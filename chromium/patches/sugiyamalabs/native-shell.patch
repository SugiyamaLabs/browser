+namespace {
+// Deletes itself when the remover is done.
+class ClearDone : public content::BrowsingDataRemover::Observer {
+ public:
+  ClearDone(content::BrowsingDataRemover* remover, AgensDoneFn done, void* context)
+      : remover_(remover), done_(done), context_(context) {
+    remover_->AddObserver(this);
+  }
+  void OnBrowsingDataRemoverDone(uint64_t) override {
+    remover_->RemoveObserver(this);
+    if (done_) done_(context_);
+    delete this;
+  }
+
+ private:
+  raw_ptr<content::BrowsingDataRemover> remover_;
+  AgensDoneFn done_;
+  raw_ptr<void> context_;
+};
+}  // namespace
+
+void agens_clear_data(AgensWindow* w, int what, int period, AgensDoneFn done, void* context) {
+  uint64_t mask = 0;
+  if (what & kAgensClearHistory) mask |= chrome_browsing_data_remover::DATA_TYPE_HISTORY;
+  if (what & kAgensClearCookies) mask |= chrome_browsing_data_remover::DATA_TYPE_SITE_DATA;
+  if (what & kAgensClearCache) mask |= content::BrowsingDataRemover::DATA_TYPE_CACHE;
+  if (what & kAgensClearDownloads) mask |= content::BrowsingDataRemover::DATA_TYPE_DOWNLOADS;
+  if (what & kAgensClearForms) mask |= chrome_browsing_data_remover::DATA_TYPE_FORM_DATA;
+  const auto time = static_cast<browsing_data::TimePeriod>(std::clamp(period, 0, 4));
+  content::BrowsingDataRemover* remover = w->browser->GetProfile()->GetBrowsingDataRemover();
+  remover->RemoveAndReply(browsing_data::CalculateBeginDeleteTime(time),
+                          browsing_data::CalculateEndDeleteTime(time), mask,
+                          content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+                          new ClearDone(remover, done, context));
+}
+
+void agens_reset_settings(AgensWindow* w, AgensDoneFn done, void* context) {
+  auto* resetter = new ProfileResetter(w->browser->GetProfile());
+  base::WeakPtr<AgensWindow> window = w->weak.GetWeakPtr();
+  resetter->ResetSettings(
+      ProfileResetter::DEFAULT_SEARCH_ENGINE | ProfileResetter::HOMEPAGE |
+          ProfileResetter::CONTENT_SETTINGS | ProfileResetter::STARTUP_PAGES |
+          ProfileResetter::SHORTCUTS | ProfileResetter::NTP_CUSTOMIZATIONS |
+          ProfileResetter::LANGUAGES,
+      std::make_unique<BrandcodedDefaultSettings>(),
+      base::BindOnce(
+          [](ProfileResetter* resetter, base::WeakPtr<AgensWindow> window, AgensDoneFn done,
+             void* context) {
+            if (window) window->PreferDuckDuckGo(/*force=*/true);  // our default search, as on a new ato
+            base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, resetter);
+            if (done) done(context);
+          },
+          resetter, window, done, context));
+}
+
+void agens_extensions(AgensWindow* w, AgensExtensionsFn fn, void* context) {
+  content::BrowserContext* profile = w->browser->GetProfile();
+  extensions::ExtensionRegistry* registry = extensions::ExtensionRegistry::Get(profile);
+  std::vector<scoped_refptr<const extensions::Extension>> shown;
+  for (const auto& e : registry->GenerateInstalledExtensionsSet()) {
+    if (extensions::ui_util::ShouldDisplayInExtensionSettings(*e)) shown.push_back(e);
+  }
+  std::vector<AgensExtension> out;
+  for (const auto& e : shown) {
+    out.push_back({e->id().c_str(), e->name().c_str(), e->VersionString().c_str(),
+                   registry->enabled_extensions().Contains(e->id())});
+  }
+  fn(context, out.data(), static_cast<int>(out.size()));
+}
+void agens_extension_set_enabled(AgensWindow* w, const char* id, int enabled) {
+  auto* registrar = extensions::ExtensionRegistrar::Get(w->browser->GetProfile());
+  if (!id) return;
+  if (enabled) {
+    registrar->EnableExtension(id);
+  } else {
+    registrar->DisableExtension(id, {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+}
+void agens_extension_remove(AgensWindow* w, const char* id) {
+  if (!id || !extensions::ExtensionRegistry::Get(w->browser->GetProfile())->GetInstalledExtension(id)) return;
+  std::u16string error;
+  extensions::ExtensionRegistrar::Get(w->browser->GetProfile())
+      ->UninstallExtension(id, extensions::UNINSTALL_REASON_USER_INITIATED, &error);
+}
+
+namespace {
+// The last list of saved logins of a profile, kept so the UI can address them by index.
+class SavedLogins : public base::SupportsUserData::Data,
+                    public password_manager::PasswordStoreConsumer {
+ public:
+  static SavedLogins* For(Profile* profile) {
+    static const char kKey[] = "AgensSavedLogins";
+    auto* data = static_cast<SavedLogins*>(profile->GetUserData(kKey));
+    if (!data) {
+      auto owned = std::make_unique<SavedLogins>();
+      data = owned.get();
+      profile->SetUserData(kKey, std::move(owned));
+    }
+    data->store = ProfilePasswordStoreFactory::GetForProfile(profile, ServiceAccessType::EXPLICIT_ACCESS);
+    return data;
+  }
+  void Fetch(AgensLoginsFn fn, void* context) {
+    fn_ = fn;
+    context_ = context;
+    if (!store) {
+      Deliver();
+      return;
+    }
+    store->GetAutofillableLogins(weak_.GetWeakPtr());
+  }
+  void OnGetPasswordStoreResultsOrErrorFrom(
+      password_manager::PasswordStoreInterface*,
+      base::expected<std::vector<password_manager::StoredCredential>,
+                     password_manager::PasswordStoreBackendError> results) override {
+    logins = results.has_value() ? std::move(results.value())
+                                 : std::vector<password_manager::StoredCredential>();
+    std::sort(logins.begin(), logins.end(), [](const auto& a, const auto& b) {
+      return std::tie(a.signon_realm, a.username_value) < std::tie(b.signon_realm, b.username_value);
+    });
+    Deliver();
+  }
+  void Deliver() {
+    if (!fn_) return;
+    std::vector<std::string> sites, users;
+    for (const auto& l : logins) {
+      sites.push_back(l.url.is_valid() ? std::string(l.url.host()) : l.signon_realm);
+      users.push_back(base::UTF16ToUTF8(l.username_value));
+    }
+    std::vector<AgensLogin> out;
+    for (size_t i = 0; i < logins.size(); ++i) out.push_back({sites[i].c_str(), users[i].c_str()});
+    AgensLoginsFn fn = std::exchange(fn_, nullptr);
+    fn(context_, out.data(), static_cast<int>(out.size()));
+  }
+
+  scoped_refptr<password_manager::PasswordStoreInterface> store;
+  std::vector<password_manager::StoredCredential> logins;
+
+ private:
+  AgensLoginsFn fn_ = nullptr;
+  raw_ptr<void> context_ = nullptr;
+  base::WeakPtrFactory<SavedLogins> weak_{this};
+};
+}  // namespace
+
+void agens_passwords(AgensWindow* w, AgensLoginsFn fn, void* context) {
+  SavedLogins::For(w->browser->GetProfile())->Fetch(fn, context);
+}
+int agens_password_get(AgensWindow* w, int index, char* out, int size) {
+  SavedLogins* saved = SavedLogins::For(w->browser->GetProfile());
+  if (index < 0 || index >= static_cast<int>(saved->logins.size()) || size <= 0) return 0;
+  const std::string password = base::UTF16ToUTF8(saved->logins[index].password_value.value());
+  const size_t n = std::min(password.size(), static_cast<size_t>(size - 1));
+  std::copy_n(password.data(), n, out);
+  out[n] = 0;
+  return 1;
+}
+void agens_password_remove(AgensWindow* w, int index) {
+  SavedLogins* saved = SavedLogins::For(w->browser->GetProfile());
+  if (!saved->store || index < 0 || index >= static_cast<int>(saved->logins.size())) return;
+  saved->store->RemoveLogin(FROM_HERE, saved->logins[index]);
+  saved->logins.erase(saved->logins.begin() + index);
+}
+
+void agens_history(AgensWindow* w, const char* text, AgensHistoryFn fn, void* context) {
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      w->browser->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    fn(context, nullptr, 0);
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count = 300;
+  options.duplicate_policy = history::QueryOptions::REMOVE_DUPLICATES_PER_DAY;
+  w->history_tracker.TryCancelAll();  // only the latest search answers
+  history->QueryHistory(
+      base::UTF8ToUTF16(text ? text : ""), options,
+      base::BindOnce(
+          [](AgensHistoryFn fn, void* context, history::QueryResults results) {
+            std::vector<std::string> urls, titles;
+            for (const history::URLResult& r : results) {
+              urls.push_back(r.url().spec());
+              titles.push_back(base::UTF16ToUTF8(r.title()));
+            }
+            std::vector<AgensVisit> out;
+            for (size_t i = 0; i < results.size(); ++i) {
+              out.push_back({urls[i].c_str(), titles[i].c_str(),
+                             results[i].visit_time().InSecondsFSinceUnixEpoch()});
+            }
+            fn(context, out.data(), static_cast<int>(out.size()));
+          },
+          fn, context),
+      &w->history_tracker);
+}
+void agens_history_remove(AgensWindow* w, const char* url) {
+  history::HistoryService* history = HistoryServiceFactory::GetForProfile(
+      w->browser->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  GURL page(url ? url : "");
+  if (history && page.is_valid()) history->DeleteURLs({page});
+}
+
+void agens_window_set_default_browser(AgensWindow*) {
+  shell_integration::SetAsDefaultBrowser();
+}
+void agens_window_suggest(AgensWindow* w, const char* text) {
+  w->Suggest(text ? text : "");
+}
+void agens_window_open_suggestion(AgensWindow* w, int index) {
+  w->OpenSuggestion(index);
+}
+void agens_window_new_tab(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_NEW_TAB);
+}
+void agens_window_activate_tab(AgensWindow* w, int index) {
+  if (w->model()->ContainsIndex(index)) w->model()->ActivateTabAt(index);
+}
+void agens_window_close_tab(AgensWindow* w, int index) {
+  if (w->model()->ContainsIndex(index)) {
+    w->model()->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE | TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+void agens_window_move_tab(AgensWindow* w, int from, int to) {
+  if (w->model()->ContainsIndex(from) && w->model()->ContainsIndex(to) && from != to) {
+    w->model()->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+  }
+}
+void agens_window_set_pinned(AgensWindow* w, int index, int pinned) {
+  if (w->model()->ContainsIndex(index)) w->model()->SetTabPinned(index, pinned);
+}
+void agens_window_toggle_mute(AgensWindow* w, int index) {
+  if (!w->model()->ContainsIndex(index)) return;
+  content::WebContents* contents = w->model()->GetWebContentsAt(index);
+  contents->SetAudioMuted(!contents->IsAudioMuted());
+}
+void agens_window_navigate(AgensWindow* w, const char* text) {
+  content::WebContents* active = w->model()->GetActiveWebContents();
+  std::u16string input = base::UTF8ToUTF16(text ? text : "");
+  if (!active || input.empty()) return;
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(w->browser->GetProfile())
+      ->Classify(input, false, false, metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  if (!match.destination_url.is_valid()) return;
+  active->GetController().LoadURL(match.destination_url, content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  active->Focus();
+}
+void agens_window_back(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_BACK);
+}
+void agens_window_forward(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_FORWARD);
+}
+void agens_window_reload(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_RELOAD);
+}
+void agens_window_relayout(AgensWindow* w) {
+  if (w->relayout) w->relayout.Run();
+}
+void agens_window_toggle_bookmark(AgensWindow* w) {
+  content::WebContents* active = w->model()->GetActiveWebContents();
+  bookmarks::BookmarkModel* model = BookmarkModelFactory::GetForBrowserContext(w->browser->GetProfile());
+  if (!active || !model || !model->loaded()) return;
+  const GURL url = active->GetVisibleURL();
+  if (model->IsBookmarked(url)) {
+    bookmarks::RemoveAllBookmarks(model, url, FROM_HERE);
+  } else {
+    bookmarks::AddIfNotBookmarked(model, url, active->GetTitle());
+  }
+  w->Notify();
+}
+void agens_window_open_page(AgensWindow* w, AgensPage page) {
+  switch (page) {
+    case kAgensBookmarks: chrome::ExecuteCommand(w->browser, IDC_SHOW_BOOKMARK_MANAGER); break;
+    case kAgensHistory: chrome::ExecuteCommand(w->browser, IDC_SHOW_HISTORY); break;
+    case kAgensSettings: chrome::ExecuteCommand(w->browser, IDC_OPTIONS); break;
+  }
+}
+void agens_window_show_site_info(AgensWindow* w) {
+  if (content::WebContents* active = w->model()->GetActiveWebContents()) {
+    ShowPageInfoDialog(active, base::DoNothing(), bubble_anchor_util::Anchor::kLocationBar);
+  }
+}
+void agens_window_stop(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_STOP);
+}
