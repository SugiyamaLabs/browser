@@ -0,0 +1,73 @@
+# SugiyamaLabs: ad blocker rulesets, built from the filter lists that
+# chromium/fetch.sh copies into lists/ (from chromium/adblock/lists in our repo).
+# The lists that ship in the app are the starting point: once a day the browser
+# may download newer ones from our GitHub (see chrome/browser/sugiyamalabs/adblock.cc).
+#
+# One ruleset per level (the subresource filter takes a single ruleset):
+#   adblock_rules_1  Padrao: EasyList + EasyPrivacy
+#   adblock_rules_2  Forte:  Padrao + uBlock filters + uBlock privacy + EasyList Cookie List
+
+import("//build/compiled_action.gni")
+
+_level_1 = [
+  "lists/easylist.txt",
+  "lists/easyprivacy.txt",
+]
+_level_2 = _level_1 + [
+      "lists/ublock-filters.txt",
+      "lists/ublock-privacy.txt",
+      "lists/easylist-cookie.txt",
+    ]
+
+template("adblock_ruleset") {
+  compiled_action(target_name) {
+    tool = "//components/subresource_filter/tools:ruleset_converter"
+    inputs = invoker.lists
+    outputs = [ "$target_gen_dir/${invoker.output}" ]
+    args = [
+      "--input_format=filter-list",
+      "--output_format=unindexed-ruleset",
+      "--input_files=" +
+          string_join(",", rebase_path(invoker.lists, root_build_dir)),
+
+      # URL rules only. shortcut: no cosmetic (CSS) rules, the style indexer
+      # DCHECKs on the list order; the cosmetic filter reads the raw lists.
+      "--output_file_url=" + rebase_path(outputs[0], root_build_dir),
+    ]
+  }
+}
+
+adblock_ruleset("ruleset_1") {
+  lists = _level_1
+  output = "adblock_rules_1"
+}
+
+adblock_ruleset("ruleset_2") {
+  lists = _level_2
+  output = "adblock_rules_2"
+}
+
+if (is_mac) {
+  bundle_data("rules_bundle") {
+    sources = get_target_outputs(":ruleset_1") + get_target_outputs(":ruleset_2")
+    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+    public_deps = [
+      ":ruleset_1",
+      ":ruleset_2",
+    ]
+  }
+
+  # The raw lists, for the cosmetic filter and as the first copy of what the
+  # daily update replaces: Resources/adblock_lists/*.txt.
+  bundle_data("lists_bundle") {
+    sources = _level_2
+    outputs = [ "{{bundle_resources_dir}}/adblock_lists/{{source_file_part}}" ]
+  }
+
+  group("bundle_data") {
+    public_deps = [
+      ":lists_bundle",
+      ":rules_bundle",
+    ]
+  }
+}
