+    if (!strong || seq != strong->_zoomNoticeSeq) return;  // a newer notice runs its own clock
+    [NSAnimationContext runAnimationGroup:^(NSAnimationContext* ctx) {
+      ctx.duration = 0.2;
+      strong->_zoomNotice.animator.alphaValue = 0;
+    } completionHandler:^{
+      if (seq == strong->_zoomNoticeSeq) strong->_zoomNotice.hidden = YES;
+    }];
+  });
+}
