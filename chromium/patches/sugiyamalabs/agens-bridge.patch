+// host.settings {site_requests?, agent_extensions?}: sets the ones given, answers both as now in force.
+void HostSettings(const Request& request, ReplyCallback reply) {
+  PrefService* local = g_browser_process->local_state();
+  const base::Value* site_requests = request.body.Find("site_requests");
+  const base::Value* agent_extensions = request.body.Find("agent_extensions");
+  if ((site_requests && !site_requests->is_bool()) || (agent_extensions && !agent_extensions->is_bool())) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "site_requests and agent_extensions are booleans"));
+    return;
+  }
+  // The prefs' observers apply them: SiteRequests here, the controlled tabs in control_ops.cc.
+  if (site_requests) local->SetBoolean(kSiteRequestsPref, site_requests->GetBool());
+  if (agent_extensions) local->SetBoolean(kAgentExtensionsPref, agent_extensions->GetBool());
+  base::DictValue result;
+  result.Set("site_requests", local->GetBoolean(kSiteRequestsPref));
+  result.Set("agent_extensions", local->GetBoolean(kAgentExtensionsPref));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
