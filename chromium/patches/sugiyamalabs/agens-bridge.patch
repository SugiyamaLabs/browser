+// The outline of a panel with its arrow (popover_arrow.h), in the panel's own coordinates (not
+// flipped): the body's rounded rect with the arrow on its top edge (`up`) or bottom one, centered
+// at `ax`. Without the body, the arrow alone. Traced on the 1 pt border's center line.
+static CGPathRef ArrowOutline(CGFloat w, CGFloat h, CGFloat radius, BOOL up, CGFloat ax, BOOL body) {
+  using namespace agens::ui;
+  const CGFloat e = 0.5, l = e, r = w - e, b = e, t = h - e, rr = radius - e, aw = kArrowW / 2;
+  const CGFloat base = up ? t : b, tip = up ? t + kArrowH : b - kArrowH;
+  CGMutablePathRef path = CGPathCreateMutable();
+  auto arrow = [&](CGFloat from, CGFloat to) {  // along the edge from `from` to `to`, out to the tip
+    CGPathAddLineToPoint(path, nullptr, from, base);
+    CGPathAddArcToPoint(path, nullptr, ax, tip, to, base, kArrowTip);
+    CGPathAddLineToPoint(path, nullptr, to, base);
+  };
+  if (!body) {
+    CGPathMoveToPoint(path, nullptr, ax - aw, base);
+    arrow(ax - aw, ax + aw);
+  } else {
+    CGPathMoveToPoint(path, nullptr, l + rr, b);
+    if (!up) arrow(ax - aw, ax + aw);
+    CGPathAddArcToPoint(path, nullptr, r, b, r, t, rr);
+    CGPathAddArcToPoint(path, nullptr, r, t, l, t, rr);
+    if (up) arrow(ax + aw, ax - aw);
+    CGPathAddArcToPoint(path, nullptr, l, t, l, b, rr);
+    CGPathAddArcToPoint(path, nullptr, l, b, r, b, rr);
+  }
+  CGPathCloseSubpath(path);
+  return path;
+}
+// Draws `panel` (made by popoverWidth:) with its arrow: one shape carries the fill and the border
+// around body and arrow, so there is no seam. On Liquid Glass the body keeps its glass and only
+// the arrow is drawn, in the glass veil's color. `fill` nil: the panel's float color.
+static void DrawArrowPanel(NSView* panel, CGFloat radius, BOOL up, CGFloat ax, NSColor* fill) {
+  for (NSView* v in [panel.subviews copy]) {
+    if ([v.identifier isEqualToString:@"arrow-outline"]) [v removeFromSuperview];
+  }
+  const BOOL glass = LiquidGlass() && !fill;
+  const CGFloat out = agens::ui::kArrowH + 1;  // room around the body for the arrow
+  NSView* outline = [[NSView alloc] initWithFrame:NSInsetRect(panel.bounds, -out, -out)];
+  outline.identifier = @"arrow-outline";
+  outline.wantsLayer = YES;
+  CAShapeLayer* shape = [CAShapeLayer layer];
+  shape.frame = outline.bounds;
+  CGPathRef path = ArrowOutline(NSWidth(panel.bounds), NSHeight(panel.bounds), radius, up, ax, !glass);
+  CGAffineTransform move = CGAffineTransformMakeTranslation(out, out);
+  CGPathRef moved = CGPathCreateCopyByTransformingPath(path, &move);
+  shape.path = moved;
+  CGPathRelease(moved);
+  CGPathRelease(path);
+  __block CGColorRef fillColor, strokeColor;
+  [panel.effectiveAppearance performAsCurrentDrawingAppearance:^{
+    fillColor = (fill ?: glass ? [kFloat.color() colorWithAlphaComponent:0.8] : kFloat.color()).CGColor;
+    strokeColor = kLineStrong.color().CGColor;
+  }];
+  shape.fillColor = fillColor;
+  shape.strokeColor = glass || fill ? nil : strokeColor;
+  shape.lineWidth = 1;
+  [outline.layer addSublayer:shape];
+  if (!glass) {  // the shape is the background and border now
+    panel.layer.backgroundColor = NSColor.clearColor.CGColor;
+    panel.layer.borderWidth = 0;
+  }
+  [panel addSubview:outline positioned:NSWindowBelow relativeTo:nil];
+}
