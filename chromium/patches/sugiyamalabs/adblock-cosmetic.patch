diff --git a/chrome/common/agens_adblock/cosmetic_filter.mojom b/chrome/common/agens_adblock/cosmetic_filter.mojom
new file mode 100644
--- /dev/null
+++ b/chrome/common/agens_adblock/cosmetic_filter.mojom
@@ -0,0 +1,16 @@
+// Copyright 2026 SugiyamaLabs. All rights reserved.
+module agens_adblock.mojom;
+
+import "url/mojom/url.mojom";
+
+// Renderer -> browser, once per new http(s) document, before the page runs.
+// Sync on purpose: the answer is a hash lookup in the browser process and the
+// page must not paint or run a script before the CSS / scriptlets are in.
+interface CosmeticFilter {
+  // Returns CSS to insert and a script to run in the page's main world (both
+  // empty when nothing applies: level off, site allowed by the user, lists not
+  // loaded yet).
+  [Sync]
+  GetForDocument(url.mojom.Url document_url, bool is_main_frame) =>
+      (string css, string main_world_script);
+};
diff --git a/chrome/renderer/agens_adblock/cosmetic_observer.cc b/chrome/renderer/agens_adblock/cosmetic_observer.cc
new file mode 100644
--- /dev/null
+++ b/chrome/renderer/agens_adblock/cosmetic_observer.cc
@@ -0,0 +1,52 @@
+// Copyright 2026 SugiyamaLabs. All rights reserved.
+#include "chrome/renderer/agens_adblock/cosmetic_observer.h"
+
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+
+namespace agens_adblock {
+
+CosmeticObserver::CosmeticObserver(content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame) {}
+
+CosmeticObserver::~CosmeticObserver() = default;
+
+// One sync call per document, shared by the two hooks below.
+bool CosmeticObserver::Fetch() {
+  GURL url = render_frame()->GetWebFrame()->GetDocument().Url();
+  if (!url.SchemeIsHTTPOrHTTPS()) return false;
+  if (url == url_ && fetched_) return true;
+  if (!filter_.is_bound())
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        filter_.BindNewPipeAndPassReceiver());
+  // shortcut: sync call; the browser side is a hash lookup. Move to a pushed
+  // message if UI thread stalls ever show up in navigation traces.
+  fetched_ = filter_->GetForDocument(url, render_frame()->IsMainFrame(), &css_,
+                                     &script_);
+  url_ = url;
+  return fetched_;
+}
+
+// The page's main-world global exists but no page script has run yet.
+void CosmeticObserver::DidClearWindowObject() {
+  fetched_ = false;  // new document: ask again
+  if (!Fetch() || script_.empty()) return;
+  render_frame()->GetWebFrame()->ExecuteScript(
+      blink::WebScriptSource(blink::WebString::FromUtf8(script_)));
+}
+
+void CosmeticObserver::DidCreateDocumentElement() {
+  if (!Fetch() || css_.empty()) return;
+  render_frame()->GetWebFrame()->GetDocument().InsertStyleSheet(
+      blink::WebString::FromUtf8(css_), nullptr, blink::WebCssOrigin::kUser);
+}
+
+void CosmeticObserver::OnDestruct() {
+  delete this;
+}
+
+}  // namespace agens_adblock
