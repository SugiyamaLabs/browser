+// view.pick {on}: arms the picker on an attached tab (again, after a pick) or ends it.
+void ViewPick(content::WebContents* contents, Shown* shown, const Request& request, ReplyCallback reply) {
+  const std::optional<bool> on = request.body.FindBool("on");
+  if (!on) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and on (a boolean)"));
+    return;
+  }
+  if (!shown) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the tab is not attached"));
+    return;
+  }
+  if (!*on) {
+    if (!shown->picker) {
+      std::move(reply).Run(OkReply(request.id));
+      return;
+    }
+    shown->picker->Stop(base::BindOnce([](base::Value id, ReplyCallback reply, std::string) { std::move(reply).Run(OkReply(id)); },
+                                       request.id.Clone(), std::move(reply)));
+    return;
+  }
+  if (AgentWorks(contents)) {
+    std::move(reply).Run(ErrorReply(&request.id, kDenied, "an agent is working on this tab"));
+    return;
+  }
+  if (!shown->picker) {
+    shown->picker = std::make_unique<Picker>(contents, base::BindRepeating(
+                                                           [](int n, base::DictValue fields) {
+                                                             if (!S().host) return;
+                                                             fields.Set("tab", ViewTabName(n));
+                                                             SendEventTo(S().host, "view.picked", std::move(fields));
+                                                           },
+                                                           shown->n));
+  }
+  shown->picker->Arm(base::BindOnce(
+      [](base::Value id, ReplyCallback reply, std::string code) {
+        std::move(reply).Run(code.empty() ? OkReply(id) : ErrorReply(&id, code, "could not start picking on this page"));
+      },
+      request.id.Clone(), std::move(reply)));
+}
+
+// view.pick.step {to}: the pick moves to its parent or first child.
+void ViewPickStep(Shown* shown, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> to = StringParam(request.body, "to");
+  if (!to || (*to != "parent" && *to != "child")) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and to: parent or child"));
+    return;
+  }
+  if (!shown || !shown->picker || !shown->picker->held()) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "nothing is picked on this tab"));
+    return;
+  }
+  shown->picker->Step(*to == "parent", base::BindOnce(
+                                           [](base::Value id, std::string to, ReplyCallback reply, std::string code) {
+                                             std::move(reply).Run(code.empty() ? OkReply(id)
+                                                                               : ErrorReply(&id, code, "no " + to));
+                                           },
+                                           request.id.Clone(), *to, std::move(reply)));
+}
