+
+std::unique_ptr<content::ColorChooser> OpenColor(content::WebContents* contents,
+                                                 SkColor color,
+                                                 std::vector<std::pair<SkColor, std::string>> suggestions,
+                                                 const gfx::Rect& anchor) {
+  if (AgentWorking(contents)) return nullptr;  // the page sees it close at once
+  base::DictValue fields;
+  fields.Set("value", HexColor(color));
+  base::ListValue list;
+  for (const auto& [value, label] : suggestions) {
+    base::DictValue entry;
+    entry.Set("value", HexColor(value));
+    entry.Set("label", label);
+    list.Append(std::move(entry));
+  }
+  fields.Set("suggestions", std::move(list));
+  SetAnchor(fields, contents, anchor);
+  const int ask = Ask(contents, "color", std::move(fields),
+                      base::BindOnce(
+                          [](base::WeakPtr<content::WebContents> contents, const base::DictValue* answer) {
+                            if (!contents) return;
+                            const std::string* value = answer ? answer->FindString("value") : nullptr;
+                            uint32_t rgb = 0;
+                            if (value && base::HexStringToUInt(value->substr(1), &rgb)) {
+                              contents->DidChooseColorInColorChooser(SkColorSetA(rgb, SK_AlphaOPAQUE));
+                            }
+                            contents->DidEndColorChooser();
+                          },
+                          contents->GetWeakPtr()));
+  return ask ? std::make_unique<HostColorChooser>(ask) : nullptr;
+}
