index 0000000000..b95ce31d3b
--- /dev/null
+++ b/chrome/browser/agens/embed/native_shell.cc
@@ -0,0 +1,169 @@
+// Copyright 2026 SugiyamaLabs.
+// The embed API (agens_embed.h) on top of AgensWindow. Same code on every platform.
+
+#include "chrome/browser/agens/embed/native_shell.h"
+
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "build/build_config.h"
+#include "ui/views/view.h"
+
+#include "base/containers/flat_set.h"
+#include "base/no_destructor.h"
+
+namespace {
+base::flat_set<const StatusBubble*>& NativeBubbles() {
+  static base::NoDestructor<base::flat_set<const StatusBubble*>> bubbles;
+  return *bubbles;
+}
+}  // namespace
+
+AgensStatusBubble::AgensStatusBubble() {
+  NativeBubbles().insert(this);
+}
+AgensStatusBubble::~AgensStatusBubble() {
+  NativeBubbles().erase(this);
+}
+
+extern "C" {
+
+void agens_window_set_tabs_observer(AgensWindow* w, AgensTabsChanged observer, void* context) {
+  w->observer = observer;
+  w->context = context;
+  w->NotifyNow();
+}
+void agens_window_set_suggestions_observer(AgensWindow* w, AgensSuggestionsChanged observer,
+                                           void* context) {
+  w->suggestions_observer = observer;
+  w->suggestions_context = context;
+}
+void agens_window_set_atos_observer(AgensWindow* w, AgensAtosChanged observer, void* context) {
+  w->atos_observer = observer;
+  w->atos_context = context;
+  w->NotifyAtos();
+}
+void agens_window_switch_ato(AgensWindow* w, int index) {
+  w->SwitchAto(index);
+}
+void agens_window_new_ato(AgensWindow* w) {
+  w->NewAto();
+}
+void agens_window_set_status_observer(AgensWindow* w, AgensStatusChanged observer, void* context) {
+  w->status_bubble.observer = observer;
+  w->status_bubble.context = context;
+}
+void agens_window_set_downloads_observer(AgensWindow* w, AgensDownloadsChanged observer, void* context) {
+  w->downloads_observer = observer;
+  w->downloads_context = context;
+  w->NotifyDownloads(false);
+}
+void agens_window_download_open(AgensWindow* w, int index) {
+  if (download::DownloadItem* item = w->DownloadAt(index)) item->OpenDownload();
+}
+void agens_window_download_show(AgensWindow* w, int index) {
+  if (download::DownloadItem* item = w->DownloadAt(index)) item->ShowDownloadInShell();
+}
+void agens_window_download_cancel(AgensWindow* w, int index) {
+  if (download::DownloadItem* item = w->DownloadAt(index)) item->Cancel(/*user_cancel=*/true);
+}
+void agens_window_suggest(AgensWindow* w, const char* text) {
+  w->Suggest(text ? text : "");
+}
+void agens_window_open_suggestion(AgensWindow* w, int index) {
+  w->OpenSuggestion(index);
+}
+void agens_window_new_tab(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_NEW_TAB);
+}
+void agens_window_activate_tab(AgensWindow* w, int index) {
+  if (w->model()->ContainsIndex(index)) w->model()->ActivateTabAt(index);
+}
+void agens_window_close_tab(AgensWindow* w, int index) {
+  if (w->model()->ContainsIndex(index)) {
+    w->model()->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE | TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+void agens_window_navigate(AgensWindow* w, const char* text) {
+  content::WebContents* active = w->model()->GetActiveWebContents();
+  std::u16string input = base::UTF8ToUTF16(text ? text : "");
+  if (!active || input.empty()) return;
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(w->browser->GetProfile())
+      ->Classify(input, false, false, metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  if (!match.destination_url.is_valid()) return;
+  active->GetController().LoadURL(match.destination_url, content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  active->Focus();
+}
+void agens_window_back(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_BACK);
+}
+void agens_window_forward(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_FORWARD);
+}
+void agens_window_reload(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_RELOAD);
+}
+void agens_window_relayout(AgensWindow* w) {
+  if (w->relayout) w->relayout.Run();
+}
+void agens_window_toggle_bookmark(AgensWindow* w) {
+  content::WebContents* active = w->model()->GetActiveWebContents();
+  bookmarks::BookmarkModel* model = BookmarkModelFactory::GetForBrowserContext(w->browser->GetProfile());
+  if (!active || !model || !model->loaded()) return;
+  const GURL url = active->GetVisibleURL();
+  if (model->IsBookmarked(url)) {
+    bookmarks::RemoveAllBookmarks(model, url, FROM_HERE);
+  } else {
+    bookmarks::AddIfNotBookmarked(model, url, active->GetTitle());
+  }
+  w->Notify();
+}
+void agens_window_open_page(AgensWindow* w, AgensPage page) {
+  switch (page) {
+    case kAgensBookmarks: chrome::ExecuteCommand(w->browser, IDC_SHOW_BOOKMARK_MANAGER); break;
+    case kAgensHistory: chrome::ExecuteCommand(w->browser, IDC_SHOW_HISTORY); break;
+    case kAgensSettings: chrome::ExecuteCommand(w->browser, IDC_OPTIONS); break;
+  }
+}
+void agens_window_show_site_info(AgensWindow* w) {
+  if (content::WebContents* active = w->model()->GetActiveWebContents()) {
+    ShowPageInfoDialog(active, base::DoNothing(), bubble_anchor_util::Anchor::kLocationBar);
+  }
+}
+void agens_window_stop(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_STOP);
+}
+
+}  // extern "C"
+
+namespace agens {
+
+BASE_FEATURE(kAgensNativeShell, base::FEATURE_ENABLED_BY_DEFAULT);
+
+bool IsNativeShellEnabled() {
+  // shortcut: only macOS has a host so far; Windows gets native_shell_win.cc in issue #61.
+  return BUILDFLAG(IS_MAC) && base::FeatureList::IsEnabled(kAgensNativeShell);
+}
+
+#if !BUILDFLAG(IS_MAC)
+// Never called while IsNativeShellEnabled() is false; they keep other platforms linking.
+std::unique_ptr<views::View> CreateNativeShellView(BrowserWindowInterface*) {
+  NOTREACHED();
+}
+void FocusNativeLocationBar(views::Widget*) {}
+StatusBubble* NativeStatusBubble(views::Widget*) {
+  return nullptr;
+}
+void ConfirmCloseWithDownloads(views::Widget*, int, base::OnceCallback<void(bool)> callback) {
+  std::move(callback).Run(true);
+}
+#endif
+
+bool IsNativeStatusBubble(const StatusBubble* bubble) {
+  return NativeBubbles().contains(bubble);
+}
+
+
+
+}  // namespace agens
