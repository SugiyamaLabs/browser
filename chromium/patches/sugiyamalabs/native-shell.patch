+// One tab in the column: favicon (or spinner), title, close on hover.
+@interface AgensTabRow : AgensHoverView
+@property(nonatomic) int index;
+@property(nonatomic, copy) void (^onClose)(void);
+- (void)updateWith:(const AgensTab&)tab;
+@end
+@implementation AgensTabRow {
+  NSImageView* _favicon;
+  NSProgressIndicator* _spinner;
+  NSTextField* _title;
+  NSButton* _close;
+}
+@synthesize index = _index;
+@synthesize onClose = _onClose;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    _favicon = [[NSImageView alloc] initWithFrame:NSMakeRect(8, 8, 16, 16)];
+    _spinner = [[NSProgressIndicator alloc] initWithFrame:NSMakeRect(8, 8, 16, 16)];
+    _spinner.style = NSProgressIndicatorStyleSpinning;
+    _spinner.controlSize = NSControlSizeSmall;
+    _spinner.displayedWhenStopped = NO;
+    _title = Label(13, NSFontWeightRegular, kMute);
+    _close = [NSButton buttonWithImage:Symbol(@"xmark", 10) target:self action:@selector(closeTab:)];
+    _close.bordered = NO;
+    _close.contentTintColor = kDim.color();
+    _close.toolTip = @"Fechar aba";
+    _close.accessibilityLabel = @"Fechar aba";
+    for (NSView* v in @[ _favicon, _spinner, _title, _close ]) [self addSubview:v];
+  }
+  return self;
+}
+- (void)layout {
+  [super layout];
+  CGFloat w = NSWidth(self.bounds);
+  _close.frame = NSMakeRect(w - 26, 6, 20, 20);
+  _title.frame = NSMakeRect(34, 7, w - 34 - 30, 18);
+}
+- (void)updateWith:(const AgensTab&)tab {
+  // Our new tab page has no URL; never show Chromium's own title for it.
+  NSString* title = tab.url[0] ? @(tab.title) : @"Nova aba";
+  if (!title.length) title = @(tab.url);
+  _title.stringValue = title;
+  self.accessibilityLabel = tab.sleeping ? [title stringByAppendingString:@", dormindo"] : title;
+  NSImage* icon = nil;
+  if (tab.favicon_png) {
+    icon = [[NSImage alloc] initWithData:[NSData dataWithBytes:tab.favicon_png
+                                                        length:tab.favicon_png_size]];
+    icon.size = NSMakeSize(16, 16);
+  }
+  _favicon.image = icon ?: Symbol(@"globe", 13);
+  _favicon.contentTintColor = kMute.color();
+  _favicon.alphaValue = tab.sleeping ? 0.4 : 1;  // prototype .sleeping .fav
+  if (tab.loading) {
+    [_spinner startAnimation:nil];
+  } else {
+    [_spinner stopAnimation:nil];
+  }
+  _favicon.hidden = tab.loading;
+  self.selected = tab.active;
+}
+- (void)refresh {
+  [super refresh];
+  _title.textColor = (self.selected || self.hovered) ? kInk.color() : kMute.color();
+  _close.hidden = !(self.selected || self.hovered);
+}
+- (void)otherMouseDown:(NSEvent*)event {  // middle click closes, like every browser
+  if (_onClose) _onClose();
+}
+- (void)closeTab:(id)sender {
+  if (_onClose) _onClose();
+}
+@end
