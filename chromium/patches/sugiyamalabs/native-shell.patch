+struct Token {
+  unsigned dark, light, brasa;
+  // Vidro/Seu: translucent surfaces over the backdrop, 0xAARRGGBB (prototype data-theme="vidro").
+  // 0 keeps the solid color.
+  unsigned glassDark = 0, glassLight = 0;
+  unsigned argb(NSAppearance* a) const {
+    const bool d = IsDark(a);
+    const unsigned glass = d ? glassDark : glassLight;
+    if (SeeThrough() && glass) return glass;
+    return 0xFF000000 | (!d ? light : Theme() == 1 ? brasa : dark);
+  }
+  NSColor* color() const {
+    Token t = *this;
+    return [NSColor colorWithName:nil dynamicProvider:^NSColor*(NSAppearance* a) { return HexA(t.argb(a)); }];
+  }
+  unsigned rgb(NSView* v) const { return argb(v.effectiveAppearance) & 0xFFFFFF; }
+  // The opaque color, for what the engine paints (it has no alpha for the card border).
+  unsigned solid(NSView* v) const {
+    return !IsDark(v.effectiveAppearance) ? light : Theme() == 1 ? brasa : dark;
+  }
