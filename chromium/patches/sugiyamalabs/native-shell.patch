+// One suggestion (prototype .sug): icon, text, detail on the right.
+@interface AgensSuggestionRow : AgensHoverView
+- (void)updateWith:(const AgensSuggestion&)suggestion;
+@end
+@implementation AgensSuggestionRow {
+  NSImageView* _icon;
+  NSTextField* _text;
+  NSTextField* _detail;
+}
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    _icon = [[NSImageView alloc] init];
+    _icon.contentTintColor = kDim.color();
+    _text = Label(13.5, NSFontWeightRegular, kInk);
+    _detail = Label(12, NSFontWeightRegular, kDim);
+    _detail.alignment = NSTextAlignmentRight;
+    for (NSView* v in @[ _icon, _text, _detail ]) [self addSubview:v];
+  }
+  return self;
+}
+- (void)layout {
+  [super layout];
+  CGFloat w = NSWidth(self.bounds);
+  _icon.frame = NSMakeRect(10, 9, 16, 16);
+  CGFloat detailW = _detail.stringValue.length ? MIN(w * 0.4, _detail.intrinsicContentSize.width) : 0;
+  _detail.frame = NSMakeRect(w - 10 - detailW, 9, detailW, 16);
+  _text.frame = NSMakeRect(36, 8, w - 36 - 10 - detailW - (detailW ? 10 : 0), 18);
+}
+- (void)updateWith:(const AgensSuggestion&)suggestion {
+  _text.stringValue = @(suggestion.text);
+  _detail.stringValue = @(suggestion.detail);
+  _icon.image = Symbol(suggestion.is_search ? @"magnifyingglass" : @"globe", 13);
+  self.accessibilityLabel = suggestion.detail[0]
+      ? [NSString stringWithFormat:@"%@, %@", _text.stringValue, _detail.stringValue]
+      : _text.stringValue;
+  self.needsLayout = YES;
+}
+- (void)refresh {
+  self.layer.backgroundColor = self.selected || self.hovered ? CG(kRaise2, self) : NSColor.clearColor.CGColor;
+}
+@end
