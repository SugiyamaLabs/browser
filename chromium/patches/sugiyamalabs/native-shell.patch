+- (CGFloat)title:(NSString*)title lead:(NSString*)lead {
+  NSImageView* mark = [[NSImageView alloc] initWithFrame:NSMakeRect(288, 56, 64, 64)];
+  const char* svg = IsDark(_body.effectiveAppearance) ? kAgensMarkDarkSvg : kAgensMarkLightSvg;
+  mark.image = [[NSImage alloc] initWithData:[NSData dataWithBytes:svg length:strlen(svg)]];
+  mark.imageScaling = NSImageScaleProportionallyUpOrDown;
+  // Long titles wrap to two lines; the lead follows right under whatever height it took.
+  NSTextField* t = [NSTextField wrappingLabelWithString:title];
+  t.font = [NSFont systemFontOfSize:24 weight:NSFontWeightSemibold];
+  t.textColor = kInk.color();
+  t.alignment = NSTextAlignmentCenter;
+  t.preferredMaxLayoutWidth = 500;
+  CGFloat th = ceil([t sizeThatFits:NSMakeSize(500, 200)].height);
+  t.frame = NSMakeRect(70, 136, 500, th);
+  NSTextField* l = [NSTextField wrappingLabelWithString:lead];
+  l.font = [NSFont systemFontOfSize:14];
+  l.textColor = kMute.color();
+  l.alignment = NSTextAlignmentCenter;
+  l.preferredMaxLayoutWidth = 480;
+  CGFloat lh = ceil([l sizeThatFits:NSMakeSize(480, 200)].height);
+  l.frame = NSMakeRect(80, 136 + th + 10, 480, lh);
+  for (NSView* v in @[ mark, t, l ]) [_body addSubview:v];
+  return 136 + th + 10 + lh + 24;
+}
+- (CGFloat)line:(NSString*)text y:(CGFloat)y {
+  NSTextField* l = Label(13, NSFontWeightRegular, kInk);
+  l.stringValue = text;
+  l.frame = NSMakeRect(150, y, 400, 18);
+  NSImageView* check = [NSImageView imageViewWithImage:Symbol(@"checkmark", 12)];
+  check.contentTintColor = kLight3.color();
+  check.frame = NSMakeRect(126, y + 1, 16, 16);
+  [_body addSubview:check];
+  [_body addSubview:l];
+  return y + 28;
+}
