+}  // namespace
+
+Page::Page(content::WebContents* contents) : content::WebContentsObserver(contents) {
+  accessibility_ = content::BrowserAccessibilityState::GetInstance()->CreateScopedModeForWebContents(
+      contents, kMode);
+}
+
+Page::~Page() {
+  if (settled_) std::move(settled_).Run();  // the op that was settling answers ok
+  for (Waiting& w : waiting_) std::move(w.reply).Run(ErrorReply(&w.id, kFailed, "the tab is no longer controlled"));
+}
+
+void Page::Run(base::Value id, Op op, ReplyCallback reply) {
+  if (waiting_.size() >= kMaxWaitingOps) return Fail(id, reply, kBadRequest, "too many page requests waiting");
+  waiting_.push_back({std::move(id), std::move(op), std::move(reply)});
+  if (!busy_) Next();
+}
+
+void Page::FailWaiting(std::string_view code, std::string_view message) {
+  std::deque<Waiting> waiting = std::move(waiting_);
+  waiting_.clear();
+  for (Waiting& w : waiting) std::move(w.reply).Run(ErrorReply(&w.id, code, message));
+}
+
+void Page::Next() {
+  if (waiting_.empty()) {
+    busy_ = false;
+    return;
+  }
+  busy_ = true;
+  Waiting w = std::move(waiting_.front());
+  waiting_.pop_front();
+  std::move(w.op).Run(base::BindOnce(&Page::Done, weak_.GetWeakPtr(), std::move(w.reply)));
+}
+
+void Page::Done(base::WeakPtr<Page> self, ReplyCallback reply, std::string line) {
+  std::move(reply).Run(std::move(line));
+  // Posted: an op that answers right away must not grow the stack.
+  if (self) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(&Page::Next, self));
+  }
+}
+
+void Page::DidFinishNavigation(content::NavigationHandle* handle) {
+  // A document that failed (network error or HTTP status >= 400), for page.network.
+  const int status = handle->GetResponseHeaders() ? handle->GetResponseHeaders()->response_code() : 0;
+  const net::Error error = handle->GetNetErrorCode();
+  if (!handle->IsSameDocument() && (status >= 400 || (error != net::OK && error != net::ERR_ABORTED))) {
+    base::DictValue entry;
+    entry.Set("url", ShownURL(handle->GetURL()));
+    entry.Set("method", handle->IsPost() ? "POST" : "GET");
+    if (status >= 400) {
+      entry.Set("status", status);
+    } else {
+      entry.Set("error", net::ErrorToShortString(error));
+    }
+    entry.Set("type", handle->IsInMainFrame() ? "document" : "iframe");
+    Keep(network_, std::move(entry));
+  }
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() || handle->IsSameDocument()) return;
+  nodes_.clear();  // refs end with their document
+  refs_.clear();
+}
+
+void Page::Keep(std::deque<base::DictValue>& ring, base::DictValue entry) {
+  if (ring.size() >= kMaxLogEntries) ring.pop_front();
+  ring.push_back(std::move(entry));
+}
+
+void Page::OnDidAddMessageToConsole(content::RenderFrameHost* frame,
+                                    blink::mojom::ConsoleMessageLevel level,
+                                    const std::u16string& message,
+                                    int32_t line,
+                                    const std::u16string& source,
+                                    const std::optional<std::u16string>& stack) {
+  // console.log and console.info both come as kInfo; console.debug as kVerbose. Uncaught
+  // exceptions come here too, as errors ("Uncaught …").
+  const char* name = level == blink::mojom::ConsoleMessageLevel::kVerbose   ? "log"
+                     : level == blink::mojom::ConsoleMessageLevel::kInfo    ? "info"
+                     : level == blink::mojom::ConsoleMessageLevel::kWarning ? "warn"
+                                                                            : "error";
+  base::DictValue entry;
+  entry.Set("level", name);
+  entry.Set("text", ClipChars(base::UTF16ToUTF8(message), kMaxLogChars));
+  entry.Set("url", ShownURL(GURL(source)));
+  entry.Set("line", line);
+  Keep(console_, std::move(entry));
+}
+
+void Page::ResourceLoadComplete(content::RenderFrameHost* frame,
+                                const content::GlobalRequestID& request_id,
+                                const GURL& original_url,
+                                const blink::mojom::ResourceLoadInfo& info) {
+  // Documents come from DidFinishNavigation.
+  if (network::IsRequestDestinationEmbeddedFrame(info.request_destination) ||
+      info.request_destination == network::mojom::RequestDestination::kDocument) {
+    return;
+  }
+  if (info.http_status_code < 400 && info.net_error == net::OK) return;
+  base::DictValue entry;
+  entry.Set("url", ShownURL(info.final_url));
+  entry.Set("method", ClipChars(info.method, 20));
+  if (info.http_status_code >= 400) {
+    entry.Set("status", info.http_status_code);
+  } else {
+    entry.Set("error", net::ErrorToShortString(info.net_error));
+  }
+  const std::string type = network::RequestDestinationToString(info.request_destination);
+  entry.Set("type", type.empty() ? "fetch" : type);  // fetch() and XMLHttpRequest have no destination
+  Keep(network_, std::move(entry));
+}
+
+void Page::Console(base::Value id, ReplyCallback reply) {
+  base::ListValue messages;
+  for (const base::DictValue& entry : console_) messages.Append(entry.Clone());
+  base::DictValue result;
+  result.Set("messages", std::move(messages));
+  std::move(reply).Run(OkReply(id, std::move(result)));
+}
+
+void Page::Network(base::Value id, ReplyCallback reply) {
+  base::ListValue requests;
+  for (const base::DictValue& entry : network_) requests.Append(entry.Clone());
+  base::DictValue result;
+  result.Set("requests", std::move(requests));
+  std::move(reply).Run(OkReply(id, std::move(result)));
+}
+
+void Page::Eval(base::Value id, std::string js, ReplyCallback reply) {
+  if (!eval) return Fail(id, reply, kDenied, "page.eval needs control.start's allow \"eval\"");
+  if (paused) return Fail(id, reply, kPaused, "the person took over the tab");
+  // Checked now, when it runs: the page may have moved since the request came.
+  content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+  if (!IsLocalURL(frame->GetLastCommittedOrigin().GetURL())) {
+    return Fail(id, reply, kDenied, "page.eval runs only on a local page (localhost, 127.0.0.1, [::1])");
+  }
+  // The page turns the value into JSON itself, so a value JSON can't carry is an error, not a guess.
+  const std::string wrapper =
+      "(() => { try { const v = (0, eval)(" + base::WriteJson(base::Value(std::move(js))).value_or("''") +
+      "); if (v === undefined) return ['ok', 'null']; const s = JSON.stringify(v); return s === undefined ? "
+      "['error', 'the result is not JSON'] : ['ok', s]; } catch (e) { return ['error', String(e)]; } })()";
+  // Whichever comes first, the result or kEvalWait, answers.
+  auto pending = base::MakeRefCounted<base::RefCountedData<ReplyCallback>>(std::move(reply));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::Value id, scoped_refptr<base::RefCountedData<ReplyCallback>> pending) {
+            if (pending->data) Fail(id, pending->data, kFailed, "the script ran past 10 s");
+          },
+          id.Clone(), pending),
+      kEvalWait);
+  frame->ExecuteJavaScriptForTests(
+      base::UTF8ToUTF16(wrapper),
+      base::BindOnce(
+          [](base::WeakPtr<Page> self, content::WeakDocumentPtr document, base::Value id,
+             scoped_refptr<base::RefCountedData<ReplyCallback>> pending, base::Value result) {
+            if (!pending->data) return;
+            ReplyCallback reply = std::move(pending->data);
+            if (!self || document.AsRenderFrameHostIfValid() != self->web_contents()->GetPrimaryMainFrame()) {
+              return Fail(id, reply, kFailed, "the page navigated while the script ran");
+            }
+            const base::ListValue* pair = result.GetIfList();
+            if (!pair || pair->size() != 2 || !(*pair)[0].is_string() || !(*pair)[1].is_string()) {
+              return Fail(id, reply, kFailed, "the script gave no result");
+            }
+            const std::string& text = (*pair)[1].GetString();
+            if ((*pair)[0].GetString() != "ok") return Fail(id, reply, kFailed, ClipChars(text, 500));
+            if (text.size() > kMaxEvalResultBytes) return Fail(id, reply, kFailed, "the result is over 1 MB");
+            std::optional<base::Value> value = base::JSONReader::Read(text, base::JSON_PARSE_RFC);
+            if (!value) return Fail(id, reply, kFailed, "the result is not JSON");
+            base::DictValue out;
+            out.Set("result", std::move(*value));
+            std::move(reply).Run(OkReply(id, std::move(out)));
+          },
+          weak_.GetWeakPtr(), frame->GetWeakDocumentPtr(), std::move(id), pending),
+      content::ISOLATED_WORLD_ID_GLOBAL);
+}
+
+ui::BrowserAccessibilityManager* Page::RootManager() {
+  return ManagerFor(web_contents()->GetPrimaryMainFrame()->GetAXTreeID());
+}
+
+ui::BrowserAccessibility* Page::Resolve(const std::string& ref) {
+  auto it = nodes_.find(ref);
+  if (it == nodes_.end()) return nullptr;
+  ui::BrowserAccessibilityManager* manager = ManagerFor(it->second.first);
+  return manager ? manager->GetFromID(it->second.second) : nullptr;
+}
+
+content::RenderWidgetHost* Page::FocusedWidget() {
+  content::RenderFrameHost* frame = web_contents()->GetFocusedFrame();
+  return (frame ? frame : web_contents()->GetPrimaryMainFrame())->GetRenderWidgetHost();
+}
+
+void Page::WaitForTree(base::WeakPtr<Page> self, base::TimeTicks deadline, base::OnceClosure then) {
+  ui::BrowserAccessibilityManager* manager = self ? self->RootManager() : nullptr;
+  const bool ready = manager && manager->GetBrowserAccessibilityRoot() && manager->GetTreeData().loaded;
+  if (!self || ready || base::TimeTicks::Now() >= deadline) {
+    std::move(then).Run();
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&Page::WaitForTree, self, deadline, std::move(then)), kTreePoll);
+}
+
+void Page::Snapshot(base::Value id, ReplyCallback reply) {
+  WaitForTree(weak_.GetWeakPtr(), base::TimeTicks::Now() + kTreeWait,
+              base::BindOnce(&Page::SnapshotNow, weak_.GetWeakPtr(), std::move(id), std::move(reply)));
+}
+
+void Page::SnapshotNow(base::WeakPtr<Page> self, base::Value id, ReplyCallback reply) {
+  if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+  std::map<std::string, Node>& nodes = self->nodes_;
+  std::map<Node, std::string>& refs = self->refs_;
+  base::ListValue list;
+  bool truncated = false;
+  size_t bytes = 0;  // a bound on the reply's size: each text twice for JSON escaping
+  ui::BrowserAccessibilityManager* manager = self->RootManager();
+  ui::BrowserAccessibility* focus = manager ? manager->GetFocus() : nullptr;
+  // Document order; `depth` counts listed ancestors. PlatformGetChild walks into frames.
+  auto visit = [&](auto&& recurse, ui::BrowserAccessibility* node, int depth, bool in_named) -> void {
+    const bool listed = !node->IsInvisibleOrIgnored() && Worth(*node, in_named);
+    if (listed && (list.size() >= kMaxNodes || bytes >= kMaxSnapshotBytes)) {
+      truncated = true;
+      return;
+    }
+    if (listed) {
+      const Node key{node->manager()->GetTreeID(), node->GetId()};
+      std::string& ref = refs[key];
+      if (ref.empty()) {
+        ref = "e" + base::NumberToString(self->next_ref_++);
+        nodes[ref] = key;
+      }
+      const ui::AXNodeData& data = node->GetData();
+      base::DictValue item;
+      item.Set("ref", ref);
+      item.Set("role", ui::ToString(node->GetRole()));
+      item.Set("name", Clip(node->GetName()));
+      if (IsPassword(data)) {
+        item.Set("password", true);  // never its value
+      } else {
+        item.Set("value", Clip(base::UTF16ToUTF8(node->GetValueForControl())));
+      }
+      item.Set("depth", depth);
+      if (node == focus) item.Set("focused", true);
+      if (data.GetRestriction() == ax::mojom::Restriction::kDisabled) item.Set("disabled", true);
+      switch (data.GetCheckedState()) {
+        case ax::mojom::CheckedState::kTrue: item.Set("checked", true); break;
+        case ax::mojom::CheckedState::kFalse: item.Set("checked", false); break;
+        case ax::mojom::CheckedState::kMixed: item.Set("checked", "mixed"); break;
+        default: break;
+      }
+      bytes += 200;
+      for (const char* field : {"name", "value"}) {
+        if (const std::string* text = item.FindString(field)) bytes += 2 * text->size();
+      }
+      list.Append(std::move(item));
+    }
+    const bool named = listed && node->GetRole() != ax::mojom::Role::kStaticText && !node->GetName().empty();
+    for (size_t i = 0; i < node->PlatformChildCount() && !truncated; ++i) {
+      if (ui::BrowserAccessibility* child = node->PlatformGetChild(i)) {
+        recurse(recurse, child, depth + (listed ? 1 : 0), in_named || named);
+      }
+    }
+  };
+  if (ui::BrowserAccessibility* root = manager ? manager->GetBrowserAccessibilityRoot() : nullptr) {
+    visit(visit, root, 0, false);
+  }
+  base::DictValue result;
+  result.Set("nodes", std::move(list));
+  if (truncated) result.Set("truncated", true);
+  std::move(reply).Run(OkReply(id, std::move(result)));
+}
+
+void Page::Click(base::Value id, std::string ref, ReplyCallback reply) {
+  PointerAttempt(weak_.GetWeakPtr(), std::move(id), std::move(ref), Pointer::kClick, 0,
+                 base::TimeTicks::Now() + kScrollWait, false, std::move(reply));
+}
+
+void Page::Hover(base::Value id, std::string ref, ReplyCallback reply) {
+  PointerAttempt(weak_.GetWeakPtr(), std::move(id), std::move(ref), Pointer::kHover, 0,
+                 base::TimeTicks::Now() + kScrollWait, false, std::move(reply));
+}
+
+void Page::Scroll(base::Value id, std::string ref, double dy, ReplyCallback reply) {
+  if (!ref.empty()) {
+    return PointerAttempt(weak_.GetWeakPtr(), std::move(id), std::move(ref), Pointer::kScroll, dy,
+                          base::TimeTicks::Now() + kScrollWait, false, std::move(reply));
+  }
+  content::RenderWidgetHost* widget = web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  content::RenderWidgetHostView* view = widget->GetView();
+  if (!view) return Fail(id, reply, kFailed, "the tab shows nothing");
+  const gfx::Size size = view->GetViewBounds().size();
+  if (paused) return Fail(id, reply, kPaused, "the person took over the tab");
+  AckWaiter::Start(widget, blink::WebInputEvent::Type::kMouseWheel,
+                   base::BindOnce([](base::Value id, ReplyCallback reply) { std::move(reply).Run(OkReply(id)); },
+                                  std::move(id), std::move(reply)));
+  SendWheel(widget, gfx::PointF(size.width() / 2.0f, size.height() / 2.0f), dy);
+}
+
+// A real click, hover or wheel scroll at the node's center, scrolled into view first. Where the
+// mouse can't land (an option of a closed <select>, a node in another process's frame, or one
+// that stays out of view), a click is the accessibility default action; hover and scroll fail.
+void Page::PointerAttempt(base::WeakPtr<Page> self,
+                          base::Value id,
+                          std::string ref,
+                          Pointer pointer,
+                          double dy,
+                          base::TimeTicks deadline,
+                          bool scrolled,
+                          ReplyCallback reply) {
+  if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+  // Each step (scroll into view, the default action, the mouse events) checks: after "Assumir"
+  // nothing more lands in what the person is doing.
+  if (self->paused) return Fail(id, reply, kPaused, "the person took over the tab");
+  ui::BrowserAccessibility* node = self->Resolve(ref);
+  if (!node) return Fail(id, reply, kNotFound, ref);
+  content::RenderWidgetHost* widget = self->web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  content::RenderFrameHost* frame = nullptr;
+  self->web_contents()->GetPrimaryMainFrame()->ForEachRenderFrameHost([&](content::RenderFrameHost* rfh) {
+    if (rfh->GetAXTreeID() == node->manager()->GetTreeID()) frame = rfh;
+  });
+  ui::AXOffscreenResult offscreen = ui::AXOffscreenResult::kOnscreen;
+  const gfx::Rect bounds =
+      node->GetBoundsRect(ui::AXCoordinateSystem::kRootFrame, ui::AXClippingBehavior::kClipped, &offscreen);
+  const bool visible = !bounds.IsEmpty() && offscreen == ui::AXOffscreenResult::kOnscreen;
+  const bool clickable = frame && frame->GetRenderWidgetHost() == widget &&
+                         node->GetRole() != ax::mojom::Role::kMenuListOption;
+  if (clickable && !visible && base::TimeTicks::Now() < deadline) {
+    if (!scrolled) node->manager()->ScrollToMakeVisible(*node, gfx::Rect());
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&Page::PointerAttempt, self, std::move(id), std::move(ref), pointer, dy, deadline, true,
+                       std::move(reply)),
+        base::Milliseconds(50));
+    return;
+  }
+  if ((!clickable || !visible) && pointer != Pointer::kClick) {
+    return Fail(id, reply, kFailed, "the mouse can't reach that element");
+  }
+  if (!clickable || !visible) {
+    node->manager()->DoDefaultAction(*node);
+    return Settle(self, std::move(id), std::move(reply));  // the action is ahead of Settle's signal
+  }
+  // Tree bounds are in physical pixels; input takes DIPs.
+  const float scale = self->RootManager() ? self->RootManager()->device_scale_factor() : 1;
+  const gfx::PointF point(bounds.CenterPoint().x() / scale, bounds.CenterPoint().y() / scale);
+  if (pointer != Pointer::kScroll && self->on_pointer) self->on_pointer.Run(point);
+  const blink::WebInputEvent::Type last = pointer == Pointer::kClick   ? blink::WebInputEvent::Type::kMouseUp
+                                          : pointer == Pointer::kHover ? blink::WebInputEvent::Type::kMouseMove
+                                                                       : blink::WebInputEvent::Type::kMouseWheel;
+  AckWaiter::Start(widget, last,
+                   base::BindOnce(&Page::Settle, self, std::move(id), std::move(reply)));
+  if (pointer == Pointer::kScroll) return SendWheel(widget, point, dy);
+  SendMouse(widget, blink::WebInputEvent::Type::kMouseMove, point);
+  if (pointer == Pointer::kHover) return;
+  SendMouse(widget, blink::WebInputEvent::Type::kMouseDown, point);
+  SendMouse(widget, blink::WebInputEvent::Type::kMouseUp, point);
+}
+
+void Page::Settle(base::WeakPtr<Page> self, base::Value id, ReplyCallback reply) {
+  if (!self) return std::move(reply).Run(OkReply(id));
+  // Blink batches tree updates (up to a second or so); kSignalEndOfTest makes each frame serialize
+  // what is pending right away and then report kEndOfTest, once its document is clean and loaded.
+  self->settling_.clear();
+  self->web_contents()->GetPrimaryMainFrame()->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+    if (ui::BrowserAccessibilityManager* manager = ManagerFor(frame->GetAXTreeID())) {
+      self->settling_.insert(frame->GetAXTreeID());
+      manager->SignalEndOfTest();
+    }
+  });
+  self->settled_ = base::BindOnce([](base::Value id, ReplyCallback reply) { std::move(reply).Run(OkReply(id)); },
+                                  std::move(id), std::move(reply));
+  if (self->settling_.empty()) return self->Settled();
+  self->settle_timer_.Start(FROM_HERE, kSettleWait, base::BindOnce(&Page::Settled, self));
+}
+
+void Page::Settled() {
+  settle_timer_.Stop();
+  settling_.clear();
+  if (settled_) std::move(settled_).Run();
+}
+
+void Page::AccessibilityEventReceived(const ui::AXUpdatesAndEvents& details) {
+  if (!settled_ || !settling_.contains(details.ax_tree_id) ||
+      std::ranges::none_of(details.events,
+                           [](const ui::AXEvent& event) { return event.event_type == ax::mojom::Event::kEndOfTest; })) {
+    return;
+  }
+  settling_.erase(details.ax_tree_id);
+  // Observers hear of the bundle before the tree applies it: answer after that.
+  if (settling_.empty()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(&Page::Settled, weak_.GetWeakPtr()));
+  }
+}
+
+void Page::FocusIsPassword(base::OnceCallback<void(std::optional<bool>)> done) {
+  web_contents()->RequestAXTreeSnapshot(
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<bool>)> done, ui::AXTreeUpdate& update) {
+            if (update.nodes.empty()) return std::move(done).Run(std::nullopt);
+            const ui::AXNodeID focus = update.tree_data.focus_id;
+            // Fails closed: without the focused node we can't tell where keys would go.
+            for (const ui::AXNodeData& node : update.nodes) {
+              if (node.id == focus) return std::move(done).Run(IsPassword(node));
+            }
+            std::move(done).Run(std::nullopt);
+          },
+          std::move(done)),
+      kMode, /*max_nodes=*/0, kRendererWait, content::WebContents::AXTreeSnapshotPolicy::kAll);
+}
+
+void Page::Type(base::Value id, std::string ref, std::u16string text, ReplyCallback reply) {
+  ui::BrowserAccessibility* node = Resolve(ref);
+  if (!node) return Fail(id, reply, kNotFound, ref);
+  if (IsPassword(node->GetData())) return Fail(id, reply, kDenied, "a password field");
+  // The focus can't land on it (a label's text, a disabled field): the keys would go to the page
+  // and be lost while the op answered ok.
+  if (!node->HasState(ax::mojom::State::kFocusable)) {
+    return Fail(id, reply, kBadRequest,
+                ref + " (" + ui::ToString(node->GetRole()) + ") does not take typing: use the field's ref");
+  }
+  if (paused) return Fail(id, reply, kPaused, "the person took over the tab");
+  node->manager()->SetFocus(*node);
+  // Then, with the focus where it really landed, refuse if that is a password field.
+  FocusIsPassword(base::BindOnce(
+      [](base::WeakPtr<Page> self, base::Value id, std::u16string text, ReplyCallback reply,
+         std::optional<bool> password) {
+        if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+        if (!password) return Fail(id, reply, kFailed, "could not read the page");
+        if (*password) return Fail(id, reply, kDenied, "the focus is on a password field");
+        // One character at a time (a surrogate pair is one).
+        std::vector<Key> keys;
+        for (size_t i = 0; i < text.size();) {
+          const size_t n = (text[i] >= 0xD800 && text[i] < 0xDC00 && i + 1 < text.size()) ? 2 : 1;
+          if (std::optional<Key> key = ParseKey(base::UTF16ToUTF8(text.substr(i, n)), nullptr)) {
+            keys.push_back(std::move(*key));
+          }
+          i += n;
+        }
+        if (keys.empty()) return std::move(reply).Run(OkReply(id));
+        if (self->paused) return Fail(id, reply, kPaused, "the person took over the tab");
+        content::RenderWidgetHost* widget = self->FocusedWidget();
+        AckWaiter::Start(widget, blink::WebInputEvent::Type::kKeyUp,
+                         base::BindOnce(&Page::Settle, self, std::move(id), std::move(reply)),
+                         static_cast<int>(keys.size()));
+        for (const Key& key : keys) SendKey(widget, key);
+      },
+      weak_.GetWeakPtr(), std::move(id), std::move(text), std::move(reply)));
+}
+
+void Page::PressKey(base::Value id, Key key, ReplyCallback reply) {
+  if (!clipboard && TouchesClipboard(key)) return Fail(id, reply, kDenied, "copy, cut and paste are not available");
+  FocusIsPassword(base::BindOnce(
+      [](base::WeakPtr<Page> self, base::Value id, Key key, ReplyCallback reply, std::optional<bool> password) {
+        if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+        if (!password) return Fail(id, reply, kFailed, "could not read the page");
+        if (!KeyAllowed(key, *password, self->clipboard)) {
+          return Fail(id, reply, kDenied, "the focus is on a password field: only keys that move");
+        }
+        if (self->paused) return Fail(id, reply, kPaused, "the person took over the tab");
+        content::RenderWidgetHost* widget = self->FocusedWidget();
+        AckWaiter::Start(widget, blink::WebInputEvent::Type::kKeyUp,
+                         base::BindOnce(&Page::Settle, self, std::move(id), std::move(reply)));
+        SendKey(widget, key);
+      },
+      weak_.GetWeakPtr(), std::move(id), std::move(key), std::move(reply)));
+}
+
+void Page::Screenshot(base::Value id, ReplyCallback reply) {
+  // The page as it is now: a password field showing its text would show in the picture.
+  web_contents()->RequestAXTreeSnapshot(
+      base::BindOnce(
+          [](base::WeakPtr<Page> self, base::Value id, ReplyCallback reply, ui::AXTreeUpdate& update) {
+            if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+            if (update.nodes.empty()) return Fail(id, reply, kFailed, "could not read the page");
+            if (AnyRevealedPassword(update)) return Fail(id, reply, kDenied, "a password field shows its text");
+            content::RenderWidgetHostView* view = self->web_contents()->GetRenderWidgetHostView();
+            if (!view) return Fail(id, reply, kFailed, "the tab shows nothing");
+            // The visible viewport at 1x (DIPs), which keeps the reply small.
+            view->CopyFromSurface(
+                gfx::Rect(), view->GetViewBounds().size(), kRendererWait,
+                base::BindOnce(
+                    [](base::WeakPtr<Page> self, base::Value id, ReplyCallback reply,
+                       const content::CopyFromSurfaceResult& result) {
+                      if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+                      if (!result.has_value() || result->bitmap.drawsNothing()) {
+                        return Fail(id, reply, kFailed, "could not capture the tab");
+                      }
+                      std::optional<std::vector<uint8_t>> png =
+                          gfx::PNGCodec::EncodeBGRASkBitmap(result->bitmap, /*discard_transparency=*/true);
+                      if (!png) return Fail(id, reply, kFailed, "could not encode the picture");
+                      // Again after the capture: one revealed meanwhile may be in the picture.
+                      self->web_contents()->RequestAXTreeSnapshot(
+                          base::BindOnce(
+                              [](base::Value id, ReplyCallback reply, std::vector<uint8_t> png,
+                                 ui::AXTreeUpdate& update) {
+                                if (update.nodes.empty()) return Fail(id, reply, kFailed, "could not read the page");
+                                if (AnyRevealedPassword(update)) {
+                                  return Fail(id, reply, kDenied, "a password field shows its text");
+                                }
+                                base::DictValue out;
+                                out.Set("png", base::Base64Encode(png));
+                                std::move(reply).Run(OkReply(id, std::move(out)));
+                              },
+                              std::move(id), std::move(reply), std::move(*png)),
+                          kMode, /*max_nodes=*/0, kRendererWait,
+                          content::WebContents::AXTreeSnapshotPolicy::kAll);
+                    },
+                    self, std::move(id), std::move(reply)));
+          },
+          weak_.GetWeakPtr(), std::move(id), std::move(reply)),
+      kMode, /*max_nodes=*/0, kRendererWait, content::WebContents::AXTreeSnapshotPolicy::kAll);
+}
+
+}  // namespace agens::bridge::control
diff --git a/chrome/browser/agens/bridge/control_page.h b/chrome/browser/agens/bridge/control_page.h
new file mode 100644
index 0000000000..e4b296e266
--- /dev/null
+++ b/chrome/browser/agens/bridge/control_page.h
@@ -0,0 +1,150 @@
+// Copyright 2026 SugiyamaLabs.
+// The page side of a controlled tab (page.* in docs/protocolo.md): its accessibility tree with
+// refs, real input on its widget, and screenshots. UI thread. Password rules, checked against the
+// page as it is when the action runs:
+// - a field that is or was a password field (Blink keeps that for the element's life) shows no
+//   value and takes no typing; while one has the focus, only keys that move go through;
+// - no screenshot while such a field shows its text;
+// - the clipboard is never touched, unless the session was allowed "clipboard".
+// page.console and page.network never carry headers, cookies or bodies; URLs lose any user,
+// password and fragment in them.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_CONTROL_PAGE_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_CONTROL_PAGE_H_
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "third_party/blink/public/mojom/devtools/console_message.mojom-forward.h"
+#include "third_party/blink/public/mojom/loader/resource_load_info.mojom-forward.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+#include "chrome/browser/agens/bridge/ops.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/accessibility/ax_tree_id.h"
+#include "ui/gfx/geometry/point_f.h"
+
+namespace content {
+class RenderWidgetHost;
+class ScopedAccessibilityMode;
+}  // namespace content
+namespace ui {
+class BrowserAccessibility;
+class BrowserAccessibilityManager;
+struct AXUpdatesAndEvents;
+}  // namespace ui
+
+namespace agens::bridge::control {
+
+class Page : public content::WebContentsObserver {
+ public:
+  // Turns accessibility on for this tab only, for as long as it lives.
+  explicit Page(content::WebContents* contents);
+  ~Page() override;
+
+  // One op at a time per tab, in the order they came: each password check sees what the ops
+  // before it did. `op` gets the reply to run when it's done; the next op starts after that.
+  // Past kMaxWaitingOps waiting, answers bad_request.
+  using Op = base::OnceCallback<void(ReplyCallback)>;
+  void Run(base::Value id, Op op, ReplyCallback reply);
+  // Answers every op still waiting with error `code`; the one running finishes.
+  void FailWaiting(std::string_view code, std::string_view message);
+
+  // Runs with the point (DIPs, from the page's top-left) of each real click, for the shell's cursor.
+  base::RepeatingCallback<void(gfx::PointF)> on_pointer;
+  // control.start's "clipboard": copy, cut and paste keys go through, also on a password field.
+  bool clipboard = false;
+  // control.start's "eval": page.eval may run (on a local page only).
+  bool eval = false;
+  // The person took over: every op checks it right before it touches the page, and answers
+  // `paused` instead. A step already sent stays sent.
+  bool paused = false;
+
+  // The ops, for Run. Each answers `reply` once, for the request `id`.
+  void Snapshot(base::Value id, ReplyCallback reply);
+  void Click(base::Value id, std::string ref, ReplyCallback reply);
+  void Type(base::Value id, std::string ref, std::u16string text, ReplyCallback reply);
+  void PressKey(base::Value id, Key key, ReplyCallback reply);
+  void Screenshot(base::Value id, ReplyCallback reply);
+  void Hover(base::Value id, std::string ref, ReplyCallback reply);
+  // A wheel scroll by `dy` CSS pixels at `ref`'s center, or the viewport's when it is empty.
+  void Scroll(base::Value id, std::string ref, double dy, ReplyCallback reply);
+  // What the tab's documents logged, and the requests that failed, since the session took it.
+  void Console(base::Value id, ReplyCallback reply);
+  void Network(base::Value id, ReplyCallback reply);
+  // `js` in the main frame's main world, only on a local page (IsLocalURL); the result as JSON.
+  void Eval(base::Value id, std::string js, ReplyCallback reply);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void OnDidAddMessageToConsole(content::RenderFrameHost* frame,
+                                blink::mojom::ConsoleMessageLevel level,
+                                const std::u16string& message,
+                                int32_t line,
+                                const std::u16string& source,
+                                const std::optional<std::u16string>& stack) override;
+  void ResourceLoadComplete(content::RenderFrameHost* frame,
+                            const content::GlobalRequestID& request_id,
+                            const GURL& original_url,
+                            const blink::mojom::ResourceLoadInfo& info) override;
+  void AccessibilityEventReceived(const ui::AXUpdatesAndEvents& details) override;
+
+ private:
+  using Node = std::pair<ui::AXTreeID, int32_t>;
+  enum class Pointer { kClick, kHover, kScroll };
+  struct Waiting {
+    base::Value id;
+    Op op;
+    ReplyCallback reply;
+  };
+
+  void Next();
+  static void Done(base::WeakPtr<Page> self, ReplyCallback reply, std::string line);
+
+  ui::BrowserAccessibilityManager* RootManager();
+  ui::BrowserAccessibility* Resolve(const std::string& ref);
+  content::RenderWidgetHost* FocusedWidget();
+  // Static with a weak `self`, so a reply waiting in a posted task still runs if the tab goes.
+  static void WaitForTree(base::WeakPtr<Page> self, base::TimeTicks deadline, base::OnceClosure then);
+  static void SnapshotNow(base::WeakPtr<Page> self, base::Value id, ReplyCallback reply);
+  static void PointerAttempt(base::WeakPtr<Page> self,
+                             base::Value id,
+                             std::string ref,
+                             Pointer pointer,
+                             double dy,
+                             base::TimeTicks deadline,
+                             bool scrolled,
+                             ReplyCallback reply);
+  // Answers ok for `id` once every frame's accessibility tree has caught up with the input already
+  // sent (or after kSettleWait), so the next page.snapshot shows what it did.
+  static void Settle(base::WeakPtr<Page> self, base::Value id, ReplyCallback reply);
+  void Settled();
+  // Into a ring of kMaxLogEntries, oldest out first.
+  static void Keep(std::deque<base::DictValue>& ring, base::DictValue entry);
+  // Asks the renderer for the page as it is now (after the input already sent) whether the
+  // focused element is or was a password field; nullopt when it can't tell.
+  void FocusIsPassword(base::OnceCallback<void(std::optional<bool>)> done);
+
+  std::unique_ptr<content::ScopedAccessibilityMode> accessibility_;
+  std::deque<Waiting> waiting_;
+  bool busy_ = false;
+  // Refs of the current document, both ways. Cleared when the tab goes to another page.
+  std::map<std::string, Node> nodes_;
+  std::map<Node, std::string> refs_;
+  int next_ref_ = 1;
+  std::deque<base::DictValue> console_, network_;
+  // Settle: the trees still to report, and the answer waiting on them. One op runs at a time.
+  std::set<ui::AXTreeID> settling_;
+  base::OnceClosure settled_;
+  base::OneShotTimer settle_timer_;
+  base::WeakPtrFactory<Page> weak_{this};
+};
+
+}  // namespace agens::bridge::control
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_CONTROL_PAGE_H_
diff --git a/chrome/browser/agens/bridge/extension_ops.cc b/chrome/browser/agens/bridge/extension_ops.cc
