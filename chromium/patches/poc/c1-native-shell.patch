+namespace agens {
+
+class NativeShellView : public views::View, public TabStripModelObserver {
+  METADATA_HEADER(NativeShellView, views::View)
+
+ public:
+  static constexpr int kSidebarWidth = 248;
+  static constexpr int kViewId = 0x4167;  // lookup from the window (Cmd+L)
+
+  explicit NativeShellView(BrowserWindowInterface* browser) : browser_(browser) {
+    SetID(kViewId);
+    SetBackground(views::CreateSolidBackground(SkColorSetRGB(0x0B, 0x0B, 0x0D)));
+    contents_ = AddChildView(std::make_unique<views::WebView>(browser->GetProfile()));
+    // Webium sizes new tabs from this element (GetContentsBoundsInScreen).
+    contents_->SetProperty(views::kElementIdentifierKey, kContentsContainerViewElementId);
+    controller_ = [[AgensSidebarController alloc] initWithShell:this];
+    browser_->GetTabStripModel()->AddObserver(this);
+  }
+  ~NativeShellView() override {
+    [controller_.view removeFromSuperview];
+    contents_->SetWebContents(nullptr);
+  }
+
+  // Called from AppKit.
+  void ActivateTab(int index) {
+    TabStripModel* model = browser_->GetTabStripModel();
+    if (model->ContainsIndex(index)) model->ActivateTabAt(index);
+  }
+  void CloseTab(int index) {
+    TabStripModel* model = browser_->GetTabStripModel();
+    if (model->ContainsIndex(index)) {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE | TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+  void Command(int id) { chrome::ExecuteCommand(browser_, id); }
+  void Navigate(const std::u16string& text) {
+    content::WebContents* active = browser_->GetTabStripModel()->GetActiveWebContents();
+    if (!active || text.empty()) return;
+    AutocompleteMatch match;
+    AutocompleteClassifierFactory::GetForProfile(browser_->GetProfile())
+        ->Classify(text, false, false, metrics::OmniboxEventProto::OTHER, &match, nullptr);
+    if (!match.destination_url.is_valid()) return;
+    active->GetController().LoadURL(match.destination_url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_TYPED, std::string());
+    active->Focus();
+  }
+  void FocusAddress() {
+    [controller_.address.window makeFirstResponder:controller_.address];
+  }
+
+  // views::View:
+  void AddedToWidget() override {
+    // The views content view is layer-hosting and won't draw AppKit subviews, so the
+    // sidebar is a sibling above it in the window frame (below the traffic lights).
+    NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    NSView* side = controller_.view;
+    side.autoresizingMask = NSViewHeightSizable | NSViewMaxXMargin;
+    [window.contentView.superview addSubview:side
+                                  positioned:NSWindowAbove
+                                  relativeTo:window.contentView];
+    Refresh();
+  }
+  void Layout(PassKey) override {
+    NSView* content = controller_.view.superview ? GetWidget()->GetNativeWindow().GetNativeNSWindow().contentView : nil;
+    if (content) {
+      controller_.view.frame = [content convertRect:NSMakeRect(0, 0, kSidebarWidth, NSHeight(content.bounds))
+                                             toView:controller_.view.superview];
+    }
+    // A small inset so the page reads as a card on the window, like the prototype.
+    contents_->SetBounds(kSidebarWidth, 8, width() - kSidebarWidth - 8, height() - 16);
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange&,
+                              const TabStripSelectionChange& selection) override {
+    if (selection.active_tab_changed()) {
+      contents_->SetWebContents(selection.new_contents);
+    }
+    Refresh();
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override { Refresh(); }
+
+ private:
+  void Refresh() {
+    TabStripModel* model = browser_->GetTabStripModel();
+    NSMutableArray<NSString*>* titles = [NSMutableArray array];
+    for (int i = 0; i < model->count(); ++i) {
+      std::u16string title = model->GetWebContentsAt(i)->GetTitle();
+      [titles addObject:base::SysUTF16ToNSString(title.empty() ? u"Nova aba" : title)];
+    }
+    content::WebContents* active = model->GetActiveWebContents();
+    NSString* url = active ? base::SysUTF8ToNSString(active->GetVisibleURL().spec()) : @"";
+    if ([url hasPrefix:@"chrome://newtab"]) url = @"";
+    [controller_ setTabs:titles active:model->active_index() url:url];
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::WebView> contents_;
+  AgensSidebarController* __strong controller_;
+};
+
+BEGIN_METADATA(NativeShellView)
+END_METADATA
+
+std::unique_ptr<views::View> CreateNativeShellView(BrowserWindowInterface* browser) {
+  return std::make_unique<NativeShellView>(browser);
+}
+
+void FocusNativeLocationBar(views::Widget* widget) {
+  if (auto* shell = views::AsViewClass<NativeShellView>(
+          widget->GetRootView()->GetViewByID(NativeShellView::kViewId))) {
+    shell->FocusAddress();
+  }
+}
