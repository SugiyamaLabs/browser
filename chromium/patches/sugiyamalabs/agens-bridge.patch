+  if (_atoNames.count > 1) {  // "Mover para o ato": the address goes, the session (cookies) doesn't
+    [menu addItem:NSMenuItem.separatorItem];
+    NSMenuItem* move = [menu addItemWithTitle:@"Mover para o ato" action:nil keyEquivalent:@""];
+    NSMenu* atos = [[NSMenu alloc] initWithTitle:@""];
