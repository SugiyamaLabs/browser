+// --- webauthn: navigator.credentials.create and get, answered by the host (its own passkey sheet,
+// later the system's through ASAuthorizationController). One proxy for every frame: content asks
+// for it (Frame) right before each request, which is how a request learns its frame.
+
+class HostWebAuthn : public content::WebAuthenticationRequestProxy {
+ public:
+  static HostWebAuthn& Get() {
+    static base::NoDestructor<HostWebAuthn> proxy;
+    return *proxy;
+  }
+  static content::WebAuthenticationRequestProxy* For(content::RenderFrameHost* frame) {
+    Get().frame_ = frame->GetGlobalId();
+    return &Get();
+  }
+
+  bool IsActive(const url::Origin& caller_origin) override { return true; }
+  RequestId SignalCreateRequest(const blink::mojom::PublicKeyCredentialCreationOptionsPtr& options,
+                                CreateCallback callback) override {
+    return Start("create", webauthn::ToValue(options), options->remote_desktop_client_override, std::move(callback));
+  }
+  RequestId SignalGetRequest(const blink::mojom::PublicKeyCredentialRequestOptionsPtr& options,
+                             GetCallback callback) override {
+    return Start("get", webauthn::ToValue(options), options->extensions->remote_desktop_client_override,
+                 std::move(callback));
+  }
+  RequestId SignalIsUvpaaRequest(IsUvpaaCallback callback) override {
+    // shortcut: the host's word (host.settings webauthn_platform), not asked per request; ask
+    // per origin when the host gets the system's passkeys.
+    std::move(callback).Run(g_browser_process->local_state()->GetBoolean(kWebAuthnPlatformPref));
+    return ++next_;
+  }
+  void CancelRequest(RequestId id) override {
+    auto it = pending_.find(id);
+    if (it == pending_.end()) return;
+    Withdraw(it->second.ask);
+    pending_.erase(it);  // content gave up on it: no callback
+  }
+
+ private:
+  friend class base::NoDestructor<HostWebAuthn>;
+  HostWebAuthn() = default;
+  using Callback = std::variant<CreateCallback, GetCallback>;
+  struct Open {
+    int ask = 0;
+    Callback done;
+  };
+
+  RequestId Start(const char* type,
+                  base::Value request,
+                  const blink::mojom::RemoteDesktopClientOverridePtr& caller,
+                  Callback done) {
+    const RequestId id = ++next_;
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(std::exchange(frame_, {}));
+    content::WebContents* contents = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+    pending_[id].done = std::move(done);
+    // The agent never answers a passkey: cancelled for it until "Assumir". Posted: content takes
+    // the id first.
+    if (!contents || !caller || AgentWorking(contents)) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&HostWebAuthn::Answered, base::Unretained(this), id, std::string(type),
+                                    static_cast<const base::DictValue*>(nullptr)));
+      return id;
+    }
+    base::DictValue fields;
+    fields.Set("type", type);
+    fields.Set("origin", caller->origin.Serialize());
+    fields.Set("cross_origin", !caller->same_origin_with_ancestors);
+    fields.Set("request", std::move(request));
+    pending_[id].ask = Ask(contents, "webauthn", std::move(fields),
+                           base::BindOnce(&HostWebAuthn::Answered, base::Unretained(this), id, std::string(type)));
+    return id;
+  }
+
+  // The response was checked in HandleAnswer; anything else is the page's NotAllowedError.
+  void Answered(RequestId id, const std::string& type, const base::DictValue* answer) {
+    auto it = pending_.find(id);
+    if (it == pending_.end()) return;
+    Callback done = std::move(it->second.done);
+    pending_.erase(it);
+    const base::DictValue* response = answer ? answer->FindDict("response") : nullptr;
+    const std::string* error = answer ? answer->FindString("error") : nullptr;
+    auto exception = [&] {
+      return blink::mojom::WebAuthnDOMExceptionDetails::New(
+          error ? *error : "NotAllowedError",
+          error ? "The host refused the request." : "The request was cancelled or timed out.");
+    };
+    if (auto* create = std::get_if<CreateCallback>(&done)) {
+      blink::mojom::MakeCredentialAuthenticatorResponsePtr made;
+      if (response) made = webauthn::MakeCredentialResponseFromValue(base::Value(response->Clone())).first;
+      if (made) return std::move(*create).Run(id, nullptr, std::move(made));
+      return std::move(*create).Run(id, exception(), nullptr);
+    }
+    blink::mojom::GetAssertionAuthenticatorResponsePtr got;
+    if (response) got = webauthn::GetAssertionResponseFromValue(base::Value(response->Clone())).first;
+    if (got) return std::move(std::get<GetCallback>(done)).Run(id, nullptr, std::move(got));
+    std::move(std::get<GetCallback>(done)).Run(id, exception(), nullptr);
+  }
+
+  content::GlobalRenderFrameHostId frame_;
+  std::map<RequestId, Open> pending_;
+  RequestId next_ = 0;
+};
+
+// A webauthn answer's response, as the page's request type wants it.
+bool ResponseFits(const base::DictValue& asked, const base::DictValue& body) {
+  const base::DictValue* response = body.FindDict("response");
+  if (!response) return true;  // an error
+  const std::string* type = asked.FindString("type");
+  base::Value value(response->Clone());
+  return type && (*type == "create" ? !!webauthn::MakeCredentialResponseFromValue(value).first
+                                    : !!webauthn::GetAssertionResponseFromValue(value).first);
+}
+
+// --- view.print_pdf: the tab's PDF, in <user data>/print/v<n>/page.pdf (0600, its folder 0700).
+
+base::FilePath PrintRoot() {
+  base::FilePath dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &dir);
+  return dir.Append("print");
+}
+
+// Every write and delete of the PDFs, in order (a delete at startup never follows a new PDF).
+scoped_refptr<base::SequencedTaskRunner> PdfFiles() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> files(
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock(), base::TaskPriority::USER_VISIBLE}));
+  return *files;
+}
+
+void DeleteLater(base::FilePath path) {
+  PdfFiles()->PostTask(FROM_HERE, base::GetDeletePathRecursivelyCallback(std::move(path)));
+}
+
+// The tab's PDF folder: goes with the tab.
+class PrintedPdf : public content::WebContentsUserData<PrintedPdf> {
+ public:
+  ~PrintedPdf() override { DeleteLater(dir_); }
+  const base::FilePath& dir() const { return dir_; }
+
+ private:
+  PrintedPdf(content::WebContents* contents, base::FilePath dir)
+      : content::WebContentsUserData<PrintedPdf>(*contents), dir_(std::move(dir)) {}
+  friend class content::WebContentsUserData<PrintedPdf>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+  const base::FilePath dir_;
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PrintedPdf);
+
+// Pages of a PDF as Chromium writes it (Skia): its "/Type /Page" objects. shortcut: not a PDF
+// parser; a PDF from elsewhere (compressed object streams) would count 0.
+int CountPages(std::string_view pdf) {
+  int pages = 0;
+  for (size_t at = pdf.find("/Type"); at != std::string_view::npos; at = pdf.find("/Type", at + 5)) {
+    size_t i = at + 5;
+    while (i < pdf.size() && (pdf[i] == ' ' || pdf[i] == '\n' || pdf[i] == '\r')) ++i;
+    if (pdf.substr(i, 5) == "/Page" && (i + 5 >= pdf.size() || !base::IsAsciiAlpha(pdf[i + 5]))) ++pages;
+  }
+  return pages;
+}
+
+// Off the UI thread: replaces the folder's PDF. The size, or nullopt when it could not be written.
+std::optional<int64_t> WritePdf(const base::FilePath& dir, const base::FilePath& path, std::string data) {
+  if (!base::DeletePathRecursively(dir) || !base::CreateDirectory(dir)) return std::nullopt;  // 0700
+  base::File file(path, base::File::FLAG_CREATE | base::File::FLAG_WRITE);  // 0600
+  if (!file.IsValid() || !file.WriteAtCurrentPosAndCheck(base::as_byte_span(data))) return std::nullopt;
+  return static_cast<int64_t>(data.size());
+}
+
+// Reads an optional value of `body`; false when it is there with another type.
+bool OptionalBool(const base::DictValue& body, std::string_view key, std::optional<bool>& out) {
+  const base::Value* value = body.Find(key);
+  if (value && !value->is_bool()) return false;
+  if (value) out = value->GetBool();
+  return true;
+}
+bool OptionalNumber(const base::DictValue& body, std::string_view key, std::optional<double>& out) {
+  const base::Value* value = body.Find(key);
+  if (value && !(value->is_int() || value->is_double())) return false;
+  if (value) out = value->GetDouble();
+  return true;
+}
+
+}  // namespace
+
+int Ask(content::WebContents* contents, std::string_view kind, base::DictValue fields, AnswerCallback done) {
+  State& s = S();
+  const int tab = contents ? view::TabNumber(contents) : 0;
+  const size_t of_tab = std::ranges::count_if(s.asks, [tab](const auto& p) { return tab && p->tab == tab; });
+  if (!view::Host() || s.asks.size() >= kMaxOpenUiAsks || of_tab >= kMaxOpenUiAsksPerTab ||
+      (contents && contents->IsBeingDestroyed())) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), static_cast<const base::DictValue*>(nullptr)));
+    return 0;
+  }
+  auto p = std::make_unique<Pending>();
+  p->n = ++s.next;
+  p->kind = std::string(kind);
+  p->tab = tab;
+  p->done = std::move(done);
+  p->fields = std::move(fields);
+  p->fields.Set("ask", "u" + base::NumberToString(p->n));
+  p->fields.Set("kind", kind);
+  ClipUiAsk(p->fields);
+  if (contents) {
+    p->fields.Set("tab", ViewTabName(p->tab));
+    if (!Watch::FromWebContents(contents)) Watch::CreateForWebContents(contents, p->tab);
+  }
+  const int n = p->n;
+  s.asks.push_back(std::move(p));
+  SendNext();
+  return n;
+}
+
+void Withdraw(int ask) {
+  std::unique_ptr<Pending> p = Take(ask);
+  if (!p) return;
+  TellCancelled(*p, "gone");
+  SendNext();
+}
+
+bool Update(int ask, base::DictValue fields) {
+  Pending* p = Find(ask);
+  if (!p) return false;
+  p->fields.Merge(fields.Clone());
+  ClipUiAsk(p->fields);
+  if (!p->sent || p->checking || !view::Host()) return false;
+  fields.Set("ask", *p->fields.FindString("ask"));
+  fields.Set("kind", p->kind);
+  if (const std::string* tab = p->fields.FindString("tab")) fields.Set("tab", *tab);
+  ClipUiAsk(fields);
+  SendEventTo(view::Host(), "ui.update", std::move(fields));
+  return true;
+}
+
+bool Sent(int ask) {
+  const Pending* p = Find(ask);
+  return p && p->sent;
+}
+
+void TabClosing(content::WebContents* contents) {
+  if (Watch::FromWebContents(contents)) EndTab(view::TabNumber(contents), "closed");
+}
+
+bool AgentWorking(content::WebContents* contents) {
+  const AgensControlled* controlled = contents ? AgensControlled::FromWebContents(contents) : nullptr;
+  return controlled && !controlled->paused;
+}
+
+void HandleAnswer(bool from_host, const Request& request, ReplyCallback reply) {
+  const std::string* ask = request.body.FindString("ask");
+  Pending* p = nullptr;
+  for (auto& candidate : S().asks) {
+    if (ask && candidate->sent && !candidate->checking && *candidate->fields.FindString("ask") == *ask) {
+      p = candidate.get();
+    }
+  }
+  switch (CheckUiAnswer(from_host, p ? &p->fields : nullptr, request.body)) {
+    case UiAnswer::kUnauthorized:
+      return std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs host.attach on this connection"));
+    case UiAnswer::kNotFound:
+      return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ask));
+    case UiAnswer::kBadRequest:
+      return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ask, and fields that fit its kind"));
+    case UiAnswer::kCancel:  // the host's {cancel: true} comes as is: the person decided
+      return Finish(p->n, request.id, std::move(reply), request.body.Clone());
+    case UiAnswer::kAnswer:
+      break;
+  }
+  if (p->kind == "webauthn" && !ResponseFits(p->fields, request.body)) {
+    return std::move(reply).Run(
+        ErrorReply(&request.id, kBadRequest, "response is not a PublicKeyCredential (JSON) for this request"));
+  }
+  if (p->kind != "file") return Finish(p->n, request.id, std::move(reply), request.body.Clone());
+  // The paths are checked on disk, off this thread; the ask can't be answered twice meanwhile.
+  p->checking = true;
+  const int n = p->n;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&PathsFitMode, *p->fields.FindString("mode"), request.body.FindList("paths")->Clone()),
+      base::BindOnce(
+          [](int n, base::Value id, base::DictValue body, ReplyCallback reply, bool fit) {
+            Pending* p = Find(n);
+            if (!p) return Reply(std::move(id), std::move(reply), kNotFound);
+            p->checking = false;
+            if (!fit) {
+              return std::move(reply).Run(ErrorReply(&id, kBadRequest, "a path does not exist or does not fit the mode"));
+            }
+            Finish(n, id, std::move(reply), std::move(body));
+          },
+          n, request.id.Clone(), request.body.Clone(), std::move(reply)));
+}
+
+void HostGone() {
+  std::vector<std::unique_ptr<Pending>> asks = std::move(S().asks);
+  S().asks.clear();
+  for (auto& p : asks) std::move(p->done).Run(nullptr);
+  DeleteLater(PrintRoot());  // the PDFs were the host's
+}
+
+void BindDateTimeChooser(content::RenderFrameHost* frame,
+                         mojo::PendingReceiver<blink::mojom::DateTimeChooser> receiver) {
+  mojo::MakeSelfOwnedReceiver(std::make_unique<HostDateChooser>(frame->GetGlobalId()), std::move(receiver));
+}
+
+void AskPrint(content::WebContents* contents) {
+  if (!contents || AgentWorking(contents)) return;
+  base::DictValue fields;
+  fields.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  fields.Set("url", contents->GetLastCommittedURL().spec());
+  Ask(contents, "print", std::move(fields), base::DoNothing());  // the host's cancel: it is done
+}
+
+bool LaunchExternal(content::WebContents* contents,
+                    const GURL& url,
+                    const std::optional<url::Origin>& initiator,
+                    bool gesture) {
+  const uint64_t host = view::Host();
+  const int n = host && contents ? view::KnownTab(contents) : 0;
+  if (!n || AgentWorking(contents) || url.spec().size() > kMaxUiUrlBytes) return false;
+  base::DictValue fields;
+  fields.Set("tab", ViewTabName(n));
+  fields.Set("url", url.spec());
+  fields.Set("scheme", url.GetScheme());
+  // As Chromium's own dialog names it: an opaque origin by what it came from.
+  if (initiator) fields.Set("origin", initiator->GetTupleOrPrecursorTupleIfOpaque().Serialize());
+  fields.Set("gesture", gesture);
+  SendEventTo(host, "view.external", std::move(fields));
+  return true;
+}
+
+void PrintPdf(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  const base::DictValue& body = request.body;
+  std::optional<bool> landscape, background, header_footer, css_page_size;
+  std::optional<double> scale, paper_width, paper_height, top, bottom, left, right;
+  const base::Value* margins = body.Find("margins");
+  const base::Value* ranges = body.Find("page_ranges");
+  const bool typed =
+      OptionalBool(body, "landscape", landscape) && OptionalBool(body, "background", background) &&
+      OptionalBool(body, "header_footer", header_footer) && OptionalBool(body, "css_page_size", css_page_size) &&
+      OptionalNumber(body, "scale", scale) && OptionalNumber(body, "paper_width", paper_width) &&
+      OptionalNumber(body, "paper_height", paper_height) && (!ranges || ranges->is_string()) &&
+      (!margins || (margins->is_dict() && OptionalNumber(margins->GetDict(), "top", top) &&
+                    OptionalNumber(margins->GetDict(), "bottom", bottom) &&
+                    OptionalNumber(margins->GetDict(), "left", left) &&
+                    OptionalNumber(margins->GetDict(), "right", right)));
+  if (!typed) {
+    return std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                           "landscape, background, header_footer and css_page_size are booleans; "
+                                           "scale, paper_width, paper_height and margins.* numbers; page_ranges text"));
+  }
+  if (AgentWorking(contents)) {
+    return std::move(reply).Run(ErrorReply(&request.id, kDenied, "an agent is working on this tab"));
+  }
+  content::RenderFrameHost* frame = contents->GetPrimaryMainFrame();
+  auto params = print_to_pdf::GetPrintPagesParams(frame->GetLastCommittedURL(), landscape, header_footer, background,
+                                                  scale, paper_width, paper_height, top, bottom, left, right,
+                                                  /*header_template=*/std::nullopt, /*footer_template=*/std::nullopt,
+                                                  css_page_size.value_or(true), /*generate_tagged_pdf=*/std::nullopt,
+                                                  /*generate_document_outline=*/std::nullopt);
+  if (auto* error = std::get_if<std::string>(&params)) {
+    return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, *error));
+  }
+  auto* manager = printing::PrintViewManager::FromWebContents(contents);
+  if (!manager) return std::move(reply).Run(ErrorReply(&request.id, kFailed, "printing is not available here"));
+  const base::FilePath dir = PrintRoot().Append(ViewTabName(view::TabNumber(contents)));
+  PrintedPdf::CreateForWebContents(contents, dir);  // no-op once it exists
+  manager->PrintToPdf(
+      frame, ranges ? ranges->GetString() : std::string(),
+      std::move(std::get<printing::mojom::PrintPagesParamsPtr>(params)),
+      base::BindOnce(
+          [](base::Value id, base::FilePath dir, ReplyCallback reply, print_to_pdf::PdfPrintResult result,
+             scoped_refptr<base::RefCountedMemory> data) {
+            using R = print_to_pdf::PdfPrintResult;
+            if (result != R::kPrintSuccess || !data) {
+              const bool caller = result == R::kPageRangeSyntaxError || result == R::kPageRangeInvalidRange ||
+                                  result == R::kPageCountExceeded;
+              return std::move(reply).Run(
+                  ErrorReply(&id, caller ? kBadRequest : kFailed, print_to_pdf::PdfPrintResultToString(result)));
+            }
+            std::string pdf(base::as_string_view(base::span(*data)));
+            const int pages = CountPages(pdf);
+            const base::FilePath path = dir.Append("page.pdf");
+            PdfFiles()->PostTaskAndReplyWithResult(
+                FROM_HERE, base::BindOnce(&WritePdf, dir, path, std::move(pdf)),
+                base::BindOnce(
+                    [](base::Value id, base::FilePath path, int pages, ReplyCallback reply,
+                       std::optional<int64_t> bytes) {
+                      if (!bytes) return std::move(reply).Run(ErrorReply(&id, kFailed, "could not write the PDF"));
+                      base::DictValue result;
+                      result.Set("path", path.value());
+                      result.Set("bytes", static_cast<double>(*bytes));
+                      result.Set("pages", pages);
+                      std::move(reply).Run(OkReply(id, std::move(result)));
+                    },
+                    std::move(id), path, pages, std::move(reply)));
+          },
+          request.id.Clone(), dir, std::move(reply)));
+}
+
+void Start() {
+  static bool started = false;
+  if (started || !IsEmbedded()) return;
+  started = true;
+  content::SetAgensEmbedSelectHandler(base::BindRepeating(&Select));
+  content::SetAgensEmbedContextMenuHandler(base::BindRepeating(&ContextMenu));
+  // A DevTools window is on screen by itself: its menus and lists are Chromium's. A DevTools view
+  // has no window: its menus and lists go to the host (ContextMenu, Select).
+  content::SetAgensEmbedOwnWindow(base::BindRepeating(&view::InOwnDevToolsWindow));
+  content::SetAgensEmbedCursorCallbacks(base::BindRepeating(&CursorChanged), base::BindRepeating(&CaretChanged));
+  content::SetAgensEmbedColorChooser(base::BindRepeating(&OpenColor));
+  content::SetAgensEmbedWebAuthn(base::BindRepeating(&HostWebAuthn::For));
+  ::ui::SelectFileDialog::SetFactory(std::make_unique<HostFileDialogFactory>());
+  DeleteLater(PrintRoot());  // what a crash or a killed host left
+}
+
+content::JavaScriptDialogManager* Dialogs() {
+  return &TheDialogs();
+}
+
+void HandDialogsTo(content::WebContents* contents, content::JavaScriptDialogManager* to) {
+  TheDialogs().HandTo(contents, to);
+}
+
+}  // namespace agens::bridge::ui_ask
