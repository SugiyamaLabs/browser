new file mode 100644
index 0000000000..64f981ee02
--- /dev/null
+++ b/chrome/browser/agens/embed/native_shell_mac.mm
@@ -0,0 +1,155 @@
+// Copyright 2026 SugiyamaLabs.
+// The macOS host: the views::View that fills the Webium window, puts the UI's chrome (an NSView)
+// over it and the active tab in the page card. Everything else is shared (agens_window.h,
+// native_shell.cc); Windows writes its own host next to this one.
+
+#include "chrome/browser/agens/embed/native_shell.h"
+
+#import <AppKit/AppKit.h>
+
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_rep.h"
+#include "ui/base/base_window.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+
+namespace agens {
+
+namespace {
+
+class NativeShellView : public views::View, public TabStripModelObserver {
+  METADATA_HEADER(NativeShellView, views::View)
+
+ public:
+  static constexpr float kRadius = 12;  // the page card, as in the prototype
+  static constexpr int kViewId = 0x4167;  // lookup from the window (Cmd+L)
+
+  explicit NativeShellView(BrowserWindowInterface* browser)
+      : window_(std::make_unique<AgensWindow>(browser)) {
+    SetID(kViewId);
+    card_ = AddChildView(std::make_unique<views::View>());
+    // An invisible view where the address's site icon is, under Chromium's id for it, so
+    // permission and site-info bubbles have an anchor (without it they crash looking for the
+    // Views toolbar).
+    site_icon_ = AddChildView(std::make_unique<views::View>());
+    site_icon_->SetProperty(views::kElementIdentifierKey, kLocationIconElementId);
+    contents_ = AddChildView(std::make_unique<views::WebView>(browser->GetProfile()));
+    // Webium sizes new tabs from this element (GetContentsBoundsInScreen).
+    contents_->SetProperty(views::kElementIdentifierKey, kContentsContainerViewElementId);
+    browser->GetTabStripModel()->AddObserver(this);
+    window_->relayout = base::BindRepeating(
+        [](NativeShellView* view) {
+          view->InvalidateLayout();
+          view->SchedulePaint();
+        },
+        base::Unretained(this));
+    chrome_ = (__bridge_transfer NSView*)agens_ui_create_chrome(window_.get());
+  }
+  ~NativeShellView() override {
+    agens_ui_destroy_chrome((__bridge void*)chrome_);
+    [chrome_ removeFromSuperview];
+    contents_->SetWebContents(nullptr);
+  }
+
+  void FocusAddress() { agens_ui_focus_address((__bridge void*)chrome_); }
+  StatusBubble* status_bubble() { return &window_->status_bubble; }
+
+  // views::View:
+  void AddedToWidget() override {
+    // The views content view is layer-hosting and won't draw AppKit subviews, so the chrome
+    // is a sibling above it in the window frame (below the traffic lights).
+    NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    [window.contentView.superview addSubview:chrome_
+                                  positioned:NSWindowAbove
+                                  relativeTo:window.contentView];
+  }
+  void Layout(PassKey) override {
+    if (chrome_.superview) {
+      NSView* content = GetWidget()->GetNativeWindow().GetNativeNSWindow().contentView;
+      chrome_.frame = [content convertRect:content.bounds toView:chrome_.superview];
+    }
+    // The UI owns the colors (light/dark); the engine paints them behind its views.
+    unsigned window_color = 0, page_color = 0, line_color = 0;
+    agens_ui_colors((__bridge void*)chrome_, &window_color, &page_color, &line_color);
+    auto sk = [](unsigned rgb) { return SkColorSetRGB((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255); };
+    SetBackground(views::CreateSolidBackground(sk(window_color)));
+    card_->SetBackground(views::CreateRoundedRectBackground(sk(page_color), kRadius, 1));
+    card_->SetBorder(views::CreateRoundedRectBorder(1, kRadius, sk(line_color)));
+    AgensRect page = agens_ui_layout((__bridge void*)chrome_, width(), height());
+    AgensRect icon = agens_ui_site_icon_rect((__bridge void*)chrome_);
+    site_icon_->SetBounds(icon.x, icon.y, icon.width, icon.height);
+    gfx::Rect card(page.x, page.y, page.width, page.height);
+    card_->SetBoundsRect(card);
+    card.Inset(1);
+    contents_->SetBoundsRect(card);
+    contents_->holder()->SetNativeViewCornerRadii(gfx::RoundedCornersF(kRadius - 1));
+  }
+
+  // TabStripModelObserver: the page area follows the active tab.
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                              const TabStripSelectionChange& selection) override {
+    if (selection.active_tab_changed()) {
+      contents_->SetWebContents(selection.new_contents);
+      contents_->holder()->SetNativeViewCornerRadii(gfx::RoundedCornersF(kRadius - 1));
+      // New tabs open ready to type, as in BrowserView::RestoreFocus. Posted so it lands after
+      // the window gives the new contents focus.
+      if (selection.new_contents && selection.new_contents->FocusLocationBarByDefault()) {
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&NativeShellView::FocusAddress, weak_.GetWeakPtr()));
+      }
+    }
+  }
+
+ private:
+  std::unique_ptr<AgensWindow> window_;
+  base::WeakPtrFactory<NativeShellView> weak_{this};
+  raw_ptr<views::View> card_;
+  raw_ptr<views::View> site_icon_;
+  raw_ptr<views::WebView> contents_;
+  NSView* __strong chrome_;
+};
+
+BEGIN_METADATA(NativeShellView)
+END_METADATA
+
+}  // namespace
+
+std::unique_ptr<views::View> CreateNativeShellView(BrowserWindowInterface* browser) {
+  return std::make_unique<NativeShellView>(browser);
+}
+
+StatusBubble* NativeStatusBubble(views::Widget* widget) {
+  auto* shell = views::AsViewClass<NativeShellView>(
+      widget->GetRootView()->GetViewByID(NativeShellView::kViewId));
+  return shell ? shell->status_bubble() : nullptr;
+}
+
+void ConfirmCloseWithDownloads(views::Widget* widget, int count, base::OnceCallback<void(bool)> callback) {
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = count == 1 ? @"Há um download em andamento" : [NSString stringWithFormat:@"Há %d downloads em andamento", count];
+  alert.informativeText = count == 1 ? @"Se fechar agora, ele é cancelado." : @"Se fechar agora, eles são cancelados.";
+  [alert addButtonWithTitle:@"Continuar baixando"];
+  [alert addButtonWithTitle:@"Fechar e cancelar"];
+  __block base::OnceCallback<void(bool)> answer = std::move(callback);
+  [alert beginSheetModalForWindow:widget->GetNativeWindow().GetNativeNSWindow()
+                completionHandler:^(NSModalResponse response) {
+                  std::move(answer).Run(response == NSAlertSecondButtonReturn);
+                }];
+}
+
+void FocusNativeLocationBar(views::Widget* widget) {
+  if (auto* shell = views::AsViewClass<NativeShellView>(
+          widget->GetRootView()->GetViewByID(NativeShellView::kViewId))) {
+    shell->FocusAddress();
+  }
+}
+
+}  // namespace agens
diff --git a/chrome/browser/agens/ui/chrome_mac.mm b/chrome/browser/agens/ui/chrome_mac.mm
new file mode 100644
index 0000000000..826500b9b0
--- /dev/null
+++ b/chrome/browser/agens/ui/chrome_mac.mm
@@ -0,0 +1,1517 @@
+// Copyright 2026 SugiyamaLabs.
+// The browser's chrome on macOS, from prototipos/janela.html (tabs on the side): a 52 pt toolbar
+// (back, forward, reload, address with suggestions), the tab column with the current ato on top and
+// the atos row at the foot, the page as a rounded card, and our new tab page. Light and dark follow
+// the system. Only AppKit and agens_embed.h here, so it can move to the Swift app unchanged.
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/agens/embed/agens_embed.h"
+#include "chrome/browser/agens/ui/logo_svg.h"
+
+// ---------------------------------------------------------------------------------------------
+// Tokens (docs/visual.md, Grafite): each one dark and light, resolved by the view's appearance.
+
+static NSColor* Hex(unsigned rgb, CGFloat a = 1) {
+  return [NSColor colorWithSRGBRed:((rgb >> 16) & 255) / 255.0
+                             green:((rgb >> 8) & 255) / 255.0
+                              blue:(rgb & 255) / 255.0
+                             alpha:a];
+}
+static BOOL IsDark(NSAppearance* appearance) {
+  return [[appearance bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]]
+      isEqualToString:NSAppearanceNameDarkAqua];
+}
+struct Token {
+  unsigned dark, light;
+  NSColor* color() const {
+    unsigned d = dark, l = light;
+    return [NSColor colorWithName:nil
+                  dynamicProvider:^NSColor*(NSAppearance* a) { return Hex(IsDark(a) ? d : l); }];
+  }
+  unsigned rgb(NSView* v) const { return IsDark(v.effectiveAppearance) ? dark : light; }
+};
+static const Token kBg{0x0B0B0D, 0xFAFAFB}, kSideBg{0x111114, 0xF1F1F4}, kRaise{0x16161A, 0xFFFFFF},
+    kSunk{0x0F0F12, 0xE9E9ED}, kLine{0x24242A, 0xE0E0E5}, kLineStrong{0x3A3A42, 0xCFCFD6},
+    kInk{0xF2F2F4, 0x16161A}, kMute{0x9A9AA4, 0x5C5C66}, kDim{0x8A8A94, 0x71717B},
+    kHover{0x18181C, 0xE8E8EC}, kFloat{0x1A1A1F, 0xFFFFFF}, kRaise2{0x26262D, 0xE2E2E7},
+    kLight3{0xFFC98A, 0xE8893A};
+
+// Layers take a CGColor, which doesn't follow the appearance by itself.
+static CGColorRef CG(const Token& t, NSView* v) {
+  return Hex(t.rgb(v)).CGColor;
+}
+
+// Layout (prototype: toolbar, then body with 14 pt padding, 236 pt sidebar, 10 pt gap).
+static const CGFloat kToolbar = 52, kPad = 14, kSide = 236, kGap = 10, kRow = 32, kAtos = 46;
+static const CGFloat kRail = 40;        // the collapsed column (prototype .collapsed .sidebar)
+static const CGFloat kLightsEnd = 86;   // the traffic lights end at 72; prototype leaves 12+2 pt
+static NSString* const kCollapsedKey = @"AgensSidebarCollapsed";
+
+static NSImage* Symbol(NSString* name, CGFloat size = 15) {
+  NSImage* image = [NSImage imageWithSystemSymbolName:name accessibilityDescription:nil];
+  return [image imageWithSymbolConfiguration:[NSImageSymbolConfiguration
+                                                 configurationWithPointSize:size
+                                                                     weight:NSFontWeightRegular]];
+}
+// Icons from the Agens set (prototipos/janela.html: 20 grid, 1.6 stroke, round caps), drawn as
+// template images so they take the tint like SF Symbols do.
+static NSImage* AgensIcon(NSString* paths, CGFloat size = 17) {
+  NSString* svg = [NSString stringWithFormat:
+      @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' width='%g' height='%g' fill='none' "
+      @"stroke='#000' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'>%@</svg>",
+      size, size, paths];
+  NSImage* image = [[NSImage alloc] initWithData:[svg dataUsingEncoding:NSUTF8StringEncoding]];
+  [image setTemplate:YES];  // "template" is a C++ keyword here
+  return image;
+}
+static NSString* const kIconPlus = @"<path d='M10 4.5V15.5 M4.5 10H15.5'/>";
+static NSString* const kIconStar = @"<path d='M10 3.6l1.9 4 4.3.5-3.2 2.9.9 4.3L10 13.1l-3.9 2.2.9-4.3-3.2-2.9 4.3-.5z'/>";
+static NSString* const kIconClock = @"<circle cx='10' cy='10' r='6.5'/><path d='M10 6.5V10l2.5 1.5'/>";
+static NSString* const kIconDown = @"<path d='M10 4v8.5M6.5 9l3.5 3.5L13.5 9M4.5 15.5h11'/>";
+static NSString* const kIconSettings =
+    @"<circle cx='10' cy='10' r='2.6'/><path d='M10 3v2M10 15v2M3 10h2M15 10h2M5 5l1.4 1.4M13.6 13.6L15 "
+    @"15M5 15l1.4-1.4M13.6 6.4L15 5'/>";
+
+static NSTextField* Label(CGFloat size, NSFontWeight weight, const Token& color) {
+  NSTextField* label = [NSTextField labelWithString:@""];
+  label.font = [NSFont systemFontOfSize:size weight:weight];
+  label.textColor = color.color();
+  label.lineBreakMode = NSLineBreakByTruncatingTail;
+  return label;
+}
+// A sunk, bordered well around a borderless text field (prototype .omni-field).
+static NSTextField* WellField(CGFloat size, NSString* placeholder, NSString* accessibility) {
+  NSTextField* field = [[NSTextField alloc] init];
+  field.bordered = NO;
+  field.drawsBackground = NO;
+  field.focusRingType = NSFocusRingTypeNone;
+  field.font = [NSFont systemFontOfSize:size];
+  field.textColor = kInk.color();
+  field.placeholderAttributedString = [[NSAttributedString alloc]
+      initWithString:placeholder
+          attributes:@{NSForegroundColorAttributeName : kDim.color(), NSFontAttributeName : field.font}];
+  field.lineBreakMode = NSLineBreakByTruncatingTail;
+  field.cell.scrollable = YES;
+  field.cell.usesSingleLineMode = YES;
+  field.accessibilityLabel = accessibility;
+  return field;
+}
+
+// The ato's color lives only on its face (monogram), never on the window. Prototype palette.
+static NSColor* AtoColor(int index) {
+  static const unsigned kColors[] = {0xFF9D5C, 0x3F9CFF, 0xFF7E98, 0xCF6FEA, 0x2BC7C0};
+  return Hex(kColors[index % 5]);
+}
+static NSString* Monogram(NSString* name) {
+  return name.length ? [name substringToIndex:1].uppercaseString : @"?";
+}
+// Rounded tile with the ato's letter, centered both ways (prototype .logo).
+@interface AgensAtoTile : NSView
+@property(nonatomic, copy) NSString* stringValue;
+- (instancetype)initWithSize:(CGFloat)size;
+@end
+@implementation AgensAtoTile {
+  NSTextField* _letter;
+}
+- (instancetype)initWithSize:(CGFloat)size {
+  if ((self = [super initWithFrame:NSMakeRect(0, 0, size, size)])) {
+    self.wantsLayer = YES;
+    self.layer.cornerRadius = size <= 16 ? 4 : 5;
+    _letter = [NSTextField labelWithString:@""];
+    _letter.alignment = NSTextAlignmentCenter;
+    _letter.font = [NSFont systemFontOfSize:size * 0.58 weight:NSFontWeightBold];
+    _letter.textColor = Hex(0x0B0B0D);
+    [self addSubview:_letter];
+  }
+  return self;
+}
+- (NSString*)stringValue {
+  return _letter.stringValue;
+}
+- (void)setStringValue:(NSString*)value {
+  _letter.stringValue = value;
+  self.needsLayout = YES;
+}
+- (void)layout {
+  [super layout];
+  // Center the capital letter itself, not the line box (which sits high in a small tile).
+  // Not flipped: the baseline is -descender above the label's bottom.
+  NSFont* font = _letter.font;
+  CGFloat h = _letter.intrinsicContentSize.height;
+  CGFloat y = NSHeight(self.bounds) / 2 - (font.capHeight / 2 - font.descender);
+  _letter.frame = NSMakeRect(0, y, NSWidth(self.bounds), h);
+}
