+// --- DevTools (Passo 5.5): a view the host lays out next to the page, or its own window.
+
+DevToolsOf* DevToolsFor(content::WebContents* frontend) {
+  for (auto& d : S().devtools) {
+    if (frontend && d->web_contents() == frontend) return d.get();
+  }
+  return nullptr;
+}
+
+// The tab's DevTools, open and not closing.
+DevToolsWindow* OpenDevTools(content::WebContents* tab) {
+  DevToolsWindow* window = DevToolsWindow::GetInstanceForInspectedWebContents(tab);
+  return window && DevToolsFor(window->GetDevToolsWebContents()) ? window : nullptr;
+}
+
+std::string DockOf(DevToolsWindow* window, const DevToolsOf& d) {
+  if (!window->agens_view()) return "window";
+  return d.wanted == "window" ? "bottom" : d.wanted;
+}
+
+// DevToolsWindow::AgensDock: whether a new one opens as a view.
+bool OpensAsView(content::WebContents*) {
+  const State& s = S();
+  return s.host && (s.next_dock.empty() ? s.last_dock : s.next_dock) != "window";
+}
+
+// DevToolsWindow::AgensDock: it shows, as a view or in its window. Tells the host when the side changed.
+void DevToolsShown(DevToolsWindow* window) {
+  State& s = S();
+  content::WebContents* frontend = window->GetDevToolsWebContents();
+  content::WebContents* inspected = window->GetInspectedWebContents();
+  if (!frontend || !inspected) return;
+  DevToolsOf* d = DevToolsFor(frontend);
+  if (!d) {
+    const std::string& wanted = s.next_dock.empty() ? s.last_dock : s.next_dock;
+    s.devtools.push_back(std::make_unique<DevToolsOf>(frontend, NumberOf(frontend), NumberOf(inspected), wanted));
+    d = s.devtools.back().get();
+  }
+  if (window->agens_view() != d->in_views) {
+    d->in_views = window->agens_view();
+    if (d->in_views) {
+      AddView(frontend);
+    } else {
+      RemoveView(frontend);
+    }
+  }
+  const std::string dock = DockOf(window, *d);
+  if (dock == d->sent || !s.host) return;
+  d->sent = dock;
+  base::DictValue fields = TabOnly(d->tab);
+  fields.Set("devtools", ViewTabName(d->n));
+  fields.Set("dock", dock);
+  SendEventTo(s.host, "view.devtools", std::move(fields));
+}
+
+// Puts an open DevTools where the host asks: a side of the page area, or its own window.
+void Dock(DevToolsWindow* window, const std::string& dock) {
+  DevToolsOf* d = DevToolsFor(window->GetDevToolsWebContents());
+  if (!d) return;
+  d->wanted = dock;
+  const bool view = dock != "window";
+  if (view == window->agens_view()) {
+    DevToolsShown(window);  // only the side changed, or nothing
+    return;
+  }
+  if (!view && d->in_views) {
+    // Out of the host's views before a window holds it (DevToolsWindow::SetAgensView).
+    d->in_views = false;
+    RemoveView(window->GetDevToolsWebContents());
+  }
+  window->SetAgensView(view);  // shows it again: DevToolsShown
+}
+
+void DevToolsOf::DidFinishNavigation(content::NavigationHandle* handle) {
+  // The frontend went somewhere else than DevTools: it is closed (posted: inside a navigation).
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() || handle->IsSameDocument() ||
+      handle->GetURL().SchemeIs(content::kChromeDevToolsScheme)) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<content::WebContents> frontend) {
+                       DevToolsWindow* window = frontend ? DevToolsWindow::AsDevToolsWindow(frontend.get()) : nullptr;
+                       if (window) window->AgensClose();
+                     },
+                     web_contents()->GetWeakPtr()));
+}
+
+void DevToolsOf::WebContentsDestroyed() {
+  content::WebContents* frontend = web_contents();
+  if (in_views) {
+    // Not RemoveView: its attachment (Shown) sees the same destruction and goes by itself.
+    std::erase(S().views, frontend);
+    ui_ask::TabClosing(frontend);
+  }
+  if (S().host) {
+    base::DictValue fields = TabOnly(tab);
+    fields.Set("devtools", ViewTabName(n));
+    SendEventTo(S().host, "view.devtools.closed", std::move(fields));
+  }
+  Observe(nullptr);
+  std::erase_if(S().devtools, [this](const std::unique_ptr<DevToolsOf>& d) { return d.get() == this; });  // deletes this
+}
+
+// view.devtools.dock {tab, dock}
+void ViewDevToolsDock(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> dock = StringParam(request.body, "dock");
+  if (!dock || !IsDevToolsDock(*dock)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and dock: bottom, right or window"));
+    return;
+  }
+  DevToolsWindow* window = OpenDevTools(contents);
+  if (!window) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no DevTools is open for this tab"));
+    return;
+  }
+  S().last_dock = *dock;
+  Dock(window, *dock);
+  base::DictValue result;
+  if (window->agens_view()) result.Set("devtools", ViewTabName(NumberOf(window->GetDevToolsWebContents())));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// view.devtools.close {tab}: the view.devtools.closed event follows.
+void ViewDevToolsClose(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  DevToolsWindow* window = OpenDevTools(contents);
+  if (!window) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no DevTools is open for this tab"));
+    return;
+  }
+  window->AgensClose();
+  std::move(reply).Run(OkReply(request.id));
+}
+
+// view.inspect {tab, x?, y?, dock?}: DevTools for the tab, on the element at the point when there is one.
+void ViewInspect(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  double x = 0, y = 0;
+  const bool at = request.body.contains("x") || request.body.contains("y");
+  if (at && !ReadPoint(request.body, x, y)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "x and y go together, as numbers"));
+    return;
+  }
+  const base::Value* dock = request.body.Find("dock");
+  if (dock && !(dock->is_string() && IsDevToolsDock(dock->GetString()))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "dock is bottom, right or window"));
+    return;
+  }
+  if (AgentWorks(contents)) {
+    std::move(reply).Run(ErrorReply(&request.id, kDenied, "an agent is working on this tab"));
+    return;
+  }
+  if (!CanInspect(contents)) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "developer tools are turned off for this page"));
+    return;
+  }
+  // shortcut: the point goes to the main frame, so over a cross-origin iframe Elements shows the
+  // <iframe>; hit-test the frame under it (as the right click's frame does) if hosts need more.
+  const std::string devtools =
+      Inspect(contents, contents->GetPrimaryMainFrame(),
+              at ? std::optional<gfx::Point>(gfx::ToRoundedPoint(gfx::PointF(x, y))) : std::nullopt,
+              dock ? dock->GetString() : std::string());
+  if (!OpenDevTools(contents)) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "DevTools did not open"));
+    return;
+  }
+  base::DictValue result;
+  if (!devtools.empty()) result.Set("devtools", devtools);
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// What the page has selected, in the frame with the focus, read from an isolated world (the page
+// cannot see or patch it). Never inside an <input>: that may be a password field, shown or not.
+constexpr char16_t kSelectionScript[] = uR"((() => {
+  const e = document.activeElement, max = 16384;
+  let t = '';
+  if (e && e.localName === 'textarea') t = e.value.slice(e.selectionStart, e.selectionEnd);
+  else if (!(e && e.localName === 'input')) t = String(getSelection());
+  return {t: t.slice(0, max), cut: t.length > max};
+})())";
+
+void ViewSelection(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  content::RenderFrameHost* frame = contents->GetFocusedFrame();
+  if (!frame) frame = contents->GetPrimaryMainFrame();
+  if (!frame->IsRenderFrameLive()) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "the page is not running"));
+    return;
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      kSelectionScript,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](base::Value id, ReplyCallback reply, base::Value result) {
+                const base::DictValue* got = result.GetIfDict();
+                const std::string* text = got ? got->FindString("t") : nullptr;
+                if (!text) {
+                  std::move(reply).Run(ErrorReply(&id, kFailed, "could not read the page"));
+                  return;
+                }
+                bool cut = false;
+                base::DictValue out;
+                out.Set("text", ClipBytes(*text, kMaxSelectionBytes, cut));
+                if (cut || got->FindBool("cut").value_or(false)) out.Set("truncated", true);
+                std::move(reply).Run(OkReply(id, std::move(out)));
+              },
+              request.id.Clone(), std::move(reply)),
+          base::Value()),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void ApprovalAnswer(const Request& request, ReplyCallback reply) {
+  State& s = S();
+  std::optional<std::string> ask = StringParam(request.body, "ask");
+  std::optional<std::string> answer_text = StringParam(request.body, "answer");
+  std::optional<int> answer = answer_text ? ParseApprovalAnswer(*answer_text) : std::nullopt;
+  if (!ask || !answer) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ask and answer: allow, always or deny"));
+    return;
+  }
+  if (!s.answer || *ask != s.ask) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ask));
+    return;
+  }
+  AgensApprovalAnswer result = static_cast<AgensApprovalAnswer>(*answer);
+  if (result == kAgensApprovalAllowAlways && !s.ask_offers_always) result = kAgensApprovalAllow;
+  ApprovalCallback done = std::move(s.answer);  // running it may ask the next one
+  std::move(reply).Run(OkReply(request.id));
+  std::move(done).Run(result);
+}
+
+void TabOp(const Request& request, ReplyCallback reply) {
+  State& s = S();
+  const std::string& op = request.op;
+  std::optional<int> n = TabParam(request);
+  content::WebContents* contents = n ? FindTab(*n) : nullptr;
+  if (!n) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *request.body.FindString("tab")));
+    return;
+  }
+  // A DevTools frontend is only shown: what acts on it goes through its tab (view.devtools.*).
+  if (IsDevToolsView(contents) && op != "view.attach" && op != "view.resize" && op != "view.detach") {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "a DevTools view is only attached: use its tab"));
+    return;
+  }
+  content::NavigationController& controller = contents->GetController();
+  if (op == "view.attach" || op == "view.resize") {
+    int width = 0, height = 0;
+    double scale = 1;
+    if (!ReadViewSize(request.body, width, height, scale)) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab, width and height (whole points, 1 to 8192) and scale (up to 8)"));
+      return;
+    }
+    // shortcut: `scale` is read but the tab draws at its screen's scale (the layer says which);
+    // honour it per tab when Retina and mixed displays get tested.
+    Shown* shown = FindShown(*n);
+    if (!shown && op == "view.resize") {
+      std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the tab is not attached"));
+      return;
+    }
+    const bool attaching = op == "view.attach";
+    if (!shown) {
+      s.shown.push_back(std::make_unique<Shown>(contents, *n));
+      shown = s.shown.back().get();
+    }
+    shown->Resize(gfx::Size(width, height));
+    if (attaching) SendCurrentLayer(*shown);  // a new size draws anew; the same one may not
+  } else if (op == "view.detach") {
+    std::erase_if(s.shown, [&](const std::unique_ptr<Shown>& shown) { return shown->n == *n; });
+  } else if (op == "view.close") {
+    std::erase_if(s.shown, [&](const std::unique_ptr<Shown>& shown) { return shown->n == *n; });
+    ui_ask::TabClosing(contents);
+    contents->Close();
+  } else if (op == "view.navigate") {
+    ViewNavigate(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.back") {
+    if (controller.CanGoBack()) controller.GoBack();
+  } else if (op == "view.forward") {
+    if (controller.CanGoForward()) controller.GoForward();
+  } else if (op == "view.reload") {
+    controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/true);
+  } else if (op == "view.stop") {
+    contents->Stop();
+  } else if (op == "view.favicon") {
+    ViewFavicon(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.control") {
+    ViewControl(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.pick") {
+    ViewPick(contents, FindShown(*n), request, std::move(reply));
+    return;
+  } else if (op == "view.pick.step") {
+    ViewPickStep(FindShown(*n), request, std::move(reply));
+    return;
+  } else if (op == "view.selection") {
+    ViewSelection(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.inspect") {
+    ViewInspect(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.devtools.dock") {
+    ViewDevToolsDock(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.devtools.close") {
+    ViewDevToolsClose(contents, request, std::move(reply));
+    return;
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  std::move(reply).Run(OkReply(request.id));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return op.starts_with("host.") || op.starts_with("view.") || op == "approval.answer" || op == "ui.answer" ||
+         extension::Handles(op);
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  if (!IsEmbedded()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  if (IsViewInputOp(op)) {
+    Input(client, request);  // never answered, as the spec says
+    return;
+  }
+  if (op == "host.attach") {
+    HostAttach(client, request, std::move(reply));
+    return;
+  }
+  if (op.starts_with("host.") && op != "host.settings") {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  if (op == "ui.answer") {
+    ui_ask::HandleAnswer(client.connection == S().host, request, std::move(reply));
+    return;
+  }
+  if (client.connection != S().host) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs host.attach on this connection"));
+    return;
+  }
+  if (op == "host.settings") {
+    HostSettings(request, std::move(reply));
+  } else if (op == "approval.answer") {
+    ApprovalAnswer(request, std::move(reply));
+  } else if (op == "view.tabs") {
+    ViewTabs(request, std::move(reply));
+  } else if (op == "view.open") {
+    ViewOpen(std::move(request), std::move(reply));
+  } else if (extension::Handles(op)) {
+    extension::HandleOp(client, std::move(request), std::move(reply));
+  } else {
+    TabOp(request, std::move(reply));
+  }
+}
+
+bool CanInspect(content::WebContents* contents) {
+  // What DevToolsWindow::Create checks: asked when it says no, it would show its policy dialog on
+  // the tab's window, which never goes on screen.
+  return DevToolsWindow::AllowDevToolsFor(Profile::FromBrowserContext(contents->GetBrowserContext()), contents);
+}
+
+std::string Inspect(content::WebContents* contents,
+                    content::RenderFrameHost* frame,
+                    std::optional<gfx::Point> at,
+                    std::string dock) {
+  State& s = S();
+  // The picker and DevTools both drive the page's inspect mode (Overlay.setInspectMode).
+  for (auto& shown : s.shown) {
+    if (shown->web_contents() == contents && shown->picker) shown->picker->End(true);
+  }
+  if (dock.empty()) dock = s.last_dock;
+  s.last_dock = dock;
+  // One already open goes where it is asked first, so its window does not come up on the way.
+  if (DevToolsWindow* open = OpenDevTools(contents)) Dock(open, dock);
+  // A new one opens there (OpensAsView); one in its window comes to the front.
+  s.next_dock = dock;
+  if (at) {
+    DevToolsWindow::InspectElement(frame, at->x(), at->y());
+  } else {
+    DevToolsWindow::OpenDevToolsWindow(contents, DevToolsToggleAction::Show(), DevToolsOpenedByAction::kUnknown);
+  }
+  s.next_dock.clear();
+  DevToolsWindow* window = OpenDevTools(contents);
+  return window && window->agens_view() ? ViewTabName(NumberOf(window->GetDevToolsWebContents())) : std::string();
+}
+
+bool IsDevToolsView(content::WebContents* contents) {
+  DevToolsWindow* window = DevToolsWindow::AsDevToolsWindow(contents);
+  return window && window->agens_view();
+}
+
+bool InOwnDevToolsWindow(content::WebContents* contents) {
+  DevToolsWindow* window = DevToolsWindow::AsDevToolsWindow(contents);
+  return window ? !window->agens_view() : DevToolsWindow::IsDevToolsWindow(contents);
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  State& s = S();
+  if (connection != s.host) return;
+  // Opened for the host's person, so they go with it (the inspected tab closing closes one too).
+  std::vector<BrowserWindowInterface*> devtools;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation([&](BrowserWindowInterface* b) {
+    if (b->GetType() == BrowserWindowInterface::TYPE_DEVTOOLS) devtools.push_back(b);
+    return true;
+  });
+  for (BrowserWindowInterface* b : devtools) b->GetWindow()->Close();
+  std::vector<DevToolsWindow*> views;
+  for (auto& d : s.devtools) {
+    DevToolsWindow* window = DevToolsWindow::AsDevToolsWindow(d->web_contents());
+    if (window && window->agens_view()) views.push_back(window);
+  }
+  for (DevToolsWindow* window : views) window->AgensClose();
+  s.last_dock = "window";
+  s.host = 0;
+  s.shown.clear();  // the tabs go back to hidden
+  s.sent.clear();
+  s.icons.clear();
+  s.agent_cursors.clear();
+  if (ApprovalCallback done = std::move(s.answer)) std::move(done).Run(kAgensApprovalDeny);
+  ui_ask::HostGone();
+  extension::HostGone();
+}
+
+void HostGone() {
+  if (S().host) OnConnectionClosed(S().host);
+}
+
+void AddWindow(AgensWindow* window) {
+  if (!IsEmbedded()) return;
+  WatchLayers();  // from the first window: every tab's last layer is known when it is attached
+  static bool dock_set = false;
+  if (!std::exchange(dock_set, true)) {
+    DevToolsWindow::AgensDock dock;
+    dock.opens_as_view = base::BindRepeating(&OpensAsView);
+    dock.shown = base::BindRepeating(&DevToolsShown);
+    dock.dialogs = base::BindRepeating(&agens::EmbeddedDialogManager);
+    DevToolsWindow::SetAgensDock(std::move(dock));
+  }
+  ui_ask::Start();
+  extension::Start();
+  TheSiteRequests().Start();
+  S().windows.push_back(window);
+  window->model()->AddObserver(&S());
+  S().Schedule();
+}
+
+void RemoveWindow(AgensWindow* window) {
+  State& s = S();
+  if (!std::erase(s.windows, window)) return;
+  window->model()->RemoveObserver(&s);
+  s.Schedule();
+}
+
+uint64_t Host() {
+  return S().host;
+}
+
+void AddView(content::WebContents* contents) {
+  NumberOf(contents);
+  S().views.push_back(contents);
+}
+
+void RemoveView(content::WebContents* contents) {
+  State& s = S();
+  if (!std::erase(s.views, contents)) return;
+  std::erase_if(s.shown, [contents](const std::unique_ptr<Shown>& shown) { return shown->web_contents() == contents; });
+  ui_ask::TabClosing(contents);
+}
+
+content::WebContents* FindView(int n, AgensWindow** window) {
+  return FindTab(n, window);
+}
+
+void OpenTab(Request request, ReplyCallback reply, GURL url, Profile* profile) {
+  OpenIn(std::move(request), std::move(reply), std::move(url), profile);
+}
+
+int TabNumber(content::WebContents* contents) {
+  return NumberOf(contents);
+}
+
+int KnownTab(content::WebContents* contents) {
+  return KnownNumber(contents);
+}
+
+void AskHost(const std::string& title,
+             const std::string& detail,
+             bool offer_always,
+             base::DictValue facts,
+             ApprovalCallback done) {
+  State& s = S();
+  if (!s.host) {
+    std::move(done).Run(kAgensApprovalDeny);
+    return;
+  }
+  s.ask = "a" + base::NumberToString(++s.next_ask);
+  s.ask_offers_always = offer_always;
+  s.answer = std::move(done);
+  base::DictValue fields = std::move(facts);
+  fields.Set("ask", s.ask);
+  fields.Set("title", title);
+  fields.Set("detail", detail);
+  fields.Set("offer_always", offer_always);
+  SendEventTo(s.host, "approval.ask", std::move(fields));
+}
+
+}  // namespace agens::bridge::view
diff --git a/chrome/browser/agens/bridge/view_ops.h b/chrome/browser/agens/bridge/view_ops.h
