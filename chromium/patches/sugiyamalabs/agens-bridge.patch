+  for (NSInteger i = (NSInteger)_buttons.count - 1; i >= 0; --i) {
+    x -= 24;
+    _buttons[i].frame = NSMakeRect(x, (h - 22) / 2, 24, 22);
+    if (i == 3) {  // a thin line between the docks and close
+      x -= 7;
