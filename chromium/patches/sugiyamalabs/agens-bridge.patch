+// Extensions for the host (docs/protocolo.md, "Passo 5.6"): extensions.list, extension.* and the
+// extension popup as a view the host attaches like a tab. Embedded and host-only: view_ops.cc
+// checks both before handing an op here. UI thread.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_EXTENSION_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_EXTENSION_OPS_H_
+
