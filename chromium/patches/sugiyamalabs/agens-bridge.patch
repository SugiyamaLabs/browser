+// Copyright 2026 SugiyamaLabs.
+// The local control socket, `<user data dir>/agens.sock` (docs/agens.md, "O socket"). Accepts and
+// reads on the IO thread, runs each operation on the UI thread (ops.cc) and writes the reply back.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_BRIDGE_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_BRIDGE_H_
+
+#include <string_view>
+
+#include "base/functional/callback_forward.h"
+#include "base/values.h"
+
+class PrefRegistrySimple;
+
+namespace agens::bridge {
+
+// Local State. Dev setting (Configurações › Sistema): clients without our signature get in.
+inline constexpr char kAcceptUnsignedPref[] = "agens.bridge.accept_unsigned";
+// Clients answered "Permitir sempre": "<team id>/<signing identifier>".
+inline constexpr char kAllowedClientsPref[] = "agens.bridge.allowed_clients";
+
+void RegisterPrefs(PrefRegistrySimple* registry);
+// UI thread. Start once the threads run; Stop at teardown removes the socket file.
+void Start();
+void Stop();
+// UI thread. Sends `{"event": name, ...fields}` to every authorized client.
+void SendEvent(std::string_view name, base::DictValue fields);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_BRIDGE_H_
diff --git a/chrome/browser/agens/bridge/bridge_mac.mm b/chrome/browser/agens/bridge/bridge_mac.mm
new file mode 100644
index 0000000000..4f5200a085
--- /dev/null
+++ b/chrome/browser/agens/bridge/bridge_mac.mm
@@ -0,0 +1,534 @@
+// Copyright 2026 SugiyamaLabs.
+// The socket server on macOS: a Unix socket in the user data dir, the peer's code signature read
+// from its audit token, and the approval of the person before a signed client gets in.
+
+#include "chrome/browser/agens/bridge/bridge.h"
+
+#import <Foundation/Foundation.h>
+#include <Security/Security.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <deque>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/apple/bridging.h"
+#include "base/apple/foundation_util.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/message_loop/message_pump_for_io.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/current_thread.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/ops.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+#include "chrome/browser/agens/embed/native_shell.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace agens::bridge {
+
+namespace {
+
+// PLACEHOLDER: our Apple Team ID (10 characters, from the Developer account). Not known yet: no
+// signing identity on the build machine. Until it is set no client passes the signature check, so
+// only "Aceitar apps sem assinatura" lets clients in.
+constexpr char kTeamId[] = "TEAM_ID_PLACEHOLDER";
+
+constexpr char kSocketName[] = "agens.sock";
+
+// Same-user DoS bounds: requests held while the approval is pending, replies the client hasn't
+// read, and open connections.
+constexpr size_t kMaxWaitingBytes = 64 * 1024;
+constexpr size_t kMaxPendingOutput = 1 << 20;
+constexpr size_t kMaxConnections = 16;
+
+// --- Who is on the other side (thread pool: the Security calls may block).
+
+struct Peer {
+  bool ours = false;     // signed with kTeamId
+  std::string identity;  // "<team id>/<signing identifier>", only when ours
+  std::string name;      // the app's name, for the approval sheet
+};
+
+std::string AppName(SecCodeRef code, const std::string& fallback) {
+  CFURLRef url = nullptr;
+  if (SecCodeCopyPath(code, kSecCSDefaultFlags, &url) != errSecSuccess || !url) return fallback;
+  base::apple::ScopedCFTypeRef<CFURLRef> owned(url);
+  NSURL* path = base::apple::CFToNSPtrCast(url);
+  NSBundle* bundle = [NSBundle bundleWithURL:path];
+  NSString* name = [bundle objectForInfoDictionaryKey:@"CFBundleDisplayName"]
+                       ?: [bundle objectForInfoDictionaryKey:@"CFBundleName"];
+  if (![name isKindOfClass:NSString.class] || !name.length) {
+    name = path.lastPathComponent.stringByDeletingPathExtension;
+  }
+  return name.length ? base::SysNSStringToUTF8(name) : fallback;
+}
+
+Peer CheckPeer(audit_token_t token) {
+  Peer peer;
+  peer.name = "app";
+  base::apple::ScopedCFTypeRef<CFDataRef> data(
+      CFDataCreate(nullptr, reinterpret_cast<const UInt8*>(&token), sizeof(token)));
+  NSDictionary* attributes = @{
+    base::apple::CFToNSPtrCast(kSecGuestAttributeAudit) : base::apple::CFToNSPtrCast(data.get())
+  };
+  SecCodeRef raw_code = nullptr;
+  if (SecCodeCopyGuestWithAttributes(nullptr, base::apple::NSToCFPtrCast(attributes),
+                                     kSecCSDefaultFlags, &raw_code) != errSecSuccess ||
+      !raw_code) {
+    return peer;
+  }
+  base::apple::ScopedCFTypeRef<SecCodeRef> code(raw_code);
+
+  CFDictionaryRef raw_info = nullptr;
+  std::string identifier;
+  if (SecCodeCopySigningInformation(code.get(), kSecCSSigningInformation, &raw_info) ==
+          errSecSuccess &&
+      raw_info) {
+    base::apple::ScopedCFTypeRef<CFDictionaryRef> info(raw_info);
+    if (CFStringRef id = base::apple::GetValueFromDictionary<CFStringRef>(info.get(),
+                                                                          kSecCodeInfoIdentifier)) {
+      identifier = base::SysCFStringRefToUTF8(id);
+    }
+  }
+  peer.name = AppName(code.get(), identifier.empty() ? peer.name : identifier);
+
+  const std::string requirement_text =
+      std::string("anchor apple generic and certificate leaf[subject.OU] = \"") + kTeamId + "\"";
+  SecRequirementRef raw_requirement = nullptr;
+  if (SecRequirementCreateWithString(base::SysUTF8ToCFStringRef(requirement_text).get(),
+                                     kSecCSDefaultFlags, &raw_requirement) != errSecSuccess ||
+      !raw_requirement) {
+    return peer;
+  }
+  base::apple::ScopedCFTypeRef<SecRequirementRef> requirement(raw_requirement);
+  // Checks the running process (dynamic validity) against our Team ID.
+  if (SecCodeCheckValidity(code.get(), kSecCSDefaultFlags, requirement.get()) == errSecSuccess &&
+      !identifier.empty()) {
+    peer.ours = true;
+    peer.identity = std::string(kTeamId) + "/" + identifier;
+  }
+  return peer;
+}
+
+// --- The decision (UI thread). `done` gets nullptr to let the client in, else the error code.
+
+using Decision = base::OnceCallback<void(const char* error)>;
+
+bool AlwaysAllowed(const std::string& identity) {
+  const base::ListValue& list = g_browser_process->local_state()->GetList(kAllowedClientsPref);
+  return std::ranges::contains(list, base::Value(identity));
+}
+
+void Decide(Peer peer, uint64_t connection, Decision done) {
+  if (!g_browser_process || g_browser_process->IsShuttingDown()) {
+    std::move(done).Run(kDenied);
+    return;
+  }
+  if (!peer.ours) {
+    const bool accept = g_browser_process->local_state()->GetBoolean(kAcceptUnsignedPref);
+    std::move(done).Run(accept ? nullptr : kUnauthorized);
+    return;
+  }
+  if (AlwaysAllowed(peer.identity)) {
+    std::move(done).Run(nullptr);
+    return;
+  }
+  // Connections of the same app ask the same question, so one sheet answers them all.
+  AskApproval(connection, "O " + peer.name + " quer usar o AgensBrowser", "Ele poderá ver, criar e abrir os seus atos.",
+              /*offer_always=*/true,
+              base::BindOnce(
+                  [](std::string identity, Decision done, AgensApprovalAnswer answer) {
+                    if (answer == kAgensApprovalAllowAlways && !AlwaysAllowed(identity)) {
+                      ScopedListPrefUpdate(g_browser_process->local_state(), kAllowedClientsPref)->Append(identity);
+                    }
+                    std::move(done).Run(answer == kAgensApprovalDeny ? kDenied : nullptr);
+                  },
+                  peer.identity, std::move(done)));
+}
+
+// --- The server (IO thread).
+
+class Server;
+
+class Connection : public base::MessagePumpForIO::FdWatcher {
+ public:
+  Connection(Server* server, base::ScopedFD fd) : server_(server), fd_(std::move(fd)) {
+    static uint64_t next_id = 0;  // IO thread only
+    client_.connection = ++next_id;
+  }
+
+  void Start();
+  void Send(std::string line);
+
+ private:
+  enum class State { kChecking, kAllowed, kClosing };
+
+  void Checked(Peer peer);
+  void Authorized(const char* error);
+  void Handle(std::string line);
+  void Flush();
+  void Close();
+
+  // base::MessagePumpForIO::FdWatcher:
+  void OnFileCanReadWithoutBlocking(int fd) override;
+  void OnFileCanWriteWithoutBlocking(int fd) override;
+
+  raw_ptr<Server> server_;
+  base::ScopedFD fd_;
+  Client client_;  // name and identity filled once the signature is read
+  State state_ = State::kChecking;
+  LineFramer framer_;
+  std::vector<std::string> waiting_;  // lines read before the client was let in
+  size_t waiting_bytes_ = 0;
+  bool closed_posted_ = false;
+  std::string out_;
+  base::MessagePumpForIO::FdWatchController read_watch_{FROM_HERE};
+  base::MessagePumpForIO::FdWatchController write_watch_{FROM_HERE};
+  bool writing_ = false;
+  base::WeakPtrFactory<Connection> weak_{this};
+
+  friend class Server;
+};
+
+class Server : public base::MessagePumpForIO::FdWatcher {
+ public:
+  explicit Server(base::ScopedFD fd) : fd_(std::move(fd)) {
+    base::CurrentIOThread::Get()->WatchFileDescriptor(fd_.get(), /*persistent=*/true,
+                                                      base::MessagePumpForIO::WATCH_READ,
+                                                      &watch_, this);
+  }
+
+  void Remove(Connection* connection) {
+    auto it = connections_.find(connection);
+    if (it == connections_.end()) return;
+    // Not now: we may be inside one of its watcher callbacks.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, std::move(it->second));
+    connections_.erase(it);
+    ResumeAccept();  // its descriptor is about to be free
+  }
+
+  void SendTo(uint64_t connection, const std::string& line) {
+    for (auto& [c, owned] : connections_) {
+      if (c->client_.connection == connection && c->state_ == Connection::State::kAllowed) c->Send(line);
+    }
+  }
+
+  void Broadcast(const std::string& line) {
+    for (auto& [connection, owned] : connections_) {
+      if (connection->state_ == Connection::State::kAllowed) connection->Send(line);
+    }
+  }
+
+ private:
+  // base::MessagePumpForIO::FdWatcher:
+  void OnFileCanReadWithoutBlocking(int) override {
+    for (;;) {
+      base::ScopedFD client(HANDLE_EINTR(accept(fd_.get(), nullptr, nullptr)));
+      if (!client.is_valid()) {
+        if (errno == EMFILE || errno == ENFILE) {
+          // The pending connection keeps the socket readable: stop watching or this spins.
+          PLOG(ERROR) << "agens bridge: accept";
+          watch_.StopWatchingFileDescriptor();
+          paused_ = true;
+          base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+              FROM_HERE, base::BindOnce(&Server::ResumeAccept, weak_.GetWeakPtr()), base::Seconds(1));
+        } else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != ECONNABORTED) {
+          PLOG(ERROR) << "agens bridge: accept";
+        }
+        return;
+      }
+      if (connections_.size() >= kMaxConnections) continue;  // refused: closed right away
+      const int one = 1;
+      setsockopt(client.get(), SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+      if (fcntl(client.get(), F_SETFL, fcntl(client.get(), F_GETFL) | O_NONBLOCK) != 0) continue;
+      auto connection = std::make_unique<Connection>(this, std::move(client));
+      Connection* raw = connection.get();
+      connections_[raw] = std::move(connection);
+      raw->Start();
+    }
+  }
+  void OnFileCanWriteWithoutBlocking(int) override {}
+
+  void ResumeAccept() {
+    if (!paused_) return;
+    paused_ = false;
+    base::CurrentIOThread::Get()->WatchFileDescriptor(fd_.get(), /*persistent=*/true,
+                                                      base::MessagePumpForIO::WATCH_READ, &watch_, this);
+  }
+
+  base::ScopedFD fd_;
+  base::MessagePumpForIO::FdWatchController watch_{FROM_HERE};
+  bool paused_ = false;
+  // Before weak_: connections go first, then pending ResumeAccept tasks are cancelled.
+  std::map<Connection*, std::unique_ptr<Connection>> connections_;
+  base::WeakPtrFactory<Server> weak_{this};
+};
+
+void Connection::Start() {
+  base::CurrentIOThread::Get()->WatchFileDescriptor(fd_.get(), /*persistent=*/true,
+                                                    base::MessagePumpForIO::WATCH_READ,
+                                                    &read_watch_, this);
+  audit_token_t token;
+  socklen_t size = sizeof(token);
+  if (getsockopt(fd_.get(), SOL_LOCAL, LOCAL_PEERTOKEN, &token, &size) != 0) {
+    PLOG(ERROR) << "agens bridge: LOCAL_PEERTOKEN";
+    Authorized(kUnauthorized);
+    return;
+  }
+  // Signature (thread pool) → decision (UI) → back here.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE}, base::BindOnce(&CheckPeer, token),
+      base::BindOnce(&Connection::Checked, weak_.GetWeakPtr()));
+}
+
+// Back on IO; skipped when the connection closed meanwhile. A close after this posts
+// OnConnectionClosed behind Decide, so the UI drops the ask.
+void Connection::Checked(Peer peer) {
+  client_.name = peer.name;
+  client_.identity = peer.identity;
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&Decide, std::move(peer), client_.connection,
+                                base::BindPostTask(content::GetIOThreadTaskRunner({}),
+                                                   base::BindOnce(&Connection::Authorized, weak_.GetWeakPtr()))));
+}
+
+void Connection::Authorized(const char* error) {
+  if (state_ != State::kChecking) return;
+  if (error) {
+    // Each waiting request gets the refusal; a client that sent nothing gets one without id.
+    if (waiting_.empty()) out_ += ErrorReply(nullptr, error);
+    for (const std::string& line : waiting_) {
+      std::string reply;
+      if (std::optional<Request> request = ParseRequest(line, reply)) {
+        reply = ErrorReply(&request->id, error);
+      }
+      out_ += reply;
+    }
+    waiting_.clear();
+    state_ = State::kClosing;
+    Flush();
+    return;
+  }
+  state_ = State::kAllowed;
+  std::vector<std::string> lines = std::move(waiting_);
+  waiting_.clear();
+  for (std::string& line : lines) Handle(std::move(line));
+}
+
+void Connection::Handle(std::string line) {
+  std::string error;
+  std::optional<Request> request = ParseRequest(line, error);
+  if (!request) {
+    Send(std::move(error));
+    return;
+  }
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&HandleOp, client_, std::move(*request),
+                                base::BindPostTask(content::GetIOThreadTaskRunner({}),
+                                                   base::BindOnce(&Connection::Send, weak_.GetWeakPtr()))));
+}
+
+void Connection::Send(std::string line) {
+  if (state_ == State::kClosing) return;
+  out_ += line;
+  if (out_.size() > kMaxPendingOutput) {
+    Close();  // the client stopped reading
+    return;
+  }
+  Flush();
+}
+
+void Connection::Flush() {
+  while (!out_.empty()) {
+    const ssize_t n = HANDLE_EINTR(write(fd_.get(), out_.data(), out_.size()));
+    if (n < 0) {
+      if (errno == EAGAIN || errno == EWOULDBLOCK) {
+        if (!writing_) {
+          writing_ = base::CurrentIOThread::Get()->WatchFileDescriptor(
+              fd_.get(), /*persistent=*/true, base::MessagePumpForIO::WATCH_WRITE, &write_watch_, this);
+        }
+        return;
+      }
+      out_.clear();
+      Close();
+      return;
+    }
+    out_.erase(0, n);
+  }
+  if (writing_) {
+    write_watch_.StopWatchingFileDescriptor();
+    writing_ = false;
+  }
+  if (state_ == State::kClosing) Close();
+}
+
+void Connection::Close() {
+  if (!closed_posted_) {  // Close can run twice (a write error while closing)
+    closed_posted_ = true;
+    content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE,
+                                                 base::BindOnce(&OnConnectionClosed, client_.connection));
+  }
+  read_watch_.StopWatchingFileDescriptor();
+  write_watch_.StopWatchingFileDescriptor();
+  writing_ = false;
+  state_ = State::kClosing;
+  weak_.InvalidateWeakPtrs();
+  server_->Remove(this);
+}
+
+void Connection::OnFileCanReadWithoutBlocking(int) {
+  char buffer[64 * 1024];
+  for (;;) {
+    const ssize_t n = HANDLE_EINTR(read(fd_.get(), buffer, sizeof(buffer)));
+    if (n == 0 || (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK)) {
+      Close();
+      return;
+    }
+    if (n < 0) return;
+    std::vector<std::string> lines;
+    if (!framer_.Append(std::string_view(buffer, n), lines)) {
+      Close();  // a line past kMaxLineBytes
+      return;
+    }
+    for (std::string& line : lines) {
+      if (state_ == State::kChecking) {
+        waiting_bytes_ += line.size();
+        if (waiting_bytes_ > kMaxWaitingBytes) {
+          Close();
+          return;
+        }
+        waiting_.push_back(std::move(line));
+      } else if (state_ == State::kAllowed) {
+        Handle(std::move(line));
+      }
+    }
+    if (state_ == State::kClosing) return;
+  }
+}
+
+void Connection::OnFileCanWriteWithoutBlocking(int) {
+  Flush();
+}
+
+// --- Lifetime.
+
+Server* g_server = nullptr;  // IO thread only
+base::FilePath& SocketPath() {  // UI thread only
+  static base::NoDestructor<base::FilePath> path;
+  return *path;
+}
+
+void StartOnIO(base::ScopedFD fd) {
+  DCHECK(!g_server);
+  g_server = new Server(std::move(fd));
+}
+
+void StopOnIO() {
+  delete g_server;
+  g_server = nullptr;
+}
+
+base::ScopedFD Listen(const base::FilePath& path) {
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (path.value().size() >= sizeof(address.sun_path)) {
+    LOG(ERROR) << "agens bridge: socket path too long (" << path.value().size() << " bytes, max "
+               << sizeof(address.sun_path) - 1 << "): " << path.value() << "; the socket is off";
+    return {};
+  }
+  strlcpy(address.sun_path, path.value().c_str(), sizeof(address.sun_path));
+  // Only one browser runs per user data dir (the process singleton), so a socket left here is
+  // stale. Anything else at that path is not ours to delete.
+  struct stat info;
+  if (lstat(address.sun_path, &info) == 0) {
+    if (!S_ISSOCK(info.st_mode)) {
+      LOG(ERROR) << "agens bridge: " << path.value() << " exists and is not a socket; the socket is off";
+      return {};
+    }
+    unlink(address.sun_path);
+  }
+  base::ScopedFD fd(socket(AF_UNIX, SOCK_STREAM, 0));
+  if (!fd.is_valid() || fcntl(fd.get(), F_SETFL, fcntl(fd.get(), F_GETFL) | O_NONBLOCK) != 0 ||
+      bind(fd.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+    PLOG(ERROR) << "agens bridge: bind " << path.value();
+    return {};
+  }
+  // Before listen(), so nobody connects while it is still wider than 0600.
+  if (chmod(address.sun_path, 0600) != 0 || listen(fd.get(), SOMAXCONN) != 0) {
+    PLOG(ERROR) << "agens bridge: listen " << path.value();
+    unlink(address.sun_path);
+    return {};
+  }
+  return fd;
+}
+
+}  // namespace
+
+void RegisterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kAcceptUnsignedPref, false);
+  registry->RegisterListPref(kAllowedClientsPref);
+}
+
+void Start() {
+  base::FilePath dir;
+  if (!SocketPath().empty() || !base::PathService::Get(chrome::DIR_USER_DATA, &dir)) return;
+  const base::FilePath path = dir.AppendASCII(kSocketName);
+  base::ScopedFD fd = Listen(path);
+  if (!fd.is_valid()) return;
+  SocketPath() = path;
+  content::GetIOThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(&StartOnIO, std::move(fd)));
+}
+
+void Stop() {
+  if (SocketPath().empty()) return;
+  unlink(SocketPath().value().c_str());
+  SocketPath().clear();
+  content::GetIOThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(&StopOnIO));
+}
+
+void SendEvent(std::string_view name, base::DictValue fields) {
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](std::string line) {
+                       if (g_server) g_server->Broadcast(line);
+                     },
+                     EventLine(name, std::move(fields))));
+}
+
+void SendEventTo(uint64_t connection, std::string_view name, base::DictValue fields) {
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](uint64_t connection, std::string line) {
+                       if (g_server) g_server->SendTo(connection, line);
+                     },
+                     connection, EventLine(name, std::move(fields))));
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/control_ops.cc b/chrome/browser/agens/bridge/control_ops.cc
new file mode 100644
index 0000000000..a262a8e13a
--- /dev/null
+++ b/chrome/browser/agens/bridge/control_ops.cc
@@ -0,0 +1,115 @@
+// Copyright 2026 SugiyamaLabs.
+// The control session (docs/protocolo.md, "control, tab, page"): an app, after the person's OK,
+// drives tabs of one ato. It belongs to the connection and ends on control.stop, when the
+// connection closes, or when the person presses "Parar" on a controlled tab.
+
+#include "chrome/browser/agens/bridge/control_ops.h"
+
+#include <map>
+#include <set>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+
+namespace agens::bridge::control {
+
+namespace {
+
+constexpr size_t kMaxReasonChars = 1024;
+
+// One app's control of one ato.
+struct Session {
+  std::string client;  // the app's name, shown on its tabs
+  base::FilePath ato;  // the ato's profile folder
+};
+std::map<uint64_t, Session>& Sessions() {
+  static base::NoDestructor<std::map<uint64_t, Session>> sessions;
+  return *sessions;
+}
+// Connections whose control.start waits for the person.
+std::set<uint64_t>& Asking() {
+  static base::NoDestructor<std::set<uint64_t>> asking;
+  return *asking;
+}
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+void End(uint64_t connection) {
+  Sessions().erase(connection);
+}
+
+void Start(const Client& client, Request request, ReplyCallback reply) {
+  const uint64_t connection = client.connection;
+  if (Sessions().contains(connection) || Asking().contains(connection)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "control already started on this connection"));
+    return;
+  }
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> reason = StringParam(request.body, "reason");
+  if (!id || !reason || !AtMostChars(*reason, kMaxReasonChars)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and reason (up to 1024 characters)"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  const std::string name = client.name.empty() ? "app" : client.name;
+  Asking().insert(connection);
+  AskApproval(connection, "O " + name + " quer usar abas do ato " + AgensWindow::AtoName(entry), *reason,
+              /*offer_always=*/false,
+              base::BindOnce(
+                  [](uint64_t connection, std::string name, base::FilePath ato, Request request, ReplyCallback reply,
+                     AgensApprovalAnswer answer) {
+                    Asking().erase(connection);
+                    if (answer == kAgensApprovalDeny) {
+                      std::move(reply).Run(ErrorReply(&request.id, kDenied));
+                      return;
+                    }
+                    if (!AgensWindow::Storage().GetProfileAttributesWithPath(ato)) {
+                      std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the ato is gone"));
+                      return;
+                    }
+                    Sessions()[connection] = {std::move(name), std::move(ato)};
+                    std::move(reply).Run(OkReply(request.id));
+                  },
+                  connection, name, entry->GetPath(), std::move(request), std::move(reply)));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return base::StartsWith(op, "control.") || base::StartsWith(op, "tab.") || base::StartsWith(op, "page.");
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  if (op == "control.start") {
+    Start(client, std::move(request), std::move(reply));
+  } else if (op == "control.stop") {
+    End(client.connection);
+    std::move(reply).Run(OkReply(request.id));
+  } else if (op.starts_with("control.")) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  } else if (!Sessions().contains(client.connection)) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs control.start on this connection"));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));  // tab.* and page.* come next
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  Asking().erase(connection);
+  End(connection);
+}
+
+}  // namespace agens::bridge::control
