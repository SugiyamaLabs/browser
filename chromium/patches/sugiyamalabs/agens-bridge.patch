+// The standalone browser shows a tab's DevTools in its page card, on the side the person used
+// last, or in its own window when that was the last choice (docs/casca.md, "DevTools").
+void SetCascaDock() {
+  static bool set = false;
+  if (std::exchange(set, true)) return;
+  DevToolsWindow::AgensDock dock;
+  dock.opens_as_view = base::BindRepeating([](content::WebContents* inspected) {
+    NativeShellView* shell = ShellWithTab(inspected);
+    return shell && agens_ui_devtools_in_page((__bridge void*)shell->chrome());
+  });
+  dock.shown = base::BindRepeating([](DevToolsWindow* devtools) {
+    NativeShellView* shell = ShellWithTab(devtools->GetInspectedWebContents());
+    if (!shell) return;
+    shell->DevToolsChanged();
+    // In the card it takes the keyboard, as Chrome's docked DevTools does (after the layout).
+    if (devtools->agens_view()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::WeakPtr<content::WebContents> frontend) {
+                           if (frontend) frontend->Focus();
+                         },
+                         devtools->GetDevToolsWebContents()->GetWeakPtr()));
+    }
+  });
+  DevToolsWindow::SetAgensDock(std::move(dock));
+}
