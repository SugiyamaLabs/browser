+++ b/chrome/browser/agens/bridge/ui_answer.h
@@ -0,0 +1,35 @@
+// Copyright 2026 SugiyamaLabs.
+// What the host may answer to a ui.ask (docs/protocolo.md, "Passo 5.3"). Pure logic, so
+// ui_answer_selfcheck.cc runs it with only //base; the engine side is ui_ops.h.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_UI_ANSWER_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_UI_ANSWER_H_
+
+#include <string_view>
+
+#include "base/values.h"
+
+namespace agens::bridge {
+
+inline constexpr size_t kMaxOpenUiAsks = 16;          // sent and waiting, all tabs together
+inline constexpr size_t kMaxUiTextBytes = 64 * 1024;  // prompt text, username, password, a path
+inline constexpr size_t kMaxUiPaths = 100;            // file, open_multiple
+
+enum class UiAnswer { kAnswer, kCancel, kBadRequest, kNotFound, kUnauthorized };
+
+// `body` is the whole ui.answer request; `asked` the open ui.ask its "ask" names, as sent (kind
+// and fields), or null when none is open by that name. In order: kUnauthorized when not
+// `from_host`; kBadRequest without an "ask" string; kNotFound when `asked` is null; kCancel for
+// {cancel: true} alone and for a file answer with no paths; kBadRequest when a field is missing,
+// has the wrong type, doesn't belong to the kind, or picks what the ask didn't offer (a disabled
+// or header item, an action outside `actions`, text outside an accepted prompt, a relative path or
+// too many).
+UiAnswer CheckUiAnswer(bool from_host, const base::DictValue* asked, const base::DictValue& body);
+
+// A file answer's `paths` against the disk, for `mode`: open and open_multiple want existing
+// files that aren't folders, folder an existing folder, save a path whose folder exists and that
+// isn't a folder itself. Blocks (it stats each one).
+bool PathsFitMode(std::string_view mode, const base::ListValue& paths);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_UI_ANSWER_H_
diff --git a/chrome/browser/agens/bridge/ui_answer_selfcheck.cc b/chrome/browser/agens/bridge/ui_answer_selfcheck.cc
new file mode 100644
index 0000000000..079453a136
--- /dev/null
+++ b/chrome/browser/agens/bridge/ui_answer_selfcheck.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 SugiyamaLabs.
+// Assert-based check of ui_answer.h, run by agens_bridge_selfcheck (protocol_selfcheck.cc).
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "chrome/browser/agens/bridge/ui_answer.h"
+
+using namespace agens::bridge;
+
+#define UI_CHECK(x)                                                       \
+  do {                                                                    \
+    if (!(x)) {                                                           \
+      std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #x); \
+      std::exit(1);                                                       \
+    }                                                                     \
+  } while (0)
+
+static base::DictValue Json(const std::string& json) {
+  std::optional<base::Value> v = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  UI_CHECK(v && v->is_dict());
+  return std::move(v->GetDict());
+}
+
+// The answer `json` (plus id, op and ask) to the ask `asked`.
+static UiAnswer Check(const std::string& asked, const std::string& json) {
+  base::DictValue body = Json(json);
+  body.Set("id", 1);
+  body.Set("op", "ui.answer");
+  body.Set("ask", "u1");
+  const base::DictValue open = Json(asked);
+  return CheckUiAnswer(/*from_host=*/true, &open, body);
+}
+
+void RunUiAnswerChecks() {
+  constexpr UiAnswer kOk = UiAnswer::kAnswer, kCancel = UiAnswer::kCancel, kBad = UiAnswer::kBadRequest;
+
+  // Who may answer, and which ask.
+  {
+    const base::DictValue asked = Json(R"({"kind":"extension"})");
+    const base::DictValue answer = Json(R"({"id":1,"op":"ui.answer","ask":"u1","allow":true})");
+    UI_CHECK(CheckUiAnswer(false, &asked, answer) == UiAnswer::kUnauthorized);
+    UI_CHECK(CheckUiAnswer(false, nullptr, Json(R"({"id":1,"op":"ui.answer"})")) == UiAnswer::kUnauthorized);
+    UI_CHECK(CheckUiAnswer(true, nullptr, answer) == UiAnswer::kNotFound);
+    UI_CHECK(CheckUiAnswer(true, &asked, answer) == kOk);
+    UI_CHECK(CheckUiAnswer(true, &asked, Json(R"({"id":1,"op":"ui.answer","allow":true})")) == kBad);
+    UI_CHECK(CheckUiAnswer(true, nullptr, Json(R"({"id":1,"op":"ui.answer","ask":4})")) == kBad);
+  }
+
+  // Cancel, for every kind; nothing else may come with it.
+  const std::string select =
+      R"({"kind":"select","items":[{"label":"Brasil"},{"label":"Chile","disabled":true},{"label":"Sul","group":true},{"label":"Peru"}],"selected":0})";
+  UI_CHECK(Check(select, R"({"cancel":true})") == kCancel);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"cancel":true})") == kCancel);
+  UI_CHECK(Check(select, R"({"cancel":false})") == kBad);
+  UI_CHECK(Check(select, R"({"cancel":1})") == kBad);
+  UI_CHECK(Check(select, R"({"cancel":true,"index":0})") == kBad);
+  UI_CHECK(Check(R"({"kind":"nope"})", R"({"allow":true})") == kBad);
+  UI_CHECK(Check(R"({})", R"({"cancel":true})") == kBad);
+
+  // select: an index of an item that can be picked.
+  UI_CHECK(Check(select, R"({"index":0})") == kOk && Check(select, R"({"index":3})") == kOk);
+  UI_CHECK(Check(select, R"({"index":1})") == kBad);  // disabled
+  UI_CHECK(Check(select, R"({"index":2})") == kBad);  // optgroup header
+  UI_CHECK(Check(select, R"({"index":4})") == kBad && Check(select, R"({"index":-1})") == kBad);
+  UI_CHECK(Check(select, R"({"index":"0"})") == kBad && Check(select, R"({"index":0.5})") == kBad);
+  UI_CHECK(Check(select, R"({})") == kBad && Check(select, R"({"index":0,"action":"copy"})") == kBad);
+
+  // context_menu: one of the actions offered.
+  const std::string menu = R"({"kind":"context_menu","context":{"actions":["copy","reload"]}})";
+  UI_CHECK(Check(menu, R"({"action":"reload"})") == kOk);
+  UI_CHECK(Check(menu, R"({"action":"paste"})") == kBad && Check(menu, R"({"action":1})") == kBad);
+  UI_CHECK(Check(menu, R"({})") == kBad && Check(R"({"kind":"context_menu"})", R"({"action":"copy"})") == kBad);
+
+  // dialog: accept, and text only for an accepted prompt.
+  const std::string prompt = R"({"kind":"dialog","type":"prompt","message":"Nome?","default":"a"})";
+  const std::string confirm = R"({"kind":"dialog","type":"confirm","message":"Sair?"})";
+  UI_CHECK(Check(prompt, R"({"accept":true,"text":"Ana"})") == kOk && Check(prompt, R"({"accept":false})") == kOk);
+  UI_CHECK(Check(prompt, R"({"accept":false,"text":"Ana"})") == kBad);
+  UI_CHECK(Check(confirm, R"({"accept":true})") == kOk && Check(confirm, R"({"accept":true,"text":"x"})") == kBad);
+  UI_CHECK(Check(confirm, R"({})") == kBad && Check(confirm, R"({"accept":"yes"})") == kBad);
+  UI_CHECK(Check(prompt, R"({"accept":true,"text":7})") == kBad);
+  UI_CHECK(Check(prompt, R"({"accept":true,"text":")" + std::string(kMaxUiTextBytes + 1, 'a') + "\"}") == kBad);
+  UI_CHECK(Check(confirm, R"({"accept":true,"allow":true})") == kBad);
+
+  // file: absolute paths, one unless open_multiple (up to 100); none is a cancel.
+  const std::string open = R"({"kind":"file","mode":"open","accept":[".png"]})";
+  const std::string multiple = R"({"kind":"file","mode":"open_multiple","accept":[]})";
+  UI_CHECK(Check(open, R"({"paths":["/tmp/a.png"]})") == kOk && Check(open, R"({"paths":[]})") == kCancel);
+  UI_CHECK(Check(open, R"({"paths":["/tmp/a","/tmp/b"]})") == kBad);
+  UI_CHECK(Check(multiple, R"({"paths":["/tmp/a","/tmp/b"]})") == kOk);
+  UI_CHECK(Check(open, R"({"paths":["a.png"]})") == kBad && Check(open, R"({"paths":["/tmp/../etc/x"]})") == kBad);
+  UI_CHECK(Check(open, R"({"paths":[""]})") == kBad && Check(open, R"({"paths":[1]})") == kBad);
+  UI_CHECK(Check(open, R"({"paths":"/tmp/a"})") == kBad && Check(open, R"({})") == kBad);
+  {
+    std::string many = R"({"paths":[)";
+    for (size_t i = 0; i <= kMaxUiPaths; ++i) many += std::string(i ? "," : "") + "\"/tmp/f\"";
+    UI_CHECK(Check(multiple, many + "]}") == kBad);
+  }
+
+  // auth: username and password, both strings.
+  const std::string auth = R"({"kind":"auth","origin":"https://a.example","realm":"r","proxy":false,"retry":false})";
+  UI_CHECK(Check(auth, R"({"username":"ana","password":"x"})") == kOk);
+  UI_CHECK(Check(auth, R"({"username":"","password":""})") == kOk);
+  UI_CHECK(Check(auth, R"({"username":"ana"})") == kBad && Check(auth, R"({"password":"x"})") == kBad);
+  UI_CHECK(Check(auth, R"({"username":"ana","password":1})") == kBad);
+  UI_CHECK(Check(auth, R"({"username":"ana","password":"x","remember":true})") == kBad);
+
+  // permission: allow, remember only with it; extension: allow alone.
+  const std::string permission = R"({"kind":"permission","origin":"https://a.example","permission":"camera"})";
+  UI_CHECK(Check(permission, R"({"allow":true})") == kOk && Check(permission, R"({"allow":false,"remember":true})") == kOk);
+  UI_CHECK(Check(permission, R"({"remember":true})") == kBad && Check(permission, R"({"allow":true,"remember":1})") == kBad);
+  UI_CHECK(Check(permission, R"({"allow":"yes"})") == kBad);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"allow":false})") == kOk);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"allow":true,"remember":true})") == kBad);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({})") == kBad);
+
+  // The paths against the disk.
+  base::ScopedTempDir dir;
+  UI_CHECK(dir.CreateUniqueTempDir());
+  const base::FilePath file = dir.GetPath().Append("a.png");
+  UI_CHECK(base::WriteFile(file, "x"));
+  auto list = [](std::initializer_list<base::FilePath> paths) {
+    base::ListValue l;
+    for (const base::FilePath& p : paths) l.Append(p.value());
+    return l;
+  };
+  const base::FilePath missing = dir.GetPath().Append("nope");
+  UI_CHECK(PathsFitMode("open", list({file})) && PathsFitMode("open_multiple", list({file, file})));
+  UI_CHECK(!PathsFitMode("open", list({dir.GetPath()})) && !PathsFitMode("open", list({missing})));
+  UI_CHECK(!PathsFitMode("open_multiple", list({file, missing})));
+  UI_CHECK(PathsFitMode("folder", list({dir.GetPath()})) && !PathsFitMode("folder", list({file})));
+  UI_CHECK(PathsFitMode("save", list({missing})) && PathsFitMode("save", list({file})));  // overwrite is the host's to ask
+  UI_CHECK(!PathsFitMode("save", list({dir.GetPath()})) && !PathsFitMode("save", list({missing.Append("b")})));
+
+  std::printf("agens bridge ui.answer: ok\n");
+}
diff --git a/chrome/browser/agens/bridge/ui_ops.cc b/chrome/browser/agens/bridge/ui_ops.cc
new file mode 100644
index 0000000000..7f329b6142
--- /dev/null
+++ b/chrome/browser/agens/bridge/ui_ops.cc
@@ -0,0 +1,679 @@
+// Copyright 2026 SugiyamaLabs.
+// - One queue for every ask, in the order they came; only the oldest of each tab and kind is on
+//   the host at a time, and at most kMaxOpenUiAsks wait in all.
+// - What the person typed (a password, a prompt's text) only passes through `done`: never in an
+//   event, an error or a log.
+
+#include "chrome/browser/agens/bridge/ui_ops.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+#include "chrome/browser/agens/bridge/ui_answer.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+#include "chrome/browser/agens/bridge/view_ops.h"
+#include "chrome/browser/agens/embed/agens_controlled.h"
+#include "chrome/browser/agens/embed/agens_embedded.h"
+#include "content/public/browser/agens_embed_mac.h"
+#include "content/public/browser/context_menu_params.h"
+#include "content/public/browser/javascript_dialog_manager.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/common/context_menu_data/edit_flags.h"
+#include "third_party/blink/public/mojom/context_menu/context_menu.mojom.h"
+#include "third_party/blink/public/mojom/forms/form_control_type.mojom-shared.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/select_file_dialog_factory.h"
+#include "ui/shell_dialogs/select_file_policy.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace agens {
+
+namespace {
+content::WebContents* g_file_dialog_source = nullptr;
+}
+
+void SetFileDialogSource(content::WebContents* contents) {
+  g_file_dialog_source = contents;
+}
+
+}  // namespace agens
+
+namespace agens::bridge::ui_ask {
+
+namespace {
+
+constexpr size_t kMaxDialogMessageChars = 1024;
+constexpr size_t kMaxSelectionChars = 200;
+constexpr size_t kMaxRealmChars = 200;
+
+struct Pending {
+  int n = 0;
+  std::string kind;
+  int tab = 0;             // 0: no tab (an extension)
+  base::DictValue fields;  // the ui.ask, as it goes out
+  bool sent = false;
+  bool checking = false;  // a file answer whose paths are being checked
+  AnswerCallback done;
+};
+
+struct State {
+  std::vector<std::unique_ptr<Pending>> asks;  // oldest first
+  int next = 0;
+  std::map<int, std::string> cursors;  // the last view.cursor of each tab
+  std::map<int, gfx::Rect> carets;     // and view.caret
+};
+State& S() {
+  static base::NoDestructor<State> state;
+  return *state;
+}
+
+Pending* Find(int n) {
+  for (auto& p : S().asks) {
+    if (p->n == n) return p.get();
+  }
+  return nullptr;
+}
+
+std::unique_ptr<Pending> Take(int n) {
+  auto& asks = S().asks;
+  auto it = std::ranges::find_if(asks, [n](const std::unique_ptr<Pending>& p) { return p->n == n; });
+  if (it == asks.end()) return nullptr;
+  std::unique_ptr<Pending> p = std::move(*it);
+  asks.erase(it);
+  return p;
+}
+
+// The oldest of each tab and kind goes to the host.
+void SendNext() {
+  const uint64_t host = view::Host();
+  if (!host) return;
+  std::set<std::pair<int, std::string>> busy;
+  for (auto& p : S().asks) {
+    if (!busy.insert({p->tab, p->kind}).second || p->sent) continue;
+    p->sent = true;
+    SendEventTo(host, "ui.ask", p->fields.Clone());
+  }
+}
+
+void TellCancelled(const Pending& p, std::string_view reason) {
+  if (!p.sent || !view::Host()) return;
+  base::DictValue fields;
+  fields.Set("ask", *p.fields.FindString("ask"));
+  fields.Set("reason", reason);
+  SendEventTo(view::Host(), "ui.cancel", std::move(fields));
+}
+
+bool IsBeforeUnload(const Pending& p) {
+  const std::string* type = p.fields.FindString("type");
+  return p.kind == "dialog" && type && *type == "beforeunload";
+}
+
+// The engine gives up on the asks of tab `n` (a beforeunload too, unless `keep_beforeunload`):
+// the page goes on as if cancelled.
+void EndTab(int n, std::string_view reason, bool keep_beforeunload = false) {
+  std::vector<std::unique_ptr<Pending>> ended;
+  for (auto& p : S().asks) {
+    if (p->tab == n && !(keep_beforeunload && IsBeforeUnload(*p))) ended.push_back(std::move(p));
+  }
+  std::erase(S().asks, nullptr);
+  for (auto& p : ended) TellCancelled(*p, reason);
+  SendNext();
+  for (auto& p : ended) std::move(p->done).Run(nullptr);
+}
+
+// Ends a tab's asks when it closes or goes to another page.
+class Watch : public content::WebContentsObserver, public content::WebContentsUserData<Watch> {
+ public:
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    // As TabModalDialogManager does: a page blocked in confirm() can't let the navigation go.
+    // A navigation starts before its own beforeunload is answered, so that one stays.
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+      EndTab(n_, "navigated", /*keep_beforeunload=*/true);
+    }
+  }
+  void WebContentsDestroyed() override {
+    S().cursors.erase(n_);
+    S().carets.erase(n_);
+    EndTab(n_, "closed");
+  }
+
+ private:
+  Watch(content::WebContents* contents, int n)
+      : content::WebContentsObserver(contents), content::WebContentsUserData<Watch>(*contents), n_(n) {}
+  friend class content::WebContentsUserData<Watch>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+  const int n_;
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(Watch);
+
+void Reply(base::Value id, ReplyCallback reply, std::string_view code) {
+  std::move(reply).Run(ErrorReply(&id, code));
+}
+
+void Finish(int n, const base::Value& id, ReplyCallback reply, std::optional<base::DictValue> answer) {
+  std::unique_ptr<Pending> p = Take(n);
+  std::move(reply).Run(OkReply(id));
+  SendNext();
+  std::move(p->done).Run(answer ? &*answer : nullptr);
+}
+
+// --- dialog: alert, confirm, prompt and beforeunload of a tab no agent holds.
+
+class HostDialogs : public content::JavaScriptDialogManager {
+ public:
+  void RunJavaScriptDialog(content::WebContents* contents,
+                           content::RenderFrameHost* frame,
+                           content::JavaScriptDialogType type,
+                           const std::u16string& message,
+                           const std::u16string& default_prompt,
+                           DialogClosedCallback done,
+                           bool* did_suppress_message) override {
+    *did_suppress_message = false;
+    Open(contents, frame, type, false, false, message, default_prompt, std::move(done));
+  }
+  void RunBeforeUnloadDialog(content::WebContents* contents,
+                             content::RenderFrameHost* frame,
+                             bool is_reload,
+                             DialogClosedCallback done) override {
+    // Nobody to ask (no host, or shutting down after it left): the page may go, or quitting would hang.
+    if (!view::Host()) return std::move(done).Run(true, std::u16string());
+    Open(contents, frame, content::JAVASCRIPT_DIALOG_TYPE_CONFIRM, true, is_reload, {}, {}, std::move(done));
+  }
+  bool HandleJavaScriptDialog(content::WebContents* contents, bool accept, const std::u16string* prompt) override {
+    auto it = std::ranges::find(dialogs_, contents, &Dialog::contents);
+    if (it == dialogs_.end()) return false;
+    Dialog dialog = std::move(*it);
+    dialogs_.erase(it);
+    Withdraw(dialog.ask);
+    std::move(dialog.done).Run(accept, accept ? (prompt ? *prompt : dialog.default_prompt) : std::u16string());
+    return true;
+  }
+  void CancelDialogs(content::WebContents* contents, bool reset_state) override {
+    while (Take(contents, contents->IsBeingDestroyed() ? "closed" : "navigated", [](Dialog dialog) {
+      std::move(dialog.done).Run(false, std::u16string());
+    })) {
+    }
+  }
+
+  void HandTo(content::WebContents* contents, content::JavaScriptDialogManager* to) {
+    while (Take(contents, "gone", [contents, to](Dialog dialog) {
+      content::RenderFrameHost* frame = content::RenderFrameHost::FromID(dialog.frame);
+      if (!frame) return std::move(dialog.done).Run(false, std::u16string());
+      if (dialog.beforeunload) return to->RunBeforeUnloadDialog(contents, frame, dialog.is_reload, std::move(dialog.done));
+      bool suppressed = false;
+      to->RunJavaScriptDialog(contents, frame, dialog.type, dialog.message, dialog.default_prompt,
+                              std::move(dialog.done), &suppressed);
+    })) {
+    }
+  }
+
+ private:
+  struct Dialog {
+    int key = 0;
+    int ask = 0;
+    raw_ptr<content::WebContents> contents;  // only compared: its asks end before it goes
+    content::GlobalRenderFrameHostId frame;
+    content::JavaScriptDialogType type;
+    bool beforeunload = false, is_reload = false;
+    std::u16string message, default_prompt;
+    DialogClosedCallback done;
+  };
+
+  void Open(content::WebContents* contents,
+            content::RenderFrameHost* frame,
+            content::JavaScriptDialogType type,
+            bool beforeunload,
+            bool is_reload,
+            const std::u16string& message,
+            const std::u16string& default_prompt,
+            DialogClosedCallback done) {
+    base::DictValue fields;
+    fields.Set("type", beforeunload                                    ? "beforeunload"
+                       : type == content::JAVASCRIPT_DIALOG_TYPE_ALERT   ? "alert"
+                       : type == content::JAVASCRIPT_DIALOG_TYPE_CONFIRM ? "confirm"
+                                                                         : "prompt");
+    fields.Set("message", ClipChars(base::UTF16ToUTF8(message), kMaxDialogMessageChars));
+    fields.Set("origin", frame->GetLastCommittedOrigin().Serialize());
+    if (type == content::JAVASCRIPT_DIALOG_TYPE_PROMPT && !beforeunload) {
+      fields.Set("default", base::UTF16ToUTF8(default_prompt));
+    }
+    const int key = ++next_key_;
+    dialogs_.push_back({key, 0, contents, frame->GetGlobalId(), type, beforeunload, is_reload, message,
+                        default_prompt, std::move(done)});
+    const int ask = Ask(contents, "dialog", std::move(fields),
+                        base::BindOnce(&HostDialogs::Answered, base::Unretained(this), key));
+    auto it = std::ranges::find(dialogs_, key, &Dialog::key);
+    if (it != dialogs_.end()) it->ask = ask;
+  }
+
+  void Answered(int key, const base::DictValue* answer) {
+    auto it = std::ranges::find(dialogs_, key, &Dialog::key);
+    if (it == dialogs_.end()) return;
+    Dialog dialog = std::move(*it);
+    dialogs_.erase(it);
+    const bool accept = answer && answer->FindBool("accept").value_or(false);
+    std::u16string text;
+    if (accept && dialog.type == content::JAVASCRIPT_DIALOG_TYPE_PROMPT) {
+      const std::string* typed = answer->FindString("text");
+      text = typed ? base::UTF8ToUTF16(*typed) : dialog.default_prompt;
+    }
+    std::move(dialog.done).Run(accept, text);
+  }
+
+  // The oldest dialog of `contents` out of the host (ui.cancel `reason`) and into `then`.
+  template <typename F>
+  bool Take(content::WebContents* contents, std::string_view reason, F then) {
+    auto it = std::ranges::find(dialogs_, contents, &Dialog::contents);
+    if (it == dialogs_.end()) return false;
+    Dialog dialog = std::move(*it);
+    dialogs_.erase(it);
+    if (std::unique_ptr<Pending> p = ui_ask::Take(dialog.ask)) {
+      TellCancelled(*p, reason);
+      SendNext();
+    }
+    then(std::move(dialog));
+    return true;
+  }
+
+  std::vector<Dialog> dialogs_;  // oldest first
+  int next_key_ = 0;
+};
+HostDialogs& TheDialogs() {
+  static base::NoDestructor<HostDialogs> dialogs;
+  return *dialogs;
+}
+
+// --- select: a <select>'s list.
+
+base::OnceClosure Select(content::WebContents* contents,
+                         const gfx::Rect& bounds,
+                         int selected,
+                         std::vector<content::AgensEmbedMenuItem> items,
+                         base::OnceCallback<void(std::optional<int>)> done) {
+  // The agent picks with page.click; the list is the person's only after "Assumir".
+  if (AgentWorking(contents)) {
+    std::move(done).Run(std::nullopt);
+    return base::OnceClosure();
+  }
+  base::ListValue list;
+  for (const content::AgensEmbedMenuItem& item : items) {
+    base::DictValue entry;
+    entry.Set("label", item.label);
+    if (!item.enabled) entry.Set("disabled", true);
+    if (item.group) entry.Set("group", true);
+    list.Append(std::move(entry));
+  }
+  base::DictValue fields;
+  fields.Set("x", bounds.x());
+  fields.Set("y", bounds.y());
+  fields.Set("width", bounds.width());
+  fields.Set("items", std::move(list));
+  fields.Set("selected", selected >= 0 && static_cast<size_t>(selected) < items.size() ? selected : -1);
+  const int ask = Ask(contents, "select", std::move(fields),
+                      base::BindOnce(
+                          [](base::OnceCallback<void(std::optional<int>)> done, const base::DictValue* answer) {
+                            std::move(done).Run(answer ? answer->FindInt("index") : std::nullopt);
+                          },
+                          std::move(done)));
+  return base::BindOnce(&Withdraw, ask);
+}
+
+// --- context_menu: a right click; the engine runs what the person picked.
+
+std::string WithoutRef(const GURL& url) {
+  GURL::Replacements no_ref;
+  no_ref.ClearRef();
+  return url.ReplaceComponents(no_ref).spec();
+}
+
+struct Clicked {
+  content::GlobalRenderFrameHostId frame;
+  GURL link, frame_url;
+  network::mojom::ReferrerPolicy referrer_policy;
+  int x = 0, y = 0;
+};
+
+void RunAction(const Clicked& clicked, const base::DictValue* answer) {
+  const std::string* action = answer ? answer->FindString("action") : nullptr;
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(clicked.frame);
+  content::WebContents* contents = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!action || !contents) return;
+  content::NavigationController& controller = contents->GetController();
+  if (*action == "open_link_new_tab") {
+    contents->OpenURL(content::OpenURLParams(clicked.link, content::Referrer(clicked.frame_url, clicked.referrer_policy),
+                                             WindowOpenDisposition::NEW_BACKGROUND_TAB, ui::PAGE_TRANSITION_LINK,
+                                             /*is_renderer_initiated=*/false, /*started_from_context_menu=*/true),
+                      {});
+  } else if (*action == "copy_link") {
+    ::ui::ScopedClipboardWriter(::ui::ClipboardBuffer::kCopyPaste).WriteText(base::UTF8ToUTF16(clicked.link.spec()));
+  } else if (*action == "copy_image") {
+    frame->CopyImageAt(clicked.x, clicked.y);
+  } else if (*action == "save_image") {
+    frame->SaveImageAt(clicked.x, clicked.y);  // a download, under the usual rules
+  } else if (*action == "copy" || *action == "cut" || *action == "paste") {
+    content::AgensEmbedEdit(contents, *action);
+  } else if (*action == "select_all") {
+    content::AgensEmbedEdit(contents, "selectAll");
+  } else if (*action == "back") {
+    if (controller.CanGoBack()) controller.GoBack();
+  } else if (*action == "forward") {
+    if (controller.CanGoForward()) controller.GoForward();
+  } else if (*action == "reload") {
+    controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/true);
+  }
+}
+
+void ContextMenu(content::RenderFrameHost& frame, const content::ContextMenuParams& params) {
+  content::WebContents* contents = content::WebContents::FromRenderFrameHost(&frame);
+  // The agent has no right click; the person's counts only after "Assumir".
+  if (!contents || AgentWorking(contents)) return;
+  base::DictValue context;
+  base::ListValue actions;
+  if (params.link_url.is_valid()) {
+    context.Set("link", WithoutRef(params.link_url));
+    if (params.link_url.SchemeIsHTTPOrHTTPS()) actions.Append("open_link_new_tab");
+    actions.Append("copy_link");
+  }
+  if (params.media_type == blink::mojom::ContextMenuDataMediaType::kImage && params.src_url.is_valid()) {
+    context.Set("image", WithoutRef(params.src_url));
+    if (params.has_image_contents) actions.Append("copy_image");
+    actions.Append("save_image");
+  }
+  const bool password = params.form_control_type == blink::mojom::FormControlType::kInputPassword;
+  if (!params.selection_text.empty() && !password) {
+    context.Set("selection", ClipChars(base::UTF16ToUTF8(params.selection_text), kMaxSelectionChars));
+  }
+  context.Set("editable", params.is_editable);
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanCopy) actions.Append("copy");
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanCut) actions.Append("cut");
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanPaste) actions.Append("paste");
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanSelectAll) actions.Append("select_all");
+  if (contents->GetController().CanGoBack()) actions.Append("back");
+  if (contents->GetController().CanGoForward()) actions.Append("forward");
+  actions.Append("reload");
+  context.Set("actions", std::move(actions));
+  base::DictValue fields;
+  fields.Set("x", params.x);
+  fields.Set("y", params.y);
+  fields.Set("context", std::move(context));
+  Ask(contents, "context_menu", std::move(fields),
+      base::BindOnce(&RunAction, Clicked{frame.GetGlobalId(), params.link_url, params.frame_url,
+                                         params.referrer_policy, params.x, params.y}));
+}
+
+// --- file: every file and folder panel (pages, "save as"), for the tab it opens for.
+
+class HostFileDialog : public ::ui::SelectFileDialog {
+ public:
+  HostFileDialog(Listener* listener, std::unique_ptr<::ui::SelectFilePolicy> policy)
+      : SelectFileDialog(listener, std::move(policy)) {}
+
+  // ::ui::SelectFileDialog:
+  bool IsRunning(gfx::NativeWindow) const override { return ask_ != 0; }
+  void ListenerDestroyed() override {
+    listener_ = nullptr;
+    if (ask_) Withdraw(std::exchange(ask_, 0));
+  }
+
+ protected:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    // Set by ChromeSelectFilePolicy right before this, in the same call.
+    content::WebContents* contents = std::exchange(g_file_dialog_source, nullptr);
+    const char* mode = type == SELECT_OPEN_MULTI_FILE ? "open_multiple"
+                       : type == SELECT_SAVEAS_FILE   ? "save"
+                       : type == SELECT_OPEN_FILE     ? "open"
+                       : (type == SELECT_FOLDER || type == SELECT_UPLOAD_FOLDER || type == SELECT_EXISTING_FOLDER)
+                           ? "folder"
+                           : nullptr;
+    base::DictValue fields;
+    fields.Set("mode", mode ? mode : "");
+    base::ListValue accept;
+    if (file_types) {
+      for (const auto& group : file_types->extensions) {
+        for (const auto& extension : group) accept.Append("." + extension);
+      }
+    }
+    fields.Set("accept", std::move(accept));
+    if (type == SELECT_SAVEAS_FILE) fields.Set("suggested", default_path.BaseName().value());
+    scoped_refptr<HostFileDialog> self(this);
+    auto done = base::BindOnce(&HostFileDialog::Answered, self, type);
+    // No tab, or an agent's: no file, as before.
+    if (!contents || !mode || AgentWorking(contents)) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(done), static_cast<const base::DictValue*>(nullptr)));
+      return;
+    }
+    ask_ = Ask(contents, "file", std::move(fields), std::move(done));
+  }
+  bool HasMultipleFileTypeChoicesImpl() override { return false; }
+
+ private:
+  ~HostFileDialog() override = default;
+  void Answered(Type type, const base::DictValue* answer) {
+    ask_ = 0;
+    if (!listener_) return;
+    const base::ListValue* paths = answer ? answer->FindList("paths") : nullptr;
+    if (!paths || paths->empty()) return listener_->FileSelectionCanceled();
+    std::vector<::ui::SelectedFileInfo> files;
+    for (const base::Value& path : *paths) {
+      ::ui::SelectedFileInfo file{base::FilePath(path.GetString())};
+      file.display_name = file.file_path.BaseName().value();  // a folder's name heads its files' paths
+      files.push_back(std::move(file));
+    }
+    if (type == SELECT_OPEN_MULTI_FILE) return listener_->MultiFilesSelected(files);
+    listener_->FileSelected(files[0], 0);
+  }
+
+  int ask_ = 0;
+};
+
+class HostFileDialogFactory : public ::ui::SelectFileDialogFactory {
+ public:
+  ::ui::SelectFileDialog* Create(::ui::SelectFileDialog::Listener* listener,
+                                 std::unique_ptr<::ui::SelectFilePolicy> policy) override {
+    return new HostFileDialog(listener, std::move(policy));
+  }
+};
+
+// --- view.cursor and view.caret.
+
+const char* CursorName(::ui::mojom::CursorType type) {
+  using T = ::ui::mojom::CursorType;
+  switch (type) {
+    case T::kHand: return "pointer";
+    case T::kIBeam:
+    case T::kVerticalText: return "text";
+    case T::kWait:
+    case T::kProgress: return "wait";
+    case T::kCross:
+    case T::kCell: return "crosshair";
+    case T::kGrab: return "grab";
+    case T::kGrabbing: return "grabbing";
+    case T::kNotAllowed:
+    case T::kNoDrop: return "not_allowed";
+    case T::kMove: return "move";
+    case T::kEastResize:
+    case T::kWestResize:
+    case T::kEastWestResize:
+    case T::kColumnResize: return "resize_ew";
+    case T::kNorthResize:
+    case T::kSouthResize:
+    case T::kNorthSouthResize:
+    case T::kRowResize: return "resize_ns";
+    case T::kNorthEastResize:
+    case T::kSouthWestResize:
+    case T::kNorthEastSouthWestResize: return "resize_nesw";
+    case T::kNorthWestResize:
+    case T::kSouthEastResize:
+    case T::kNorthWestSouthEastResize: return "resize_nwse";
+    case T::kNone: return "none";
+    default: return "default";
+  }
+}
+
+void CursorChanged(content::WebContents* contents, ::ui::mojom::CursorType type) {
+  const uint64_t host = view::Host();
+  if (!host) return;
+  const int n = view::TabNumber(contents);
+  std::string& last = S().cursors[n];
+  if (last == CursorName(type)) return;
+  last = CursorName(type);
+  base::DictValue fields;
+  fields.Set("tab", ViewTabName(n));
+  fields.Set("cursor", last);
+  SendEventTo(host, "view.cursor", std::move(fields));
+}
+
+void CaretChanged(content::WebContents* contents, const gfx::Rect& caret) {
+  const uint64_t host = view::Host();
+  if (!host) return;
+  const int n = view::TabNumber(contents);
+  auto [it, added] = S().carets.try_emplace(n, caret);
+  if (!added && it->second == caret) return;
+  it->second = caret;
+  base::DictValue fields;
+  fields.Set("tab", ViewTabName(n));
+  fields.Set("x", caret.x());
+  fields.Set("y", caret.y());
+  fields.Set("width", caret.width());
+  fields.Set("height", caret.height());
+  SendEventTo(host, "view.caret", std::move(fields));
+}
+
+}  // namespace
+
+int Ask(content::WebContents* contents, std::string_view kind, base::DictValue fields, AnswerCallback done) {
+  State& s = S();
+  if (!view::Host() || s.asks.size() >= kMaxOpenUiAsks || (contents && contents->IsBeingDestroyed())) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), static_cast<const base::DictValue*>(nullptr)));
+    return 0;
+  }
+  auto p = std::make_unique<Pending>();
+  p->n = ++s.next;
+  p->kind = std::string(kind);
+  p->tab = contents ? view::TabNumber(contents) : 0;
+  p->done = std::move(done);
+  p->fields = std::move(fields);
+  p->fields.Set("ask", "u" + base::NumberToString(p->n));
+  p->fields.Set("kind", kind);
+  if (contents) {
+    p->fields.Set("tab", ViewTabName(p->tab));
+    if (!Watch::FromWebContents(contents)) Watch::CreateForWebContents(contents, p->tab);
+  }
+  const int n = p->n;
+  s.asks.push_back(std::move(p));
+  SendNext();
+  return n;
+}
+
+void Withdraw(int ask) {
+  std::unique_ptr<Pending> p = Take(ask);
+  if (!p) return;
+  TellCancelled(*p, "gone");
+  SendNext();
+}
+
+void TabClosing(content::WebContents* contents) {
+  if (Watch::FromWebContents(contents)) EndTab(view::TabNumber(contents), "closed");
+}
+
+bool AgentWorking(content::WebContents* contents) {
+  const AgensControlled* controlled = contents ? AgensControlled::FromWebContents(contents) : nullptr;
+  return controlled && !controlled->paused;
+}
+
+void HandleAnswer(bool from_host, const Request& request, ReplyCallback reply) {
+  const std::string* ask = request.body.FindString("ask");
+  Pending* p = nullptr;
+  for (auto& candidate : S().asks) {
+    if (ask && candidate->sent && !candidate->checking && *candidate->fields.FindString("ask") == *ask) {
+      p = candidate.get();
+    }
+  }
+  switch (CheckUiAnswer(from_host, p ? &p->fields : nullptr, request.body)) {
+    case UiAnswer::kUnauthorized:
+      return std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs host.attach on this connection"));
+    case UiAnswer::kNotFound:
+      return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ask));
+    case UiAnswer::kBadRequest:
+      return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ask, and fields that fit its kind"));
+    case UiAnswer::kCancel:
+      return Finish(p->n, request.id, std::move(reply), std::nullopt);
+    case UiAnswer::kAnswer:
+      break;
+  }
+  if (p->kind != "file") return Finish(p->n, request.id, std::move(reply), request.body.Clone());
+  // The paths are checked on disk, off this thread; the ask can't be answered twice meanwhile.
+  p->checking = true;
+  const int n = p->n;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&PathsFitMode, *p->fields.FindString("mode"), request.body.FindList("paths")->Clone()),
+      base::BindOnce(
+          [](int n, base::Value id, base::DictValue body, ReplyCallback reply, bool fit) {
+            Pending* p = Find(n);
+            if (!p) return Reply(std::move(id), std::move(reply), kNotFound);
+            p->checking = false;
+            if (!fit) {
+              return std::move(reply).Run(ErrorReply(&id, kBadRequest, "a path does not exist or does not fit the mode"));
+            }
+            Finish(n, id, std::move(reply), std::move(body));
+          },
+          n, request.id.Clone(), request.body.Clone(), std::move(reply)));
+}
+
+void HostGone() {
+  std::vector<std::unique_ptr<Pending>> asks = std::move(S().asks);
+  S().asks.clear();
+  S().cursors.clear();
+  S().carets.clear();
+  for (auto& p : asks) std::move(p->done).Run(nullptr);
+}
+
+void Start() {
+  static bool started = false;
+  if (started || !IsEmbedded()) return;
+  started = true;
+  content::SetAgensEmbedSelectHandler(base::BindRepeating(&Select));
+  content::SetAgensEmbedContextMenuHandler(base::BindRepeating(&ContextMenu));
+  content::SetAgensEmbedCursorCallbacks(base::BindRepeating(&CursorChanged), base::BindRepeating(&CaretChanged));
+  ::ui::SelectFileDialog::SetFactory(std::make_unique<HostFileDialogFactory>());
+}
+
+content::JavaScriptDialogManager* Dialogs() {
+  return &TheDialogs();
+}
+
+void HandDialogsTo(content::WebContents* contents, content::JavaScriptDialogManager* to) {
+  TheDialogs().HandTo(contents, to);
+}
+
+}  // namespace agens::bridge::ui_ask
