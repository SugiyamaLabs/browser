+- (void)showStep:(int)step {
+  _step = step;
+  for (NSView* v in [_body.subviews copy]) [v removeFromSuperview];
+  NSView* root = self.window.contentView;
+  root.layer.backgroundColor = CG(kBg, root);
+  CGFloat y;
+  switch (step) {
+    case 0:
+      [self title:@"O navegador leve, bonito e que não conta nada a ninguém."
+             lead:@"Abas que dormem, atos separados e privacidade no máximo desde agora."];
+      break;
+    case 1: {
+      y = [self title:@"Seus atos"
+                 lead:@"Cada ato tem abas, logins, cookies e extensões só dele. Atos fora de uso dormem e não gastam memória."];
+      NSTextField* label = Label(13, NSFontWeightRegular, kMute);
+      label.stringValue = @"Nome do primeiro ato";
+      label.frame = NSMakeRect(170, y + 6, 300, 18);
+      _atoName = [NSTextField textFieldWithString:@"Pessoal"];
+      _atoName.frame = NSMakeRect(170, y + 30, 300, 26);
+      NSTextField* cookies = Label(12, NSFontWeightRegular, kDim);
+      cookies.stringValue = @"Compartilhar cookies entre atos: desligado. Dá para mudar em Configurações › Atos.";
+      cookies.frame = NSMakeRect(90, y + 76, 460, 16);
+      cookies.alignment = NSTextAlignmentCenter;
+      for (NSView* v in @[ label, _atoName, cookies ]) [_body addSubview:v];
+      break;
+    }
+    case 2: {
+      y = [self title:@"Do seu jeito" lead:@"Muda a qualquer hora em Configurações › Aparência, sem reiniciar."];
+      NSSegmentedControl* theme = [NSSegmentedControl segmentedControlWithLabels:@[ @"Grafite", @"Brasa" ]
+                                                                     trackingMode:NSSegmentSwitchTrackingSelectOne
+                                                                           target:self
+                                                                           action:@selector(setTheme:)];
+      theme.selectedSegment = Theme() <= 1 ? Theme() : -1;  // Vidro and Seu live in Configurações
+      NSSegmentedControl* mode = [NSSegmentedControl segmentedControlWithLabels:@[ @"Sistema", @"Claro", @"Escuro" ]
+                                                                    trackingMode:NSSegmentSwitchTrackingSelectOne
+                                                                          target:self
+                                                                          action:@selector(setMode:)];
+      mode.selectedSegment = _browser ? agens_window_color_mode(_browser) : 0;
+      theme.frame = NSMakeRect((640 - theme.fittingSize.width) / 2, y + 10, theme.fittingSize.width, 24);
+      mode.frame = NSMakeRect((640 - mode.fittingSize.width) / 2, y + 50, mode.fittingSize.width, 24);
+      [_body addSubview:theme];
+      [_body addSubview:mode];
+      break;
+    }
+    case 3:
+      y = [self title:@"Sua privacidade já está no máximo" lead:@"Não precisa ligar nada. Se um site quebrar, você libera só ele."];
+      y = [self line:@"Bloqueio de rastreadores e cookies de terceiros" y:y];
+      y = [self line:@"Pedido de não rastrear (GPC e Do Not Track)" y:y];
+      y = [self line:@"Só HTTPS, e nada de pré-carregar páginas" y:y];
+      y = [self line:@"Localização e notificações bloqueadas; câmera e microfone perguntam" y:y];
+      [self line:@"Nenhuma telemetria: parado, o navegador não faz conexão nenhuma" y:y];
+      break;
+    case 4: {
+      y = [self title:@"Abrir os links no AgensBrowser?" lead:@"Links do Slack, do e-mail e de outros apps passam a abrir aqui."];
+      NSButton* yes = [NSButton buttonWithTitle:_madeDefault ? @"Pronto, é o padrão" : @"Usar como navegador padrão"
+                                         target:self
+                                         action:@selector(makeDefault:)];
+      yes.enabled = !_madeDefault;
+      yes.frame = NSMakeRect((640 - 240) / 2, y + 10, 240, 30);
+      [_body addSubview:yes];
+      break;
+    }
+    default:
+      [self title:@"Pronto." lead:@"Bom uso. Tudo isso fica em Configurações."];
+      break;
+  }
+  _back.hidden = step == 0;
+  _next.title = step == 5 ? @"Começar" : step == 4 && !_madeDefault ? @"Agora não" : @"Continuar";
+  for (NSView* v in [_dots.subviews copy]) [v removeFromSuperview];
+  for (int i = 0; i < 6; ++i) {
+    NSView* dot = [[NSView alloc] initWithFrame:NSMakeRect(14 + i * 13, 0, 7, 7)];
+    dot.wantsLayer = YES;
+    dot.layer.cornerRadius = 3.5;
+    dot.layer.backgroundColor = i == step ? CG(kLight3, root) : CG(kLineStrong, root);
+    [_dots addSubview:dot];
+  }
+}
+- (void)next:(id)sender {
+  if (_step == 1 && _browser && _atoName.stringValue.length) agens_window_rename_ato(_browser, 0, _atoName.stringValue.UTF8String);
+  if (_step == 5) {
+    [self close];
+    return;
+  }
+  [self showStep:_step + 1];
+}
+- (void)back:(id)sender {
+  if (_step > 0) [self showStep:_step - 1];
+}
+- (void)setTheme:(NSSegmentedControl*)seg {
+  g_theme = (int)seg.selectedSegment;
+  [NSUserDefaults.standardUserDefaults setInteger:g_theme forKey:kThemeKey];
+  if (g_theme == 1 && _browser) SetMode(_browser, kAgensModeDark);
+  [NSNotificationCenter.defaultCenter postNotificationName:kThemeChanged object:nil];
+  [self showStep:_step];
+}
+- (void)setMode:(NSSegmentedControl*)seg {
+  if (_browser) SetMode(_browser, (AgensColorMode)seg.selectedSegment);
+}
+- (void)makeDefault:(id)sender {
+  if (_browser) agens_window_set_default_browser(_browser);
+  _madeDefault = YES;
+  [self showStep:_step];
+}
