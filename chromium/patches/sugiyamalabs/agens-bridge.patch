+namespace agens::bridge::session {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr char kCancelled[] = "cancelled";
+
+constexpr char kNeedsLogin[] = "needs_login";
+
+// Per connection, and how long one may wait for the person (also covers a profile that never opens).
+constexpr size_t kMaxLoginsInFlight = 4;
+constexpr base::TimeDelta kMaxLoginTime = base::Minutes(15);
+
+constexpr size_t kMaxReasonChars = 1024;
+// session and renew per connection (one waiting on the sheet counts), the hidden tabs one may
+// open (one per origin of its localStorage and header items), how long reading may take once
+// approved, and the cookies a connection may have watched for session.lost.
+constexpr size_t kMaxReadsInFlight = 4;
+constexpr size_t kMaxPageOrigins = 4;
+constexpr base::TimeDelta kPageWait = base::Seconds(20);
+constexpr size_t kMaxWatches = 64;
+
+// The ato whose folder is `id`, among the atos the UI lists (as ops.cc), so a client never names a path.
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+network::mojom::CookieManager* CookiesOf(Profile* profile) {
+  return profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+}
+
+// Whether the ato would send a cookie `name` to `origin` (httpOnly included). Only that: the value
+// is not needed, so it never leaves the cookie store.
+void HasCookie(Profile* profile, const url::Origin& origin, const std::string& name, base::OnceCallback<void(bool)> done) {
+  CookiesOf(profile)->GetCookieList(
+      origin.GetURL(), net::CookieOptions::MakeAllInclusive(), net::CookiePartitionKeyCollection(),
+      base::BindOnce(
+          [](std::string name, base::OnceCallback<void(bool)> done, const std::vector<net::CookieWithAccessResult>& cookies,
+             const std::vector<net::CookieWithAccessResult>&) {
+            std::move(done).Run(std::ranges::any_of(cookies, [&](const auto& c) { return c.cookie.Name() == name; }));
+          },
+          name, std::move(done)));
+}
+
+bool IsInsertion(net::CookieChangeCause cause) {
+  return cause == net::CookieChangeCause::INSERTED || cause == net::CookieChangeCause::INSERTED_NO_CHANGE_OVERWRITE ||
+         cause == net::CookieChangeCause::INSERTED_NO_VALUE_CHANGE_OVERWRITE;
+}
+
+// Deleted or expired. OVERWRITE is only the old copy of a cookie being replaced: the new one
+// follows as an insertion.
+bool IsLoss(net::CookieChangeCause cause) {
+  return !IsInsertion(cause) && cause != net::CookieChangeCause::OVERWRITE;
+}
+
+bool AlwaysAllowed(const std::string& key) {
+  return std::ranges::contains(g_browser_process->local_state()->GetList(kAlwaysPref), base::Value(key));
+}
+
+class LoginWatch;
+class Read;
+class CookieWatch;
+
+// What this area keeps per connection; dropped in OnConnectionClosed.
+struct ConnectionState {
+  std::list<std::unique_ptr<LoginWatch>> logins;
+  std::list<std::unique_ptr<Read>> reads;  // session and renew in flight
+  // ApprovalKey()s the person allowed on this connection: what renew may fetch again.
+  std::set<std::string> approved;
+  std::list<std::unique_ptr<CookieWatch>> watches;  // cookies handed out, for session.lost
+};
+std::map<uint64_t, ConnectionState>& Connections() {
+  static base::NoDestructor<std::map<uint64_t, ConnectionState>> connections;
+  return *connections;
+}
+
+// A `login` in progress: the tab it opened and its `done` rule. Replies once and deletes itself;
+// deleted early (the connection closed), it stops watching and leaves the tab open.
+class LoginWatch : public content::WebContentsObserver, public network::mojom::CookieChangeListener {
+ public:
+  LoginWatch(uint64_t connection,
+             base::Value id,
+             ReplyCallback reply,
+             std::string url_prefix,
+             std::optional<url::Origin> cookie_origin,
+             std::string cookie_name)
+      : connection_(connection),
+        id_(std::move(id)),
+        reply_(std::move(reply)),
+        url_prefix_(std::move(url_prefix)),
+        cookie_origin_(std::move(cookie_origin)),
+        cookie_name_(std::move(cookie_name)) {
+    timeout_.Start(FROM_HERE, kMaxLoginTime,
+                   base::BindOnce(&LoginWatch::Finish, base::Unretained(this),
+                                  ErrorReply(&id_, kFailed, "timed out"), /*close_tab=*/false));
+  }
+
+  void Start(Profile* profile, content::WebContents* tab) {
+    Observe(tab);
+    if (!cookie_origin_) return;
+    CookiesOf(profile)->AddCookieChangeListener(cookie_origin_->GetURL(), cookie_name_,
+                                                receiver_.BindNewPipeAndPassRemote());
+    // E.g. the network service restarted: nothing would ever tell this watch.
+    receiver_.set_disconnect_handler(base::BindOnce(&LoginWatch::Finish, base::Unretained(this),
+                                                    ErrorReply(&id_, kFailed, "lost the cookie store"),
+                                                    /*close_tab=*/false));
+    // The person may already be logged in.
+    HasCookie(profile, *cookie_origin_, cookie_name_,
+              base::BindOnce(
+                  [](base::WeakPtr<LoginWatch> self, bool has) {
+                    if (self && has) self->Finish(OkReply(self->id_), /*close_tab=*/true);
+                  },
+                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Fail() { Finish(ErrorReply(&id_, kFailed, "could not open the ato"), /*close_tab=*/false); }
+
+ private:
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (!url_prefix_.empty() && navigation->IsInPrimaryMainFrame() && navigation->HasCommitted() &&
+        !navigation->IsErrorPage() && base::StartsWith(navigation->GetURL().spec(), url_prefix_)) {
+      Finish(OkReply(id_), /*close_tab=*/true);
+    }
+  }
+  void WebContentsDestroyed() override {
+    Finish(ErrorReply(&id_, kCancelled, "the tab was closed"), /*close_tab=*/false);
+  }
+
+  // network::mojom::CookieChangeListener:
+  void OnCookieChange(const net::CookieChangeInfo& change) override {
+    if (change.cookie.Name() == cookie_name_ && IsInsertion(change.cause)) Finish(OkReply(id_), /*close_tab=*/true);
+  }
+
+  // Deletes this.
+  void Finish(std::string line, bool close_tab) {
+    std::move(reply_).Run(std::move(line));
+    if (close_tab && web_contents()) {
+      // Posted: not from inside the tab's own observer call.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::WeakPtr<content::WebContents> tab) {
+                           if (tab) tab->ClosePage();
+                         },
+                         web_contents()->GetWeakPtr()));
+    }
+    Observe(nullptr);
+    std::erase_if(Connections()[connection_].logins, [this](const auto& watch) { return watch.get() == this; });
+  }
+
+  const uint64_t connection_;
+  const base::Value id_;
+  ReplyCallback reply_;
+  const std::string url_prefix_;  // spec of the URL; empty for a cookie rule
+  const std::optional<url::Origin> cookie_origin_;
+  const std::string cookie_name_;
+  mojo::Receiver<network::mojom::CookieChangeListener> receiver_{this};
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<LoginWatch> weak_factory_{this};
+};
+
+void Login(const Client& client, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  const GURL url(StringParam(request.body, "url").value_or(""));
+  const base::DictValue* done = request.body.FindDict("done");
+  std::string url_prefix;
+  std::optional<url::Origin> cookie_origin;
+  std::string cookie_name;
+  bool done_ok = false;
+  // The rule must be about the site it opens: otherwise opening any page would tell a client whether
+  // the person is logged in somewhere else, unseen.
+  auto same_site = [&](const url::Origin& other) {
+    return url.is_valid() && net::registry_controlled_domains::SameDomainOrHost(
+                                 url::Origin::Create(url), other,
+                                 net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  };
+  if (done && done->size() == 1) {
+    const GURL prefix(StringParam(*done, "url_prefix").value_or(""));
+    if (prefix.is_valid() && prefix.SchemeIsHTTPOrHTTPS() && same_site(url::Origin::Create(prefix))) {
+      url_prefix = prefix.spec();
+      done_ok = true;
+    }
+  } else if (done && done->size() == 2) {
+    std::optional<std::string> name = StringParam(*done, "cookie");
+    std::optional<std::string> from = StringParam(*done, "from");
+    cookie_origin = from ? ParseOrigin(*from) : std::nullopt;
+    if (name && ValidName(*name) && cookie_origin && same_site(*cookie_origin)) {
+      cookie_name = *name;
+      done_ok = true;
+    }
+  }
+  if (!id || !url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !done_ok) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                    "needs ato, url (http or https) and done: {cookie, from} or {url_prefix}, "
+                                    "on the same site as url"));
+    return;
+  }
+  if (Connections()[client.connection].logins.size() >= kMaxLoginsInFlight) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "at most 4 logins at once per connection"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  auto owned = std::make_unique<LoginWatch>(client.connection, request.id.Clone(), std::move(reply),
+                                            std::move(url_prefix), std::move(cookie_origin), std::move(cookie_name));
+  LoginWatch* watch = owned.get();
+  Connections()[client.connection].logins.push_back(std::move(owned));
+  // Loads the profile when it isn't, and opens (or brings up) its window.
+  profiles::SwitchToProfile(
+      entry->GetPath(), /*always_create=*/false,
+      base::BindOnce(
+          [](uint64_t connection, LoginWatch* watch, GURL url, BrowserWindowInterface* browser) {
+            // The connection may have closed meanwhile, taking the watch with it.
+            auto it = Connections().find(connection);
+            if (it == Connections().end() ||
+                !std::ranges::any_of(it->second.logins, [&](const auto& w) { return w.get() == watch; })) {
+              return;
+            }
+            content::WebContents* tab = nullptr;
+            if (browser) {
+              NavigateParams params(browser, url, ui::PAGE_TRANSITION_LINK);
+              params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+              Navigate(&params);
+              tab = params.navigated_or_inserted_contents;
+            }
+            if (tab) {
+              watch->Start(browser->GetProfile(), tab);
+            } else {
+              watch->Fail();
+            }
+          },
+          client.connection, watch, url));
+}
+
+
+// A cookie handed out on a connection: session.lost to it once the cookie is deleted or expires
+// in the ato's store, then the watch ends. Names only, never the value.
+class CookieWatch : public network::mojom::CookieChangeListener {
+ public:
+  CookieWatch(uint64_t connection, std::string ato, Item item)
+      : connection_(connection), ato_(std::move(ato)), item_(std::move(item)) {}
+
+  void Start(Profile* profile) {
+    CookiesOf(profile)->AddCookieChangeListener(item_.origin.GetURL(), item_.name, receiver_.BindNewPipeAndPassRemote());
+    // The store went away (the ato closed, the network service restarted): nothing to tell.
+    receiver_.set_disconnect_handler(base::BindOnce(&CookieWatch::Drop, base::Unretained(this)));
+  }
+
+  bool Watches(const std::string& ato, const Item& item) const {
+    return ato == ato_ && item.origin == item_.origin && item.name == item_.name;
+  }
+
+ private:
+  // network::mojom::CookieChangeListener:
+  void OnCookieChange(const net::CookieChangeInfo& change) override {
+    if (change.cookie.Name() != item_.name || !IsLoss(change.cause)) return;
+    base::DictValue fields;
+    fields.Set("ato", ato_);
+    fields.Set("from", item_.from);
+    fields.Set("name", item_.name);
+    SendEventTo(connection_, "session.lost", std::move(fields));
+    Drop();
+  }
+
+  // Deletes this.
+  void Drop() {
+    std::erase_if(Connections()[connection_].watches, [this](const auto& watch) { return watch.get() == this; });
+  }
+
+  const uint64_t connection_;
+  const std::string ato_;
+  const Item item_;
+  mojo::Receiver<network::mojom::CookieChangeListener> receiver_{this};
+};
+
+void Watch(uint64_t connection, const std::string& ato, Profile* profile, const Item& item) {
+  std::list<std::unique_ptr<CookieWatch>>& watches = Connections()[connection].watches;
+  // shortcut: past kMaxWatches a cookie is handed out unwatched; upgrade if a bridge needs more.
+  if (watches.size() >= kMaxWatches ||
+      std::ranges::any_of(watches, [&](const auto& watch) { return watch->Watches(ato, item); })) {
+    return;
+  }
+  watches.push_back(std::make_unique<CookieWatch>(connection, ato, item));
+  watches.back()->Start(profile);
+}
+
+// One session or renew, from the request to the reply: the approval (session), loading the ato,
+// reading each item (session_read.h), the reply. Replies once and deletes itself; deleted early
+// (the connection closed), it closes its hidden tabs without replying.
+class Read : public ProfileObserver {
+ public:
+  Read(uint64_t connection, bool renew, std::string ato, base::FilePath path, std::vector<Item> items, base::Value id,
+       ReplyCallback reply)
+      : connection_(connection),
+        renew_(renew),
+        ato_(std::move(ato)),
+        path_(std::move(path)),
+        items_(std::move(items)),
+        id_(std::move(id)),
+        reply_(std::move(reply)),
+        values_(items_.size()) {}
+
+  base::WeakPtr<Read> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+
+  // The person's answer to the sheet; `shares_with` is what the sheet said.
+  void Approved(std::string key, bool signed_client, std::vector<std::string> shares_with, AgensApprovalAnswer answer) {
+    if (answer == kAgensApprovalDeny) return Fail(kDenied, "");
+    if (!AgensWindow::Storage().GetProfileAttributesWithPath(path_)) return Fail(kNotFound, "the ato is gone");
+    if (control::SharesWith(path_) != shares_with) {
+      return Fail(kDenied, "the ato's cookie sharing changed while asking");
+    }
+    if (answer == kAgensApprovalAllowAlways && signed_client && !AlwaysAllowed(key)) {
+      ScopedListPrefUpdate(g_browser_process->local_state(), kAlwaysPref)->Append(key);
+    }
+    Connections()[connection_].approved.insert(std::move(key));
+    Start();
+  }
+
+  // Wakes the ato when it sleeps (no window), then reads.
+  void Start() {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (Profile* profile = manager->GetProfileByPath(path_)) return Loaded(profile);
+    // The callback runs once in every case, with null when loading fails.
+    manager->LoadProfileByPath(path_, /*incognito=*/false, base::BindOnce(&Read::Loaded, GetWeakPtr()));
+  }
+
+  // Deletes this.
+  void Fail(std::string_view code, std::string_view message) {
+    std::move(reply_).Run(ErrorReply(&id_, code, message));
+    Drop();
+  }
+
+ private:
+  static constexpr size_t kNoPage = static_cast<size_t>(-1);
+
+  // A hidden tab of the ato at one origin, and what reads it.
+  struct Page {
+    std::unique_ptr<content::WebContents> tab;
+    std::unique_ptr<PageReader> reader;  // declared after the tab: always destroyed before it
+  };
+
+  void Loaded(Profile* profile) {
+    if (!profile) return Fail(kFailed, "could not open the ato");
+    profile_ = profile;
+    profile_observation_.Observe(profile);
+    timeout_.Start(FROM_HERE, kPageWait, base::BindOnce(&Read::Finish, base::Unretained(this)));
+    std::vector<size_t> cookies;
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (items_[i].type == "cookie") cookies.push_back(i);
+    }
+    if (!cookies.empty()) {
+      ++pending_;
+      ReadCookies(profile, Pick(cookies), base::BindOnce(&Read::Got, GetWeakPtr(), cookies, kNoPage));
+    }
+    for (const url::Origin& origin : PageOrigins(items_)) {
+      std::vector<size_t> indices;
+      for (size_t i = 0; i < items_.size(); ++i) {
+        if (items_[i].type != "cookie" && items_[i].origin == origin) indices.push_back(i);
+      }
+      content::WebContents::CreateParams params(profile);
+      params.initially_hidden = true;
+      Page page;
+      page.tab = content::WebContents::Create(params);
+      page.tab->SetAudioMuted(true);
+      page.reader = ReadFromPage(page.tab.get(), origin, Pick(indices),
+                                 base::BindOnce(&Read::Got, GetWeakPtr(), indices, pages_.size()));
+      content::WebContents* tab = page.tab.get();
+      pages_.push_back(std::move(page));
+      ++pending_;
+      tab->GetController().LoadURL(origin.GetURL(), content::Referrer(), ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                   std::string());
+    }
+  }
+
+  std::vector<Item> Pick(const std::vector<size_t>& indices) const {
+    std::vector<Item> items;
+    for (size_t i : indices) items.push_back(items_[i]);
+    return items;
+  }
+
+  void Got(std::vector<size_t> indices, size_t page, Values values) {
+    if (values.size() == indices.size()) {
+      for (size_t i = 0; i < indices.size(); ++i) values_[indices[i]] = std::move(values[i]);
+    }
+    if (page != kNoPage) {
+      pages_[page].reader.reset();
+      pages_[page].tab.reset();
+    }
+    if (--pending_ == 0) Finish();
+  }
+
+  // Every item read, or kPageWait passed: what is still missing stays missing. Deletes this.
+  void Finish() {
+    std::vector<std::string> missing;
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (!values_[i]) missing.push_back(Describe(items_[i]));
+    }
+    if (!missing.empty()) {
+      // Names only, never a value.
+      return renew_ ? Fail(kNeedsLogin, "missing: " + base::JoinString(missing, "; "))
+                    : Fail(kNotFound, "missing: " + base::JoinString(missing, "; "));
+    }
+    base::ListValue list;
+    for (size_t i = 0; i < items_.size(); ++i) {
+      base::DictValue item;
+      item.Set("type", items_[i].type);
+      item.Set("from", items_[i].from);
+      item.Set("name", items_[i].name);
+      item.Set("value", std::move(*values_[i]));
+      list.Append(std::move(item));
+    }
+    base::DictValue result;
+    result.Set("items", std::move(list));
+    std::move(reply_).Run(OkReply(id_, std::move(result)));
+    for (const Item& item : items_) {
+      if (item.type == "cookie") Watch(connection_, ato_, profile_, item);
+    }
+    Drop();
+  }
+
+  // ProfileObserver: the tabs must go before their profile does.
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    pages_.clear();
+    profile_observation_.Reset();
+    Fail(kFailed, "the ato closed");
+  }
+
+  // Deletes this.
+  void Drop() {
+    std::erase_if(Connections()[connection_].reads, [this](const auto& read) { return read.get() == this; });
+  }
+
+  const uint64_t connection_;
+  const bool renew_;
+  const std::string ato_;
+  const base::FilePath path_;
+  const std::vector<Item> items_;
+  const base::Value id_;
+  ReplyCallback reply_;
+  Values values_;  // one per item; never logged
+  size_t pending_ = 0;
+  raw_ptr<Profile> profile_ = nullptr;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  std::vector<Page> pages_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<Read> weak_factory_{this};
+};
+
+// session and renew: the same checks, then the sheet (session) or a past approval (renew).
+void SessionOrRenew(const Client& client, Request request, ReplyCallback reply) {
+  const bool renew = request.op == "renew";
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> reason = renew ? std::string() : StringParam(request.body, "reason");
+  if (!id || !reason || (!reason->empty() && !IsDisplayText(*reason, kMaxReasonChars))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                    renew ? "needs ato and need"
+                                          : "needs ato, need and reason (up to 1024 characters, no control characters)"));
+    return;
+  }
+  std::string error;
+  std::optional<std::vector<Item>> items = ParseNeed(request.body.Find("need"), error);
+  if (!items) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, error));
+    return;
+  }
+  if (PageOrigins(*items).size() > kMaxPageOrigins) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "localStorage and header items of at most 4 origins at once"));
+    return;
+  }
+  ConnectionState& state = Connections()[client.connection];
+  if (state.reads.size() >= kMaxReadsInFlight) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "at most 4 session or renew at once per connection"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  // "Permitir sempre" only for a signed app, for this ato and exactly these items.
+  const bool signed_client = !client.identity.empty();
+  std::string key = ApprovalKey(client.identity, *id, *items);
+  const bool always = signed_client && AlwaysAllowed(key);
+  // renew never shows a sheet: it fetches again what the person already allowed.
+  if (renew && !always && !state.approved.contains(key)) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized,
+                                    "not approved: ask for these exact items with session first, on this connection"));
+    return;
+  }
+  const std::vector<std::string> shares_with = control::SharesWith(entry->GetPath());
+  auto owned = std::make_unique<Read>(client.connection, renew, *id, entry->GetPath(), *items, request.id.Clone(),
+                                      std::move(reply));
+  Read* read = owned.get();
+  state.reads.push_back(std::move(owned));
+  if (renew || always) {
+    if (always) state.approved.insert(std::move(key));
+    read->Start();
+    return;
+  }
+  std::vector<std::string> names;
+  for (const std::string& folder : shares_with) {
+    if (ProfileAttributesEntry* other = FindAto(folder)) names.push_back(AgensWindow::AtoName(other));
+  }
+  const std::string app = client.name.empty() ? "app" : client.name;
+  // The sheet's text in parts, for a host that draws its own.
+  base::DictValue facts;
+  facts.Set("kind", "session");
+  facts.Set("ato", *id);
+  facts.Set("ato_name", AgensWindow::AtoName(entry));
+  if (!reason->empty()) facts.Set("reason", *reason);
+  base::ListValue item_list, shares_list;
+  for (const Item& item : *items) {
+    item_list.Append(base::DictValue().Set("type", item.type).Set("from", item.from).Set("name", item.name));
+  }
+  for (const std::string& name : names) shares_list.Append(name);
+  facts.Set("items", std::move(item_list));
+  if (!shares_list.empty()) facts.Set("shares_with", std::move(shares_list));
+  AskApproval(client.connection, SheetTitle(app, *items), SheetDetail(*reason, AgensWindow::AtoName(entry), *items, names),
+              /*offer_always=*/signed_client,
+              base::BindOnce(&Read::Approved, read->GetWeakPtr(), std::move(key), signed_client, shares_with),
+              std::move(facts));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return op == "login" || op == "session" || op == "renew";
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  if (request.op == "login") {
+    Login(client, std::move(request), std::move(reply));
+  } else if (request.op == "session" || request.op == "renew") {
+    SessionOrRenew(client, std::move(request), std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, request.op));
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  Connections().erase(connection);
+}
+
+}  // namespace agens::bridge::session
