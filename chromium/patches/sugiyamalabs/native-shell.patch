+static const PrefService::Preference* Find(AgensWindow* w, AgensPrefStore store, const char* name,
+                                           base::Value::Type type) {
+  const PrefService::Preference* pref = name ? Store(w, store)->FindPreference(name) : nullptr;
+  return pref && pref->GetType() == type ? pref : nullptr;
