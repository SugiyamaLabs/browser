+// Clicks on the page (where there is no chrome view) go to the page underneath.
+- (NSView*)hitTest:(NSPoint)point {
+  NSView* hit = [super hitTest:point];
+  if (hit == self && NSPointInRect([self convertPoint:point fromView:self.superview], _page)) return nil;
+  return hit;
+}
