+// page.key's key names and the password rules that depend on them (docs/protocolo.md, "control,
+// tab, page"). Pure logic, checked by protocol_selfcheck.cc with only //base.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_CONTROL_KEYS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_CONTROL_KEYS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace agens::bridge {
+
+struct Key {
+  std::string key;        // DOM key value: "Enter", "a"
+  std::string code;       // DOM code: "Enter", "KeyA"; empty when it has none we know
+  int windows_code = 0;   // Windows virtual key code (Chromium's ui::KeyboardCode); 0 when none
+  std::u16string text;    // what it types: the character, "\r" for Enter; empty for the others
+  bool shift = false, meta = false, alt = false, ctrl = false;
+  bool edits = false;     // inserts or deletes text
+};
+
+// A named key (Enter, Tab, Escape, Backspace, Delete, ArrowUp/Down/Left/Right, PageUp/PageDown,
+// Home, End) or one character, with `modifiers` ("shift", "meta", "alt", "ctrl"; may be null).
+// nullopt for anything else.
+std::optional<Key> ParseKey(std::string_view name, const base::Value* modifiers);
+
+// Allowed while a password field has the focus: keys that move, never ones that type, delete or
+// carry a modifier other than Shift. Enter is allowed on purpose: it submits a form with a
+// password the person typed, and the controller never sees the value.
+bool AllowedOnPassword(const Key& key);
+
+// Copy, cut or paste: never, so the clipboard stays out of the controller's reach.
+bool TouchesClipboard(const Key& key);
+
+// While a password field has the focus (`on_password`), or not: whether page.key may send `key`.
+// Copy, cut and paste only with control.start's "clipboard" (then also on a password field).
+bool KeyAllowed(const Key& key, bool on_password, bool clipboard);
+
+// control.start's `allow`: a list of "passwords", "clipboard" and "eval", sorted, without repeats; nullopt
+// for anything else (not a list, another value). Null `value` (omitted) is an empty list.
+std::optional<std::vector<std::string>> ParseAllow(const base::Value* value);
+// What the approval sheet says about `allow` (from ParseAllow), after the reason; empty for none.
+std::string AllowDetail(const std::vector<std::string>& allow);
+
+// control.start's "Permitir sempre": what Local State remembers, one string per answer. The
+// app's identity, the ato's folder, the folders of the atos it shares cookies with (any order)
+// and the `allow` list (sorted), so that a change in that group or asking for more asks again.
+std::string ControlAlwaysKey(std::string_view identity,
+                             std::string_view ato,
+                             std::vector<std::string> shares_with,
+                             const std::vector<std::string>& allow = {});
+
+// Text the shell shows (control.start's agent and reason, control.status): valid UTF-8, 1 to `max`
+// characters, no control characters and no bidi controls that could reorder what is shown.
+bool IsDisplayText(std::string_view utf8, size_t max);
+
+// While the person is in control (control.paused), these ops answer kPaused.
+bool PauseBlocks(std::string_view op);
+
+// While a JavaScript dialog of the tab is open, these ops on it answer kDialogOpen.
+bool DialogBlocks(std::string_view op);
+
+// page.eval runs only on a local page: http or https on localhost, *.localhost, 127.0.0.1 or
+// [::1]. `url` is the committed origin's URL.
+bool IsLocalURL(const GURL& url);
+
+// An http:// page that is not local (IsLocalURL): anyone on the network may have read or changed
+// it. page.* answers carry insecure: true there, and typing waits for the person's OK.
+bool IsInsecurePage(const GURL& url);
+// page.key that puts text into the page: a character (no meta or ctrl) or paste. Keys that move,
+// Enter, Backspace and Delete don't.
+bool KeyTypes(const Key& key);
+// An ok reply line with "insecure": true added; any other line as it is.
+std::string MarkInsecure(std::string line);
+
+// `text` cut to at most `max` characters (code points), never inside one.
+std::string ClipChars(std::string text, size_t max);
+
+// "A", "A e B", "A, B e C".
+std::string JoinNames(const std::vector<std::string>& names);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_CONTROL_KEYS_H_
