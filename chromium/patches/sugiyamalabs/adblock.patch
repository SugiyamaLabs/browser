 #include "base/files/file_path.h"
+#include "base/files/file_util.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "base/functional/callback_helpers.h"
@@ -1844,6 +1845,43 @@ void BrowserProcessImpl::CreateSubresourceFilterRulesetService() {
           subresource_filter::kSafeBrowsingRulesetConfig, local_state(),
           user_data_dir,
           subresource_filter::SafeBrowsingRulesetPublisher::Factory());
+
+  // SugiyamaLabs: index the ad blocker ruleset that ships inside the app. It is
+  // re-indexed only when the file changes (a new app version).
+  base::FilePath rules_path;
+  if (!base::FeatureList::IsEnabled(subresource_filter::kNativeAdblock) ||
+      !base::PathService::Get(chrome::DIR_RESOURCES, &rules_path)) {
+    return;
+  }
+  rules_path = rules_path.AppendASCII("adblock_rules");
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](const base::FilePath& path) {
+            base::File::Info info;
+            if (!base::GetFileInfo(path, &info)) {
+              return std::string();
+            }
+            return base::NumberToString(info.size) + "-" +
+                   base::NumberToString(
+                       info.last_modified.InMillisecondsSinceUnixEpoch());
+          },
+          rules_path),
+      base::BindOnce(
+          [](const base::FilePath& path, std::string version) {
+            subresource_filter::RulesetService* service =
+                g_browser_process
+                    ? g_browser_process->subresource_filter_ruleset_service()
+                    : nullptr;
+            if (!service || version.empty()) {
+              return;
+            }
+            subresource_filter::UnindexedRulesetInfo info;
+            info.content_version = std::move(version);
+            info.ruleset_path = path;
+            service->IndexAndStoreAndPublishRulesetIfNeeded(info);
+          },
+          rules_path));
 }
 
