+- (AgensRect)layoutForWidth:(int)width height:(int)height {
+  // Open column: two columns like the body below (buttons end where the tab column ends, the
+  // address has the page card's edges). Collapsed: the buttons follow the traffic lights.
+  // During the animation everything follows the current width: the buttons slide from the end
+  // of the column to after the traffic lights, and the labels switch at the halfway point.
+  // Tabs on top (prototype .layout-top): a strip of pills by the lights, the bar under it with
+  // the atos before the menu, and the page card across the whole width.
+  const BOOL top = _top;
+  const CGFloat side = top ? 0 : _sideW;
+  const BOOL narrow = side < (kRail + kSide) / 2;
+  for (NSView* v in @[ _toggle, _atoTile, _atoName, _separator, _newTab, _tabsScroll, _atosLine ]) v.hidden = top;
+  _newTabTop.hidden = !top;
+  for (AgensTabRow* row in _rows) {
+    NSView* parent = top || row.pinned ? self : _tabsDoc;
+    if (row.superview != parent) {
+      if (parent == self) {
+        [self addSubview:row positioned:NSWindowBelow relativeTo:_ntp];
+      } else {
+        [parent addSubview:row];
+      }
+    }
+    TabLook look = top ? kLookTop : row.pinned ? kLookPin : kLookRow;
+    if (row.look != look) row.look = look;
+  }
+
+  const CGFloat barY = top ? kStrip : 0;
+  CGFloat columnEnd = kPad + side;
+  CGFloat navX = top ? kPad - 30 : MAX(kLightsEnd, columnEnd - 118);
+  _toggle.frame = NSMakeRect(navX, 12, 28, 28);
+  _back.frame = NSMakeRect(navX + 30, barY + 12, 28, 28);
+  _forward.frame = NSMakeRect(navX + 60, barY + 12, 28, 28);
+  _reload.frame = NSMakeRect(navX + 90, barY + 12, 28, 28);
+  CGFloat omniX = top ? NSMaxX(_reload.frame) + 10 : MAX(columnEnd + kGap, navX + 126);
+  _menu.frame = NSMakeRect(width - kPad - 28, barY + 12, 28, 28);
+  CGFloat omniEnd = NSMinX(_menu.frame) - 4;
+  if (!_downloadsButton.hidden) {
+    _downloadsButton.frame = NSMakeRect(NSMinX(_menu.frame) - 30, barY + 12, 28, 28);
+    omniEnd = NSMinX(_downloadsButton.frame) - 4;
+  }
+
+  // Atos: only what fits (6 in the open column, 5 collapsed, 4 on the bar); past that the last
+  // slot is "⋯" with the full list, and the current ato always stays in view.
+  const NSUInteger n = _atoButtons.count, cap = top ? 4 : narrow ? 5 : 6;
+  const BOOL overflow = n > cap;
+  std::vector<int> shown;
+  for (int i = 0; i < (int)(overflow ? cap - 1 : n); ++i) shown.push_back(i);
+  if (overflow && _activeAto >= (int)shown.size()) shown.back() = _activeAto;
+  NSMutableArray<NSView*>* foot = [NSMutableArray array];
+  for (AgensAtoButton* b in _atoButtons) b.hidden = YES;
+  for (int i : shown) {
+    _atoButtons[i].hidden = NO;
+    [foot addObject:_atoButtons[i]];
+  }
+  _moreAtos.hidden = !overflow;
+  if (overflow) [foot addObject:_moreAtos];
+  [foot addObject:_addAto];
+  _atoDot.hidden = YES;
+  if (top) {  // on the bar, before downloads and the menu (prototype .profiles)
+    CGFloat x = omniEnd - foot.count * 32 + 2;
+    omniEnd = x - 10;
+    for (NSView* v in foot) {
+      v.frame = NSMakeRect(x, barY + 12, 30, 28);
+      x += 32;
+    }
+  }
+  _omni.frame = NSMakeRect(omniX, barY + 9, omniEnd - omniX, 34);
+  _omniIcon.frame = NSMakeRect(12, 10, 14, 14);
+  _siteButton.frame = NSInsetRect(_omniIcon.frame, -6, -6);
+  _star.frame = NSMakeRect(NSWidth(_omni.frame) - 4 - 26, 4, 26, 26);
+  _sound.frame = NSMakeRect(NSMinX(_star.frame) - 26, 4, 26, 26);
+  const CGFloat addressEnd = _sound.hidden ? NSMinX(_star.frame) : NSMinX(_sound.frame);
+  _address.frame = NSMakeRect(33, 8, addressEnd - 6 - 33, 18);
+
+  NSMutableArray<AgensTabRow*>* pins = [NSMutableArray array];
+  NSMutableArray<AgensTabRow*>* list = [NSMutableArray array];
+  for (AgensTabRow* row in _rows) [row.pinned ? pins : list addObject:row];
+  NSRect page;
+  if (top) {
+    // The strip: pinned tabs as 44 pt icons, the rest share what's left (prototype .ttab: up to
+    // 220 pt, at least 44). The "+" stays at the right end.
+    _newTabTop.frame = NSMakeRect(width - kPad - 28, 12, 28, 28);
+    const CGFloat x0 = kLightsEnd, end = NSMinX(_newTabTop.frame) - 6;
+    const CGFloat pinsW = pins.count * 48;
+    const CGFloat w = list.count ? MAX(44, MIN(220, (end - x0 - pinsW + 4) / list.count - 4)) : 0;
+    _tabStep = w + 4;
+    _listX = x0 + pinsW;
+    CGFloat x = x0;
+    for (AgensTabRow* row in pins) {
+      row.frame = NSMakeRect(x, 10, 44, 32);
+      row.hidden = x + 44 > end;
+      x += 48;
+    }
+    int slot = 0;
+    for (AgensTabRow* row in list) {
+      if (row == _dragged) continue;  // it follows the pointer (dragRow:by:)
+      if (_dragged && slot == _dropIndex - _pinnedCount) x += w + 4;  // where it will land
+      row.frame = NSMakeRect(x, 10, w, 32);
+      // shortcut: tabs past the end are hidden, not scrolled; add strip scrolling if people keep 30+ tabs on top.
+      row.hidden = x + w > end;
+      x += w + 4;
+      ++slot;
+    }
+    page = NSMakeRect(kPad, kStrip + 52, width - 2 * kPad, height - kStrip - 52 - kPad);
+  } else {
+    // Column: ato title (prototype .space-title), pinned tiles, separator, new tab, tabs.
+    CGFloat y = kToolbar;
+    CGFloat inset = narrow ? (side - 18) / 2 : 8;
+    _atoTile.frame = NSMakeRect(kPad + inset, y + 7, 18, 18);
+    _atoName.frame = NSMakeRect(kPad + 35, y + 7, kSide - 43, 18);
+    _atoName.hidden = narrow;
+    y += kRow + 6;
+    // Pinned (prototype .pinned): a grid of four 36 pt tiles; one per line in the rail.
+    const CGFloat tileW = narrow ? side : (side - 12) / 4, tileH = narrow ? kRow : 36;
+    for (NSUInteger i = 0; i < pins.count; ++i) {
+      const NSUInteger col = narrow ? 0 : i % 4, line = narrow ? i : i / 4;
+      pins[i].hidden = NO;
+      if (pins[i] != _dragged) {
+        pins[i].frame = NSMakeRect(kPad + col * (tileW + 4), y + line * (tileH + 4), tileW, tileH);
+      }
+    }
+    if (pins.count) y += ((narrow ? pins.count : (pins.count + 3) / 4) * (tileH + 4)) + 2;
+    _separator.frame = NSMakeRect(kPad + (narrow ? 6 : 8), y, side - (narrow ? 12 : 16), 1);
+    y += 7;
+    _newTab.frame = NSMakeRect(kPad, y, side, kRow);
+    _newTabPlus.frame = NSMakeRect(narrow ? (side - 16) / 2 : 8, 8, 16, 16);
+    _newTabLabel.frame = NSMakeRect(34, 7, 150, 18);
+    _newTabLabel.hidden = narrow;
+    y += kRow + 1;
+
+    // Atos at the foot with a line above (prototype .spaces): a centered row when open, a column
+    // when collapsed. The warm dot marks the current one: under it, or to its left in the column.
+    CGFloat footY;
+    if (!narrow) {
+      footY = height - kPad - kAtos;
+      _atosLine.frame = NSMakeRect(kPad, footY, side, 1);
+      CGFloat x = kPad + (side - foot.count * 32) / 2;
+      for (NSView* v in foot) {
+        v.frame = NSMakeRect(x, footY + 8, 30, 28);
+        if ([v isKindOfClass:AgensAtoButton.class] && ((AgensAtoButton*)v).selected) {
+          _atoDot.frame = NSMakeRect(x + 13, footY + 8 + 28 + 3, 4, 4);
+          _atoDot.hidden = NO;
+        }
+        x += 32;
+      }
+    } else {
+      footY = height - kPad - 8 - foot.count * 32;
+      _atosLine.frame = NSMakeRect(kPad + 6, footY, side - 12, 1);
+      CGFloat x = kPad + (side - 30) / 2, by = footY + 8;
+      for (NSView* v in foot) {
+        v.frame = NSMakeRect(x, by, 30, 28);
+        if ([v isKindOfClass:AgensAtoButton.class] && ((AgensAtoButton*)v).selected) {
+          _atoDot.frame = NSMakeRect(x - 5, by + 12, 4, 4);
+          _atoDot.hidden = NO;
+        }
+        by += 32;
+      }
+    }
+
+    // The tabs fill what's left and scroll. The collapsed rail is too narrow for a scroller next
+    // to the icons; it still scrolls with the trackpad or wheel.
+    _tabsScroll.hasVerticalScroller = !narrow;
+    _tabsScroll.verticalScroller.alphaValue = 1;
+    _tabsScroll.frame = NSMakeRect(kPad, y, side, MAX(0, footY - 6 - y));
+    CGFloat rowY = 0;
+    int slot = 0;
+    for (AgensTabRow* row in list) {
+      row.hidden = NO;
+      if (row == _dragged) continue;  // it follows the pointer (dragRow:by:)
+      if (_dragged && slot == _dropIndex - _pinnedCount) rowY += kRow + 1;  // where it will land
+      row.frame = NSMakeRect(0, rowY, side, kRow);
+      rowY += kRow + 1;
+      ++slot;
+    }
+    if (_dragged && !_dragged.pinned) rowY += kRow + 1;
+    _tabsDoc.frame = NSMakeRect(0, 0, side, MAX(rowY, NSHeight(_tabsScroll.frame)));
+    page = NSMakeRect(columnEnd + kGap, kToolbar, width - (columnEnd + kGap) - kPad,
+                      height - kToolbar - kPad);
+  }
+
+  _page = page;
+  _ntp.frame = NSInsetRect(_page, 1, 1);
+  _history.frame = _ntp.frame;
+  _loadbar.frame = NSMakeRect(NSMinX(_page), NSMinY(_page) - 5, NSWidth(_page), 2);
+  if (NSWidth(_page) != _loadW) [self runLoadbar];  // the sweep is sized to the line
+  CGFloat statusW = MIN(ceil(_statusText.fittingSize.width) + 24, NSWidth(_page) / 2);
+  _statusPill.frame = NSMakeRect(NSMinX(_page) + 8, NSMaxY(_page) - 8 - 22, statusW, 22);
+  _statusText.frame = NSMakeRect(10, 3, statusW - 20, 16);
+
+  NSRect anchor = [self editingField] == _ntp.field ? [_ntp convertRect:_ntp.well.frame toView:self]
+                                                     : _omni.frame;
+  CGFloat rowsH = _suggestionRows.count * 34;
+  _suggest.frame = NSMakeRect(NSMinX(anchor), NSMaxY(anchor) + 6, NSWidth(anchor), rowsH + 10);
+  for (NSUInteger i = 0; i < _suggestionRows.count; ++i) {
+    _suggestionRows[i].frame = NSMakeRect(5, 5 + i * 34, NSWidth(anchor) - 10, 34);
+  }
+  return {(int)NSMinX(_page), (int)NSMinY(_page), (int)NSWidth(_page), (int)NSHeight(_page)};
+}
+- (AgensRect)siteIconRect {
+  NSRect r = [_omni convertRect:_omniIcon.frame toView:self];
+  return {(int)NSMinX(r), (int)NSMinY(r), (int)NSWidth(r), (int)NSHeight(r)};
+}
+- (void)relayout {
+  [self layoutForWidth:(int)NSWidth(self.bounds) height:(int)NSHeight(self.bounds)];
