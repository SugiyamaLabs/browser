+// Copyright 2026 SugiyamaLabs.
+// A tab shown by another app (docs/poc/embed.md). The tab is not in any window here: its
+// compositor draws into a CAContext, the other app hosts that context in a CALayerHost and sends
+// its NSEvents back. This is the browser side of what RenderWidgetHostViewCocoa does for an app
+// shim, without Chromium code in the other app.
+#ifndef CONTENT_PUBLIC_BROWSER_AGENS_EMBED_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_AGENS_EMBED_MAC_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+
+class WebContents;
+
+// Runs on the UI thread for every frame of a tab that draws by itself (not inside a views
+// window). `ca_context_id` is what the other app gives to its CALayerHost.
+using AgensEmbedLayerCallback = base::RepeatingCallback<
+    void(WebContents*, uint32_t ca_context_id, const gfx::Size& pixel_size, float scale)>;
+CONTENT_EXPORT void SetAgensEmbedLayerCallback(AgensEmbedLayerCallback callback);
+
+// The other app's view became (or stopped being) the first responder of its key window.
+CONTENT_EXPORT void AgensEmbedSetFocus(WebContents* contents, bool focused);
+
+// `native_event` is the NSEvent as CGEventCreateData gives it; `point` is where it happened in
+// the other app's view, in points from the top left.
+CONTENT_EXPORT void AgensEmbedMouse(WebContents* contents,
+                                    base::span<const uint8_t> native_event,
+                                    const gfx::PointF& point);
+CONTENT_EXPORT void AgensEmbedMouseLeave(WebContents* contents);
+CONTENT_EXPORT void AgensEmbedWheel(WebContents* contents,
+                                    base::span<const uint8_t> native_event,
+                                    const gfx::PointF& point);
+
+// A key event and what the other app's text input system made of it (its NSTextInputClient
+// calls during -interpretKeyEvents:).
+struct CONTENT_EXPORT AgensEmbedKey {
+  AgensEmbedKey();
+  ~AgensEmbedKey();
+  std::vector<uint8_t> native_event;
+  std::u16string text;                 // -insertText:
+  std::vector<std::string> selectors;  // -doCommandBySelector:, e.g. "deleteBackward:"
+  std::u16string marked;               // -setMarkedText: (the composition now)
+  int selection_start = 0;             // inside `marked`
+  int selection_end = 0;
+  bool had_marked = false;  // there was a composition before this key
+  bool unmarked = false;    // -unmarkText was called
+};
+CONTENT_EXPORT void AgensEmbedKeyEvent(WebContents* contents, const AgensEmbedKey& key);
+
+// "cut", "copy", "paste", "selectAll", "undo", "redo" (the other app's Edit menu).
+CONTENT_EXPORT void AgensEmbedEdit(WebContents* contents, const std::string& command);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_AGENS_EMBED_MAC_H_
