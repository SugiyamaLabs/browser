+- (instancetype)init {
+  NSWindow* w = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 640, 540)
+                                            styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                                                      NSWindowStyleMaskFullSizeContentView
