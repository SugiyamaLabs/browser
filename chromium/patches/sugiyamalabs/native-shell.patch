+  _favicon.hidden = tab.loading;
+  _pinned = tab.pinned;
+  _muted = tab.muted;
+  _audible = tab.audible;
+  _sound.image = Symbol(_muted ? @"speaker.slash.fill" : @"speaker.wave.2.fill", 10);
+  _sound.toolTip = _muted ? @"Ativar o som da aba" : @"Silenciar a aba";
