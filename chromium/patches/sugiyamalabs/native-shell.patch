+static std::optional<ContentSettingsType> KindOf(const char* kind) {
+  static const std::pair<const char*, ContentSettingsType> kKinds[] = {
+      {"camera", ContentSettingsType::MEDIASTREAM_CAMERA},
+      {"microphone", ContentSettingsType::MEDIASTREAM_MIC},
+      {"location", ContentSettingsType::GEOLOCATION},
+      {"notifications", ContentSettingsType::NOTIFICATIONS},
+      {"popups", ContentSettingsType::POPUPS},
+      {"sound", ContentSettingsType::SOUND},
+      {"clipboard", ContentSettingsType::CLIPBOARD_READ_WRITE},
+      {"downloads", ContentSettingsType::AUTOMATIC_DOWNLOADS},
+      {"javascript", ContentSettingsType::JAVASCRIPT},
+      {"cookies", ContentSettingsType::COOKIES},
+  };
+  for (const auto& [name, type] : kKinds) {
+    if (kind && std::string_view(kind) == name) return type;
+  }
+  return std::nullopt;
+}
+static AgensPermission ToAgens(ContentSetting setting) {
+  switch (setting) {
+    case CONTENT_SETTING_ALLOW: return kAgensAllow;
+    case CONTENT_SETTING_BLOCK: return kAgensBlock;
+    case CONTENT_SETTING_SESSION_ONLY: return kAgensSessionOnly;
+    default: return kAgensAsk;
+  }
+}
+static ContentSetting FromAgens(AgensPermission value) {
+  return value == kAgensAllow         ? CONTENT_SETTING_ALLOW
+         : value == kAgensBlock       ? CONTENT_SETTING_BLOCK
+         : value == kAgensSessionOnly ? CONTENT_SETTING_SESSION_ONLY
+                                      : CONTENT_SETTING_ASK;
+}
+
+AgensPermission agens_permission_get(AgensWindow* w, const char* kind) {
+  std::optional<ContentSettingsType> type = KindOf(kind);
+  if (!type) return kAgensAsk;
+  return ToAgens(HostContentSettingsMapFactory::GetForProfile(w->browser->GetProfile())->GetDefaultContentSetting(*type));
+}
+void agens_permission_set(AgensWindow* w, const char* kind, AgensPermission value) {
+  std::optional<ContentSettingsType> type = KindOf(kind);
+  if (!type) return;
+  HostContentSettingsMapFactory::GetForProfile(w->browser->GetProfile())->SetDefaultContentSetting(*type, FromAgens(value));
+}
+
+void agens_site_exceptions(AgensWindow* w, AgensSiteExceptionsFn fn, void* context) {
+  static const char* const kNames[] = {"camera", "microphone", "location", "notifications", "popups",
+                                       "sound", "clipboard", "downloads", "javascript", "cookies"};
+  HostContentSettingsMap* map = HostContentSettingsMapFactory::GetForProfile(w->browser->GetProfile());
+  std::vector<std::string> sites;
+  std::vector<AgensSiteException> out;
+  std::vector<std::pair<std::string, const char*>> found;
+  std::vector<AgensPermission> values;
+  for (const char* name : kNames) {
+    for (const ContentSettingPatternSource& rule : map->GetSettingsForOneType(*KindOf(name))) {
+      // Only what the person set (not policy, extensions or the defaults), for one site.
+      if (rule.source != content_settings::mojom::ProviderType::kPrefProvider ||
+          rule.primary_pattern == ContentSettingsPattern::Wildcard() ||
+          rule.secondary_pattern != ContentSettingsPattern::Wildcard()) {
+        continue;
+      }
+      found.emplace_back(rule.primary_pattern.ToString(), name);
+      values.push_back(ToAgens(rule.GetContentSetting()));
+    }
+  }
+  for (size_t i = 0; i < found.size(); ++i) out.push_back({found[i].first.c_str(), found[i].second, values[i]});
+  fn(context, out.data(), static_cast<int>(out.size()));
+}
+void agens_site_exception_set(AgensWindow* w, const char* site, const char* kind, AgensPermission value) {
+  std::optional<ContentSettingsType> type = KindOf(kind);
+  ContentSettingsPattern pattern = ContentSettingsPattern::FromString(site ? site : "");
+  if (!type || !pattern.IsValid() || pattern == ContentSettingsPattern::Wildcard()) return;
+  HostContentSettingsMapFactory::GetForProfile(w->browser->GetProfile())
+      ->SetContentSettingCustomScope(pattern, ContentSettingsPattern::Wildcard(), *type, FromAgens(value));
+}
+void agens_site_exception_remove(AgensWindow* w, const char* site, const char* kind) {
+  std::optional<ContentSettingsType> type = KindOf(kind);
+  ContentSettingsPattern pattern = ContentSettingsPattern::FromString(site ? site : "");
+  if (!type || !pattern.IsValid() || pattern == ContentSettingsPattern::Wildcard()) return;
+  HostContentSettingsMapFactory::GetForProfile(w->browser->GetProfile())
+      ->SetContentSettingCustomScope(pattern, ContentSettingsPattern::Wildcard(), *type, CONTENT_SETTING_DEFAULT);
+}
