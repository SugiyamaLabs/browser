+// One ato in the foot row: monogram tile; the current one has a warm dot under it.
+@interface AgensAtoButton : AgensHoverView
+- (void)updateWith:(const AgensAto&)ato index:(int)index;
+@end
+@implementation AgensAtoButton {
+  AgensAtoTile* _tile;
+  NSView* _dot;
+}
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    _tile = AtoTile(16);
+    _dot = [[NSView alloc] init];
+    _dot.wantsLayer = YES;
+    _dot.layer.cornerRadius = 2;
+    [self addSubview:_tile];
+    [self addSubview:_dot];
+  }
+  return self;
+}
+- (void)layout {
+  [super layout];
+  _tile.frame = NSMakeRect(7, 6, 16, 16);
+  _dot.frame = NSMakeRect(13, 26, 4, 4);
+}
+- (void)updateWith:(const AgensAto&)ato index:(int)index {
+  NSString* name = @(ato.name);
+  _tile.stringValue = Monogram(name);
+  _tile.layer.backgroundColor = AtoColor(index).CGColor;
+  _tile.alphaValue = ato.asleep && !ato.active ? 0.4 : 1;
+  _dot.hidden = !ato.active;
+  self.toolTip = ato.asleep && !ato.active ? [name stringByAppendingString:@" · dormindo"] : name;
+  self.accessibilityLabel = self.toolTip;
+  self.selected = ato.active;
+}
+- (void)refresh {
+  [super refresh];
+  _dot.layer.backgroundColor = CG(kLight3, self);
+}
+@end
