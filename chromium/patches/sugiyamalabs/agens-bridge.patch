+std::optional<int> TabParam(const Request& request) {
+  const std::string* tab = request.body.FindString("tab");
+  return tab ? ParseViewTab(*tab) : std::nullopt;
+}
+
+// --- Input: no reply, malformed messages dropped, only to attached tabs.
+
+void Input(const Client& client, const Request& request) {
+  State& s = S();
+  if (client.connection != s.host) return;
+  std::optional<int> n = TabParam(request);
+  Shown* shown = n ? FindShown(*n) : nullptr;
+  if (!shown) return;
+  content::WebContents* contents = shown->web_contents();
+  const std::string& op = request.op;
+  if (op == "view.mouse" || op == "view.wheel") {
+    double x = 0, y = 0;
+    if (!ReadEventData(request.body, s.event_data) || !ReadPoint(request.body, x, y)) return;
+    const gfx::PointF point(x, y);
+    if (op == "view.mouse") {
+      if (Picker* picker = shown->picker.get()) {
+        const content::AgensEmbedMouseKind kind = content::AgensEmbedMouseKindOf(base::as_byte_span(s.event_data));
+        // A move would take a held pick's highlight away (view_pick.cc).
+        if (kind == content::AgensEmbedMouseKind::kMove && picker->held()) return;
+        // The element under the press, even after a scroll forgot it: the press then picks it.
+        if (kind == content::AgensEmbedMouseKind::kPress && picker->armed()) content::AgensEmbedMouseHover(contents, point);
+      }
+      content::AgensEmbedMouse(contents, base::as_byte_span(s.event_data), point);
+    } else {
+      content::AgensEmbedWheel(contents, base::as_byte_span(s.event_data), point);
+    }
+  } else if (op == "view.mouse.leave") {
+    content::AgensEmbedMouseLeave(contents);
+  } else if (op == "view.focus") {
+    std::optional<bool> on = request.body.FindBool("on");
+    if (!on) return;
+    if (*on) {
+      // One focused tab at a time.
+      for (auto& other : s.shown) {
+        if (other.get() != shown && other->focused && other->web_contents()) {
+          other->focused = false;
+          content::AgensEmbedSetFocus(other->web_contents(), false);
+        }
+      }
+      // The tab with the keyboard is its window's active tab (find, permission prompts…).
+      for (AgensWindow* window : s.windows) {
+        const int index = window->model()->GetIndexOfWebContents(contents);
+        if (index != TabStripModel::kNoTab && index != window->model()->active_index()) {
+          window->model()->ActivateTabAt(index);
+        }
+      }
+    }
+    shown->focused = *on;
+    content::AgensEmbedSetFocus(contents, *on);
+  } else if (op == "view.edit") {
+    const std::string* command = request.body.FindString("command");
+    if (command && IsEditCommand(*command)) content::AgensEmbedEdit(contents, *command);
+  } else if (op == "view.key") {
+    ViewKey read;
+    if (!ReadEventData(request.body, s.event_data) || !ReadViewKey(request.body, read)) return;
+    content::AgensEmbedKey key;
+    key.native_event.assign(s.event_data.begin(), s.event_data.end());
+    if (!base::UTF8ToUTF16(read.text.data(), read.text.size(), &key.text) ||
+        !base::UTF8ToUTF16(read.marked.data(), read.marked.size(), &key.marked)) {
+      return;
+    }
+    key.selectors = std::move(read.commands);
+    const int length = static_cast<int>(key.marked.length());
+    key.selection_start = std::clamp(read.sel_start.value_or(length), 0, length);
+    key.selection_end = std::clamp(read.sel_end.value_or(length), key.selection_start, length);
+    key.had_marked = read.had_marked;
+    key.unmarked = read.unmarked;
+    content::AgensEmbedKeyEvent(contents, key);
+  }
+}
+
+// --- Requests.
+
+void HostAttach(const Client& client, const Request& request, ReplyCallback reply) {
+  State& s = S();
+  // The parent that launched the engine, and still its parent (not reparented after it died).
+  if (client.pid <= 0 || client.pid != EmbeddedParent() || getppid() != EmbeddedParent()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "only the app that started the engine is its host"));
+    return;
+  }
+  if (s.host) {
+    std::move(reply).Run(s.host == client.connection
+                             ? ErrorReply(&request.id, kBadRequest, "already the host")
+                             : ErrorReply(&request.id, kUnauthorized, "another connection is the host"));
+    return;
+  }
+  s.host = client.connection;
+  WatchLayers();
+  std::move(reply).Run(OkReply(request.id));
+  s.Schedule();  // the tabs that exist already
+}
+
+void ViewTabs(const Request& request, ReplyCallback reply) {
+  const base::Value* ato_value = request.body.Find("ato");
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  if (ato_value && !ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "ato must be a string"));
+    return;
+  }
+  if (ato && !FindAto(*ato)) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  base::ListValue tabs;
+  ForEachTab([&](AgensWindow* window, content::WebContents* contents) {
+    if (!ato || AtoOf(window) == *ato) tabs.Append(TabFields(window, contents));
+  });
+  base::DictValue result;
+  result.Set("tabs", std::move(tabs));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// A new foreground tab in the ato's window, made (off screen) when it has none.
+void OpenIn(Request request, ReplyCallback reply, GURL url, Profile* profile) {
+  if (!profile) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not load the ato"));
+    return;
+  }
+  BrowserWindowInterface* browser = nullptr;
+  for (AgensWindow* window : S().windows) {
+    BrowserWindowInterface* b = window->browser;
+    if (b->GetProfile() == profile && b->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+        !b->IsDeleteScheduled() && !b->GetTabStripModel()->closing_all()) {
+      browser = b;
+      break;
+    }
+  }
+  if (!browser) browser = CreateBrowserWindow(BrowserWindowCreateParams(*profile, /*from_user_gesture=*/false));
+  if (!browser) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the ato's window"));
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the tab"));
+    return;
+  }
+  base::DictValue result;
+  result.Set("tab", ViewTabName(NumberOf(contents)));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+  S().Schedule();
+}
+
+void ViewOpen(Request request, ReplyCallback reply) {
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  const base::Value* url_value = request.body.Find("url");
+  GURL url(chrome::kChromeUINewTabURL);
+  if (url_value) {
+    url = url_value->is_string() ? GURL(url_value->GetString()) : GURL();
+    // Only web pages: the host's address bar goes through view.navigate.
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "url must be http or https"));
+      return;
+    }
+  }
+  if (!ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*ato);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  const base::FilePath path = entry->GetPath();
+  if (Profile* profile = manager->GetProfileByPath(path)) {
+    OpenIn(std::move(request), std::move(reply), url, profile);
+    return;
+  }
+  // The callback runs once in every case, with null when loading fails.
+  manager->LoadProfileByPath(path, /*incognito=*/false,
+                             base::BindOnce(&OpenIn, std::move(request), std::move(reply), url));
+}
+
+// Brings back `profile`'s tabs from its last saved session ("Continuar de onde parou"), after
+// TakeRestorable. Into the ato's window when it has one; an agent's tabs stay out (session_restore.cc).
+void RestoreIn(Request request, ReplyCallback reply, Profile* profile) {
+  if (!profile) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not load the ato"));
+    return;
+  }
+  if (SessionRestore::IsRestoring(profile)) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "the ato is restoring already"));
+    return;
+  }
+  BrowserWindowInterface* browser = nullptr;
+  for (AgensWindow* window : S().windows) {
+    BrowserWindowInterface* b = window->browser;
+    if (b->GetProfile() == profile && b->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+        !b->IsDeleteScheduled() && !b->GetTabStripModel()->closing_all()) {
+      browser = b;
+      break;
+    }
+  }
+  // Answers when this profile's restore is done (it always notifies, also with nothing to restore).
+  struct Waiting {
+    Request request;
+    ReplyCallback reply;
+    base::CallbackListSubscription subscription;
+  };
+  auto* waiting = new Waiting{std::move(request), std::move(reply), {}};
+  waiting->subscription = SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+      [](Waiting* waiting, Profile* wanted, Profile* profile, int tabs) {
+        if (profile != wanted || !waiting->reply) return;
+        if (tabs == 0) {
+          std::move(waiting->reply).Run(ErrorReply(&waiting->request.id, kNotFound, "no saved tabs for this ato"));
+        } else {
+          base::DictValue result;
+          result.Set("tabs", tabs);
+          std::move(waiting->reply).Run(OkReply(waiting->request.id, std::move(result)));
+        }
+        S().Schedule();
+        // Not from inside the callback list that is running this.
+        base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, waiting);
+      },
+      waiting, profile));
+  SessionRestore::RestoreSession(profile, browser, SessionRestore::RESTORE_BROWSER, StartupTabs());
+}
+
+void ViewRestore(Request request, ReplyCallback reply) {
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  if (!ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*ato);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  // Once per saved session: a second call (a double click) finds nothing, so no tab comes twice.
+  if (!TakeRestorable(*ato)) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no saved tabs for this ato"));
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (Profile* profile = manager->GetProfileByPath(entry->GetPath())) {
+    RestoreIn(std::move(request), std::move(reply), profile);
+    return;
+  }
+  manager->LoadProfileByPath(entry->GetPath(), /*incognito=*/false,
+                             base::BindOnce(&RestoreIn, std::move(request), std::move(reply)));
+}
+
+// --- Closed tabs (Passo 5.7): Chromium's TabRestoreService of the ato's profile.
+
+// The closed tabs view.reopen may bring back, most recent first: never one an agent had (its entry
+// carries kAgentTabKey, browser_live_tab_context.cc). A closed window's tabs count one by one;
+// groups and splits are left out (the host has neither).
+// shortcut: only what this run closed (the last run's file is not loaded, view.restore covers that
+// run); call LoadTabsFromLastSession here if hosts want older ones.
+std::vector<SessionID> Reopenable(const std::string& ato) {
+  std::vector<SessionID> ids;
+  ProfileAttributesEntry* entry = FindAto(ato);
+  Profile* profile = entry ? g_browser_process->profile_manager()->GetProfileByPath(entry->GetPath()) : nullptr;
+  sessions::TabRestoreService* service = profile ? TabRestoreServiceFactory::GetForProfileIfExisting(profile) : nullptr;
+  if (!service) return ids;
+  auto add = [&](const sessions::tab_restore::Tab& tab) {
+    auto mark = tab.extra_data.find(kAgentTabKey);
+    if (mark == tab.extra_data.end() || mark->second != "1") ids.push_back(tab.id);
+  };
+  for (const auto& closed : service->entries()) {
+    if (closed->type == sessions::tab_restore::Type::TAB) {
+      add(static_cast<const sessions::tab_restore::Tab&>(*closed));
+    } else if (closed->type == sessions::tab_restore::Type::WINDOW) {
+      for (const auto& tab : static_cast<const sessions::tab_restore::Window&>(*closed).tabs) add(*tab);
+    }
+  }
+  return ids;
+}
+
+// view.reopenable {ato} -> {count}: for the host's "reopen closed tab" item.
+void ViewReopenable(const Request& request, ReplyCallback reply) {
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  if (!ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+    return;
+  }
+  if (!FindAto(*ato)) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  base::DictValue result;
+  result.Set("count", static_cast<int>(Reopenable(*ato).size()));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// view.reopen {ato} -> {tab}: the most recently closed tab comes back with its history, into the
+// ato's window (a new one when it has none), and reaches the host as view.tab.
+void ViewReopen(const Request& request, ReplyCallback reply) {
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  if (!ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+    return;
+  }
+  if (!FindAto(*ato)) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  std::vector<SessionID> ids = Reopenable(*ato);
+  if (ids.empty()) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no closed tab to reopen"));
+    return;
+  }
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(FindAto(*ato)->GetPath());
+  sessions::LiveTabContext* context = nullptr;
+  for (AgensWindow* window : S().windows) {
+    BrowserWindowInterface* b = window->browser;
+    if (b->GetProfile() == profile && b->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+        !b->IsDeleteScheduled() && !b->GetTabStripModel()->closing_all()) {
+      context = BrowserLiveTabContext::From(b);
+      break;
+    }
+  }
+  std::optional<std::vector<sessions::LiveTab*>> restored =
+      TabRestoreServiceFactory::GetForProfile(profile)->RestoreEntryById(
+          context, ids.front(), context ? WindowOpenDisposition::NEW_FOREGROUND_TAB : WindowOpenDisposition::UNKNOWN);
+  if (!restored || restored->empty() || !restored->front()) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not reopen the tab"));
+    return;
+  }
+  content::WebContents& contents = static_cast<sessions::ContentLiveTab*>(restored->front())->GetWebContents();
+  base::DictValue result;
+  result.Set("tab", ViewTabName(NumberOf(&contents)));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+  S().Schedule();
+}
+
+void ViewNavigate(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> text = StringParam(request.body, "text");
+  std::u16string input;
+  if (!text || text->empty() || !AtMostChars(*text, kMaxAddressChars) ||
+      !base::UTF8ToUTF16(text->data(), text->size(), &input)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and text (up to 8192 characters)"));
+    return;
+  }
+  // What the address bar does with it: an address, or a search with the ato's engine.
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(Profile::FromBrowserContext(contents->GetBrowserContext()))
+      ->Classify(input, false, false, metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  if (!match.destination_url.is_valid()) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "not an address or a search"));
+    return;
+  }
+  contents->GetController().LoadURL(match.destination_url, content::Referrer(), ui::PAGE_TRANSITION_TYPED,
+                                    std::string());
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void ViewFavicon(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::string png;
+  if (gfx::Image icon = FaviconOf(contents); !icon.IsEmpty()) {
+    const SkBitmap& bitmap = icon.AsImageSkia().GetRepresentation(2.0f).GetBitmap();
+    std::optional<std::vector<uint8_t>> bytes = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false);
+    if (bytes) png = base::Base64Encode(*bytes);
+  }
+  base::DictValue result;
+  result.Set("png", std::move(png));  // empty: the tab has no icon
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+void ViewControl(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> action = StringParam(request.body, "action");
+  if (!action || (*action != "take" && *action != "give" && *action != "end")) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and action: take, give or end"));
+    return;
+  }
+  const AgensControlled* controlled = AgensControlled::FromWebContents(contents);
+  if (!controlled) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no agent controls this tab"));
+    return;
+  }
+  // take pauses the agent ("Assumir"), give resumes it ("Devolver"), end ends its whole session.
+  // Posted, as the shell does: end removes the mark.
+  const base::RepeatingClosure& run =
+      *action == "take" ? controlled->take_over : *action == "give" ? controlled->hand_back : controlled->stop;
+  if (run) base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, run);
+  std::move(reply).Run(OkReply(request.id));
+}
+
+// host.settings' site_requests on every ato, also those loaded later: the default for geolocation
+// and notifications, ask or block. It overwrites what the standalone shell set per ato.
+class SiteRequests : public ProfileManagerObserver {
+ public:
+  void Start() {
+    if (!prefs_.IsEmpty()) return;
+    prefs_.Init(g_browser_process->local_state());
+    prefs_.Add(kSiteRequestsPref, base::BindRepeating(&SiteRequests::ApplyAll, base::Unretained(this)));
+    if (ProfileManager* manager = g_browser_process->profile_manager()) manager_observation_.Observe(manager);
+    ApplyAll();
+  }
+
+ private:
+  void ApplyAll() {
+    if (ProfileManager* manager = g_browser_process->profile_manager()) {
+      for (Profile* profile : manager->GetLoadedProfiles()) Apply(profile);
+    }
+  }
+  static void Apply(Profile* profile) {
+    if (profile->IsOffTheRecord()) return;
+    const ContentSetting value =
+        g_browser_process->local_state()->GetBoolean(kSiteRequestsPref) ? CONTENT_SETTING_ASK : CONTENT_SETTING_BLOCK;
+    HostContentSettingsMap* map = HostContentSettingsMapFactory::GetForProfile(profile);
+    for (ContentSettingsType type : {ContentSettingsType::GEOLOCATION, ContentSettingsType::NOTIFICATIONS}) {
+      map->SetDefaultContentSetting(type, value);
+    }
+  }
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override { Apply(profile); }
+  void OnProfileManagerDestroying() override { manager_observation_.Reset(); }
+
+  PrefChangeRegistrar prefs_;
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver> manager_observation_{this};
+};
+SiteRequests& TheSiteRequests() {
+  static base::NoDestructor<SiteRequests> site_requests;
+  return *site_requests;
+}
+
+// host.settings {site_requests?, agent_extensions?, webauthn_platform?}: sets the ones given,
+// answers all three as now in force.
+void HostSettings(const Request& request, ReplyCallback reply) {
+  PrefService* local = g_browser_process->local_state();
+  const std::pair<const char*, const char*> settings[] = {{"site_requests", kSiteRequestsPref},
+                                                          {"agent_extensions", kAgentExtensionsPref},
+                                                          {"webauthn_platform", kWebAuthnPlatformPref}};
+  for (const auto& [key, pref] : settings) {
+    const base::Value* value = request.body.Find(key);
+    if (value && !value->is_bool()) {
+      std::move(reply).Run(
+          ErrorReply(&request.id, kBadRequest, "site_requests, agent_extensions and webauthn_platform are booleans"));
+      return;
+    }
+  }
+  // The prefs' observers apply them: SiteRequests here, the controlled tabs in control_ops.cc.
+  base::DictValue result;
+  for (const auto& [key, pref] : settings) {
+    if (const base::Value* value = request.body.Find(key)) local->SetBoolean(pref, value->GetBool());
+    result.Set(key, local->GetBoolean(pref));
+  }
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// view.pick {on}: arms the picker on an attached tab (again, after a pick) or ends it.
+void ViewPick(content::WebContents* contents, Shown* shown, const Request& request, ReplyCallback reply) {
+  const std::optional<bool> on = request.body.FindBool("on");
+  if (!on) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and on (a boolean)"));
+    return;
+  }
+  if (!shown) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the tab is not attached"));
+    return;
+  }
+  if (!*on) {
+    if (!shown->picker) {
+      std::move(reply).Run(OkReply(request.id));
+      return;
+    }
+    shown->picker->Stop(base::BindOnce([](base::Value id, ReplyCallback reply, std::string) { std::move(reply).Run(OkReply(id)); },
+                                       request.id.Clone(), std::move(reply)));
+    return;
+  }
+  if (AgentWorks(contents)) {
+    std::move(reply).Run(ErrorReply(&request.id, kDenied, "an agent is working on this tab"));
+    return;
+  }
+  if (!shown->picker) {
+    shown->picker = std::make_unique<Picker>(contents, base::BindRepeating(
+                                                           [](int n, base::DictValue fields) {
+                                                             if (!S().host) return;
+                                                             fields.Set("tab", ViewTabName(n));
+                                                             SendEventTo(S().host, "view.picked", std::move(fields));
+                                                           },
+                                                           shown->n));
+  }
+  shown->picker->Arm(base::BindOnce(
+      [](base::Value id, ReplyCallback reply, std::string code) {
+        std::move(reply).Run(code.empty() ? OkReply(id) : ErrorReply(&id, code, "could not start picking on this page"));
+      },
+      request.id.Clone(), std::move(reply)));
+}
+
+// view.pick.step {to}: the pick moves to its parent or first child.
+void ViewPickStep(Shown* shown, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> to = StringParam(request.body, "to");
+  if (!to || (*to != "parent" && *to != "child")) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and to: parent or child"));
+    return;
+  }
+  if (!shown || !shown->picker || !shown->picker->held()) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "nothing is picked on this tab"));
+    return;
+  }
+  shown->picker->Step(*to == "parent", base::BindOnce(
+                                           [](base::Value id, std::string to, ReplyCallback reply, std::string code) {
+                                             std::move(reply).Run(code.empty() ? OkReply(id)
+                                                                               : ErrorReply(&id, code, "no " + to));
+                                           },
+                                           request.id.Clone(), *to, std::move(reply)));
+}
