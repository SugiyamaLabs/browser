index 0000000000..7c913a3a06
--- /dev/null
+++ b/content/browser/renderer_host/agens_embed_mac.mm
@@ -0,0 +1,369 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "content/public/browser/agens_embed_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/strings/sys_string_conversions.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "components/input/render_widget_host_input_event_router.h"
+#include "components/input/web_input_event_builders_mac.h"
+#include "content/browser/renderer_host/agens_embed_internal_mac.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_mac.h"
+#include "content/browser/renderer_host/render_widget_host_view_mac_editcommand_helper.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/browser/context_menu_params.h"
+#include "content/public/browser/render_view_host.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "ui/base/cursor/cursor.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/input/input_handler.mojom.h"
+#include "ui/events/cocoa/cocoa_event_utils.h"
+#include "ui/gfx/ca_layer_params.h"
+#include "ui/latency/latency_info.h"
+
+namespace content {
+
+namespace {
+
+AgensEmbedLayerCallback& LayerCallback() {
+  static base::NoDestructor<AgensEmbedLayerCallback> callback;
+  return *callback;
+}
+
+AgensEmbedSelectHandler& SelectHandler() {
+  static base::NoDestructor<AgensEmbedSelectHandler> handler;
+  return *handler;
+}
+AgensEmbedContextMenuHandler& ContextMenuHandler() {
+  static base::NoDestructor<AgensEmbedContextMenuHandler> handler;
+  return *handler;
+}
+AgensEmbedOwnWindowCallback& OwnWindowCallback() {
+  static base::NoDestructor<AgensEmbedOwnWindowCallback> callback;
+  return *callback;
+}
+bool InOwnWindow(WebContents* contents) {
+  return OwnWindowCallback() && contents && OwnWindowCallback().Run(contents);
+}
+AgensEmbedCursorCallback& CursorCallback() {
+  static base::NoDestructor<AgensEmbedCursorCallback> callback;
+  return *callback;
+}
+AgensEmbedCaretCallback& CaretCallback() {
+  static base::NoDestructor<AgensEmbedCaretCallback> callback;
+  return *callback;
+}
+
+// A page's main view only: popups have no RenderViewHost.
+WebContents* ContentsOf(RenderWidgetHostViewMac* view) {
+  RenderViewHost* rvh = RenderViewHost::From(view->host());
+  return rvh ? WebContents::FromRenderViewHost(rvh) : nullptr;
+}
+
+// An open <select> list the other app draws. The renderer waits for one answer, so going away
+// without one cancels it.
+class Popup {
+ public:
+  explicit Popup(mojo::PendingRemote<blink::mojom::PopupMenuClient> client) : client_(std::move(client)) {}
+  ~Popup() {
+    if (client_.is_bound() && client_.is_connected()) client_->DidCancel();
+  }
+  static void Done(std::unique_ptr<Popup> popup, std::optional<int> index) {
+    if (!popup->client_.is_bound() || !popup->client_.is_connected()) return;
+    if (index) {
+      popup->client_->DidAcceptIndices({*index});
+    } else {
+      popup->client_->DidCancel();
+    }
+    popup->client_.reset();
+  }
+  void OnGone(base::OnceClosure gone) { client_.set_disconnect_handler(std::move(gone)); }
+  base::WeakPtr<Popup> GetWeakPtr() { return weak_.GetWeakPtr(); }
+
+ private:
+  mojo::Remote<blink::mojom::PopupMenuClient> client_;
+  base::WeakPtrFactory<Popup> weak_{this};
+};
+
+// The tab's own view. Null while the tab has none (crashed, or still being set up).
+RenderWidgetHostViewMac* ViewFor(WebContents* contents) {
+  return contents ? static_cast<RenderWidgetHostViewMac*>(contents->GetRenderWidgetHostView())
+                  : nullptr;
+}
+
+ui::LatencyInfo Latency() {
+  ui::LatencyInfo latency;
+  latency.AddLatencyNumber(ui::INPUT_EVENT_LATENCY_UI_COMPONENT);
+  return latency;
+}
+
+}  // namespace
+
+AgensEmbedKey::AgensEmbedKey() = default;
+AgensEmbedKey::~AgensEmbedKey() = default;
+
+void SetAgensEmbedLayerCallback(AgensEmbedLayerCallback callback) {
+  LayerCallback() = std::move(callback);
+}
+
+void AgensEmbedLayerUpdated(RenderWidgetHostViewMac* view, const gfx::CALayerParams& params) {
+  if (!LayerCallback() || !params.ca_context_id) return;
+  if (WebContents* contents = ContentsOf(view)) {
+    LayerCallback().Run(contents, params.ca_context_id, params.pixel_size, params.scale_factor);
+  }
+}
+
+void SetAgensEmbedSelectHandler(AgensEmbedSelectHandler handler) {
+  SelectHandler() = std::move(handler);
+}
+void SetAgensEmbedContextMenuHandler(AgensEmbedContextMenuHandler handler) {
+  ContextMenuHandler() = std::move(handler);
+}
+void SetAgensEmbedOwnWindow(AgensEmbedOwnWindowCallback callback) {
+  OwnWindowCallback() = std::move(callback);
+}
+void SetAgensEmbedCursorCallbacks(AgensEmbedCursorCallback cursor, AgensEmbedCaretCallback caret) {
+  CursorCallback() = std::move(cursor);
+  CaretCallback() = std::move(caret);
+}
+
+bool AgensEmbedShowPopupMenu(WebContents* contents,
+                             mojo::PendingRemote<blink::mojom::PopupMenuClient>& client,
+                             const gfx::Rect& bounds,
+                             int selected,
+                             const std::vector<blink::mojom::MenuItemPtr>& items) {
+  if (!SelectHandler() || InOwnWindow(contents)) return false;
+  std::vector<AgensEmbedMenuItem> list;
+  for (const blink::mojom::MenuItemPtr& item : items) {
+    list.push_back({item->label.value_or(std::string()),
+                    item->enabled && item->type != blink::mojom::MenuItem::Type::kSeparator,
+                    item->type == blink::mojom::MenuItem::Type::kGroup});
+  }
+  auto popup = std::make_unique<Popup>(std::move(client));
+  base::WeakPtr<Popup> weak = popup->GetWeakPtr();
+  base::OnceClosure gone = SelectHandler().Run(contents, bounds, selected, std::move(list),
+                                               base::BindOnce(&Popup::Done, std::move(popup)));
+  if (weak && gone) weak->OnGone(std::move(gone));  // still open
+  return true;
+}
+
+bool AgensEmbedShowContextMenu(RenderFrameHost& frame, const ContextMenuParams& params) {
+  if (!ContextMenuHandler() || InOwnWindow(WebContents::FromRenderFrameHost(&frame))) return false;
+  ContextMenuHandler().Run(frame, params);
+  return true;
+}
+
+void AgensEmbedCursorChanged(RenderWidgetHostViewMac* view, const ui::Cursor& cursor) {
+  if (!CursorCallback()) return;
+  if (WebContents* contents = ContentsOf(view)) CursorCallback().Run(contents, cursor.type());
+}
+
+void AgensEmbedCaretChanged(RenderWidgetHostViewMac* view, const gfx::Rect& caret) {
+  if (!CaretCallback()) return;
+  if (WebContents* contents = ContentsOf(view)) CaretCallback().Run(contents, caret);
+}
+
+void AgensEmbedRedraw(WebContents* contents) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  RenderWidgetHostImpl* host = view ? RenderWidgetHostImpl::From(view->GetRenderWidgetHost()) : nullptr;
+  // The renderer's widget must be live: ForceRedrawForTesting CHECKs it is bound. Despite its
+  // name it is the plain "draw a full frame now" request.
+  if (host && host->renderer_initialized()) host->ForceRedrawForTesting();
+}
+
+void AgensEmbedSetFocus(WebContents* contents, bool focused) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  // The same two notifications the NSView sends, in the order that makes the page active and
+  // focused (see RenderWidgetHostViewMac::OnFirstResponderChanged).
+  if (focused) {
+    view->OnFirstResponderChanged(true);
+    view->OnWindowIsKeyChanged(true);
+  } else {
+    view->OnWindowIsKeyChanged(false);
+    view->OnFirstResponderChanged(false);
+  }
+}
+
+void AgensEmbedMouse(WebContents* contents,
+                     base::span<const uint8_t> native_event,
+                     const gfx::PointF& point) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  NSEvent* event = ui::EventFromData(native_event);
+  if (!view || !event) return;
+  // Only mouse events: the builder reads mouse-only properties, which raise on other types.
+  switch (event.type) {
+    case NSEventTypeLeftMouseDown:
+    case NSEventTypeLeftMouseUp:
+    case NSEventTypeLeftMouseDragged:
+    case NSEventTypeRightMouseDown:
+    case NSEventTypeRightMouseUp:
+    case NSEventTypeRightMouseDragged:
+    case NSEventTypeOtherMouseDown:
+    case NSEventTypeOtherMouseUp:
+    case NSEventTypeOtherMouseDragged:
+    case NSEventTypeMouseMoved:
+    case NSEventTypeMouseEntered:
+    case NSEventTypeMouseExited:
+      break;
+    default:
+      return;
+  }
+  blink::WebMouseEvent mouse =
+      input::WebMouseEventBuilder::Build(event, view->GetNativeView().GetNativeNSView());
+  // The event's own location belongs to the other app's window.
+  mouse.SetPositionInWidget(point);
+  // shortcut: the screen position is the view's; popups placed from it land wrong until the other
+  // app also sends where its view is on screen.
+  mouse.SetPositionInScreen(point);
+  view->RouteOrProcessMouseEvent(mouse);
+}
+
+void AgensEmbedMouseLeave(WebContents* contents) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  view->RouteOrProcessMouseEvent(blink::WebMouseEvent(
+      blink::WebInputEvent::Type::kMouseLeave, 0, base::TimeTicks::Now()));
+}
+
+AgensEmbedMouseKind AgensEmbedMouseKindOf(base::span<const uint8_t> native_event) {
+  NSEvent* event = ui::EventFromData(native_event);
+  if (!event) return AgensEmbedMouseKind::kOther;
+  switch (event.type) {
+    case NSEventTypeMouseMoved:
+      return AgensEmbedMouseKind::kMove;
+    case NSEventTypeLeftMouseDown:
+    case NSEventTypeRightMouseDown:
+    case NSEventTypeOtherMouseDown:
+      return AgensEmbedMouseKind::kPress;
+    default:
+      return AgensEmbedMouseKind::kOther;
+  }
+}
+
+void AgensEmbedMouseHover(WebContents* contents, const gfx::PointF& point) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  blink::WebMouseEvent move(blink::WebInputEvent::Type::kMouseMove, blink::WebInputEvent::kNoModifiers,
+                            base::TimeTicks::Now());
+  move.SetPositionInWidget(point);
+  move.SetPositionInScreen(point);
+  view->RouteOrProcessMouseEvent(move);
+}
+
+void AgensEmbedRouteMouseToRoot(WebContents* contents, bool on) {
+  auto* impl = static_cast<WebContentsImpl*>(contents);
+  if (impl && impl->GetInputEventRouter()) impl->GetInputEventRouter()->set_route_to_root_for_devtools(on);
+}
+
+void AgensEmbedWheel(WebContents* contents,
+                     base::span<const uint8_t> native_event,
+                     const gfx::PointF& point) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  NSEvent* event = ui::EventFromData(native_event);
+  if (!view || !event || event.type != NSEventTypeScrollWheel) return;
+  blink::WebMouseWheelEvent wheel =
+      input::WebMouseWheelEventBuilder::Build(event, view->GetNativeView().GetNativeNSView());
+  wheel.SetPositionInWidget(point);
+  wheel.SetPositionInScreen(point);
+  view->RouteOrProcessWheelEvent(wheel);
+}
+
+// The part of -[RenderWidgetHostViewCocoa keyEvent:wasKeyEquivalent:] that runs after
+// -interpretKeyEvents:; the other app did that step and sent what came out of it.
+// shortcut: no key equivalents, keyboard lock or "delay the key until the composition ends"
+// (crbug.com/48161); add them when a real IME shows the difference.
+void AgensEmbedKeyEvent(WebContents* contents, const AgensEmbedKey& key) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  NSEvent* ns_event = ui::EventFromData(key.native_event);
+  if (!view || !ns_event) return;
+  const NSEventType type = ns_event.type;
+  if (type != NSEventTypeKeyDown && type != NSEventTypeKeyUp && type != NSEventTypeFlagsChanged) {
+    return;
+  }
+  input::NativeWebKeyboardEvent event((base::apple::OwnedNSEvent(ns_event)));
+  const ui::LatencyInfo latency = Latency();
+
+  view->BeginKeyboardEvent();
+  if (type != NSEventTypeKeyDown) {
+    view->ForwardKeyboardEvent(event, latency);
+    view->EndKeyboardEvent();
+    return;
+  }
+
+  // Commands that insert characters are left out, as upstream does (Tab would insert a tab
+  // instead of moving to the next field); the key then goes on as a keypress below.
+  std::vector<blink::mojom::EditCommandPtr> commands;
+  bool has_commands = false;
+  for (const std::string& selector : key.selectors) {
+    if (selector == "noop:") continue;
+    has_commands = true;
+    const std::string command =
+        base::SysNSStringToUTF8(RenderWidgetHostViewMacEditCommandHelper::CommandNameForSelector(
+            NSSelectorFromString(base::SysUTF8ToNSString(selector))));
+    if (!base::StartsWith(command, "insert", base::CompareCase::INSENSITIVE_ASCII)) {
+      commands.push_back(blink::mojom::EditCommand::New(command, ""));
+    }
+  }
+  const bool commands_empty = commands.empty();
+  const bool has_marked = !key.marked.empty();
+
+  if (has_marked || key.had_marked || key.text.length() > 1) {
+    input::NativeWebKeyboardEvent fake = event;
+    fake.windows_key_code = 0xE5;  // VKEY_PROCESSKEY: an input method is composing
+    fake.skip_if_unhandled = true;
+    view->ForwardKeyboardEvent(fake, latency);
+  } else {
+    view->ForwardKeyboardEventWithCommands(event, latency, std::move(commands));
+  }
+
+  bool inserted = false;
+  if (key.text.length() > ((has_marked || key.had_marked) ? 0u : 1u)) {
+    view->ImeCommitText(key.text, gfx::Range::InvalidRange());
+    inserted = true;
+  }
+  if (has_marked) {
+    view->ImeSetComposition(key.marked, {}, gfx::Range::InvalidRange(), key.selection_start,
+                            key.selection_end);
+  } else if (key.had_marked && !inserted) {
+    if (key.unmarked) {
+      view->ImeFinishComposingText();
+    } else {
+      view->ImeCancelCompositionFromCocoa();
+    }
+  }
+
+  if (!has_marked) {
+    const NSEventModifierFlags kCtrlCmd = NSEventModifierFlagControl | NSEventModifierFlagCommand;
+    if (!inserted && key.text.length() == 1) {
+      event.SetType(blink::WebInputEvent::Type::kChar);
+      event.text[0] = key.text[0];
+      event.text[1] = 0;
+      event.skip_if_unhandled = true;
+      view->ForwardKeyboardEvent(event, latency);
+    } else if (!inserted && event.text[0] != '\0' &&
+               ((ns_event.modifierFlags & kCtrlCmd) || (has_commands && commands_empty))) {
+      event.SetType(blink::WebInputEvent::Type::kChar);
+      event.skip_if_unhandled = true;
+      view->ForwardKeyboardEvent(event, latency);
+    }
+  }
+  view->EndKeyboardEvent();
+}
+
+void AgensEmbedEdit(WebContents* contents, const std::string& command) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  if (command == "cut") view->Cut();
+  else if (command == "copy") view->Copy();
+  else if (command == "paste") view->Paste();
+  else if (command == "selectAll") view->SelectAll();
+  else if (command == "undo") view->Undo();
+  else if (command == "redo") view->Redo();
+}
+
+}  // namespace content
