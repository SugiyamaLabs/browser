+// --- Controls bound to Chromium prefs. The pref name rides in the control's identifier; the
+// profile store is tried first, then Local State.
+- (AgensPrefStore)storeFor:(const char*)name {
+  int dummy;
+  char buf[8];
+  if (_browser && (agens_pref_get_bool(_browser, kAgensProfile, name, &dummy) ||
+                   agens_pref_get_int(_browser, kAgensProfile, name, &dummy) ||
+                   agens_pref_get_string(_browser, kAgensProfile, name, buf, sizeof buf))) {
+    return kAgensProfile;
+  }
+  return kAgensLocal;
+}
+- (NSSwitch*)prefSwitch:(const char*)name {
+  NSSwitch* sw = [[NSSwitch alloc] init];
+  int on = 0;
+  if (_browser) agens_pref_get_bool(_browser, [self storeFor:name], name, &on);
+  sw.state = on ? NSControlStateValueOn : NSControlStateValueOff;
+  sw.identifier = @(name);
+  sw.target = self;
+  sw.action = @selector(toggleBool:);
+  return sw;
+}
+- (void)toggleBool:(NSSwitch*)sw {
+  const char* name = sw.identifier.UTF8String;
+  if (_browser) agens_pref_set_bool(_browser, [self storeFor:name], name, sw.state == NSControlStateValueOn);
+}
+- (NSSwitch*)intSwitch:(const char*)name on:(int)onValue off:(int)offValue {
+  NSSwitch* sw = [[NSSwitch alloc] init];
+  int v = offValue;
+  if (_browser) agens_pref_get_int(_browser, kAgensProfile, name, &v);
+  sw.state = v == onValue ? NSControlStateValueOn : NSControlStateValueOff;
+  sw.identifier = [NSString stringWithFormat:@"%s|%d|%d", name, onValue, offValue];
+  sw.target = self;
+  sw.action = @selector(toggleInt:);
+  return sw;
+}
+- (void)toggleInt:(NSSwitch*)sw {
+  NSArray<NSString*>* parts = [sw.identifier componentsSeparatedByString:@"|"];
+  int v = sw.state == NSControlStateValueOn ? parts[1].intValue : parts[2].intValue;
+  if (_browser) agens_pref_set_int(_browser, kAgensProfile, parts[0].UTF8String, v);
+}
+- (NSPopUpButton*)intPopup:(const char*)name labels:(NSArray<NSString*>*)labels values:(std::vector<int>)values {
+  NSPopUpButton* popup = [[NSPopUpButton alloc] init];
+  int v = values[0];
+  if (_browser) agens_pref_get_int(_browser, kAgensProfile, name, &v);
+  for (NSUInteger i = 0; i < labels.count; ++i) {
+    [popup addItemWithTitle:labels[i]];
+    popup.lastItem.tag = values[i];
+    if (values[i] == v) [popup selectItemAtIndex:i];
+  }
+  popup.identifier = @(name);
+  popup.target = self;
+  popup.action = @selector(pickInt:);
+  return popup;
+}
+- (void)pickInt:(NSPopUpButton*)popup {
+  if (_browser) agens_pref_set_int(_browser, kAgensProfile, popup.identifier.UTF8String, (int)popup.selectedItem.tag);
+}
+// GPC and Do Not Track go together.
+- (NSSwitch*)dntSwitch {
+  NSSwitch* sw = [self prefSwitch:"enable_do_not_track"];
+  sw.action = @selector(toggleDnt:);
+  return sw;
+}
+- (void)toggleDnt:(NSSwitch*)sw {
+  if (!_browser) return;
+  const int on = sw.state == NSControlStateValueOn;
+  agens_pref_set_bool(_browser, kAgensProfile, "enable_do_not_track", on);
+  agens_pref_set_bool(_browser, kAgensProfile, "universal_optout.enabled", on);
+}
+- (NSSwitch*)webrtcSwitch {
+  NSSwitch* sw = [[NSSwitch alloc] init];
+  char policy[64] = "";
+  if (_browser) agens_pref_get_string(_browser, kAgensProfile, "webrtc.ip_handling_policy", policy, sizeof policy);
+  sw.state = strcmp(policy, "disable_non_proxied_udp") == 0 ? NSControlStateValueOn : NSControlStateValueOff;
+  sw.target = self;
+  sw.action = @selector(toggleWebrtc:);
+  return sw;
+}
+- (void)toggleWebrtc:(NSSwitch*)sw {
+  if (_browser) {
+    agens_pref_set_string(_browser, kAgensProfile, "webrtc.ip_handling_policy",
+                          sw.state == NSControlStateValueOn ? "disable_non_proxied_udp" : "default");
+  }
+}
+- (NSSwitch*)cookiesOnCloseSwitch {
+  NSSwitch* sw = [[NSSwitch alloc] init];
+  sw.state = _browser && agens_permission_get(_browser, "cookies") == kAgensSessionOnly ? NSControlStateValueOn
+                                                                                       : NSControlStateValueOff;
+  sw.target = self;
+  sw.action = @selector(toggleCookiesOnClose:);
+  return sw;
+}
+- (void)toggleCookiesOnClose:(NSSwitch*)sw {
+  if (_browser) agens_permission_set(_browser, "cookies", sw.state == NSControlStateValueOn ? kAgensSessionOnly : kAgensAllow);
+}
+- (NSPopUpButton*)permissionPopup:(const char*)kind ask:(BOOL)ask {
+  NSPopUpButton* popup = [[NSPopUpButton alloc] init];
+  if (ask) {
+    [popup addItemWithTitle:@"Perguntar"];
+    popup.lastItem.tag = kAgensAsk;
+  }
+  [popup addItemWithTitle:@"Permitir"];
+  popup.lastItem.tag = kAgensAllow;
+  [popup addItemWithTitle:@"Bloquear"];
+  popup.lastItem.tag = kAgensBlock;
+  if (_browser) [popup selectItemWithTag:agens_permission_get(_browser, kind)];
+  popup.identifier = @(kind);
+  popup.target = self;
+  popup.action = @selector(pickPermission:);
+  return popup;
+}
+- (void)pickPermission:(NSPopUpButton*)popup {
+  if (_browser) agens_permission_set(_browser, popup.identifier.UTF8String, (AgensPermission)popup.selectedItem.tag);
+}
+- (NSButton*)linkButton:(NSString*)title url:(NSString*)url {
+  NSButton* b = [NSButton buttonWithTitle:title target:self action:@selector(openChromium:)];
+  b.identifier = url;
+  return b;
+}
