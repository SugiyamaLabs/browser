+// Copyright 2026 SugiyamaLabs.
+// The host draws the interface; the engine hands it the pages (docs/protocolo.md, "host e view").
+// - One host: the connection that sent host.attach (the app that launched the engine).
+// - Every tab of every ato has an id "v<n>" for as long as it lives, agent tabs included. The host
+//   learns them from view.tab events (sent when anything it shows changes) and view.closed.
+// - An attached tab draws by itself, outside any window (the shell never holds a tab while
+//   embedded, native_shell_mac.mm), and its CAContext id goes out as view.layer. Several at once.
+
+#include "chrome/browser/agens/bridge/view_ops.h"
+
+#include <unistd.h>
+
+#include <algorithm>
+#include <cmath>
+#include <map>
