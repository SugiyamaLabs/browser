+// Copyright 2026 SugiyamaLabs.
+// The host draws what the engine would put on screen (docs/protocolo.md, "Passo 5.3"): ui.ask to
+// the host, ui.answer back, ui.cancel when the engine gives up first. Embedded only; UI thread.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_UI_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_UI_OPS_H_
+
+#include <optional>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "chrome/browser/agens/bridge/ops.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "third_party/blink/public/mojom/choosers/date_time_chooser.mojom-forward.h"
+
+class GURL;
+namespace content {
+class JavaScriptDialogManager;
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+namespace url {
+class Origin;
+}  // namespace url
+
+namespace agens::bridge::ui_ask {
+
+// The host's ui.answer (already checked against the ask; {cancel: true} included: the person
+// decided), or null when the engine ended it (the host left, the tab closed or navigated, too
+// many open).
+using AnswerCallback = base::OnceCallback<void(const base::DictValue* answer)>;
+
+// Sends ui.ask {ask, kind, tab, ...fields} once the asks of the same tab and kind before it are
+// done. `contents` is null only for an extension. `done` runs exactly once, unless Withdraw; with
+// null (posted) when there is no host or too many are open (ui_answer.h). What the page controls
+// is cut first (ClipUiAsk). Returns the ask, for Withdraw.
+int Ask(content::WebContents* contents, std::string_view kind, base::DictValue fields, AnswerCallback done);
+// The page gave up: the host gets ui.cancel "gone" if it was asked, and `done` never runs.
+void Withdraw(int ask);
+// An open ask changed (screen_share's sources): `fields` replace those keys in it, and the host
+// gets ui.update {ask, kind, tab, ...fields} if it was sent. False when it was not sent yet (it
+// goes later with these fields) or is gone.
+bool Update(int ask, base::DictValue fields);
+// The ask is on the host now (not waiting behind another of its tab and kind).
+bool Sent(int ask);
+
+// The engine closes the tab (view.close, tab.close): its asks end with "closed" now, before
+// Chromium tears the page down and cancels its dialogs for other reasons.
+void TabClosing(content::WebContents* contents);
+
+// An agent drives the tab and the person hasn't taken over: select, context_menu, file and auth
+// are cancelled for it instead of reaching the host.
+bool AgentWorking(content::WebContents* contents);
+
+// view_ops.cc: ui.answer (`from_host`: on the host's connection); the host is gone (every ask
+// ends without an answer).
+void HandleAnswer(bool from_host, const Request& request, ReplyCallback reply);
+void HostGone();
+
+// Embedded, once: <select> lists, right clicks, file panels, color choosers, passkey requests,
+// the cursor and the caret go to the host.
+void Start();
+
+// The date and time pickers of a frame's <input> (ui.ask "date"), bound for the embedded engine
+// only (chrome_browser_interface_binders.cc); one open at a time per frame.
+void BindDateTimeChooser(content::RenderFrameHost* frame,
+                         mojo::PendingReceiver<blink::mojom::DateTimeChooser> receiver);
+
+// window.print() and the like reached print preview: ui.ask "print" for the host, which prints
+// with view.print_pdf and answers cancel when done. Nothing for a tab an agent works.
+void AskPrint(content::WebContents* contents);
+
+// A link to another app (mailto:, zoommtg:...) that Chromium would launch: the host gets
+// view.external and opens it. False (refused) when there is no host, the tab is not one it
+// knows, an agent works it, or the address is longer than kMaxUiUrlBytes.
+bool LaunchExternal(content::WebContents* contents,
+                    const GURL& url,
+                    const std::optional<url::Origin>& initiator,
+                    bool gesture);
+
+// view.print_pdf (view_ops.cc): the tab's page as a PDF in a file of the host's, kept until the
+// next call, the tab closing or the host going.
+void PrintPdf(content::WebContents* contents, const Request& request, ReplyCallback reply);
+
+// The JavaScript dialogs of embedded tabs no agent holds (ui.ask "dialog").
+content::JavaScriptDialogManager* Dialogs();
+// An agent takes the tab back ("Devolver"): its dialogs open on the host are cancelled there and
+// handed to `to`, oldest first.
+void HandDialogsTo(content::WebContents* contents, content::JavaScriptDialogManager* to);
+
+}  // namespace agens::bridge::ui_ask
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_UI_OPS_H_
