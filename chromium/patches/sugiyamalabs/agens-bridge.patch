+void StreamFactory::SetGroupVolume(const base::UnguessableToken& group_id,
+                                   double volume) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(owning_sequence_);
+  volume = std::clamp(volume, 0.0, 1.0);
+  if (volume == 1.0) {
+    group_volumes_.erase(group_id);
+  } else {
+    group_volumes_[group_id] = volume;
+  }
+  ApplyGroupVolume(group_id);
+}
+
+void StreamFactory::ApplyGroupVolume(const base::UnguessableToken& group_id) {
+  auto it = group_volumes_.find(group_id);
+  const double volume = it == group_volumes_.end() ? 1.0 : it->second;
+  coordinator_.ForEachMember(base::BindRepeating(
+      [](const base::UnguessableToken& group_id, double volume,
+         const LoopbackCoordinator::Member& member) {
+        if (member.group_id == group_id) {
+          member.loopback_source->SetGroupVolume(volume);
+        }
+      },
+      group_id, volume));
+}
