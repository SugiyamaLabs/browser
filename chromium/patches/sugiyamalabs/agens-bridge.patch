+  _line.layer.backgroundColor = CG(kLine, self);
+}
+- (void)setCurrent:(NSString*)where {
+  NSArray* keys = @[ @"bottom", @"right", @"window" ];
+  for (NSUInteger i = 0; i < keys.count; ++i) {
+    const BOOL on = [keys[i] isEqual:where];
+    [_buttons[i] setTint:on ? kLight3 : kDim];
+    _buttons[i].accessibilityValue = on ? @"marcado" : nil;
+  }
+}
