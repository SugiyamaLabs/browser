+#endif  // CHROME_BROWSER_AGENS_BRIDGE_SESSION_OPS_H_
diff --git a/chrome/browser/agens/bridge/ui_answer.cc b/chrome/browser/agens/bridge/ui_answer.cc
new file mode 100644
index 0000000000..1bd65165f3
--- /dev/null
+++ b/chrome/browser/agens/bridge/ui_answer.cc
@@ -0,0 +1,111 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/ui_answer.h"
+
+#include <initializer_list>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+
+namespace agens::bridge {
+
+namespace {
+
+// Only `id`, `op`, `ask`, `cancel` and the kind's own keys.
+bool OnlyKeys(const base::DictValue& body, std::initializer_list<std::string_view> own) {
+  for (const auto [key, value] : body) {
+    if (key == "id" || key == "op" || key == "ask" || key == "cancel") continue;
+    bool known = false;
+    for (std::string_view k : own) known = known || key == k;
+    if (!known) return false;
+  }
+  return true;
+}
+
+bool IsText(const base::Value* value) {
+  return value && value->is_string() && value->GetString().size() <= kMaxUiTextBytes;
+}
+
+bool IsAbsolutePath(const base::Value& value) {
+  if (!IsText(&value)) return false;
+  const std::string& path = value.GetString();
+  return !path.empty() && path[0] == '/' && path.find('\0') == std::string::npos &&
+         !base::FilePath(path).ReferencesParent();
+}
+
+UiAnswer Pick(bool ok) {
+  return ok ? UiAnswer::kAnswer : UiAnswer::kBadRequest;
+}
+
+}  // namespace
+
+UiAnswer CheckUiAnswer(bool from_host, const base::DictValue* asked_or_null, const base::DictValue& body) {
+  if (!from_host) return UiAnswer::kUnauthorized;
+  if (!body.FindString("ask")) return UiAnswer::kBadRequest;
+  if (!asked_or_null) return UiAnswer::kNotFound;
+  const base::DictValue& asked = *asked_or_null;
+  const std::string* kind = asked.FindString("kind");
+  if (!kind) return UiAnswer::kBadRequest;
+  if (const base::Value* cancel = body.Find("cancel")) {
+    return cancel->is_bool() && cancel->GetBool() && OnlyKeys(body, {}) ? UiAnswer::kCancel : UiAnswer::kBadRequest;
+  }
+  if (*kind == "select") {
+    if (!OnlyKeys(body, {"index"})) return UiAnswer::kBadRequest;
+    std::optional<int> index = body.FindInt("index");
+    const base::ListValue* items = asked.FindList("items");
+    if (!index || !items || *index < 0 || static_cast<size_t>(*index) >= items->size()) return UiAnswer::kBadRequest;
+    const base::DictValue* item = (*items)[*index].GetIfDict();
+    return Pick(item && !item->FindBool("disabled").value_or(false) && !item->FindBool("group").value_or(false));
+  }
+  if (*kind == "context_menu") {
+    const std::string* action = body.FindString("action");
+    const base::ListValue* actions = asked.FindListByDottedPath("context.actions");
+    return Pick(OnlyKeys(body, {"action"}) && action && actions && actions->contains(*action));
+  }
+  if (*kind == "dialog") {
+    if (!OnlyKeys(body, {"accept", "text"})) return UiAnswer::kBadRequest;
+    std::optional<bool> accept = body.FindBool("accept");
+    const base::Value* text = body.Find("text");
+    const std::string* type = asked.FindString("type");
+    if (!accept) return UiAnswer::kBadRequest;
+    return Pick(!text || (IsText(text) && *accept && type && *type == "prompt"));
+  }
+  if (*kind == "file") {
+    const base::ListValue* paths = body.FindList("paths");
+    const std::string* mode = asked.FindString("mode");
+    if (!OnlyKeys(body, {"paths"}) || !paths || !mode) return UiAnswer::kBadRequest;
+    if (paths->empty()) return UiAnswer::kCancel;
+    if (paths->size() > (*mode == "open_multiple" ? kMaxUiPaths : 1)) return UiAnswer::kBadRequest;
+    for (const base::Value& path : *paths) {
+      if (!IsAbsolutePath(path)) return UiAnswer::kBadRequest;
+    }
+    return UiAnswer::kAnswer;
+  }
+  if (*kind == "auth") {
+    return Pick(OnlyKeys(body, {"username", "password"}) && IsText(body.Find("username")) &&
+                IsText(body.Find("password")));
+  }
+  if (*kind == "permission") {
+    const base::Value* remember = body.Find("remember");
+    return Pick(OnlyKeys(body, {"allow", "remember"}) && body.FindBool("allow") && (!remember || remember->is_bool()));
+  }
+  if (*kind == "extension") return Pick(OnlyKeys(body, {"allow"}) && body.FindBool("allow"));
+  return UiAnswer::kBadRequest;
+}
+
+bool PathsFitMode(std::string_view mode, const base::ListValue& paths) {
+  for (const base::Value& value : paths) {
+    if (!value.is_string()) return false;
+    const base::FilePath path(value.GetString());
+    if (mode == "folder") {
+      if (!base::DirectoryExists(path)) return false;
+    } else if (mode == "save") {
+      if (base::DirectoryExists(path) || !base::DirectoryExists(path.DirName())) return false;
+    } else if (!base::PathExists(path) || base::DirectoryExists(path)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace agens::bridge
