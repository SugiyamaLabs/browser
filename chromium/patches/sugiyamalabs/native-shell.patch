+// Toolbar button: 28 pt square, dim symbol, hover background.
+@interface AgensToolButton : AgensHoverView
+@property(nonatomic) BOOL enabled;
+- (instancetype)initWithSymbol:(NSString*)symbol label:(NSString*)label;
+- (void)setSymbol:(NSString*)symbol;
+@end
+@implementation AgensToolButton {
+  NSImageView* _icon;
+}
+@synthesize enabled = _enabled;
+- (instancetype)initWithSymbol:(NSString*)symbol label:(NSString*)label {
+  if ((self = [super initWithFrame:NSMakeRect(0, 0, 28, 28)])) {
+    _icon = [NSImageView imageViewWithImage:Symbol(symbol)];
+    _icon.contentTintColor = kDim.color();
+    [self addSubview:_icon];
+    self.accessibilityLabel = label;
+    self.toolTip = label;
+    self.enabled = YES;
+  }
+  return self;
+}
+- (void)layout {
+  [super layout];
+  _icon.frame = self.bounds;
+}
+- (void)setEnabled:(BOOL)enabled {
+  _enabled = enabled;
+  self.alphaValue = enabled ? 1 : 0.35;
+}
+- (void)setSymbol:(NSString*)symbol {
+  _icon.image = Symbol(symbol);
+}
+- (void)mouseDown:(NSEvent*)event {
+  if (_enabled) [super mouseDown:event];
+}
+- (void)refresh {
+  self.layer.backgroundColor = self.hovered && _enabled ? CG(kRaise, self) : NSColor.clearColor.CGColor;
+}
+@end
