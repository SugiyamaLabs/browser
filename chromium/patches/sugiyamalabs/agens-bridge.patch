+}
+
+// The dock bar: a side of the card, its own window, or close. The choice holds for every ato.
+- (void)dockDevTools:(NSString*)where {
+  if (!_window) return;
+  NSUserDefaults* d = NSUserDefaults.standardUserDefaults;
+  if ([where isEqual:@"close"]) {
+    agens_window_devtools(_window, 0);
+    return;
+  }
+  [d setObject:where forKey:kDevToolsDockKey];
+  if (![where isEqual:@"window"]) [d setObject:where forKey:kDevToolsSideKey];
+  [_devtoolsBar setCurrent:where];
+  if ([where isEqual:@"window"]) {
+    agens_window_devtools(_window, 2);
+  } else if (_devtools == 2) {
+    agens_window_devtools(_window, 1);
+  } else {
+    [self relayout];
+    agens_window_relayout(_window);
+  }
+}
