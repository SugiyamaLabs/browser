+class HostColorChooser : public content::ColorChooser {
+ public:
+  explicit HostColorChooser(int ask) : ask_(ask) {}
+  ~HostColorChooser() override { End(); }
+  // The page closed it, or the host's answer ended it (then the ask is gone already).
+  void End() override { Withdraw(std::exchange(ask_, 0)); }
+  // shortcut: a page changing the value while the host shows the chooser is not passed on; send
+  // a fresh ui.ask (or a ui.update) if a host wants to follow it.
