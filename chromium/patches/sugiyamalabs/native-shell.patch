+// Rounded hover/selected background, as the prototype's .tbtn / .stab.
+@interface AgensHoverView : AgensDragView
+@property(nonatomic) BOOL selected;
+@property(nonatomic) BOOL hovered;
+@property(nonatomic, copy) void (^onPress)(void);
+- (void)refresh;
+@end
+@implementation AgensHoverView {
+  NSTrackingArea* _tracking;
+}
+@synthesize selected = _selected;
+@synthesize hovered = _hovered;
+@synthesize onPress = _onPress;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    self.layer.cornerRadius = 8;
+  }
+  return self;
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_tracking) [self removeTrackingArea:_tracking];
+  _tracking = [[NSTrackingArea alloc]
+      initWithRect:NSZeroRect
+           options:NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways | NSTrackingInVisibleRect
+             owner:self
+          userInfo:nil];
+  [self addTrackingArea:_tracking];
+  // Rows move under a still pointer when the list scrolls or changes; the enter/exit events for
+  // that never come, so read where the pointer really is.
+  NSPoint p = [self convertPoint:self.window.mouseLocationOutsideOfEventStream fromView:nil];
+  BOOL inside = self.window && !self.hidden && NSPointInRect(p, self.visibleRect);
+  if (inside != _hovered) {
+    _hovered = inside;
+    [self refresh];
+  }
+}
+- (void)refresh {
+  self.layer.backgroundColor =
+      _selected ? CG(kRaise, self) : _hovered ? CG(kHover, self) : NSColor.clearColor.CGColor;
+}
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  [self refresh];
+}
+- (void)setSelected:(BOOL)selected {
+  _selected = selected;
+  [self refresh];
+}
+- (void)mouseEntered:(NSEvent*)event {
+  _hovered = YES;
+  [self refresh];
+}
+- (void)mouseExited:(NSEvent*)event {
+  _hovered = NO;
+  [self refresh];
+}
+- (void)mouseDown:(NSEvent*)event {
+  if (_onPress) _onPress();
+}
+- (BOOL)isAccessibilityElement {
+  return YES;
+}
+- (NSAccessibilityRole)accessibilityRole {
+  return NSAccessibilityButtonRole;
+}
+- (BOOL)accessibilityPerformPress {
+  if (_onPress) _onPress();
+  return YES;
+}
+@end
