@@ -0,0 +1,510 @@
+// Copyright 2026 SugiyamaLabs.
+// - The extension is `extension` in ops and events: a request's own `id` is taken.
+// - Installing always goes through the person: extension.install only starts it, and the prompt
+//   (ui.ask "extension", with the ato choice) is what lets it in, here and into other atos.
+// - A popup is the extension's page in its own WebContents (an ExtensionViewHost, as Chrome's
+//   bubble has), sized by its content (25x25 to 800x600), with an id from the tabs' numbering.
+//   It is never in view.tab and never in a window; the host attaches it like a tab.
+
+#include "chrome/browser/agens/bridge/extension_ops.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+#include "base/scoped_observation.h"
+#include "base/strings/stringprintf.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/agens/bridge/ui_ops.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+#include "chrome/browser/agens/bridge/view_ops.h"
+#include "chrome/browser/agens/embed/agens_controlled.h"
+#include "chrome/browser/agens/embed/agens_extensions.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/extensions/extension_action_runner.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/extensions/extension_view.h"
+#include "chrome/browser/extensions/extension_view_host.h"
+#include "chrome/browser/extensions/extension_view_host_factory.h"
+#include "chrome/browser/ui/extensions/extension_popup_types.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "extensions/browser/disable_reason.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registrar.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+#include "extensions/common/manifest_handlers/options_page_info.h"
+#include "extensions/common/permissions/permission_message.h"
+#include "extensions/common/permissions/permissions_data.h"
+
+namespace agens::bridge::extension {
+
+namespace {
+
+using extensions::Extension;
+using extensions::ExtensionRegistry;
+
+constexpr char kFailed[] = "failed";
+
+std::string TabName(int n) {
+  return ViewTabName(n);
+}
+
+std::string Color(SkColor color) {
+  if (!SkColorGetA(color)) return std::string();  // not set: the host's default
+  return base::StringPrintf("#%02X%02X%02X", SkColorGetR(color), SkColorGetG(color), SkColorGetB(color));
+}
+
+// What a toolbar shows of the action on `tab_id` (ExtensionAction::kDefaultTabId for every tab).
+void ActionFields(base::DictValue& fields, extensions::ExtensionAction& action, const Extension& e, int tab_id) {
+  std::string title = action.GetTitle(tab_id);
+  fields.Set("title", title.empty() ? e.name() : title);
+  fields.Set("badge", action.GetDisplayBadgeText(tab_id));
+  fields.Set("badge_color", Color(action.GetBadgeBackgroundColor(tab_id)));
+  fields.Set("visible", action.GetIsVisible(tab_id));
+  fields.Set("popup", action.HasPopup(tab_id));
+}
+
+extensions::ExtensionAction* ActionOf(Profile* profile, const Extension& e) {
+  return extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(e);
+}
+
+base::DictValue ExtensionFields(Profile* profile, const Extension& e, int tab_id) {
+  base::DictValue fields;
+  fields.Set("id", e.id());
+  fields.Set("name", e.name());
+  fields.Set("version", e.VersionString());
+  fields.Set("enabled", ExtensionRegistry::Get(profile)->enabled_extensions().Contains(e.id()));
+  fields.Set("from", ext::From(e));
+  extensions::ExtensionAction* action = ActionOf(profile, e);
+  fields.Set("action", !!action);
+  if (action) ActionFields(fields, *action, e, tab_id);
+  fields.Set("pinned", ext::Pinned(profile, e.id()));
+  fields.Set("options", extensions::OptionsPageInfo::HasOptionsPage(&e));
+  base::ListValue permissions;
+  for (const extensions::PermissionMessage& message : e.permissions_data()->GetPermissionMessages()) {
+    permissions.Append(base::UTF16ToUTF8(message.message()));
+  }
+  fields.Set("permissions", std::move(permissions));
+  base::ListValue hosts;
+  for (const std::string& pattern : e.permissions_data()->active_permissions().effective_hosts().ToStringVector()) {
+    hosts.Append(pattern);
+  }
+  fields.Set("host_permissions", std::move(hosts));
+  base::ListValue atos;
+  for (const std::string& ato : ext::AtosWith(e.id())) atos.Append(ato);
+  fields.Set("atos", std::move(atos));
+  return fields;
+}
+
+// --- The popup.
+
+class Popup;
+struct State {
+  std::vector<std::unique_ptr<Popup>> popups;
+  bool started = false;
+};
+State& S() {
+  static base::NoDestructor<State> state;
+  return *state;
+}
+
+class Popup : public extensions::ExtensionView,
+              public content::WebContentsObserver,  // the tab it was opened on
+              public extensions::ExtensionRegistryObserver {
+ public:
+  Popup(std::unique_ptr<extensions::ExtensionViewHost> host, content::WebContents* tab)
+      : content::WebContentsObserver(tab), host_(std::move(host)), tab_(view::TabNumber(tab)) {
+    content::WebContents* contents = host_->host_contents();
+    n_ = view::TabNumber(contents);
+    id_ = host_->extension_id();
+    host_->set_view(this);
+    // window.close() in the popup.
+    host_->SetCloseHandler(base::BindOnce([](Popup* popup, extensions::ExtensionHost*) { popup->Close(); },
+                                          base::Unretained(this)));
+    registry_.Observe(ExtensionRegistry::Get(host_->browser_context()));
+    // Seen as visible from the start (it is in no window): it lays out and sizes itself.
+    capture_ = contents->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/false, /*stay_awake=*/false,
+                                                /*is_activity=*/false);
+    contents->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+    contents->Resize(gfx::Rect(extensions::kExtensionPopupMinSize));
+    view::AddView(contents);
+    host_->CreateRendererSoon();
+  }
+  ~Popup() override {
+    if (host_) host_->set_view(nullptr);
+  }
+
+  int n() const { return n_; }
+
+  // Once: tells the host, takes the view away from it and goes (posted: this may run inside the
+  // host's own call).
+  void Close() {
+    if (closing_) return;
+    closing_ = true;
+    Observe(nullptr);
+    registry_.Reset();
+    if (host_) view::RemoveView(host_->host_contents());
+    if (view::Host()) {
+      base::DictValue fields;
+      fields.Set("popup", TabName(n_));
+      SendEventTo(view::Host(), "extension.popup.closed", std::move(fields));
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](Popup* popup) {
+                         std::erase_if(S().popups, [popup](const auto& p) { return p.get() == popup; });
+                       },
+                       base::Unretained(this)));
+  }
+
+  // extensions::ExtensionView:
+  gfx::NativeView GetNativeView() override { return host_->host_contents()->GetNativeView(); }
+  void ResizeDueToAutoResize(content::WebContents* contents, const gfx::Size& size) override {
+    if (closing_ || size.IsEmpty()) return;
+    size_ = size;
+    contents->Resize(gfx::Rect(size));
+    if (loaded_) SendSize();
+  }
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    // The main frame sizes the popup, as Chrome's bubble does (ExtensionViewViews).
+    if (!frame->GetParent() && frame->GetView()) {
+      frame->GetView()->EnableAutoResize(extensions::kExtensionPopupMinSize, extensions::kExtensionPopupMaxSize);
+    }
+  }
+  bool HandleKeyboardEvent(content::WebContents*, const input::NativeWebKeyboardEvent&) override { return false; }
+  void OnLoaded() override {
+    loaded_ = true;
+    SendSize();
+  }
+
+  // content::WebContentsObserver (the tab):
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) Close();
+  }
+  void WebContentsDestroyed() override { Close(); }
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionUnloaded(content::BrowserContext*, const Extension* e, extensions::UnloadedExtensionReason) override {
+    if (e->id() == id_) Close();
+  }
+  void OnShutdown(ExtensionRegistry*) override { Close(); }
+
+ private:
+  void SendSize() {
+    if (!view::Host() || size_.IsEmpty()) return;
+    base::DictValue fields;
+    fields.Set("popup", TabName(n_));
+    fields.Set("tab", TabName(tab_));
+    fields.Set("extension", id_);
+    fields.Set("width", size_.width());
+    fields.Set("height", size_.height());
+    SendEventTo(view::Host(), "extension.popup", std::move(fields));
+  }
+
+  std::unique_ptr<extensions::ExtensionViewHost> host_;
+  int n_ = 0;
+  const int tab_;
+  std::string id_;
+  gfx::Size size_;
+  bool loaded_ = false;
+  bool closing_ = false;
+  base::ScopedClosureRunner capture_;
+  base::ScopedObservation<ExtensionRegistry, extensions::ExtensionRegistryObserver> registry_{this};
+};
+
+Popup* FindPopup(int n) {
+  for (auto& p : S().popups) {
+    if (p->n() == n) return p.get();
+  }
+  return nullptr;
+}
+
+// --- Events.
+
+class Events : public ext::Observer {
+ public:
+  void OnExtensionChanged(Profile* ato, const std::string& id, std::string_view change) override {
+    if (!view::Host()) return;
+    base::DictValue fields;
+    fields.Set("ato", ext::AtoId(ato));
+    fields.Set("extension", id);
+    fields.Set("change", change);
+    SendEventTo(view::Host(), "extension.changed", std::move(fields));
+  }
+  void OnExtensionActionChanged(Profile* ato, const std::string& id, content::WebContents* tab) override {
+    const int n = tab ? view::KnownTab(tab) : 0;
+    const Extension* e = ExtensionRegistry::Get(ato)->enabled_extensions().GetByID(id);
+    extensions::ExtensionAction* action = e ? ActionOf(ato, *e) : nullptr;
+    if (!view::Host() || !action || (tab && !n)) return;
+    base::DictValue fields;
+    fields.Set("ato", ext::AtoId(ato));
+    if (n) fields.Set("tab", TabName(n));  // absent: the default, on every tab of the ato
+    fields.Set("extension", id);
+    ActionFields(fields, *action, *e,
+                 tab ? extensions::ExtensionTabUtil::GetTabId(tab) : extensions::ExtensionAction::kDefaultTabId);
+    SendEventTo(view::Host(), "extension.action", std::move(fields));
+  }
+};
+
+// --- Requests.
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+// Runs `then(profile)` with the request's ato, loading it when it sleeps; answers the errors.
+void WithAto(Request request, ReplyCallback reply, base::OnceCallback<void(Request, ReplyCallback, Profile*)> then) {
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  if (!ato) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+  ProfileAttributesEntry* entry = FindAto(*ato);
+  if (!entry) return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (Profile* profile = manager->GetProfileByPath(entry->GetPath())) {
+    return std::move(then).Run(std::move(request), std::move(reply), profile);
+  }
+  manager->LoadProfileByPath(
+      entry->GetPath(), /*incognito=*/false,
+      base::BindOnce(
+          [](Request request, ReplyCallback reply, base::OnceCallback<void(Request, ReplyCallback, Profile*)> then,
+             Profile* profile) {
+            if (!profile) return std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not load the ato"));
+            std::move(then).Run(std::move(request), std::move(reply), profile);
+          },
+          std::move(request), std::move(reply), std::move(then)));
+}
+
+// The request's `tab`, when it has one: nullopt when absent, null contents when not a tab.
+std::optional<content::WebContents*> OptionalTab(const Request& request, bool& bad) {
+  const base::Value* value = request.body.Find("tab");
+  if (!value) return std::nullopt;
+  std::optional<int> n = value->is_string() ? ParseViewTab(value->GetString()) : std::nullopt;
+  bad = !n;
+  return n ? view::FindView(*n) : nullptr;
+}
+
+void ExtensionsList(Request request, ReplyCallback reply, Profile* profile) {
+  bool bad = false;
+  std::optional<content::WebContents*> tab = OptionalTab(request, bad);
+  if (bad) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "tab must be a v<n> id"));
+  if (tab && !*tab) return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *request.body.FindString("tab")));
+  const int tab_id = tab ? extensions::ExtensionTabUtil::GetTabId(*tab) : extensions::ExtensionAction::kDefaultTabId;
+  base::ListValue list;
+  for (const auto& e : ExtensionRegistry::Get(profile)->GenerateInstalledExtensionsSet()) {
+    if (ext::Listed(*e)) list.Append(ExtensionFields(profile, *e, tab_id));
+  }
+  base::DictValue result;
+  result.Set("extensions", std::move(list));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// The ato's extension `id` (enabled or not), or the reply says why not.
+const Extension* NeedExtension(Profile* profile, const Request& request, ReplyCallback& reply) {
+  std::optional<std::string> id = StringParam(request.body, "extension");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and extension"));
+    return nullptr;
+  }
+  const Extension* e = ExtensionRegistry::Get(profile)->GetInstalledExtension(*id);
+  if (!e || !ext::Listed(*e)) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return nullptr;
+  }
+  return e;
+}
+
+void ExtensionIcon(Request request, ReplyCallback reply, Profile* profile) {
+  const Extension* e = NeedExtension(profile, request, reply);
+  if (!e) return;
+  bool bad = false;
+  std::optional<content::WebContents*> tab = OptionalTab(request, bad);
+  if (bad) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "tab must be a v<n> id"));
+  if (tab && !*tab) return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *request.body.FindString("tab")));
+  auto send = base::BindOnce(
+      [](base::Value id, ReplyCallback reply, std::vector<uint8_t> png) {
+        base::DictValue result;
+        result.Set("png", base::Base64Encode(png));  // empty: it has none
+        std::move(reply).Run(OkReply(id, std::move(result)));
+      },
+      request.id.Clone(), std::move(reply));
+  if (tab) {
+    std::vector<uint8_t> set = ext::SetIcon(profile, *e, extensions::ExtensionTabUtil::GetTabId(*tab));
+    if (!set.empty()) return std::move(send).Run(std::move(set));
+  }
+  ext::LoadIcon(profile, *e, /*of_action=*/tab.has_value(), std::move(send));
+}
+
+void ExtensionEnable(Request request, ReplyCallback reply, Profile* profile) {
+  std::optional<bool> on = request.body.FindBool("on");
+  if (!on) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato, extension and on (a boolean)"));
+  const Extension* e = NeedExtension(profile, request, reply);
+  if (!e) return;
+  auto* registrar = extensions::ExtensionRegistrar::Get(profile);
+  if (*on) {
+    registrar->EnableExtension(e->id());
+  } else {
+    registrar->DisableExtension(e->id(), {extensions::disable_reason::DISABLE_USER_ACTION});
+  }
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void ExtensionPin(Request request, ReplyCallback reply, Profile* profile) {
+  std::optional<bool> on = request.body.FindBool("on");
+  if (!on) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato, extension and on (a boolean)"));
+  const Extension* e = NeedExtension(profile, request, reply);
+  if (!e) return;
+  ext::SetPinned(profile, e->id(), *on);
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void ExtensionRemove(Request request, ReplyCallback reply, Profile* profile) {
+  const base::Value* all = request.body.Find("all");
+  if (all && !all->is_bool()) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "all is a boolean"));
+  const Extension* e = NeedExtension(profile, request, reply);
+  if (!e) return;
+  ext::Remove(profile, e->id(), all && all->GetBool(),
+              base::BindOnce([](base::Value id, ReplyCallback reply) { std::move(reply).Run(OkReply(id)); },
+                             request.id.Clone(), std::move(reply)));
+}
+
+void ExtensionOptions(Request request, ReplyCallback reply, Profile* profile) {
+  const Extension* e = NeedExtension(profile, request, reply);
+  if (!e) return;
+  if (!ExtensionRegistry::Get(profile)->enabled_extensions().Contains(e->id()) ||
+      !extensions::OptionsPageInfo::HasOptionsPage(e)) {
+    return std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no options page (or the extension is off)"));
+  }
+  view::OpenTab(std::move(request), std::move(reply), extensions::OptionsPageInfo::GetOptionsPage(e), profile);
+}
+
+// {crx: "/abs"} or {folder: "/abs"}: checked on disk, then the install, which asks the person.
+void ExtensionInstall(Request request, ReplyCallback reply, Profile* profile) {
+  std::optional<std::string> crx = StringParam(request.body, "crx");
+  std::optional<std::string> folder = StringParam(request.body, "folder");
+  const base::FilePath path(crx ? *crx : folder ? *folder : std::string());
+  const bool one = (request.body.contains("crx") + request.body.contains("folder")) == 1 && (crx || folder);
+  if (!one || !path.IsAbsolute() || path.ReferencesParent() || path.value().find('\0') != std::string::npos) {
+    return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and crx or folder (an absolute path)"));
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath path, bool folder) {
+            if (folder) return base::DirectoryExists(path) && base::PathExists(path.AppendASCII("manifest.json"));
+            return base::PathExists(path) && !base::DirectoryExists(path) && path.MatchesExtension(".crx");
+          },
+          path, !!folder),
+      base::BindOnce(
+          [](Request request, ReplyCallback reply, base::WeakPtr<Profile> profile, base::FilePath path, bool fits) {
+            if (!fits) {
+              return std::move(reply).Run(ErrorReply(
+                  &request.id, kBadRequest, "crx must be a .crx file, folder a folder with a manifest.json"));
+            }
+            if (!profile) return std::move(reply).Run(ErrorReply(&request.id, kFailed, "the ato went away"));
+            ext::InstallFromDisk(profile.get(), path, gfx::NativeWindow(),
+                                 base::BindOnce(
+                                     [](base::Value id, ReplyCallback reply, const std::string& extension,
+                                        const std::string& error) {
+                                       if (!error.empty()) {
+                                         return std::move(reply).Run(ErrorReply(
+                                             &id, error, error == kDenied ? "the person said no" : "could not install"));
+                                       }
+                                       base::DictValue result;
+                                       result.Set("extension", extension);  // "id" is the request's
+                                       std::move(reply).Run(OkReply(id, std::move(result)));
+                                     },
+                                     request.id.Clone(), std::move(reply)));
+          },
+          std::move(request), std::move(reply), profile->GetWeakPtr(), path));
+}
+
+// extension.click {tab, id}: the extension's action on that tab, as a click on its button.
+void ExtensionClick(const Request& request, ReplyCallback reply) {
+  std::optional<int> n = request.body.FindString("tab") ? ParseViewTab(*request.body.FindString("tab")) : std::nullopt;
+  std::optional<std::string> id = StringParam(request.body, "extension");
+  if (!n || !id) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and extension"));
+  AgensWindow* window = nullptr;
+  content::WebContents* contents = view::FindView(*n, &window);
+  if (!contents || !window) return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *request.body.FindString("tab")));
+  Profile* profile = window->browser->GetProfile();
+  const Extension* e = ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(*id);
+  extensions::ExtensionAction* action = e ? ActionOf(profile, *e) : nullptr;
+  if (!action) return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id + " (or it is off, or has no action)"));
+  // As the toolbar button: nothing on a tab an agent uses while agent_extensions is off.
+  if (AgensControlled::BlocksExtensions(contents)) {
+    return std::move(reply).Run(ErrorReply(&request.id, kDenied, "an agent is using this tab"));
+  }
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(contents);
+  if (!runner) return std::move(reply).Run(ErrorReply(&request.id, kFailed, "this tab runs no extensions"));
+  if (runner->RunAction(e, /*grant_tab_permissions=*/true) != extensions::ExtensionAction::ShowAction::kShowPopup) {
+    return std::move(reply).Run(OkReply(request.id));  // the extension handled the click itself
+  }
+  // One popup at a time, as Chrome's bubble.
+  for (auto& popup : S().popups) popup->Close();
+  const GURL url = action->GetPopupUrl(extensions::ExtensionTabUtil::GetTabId(contents));
+  S().popups.push_back(std::make_unique<Popup>(
+      extensions::ExtensionViewHostFactory::CreatePopupHost(*e, url, window->browser.get()), contents));
+  base::DictValue result;
+  result.Set("popup", TabName(S().popups.back()->n()));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+void PopupClose(const Request& request, ReplyCallback reply) {
+  const std::string* popup = request.body.FindString("popup");
+  std::optional<int> n = popup ? ParseViewTab(*popup) : std::nullopt;
+  if (!n) return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs popup"));
+  Popup* found = FindPopup(*n);
+  if (!found) return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *popup));
+  found->Close();
+  std::move(reply).Run(OkReply(request.id));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return op == "extensions.list" || op.starts_with("extension.");
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  const std::string op = request.op;
+  if (op == "extension.click") return ExtensionClick(request, std::move(reply));
+  if (op == "extension.popup.close") return PopupClose(request, std::move(reply));
+  void (*with_ato)(Request, ReplyCallback, Profile*) = op == "extensions.list"     ? &ExtensionsList
+                                                       : op == "extension.icon"    ? &ExtensionIcon
+                                                       : op == "extension.enable"  ? &ExtensionEnable
+                                                       : op == "extension.pin"     ? &ExtensionPin
+                                                       : op == "extension.remove"  ? &ExtensionRemove
+                                                       : op == "extension.options" ? &ExtensionOptions
+                                                       : op == "extension.install" ? &ExtensionInstall
+                                                                                   : nullptr;
+  if (!with_ato) return std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  WithAto(std::move(request), std::move(reply), base::BindOnce(with_ato));
+}
+
+void Start() {
+  if (S().started) return;
+  S().started = true;
+  ext::Start();
+  static base::NoDestructor<Events> events;
+  ext::AddObserver(events.get());
+}
+
+void HostGone() {
+  for (auto& popup : S().popups) popup->Close();
+}
+
+}  // namespace agens::bridge::extension
