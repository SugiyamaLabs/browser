+@implementation AgensHistoryView {
+  NSScrollView* _scroll;
+  AgensFlippedView* _doc;
+  NSTextField* _heading;
+  NSSearchField* _search;
+  NSButton* _clear;
+  NSMutableArray<NSView*>* _items;  // day labels, lines and rows
+  NSTextField* _note;
+  std::vector<std::tuple<std::string, std::string, double>> _visits;  // url, title, time
+}
+@synthesize engine = _engine;
+@synthesize onOpen = _onOpen;
+@synthesize onClear = _onClear;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    self.layer.cornerRadius = 11;
+    self.layer.masksToBounds = YES;
