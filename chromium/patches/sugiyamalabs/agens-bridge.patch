+- (void)refresh {
+  [super refresh];
+  if (self.icon.image) self.layer.cornerRadius = NSHeight(self.bounds) / 2;  // the round bubble
+  if (_primary) {
+    NSColor* hover = IsDark(self.effectiveAppearance) ? NSColor.whiteColor : NSColor.blackColor;
