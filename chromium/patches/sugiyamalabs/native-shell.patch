+// One download in the panel: file name, size or state, a progress line while it runs, and
+// buttons to show it in the Finder or cancel it.
+@interface AgensDownloadRow : AgensHoverView
+@property(nonatomic, copy) void (^onShow)(void);
+@property(nonatomic, copy) void (^onCancel)(void);
+- (void)updateWith:(const AgensDownload&)d;
+@end
+@implementation AgensDownloadRow {
+  NSImageView* _icon;
+  NSTextField* _name;
+  NSTextField* _detail;
+  NSView* _track;
+  NSView* _bar;
+  NSButton* _show;
+  NSButton* _cancel;
+  double _fraction;
+}
+@synthesize onShow = _onShow;
+@synthesize onCancel = _onCancel;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.layer.cornerRadius = 7;
+    _icon = [NSImageView imageViewWithImage:AgensIcon(kIconDown)];
+    _icon.contentTintColor = kDim.color();
+    _name = Label(13, NSFontWeightRegular, kInk);
+    _detail = Label(11.5, NSFontWeightRegular, kDim);
+    _track = [[NSView alloc] init];
+    _bar = [[NSView alloc] init];
+    for (NSView* v in @[ _track, _bar ]) {
+      v.wantsLayer = YES;
+      v.layer.cornerRadius = 1.5;
+    }
+    _show = [NSButton buttonWithImage:Symbol(@"magnifyingglass", 12) target:self action:@selector(show:)];
+    _show.toolTip = @"Mostrar no Finder";
+    _show.accessibilityLabel = @"Mostrar no Finder";
+    _cancel = [NSButton buttonWithImage:Symbol(@"xmark", 11) target:self action:@selector(cancel:)];
+    _cancel.toolTip = @"Cancelar";
+    _cancel.accessibilityLabel = @"Cancelar download";
+    for (NSButton* b in @[ _show, _cancel ]) {
+      b.bordered = NO;
+      b.contentTintColor = kDim.color();
+    }
+    for (NSView* v in @[ _icon, _name, _detail, _track, _bar, _show, _cancel ]) [self addSubview:v];
+  }
+  return self;
+}
+- (void)layout {
+  [super layout];
+  CGFloat w = NSWidth(self.bounds);
+  _icon.frame = NSMakeRect(10, 13, 17, 17);
+  _cancel.frame = NSMakeRect(w - 30, 12, 22, 20);
+  _show.frame = NSMakeRect(w - (_cancel.hidden ? 30 : 54), 12, 22, 20);
+  CGFloat textW = NSMinX(_show.frame) - 6 - 37;
+  _name.frame = NSMakeRect(37, 6, textW, 17);
+  _detail.frame = NSMakeRect(37, 23, textW, 15);
+  _track.frame = NSMakeRect(37, 38, textW, 3);
+  _bar.frame = NSMakeRect(37, 38, textW * _fraction, 3);
+}
+static NSString* Bytes(long long n) {
+  return [NSByteCountFormatter stringFromByteCount:n countStyle:NSByteCountFormatterCountStyleFile];
+}
+- (void)updateWith:(const AgensDownload&)d {
+  _name.stringValue = @(d.name);
+  BOOL running = d.state == kAgensDownloading;
+  _fraction = running && d.total > 0 ? (double)d.received / d.total : 0;
+  switch (d.state) {
+    case kAgensDownloading:
+      _detail.stringValue = d.paused ? @"Pausado"
+                            : d.total > 0 ? [NSString stringWithFormat:@"%@ de %@", Bytes(d.received), Bytes(d.total)]
+                                          : Bytes(d.received);
+      break;
+    case kAgensDownloaded: _detail.stringValue = Bytes(d.total ?: d.received); break;
+    case kAgensDownloadCancelled: _detail.stringValue = @"Cancelado"; break;
+    case kAgensDownloadFailed: _detail.stringValue = @"Falhou"; break;
+  }
+  _track.hidden = _bar.hidden = !running;
+  _cancel.hidden = !running;
+  _show.hidden = d.state != kAgensDownloaded;
+  self.accessibilityLabel = [NSString stringWithFormat:@"%@, %@", _name.stringValue, _detail.stringValue];
+  [self refresh];
+  self.needsLayout = YES;
+}
+- (void)refresh {
+  self.layer.backgroundColor = self.hovered ? CG(kRaise, self) : NSColor.clearColor.CGColor;
+  _track.layer.backgroundColor = CG(kLine, self);
+  _bar.layer.backgroundColor = CG(kLight3, self);
