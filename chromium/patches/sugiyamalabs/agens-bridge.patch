+static NSString* Bytes(long long n) {
+  return [NSByteCountFormatter stringFromByteCount:n countStyle:NSByteCountFormatterCountStyleFile];
+}
+// "18,2 de 48 MB": the first number in the second one's unit, without repeating it.
+static NSString* BytesOf(long long part, long long whole) {
+  NSByteCountFormatter* f = [[NSByteCountFormatter alloc] init];
+  f.countStyle = NSByteCountFormatterCountStyleFile;
+  f.allowedUnits = whole >= 1000000000 ? NSByteCountFormatterUseGB
+                   : whole >= 1000000  ? NSByteCountFormatterUseMB
+                   : whole >= 1000     ? NSByteCountFormatterUseKB
+                                       : NSByteCountFormatterUseBytes;
+  NSString* total = [f stringFromByteCount:whole];
+  f.includesUnit = NO;
+  return [NSString stringWithFormat:@"%@ de %@", [f stringFromByteCount:part], total];
+}
+static NSString* ShortDuration(int s) {
+  return s < 60 ? [NSString stringWithFormat:@"%d s", s] : s < 3600 ? [NSString stringWithFormat:@"%d min", (s + 30) / 60]
+                                                                    : [NSString stringWithFormat:@"%d h", (s + 1800) / 3600];
+}
+static NSString* Ago(double end) {
+  const int s = (int)MAX(0, NSDate.date.timeIntervalSince1970 - end);
+  return s < 60 ? @"agora" : [@"há " stringByAppendingString:ShortDuration(s)];
+}
+// Why it failed, short (Chromium's DownloadInterruptReason).
+static NSString* FailReason(const AgensDownload& d) {
+  const int r = d.interrupt_reason;
+  if (r >= 20 && r < 30) {
+    return d.total > 0 ? [NSString stringWithFormat:@"a rede caiu em %d%%", (int)(100.0 * d.received / d.total)] : @"a rede caiu";
+  }
+  if (r >= 30 && r < 40) return @"o site não entregou o arquivo";
+  if (r == 3) return @"o disco está cheio";
+  if (r == 2) return @"sem permissão para gravar na pasta";
+  if (r == 41 || r == 50) return @"o navegador fechou antes do fim";
+  if (r == 7 || r == 11 || r == 12 || r == 51) return @"o sistema bloqueou o arquivo";
+  return @"erro ao gravar o arquivo";
+}
