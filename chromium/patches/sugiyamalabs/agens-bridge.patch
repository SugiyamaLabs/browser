+// Another ato's logins without loading it (that would start its extensions' renderers): its
+// "Login Data" opened, read or changed, and closed again in one background task. The database
+// is opened with exclusive locking, so it is never held open.
+// shortcut: an ato that loads during those few ms can fail to open its store for the session;
+// upgrade by loading only the store if that ever shows up.
+struct DiskLogins {
+  static std::map<std::string, std::vector<password_manager::StoredCredential>>& Cache() {
+    static base::NoDestructor<std::map<std::string, std::vector<password_manager::StoredCredential>>> cache;
+    return *cache;
+  }
+  static void WithDb(const base::FilePath& ato_path,
+                     base::OnceCallback<std::vector<password_manager::StoredCredential>(password_manager::LoginDatabase&)> work,
+                     base::OnceCallback<void(std::vector<password_manager::StoredCredential>)> done) {
+    g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+        [](base::FilePath path,
+           base::OnceCallback<std::vector<password_manager::StoredCredential>(password_manager::LoginDatabase&)> work,
+           base::OnceCallback<void(std::vector<password_manager::StoredCredential>)> done,
+           scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+          base::ThreadPool::PostTaskAndReplyWithResult(
+              FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+              base::BindOnce(
+                  [](base::FilePath path,
+                     base::OnceCallback<std::vector<password_manager::StoredCredential>(password_manager::LoginDatabase&)> work,
+                     scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+                    const base::FilePath file = path.Append(password_manager::kLoginDataForProfileFileName);
+                    if (!base::PathExists(file)) return std::vector<password_manager::StoredCredential>();
+                    // Never drops what it can't decrypt: that is the ato's own store's call.
+                    password_manager::LoginDatabase db(
+                        file, password_manager::IsAccountStore(false),
+                        password_manager::LoginDatabase::DeletingUndecryptablePasswordsEnabled(false));
+                    if (!db.Init(base::DoNothing(), std::move(encryptor))) {
+                      return std::vector<password_manager::StoredCredential>();
+                    }
+                    return std::move(work).Run(db);
