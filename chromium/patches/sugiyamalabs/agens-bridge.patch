+// host.settings' site_requests on every ato, also those loaded later: the default for geolocation
+// and notifications, ask or block. It overwrites what the standalone shell set per ato.
+class SiteRequests : public ProfileManagerObserver {
+ public:
+  void Start() {
+    if (!prefs_.IsEmpty()) return;
+    prefs_.Init(g_browser_process->local_state());
+    prefs_.Add(kSiteRequestsPref, base::BindRepeating(&SiteRequests::ApplyAll, base::Unretained(this)));
+    if (ProfileManager* manager = g_browser_process->profile_manager()) manager_observation_.Observe(manager);
+    ApplyAll();
+  }
+
+ private:
+  void ApplyAll() {
+    if (ProfileManager* manager = g_browser_process->profile_manager()) {
+      for (Profile* profile : manager->GetLoadedProfiles()) Apply(profile);
+    }
+  }
+  static void Apply(Profile* profile) {
+    if (profile->IsOffTheRecord()) return;
+    const ContentSetting value =
+        g_browser_process->local_state()->GetBoolean(kSiteRequestsPref) ? CONTENT_SETTING_ASK : CONTENT_SETTING_BLOCK;
+    HostContentSettingsMap* map = HostContentSettingsMapFactory::GetForProfile(profile);
+    for (ContentSettingsType type : {ContentSettingsType::GEOLOCATION, ContentSettingsType::NOTIFICATIONS}) {
+      map->SetDefaultContentSetting(type, value);
+    }
+  }
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override { Apply(profile); }
+  void OnProfileManagerDestroying() override { manager_observation_.Reset(); }
+
+  PrefChangeRegistrar prefs_;
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver> manager_observation_{this};
+};
+SiteRequests& TheSiteRequests() {
+  static base::NoDestructor<SiteRequests> site_requests;
+  return *site_requests;
+}
