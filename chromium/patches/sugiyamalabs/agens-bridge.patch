+// Copyright 2026 SugiyamaLabs.
+// - Into another ato, an extension goes as the first ato has it, without the network: a copy of
+//   its installed folder through CrxInstaller (store and .crx), or the same unpacked folder.
+// - What a sleeping ato has is kept in Local State with the ato's extras ("extensions"), written
+//   each time it is awake and its list changes.
+
+#include "chrome/browser/agens/embed/agens_extensions.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <utility>
+
+#include "base/barrier_closure.h"
+#include "base/files/file_util.h"
+#include "base/no_destructor.h"
+#include "base/observer_list.h"
+#include "base/one_shot_event.h"
+#include "base/scoped_observation.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/extensions/extension_action_dispatcher.h"
+#include "chrome/browser/extensions/extension_install_prompt.h"
