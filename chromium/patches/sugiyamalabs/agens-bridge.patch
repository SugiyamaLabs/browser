+struct State : public TabStripModelObserver {
+  uint64_t host = 0;
+  std::vector<raw_ptr<AgensWindow>> windows;
+  std::vector<std::unique_ptr<Shown>> shown;
+  std::vector<raw_ptr<content::WebContents>> views;  // AddView: extension popups, DevTools frontends
+  std::vector<std::unique_ptr<DevToolsOf>> devtools;
+  std::string last_dock = "window";  // the side the host used last: where an inspect with none opens
+  std::string next_dock;              // set around the call that makes a DevTools (Inspect)
+  std::map<int, base::DictValue> sent;  // the last view.tab of each tab the host knows
+  std::map<int, gfx::Image> icons;      // the favicon it was told about
+  std::map<int, base::DictValue> agent_cursors;  // the last view.agent_cursor; none sent: no cursor
+  bool flush_pending = false;
+  // The approval on the host (one at a time, approval.cc keeps the queue).
+  int next_ask = 0;
+  std::string ask;
+  bool ask_offers_always = false;
+  ApprovalCallback answer;
+  std::string event_data;  // input ops decode here: no allocation per mouse move
+
+  void Schedule();
+  // TabStripModelObserver (every window's):
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&, const TabStripSelectionChange&) override {
+    Schedule();
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override {
+    EndAgentPicks();
+    Schedule();
+  }
+  // A tab's marks change through here too (control_ops.cc): an agent at work ends its picker.
+  void EndAgentPicks();
+};
+State& S() {
+  static base::NoDestructor<State> state;
+  return *state;
+}
