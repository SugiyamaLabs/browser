+  }
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = title;
+  alert.informativeText = detail;
+  // Return answers Não permitir: the sheet comes up while the person may be typing elsewhere.
+  [alert addButtonWithTitle:@"Permitir"].keyEquivalent = @"";
+  if (offerAlways) [alert addButtonWithTitle:@"Permitir sempre"];
+  [alert addButtonWithTitle:@"Não permitir"].keyEquivalent = @"\r";
+  __weak AgensChrome* weak = self;
+  [alert beginSheetModalForWindow:self.window completionHandler:^(NSModalResponse r) {
+    AgensChrome* strong = weak;
+    // No window to answer through: it closed, and closing it already answered Não permitir
+    // (~AgensWindow posts the deny).
+    if (!strong || !strong->_window) return;
+    agens_window_approval_answer(strong->_window, r == NSAlertFirstButtonReturn                ? kAgensApprovalAllow
