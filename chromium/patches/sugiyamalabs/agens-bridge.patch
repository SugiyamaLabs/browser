+namespace {
+
+using extensions::Extension;
+using extensions::ExtensionRegistry;
+
+constexpr char kWhereKey[] = "extensions";  // in the ato's extras (AgensWindow::kAtosPref)
+
+base::ObserverList<Observer>& Observers() {
+  static base::NoDestructor<base::ObserverList<Observer>> observers;
+  return *observers;
+}
+
+void Tell(Profile* profile, const std::string& id, std::string_view change) {
+  for (ext::Observer& o : Observers()) o.OnExtensionChanged(profile, id, change);
+}
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+// The ato's extensions as last written (a sleeping ato's only source).
+const base::ListValue* Recorded(const std::string& ato) {
+  const base::DictValue* extras = g_browser_process->local_state()->GetDict(AgensWindow::kAtosPref).FindDict(ato);
+  return extras ? extras->FindList(kWhereKey) : nullptr;
+}
+
+void Record(Profile* profile) {
+  base::ListValue ids;
+  for (const auto& e : ExtensionRegistry::Get(profile)->GenerateInstalledExtensionsSet()) {
+    if (Listed(*e)) ids.Append(e->id());
+  }
+  const std::string ato = AtoId(profile);
+  if (const base::ListValue* old = Recorded(ato); old && *old == ids) return;
+  if (!FindAto(ato)) return;  // an ato being deleted keeps no extras
+  ScopedDictPrefUpdate update(g_browser_process->local_state(), AgensWindow::kAtosPref);
+  update->EnsureDict(ato)->Set(kWhereKey, std::move(ids));
+}
+
+struct FanOut {
+  base::FilePath from;  // the asking ato's folder
+  std::string id;
+  std::vector<std::string> atos;
+};
+std::vector<FanOut>& FanOuts() {
+  static base::NoDestructor<std::vector<FanOut>> fan_outs;
+  return *fan_outs;
+}
+
+// Into an ato that may be asleep: loads it, then `then(profile)` (null when it could not load).
+void WithAto(const std::string& ato, base::OnceCallback<void(Profile*)> then) {
+  ProfileAttributesEntry* entry = FindAto(ato);
+  if (!entry) return std::move(then).Run(nullptr);
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (Profile* loaded = manager->GetProfileByPath(entry->GetPath())) return std::move(then).Run(loaded);
+  // The callback runs once in every case, with null when loading fails.
+  manager->LoadProfileByPath(entry->GetPath(), /*incognito=*/false, std::move(then));
+}
+
+// Unpacked extensions are disabled unless the ato is in developer mode
+// (ExtensionManagement::IsAllowedByUnpackedDeveloperModePolicy): adding a folder turns it on.
+void LoadUnpacked(Profile* profile, const base::FilePath& dir, extensions::UnpackedInstaller::CompletionCallback done) {
+  profile->GetPrefs()->SetBoolean(prefs::kExtensionsUIDeveloperMode, true);
+  scoped_refptr<extensions::UnpackedInstaller> installer = extensions::UnpackedInstaller::Create(profile);
+  installer->set_be_noisy_on_failure(false);  // no error dialog: the caller says what happened
+  installer->set_completion_callback(std::move(done));
+  installer->Load(dir);
+}
+
+// `e` as `from` has it, into `profile` (an ato that does not have it yet).
+void InstallCopy(scoped_refptr<const Extension> e, Profile* profile) {
+  if (!profile || ExtensionRegistry::Get(profile)->GetInstalledExtension(e->id())) return;
+  std::unique_ptr<ScopedProfileKeepAlive> keep =
+      ScopedProfileKeepAlive::TryAcquire(profile, ProfileKeepAliveOrigin::kCrxInstaller);
+  if (!keep) return;
+  if (e->location() == extensions::mojom::ManifestLocation::kUnpacked) {
+    LoadUnpacked(profile, e->path(),
+                 base::BindOnce([](std::unique_ptr<ScopedProfileKeepAlive>, const Extension*, const base::FilePath&,
+                                   const std::u16string&) {},
+                                std::move(keep)));
+    return;
+  }
+  // The installed folder, copied: the installer moves what it gets into the ato's own folder.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath source) {
+            base::FilePath temp;
+            if (!base::CreateNewTempDirectory("agens-ext", &temp)) return base::FilePath();
+            const base::FilePath copy = temp.AppendASCII("x");
+            return base::CopyDirectory(source, copy, /*recursive=*/true) ? copy : base::FilePath();
+          },
+          e->path()),
+      base::BindOnce(
+          [](scoped_refptr<const Extension> e, Profile* profile, std::unique_ptr<ScopedProfileKeepAlive>,
+             base::FilePath copy) {
+            if (copy.empty()) return;
+            scoped_refptr<extensions::CrxInstaller> installer = extensions::CrxInstaller::CreateSilent(profile);
+            installer->set_install_source(e->location());
+            installer->set_creation_flags(e->creation_flags());
+            installer->set_off_store_install_allow_reason(
+                extensions::CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+            installer->set_delete_source(true);
+            installer->InstallUnpackedCrx(e->id(), e->public_key(), copy);
+          },
+          e, profile, std::move(keep)));
+}
+
+// One loaded ato's extensions and actions, until it goes.
+class AtoWatch : public extensions::ExtensionRegistryObserver,
+                 public extensions::ExtensionActionDispatcher::Observer,
+                 public ProfileObserver {
+ public:
+  explicit AtoWatch(Profile* profile) : profile_(profile) {
+    registry_.Observe(ExtensionRegistry::Get(profile));
+    dispatcher_ = extensions::ExtensionActionDispatcher::Get(profile);
+    if (dispatcher_) dispatcher_->AddObserver(this);
+    profile_observation_.Observe(profile);
+    // An ato just loading has none loaded yet: its record is rewritten only once they are.
+    extensions::ExtensionSystem::Get(profile)->ready().Post(
+        FROM_HERE, base::BindOnce([](base::WeakPtr<AtoWatch> self) {
+          if (self) Record(self->profile_);
+        }, weak_.GetWeakPtr()));
+  }
+  ~AtoWatch() override {
+    if (dispatcher_) dispatcher_->RemoveObserver(this);
+  }
+  Profile* profile() const { return profile_; }
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionInstalled(content::BrowserContext*, const Extension* e, bool is_update) override {
+    if (!Listed(*e)) return;
+    Record(profile_);
+    Tell(profile_, e->id(), is_update ? "updated" : "installed");
+    if (is_update) return;
+    const base::FilePath from = profile_->GetPath();
+    auto& fan_outs = FanOuts();
+    for (auto it = fan_outs.begin(); it != fan_outs.end();) {
+      if (it->from != from || it->id != e->id()) {
+        ++it;
+        continue;
+      }
+      for (const std::string& ato : it->atos) {
+        WithAto(ato, base::BindOnce(&InstallCopy, base::WrapRefCounted(e)));
+      }
+      it = fan_outs.erase(it);
+    }
+  }
+  void OnExtensionUninstalled(content::BrowserContext*, const Extension* e, extensions::UninstallReason) override {
+    if (!Listed(*e)) return;
+    Record(profile_);
+    // Unpinned with it: installed again later, it starts in the menu.
+    SetPinned(profile_, e->id(), false);
+    Tell(profile_, e->id(), "removed");
+  }
+  void OnExtensionLoaded(content::BrowserContext*, const Extension* e) override {
+    if (Listed(*e) && extensions::ExtensionSystem::Get(profile_)->ready().is_signaled()) Record(profile_);
+  }
+  void OnExtensionEnabled(content::BrowserContext*, const Extension* e) override {
+    if (Listed(*e)) Tell(profile_, e->id(), "enabled");
+  }
+  void OnExtensionUnloaded(content::BrowserContext*, const Extension* e, extensions::UnloadedExtensionReason reason) override {
+    if (Listed(*e) && reason == extensions::UnloadedExtensionReason::DISABLE) Tell(profile_, e->id(), "disabled");
+  }
+  void OnShutdown(ExtensionRegistry*) override { registry_.Reset(); }
+
+  // extensions::ExtensionActionDispatcher::Observer:
+  void OnExtensionActionUpdated(extensions::ExtensionAction* action,
+                                content::WebContents* contents,
+                                content::BrowserContext* context) override {
+    if (context != profile_) return;  // its incognito twin shares the dispatcher
+    for (ext::Observer& o : Observers()) o.OnExtensionActionChanged(profile_, action->extension_id(), contents);
+  }
+  void OnShuttingDown() override {
+    dispatcher_->RemoveObserver(this);
+    dispatcher_ = nullptr;
+  }
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile*) override;
+
+ private:
+  raw_ptr<Profile> profile_;
+  raw_ptr<extensions::ExtensionActionDispatcher> dispatcher_ = nullptr;
+  base::ScopedObservation<ExtensionRegistry, extensions::ExtensionRegistryObserver> registry_{this};
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::WeakPtrFactory<AtoWatch> weak_{this};
+};
+
+class Hub : public ProfileManagerObserver {
+ public:
+  void Start() {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (started_ || !manager) return;
+    started_ = true;
+    manager_observation_.Observe(manager);
+    for (Profile* profile : manager->GetLoadedProfiles()) Watch(profile);
+  }
+  void Forget(AtoWatch* watch) {
+    std::erase_if(watches_, [watch](const std::unique_ptr<AtoWatch>& w) { return w.get() == watch; });
+  }
+
+ private:
+  void Watch(Profile* profile) {
+    if (profile->IsOffTheRecord() || profile->IsSystemProfile()) return;
+    if (std::ranges::any_of(watches_, [profile](const auto& w) { return w->profile() == profile; })) return;
+    watches_.push_back(std::make_unique<AtoWatch>(profile));
+  }
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override { Watch(profile); }
+  void OnProfileManagerDestroying() override { manager_observation_.Reset(); }
+
+  bool started_ = false;
+  std::vector<std::unique_ptr<AtoWatch>> watches_;
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver> manager_observation_{this};
+};
+Hub& TheHub() {
+  static base::NoDestructor<Hub> hub;
+  return *hub;
+}
+
+void AtoWatch::OnProfileWillBeDestroyed(Profile*) {
+  profile_observation_.Reset();
+  registry_.Reset();
+  TheHub().Forget(this);  // deletes this
+}
+
+const Extension* Installed(Profile* profile, const std::string& id) {
+  return ExtensionRegistry::Get(profile)->GetInstalledExtension(id);
+}
+
+// "denied" when the person said no, else "failed".
+std::string ErrorFor(const extensions::CrxInstallError& error) {
+  using Detail = extensions::CrxInstallErrorDetail;
+  return error.detail() == Detail::USER_CANCELED || error.detail() == Detail::USER_ABORTED ? "denied" : "failed";
+}
+
+// A folder: read it here (off the UI thread), ask the person, then load it.
+void InstallFolder(Profile* profile, const base::FilePath& dir, gfx::NativeWindow parent, InstallDone done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath dir) -> scoped_refptr<Extension> {
+            std::u16string error;
+            return extensions::file_util::LoadExtension(dir, extensions::mojom::ManifestLocation::kUnpacked,
+                                                        Extension::FOLLOW_SYMLINKS_ANYWHERE, &error);
+          },
+          dir),
+      base::BindOnce(
+          [](base::WeakPtr<Profile> profile, base::FilePath dir, gfx::NativeWindow parent, InstallDone done,
+             scoped_refptr<Extension> extension) {
+            if (!profile || !extension || !Listed(*extension)) return std::move(done).Run(std::string(), "failed");
+            auto prompt = std::make_unique<ExtensionInstallPrompt>(
+                profile.get(), parent,
+                std::make_unique<extensions::InstallPromptData>(extensions::InstallPromptData::INSTALL_PROMPT));
+            ExtensionInstallPrompt* raw = prompt.get();
+            raw->ShowDialog(
+                base::BindOnce(
+                    [](std::unique_ptr<ExtensionInstallPrompt>, base::WeakPtr<Profile> profile, base::FilePath dir,
+                       InstallDone done, ExtensionInstallPrompt::DoneCallbackPayload payload) {
+                      if (payload.result != ExtensionInstallPrompt::Result::ACCEPTED) {
+                        return std::move(done).Run(std::string(), "denied");
+                      }
+                      if (!profile) return std::move(done).Run(std::string(), "failed");
+                      LoadUnpacked(profile.get(), dir,
+                                   base::BindOnce(
+                                       [](InstallDone done, const Extension* e, const base::FilePath&,
+                                          const std::u16string&) {
+                                         std::move(done).Run(e ? e->id() : std::string(), e ? "" : "failed");
+                                       },
+                                       std::move(done)));
+                    },
+                    std::move(prompt), profile, dir, std::move(done)),
+                extension.get(), /*icon=*/nullptr, ExtensionInstallPrompt::GetDefaultShowDialogCallback());
+          },
+          profile->GetWeakPtr(), dir, parent, std::move(done)));
+}
+
+}  // namespace
+
+void Start() {
+  TheHub().Start();
+}
+
+void AddObserver(Observer* observer) {
+  Observers().AddObserver(observer);
+}
+void RemoveObserver(Observer* observer) {
+  Observers().RemoveObserver(observer);
+}
+
+std::string AtoId(Profile* profile) {
+  return profile->GetOriginalProfile()->GetPath().BaseName().AsUTF8Unsafe();
+}
+
+bool Listed(const Extension& extension) {
+  return extensions::ui_util::ShouldDisplayInExtensionSettings(extension);
+}
+
+std::string From(const Extension& extension) {
+  if (extension.location() == extensions::mojom::ManifestLocation::kUnpacked) return "folder";
+  return extension.from_webstore() ? "store" : "file";
+}
+
+std::vector<std::string> AtosWith(const std::string& id) {
+  std::vector<std::string> atos;
+  ProfileManager* manager = g_browser_process->profile_manager();
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    const std::string ato = entry->GetPath().BaseName().AsUTF8Unsafe();
+    const base::ListValue* recorded = Recorded(ato);
+    Profile* loaded = manager->GetProfileByPath(entry->GetPath());
+    if (loaded ? !!Installed(loaded, id) : recorded && recorded->contains(id)) atos.push_back(ato);
+  }
+  return atos;
+}
+
+base::ListValue AtoChoices(const std::string& id) {
+  const std::vector<std::string> with = AtosWith(id);
+  const std::vector<ProfileAttributesEntry*> entries = AgensWindow::Atos();
+  base::ListValue atos;
+  for (size_t i = 0; i < entries.size(); ++i) {
+    base::DictValue ato;
+    const std::string ato_id = entries[i]->GetPath().BaseName().AsUTF8Unsafe();
+    ato.Set("id", ato_id);
+    ato.Set("name", AgensWindow::AtoName(entries[i]));
+    ato.Set("color", AgensWindow::kAtoColors[AgensWindow::AtoColor(entries[i], static_cast<int>(i))]);
+    ato.Set("installed", std::ranges::contains(with, ato_id));
+    atos.Append(std::move(ato));
+  }
+  return atos;
+}
+
+void AlsoInstallInto(Profile* asking, const std::string& id, std::vector<std::string> atos) {
+  const std::string self = AtoId(asking);
+  std::erase_if(atos, [&](const std::string& ato) { return ato == self || !FindAto(ato); });
+  if (atos.empty()) return;
+  auto& fan_outs = FanOuts();
+  std::erase_if(fan_outs, [&](const FanOut& f) { return f.from == asking->GetPath() && f.id == id; });
+  // shortcut: a prompt allowed whose install then fails leaves its entry here until the next try
+  // of the same extension in that ato; the list stays tiny.
+  fan_outs.push_back({asking->GetOriginalProfile()->GetPath(), id, std::move(atos)});
+}
+
+void InstallFromDisk(Profile* profile, const base::FilePath& path, gfx::NativeWindow parent, InstallDone done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()}, base::BindOnce(&base::DirectoryExists, path),
+      base::BindOnce(
+          [](base::WeakPtr<Profile> profile, base::FilePath path, gfx::NativeWindow parent, InstallDone done,
+             bool folder) {
+            if (!profile) return std::move(done).Run(std::string(), "failed");
+            if (folder) return InstallFolder(profile.get(), path, parent, std::move(done));
+            // CrxInstaller sets the prompt's type itself.
+            auto prompt = std::make_unique<ExtensionInstallPrompt>(
+                profile.get(), parent,
+                std::make_unique<extensions::InstallPromptData>(extensions::InstallPromptData::UNSET_PROMPT_TYPE));
+            prompt->SetSkipPostInstallUI(true);  // no Views error bubble or infobar: `done` says it
+            scoped_refptr<extensions::CrxInstaller> installer =
+                extensions::CrxInstaller::Create(profile.get(), std::move(prompt));
+            // The person picked the file, as on chrome://extensions: allowed off the store.
+            installer->set_off_store_install_allow_reason(
+                extensions::CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+            installer->AddInstallerCallback(base::BindOnce(
+                [](scoped_refptr<extensions::CrxInstaller> installer, InstallDone done,
+                   const std::optional<extensions::CrxInstallError>& error) {
+                  if (error) return std::move(done).Run(std::string(), ErrorFor(*error));
+                  const Extension* e = installer->extension();
+                  std::move(done).Run(e ? e->id() : std::string(), e ? "" : "failed");
+                },
+                installer, std::move(done)));
+            installer->InstallCrx(path);
+          },
+          profile->GetWeakPtr(), path, parent, std::move(done)));
+}
+
+// `id` by value: uninstalling from this ato frees the extension the caller's reference may point into.
+void Remove(Profile* profile, std::string id, bool all, base::OnceClosure done) {
+  auto uninstall = [](std::string id, base::OnceClosure done, Profile* profile) {
+    if (profile && Installed(profile, id)) {
+      std::u16string error;
+      extensions::ExtensionRegistrar::Get(profile)->UninstallExtension(
+          id, extensions::UNINSTALL_REASON_USER_INITIATED, &error);
+    }
+    std::move(done).Run();
+  };
+  if (!all) return uninstall(id, std::move(done), profile);
+  const std::vector<std::string> atos = AtosWith(id);
+  base::RepeatingClosure each = base::BarrierClosure(atos.size(), std::move(done));
+  for (const std::string& ato : atos) WithAto(ato, base::BindOnce(uninstall, id, each));
+}
+
+bool Pinned(Profile* profile, const std::string& id) {
+  return std::ranges::contains(extensions::ExtensionPrefs::Get(profile)->GetPinnedExtensions(), id);
+}
+
+void SetPinned(Profile* profile, const std::string& id, bool pinned) {
+  extensions::ExtensionPrefs* prefs = extensions::ExtensionPrefs::Get(profile);
+  extensions::ExtensionIdList ids = prefs->GetPinnedExtensions();
+  if (std::ranges::contains(ids, id) == pinned) return;
+  if (pinned) {
+    ids.push_back(id);
+  } else {
+    std::erase(ids, id);
+  }
+  prefs->SetPinnedExtensions(ids);
+  Tell(profile, id, "pinned");
+}
+
+std::vector<uint8_t> EncodePng(const gfx::Image& image, float scale) {
+  if (image.IsEmpty()) return {};
+  const SkBitmap& bitmap = image.AsImageSkia().GetRepresentation(scale).GetBitmap();
+  return gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false).value_or(std::vector<uint8_t>());
+}
+
+std::vector<uint8_t> SetIcon(Profile* profile, const Extension& extension, int tab_id) {
+  extensions::ExtensionAction* action = extensions::ExtensionActionManager::Get(profile)->GetExtensionAction(extension);
+  if (!action) return {};
+  for (const gfx::Image& set : {action->GetExplicitlySetIcon(tab_id), action->GetDeclarativeIcon(tab_id)}) {
+    if (std::vector<uint8_t> png = EncodePng(set); !png.empty()) return png;
+  }
+  return {};
+}
+
+void LoadIcon(Profile* profile,
+              const Extension& extension,
+              bool of_action,
+              base::OnceCallback<void(std::vector<uint8_t> png)> done) {
+  extensions::ExtensionAction* action =
