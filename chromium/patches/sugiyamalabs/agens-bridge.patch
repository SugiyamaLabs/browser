+// While the active tab shares (prototype .sharebar): flush at the page's foot, a pulsing dot,
+// "Compartilhando <x> com <site>", Trocar and Parar.
+@interface AgensShareBar : AgensFlippedView
+@property(nonatomic, copy) void (^onSwitch)(void);
+@property(nonatomic, copy) void (^onStop)(void);
+- (void)setWhat:(NSString*)what site:(NSString*)site canSwitch:(BOOL)canSwitch;
+- (CGFloat)fittingWidth;
+- (void)refresh;
+@end
+@implementation AgensShareBar {
+  CALayer* _dot;
+  NSTextField* _text;
+  AgensPillButton* _switch;
+  AgensPillButton* _stop;
+}
+@synthesize onSwitch = _onSwitch;
+@synthesize onStop = _onStop;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    self.layer.borderWidth = 1;
+    self.layer.shadowOpacity = 0.35;
+    self.layer.shadowRadius = 9;
+    self.layer.shadowOffset = CGSizeMake(0, -4);
+    self.accessibilityRole = NSAccessibilityGroupRole;
+    _dot = [CALayer layer];
+    _dot.cornerRadius = 3.5;
+    [self.layer addSublayer:_dot];
+    _text = Label(13, NSFontWeightRegular, kInk);
+    [self addSubview:_text];
+    __weak AgensShareBar* weak = self;
+    _switch = [[AgensPillButton alloc] init];
+    _switch.label.stringValue = @"Trocar";
+    _switch.onPress = ^{
+      AgensShareBar* strong = weak;
+      if (strong && strong->_onSwitch) strong->_onSwitch();
+    };
+    _stop = [[AgensPillButton alloc] init];
+    _stop.label.stringValue = @"Parar";
+    _stop.primary = YES;
+    _stop.onPress = ^{
+      AgensShareBar* strong = weak;
+      if (strong && strong->_onStop) strong->_onStop();
+    };
+    for (AgensPillButton* b in @[ _switch, _stop ]) {
+      b.radius = 8;
+      b.label.font = [NSFont systemFontOfSize:12.5 weight:b.primary ? NSFontWeightSemibold : NSFontWeightRegular];
+      [self addSubview:b];
+    }
+  }
+  return self;
+}
+- (void)setWhat:(NSString*)what site:(NSString*)site canSwitch:(BOOL)canSwitch {
+  NSMutableAttributedString* t = [[NSMutableAttributedString alloc]
+      initWithString:@"Compartilhando " attributes:@{NSFontAttributeName : [NSFont systemFontOfSize:13], NSForegroundColorAttributeName : kInk.color()}];
+  [t appendAttributedString:[[NSAttributedString alloc] initWithString:what
+                                                            attributes:@{NSFontAttributeName : [NSFont systemFontOfSize:13 weight:NSFontWeightSemibold],
+                                                                         NSForegroundColorAttributeName : kInk.color()}]];
+  if (site.length) {
+    [t appendAttributedString:[[NSAttributedString alloc] initWithString:[@" com " stringByAppendingString:site]
+                                                              attributes:@{NSFontAttributeName : [NSFont systemFontOfSize:12], NSForegroundColorAttributeName : kDim.color()}]];
+  }
+  _text.attributedStringValue = t;
+  self.accessibilityLabel = t.string;
+  _switch.hidden = !canSwitch;
+  [self refresh];
+}
+// Its width for the text it has; the bar centers itself in the page with it.
+- (CGFloat)fittingWidth {
+  CGFloat w = 12 + 7 + 8 + ceil(_text.fittingSize.width) + 10;
+  for (AgensPillButton* b in @[ _switch, _stop ]) {
+    if (!b.hidden) w += ceil(b.label.fittingSize.width) + 22 + 6;
+  }
+  return w;
+}
+- (void)layout {
+  [super layout];
+  const CGFloat h = NSHeight(self.bounds), W = NSWidth(self.bounds);
+  _dot.frame = CGRectMake(12, (h - 7) / 2, 7, 7);
+  CGFloat x = W - 6;
+  for (AgensPillButton* b in @[ _stop, _switch ]) {
+    if (b.hidden) continue;
+    const CGFloat bw = ceil(b.label.fittingSize.width) + 22;
+    x -= bw;
+    b.frame = NSMakeRect(x, 6, bw, h - 12);
+    x -= 6;
+  }
+  _text.frame = NSMakeRect(27, (h - 17) / 2, MAX(0, x - 4 - 27), 17);
+}
+- (void)refresh {
+  self.layer.cornerRadius = 12 * Round();
+  self.layer.backgroundColor = CG(kFloat, self);
+  self.layer.borderColor = CG(kLineStrong, self);
+  _dot.backgroundColor = CG(kLight3, self);
+  if (![_dot animationForKey:@"blink"] && !NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion) {
+    CABasicAnimation* blink = [CABasicAnimation animationWithKeyPath:@"opacity"];
+    blink.fromValue = @1;
+    blink.toValue = @0.35;
+    blink.duration = 0.8;
+    blink.autoreverses = YES;
+    blink.repeatCount = HUGE_VALF;
+    [_dot addAnimation:blink forKey:@"blink"];
+  }
+  [_switch refresh];
+  [_stop refresh];
+}
+@end
