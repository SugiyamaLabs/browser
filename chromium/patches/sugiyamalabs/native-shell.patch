diff --git a/chrome/browser/agens/embed/agens_embed.h b/chrome/browser/agens/embed/agens_embed.h
new file mode 100644
index 0000000000..7e2448fcf5
--- /dev/null
+++ b/chrome/browser/agens/embed/agens_embed.h
@@ -0,0 +1,89 @@
+// Copyright 2026 SugiyamaLabs.
+// The boundary between the engine and any interface (the browser's own chrome today, the Agens
+// app later). Plain C on purpose: no Chromium or C++ types cross it, Swift imports it as is, and
+// what sits under it (today Chromium's Webium window) can change without touching the UI.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_EMBED_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_EMBED_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// One browser window. Owned by the engine; valid until the UI's destroy hook runs.
+typedef struct AgensWindow AgensWindow;
+
+typedef struct {
+  const char* title;  // UTF-8, never null
+  const char* url;    // UTF-8, empty for the new tab page
+  const unsigned char* favicon_png;  // 32x32 PNG (2x), null when the page has none yet
+  int favicon_png_size;
+  int active;
+  int loading;
+  int sleeping;  // discarded to save memory; reloads when activated
+  int can_go_back;
+  int can_go_forward;
+} AgensTab;
+
+// Top-left origin, in points.
+typedef struct {
+  int x, y, width, height;
+} AgensRect;
+
+// Strings, icons and the array are only valid during the call; copy what you keep.
+typedef void (*AgensTabsChanged)(void* context, const AgensTab* tabs, int count);
+
+void agens_window_set_tabs_observer(AgensWindow* window, AgensTabsChanged observer, void* context);
+void agens_window_new_tab(AgensWindow* window);
+void agens_window_activate_tab(AgensWindow* window, int index);
+void agens_window_close_tab(AgensWindow* window, int index);
+// Address or search text, as typed; the engine decides which it is.
+void agens_window_navigate(AgensWindow* window, const char* text);
+void agens_window_back(AgensWindow* window);
+void agens_window_forward(AgensWindow* window);
+void agens_window_reload(AgensWindow* window);
+void agens_window_stop(AgensWindow* window);
+// Asks the engine to lay out and repaint again (after the UI changes size or colors, e.g.
+// light/dark mode).
+void agens_window_relayout(AgensWindow* window);
+
+// Address suggestions, from local sources only (history, bookmarks, the typed search); remote
+// search suggestions stay off. Call suggest on every edit, with "" to stop.
+typedef struct {
+  const char* text;    // what to show: the address or the search terms
+  const char* detail;  // page title, or empty for a search
+  int is_search;
+} AgensSuggestion;
+typedef void (*AgensSuggestionsChanged)(void* context, const AgensSuggestion* suggestions,
+                                        int count);
+void agens_window_set_suggestions_observer(AgensWindow* window, AgensSuggestionsChanged observer,
+                                           void* context);
+void agens_window_suggest(AgensWindow* window, const char* text);
+void agens_window_open_suggestion(AgensWindow* window, int index);
+
+// Atos: separate contexts with their own tabs, logins and cookies (one Chromium profile each).
+typedef struct {
+  const char* name;  // UTF-8
+  int active;        // this window's ato
+  int asleep;        // not loaded in memory right now
+} AgensAto;
+typedef void (*AgensAtosChanged)(void* context, const AgensAto* atos, int count);
+void agens_window_set_atos_observer(AgensWindow* window, AgensAtosChanged observer, void* context);
+// Opens that ato's window over this one (each ato keeps its own window and tabs).
+void agens_window_switch_ato(AgensWindow* window, int index);
+void agens_window_new_ato(AgensWindow* window);
+
+// Implemented by the interface. The chrome is a platform view (NSView* on macOS) the size of the
+// window, returned retained; it must let clicks through where the page sits. The engine puts the
+// page where agens_ui_layout says, and calls destroy when the window closes.
+void* agens_ui_create_chrome(AgensWindow* window);
+AgensRect agens_ui_layout(void* chrome, int width, int height);
+void agens_ui_focus_address(void* chrome);
+// Colors (0xRRGGBB) the engine paints behind the chrome: the window, the page card and its border.
+void agens_ui_colors(void* chrome, unsigned* window, unsigned* page, unsigned* line);
+void agens_ui_destroy_chrome(void* chrome);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_EMBED_H_
diff --git a/chrome/browser/agens/embed/native_shell.h b/chrome/browser/agens/embed/native_shell.h
