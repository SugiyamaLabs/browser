@@ -0,0 +1,70 @@
+// Copyright 2026 SugiyamaLabs.
+#include "chrome/browser/ui/webui/agens_light_pages.h"
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/ref_counted_memory.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/webui_config.h"
+#include "content/public/browser/webui_config_map.h"
+#include "content/public/common/url_constants.h"
+
+namespace {
+
+// No script, no Mojo: just a title and a background that follows the system theme.
+std::string Html(const std::string& title) {
+  return "<!doctype html><html><head><meta charset=\"utf-8\"><title>" + title +
+         "</title><meta name=\"color-scheme\" content=\"light dark\">"
+         "<style>:root{color-scheme:light dark}html,body{margin:0;background:Canvas}"
+         "</style></head><body></body></html>";
+}
+
+class LightController : public content::WebUIController {
+ public:
+  LightController(content::WebUI* web_ui, const std::string& host, const std::string& title)
+      : content::WebUIController(web_ui) {
+    auto* source = content::WebUIDataSource::CreateAndAdd(
+        web_ui->GetWebContents()->GetBrowserContext(), host);
+    source->SetRequestFilter(
+        base::BindRepeating([](const std::string&) { return true; }),
+        base::BindRepeating(
+            [](const std::string& html, const std::string&,
+               content::WebUIDataSource::GotDataCallback callback) {
+              std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(html));
+            },
+            Html(title)));
+  }
+};
+
+class LightConfig : public content::WebUIConfig {
+ public:
+  LightConfig(const char* host, const char* title)
+      : WebUIConfig(content::kChromeUIScheme, host), title_(title) {}
+
+  std::unique_ptr<content::WebUIController> CreateWebUIController(
+      content::WebUI* web_ui, const GURL& url) override {
+    return std::make_unique<LightController>(web_ui, host(), title_);
+  }
+
+ private:
+  std::string title_;
+};
+
+}  // namespace
+
+void RegisterAgensLightPageConfigs(content::WebUIConfigMap& map) {
+  // newtab covers incognito/guest; the other two are what chrome://newtab is rewritten to.
+  for (const char* host : {chrome::kChromeUINewTabHost, chrome::kChromeUINewTabPageHost,
+                           chrome::kChromeUINewTabPageThirdPartyHost}) {
+    map.AddWebUIConfig(std::make_unique<LightConfig>(host, "Nova aba"));
+  }
+  map.AddWebUIConfig(std::make_unique<LightConfig>(chrome::kChromeUIHistoryHost, "Histórico"));
+  map.AddWebUIConfig(std::make_unique<LightConfig>(chrome::kChromeUIBookmarksHost, "Favoritos"));
+}
