+// The ato with that profile folder name ("" or null: the window's own). `*loaded` is its profile
+// when loaded (the window's always is), else null and `*path` says where it lives.
+bool ResolveAto(AgensWindow* w, const char* ato, Profile** loaded, base::FilePath* path) {
+  Profile* own = w->browser->GetProfile()->GetOriginalProfile();
+  *loaded = nullptr;
+  if (!ato || !*ato || own->GetPath().BaseName().AsUTF8Unsafe() == ato) {
+    *loaded = own;
+    return true;
+  }
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() != ato) continue;
+    *path = entry->GetPath();
+    *loaded = g_browser_process->profile_manager()->GetProfileByPath(*path);
+    return true;
+  }
+  return false;
+}
