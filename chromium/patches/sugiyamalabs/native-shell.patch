+// Senhas salvas: search, then one row per login. Seeing or copying a password asks for Touch ID
+// (or the Mac's password), good for a minute.
+- (CGFloat)passwordsPage:(CGFloat)y {
+  if (!_loginsFresh && _browser) {
+    _loginsFresh = YES;
+    agens_passwords(_browser, LoginsListed, (__bridge void*)self);
+    return [self info:@"Carregando…" detail:nil note:@"" y:y];
+  }
+  if (!_loginSearch) {
+    _loginSearch = [[NSSearchField alloc] init];
+    _loginSearch.placeholderString = @"Buscar site ou usuário";
+    _loginSearch.target = self;
+    _loginSearch.action = @selector(searchLogins:);
+    _loginSearch.sendsSearchStringImmediately = YES;
+  }
+  _loginSearch.frame = NSMakeRect(32, y, NSWidth(_pane.bounds) - 64, 28);
+  [_pane addSubview:_loginSearch];
+  _loginsY = y + 40;
+  return [self fillLogins];
+}
+- (CGFloat)fillLogins {
+  for (NSView* v in [_pane.subviews copy]) {
+    if ([v.identifier isEqualToString:@"login"]) [v removeFromSuperview];
+  }
+  NSString* q = _loginSearch.stringValue.lowercaseString;
+  CGFloat y = _loginsY;
+  NSUInteger before = _pane.subviews.count;
+  if (_passwordStatus) y = [self info:_passwordStatus detail:nil note:@"" y:y];
+  if (_logins.empty()) {
+    y = [self info:@"Nenhuma senha salva neste ato" detail:@"Quando você salvar uma ao entrar num site, aparece aqui." note:@"" y:y];
+  }
+  for (size_t i = 0; i < _logins.size(); ++i) {
+    NSString* site = @(_logins[i].first.c_str());
+    NSString* user = _logins[i].second.empty() ? @"(sem usuário)" : @(_logins[i].second.c_str());
+    if (q.length && ![site.lowercaseString containsString:q] && ![user.lowercaseString containsString:q]) continue;
+    const BOOL shown = (int)i == _revealed;
+    NSView* box = [self buttons:@[
+      [self small:shown ? @"Esconder" : @"Ver" action:@selector(revealPassword:) tag:i],
+      [self small:@"Copiar" action:@selector(copyPassword:) tag:i],
+      [self small:@"Apagar…" action:@selector(confirmRemovePassword:) tag:i],
+    ]];
+    NSString* detail = shown ? [NSString stringWithFormat:@"%@ · %@", user, @(_revealedPassword.c_str())] : user;
+    y = [self option:site detail:detail control:box y:y];
+  }
+  for (NSUInteger k = before; k < _pane.subviews.count; ++k) _pane.subviews[k].identifier = @"login";
+  NSRect f = _pane.frame;
+  f.size.height = MAX(y + 40, NSHeight(_paneScroll.frame));
+  _pane.frame = f;
+  return y;
+}
+- (void)setLogins:(const AgensLogin*)logins count:(int)count {
+  _logins.clear();
+  for (int i = 0; i < count; ++i) _logins.emplace_back(logins[i].site, logins[i].username);
+  if ([_section isEqualToString:@"senhas-salvas"]) [self showSection:@"senhas-salvas"];
+}
+- (void)searchLogins:(NSSearchField*)field {
+  [self fillLogins];
+}
+- (void)unlockThen:(void (^)(void))then {
+  if (_unlockedUntil && _unlockedUntil.timeIntervalSinceNow > 0) {
+    then();
+    return;
+  }
+  LAContext* context = [[LAContext alloc] init];
+  __weak AgensSettings* weak = self;
+  [context evaluatePolicy:LAPolicyDeviceOwnerAuthentication
+          localizedReason:@"mostrar a senha salva"
+                    reply:^(BOOL ok, NSError* error) {
+                      dispatch_async(dispatch_get_main_queue(), ^{
+                        AgensSettings* strong = weak;
+                        if (!ok || !strong) return;
+                        strong->_unlockedUntil = [NSDate dateWithTimeIntervalSinceNow:60];
+                        then();
+                      });
+                    }];
+}
+- (std::string)passwordAt:(int)i {
+  char buf[1024] = "";
+  if (_browser) agens_password_get(_browser, i, buf, sizeof buf);
+  std::string out = buf;
+  std::fill(std::begin(buf), std::end(buf), 0);
+  return out;
+}
+- (void)revealPassword:(NSButton*)button {
+  const int i = (int)button.tag;
+  if (_revealed == i) {
+    _revealed = -1;
+    _revealedPassword.clear();
+    [self fillLogins];
+    return;
+  }
+  __weak AgensSettings* weak = self;
+  [self unlockThen:^{
+    AgensSettings* strong = weak;
+    if (!strong) return;
+    strong->_revealed = i;
+    strong->_revealedPassword = [strong passwordAt:i];
+    [strong fillLogins];
+  }];
+}
+- (void)copyPassword:(NSButton*)button {
+  const int i = (int)button.tag;
+  __weak AgensSettings* weak = self;
+  [self unlockThen:^{
+    AgensSettings* strong = weak;
+    if (!strong) return;
+    const std::string password = [strong passwordAt:i];
+    [NSPasteboard.generalPasteboard clearContents];
+    [NSPasteboard.generalPasteboard setString:@(password.c_str()) forType:NSPasteboardTypeString];
+    strong->_passwordStatus = [NSString stringWithFormat:@"Senha de %@ copiada.", @(strong->_logins[i].first.c_str())];
+    [strong fillLogins];
+  }];
+}
+- (void)confirmRemovePassword:(NSButton*)button {
+  const int i = (int)button.tag;
+  if (i < 0 || i >= (int)_logins.size()) return;
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = [NSString stringWithFormat:@"Apagar a senha de %@?", @(_logins[i].first.c_str())];
+  alert.informativeText = _logins[i].second.empty() ? @"Não dá para desfazer." : [NSString stringWithFormat:@"Usuário %@. Não dá para desfazer.", @(_logins[i].second.c_str())];
+  [alert addButtonWithTitle:@"Apagar"].hasDestructiveAction = YES;
+  [alert addButtonWithTitle:@"Cancelar"];
+  __weak AgensSettings* weak = self;
+  [alert beginSheetModalForWindow:self.window completionHandler:^(NSModalResponse r) {
+    AgensSettings* strong = weak;
+    if (r != NSAlertFirstButtonReturn || !strong || !strong->_browser || i >= (int)strong->_logins.size()) return;
+    agens_password_remove(strong->_browser, i);
+    strong->_logins.erase(strong->_logins.begin() + i);
+    strong->_revealed = -1;
+    strong->_revealedPassword.clear();
+    strong->_passwordStatus = nil;
+    [strong fillLogins];
+  }];
+}
+@end
