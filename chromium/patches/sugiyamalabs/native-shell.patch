+static void EnginesListed(void* context, const AgensSearchEngine* engines, int count) {
+  AgensSettings* s = (__bridge AgensSettings*)context;
+  for (int i = 0; i < count; ++i) {
+    [s->_engines addItemWithTitle:@(engines[i].name)];
+    s->_engineKeywords.push_back(engines[i].keyword);
+    if (engines[i].is_default) [s->_engines selectItemAtIndex:i];
+  }
+}
+- (CGFloat)fillAtos:(CGFloat)y {
+  // The atos list comes from the chrome (it already observes them); rename in place.
+  NSArray<NSString*>* names = [_chrome atoNamesForSettings];
+  for (NSUInteger i = 0; i < names.count; ++i) {
+    NSTextField* field = [NSTextField textFieldWithString:names[i]];
+    field.tag = i;
+    field.delegate = self;
+    field.target = self;
+    field.action = @selector(renameAto:);
+    field.frame = NSMakeRect(0, 0, 220, 24);
+    y = [self option:[NSString stringWithFormat:@"Ato %lu", (unsigned long)i + 1] detail:nil control:field y:y];
+  }
+  NSButton* add = [NSButton buttonWithTitle:@"Novo ato" target:self action:@selector(newAto:)];
+  add.frame = NSMakeRect(32, y + 4, 110, 28);
+  [_pane addSubview:add];
+  NSTextField* note = Label(12, NSFontWeightRegular, kDim);
+  note.stringValue = @"Cada ato tem abas, logins e cookies próprios. Compartilhar cookies entre atos: desligado.";
+  note.frame = NSMakeRect(32, y + 44, NSWidth(_pane.bounds) - 64, 16);
+  [_pane addSubview:note];
+  return y + 70;
+}
