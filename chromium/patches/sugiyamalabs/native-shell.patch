+// --- Actions
+// Segment order on screen: Grafite, Vidro, Brasa, Seu (the prototype's); stored ids 0, 2, 1, 3.
+static const int kThemeOrder[] = {0, 2, 1, 3};
+- (CGFloat)appearanceAt:(CGFloat)y {
+  const int theme = Theme();
+  int shown = 0;
+  for (int i = 0; i < 4; ++i) {
+    if (kThemeOrder[i] == theme) shown = i;
+  }
+  y = [self option:@"Tema" detail:@"Grafite, Vidro e Brasa são os do Agens. Seu é o seu."
+           control:[self segments:@[ @"Grafite", @"Vidro", @"Brasa", @"Seu" ] selected:shown action:@selector(setTheme:)]
+                 y:y];
+  if (theme == 3) {
+    NSUserDefaults* d = NSUserDefaults.standardUserDefaults;
+    NSColorWell* well = [NSColorWell colorWellWithStyle:NSColorWellStyleMinimal];
+    unsigned tint = [d objectForKey:kTintKey] ? (unsigned)[d integerForKey:kTintKey] : kSideBg.rgb(_pane);
+    well.color = Hex(tint);
+    well.target = self;
+    well.action = @selector(setTint:);
+    well.frame = NSMakeRect(0, 0, 44, 24);
+    y = [self option:@"Cor" detail:@"Pinta a moldura da janela." control:well y:y];
+    NSSlider* cover = [NSSlider sliderWithValue:([d objectForKey:kOpacityKey] ? [d doubleForKey:kOpacityKey] : 0.85)
+                                       minValue:0.2
+                                       maxValue:1
+                                         target:self
+                                         action:@selector(setCover:)];
+    cover.frame = NSMakeRect(0, 0, 180, 20);
+    y = [self option:@"Transparência" detail:@"Para a esquerda, mais do que está atrás aparece." control:cover y:y];
+    NSSwitch* blur = [[NSSwitch alloc] init];
+    blur.state = [d boolForKey:kBlurKey] ? NSControlStateValueOn : NSControlStateValueOff;
+    blur.target = self;
+    blur.action = @selector(setBlur:);
+    y = [self option:@"Desfoque" detail:@"Desligado: a área de trabalho aparece nítida." control:blur y:y];
