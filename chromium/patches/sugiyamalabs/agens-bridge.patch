+// Copyright 2026 SugiyamaLabs.
+// The host draws what the engine would put on screen (docs/protocolo.md, "Passo 5.3"): ui.ask to
+// the host, ui.answer back, ui.cancel when the engine gives up first. Embedded only; UI thread.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_UI_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_UI_OPS_H_
+
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "chrome/browser/agens/bridge/ops.h"
+
+namespace content {
+class JavaScriptDialogManager;
+class WebContents;
+}  // namespace content
+
+namespace agens::bridge::ui_ask {
+
+// The host's ui.answer (already checked against the ask), or null when the ask ended without one:
+// the host cancelled, or the engine did (the host left, the tab closed or navigated, too many open).
+using AnswerCallback = base::OnceCallback<void(const base::DictValue* answer)>;
+
+// Sends ui.ask {ask, kind, tab, ...fields} once the asks of the same tab and kind before it are
+// done. `contents` is null only for an extension. `done` runs exactly once, unless Withdraw; with
+// null (posted) when there is no host or kMaxOpenUiAsks are open. Returns the ask, for Withdraw.
+int Ask(content::WebContents* contents, std::string_view kind, base::DictValue fields, AnswerCallback done);
+// The page gave up: the host gets ui.cancel "gone" if it was asked, and `done` never runs.
+void Withdraw(int ask);
+
+// The engine closes the tab (view.close, tab.close): its asks end with "closed" now, before
+// Chromium tears the page down and cancels its dialogs for other reasons.
+void TabClosing(content::WebContents* contents);
+
+// An agent drives the tab and the person hasn't taken over: select, context_menu, file and auth
+// are cancelled for it instead of reaching the host.
+bool AgentWorking(content::WebContents* contents);
+
+// view_ops.cc: ui.answer (`from_host`: on the host's connection); the host is gone (every ask
+// ends without an answer).
+void HandleAnswer(bool from_host, const Request& request, ReplyCallback reply);
+void HostGone();
+
+// Embedded, once: <select> lists, right clicks, file panels, the cursor and the caret go to the host.
+void Start();
+
+// The JavaScript dialogs of embedded tabs no agent holds (ui.ask "dialog").
+content::JavaScriptDialogManager* Dialogs();
+// An agent takes the tab back ("Devolver"): its dialogs open on the host are cancelled there and
+// handed to `to`, oldest first.
+void HandDialogsTo(content::WebContents* contents, content::JavaScriptDialogManager* to);
+
+}  // namespace agens::bridge::ui_ask
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_UI_OPS_H_
