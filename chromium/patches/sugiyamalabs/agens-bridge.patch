+// Copyright 2026 SugiyamaLabs.
+// "Compartilhar cookies": the atos with the switch on (AgensWindow::AtoSharesCookies) form one
+// pool, and a cookie set, changed or deleted in one of them is written to the others' cookie
+// stores. Cookies only; nothing else of the profile is shared, and no copy is kept outside the
+// profiles' own stores.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_COOKIE_POOL_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_COOKIE_POOL_H_
+
+namespace agens {
+
+// Starts following the pool (once; later calls do nothing). UI thread, after the profile manager.
+void StartCookiePool();
+// The process is about to end without tearing profiles down (SIGTERM, logout): records "synced"
+// for the atos in sync now, before Local State's last write. From BrowserProcessImpl::EndSession.
+void EndCookiePoolSession();
+
+}  // namespace agens
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_COOKIE_POOL_H_
