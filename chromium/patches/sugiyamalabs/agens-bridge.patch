+- (void)dragDevTools:(NSPoint)p done:(BOOL)done {
+  const NSRect inner = NSInsetRect(_page, 1, 1);
+  const BOOL right = DevToolsOnRight();
+  const CGFloat total = right ? NSWidth(inner) : NSHeight(inner);
+  const CGFloat size = MAX(kDevToolsMin, MIN(right ? NSMaxX(inner) - p.x : NSMaxY(inner) - p.y, total - kDevToolsPageMin - 1));
+  [NSUserDefaults.standardUserDefaults setDouble:round(size) forKey:right ? kDevToolsWidthKey : kDevToolsHeightKey];
+  [self splitDevTools];
+  _devtoolsSize.stringValue = [NSString stringWithFormat:@"%d px · %d%%", (int)round(size), (int)lround(size / total * 100)];
+  _devtoolsSize.layer.backgroundColor = CG(kFloat, self);
+  _devtoolsSize.layer.borderColor = CG(kLineStrong, self);
+  const CGFloat w = ceil(_devtoolsSize.fittingSize.width) + 16, h = 22;
+  const NSRect d = _devtoolsDivider.frame;
+  _devtoolsSize.frame = right ? NSMakeRect(NSMinX(d) - w - 4, NSMidY(d) - h / 2, w, h)
+                              : NSMakeRect(NSMidX(d) - w / 2, NSMinY(d) - h - 4, w, h);
