+// Two icons side by side, as one template image (camera and microphone on the tab).
+static NSImage* AgensIconPair(NSString* a, NSString* b, CGFloat size) {
+  NSString* svg = [NSString stringWithFormat:
+      @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 38 20' width='%g' height='%g' fill='none' stroke='#000' "
+      @"stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'>%@<g transform='translate(18 0)'>%@</g></svg>",
+      size * 1.9, size, a, b];
+  NSImage* image = [[NSImage alloc] initWithData:[svg dataUsingEncoding:NSUTF8StringEncoding]];
+  [image setTemplate:YES];
+  return image;
+}
+// The kinds a site asks for: icon, what it may do (the request) and its name (the site panel).
+struct PermissionKind {  // literals only: unretained, so the table needs no destructor
+  const char* kind;
+  __unsafe_unretained NSString* icon;
+  __unsafe_unretained NSString* ask;
+  __unsafe_unretained NSString* name;
+};
+static const PermissionKind kPermissionKinds[] = {
+    {"camera", kIconCam, @"Usar a câmera", @"Câmera"},
+    {"microphone", kIconMic, @"Usar o microfone", @"Microfone"},
+    {"location", kIconLoc, @"Saber onde você está", @"Localização"},
+    {"notifications", kIconBell, @"Mostrar notificações", @"Notificações"},
+    {"clipboard", kIconClip, @"Ler o que você copiou", @"Área de transferência"},
+    {"popups", kIconPopups, @"Abrir pop-ups", @"Pop-ups e redirecionamentos"},
+    {"sound", kIconSound, @"Tocar som", @"Som"},
+};
+// At most two: the screen first (it's what the person would most want to know), then camera, microphone.
+static NSImage* CaptureIcons(BOOL camera, BOOL microphone, BOOL screen, CGFloat size) {
+  NSMutableArray<NSString*>* icons = [NSMutableArray array];
+  if (screen) [icons addObject:kIconScr];
+  if (camera) [icons addObject:kIconCam];
+  if (microphone) [icons addObject:kIconMic];
+  return icons.count > 1 ? AgensIconPair(icons[0], icons[1], size) : AgensIcon(icons.firstObject ?: kIconMic, size);
+}
+static const PermissionKind* FindPermissionKind(NSString* kind) {
+  for (const PermissionKind& k : kPermissionKinds) {
+    if ([kind isEqualToString:@(k.kind)]) return &k;
+  }
+  return nullptr;
+}
