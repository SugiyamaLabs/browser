+// A view whose plain background drags the window, like a title bar.
+@interface AgensDragView : NSView
+@end
+@implementation AgensDragView
+- (BOOL)isFlipped {
+  return YES;
+}
+- (BOOL)mouseDownCanMoveWindow {
+  return YES;
+}
+- (void)mouseDown:(NSEvent*)event {
+  if (event.clickCount == 2) {
+    [self.window performZoom:nil];
+  } else {
+    [self.window performWindowDragWithEvent:event];
+  }
+}
+@end
