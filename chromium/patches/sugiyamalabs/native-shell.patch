+  if (_window) agens_window_relayout(_window);  // the engine repaints the window and page card
+}
+// A theme switch (Grafite/Brasa) changes colors without changing the appearance: repaint all.
+static void RefreshTree(NSView* v) {
+  if ([v respondsToSelector:@selector(refresh)]) [(id)v refresh];
+  if ([v respondsToSelector:@selector(refreshTheme)]) [(id)v refreshTheme];
+  v.needsDisplay = YES;
+  for (NSView* sub in v.subviews) RefreshTree(sub);
+}
+// The backdrop sits below Chromium's content view in the window frame: the engine paints the
+// window color with alpha over it, the chrome draws on top.
+- (void)viewDidMoveToWindow {
+  [super viewDidMoveToWindow];
+  if (!self.window || _backdrop) return;
+  _backdrop = [[NSView alloc] initWithFrame:self.window.contentView.superview.bounds];
+  _backdrop.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [self.window.contentView.superview addSubview:_backdrop positioned:NSWindowBelow relativeTo:self.window.contentView];
+  [self refreshBackdrop];
+}
+- (void)refreshBackdrop {
+  for (NSView* v in [_backdrop.subviews copy]) [v removeFromSuperview];
+  _backdrop.hidden = !SeeThrough();
+  if (_backdrop.hidden) return;
+  NSUserDefaults* d = NSUserDefaults.standardUserDefaults;
+  NSString* image = Theme() == 3 ? [d stringForKey:kImageKey] : nil;
+  if (image.length) {
+    NSView* picture = [[NSView alloc] initWithFrame:_backdrop.bounds];
+    picture.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    picture.wantsLayer = YES;
+    picture.layer.contents = [[NSImage alloc] initWithContentsOfFile:image];
+    picture.layer.contentsGravity = kCAGravityResizeAspectFill;
+    [_backdrop addSubview:picture];
+  }
+  // Vidro always blurs; Seu blurs if asked (without blur and without image, the desktop shows).
+  if (Theme() == 2 || [d boolForKey:kBlurKey]) {
+    NSVisualEffectView* glass = [[NSVisualEffectView alloc] initWithFrame:_backdrop.bounds];
+    glass.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    glass.material = NSVisualEffectMaterialUnderWindowBackground;
+    glass.blendingMode = image.length ? NSVisualEffectBlendingModeWithinWindow : NSVisualEffectBlendingModeBehindWindow;
+    glass.state = NSVisualEffectStateFollowsWindowActiveState;
+    [_backdrop addSubview:glass];
+  }
+}
+// .loadbar::after: 35% of the line, from fully left of it to past its end, 1.1 s, again and again.
+// With "Reduzir movimento" it stays still in the middle.
+- (void)runLoadbar {
+  const CGFloat w = NSWidth(_loadbar.frame);
+  _loadW = NSWidth(_page);
+  [_loadGlow removeAllAnimations];
+  __block NSColor* warm;
+  [self.effectiveAppearance performAsCurrentDrawingAppearance:^{ warm = [kLight3.color() colorUsingColorSpace:NSColorSpace.sRGBColorSpace]; }];
+  _loadGlow.colors = @[ (id)[warm colorWithAlphaComponent:0].CGColor, (id)warm.CGColor, (id)[warm colorWithAlphaComponent:0].CGColor ];
+  _loadGlow.frame = CGRectMake((w - w * 0.35) / 2, 0, w * 0.35, 2);
+  if (_loadbar.hidden || w <= 0 || NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion) return;
+  CABasicAnimation* sweep = [CABasicAnimation animationWithKeyPath:@"position.x"];
+  sweep.fromValue = @(-w * 0.35 / 2);
+  sweep.toValue = @(w * 0.35 * 3.5);
+  sweep.duration = 1.1;
+  sweep.repeatCount = HUGE_VALF;
+  sweep.timingFunction = [CAMediaTimingFunction functionWithControlPoints:0.2 :0.8 :0.2 :1];  // --ease
+  [_loadGlow addAnimation:sweep forKey:@"sweep"];
+}
+- (void)tintChanged:(NSNotification*)note {
+  if (_window) agens_window_relayout(_window);  // the engine asks agens_ui_colors again
+}
+- (void)themeChanged:(NSNotification*)note {
+  [self setTop:[NSUserDefaults.standardUserDefaults boolForKey:kTabsOnTopKey]];
+  [self refreshBackdrop];
+  RefreshTree(self);
+
+  [self relayout];
+  if (_window) agens_window_relayout(_window);
+}
+- (void)colorsWindow:(unsigned*)window page:(unsigned*)page line:(unsigned*)line {
+  if (Theme() == 2) {
+    *window = 0;  // Vidro: all glass behind the chrome
+  } else if (Theme() == 3) {
+    NSUserDefaults* d = NSUserDefaults.standardUserDefaults;
+    unsigned tint = [d objectForKey:kTintKey] ? (unsigned)[d integerForKey:kTintKey] : kSideBg.rgb(self);
+    double cover = [d objectForKey:kOpacityKey] ? [d doubleForKey:kOpacityKey] : 0.85;
+    *window = ((unsigned)lround(cover * 255) << 24) | (tint & 0xFFFFFF);
+  } else {
+    *window = 0xFF000000 | kSideBg.rgb(self);
+  }
+
+  *page = kBg.solid(self);
+  *line = kLine.solid(self);
+}
