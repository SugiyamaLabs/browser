diff --git a/content/public/browser/agens_embed_mac.h b/content/public/browser/agens_embed_mac.h
new file mode 100644
index 0000000000..cc1b4b2304
--- /dev/null
+++ b/content/public/browser/agens_embed_mac.h
@@ -0,0 +1,107 @@
+// Copyright 2026 SugiyamaLabs.
+// A tab shown by another app (docs/poc/embed.md). The tab is not in any window here: its
+// compositor draws into a CAContext, the other app hosts that context in a CALayerHost and sends
+// its NSEvents back. This is the browser side of what RenderWidgetHostViewCocoa does for an app
+// shim, without Chromium code in the other app.
+#ifndef CONTENT_PUBLIC_BROWSER_AGENS_EMBED_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_AGENS_EMBED_MAC_H_
+
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/callback.h"
+#include "content/common/content_export.h"
+#include "ui/base/cursor/mojom/cursor_type.mojom-shared.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+
+class RenderFrameHost;
+class WebContents;
+struct ContextMenuParams;
+
+// Runs on the UI thread for every frame of a tab that draws by itself (not inside a views
+// window). `ca_context_id` is what the other app gives to its CALayerHost.
+using AgensEmbedLayerCallback = base::RepeatingCallback<
+    void(WebContents*, uint32_t ca_context_id, const gfx::Size& pixel_size, float scale)>;
+CONTENT_EXPORT void SetAgensEmbedLayerCallback(AgensEmbedLayerCallback callback);
+
+// Asks the tab for a new frame (and so a layer callback), for a host that attaches a tab already
+// drawn and idle. Does nothing while the tab has no live renderer.
+CONTENT_EXPORT void AgensEmbedRedraw(WebContents* contents);
+
+// The other app's view became (or stopped being) the first responder of its key window.
+CONTENT_EXPORT void AgensEmbedSetFocus(WebContents* contents, bool focused);
+
+// `native_event` is the NSEvent as CGEventCreateData gives it; `point` is where it happened in
+// the other app's view, in points from the top left.
+CONTENT_EXPORT void AgensEmbedMouse(WebContents* contents,
+                                    base::span<const uint8_t> native_event,
+                                    const gfx::PointF& point);
+CONTENT_EXPORT void AgensEmbedMouseLeave(WebContents* contents);
+// The element picker (chrome/browser/agens/bridge/view_pick.cc). What a view.mouse event is:
+// a move with no button down, a button going down, or anything else.
+enum class AgensEmbedMouseKind { kOther, kMove, kPress };
+CONTENT_EXPORT AgensEmbedMouseKind AgensEmbedMouseKindOf(base::span<const uint8_t> native_event);
+// A plain mouse move at `point` (no button, no modifier), as if the pointer had just arrived there.
+CONTENT_EXPORT void AgensEmbedMouseHover(WebContents* contents, const gfx::PointF& point);
+// Mouse events go to the page's main frame even over a cross-origin iframe (DevTools does the same
+// while it captures an area).
+CONTENT_EXPORT void AgensEmbedRouteMouseToRoot(WebContents* contents, bool on);
+CONTENT_EXPORT void AgensEmbedWheel(WebContents* contents,
+                                    base::span<const uint8_t> native_event,
+                                    const gfx::PointF& point);
+
+// A key event and what the other app's text input system made of it (its NSTextInputClient
+// calls during -interpretKeyEvents:).
+struct CONTENT_EXPORT AgensEmbedKey {
+  AgensEmbedKey();
+  ~AgensEmbedKey();
+  std::vector<uint8_t> native_event;
+  std::u16string text;                 // -insertText:
+  std::vector<std::string> selectors;  // -doCommandBySelector:, e.g. "deleteBackward:"
+  std::u16string marked;               // -setMarkedText: (the composition now)
+  int selection_start = 0;             // inside `marked`
+  int selection_end = 0;
+  bool had_marked = false;  // there was a composition before this key
+  bool unmarked = false;    // -unmarkText was called
+};
+CONTENT_EXPORT void AgensEmbedKeyEvent(WebContents* contents, const AgensEmbedKey& key);
+
+// "cut", "copy", "paste", "selectAll", "undo", "redo" (the other app's Edit menu).
+CONTENT_EXPORT void AgensEmbedEdit(WebContents* contents, const std::string& command);
+
+// Menus the other app draws instead of Chromium: set once, only when every tab is shown that way.
+struct CONTENT_EXPORT AgensEmbedMenuItem {
+  std::string label;
+  bool enabled = true;
+  bool group = false;  // an <optgroup>'s header
+};
+// A <select>'s list: `bounds` is the control, in the view's DIPs. `done` gets an index into
+// `items`, or nullopt to cancel; dropping it cancels too. Returns what to run if the page closes
+// the list before `done` runs (then `done` does nothing).
+using AgensEmbedSelectHandler = base::RepeatingCallback<base::OnceClosure(
+    WebContents*, const gfx::Rect& bounds, int selected, std::vector<AgensEmbedMenuItem> items,
+    base::OnceCallback<void(std::optional<int>)> done)>;
+CONTENT_EXPORT void SetAgensEmbedSelectHandler(AgensEmbedSelectHandler handler);
+// A right click (params.x and y are in the view's DIPs); Chromium shows no menu of its own.
+using AgensEmbedContextMenuHandler = base::RepeatingCallback<void(RenderFrameHost&, const ContextMenuParams&)>;
+CONTENT_EXPORT void SetAgensEmbedContextMenuHandler(AgensEmbedContextMenuHandler handler);
+// True for a page the other app does not show (a DevTools window's own): its <select> lists and
+// right clicks stay Chromium's, in that page's real window. Unset: every page goes to the handlers.
+using AgensEmbedOwnWindowCallback = base::RepeatingCallback<bool(WebContents*)>;
+CONTENT_EXPORT void SetAgensEmbedOwnWindow(AgensEmbedOwnWindowCallback callback);
+// The mouse cursor over the page, and where the text being edited is (in the view, DIPs).
+using AgensEmbedCursorCallback = base::RepeatingCallback<void(WebContents*, ui::mojom::CursorType)>;
+using AgensEmbedCaretCallback = base::RepeatingCallback<void(WebContents*, const gfx::Rect&)>;
+CONTENT_EXPORT void SetAgensEmbedCursorCallbacks(AgensEmbedCursorCallback cursor, AgensEmbedCaretCallback caret);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_AGENS_EMBED_MAC_H_
