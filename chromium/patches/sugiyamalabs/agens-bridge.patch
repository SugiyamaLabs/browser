+void agens_extension_add_file(AgensWindow* w, const char* path, void* parent) {
+  const base::FilePath file(path ? path : "");
+  if (!file.IsAbsolute()) return;
+  NSWindow* window = (__bridge NSWindow*)parent;
+  if (!window && w->browser->GetWindow()) window = w->browser->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  // The sheet is the only answer the person needs: a file that fails just installs nothing.
+  // shortcut: tell the person why a file failed (the CrxInstallError text) if people trip on it.
+  agens::ext::InstallFromDisk(w->browser->GetProfile(), file, gfx::NativeWindow(window), base::DoNothing());
+}
