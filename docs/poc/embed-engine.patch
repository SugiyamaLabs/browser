+// Copyright 2026 SugiyamaLabs.
+// The page of a window shown by another app (docs/poc/embed.md). Off unless the engine was
+// started with --agens-embed-socket=<path>.
+#ifndef CHROME_BROWSER_AGENS_EMBED_EMBED_HOST_H_
+#define CHROME_BROWSER_AGENS_EMBED_EMBED_HOST_H_
+
+struct AgensWindow;
+namespace content {
+class WebContents;
+}
+
+namespace agens {
+
+// The shell tells which windows exist; the first one is what a client attaches to.
+void EmbedAddWindow(AgensWindow* window);
+void EmbedRemoveWindow(AgensWindow* window);
+// True while another app shows this window's page: the shell keeps the tabs out of its views.
+bool EmbedShowsPage(AgensWindow* window);
+// Makes `active` the tab the other app shows: visible, at that app's size, drawing by itself.
+void EmbedShowTab(content::WebContents* active);
+
+}  // namespace agens
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_EMBED_HOST_H_
diff --git a/chrome/browser/agens/embed/embed_host_mac.cc b/chrome/browser/agens/embed/embed_host_mac.cc
new file mode 100644
index 0000000000..58146a8110
--- /dev/null
+++ b/chrome/browser/agens/embed/embed_host_mac.cc
@@ -0,0 +1,320 @@
+// Copyright 2026 SugiyamaLabs.
+// Proof of the embed (docs/poc/embed.md): one client on a Unix socket, one JSON message per
+// line. The client attaches to a window, gets the CAContext id of its active tab ("layer"
+// events) to host in a CALayerHost, and sends its view's size, focus and NSEvents.
+//
+// shortcut: no check of who connects (code signature, approval) and one window only; that is
+// the socket of docs/agens.md, which replaces this file's transport.
+
+#include "chrome/browser/agens/embed/embed_host.h"
+
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "content/public/browser/agens_embed_mac.h"
+
+namespace agens {
+
+namespace {
+
+const char kSocketSwitch[] = "agens-embed-socket";
+constexpr size_t kMaxLine = 1 << 20;  // a client that sends more without a newline is dropped
+
+class EmbedHost : public TabStripModelObserver {
+ public:
+  static EmbedHost* Get() {
+    static base::NoDestructor<EmbedHost> host;
+    return host.get();
+  }
+
+  void AddWindow(AgensWindow* window) {
+    windows_.push_back(window);
+    if (!started_) Start();
+  }
+  void RemoveWindow(AgensWindow* window) {
+    if (attached_ == window) Detach(/*window_closing=*/true);
+    std::erase(windows_, window);
+  }
+  bool ShowsPage(AgensWindow* window) { return attached_ && attached_ == window; }
+
+  void ShowTab(content::WebContents* active) {
+    content::WebContents* was = shown_.get();
+    if (was && was != active) {
+      content::AgensEmbedSetFocus(was, false);
+      was->UpdateWebContentsVisibility(content::Visibility::HIDDEN);
+    }
+    shown_ = active ? active->GetWeakPtr() : nullptr;
+    if (!active) return;
+    active->Resize(gfx::Rect(size_));
+    active->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+    if (was != active) {
+      sent_context_ = 0;  // the new tab's layer goes out even if the id repeats
+      if (focused_) content::AgensEmbedSetFocus(active, true);
+    }
+  }
+
+ private:
+  friend class base::NoDestructor<EmbedHost>;
+  EmbedHost() = default;
+
+  void Start() {
+    started_ = true;
+    const std::string path =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(kSocketSwitch);
+    if (path.empty()) return;
+    sockaddr_un address = {};
+    address.sun_family = AF_UNIX;
+    if (path.size() >= sizeof(address.sun_path)) {
+      LOG(ERROR) << "agens embed: socket path too long";
+      return;
+    }
+    path.copy(address.sun_path, path.size());
+    const int listener = socket(AF_UNIX, SOCK_STREAM, 0);
+    unlink(path.c_str());
+    // Only this user: the mode is set before anyone can connect (listen comes after).
+    if (listener < 0 || bind(listener, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0 ||
+        chmod(path.c_str(), 0600) < 0 || listen(listener, 1) < 0) {
+      PLOG(ERROR) << "agens embed: cannot listen on " << path;
+      if (listener >= 0) close(listener);
+      return;
+    }
+    content::SetAgensEmbedLayerCallback(
+        base::BindRepeating(&EmbedHost::OnLayer, base::Unretained(this)));
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&EmbedHost::Serve, listener, base::SequencedTaskRunner::GetCurrentDefault()));
+    LOG(WARNING) << "agens embed: listening on " << path;
+  }
+
+  // On a pool thread, forever: one client at a time. The UI thread owns and closes the client's
+  // descriptor, after this loop is done reading from it.
+  static void Serve(int listener, scoped_refptr<base::SequencedTaskRunner> ui) {
+    EmbedHost* host = Get();  // never destroyed
+    for (;;) {
+      const int client = HANDLE_EINTR(accept(listener, nullptr, nullptr));
+      if (client < 0) return;
+      const int on = 1;
+      setsockopt(client, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
+      ui->PostTask(FROM_HERE,
+                   base::BindOnce(&EmbedHost::OnConnected, base::Unretained(host), client));
+      std::string pending;
+      char buffer[1 << 16];
+      for (;;) {
+        const ssize_t count = HANDLE_EINTR(read(client, buffer, sizeof(buffer)));
+        if (count <= 0) break;
+        pending.append(buffer, static_cast<size_t>(count));
+        for (size_t end; (end = pending.find('\n')) != std::string::npos;) {
+          ui->PostTask(FROM_HERE, base::BindOnce(&EmbedHost::OnLine, base::Unretained(host), client,
+                                                 pending.substr(0, end)));
+          pending.erase(0, end + 1);
+        }
+        if (pending.size() > kMaxLine) break;
+      }
+      ui->PostTask(FROM_HERE,
+                   base::BindOnce(&EmbedHost::OnDisconnected, base::Unretained(host), client));
+    }
+  }
+
+  void OnConnected(int client) {
+    client_ = client;
+    LOG(WARNING) << "agens embed: client connected";
+  }
+
+  void OnDisconnected(int client) {
+    if (client_ == client) {
+      client_ = -1;
+      Detach();
+      LOG(WARNING) << "agens embed: client gone";
+    }
+    close(client);
+  }
+
+  void Attach(const gfx::Size& size) {
+    if (attached_ || windows_.empty()) return;
+    attached_ = windows_.front();
+    size_ = size;
+    attached_->model()->AddObserver(this);
+    attached_->relayout.Run();  // the shell lets go of the tabs and calls ShowTab
+    SendTabs();
+  }
+
+  // The page goes back to the window's own views (the shell lays out again).
+  void Detach(bool window_closing = false) {
+    if (!attached_) return;
+    AgensWindow* window = attached_;
+    attached_ = nullptr;
+    TabStripModelObserver::StopObservingAll(this);
+    shown_ = nullptr;
+    focused_ = false;
+    sent_context_ = 0;
+    if (window_closing) return;
+    if (content::WebContents* active = window->model()->GetActiveWebContents()) {
+      content::AgensEmbedSetFocus(active, false);
+    }
+    window->relayout.Run();
+  }
+
+  void OnLine(int client, const std::string& line) {
+    if (client != client_) return;
+    std::optional<base::DictValue> message = base::JSONReader::ReadDict(line, base::JSON_PARSE_RFC);
+    const std::string* op = message ? message->FindString("op") : nullptr;
+    if (!op) return;
+    if (*op == "attach" || *op == "resize") {
+      // Sizes come from outside: keep them sane before they reach the compositor.
+      const gfx::Size size(std::clamp(message->FindInt("width").value_or(0), 1, 16384),
+                           std::clamp(message->FindInt("height").value_or(0), 1, 16384));
+      if (*op == "attach") {
+        Attach(size);
+      } else if (attached_) {
+        size_ = size;
+        if (shown_) shown_->Resize(gfx::Rect(size_));
+      }
+      return;
+    }
+    if (!attached_) return;
+    AgensWindow* window = attached_;
+    if (*op == "navigate") {
+      const std::string* text = message->FindString("text");
+      if (text) agens_window_navigate(window, text->c_str());
+    } else if (*op == "tab.new") {
+      agens_window_new_tab(window);
+    } else if (*op == "tab.activate") {
+      agens_window_activate_tab(window, message->FindInt("index").value_or(-1));
+    } else if (*op == "tab.close") {
+      agens_window_close_tab(window, message->FindInt("index").value_or(-1));
+    } else if (*op == "back") {
+      agens_window_back(window);
+    } else if (*op == "forward") {
+      agens_window_forward(window);
+    } else if (*op == "reload") {
+      agens_window_reload(window);
+    } else if (content::WebContents* tab = shown_.get()) {
+      Input(tab, *op, *message);
+    }
+  }
+
+  void Input(content::WebContents* tab, const std::string& op, const base::DictValue& message) {
+    const std::string* data = message.FindString("data");
+    std::vector<uint8_t> event =
+        data ? base::Base64Decode(*data).value_or(std::vector<uint8_t>()) : std::vector<uint8_t>();
+    const gfx::PointF point(message.FindDouble("x").value_or(0), message.FindDouble("y").value_or(0));
+    if (op == "focus") {
+      focused_ = message.FindBool("on").value_or(false);
+      content::AgensEmbedSetFocus(tab, focused_);
+    } else if (op == "mouse") {
+      content::AgensEmbedMouse(tab, event, point);
+    } else if (op == "mouse.leave") {
+      content::AgensEmbedMouseLeave(tab);
+    } else if (op == "wheel") {
+      content::AgensEmbedWheel(tab, event, point);
+    } else if (op == "edit") {
+      const std::string* command = message.FindString("command");
+      if (command) content::AgensEmbedEdit(tab, *command);
+    } else if (op == "key") {
+      content::AgensEmbedKey key;
+      key.native_event = std::move(event);
+      if (const std::string* text = message.FindString("text")) key.text = base::UTF8ToUTF16(*text);
+      if (const std::string* marked = message.FindString("marked")) key.marked = base::UTF8ToUTF16(*marked);
+      if (const base::ListValue* selectors = message.FindList("commands")) {
+        for (const base::Value& selector : *selectors) {
+          if (selector.is_string()) key.selectors.push_back(selector.GetString());
+        }
+      }
+      const int length = static_cast<int>(key.marked.length());
+      key.selection_start = std::clamp(message.FindInt("sel_start").value_or(length), 0, length);
+      key.selection_end = std::clamp(message.FindInt("sel_end").value_or(length), key.selection_start, length);
+      key.had_marked = message.FindBool("had_marked").value_or(false);
+      key.unmarked = message.FindBool("unmarked").value_or(false);
+      content::AgensEmbedKeyEvent(tab, key);
+    }
+  }
+
+  void OnLayer(content::WebContents* contents, uint32_t context, const gfx::Size& pixels, float scale) {
+    if (client_ < 0 || contents != shown_.get()) return;
+    if (context == sent_context_ && pixels == sent_pixels_) return;  // this runs every frame
+    sent_context_ = context;
+    sent_pixels_ = pixels;
+    Send(base::DictValue()
+             .Set("event", "layer")
+             .Set("context", static_cast<double>(context))  // 32 bits unsigned: past an int
+             .Set("width", pixels.width())
+             .Set("height", pixels.height())
+             .Set("scale", static_cast<double>(scale)));
+  }
+
+  void SendTabs() {
+    if (client_ < 0 || !attached_) return;
+    TabStripModel* model = attached_->model();
+    base::ListValue list;
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      list.Append(base::DictValue()
+                      .Set("title", base::UTF16ToUTF8(contents->GetTitle()))
+                      .Set("url", contents->GetVisibleURL().spec())
+                      .Set("active", i == model->active_index())
+                      .Set("loading", contents->IsLoading()));
+    }
+    Send(base::DictValue().Set("event", "tabs").Set("tabs", std::move(list)));
+  }
+
+  // shortcut: a blocking write on the UI thread; fine for a few small lines to a local client,
+  // not for the real protocol.
+  void Send(const base::DictValue& message) {
+    std::string line = base::WriteJson(message).value_or("{}") + "\n";
+    for (size_t sent = 0; sent < line.size();) {
+      const ssize_t count = HANDLE_EINTR(write(client_, line.data() + sent, line.size() - sent));
+      if (count <= 0) return;  // the reader notices the closed socket and cleans up
+      sent += static_cast<size_t>(count);
+    }
+  }
+
+  // TabStripModelObserver (the attached window):
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                              const TabStripSelectionChange&) override {
+    SendTabs();
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override { SendTabs(); }
+
+  bool started_ = false;
+  std::vector<raw_ptr<AgensWindow>> windows_;
+  raw_ptr<AgensWindow> attached_ = nullptr;
+  base::WeakPtr<content::WebContents> shown_;
+  gfx::Size size_;
+  bool focused_ = false;
+  int client_ = -1;
+  uint32_t sent_context_ = 0;
+  gfx::Size sent_pixels_;
+};
+
+}  // namespace
+
+void EmbedAddWindow(AgensWindow* window) {
+  EmbedHost::Get()->AddWindow(window);
+}
+void EmbedRemoveWindow(AgensWindow* window) {
+  EmbedHost::Get()->RemoveWindow(window);
+}
+bool EmbedShowsPage(AgensWindow* window) {
+  return EmbedHost::Get()->ShowsPage(window);
+}
+void EmbedShowTab(content::WebContents* active) {
+  EmbedHost::Get()->ShowTab(active);
+}
+
+}  // namespace agens
