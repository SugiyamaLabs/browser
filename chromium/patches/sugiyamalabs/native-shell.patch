@@ -0,0 +1,412 @@
+// Copyright 2026 SugiyamaLabs.
+// One browser window as the embed API sees it (agens_embed.h): tabs, suggestions, atos, search
+// default, bookmarks. Platform-neutral; each platform's shell (native_shell_mac.mm, later
+// native_shell_win.cc) only hosts the UI and the page.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_WINDOW_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_WINDOW_H_
+
+#include <string>
+#include <vector>
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/agens/embed/agens_embed.h"
+#include "chrome/browser/autocomplete/autocomplete_classifier_factory.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_provider_client.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_scheme_classifier.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/stringprintf.h"
+#include "chrome/common/chrome_constants.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/browser_process.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_utils.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/default_search_manager.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data_util.h"
+#include "components/search_engines/template_url_service.h"
+#include "third_party/search_engines_data/resources/definitions/prepopulated_engines.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/page_info/page_info_dialog.h"
+#include "chrome/browser/ui/bubble_anchor_util.h"
+#include "chrome/browser/ui/browser_element_identifiers.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/favicon/content/content_favicon_driver.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/omnibox/browser/autocomplete_controller.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "chrome/browser/ui/status_bubble.h"
+#include "components/download/public/common/download_item.h"
+#include "components/url_formatter/url_formatter.h"
+#include "content/public/browser/download_manager.h"
+#include "ui/base/base_window.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_rep.h"
+
+// Chromium's status bubble, forwarded to the UI as one line of text.
+class AgensStatusBubble : public StatusBubble {
+ public:
+  AgensStatusBubble();
+  ~AgensStatusBubble() override;
+  void SetStatus(const std::u16string& status) override {
+    status_ = status;
+    Publish();
+  }
+  void SetURL(const GURL& url) override {
+    url_ = url.is_empty() ? std::u16string()
+                          : url_formatter::FormatUrl(
+                                url,
+                                url_formatter::kFormatUrlOmitDefaults | url_formatter::kFormatUrlOmitHTTPS |
+                                    url_formatter::kFormatUrlOmitTrivialSubdomains,
+                                base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+    Publish();
+  }
+  void Hide() override {
+    status_.clear();
+    url_.clear();
+    Publish();
+  }
+  void MouseMoved(bool left_content) override {}
+
+  AgensStatusChanged observer = nullptr;
+  raw_ptr<void> context = nullptr;
+
+ private:
+  void Publish() {
+    if (observer) observer(context, base::UTF16ToUTF8(url_.empty() ? status_ : url_).c_str());
+  }
+  std::u16string status_, url_;
+};
+
+struct AgensWindow : public TabStripModelObserver,
+                     public AutocompleteController::Observer,
+                     public ProfileAttributesStorage::Observer,
+                     public content::DownloadManager::Observer,
+                     public download::DownloadItem::Observer {
+  explicit AgensWindow(BrowserWindowInterface* browser) : browser(browser) {
+    browser->GetTabStripModel()->AddObserver(this);
+    Storage().AddObserver(this);
+    PreferDuckDuckGo();
+    if (content::DownloadManager* manager = browser->GetProfile()->GetDownloadManager()) {
+      downloads_manager = manager;
+      manager->AddObserver(this);
+    }
+  }
+
+  // Each ato starts searching with DuckDuckGo. Only while nobody has picked a default yet: once
+  // set (by this or by the person in Configurações), the choice is theirs and stays.
+  // `force` (Restaurar) sets it even when a default was already chosen.
+  void PreferDuckDuckGo(bool force = false) {
+    Profile* profile = browser->GetProfile()->GetOriginalProfile();
+    if (!force &&
+        profile->GetPrefs()->HasPrefPath(DefaultSearchManager::kDefaultSearchProviderDataPrefName)) {
+      return;
+    }
+    TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(profile);
+    if (!service) return;
+    if (!service->loaded()) {
+      search_loaded_ = service->RegisterOnLoadedCallback(
+          base::BindOnce(&AgensWindow::PreferDuckDuckGo, weak.GetWeakPtr(), force));
+      service->Load();
+      return;
+    }
+    TemplateURL* ddg = nullptr;
+    for (TemplateURL* t : service->GetTemplateURLs()) {
+      if (t->prepopulate_id() == TemplateURLPrepopulateData::duckduckgo.id) ddg = t;
+    }
+    if (!ddg) {
+      ddg = service->Add(std::make_unique<TemplateURL>(
+          *TemplateURLDataFromPrepopulatedEngine(TemplateURLPrepopulateData::duckduckgo)));
+    }
+    if (ddg && service->GetDefaultSearchProvider() != ddg) {
+      service->SetUserSelectedDefaultSearchProvider(ddg);
+    }
+  }
+  ~AgensWindow() override {
+    Storage().RemoveObserver(this);
+    for (download::DownloadItem* item : downloads) item->RemoveObserver(this);
+    if (downloads_manager) downloads_manager->RemoveObserver(this);
+  }
+
+  // --- Downloads: this session's, newest first.
+  void OnDownloadCreated(content::DownloadManager*, download::DownloadItem* item) override {
+    if (item->IsTemporary() || item->IsTransient()) return;
+    item->AddObserver(this);
+    downloads.insert(downloads.begin(), item);
+    NotifyDownloads(/*started=*/true);
+  }
+  void ManagerGoingDown(content::DownloadManager* manager) override {
+    for (download::DownloadItem* item : downloads) item->RemoveObserver(this);
+    downloads.clear();
+    manager->RemoveObserver(this);
+    downloads_manager = nullptr;
+  }
+  void OnDownloadUpdated(download::DownloadItem*) override { NotifyDownloads(false); }
+  void OnDownloadDestroyed(download::DownloadItem* item) override {
+    item->RemoveObserver(this);
+    std::erase(downloads, item);
+    NotifyDownloads(false);
+  }
+  download::DownloadItem* DownloadAt(int index) {
+    return index >= 0 && static_cast<size_t>(index) < downloads.size() ? downloads[index].get() : nullptr;
+  }
+  void NotifyDownloads(bool started) {
+    if (!downloads_observer) return;
+    std::vector<std::string> names;
+    std::vector<AgensDownload> out;
+    for (download::DownloadItem* item : downloads) {
+      names.push_back(item->GetFileNameToReportUser().AsUTF8Unsafe());
+    }
+    for (size_t i = 0; i < downloads.size(); ++i) {
+      download::DownloadItem* item = downloads[i];
+      AgensDownloadState state = kAgensDownloading;
+      switch (item->GetState()) {
+        case download::DownloadItem::COMPLETE: state = kAgensDownloaded; break;
+        case download::DownloadItem::CANCELLED: state = kAgensDownloadCancelled; break;
+        case download::DownloadItem::INTERRUPTED: state = kAgensDownloadFailed; break;
+        default: break;
+      }
+      out.push_back({names[i].c_str(), item->GetReceivedBytes(),
+                     std::max<int64_t>(0, item->GetTotalBytes()), state, item->IsPaused()});
+    }
+    downloads_observer(downloads_context, out.data(), static_cast<int>(out.size()), started);
+  }
+
+  static ProfileAttributesStorage& Storage() {
+    return g_browser_process->profile_manager()->GetProfileAttributesStorage();
+  }
+
+  std::vector<ProfileAttributesEntry*> Atos() {
+    // Creation order, so an ato keeps its place and color: Chromium names profile folders
+    // "Default", then "Profile 1", "Profile 2"…
+    std::vector<ProfileAttributesEntry*> atos;
+    for (ProfileAttributesEntry* entry : Storage().GetAllProfilesAttributesSortedByLocalProfileNameWithCheck()) {
+      if (!entry->IsOmitted()) atos.push_back(entry);
+    }
+    auto order = [](const ProfileAttributesEntry* e) {
+      const std::string name = e->GetPath().BaseName().AsUTF8Unsafe();
+      if (name == chrome::kInitialProfile) return -1;
+      int n = 0;
+      return base::StringToInt(name.substr(name.rfind(' ') + 1), &n) ? n : 1 << 20;
+    };
+    std::stable_sort(atos.begin(), atos.end(), [&](auto* a, auto* b) { return order(a) < order(b); });
+    return atos;
+  }
+
+  void NotifyAtos() {
+    if (!atos_observer) return;
+    std::vector<ProfileAttributesEntry*> entries = Atos();
+    std::vector<std::string> names;
+    std::vector<AgensAto> atos;
+    const base::FilePath current = browser->GetProfile()->GetOriginalProfile()->GetPath();
+    for (ProfileAttributesEntry* entry : entries) {
+      // Chromium's first profile has a generated name ("Pessoa 1"); ours is the personal ato.
+      names.push_back(entry->IsUsingDefaultName() &&
+                              entry->GetPath().BaseName().AsUTF8Unsafe() == chrome::kInitialProfile
+                          ? "Pessoal"
+                          : base::UTF16ToUTF8(entry->GetLocalProfileName()));
+    }
+    for (size_t i = 0; i < entries.size(); ++i) {
+      atos.push_back({names[i].c_str(), entries[i]->GetPath() == current,
+                      !g_browser_process->profile_manager()->GetProfileByPath(entries[i]->GetPath())});
+    }
+    atos_observer(atos_context, atos.data(), static_cast<int>(atos.size()));
+  }
+
+  void SwitchAto(int index) {
+    std::vector<ProfileAttributesEntry*> atos = Atos();
+    if (index < 0 || static_cast<size_t>(index) >= atos.size()) return;
+    const gfx::Rect bounds = browser->GetWindow()->GetBounds();
+    profiles::SwitchToProfile(atos[index]->GetPath(), /*always_create=*/false,
+                              base::BindOnce(&AgensWindow::PlaceOver, bounds));
+  }
+
+  void NewAto() {
+    // Our own free folder: Chromium's CreateMultiProfileAsync picks "Profile N" from a counter
+    // and stops on a folder already in use (seen on the second "+").
+    ProfileManager* manager = g_browser_process->profile_manager();
+    base::FilePath dir;
+    for (int i = 1;; ++i) {
+      dir = manager->user_data_dir().AppendASCII(base::StringPrintf("Profile %d", i));
+      if (!manager->GetProfileByPath(dir) && !Storage().GetProfileAttributesWithPath(dir)) break;
+    }
+    const gfx::Rect bounds = browser->GetWindow()->GetBounds();
+    const std::u16string name = base::UTF8ToUTF16(base::StringPrintf("Ato %zu", Atos().size() + 1));
+    manager->CreateProfileAsync(
+        dir, base::BindOnce(
+                 [](const gfx::Rect& bounds, const std::u16string& name, Profile* profile) {
+                   if (!profile) return;
+                   if (ProfileAttributesEntry* entry =
+                           Storage().GetProfileAttributesWithPath(profile->GetPath())) {
+                     entry->SetLocalProfileName(name, /*is_default_name=*/false);
+                   }
+                   profiles::OpenBrowserWindowForProfile(
+                       base::BindOnce(&AgensWindow::PlaceOver, bounds), /*always_create=*/true,
+                       /*is_new_profile=*/true, /*open_command_line_urls=*/false, profile);
+                 },
+                 bounds, name));
+  }
+
+  // The ato's window takes this window's place, so switching feels like one window.
+  static void PlaceOver(const gfx::Rect& bounds, BrowserWindowInterface* other) {
+    if (other) other->GetWindow()->SetBounds(bounds);
+  }
+
+  // ProfileAttributesStorage::Observer:
+  void OnProfileAdded(const base::FilePath&) override { NotifyAtos(); }
+  void OnProfileWasRemoved(const base::FilePath&, const std::u16string&) override { NotifyAtos(); }
+  void OnProfileNameChanged(const base::FilePath&, const std::u16string&) override { NotifyAtos(); }
+
+  TabStripModel* model() { return browser->GetTabStripModel(); }
+
+  // Loading pages change a tab many times a frame (title, URL, favicon, loading); the UI gets one
+  // update per run of the message loop instead of one per change.
+  void Notify() {
+    if (notify_pending) return;
+    notify_pending = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AgensWindow::NotifyNow, weak.GetWeakPtr()));
+  }
+
+  void NotifyNow() {
+    notify_pending = false;
+    if (!observer) return;
+    const int count = model()->count();
+    bookmarks::BookmarkModel* bookmarks =
+        BookmarkModelFactory::GetForBrowserContextIfExists(browser->GetProfile());
+    std::vector<std::string> titles(count), urls(count);
+    std::vector<std::vector<uint8_t>> icons(count);
+    std::vector<AgensTab> tabs(count);
+    for (int i = 0; i < count; ++i) {
+      content::WebContents* contents = model()->GetWebContentsAt(i);
+      titles[i] = base::UTF16ToUTF8(contents->GetTitle());
+      urls[i] = contents->GetVisibleURL().spec();
+      if (urls[i].starts_with("chrome://newtab")) urls[i].clear();
+      if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents)) {
+        gfx::Image icon = driver->GetFavicon();
+        if (!icon.IsEmpty()) {
+          const SkBitmap& bitmap = icon.AsImageSkia().GetRepresentation(2.0f).GetBitmap();
+          icons[i] = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false).value_or(std::vector<uint8_t>());
+        }
+      }
+      tabs[i] = {titles[i].c_str(), urls[i].c_str(), icons[i].empty() ? nullptr : icons[i].data(),
+                 static_cast<int>(icons[i].size()), i == model()->active_index(),
+                 contents->IsLoading(), contents->WasDiscarded(),
+                 contents->GetController().CanGoBack(), contents->GetController().CanGoForward(),
+                 bookmarks && bookmarks->IsBookmarked(contents->GetVisibleURL()),
+                 model()->IsTabPinned(i), contents->IsCurrentlyAudible(),
+                 contents->IsAudioMuted()};
+    }
+    observer(context, tabs.data(), static_cast<int>(tabs.size()));
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                              const TabStripSelectionChange&) override {
+    Notify();
+    NotifyAtos();  // cheap; keeps "asleep" fresh as atos load and unload
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override { Notify(); }
+
+  void Suggest(const std::string& text) {
+    if (!autocomplete) {
+      AutocompleteControllerConfig config;
+      // Local sources only. kSearch adds the "search for what you typed" row; its remote
+      // suggestions follow kSearchSuggestEnabled, which ungoogled turns off.
+      config.provider_types = static_cast<int>(
+          AutocompleteProvider::Type::kBookmark | AutocompleteProvider::Type::kBuiltin |
+          AutocompleteProvider::Type::kHistoryQuick | AutocompleteProvider::Type::kHistoryUrl |
+          AutocompleteProvider::Type::kSearch | AutocompleteProvider::Type::kShortcuts |
+          AutocompleteProvider::Type::kCalculator);
+      autocomplete = std::make_unique<AutocompleteController>(
+          std::make_unique<ChromeAutocompleteProviderClient>(browser->GetProfile()), config);
+      autocomplete->AddObserver(this);
+    }
+    if (text.empty()) {
+      autocomplete->Stop(AutocompleteStopReason::kClobbered);
+      PublishSuggestions();
+      return;
+    }
+    AutocompleteInput input(base::UTF8ToUTF16(text), metrics::OmniboxEventProto::OTHER,
+                            ChromeAutocompleteSchemeClassifier(browser->GetProfile()));
+    autocomplete->Start(input);
+  }
+
+  void OpenSuggestion(int index) {
+    content::WebContents* active = model()->GetActiveWebContents();
+    if (!autocomplete || !active || index < 0 ||
+        static_cast<size_t>(index) >= autocomplete->result().size()) {
+      return;
+    }
+    const GURL url = autocomplete->result().match_at(index).destination_url;
+    autocomplete->Stop(AutocompleteStopReason::kClobbered);
+    if (!url.is_valid()) return;
+    active->GetController().LoadURL(url, content::Referrer(), ui::PAGE_TRANSITION_TYPED,
+                                    std::string());
+    active->Focus();
+  }
+
+  void PublishSuggestions() {
+    if (!suggestions_observer) return;
+    std::vector<std::string> texts, details;
+    std::vector<AgensSuggestion> out;
+    const AutocompleteResult& result = autocomplete->result();
+    const size_t count = std::min<size_t>(result.size(), 6);
+    texts.reserve(count);
+    details.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+      const AutocompleteMatch& match = result.match_at(i);
+      const bool search = AutocompleteMatch::IsSearchType(match.type);
+      texts.push_back(base::UTF16ToUTF8(search ? match.contents : match.contents));
+      details.push_back(search ? std::string() : base::UTF16ToUTF8(match.description));
+    }
+    for (size_t i = 0; i < count; ++i) {
+      out.push_back({texts[i].c_str(), details[i].c_str(),
+                     AutocompleteMatch::IsSearchType(result.match_at(i).type)});
+    }
+    suggestions_observer(suggestions_context, out.data(), static_cast<int>(out.size()));
+  }
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController*, bool) override { PublishSuggestions(); }
+
+  raw_ptr<BrowserWindowInterface> browser;
+  AgensTabsChanged observer = nullptr;
+  raw_ptr<void> context = nullptr;
+  AgensAtosChanged atos_observer = nullptr;
+  raw_ptr<void> atos_context = nullptr;
+  AgensSuggestionsChanged suggestions_observer = nullptr;
+  raw_ptr<void> suggestions_context = nullptr;
+  std::unique_ptr<AutocompleteController> autocomplete;
+  base::RepeatingClosure relayout;
+  bool notify_pending = false;
+  AgensStatusBubble status_bubble;
+  raw_ptr<content::DownloadManager> downloads_manager = nullptr;
+  std::vector<raw_ptr<download::DownloadItem>> downloads;
+  AgensDownloadsChanged downloads_observer = nullptr;
+  raw_ptr<void> downloads_context = nullptr;
+  base::CallbackListSubscription search_loaded_;
+  base::CancelableTaskTracker history_tracker;
+  base::WeakPtrFactory<AgensWindow> weak{this};
+};
