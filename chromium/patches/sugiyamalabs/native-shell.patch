+// Apagar dados de navegação: period, what, and the button.
+- (CGFloat)clearPage:(CGFloat)y {
+  NSPopUpButton* period = [[NSPopUpButton alloc] init];
+  NSArray<NSString*>* periods = @[ @"Última hora", @"Últimas 24 horas", @"Últimos 7 dias", @"Últimas 4 semanas", @"Todo o período" ];
+  for (NSUInteger i = 0; i < periods.count; ++i) {
+    [period addItemWithTitle:periods[i]];
+    period.lastItem.tag = i;
+  }
+  [period selectItemWithTag:_clearPeriod];
+  period.target = self;
+  period.action = @selector(setClearPeriod:);
+  y = [self option:@"Período" detail:@"Só deste ato." control:period y:y];
+  struct Kind {
+    int bit;
+    NSString* label;
+    NSString* detail;
+  } kinds[] = {
+      {kAgensClearHistory, @"Histórico", @"As páginas visitadas."},
+      {kAgensClearCookies, @"Cookies e dados de sites", @"Sai da maioria dos sites."},
+      {kAgensClearCache, @"Imagens e arquivos em cache", @"As páginas carregam de novo, um pouco mais devagar."},
+      {kAgensClearDownloads, @"Lista de downloads", @"Os arquivos continuam no disco."},
+      {kAgensClearForms, @"Dados de formulários", @"O que o preenchimento automático guardou."},
+  };
+  for (const Kind& k : kinds) {
+    NSSwitch* sw = [[NSSwitch alloc] init];
+    sw.state = (_clearWhat & k.bit) ? NSControlStateValueOn : NSControlStateValueOff;
+    sw.tag = k.bit;
+    sw.target = self;
+    sw.action = @selector(setClearKind:);
+    y = [self option:k.label detail:k.detail control:sw y:y];
+  }
+  NSButton* go = [NSButton buttonWithTitle:@"Apagar dados" target:self action:@selector(clearData:)];
+  go.hasDestructiveAction = YES;
+  go.enabled = _clearWhat != 0 && ![_clearStatus isEqualToString:@"Apagando…"];
+  return [self option:@"Apagar o que está marcado" detail:_clearStatus control:go y:y];
+}
