+static const int kAtoSleepMinutes[] = {5, 10, 30, 60, 0};  // 0 is "Nunca"
+- (CGFloat)atosSleep:(CGFloat)y {
+  y = [self groupTitle:@"Atos" y:y];
+  int after = 10;
+  if (_browser) agens_pref_get_int(_browser, kAgensLocal, "agens.atos_sleep_after_min", &after);
+  NSInteger shown = 1;
+  for (NSInteger i = 0; i < 5; ++i) {
+    if (kAtoSleepMinutes[i] == after) shown = i;
+  }
+  const BOOL never = after == 0;
+  _stackWide = YES;
+  y = [self option:@"Atos fora de uso dormem depois de"
+            detail:never ? @"Nenhum ato dorme sozinho. Pôr o ato para dormir, no botão direito, continua valendo."
+                         : @"Conta desde que o ato ficou sem aba à vista."
+           control:[self segments:@[ @"5 min", @"10 min", @"30 min", @"1 h", @"Nunca" ] selected:shown action:@selector(setAtosSleepAfter:)]
+                 y:y];
+  _stackWide = NO;
+  NSSwitch* front = [self prefSwitch:"agens.atos_sleep_active_pinned"];
+  front.action = @selector(toggleBoolAndShow:);  // its line says what happens now
+  const BOOL frontOn = front.state == NSControlStateValueOn;
+  // agens::kAtosSleepWholePref: an ato the rule put to sleep also unloads.
+  NSSwitch* whole = [self prefSwitch:"agens.atos_sleep_whole"];
+  struct Row { NSString* label; NSString* detail; NSSwitch* control; } rows[] = {
+      {@"A aba ativa e as fixadas também dormem",
+       frontOn ? @"O ato dorme todo, até a aba da frente; ao voltar, ela recarrega." : @"A aba da frente e as fixadas ficam acordadas; o resto dorme.",
+       front},
+      {@"Atos fora de uso dormem inteiros", @"Só o ato aberto fica carregado. Ao abrir de novo, as abas voltam.", whole},
+  };
+  for (const Row& r : rows) {
+    r.control.enabled = !never;  // with Nunca there's no rule to tune
+    y = [self option:r.label detail:r.detail control:r.control y:y];
+    if (never) _pane.subviews.lastObject.alphaValue = 0.45;
+  }
+  return [self atosNeverSleep:y];
+}
+- (CGFloat)atosNeverSleep:(CGFloat)y {
+  y = [self groupTitle:@"Atos que nunca dormem sozinhos" y:y];
+  NSArray<NSString*>* names = [_chrome atoNamesForSettings];
+  NSArray<NSString*>* ids = [_chrome atoIdsForSettings];
+  NSArray<NSNumber*>* nevers = [_chrome atoNeverSleepForSettings];
+  NSMutableArray<NSButton*>* add = [NSMutableArray array];
+  BOOL any = NO;
+  for (NSUInteger i = 0; i < names.count && i < ids.count && i < nevers.count; ++i) {
+    NSButton* b = [self small:nevers[i].boolValue ? @"Remover" : names[i] action:@selector(setAtoNeverSleep:) tag:!nevers[i].boolValue];
+    b.identifier = ids[i];
+    if (!nevers[i].boolValue) {
+      [add addObject:b];
+      continue;
+    }
+    any = YES;
+    b.accessibilityLabel = [@"Remover " stringByAppendingString:names[i]];
+    y = [self option:names[i] detail:@"Fora da regra do tempo e do “dormem inteiros”." control:[self buttons:@[ b ]] y:y];
+  }
+  if (!any) y = [self info:@"Nenhum" detail:@"Marque “Nunca pôr para dormir” no botão direito do ato." note:@"" y:y];
+  if (add.count) {
+    _stackWide = YES;
+    y = [self option:@"Adicionar ato…" detail:nil control:[self buttons:add] y:y];
+    _stackWide = NO;
+  }
+  NSTextField* note = Label(12, NSFontWeightRegular, kDim);
+  note.stringValue = @"Mesma lista do botão direito do ato › Nunca pôr para dormir.";
+  note.frame = NSMakeRect(32, y, NSWidth(_pane.bounds) - 64, 16);
+  [_pane addSubview:note];
+  return y + 24;
+}
