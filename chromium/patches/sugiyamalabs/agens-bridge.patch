+
+std::string_view Trim(std::string_view s) {
+  while (!s.empty() && s.front() == ' ') s.remove_prefix(1);
+  while (!s.empty() && s.back() == ' ') s.remove_suffix(1);
+  return s;
+}
+
+// `+js(a, b\, c, 'd, e')` -> {"a", "b, c", "d, e"}, as uBlock splits them.
+std::vector<std::string> SplitArgs(std::string_view body) {
+  std::vector<std::string> out;
+  size_t i = 0;
+  while (i <= body.size()) {
+    while (i < body.size() && body[i] == ' ') ++i;
+    std::string arg;
+    char q = i < body.size() ? body[i] : 0;
+    if (q == '\'' || q == '"' || q == '`') {
+      size_t end = i + 1;
+      while (end < body.size() && !(body[end] == q && body[end - 1] != '\\'))
+        ++end;
+      size_t comma = body.find(',', end);
+      if (end < body.size() &&
+          Trim(body.substr(end + 1, comma == std::string_view::npos
+                                        ? std::string_view::npos
+                                        : comma - end - 1))
+              .empty()) {
+        arg = std::string(body.substr(i + 1, end - i - 1));
+        out.push_back(arg);
+        if (comma == std::string_view::npos) break;
+        i = comma + 1;
+        continue;
+      }
+    }
+    for (; i < body.size() && body[i] != ','; ++i) {
+      if (body[i] == '\\' && i + 1 < body.size() && body[i + 1] == ',') ++i;
+      arg += body[i];
+    }
+    out.emplace_back(Trim(arg));
+    if (i >= body.size()) break;
+    ++i;
+  }
+  return out;
+}
+
+void AppendJsString(std::string& out, std::string_view s) {
+  out += '"';
+  for (unsigned char c : s) {
+    if (c == '"' || c == '\\') {
+      out += '\\';
+      out += c;
+    } else if (c < 0x20 || c == '<') {
+      out += "\\u00";
+      out += "0123456789abcdef"[c >> 4];
+      out += "0123456789abcdef"[c & 15];
+    } else {
+      out += c;
+    }
+  }
+  out += '"';
+}
+
+}  // namespace
+
+std::string ScriptletsJs(const std::vector<std::string>& rules) {
+  std::string calls;
+  std::set<std::string> seen;
+  for (const std::string& rule : rules) {
+    std::string_view r(rule);
+    if (!r.starts_with("+js(") || !r.ends_with(")") || !seen.insert(rule).second)
+      continue;
+    std::vector<std::string> args = SplitArgs(r.substr(4, r.size() - 5));
+    if (args.empty()) continue;
+    std::string_view name = args[0];
+    if (name.ends_with(".js")) name.remove_suffix(3);
+    std::string_view canonical;
+    for (auto& [alias, short_name] : kNames)
+      if (alias == name) canonical = short_name;
+    if (canonical.empty()) continue;
+    calls += calls.empty() ? "[" : ",[";
+    AppendJsString(calls, canonical);
+    for (size_t i = 1; i < args.size(); ++i) {
+      calls += ',';
+      AppendJsString(calls, args[i]);
+    }
+    calls += ']';
+  }
+  if (calls.empty()) return std::string();
+  return std::string(kLibrary) + "[" + calls + "]);\n";
+}
+
+}  // namespace agens_adblock
