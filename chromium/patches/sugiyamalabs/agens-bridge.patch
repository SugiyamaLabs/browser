+void StartUpdates() {
+  static bool tried = false;
+  if (std::exchange(tried, true) || IsEmbedded()) return;
+#if !defined(OFFICIAL_BUILD)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("agens-updates")) return;
+#endif
+  NSBundle* sparkle =
+      [NSBundle bundleWithPath:[NSBundle.mainBundle.privateFrameworksPath stringByAppendingPathComponent:@"Sparkle.framework"]];
+  Class controller = [sparkle load] ? NSClassFromString(@"SPUStandardUpdaterController") : nil;
+  if (!controller) return;
+  g_updater = [(id<AgensSparkleUpdater>)[controller alloc] initWithStartingUpdater:YES updaterDelegate:nil userDriverDelegate:nil];
+  // AgensBrowser › Procurar atualizações…, under Sobre. Sparkle's controller validates (greys) it.
+  NSMenu* app = NSApp.mainMenu.itemArray.firstObject.submenu;
+  NSMenuItem* item = [[NSMenuItem alloc] initWithTitle:@"Procurar atualizações…" action:@selector(checkForUpdates:) keyEquivalent:@""];
+  item.target = g_updater;
+  [app insertItem:item atIndex:MIN(1, app.numberOfItems)];
