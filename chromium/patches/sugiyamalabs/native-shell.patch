+// Copyright 2026 SugiyamaLabs.
+// The boundary between the engine and any interface (the browser's own chrome today, the Agens
+// app later). Plain C on purpose: no Chromium or C++ types cross it, Swift imports it as is, and
+// what sits under it (today Chromium's Webium window) can change without touching the UI.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_EMBED_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_EMBED_H_
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// One browser window. Owned by the engine; valid until the UI's destroy hook runs.
+typedef struct AgensWindow AgensWindow;
+
+typedef struct {
+  const char* title;  // UTF-8, never null
+  const char* url;    // UTF-8, empty for the new tab page
+  const unsigned char* favicon_png;  // 32x32 PNG (2x), null when the page has none yet
+  int favicon_png_size;
+  int active;
+  int loading;
+  int sleeping;  // discarded to save memory; reloads when activated
+  int can_go_back;
+  int can_go_forward;
+  int bookmarked;  // the page is in Favoritos
+  int pinned;      // kept at the front, as an icon; Chromium keeps pinned tabs first
+  int audible;     // playing sound now
+  int muted;       // sound turned off by the person
+} AgensTab;
+
+// Things the window's menu opens (Chromium's own pages for now).
+typedef enum {
+  kAgensBookmarks,
+  kAgensHistory,
+  kAgensSettings,
+} AgensPage;
+
+// Top-left origin, in points.
+typedef struct {
+  int x, y, width, height;
+} AgensRect;
+
+// Strings, icons and the array are only valid during the call; copy what you keep.
+typedef void (*AgensTabsChanged)(void* context, const AgensTab* tabs, int count);
+
+void agens_window_set_tabs_observer(AgensWindow* window, AgensTabsChanged observer, void* context);
+void agens_window_new_tab(AgensWindow* window);
+void agens_window_activate_tab(AgensWindow* window, int index);
+void agens_window_close_tab(AgensWindow* window, int index);
+void agens_window_move_tab(AgensWindow* window, int from, int to);
+void agens_window_set_pinned(AgensWindow* window, int index, int pinned);
+void agens_window_toggle_mute(AgensWindow* window, int index);
+// Address or search text, as typed; the engine decides which it is.
+void agens_window_navigate(AgensWindow* window, const char* text);
+void agens_window_back(AgensWindow* window);
+void agens_window_forward(AgensWindow* window);
+void agens_window_reload(AgensWindow* window);
+void agens_window_stop(AgensWindow* window);
+// Adds the active page to Favoritos, or removes it if it's there.
+void agens_window_toggle_bookmark(AgensWindow* window);
+void agens_window_open_page(AgensWindow* window, AgensPage page);
+// The site panel (connection, permissions, cookies), anchored at the address's site icon.
+void agens_window_show_site_info(AgensWindow* window);
+// Asks the engine to lay out and repaint again (after the UI changes size or colors, e.g.
+// light/dark mode).
+void agens_window_relayout(AgensWindow* window);
+
+// Address suggestions, from local sources only (history, bookmarks, the typed search); remote
+// search suggestions stay off. Call suggest on every edit, with "" to stop.
+typedef struct {
+  const char* text;    // what to show: the address or the search terms
+  const char* detail;  // page title, or empty for a search
+  int is_search;
+} AgensSuggestion;
+typedef void (*AgensSuggestionsChanged)(void* context, const AgensSuggestion* suggestions,
+                                        int count);
+void agens_window_set_suggestions_observer(AgensWindow* window, AgensSuggestionsChanged observer,
+                                           void* context);
+void agens_window_suggest(AgensWindow* window, const char* text);
+void agens_window_open_suggestion(AgensWindow* window, int index);
+
+// Atos: separate contexts with their own tabs, logins and cookies (one Chromium profile each).
+typedef struct {
+  const char* name;  // UTF-8
+  int active;        // this window's ato
+  int asleep;        // not loaded in memory right now
+} AgensAto;
+typedef void (*AgensAtosChanged)(void* context, const AgensAto* atos, int count);
+void agens_window_set_atos_observer(AgensWindow* window, AgensAtosChanged observer, void* context);
+// Opens that ato's window over this one (each ato keeps its own window and tabs).
+void agens_window_switch_ato(AgensWindow* window, int index);
+void agens_window_new_ato(AgensWindow* window);
+
+// The status line: the URL of the link under the pointer, or a page status. "" hides it.
+typedef void (*AgensStatusChanged)(void* context, const char* text);
+void agens_window_set_status_observer(AgensWindow* window, AgensStatusChanged observer, void* context);
+
+// Downloads of this session, newest first. `started` is 1 on the update that adds a new one.
+typedef enum {
+  kAgensDownloading,
+  kAgensDownloaded,
+  kAgensDownloadCancelled,
+  kAgensDownloadFailed,
+} AgensDownloadState;
+typedef struct {
+  const char* name;  // file name, UTF-8
+  long long received, total;  // bytes; total is 0 when unknown
+  AgensDownloadState state;
+  int paused;
+} AgensDownload;
+typedef void (*AgensDownloadsChanged)(void* context, const AgensDownload* downloads, int count,
+                                      int started);
+void agens_window_set_downloads_observer(AgensWindow* window, AgensDownloadsChanged observer,
+                                         void* context);
+void agens_window_download_open(AgensWindow* window, int index);       // the file
+void agens_window_download_show(AgensWindow* window, int index);       // in the Finder
+void agens_window_download_cancel(AgensWindow* window, int index);
+
+// --- Settings (the browser's own; not part of what the Agens app embeds).
+
+// Light, dark or follow the system, for the window and for pages (prefers-color-scheme).
+typedef enum { kAgensModeSystem, kAgensModeLight, kAgensModeDark } AgensColorMode;
+void agens_window_set_color_mode(AgensWindow* window, AgensColorMode mode);
+AgensColorMode agens_window_color_mode(AgensWindow* window);
+
+typedef struct {
+  const char* name;
+  const char* keyword;  // identifies the engine
+  int is_default;
+} AgensSearchEngine;
+typedef void (*AgensSearchEnginesFn)(void* context, const AgensSearchEngine* engines, int count);
+// Calls `fn` once, now, with the built-in engines (and the current default).
+void agens_window_search_engines(AgensWindow* window, AgensSearchEnginesFn fn, void* context);
+void agens_window_set_search_engine(AgensWindow* window, const char* keyword);
+
+void agens_window_rename_ato(AgensWindow* window, int index, const char* name);
+// Opens a page (e.g. one of Chromium's settings pages) in a new tab of this window.
+void agens_window_open_url(AgensWindow* window, const char* url);
+// Chromium preferences by name, for the settings window. kAgensLocal is the browser-wide store
+// (Local State); kAgensProfile is this window's ato. Getters return 0 when the pref doesn't exist or
+// has another type, and leave `out` alone.
+typedef enum { kAgensProfile, kAgensLocal } AgensPrefStore;
+int agens_pref_get_bool(AgensWindow* window, AgensPrefStore store, const char* name, int* out);
+int agens_pref_get_int(AgensWindow* window, AgensPrefStore store, const char* name, int* out);
+// Copies at most size-1 bytes (UTF-8) and always terminates.
+int agens_pref_get_string(AgensWindow* window, AgensPrefStore store, const char* name, char* out, int size);
+void agens_pref_set_bool(AgensWindow* window, AgensPrefStore store, const char* name, int value);
+void agens_pref_set_int(AgensWindow* window, AgensPrefStore store, const char* name, int value);
+void agens_pref_set_string(AgensWindow* window, AgensPrefStore store, const char* name, const char* value);
+
+// Site permissions by default, for every site of this ato. `kind`: "camera", "microphone",
+// "location", "notifications", "popups", "sound", "clipboard", "downloads", "javascript", "cookies".
+typedef enum { kAgensAsk, kAgensAllow, kAgensBlock, kAgensSessionOnly } AgensPermission;
+AgensPermission agens_permission_get(AgensWindow* window, const char* kind);
+void agens_permission_set(AgensWindow* window, const char* kind, AgensPermission value);
+
+// The managers in Configurações. All act on this window's ato. `done` runs once, later, on the UI
+// thread.
+typedef void (*AgensDoneFn)(void* context);
+
+// Apagar dados de navegação. `what` is a mask; `period` 0 last hour, 1 day, 2 week, 3 four weeks,
+// 4 all time.
+enum {
+  kAgensClearHistory = 1 << 0,
+  kAgensClearCookies = 1 << 1,  // cookies and site data (signs out of sites)
+  kAgensClearCache = 1 << 2,
+  kAgensClearDownloads = 1 << 3,  // the list, not the files
+  kAgensClearForms = 1 << 4,
+};
+void agens_clear_data(AgensWindow* window, int what, int period, AgensDoneFn done, void* context);
+
+// Restaurar: search engine (back to ours), home and startup pages, site permissions, languages and
+// new tab shortcuts. Logins, cookies, passwords, bookmarks, history and extensions stay.
+void agens_reset_settings(AgensWindow* window, AgensDoneFn done, void* context);
+
+// Exceções por site: what the person set for one site, for the kinds of agens_permission_get.
+typedef struct {
+  const char* site;  // the pattern, e.g. "https://meet.google.com:443" or "[*.]example.com"
+  const char* kind;
+  AgensPermission value;
+} AgensSiteException;
+typedef void (*AgensSiteExceptionsFn)(void* context, const AgensSiteException* exceptions, int count);
+void agens_site_exceptions(AgensWindow* window, AgensSiteExceptionsFn fn, void* context);  // calls now
+void agens_site_exception_set(AgensWindow* window, const char* site, const char* kind, AgensPermission value);
+void agens_site_exception_remove(AgensWindow* window, const char* site, const char* kind);
+
+// Extensões instaladas neste ato (not the built-in ones).
+typedef struct {
+  const char* id;
+  const char* name;
+  const char* version;
+  int enabled;
+} AgensExtension;
+typedef void (*AgensExtensionsFn)(void* context, const AgensExtension* extensions, int count);
+void agens_extensions(AgensWindow* window, AgensExtensionsFn fn, void* context);  // calls now
+void agens_extension_set_enabled(AgensWindow* window, const char* id, int enabled);
+void agens_extension_remove(AgensWindow* window, const char* id);
+
+// Senhas salvas. The list carries no passwords; agens_password_get copies one (the UI asks for
+// Touch ID first). Indexes refer to the last list delivered.
+typedef struct {
+  const char* site;
+  const char* username;
+} AgensLogin;
+typedef void (*AgensLoginsFn)(void* context, const AgensLogin* logins, int count);
+void agens_passwords(AgensWindow* window, AgensLoginsFn fn, void* context);  // calls later
+int agens_password_get(AgensWindow* window, int index, char* out, int size);
+void agens_password_remove(AgensWindow* window, int index);
+
+// Histórico of this window's ato, newest first, one entry per page per day, at most 300.
+// `text` filters by title and address ("" for all). Calls `fn` later, once.
+typedef struct {
+  const char* url;
+  const char* title;
+  double time;  // seconds since 1970
+} AgensVisit;
+typedef void (*AgensHistoryFn)(void* context, const AgensVisit* visits, int count);
+void agens_history(AgensWindow* window, const char* text, AgensHistoryFn fn, void* context);
+// Removes every visit to that page.
+void agens_history_remove(AgensWindow* window, const char* url);
+
+// Asks the system to make this browser the default for links (macOS shows its own prompt).
+void agens_window_set_default_browser(AgensWindow* window);
+
+// Implemented by the interface. The chrome is a platform view (NSView* on macOS) the size of the
+// window, returned retained; it must let clicks through where the page sits. The engine puts the
+// page where agens_ui_layout says, and calls destroy when the window closes.
+void* agens_ui_create_chrome(AgensWindow* window);
+AgensRect agens_ui_layout(void* chrome, int width, int height);
+void agens_ui_focus_address(void* chrome);
+// Where Chromium anchors its bubbles (permissions, site info): the address's site icon.
+AgensRect agens_ui_site_icon_rect(void* chrome);
+// Colors the engine paints behind the chrome: the window (0xAARRGGBB, so a theme can let the
+// desktop or an image show through), the page card and its border (0xRRGGBB).
+void agens_ui_colors(void* chrome, unsigned* window, unsigned* page, unsigned* line);
+void agens_ui_destroy_chrome(void* chrome);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_EMBED_H_
