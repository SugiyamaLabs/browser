+static NSString* MB(long long kb) {
+  return kb > 0 ? [NSString stringWithFormat:@"%lld MB", (kb + 512) / 1024] : @"—";
+}
+static NSString* SiteHost(NSString* url) {
+  NSString* host = [NSURL URLWithString:url].host.lowercaseString ?: @"";
+  return [host hasPrefix:@"www."] ? [host substringFromIndex:4] : host;
+}
+- (std::vector<std::string>)neverSleepSites {
+  std::vector<std::string> sites;
+  if (_window) agens_pref_get_list(_window, kAgensProfile, "performance_tuning.tab_discarding.exceptions", StringsListed, &sites);
+  return sites;
+}
+- (BOOL)neverSleeps:(NSString*)host {
+  for (const std::string& site : [self neverSleepSites]) {
+    NSString* s = @(site.c_str());
+    if (host.length && ([host isEqualToString:s] || [host hasSuffix:[@"." stringByAppendingString:s]])) return YES;
+  }
+  return NO;
+}
+// Why this tab doesn't sleep now (the card and the menu say it), nil when it can.
+- (NSString*)sleepBlocker:(AgensTabRow*)row {
+  if (row.selected) return @"é a aba aberta";
+  if (row.audible) return @"tocando áudio";
+  if (row.capturing) return @"usando câmera ou microfone";
+  if (row.pinned) return @"fixada";
+  if ([self neverSleeps:SiteHost(row.url)]) return @"site que nunca dorme";
+  return nil;
+}
