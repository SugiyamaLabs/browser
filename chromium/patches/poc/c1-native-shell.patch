+@interface AgensSidebarController : NSObject <NSTextFieldDelegate>
+@property(nonatomic, readonly) NSView* view;
+@property(nonatomic, readonly) NSTextField* address;
+- (instancetype)initWithShell:(agens::NativeShellView*)shell;
+- (void)setTabs:(NSArray<NSString*>*)titles active:(NSInteger)active url:(NSString*)url;
+@end
