+- (void)setDownloads:(const AgensDownload*)downloads count:(int)count started:(BOOL)started {
+  _downloadNames.clear();
+  for (int i = 0; i < count; ++i) _downloadNames.push_back(downloads[i].name);
+  _downloads.assign(downloads, downloads + count);
+  for (int i = 0; i < count; ++i) _downloads[i].name = _downloadNames[i].c_str();  // keep our copies
+  BOOL running = std::any_of(_downloads.begin(), _downloads.end(), [](const AgensDownload& d) { return d.state == kAgensDownloading; });
+  _downloadsButton.hidden = count == 0;
+  [_downloadsButton setTint:running ? kLight3 : kDim];
+  _downloadsButton.accessibilityLabel = running ? @"Downloads em andamento" : @"Downloads";
+  [self relayout];
+  if (started) {
+    [self showDownloads];  // like Chrome: a new download opens the list
+  } else if (_downloadsPanel) {
+    [self fillDownloads];
+  }
+}
+- (void)toggleDownloads {
+  if (_downloadsPanel) {
+    [self closeMenu];
+  } else {
+    [self showDownloads];
+  }
+}
+- (void)showDownloads {
+  const CGFloat w = 340;
+  NSView* panel = [self popoverWidth:w height:10 under:_downloadsButton];
+  panel.accessibilityRole = NSAccessibilityListRole;
+  panel.accessibilityLabel = @"Downloads";
+  [self presentPopover:panel anchor:_downloadsButton];
+  _downloadsPanel = panel;
+  [self fillDownloads];
+}
+- (void)fillDownloads {
+  const CGFloat w = NSWidth(_downloadsPanel.frame), rowH = 48;
+  const int count = (int)MIN(_downloads.size(), (size_t)6);
+  for (NSView* v in [_downloadsPanel.subviews copy]) [v removeFromSuperview];
+  NSRect f = _downloadsPanel.frame;
+  f.size.height = count * rowH + 10;
+  _downloadsPanel.frame = f;
+  __weak AgensChrome* weak = self;
+  CGFloat y = f.size.height - 5 - rowH;
+  for (int i = 0; i < count; ++i) {
+    AgensDownloadRow* row = [[AgensDownloadRow alloc] initWithFrame:NSMakeRect(5, y, w - 10, rowH)];
+    [row updateWith:_downloads[i]];
+    const BOOL done = _downloads[i].state == kAgensDownloaded;
+    row.onPress = ^{
+      AgensChrome* strong = weak;
+      if (strong && done && strong->_window) agens_window_download_open(strong->_window, i);
+    };
+    row.onShow = ^{
+      AgensChrome* strong = weak;
+      if (strong && strong->_window) agens_window_download_show(strong->_window, i);
+    };
+    row.onCancel = ^{
+      AgensChrome* strong = weak;
+      if (strong && strong->_window) agens_window_download_cancel(strong->_window, i);
+    };
+    [_downloadsPanel addSubview:row];
+    y -= rowH;
+  }
+}
+- (void)closeMenu {
+  [_menuView removeFromSuperview];
+  _menuView = nil;
+  _popoverAnchor = nil;
+  _downloadsPanel = nil;
+  if (_clickMonitor) [NSEvent removeMonitor:_clickMonitor];
+  _clickMonitor = nil;
+}
+- (void)menuNewTab:(id)sender {
+  [self run:agens_window_new_tab];
+}
+- (void)menuBookmarks:(id)sender {
+  if (_window) agens_window_open_page(_window, kAgensBookmarks);
+}
+- (void)menuHistory:(id)sender {
+  if (_window) agens_window_open_page(_window, kAgensHistory);
+}
+- (void)menuSettings:(id)sender {
+  if (_window) [AgensSettings showFor:_window collapsed:_collapsed chrome:self];
+}
+// Open/close the column with the prototype's motion (width, .32s, ease-out); instant with
+// "Reduzir movimento". Each frame lays out the chrome and asks the engine to move the page.
+- (BOOL)collapsed {
+  return _collapsed;
+}
+- (NSArray<NSString*>*)atoNamesForSettings {
+  return [_atoNames copy];
+}
+- (void)toggleSidebar {
+  _collapsed = !_collapsed;
+  [NSUserDefaults.standardUserDefaults setBool:_collapsed forKey:kCollapsedKey];
+  [_sideTimer invalidate];
+  const CGFloat from = _sideW, to = _collapsed ? kRail : kSide;
+  if (NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion) {
+    [self setSideWidth:to];
+    return;
+  }
+  const CFTimeInterval start = CACurrentMediaTime(), duration = 0.32;
+  __weak AgensChrome* weak = self;
+  _sideTimer = [NSTimer timerWithTimeInterval:1.0 / 120 repeats:YES block:^(NSTimer* timer) {
+    AgensChrome* strong = weak;
+    if (!strong) {
+      [timer invalidate];
+      return;
+    }
+    double t = MIN(1.0, (CACurrentMediaTime() - start) / duration);
+    [strong setSideWidth:from + (to - from) * (1 - pow(1 - t, 3))];
+    if (t >= 1) [timer invalidate];
+  }];
+  [NSRunLoop.currentRunLoop addTimer:_sideTimer forMode:NSRunLoopCommonModes];
+}
+- (void)setSideWidth:(CGFloat)width {
+  _sideW = width;
+  [self relayout];
+  if (_window) agens_window_relayout(_window);  // the page moves with the column
+}
+- (void)run:(void (*)(AgensWindow*))action {
+  if (_window) action(_window);
+}
+- (void)reloadOrStop {
+  [self run:_loading ? agens_window_stop : agens_window_reload];
+}
+// Unpinned tabs reorder by dragging: up and down the column, sideways on top. Pinned ones stay put.
+- (void)dragRow:(AgensTabRow*)row by:(NSPoint)delta {
+  if (row.pinned) return;
+  if (!_dragged) {
+    _dragged = row;
+    [row.superview addSubview:row positioned:NSWindowAbove relativeTo:nil];  // on top of the others
+  }
+  const int slot = row.index - _pinnedCount, last = (int)_rows.count - 1 - _pinnedCount;
+  NSRect f = row.frame;
+  if (_top) {
+    CGFloat x = MAX(_listX, MIN(_listX + slot * _tabStep + delta.x, _listX + last * _tabStep));
+    _dropIndex = _pinnedCount + (int)lround((x - _listX) / _tabStep);
+    f.origin.x = x;
+  } else {
+    const CGFloat step = kRow + 1;
+    CGFloat y = MAX(0, MIN(slot * step + delta.y, last * step));
+    _dropIndex = _pinnedCount + (int)lround(y / step);
+    f.origin.y = y;
+  }
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* ctx) {
+    ctx.duration = 0.12;
+    ctx.allowsImplicitAnimation = YES;
+    [self relayout];
+  }];
+  row.frame = f;
+}
+- (void)dropRow:(AgensTabRow*)row {
+  if (row != _dragged) return;
+  const int from = row.index, to = _dropIndex;
+  _dragged = nil;
+  if (_window && from != to) agens_window_move_tab(_window, from, to);
+  [self relayout];
+}
+// Tabs on top or in the column (⌘⇧S and Configurações › Aparência), for every window.
+- (BOOL)tabsOnTop {
+  return _top;
+}
+- (void)toggleTabsPosition {
+  [NSUserDefaults.standardUserDefaults setBool:!_top forKey:kTabsOnTopKey];
+  [NSNotificationCenter.defaultCenter postNotificationName:kThemeChanged object:nil];
+}
+- (void)setTop:(BOOL)top {
+  if (top == _top) return;
+  [_sideTimer invalidate];
+  _sideW = _collapsed ? kRail : kSide;
+  _top = top;
+}
+- (void)activate:(int)index {
+  if (_window) agens_window_activate_tab(_window, index);
+}
+- (void)close:(int)index {
+  if (_window) agens_window_close_tab(_window, index);
+}
+- (void)go:(NSTextField*)sender {
+  if (_window && sender.stringValue.length) agens_window_navigate(_window, sender.stringValue.UTF8String);
+  [self closeSuggestions];
+}
+- (void)detach {
+  [_backdrop removeFromSuperview];
+  [AgensSettings forget:_window];
+  [AgensFirstRun forget:_window];
+  [NSNotificationCenter.defaultCenter removeObserver:self];
+  [_sideTimer invalidate];
+  [self closeMenu];
+  if (_keyMonitor) [NSEvent removeMonitor:_keyMonitor];
+  _keyMonitor = nil;
+  if (_menuMonitor) [NSEvent removeMonitor:_menuMonitor];
+  _menuMonitor = nil;
+  if (_window) {
+    agens_window_set_tabs_observer(_window, nullptr, nullptr);
+    agens_window_set_atos_observer(_window, nullptr, nullptr);
+    agens_window_set_suggestions_observer(_window, nullptr, nullptr);
+    agens_window_set_status_observer(_window, nullptr, nullptr);
+    agens_window_set_downloads_observer(_window, nullptr, nullptr);
+  }
+  _window = nullptr;
+}
+- (void)focusAddress {
+  if (!_ntp.hidden) {  // a new tab: type in the page's own big field
+    [self.window makeFirstResponder:_ntp.field];
+    return;
+  }
+  _address.stringValue = _url;  // the full address while editing
+  [self.window makeFirstResponder:_address];
+}
+@end
+
+extern "C" {
+
+void* agens_ui_create_chrome(AgensWindow* window) {
+  return (__bridge_retained void*)[[AgensChrome alloc] initWithWindow:window];
+}
+AgensRect agens_ui_layout(void* chrome, int width, int height) {
+  return [(__bridge AgensChrome*)chrome layoutForWidth:width height:height];
+}
+AgensRect agens_ui_site_icon_rect(void* chrome) {
+  return [(__bridge AgensChrome*)chrome siteIconRect];
+}
+void agens_ui_focus_address(void* chrome) {
+  [(__bridge AgensChrome*)chrome focusAddress];
+}
+void agens_ui_colors(void* chrome, unsigned* window, unsigned* page, unsigned* line) {
+  [(__bridge AgensChrome*)chrome colorsWindow:window page:page line:line];
+}
+void agens_ui_destroy_chrome(void* chrome) {
+  [(__bridge AgensChrome*)chrome detach];
+}
+
+}  // extern "C"
