+void ShowNativeInstallDialog(std::unique_ptr<ExtensionInstallPromptShowParams> params,
+                             ExtensionInstallPrompt::DoneCallback done,
+                             std::unique_ptr<extensions::InstallPromptData> prompt) {
+  const extensions::Extension* extension = prompt->extension();
+  Profile* profile = params->profile() ? params->profile()->GetOriginalProfile() : nullptr;
+  content::WebContents* from_tab = params->GetParentWebContents();
+  const GURL from_url = from_tab ? from_tab->GetLastCommittedURL() : GURL();
+  const std::string from =
+      prompt->has_webstore_data() ? "store"
+      : extension && extension->location() == extensions::mojom::ManifestLocation::kUnpacked ? "folder"
+      : from_url.SchemeIsHTTPOrHTTPS() ? url::Origin::Create(from_url).Serialize()
+                                       : "file";
+  // Only a new install picks atos: a re-enable or a permissions prompt is about this ato's copy.
+  const bool choose = extension && profile && prompt->type() == extensions::InstallPromptData::INSTALL_PROMPT;
+  const std::string id = extension ? extension->id() : std::string();
+  // The person's answer: the prompt goes on, and the atos they chose get it once this one has it.
+  auto answered = base::BindOnce(
+      [](ExtensionInstallPrompt::DoneCallback done, base::WeakPtr<Profile> profile, std::string id, bool allow,
+         std::vector<std::string> atos) {
+        if (allow && profile && !atos.empty()) ext::AlsoInstallInto(profile.get(), id, std::move(atos));
+        std::move(done).Run(ExtensionInstallPrompt::DoneCallbackPayload(
+            allow ? ExtensionInstallPrompt::Result::ACCEPTED : ExtensionInstallPrompt::Result::USER_CANCELED));
+      },
+      std::move(done), profile ? profile->GetWeakPtr() : base::WeakPtr<Profile>(), id);
+  base::ListValue atos = choose ? ext::AtoChoices(id) : base::ListValue();
+  if (IsEmbedded()) {
+    // The host asks the person, whoever drives the tabs; the agent never installs.
+    base::DictValue fields;
+    fields.Set("name", extension ? extension->name() : std::string());
+    fields.Set("version", extension ? extension->VersionString() : std::string());
+    base::ListValue permissions;
+    for (size_t i = 0; i < prompt->GetPermissionCount(); ++i) {
+      permissions.Append(base::UTF16ToUTF8(prompt->GetPermission(i)));
+    }
+    fields.Set("permissions", std::move(permissions));
+    base::ListValue hosts;
+    if (extension) {
+      for (const std::string& pattern :
+           extension->permissions_data()->active_permissions().effective_hosts().ToStringVector()) {
+        hosts.Append(pattern);
+      }
+    }
+    fields.Set("host_permissions", std::move(hosts));
+    fields.Set("from", from);
+    if (profile) fields.Set("ato", ext::AtoId(profile));
+    if (extension) fields.Set("id", id);
+    if (!prompt->icon().IsEmpty()) {
+      // Small: a 32 px picture, whatever size the prompt loaded.
+      const gfx::ImageSkia small = gfx::ImageSkiaOperations::CreateResizedImage(
+          prompt->icon().AsImageSkia(), skia::ImageOperations::RESIZE_BEST, gfx::Size(32, 32));
+      if (std::vector<uint8_t> png = ext::EncodePng(gfx::Image(small), 1); !png.empty()) {
+        fields.Set("icon", base::Base64Encode(png));
+      }
+    }
+    if (choose) fields.Set("atos", std::move(atos));
+    bridge::ui_ask::Ask(nullptr, "extension", std::move(fields),
+                        base::BindOnce(
+                            [](base::OnceCallback<void(bool, std::vector<std::string>)> answered,
+                               std::unique_ptr<extensions::InstallPromptData>, const base::DictValue* answer) {
+                              const bool allow = answer && answer->FindBool("allow").value_or(false);
+                              std::vector<std::string> chosen;
+                              if (const base::ListValue* list = allow ? answer->FindList("atos") : nullptr) {
+                                for (const base::Value& ato : *list) chosen.push_back(ato.GetString());
+                              }
+                              std::move(answered).Run(allow, std::move(chosen));
+                            },
+                            std::move(answered), std::move(prompt)));
+    return;
+  }
+  AskInstallSheet(params->GetParentWindow().GetNativeNSWindow(), *prompt, from,
+                  profile ? ext::AtoId(profile) : std::string(), choose ? &atos : nullptr, std::move(answered));
+}
