+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/control_keys.h"
+
+#include <algorithm>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+
+namespace agens::bridge {
+
+namespace {
+
+struct Named {
+  const char* name;
+  int windows_code;
+  bool edits;
+};
+// DOM key and code are the same string for all of these.
+constexpr Named kNamed[] = {
+    {"Enter", 0x0D, false},     {"Tab", 0x09, false},        {"Escape", 0x1B, false},
+    {"Backspace", 0x08, true},  {"Delete", 0x2E, true},      {"ArrowUp", 0x26, false},
+    {"ArrowDown", 0x28, false}, {"ArrowLeft", 0x25, false},  {"ArrowRight", 0x27, false},
+    {"PageUp", 0x21, false},    {"PageDown", 0x22, false},   {"Home", 0x24, false},
+    {"End", 0x23, false},
+};
+
+}  // namespace
+
+std::optional<Key> ParseKey(std::string_view name, const base::Value* modifiers) {
+  Key key;
+  if (modifiers) {
+    if (!modifiers->is_list()) return std::nullopt;
+    for (const base::Value& m : modifiers->GetList()) {
+      const std::string* s = m.GetIfString();
+      if (!s) return std::nullopt;
+      if (*s == "shift") {
+        key.shift = true;
+      } else if (*s == "meta") {
+        key.meta = true;
+      } else if (*s == "alt") {
+        key.alt = true;
+      } else if (*s == "ctrl") {
+        key.ctrl = true;
+      } else {
+        return std::nullopt;
+      }
+    }
+  }
+  for (const Named& n : kNamed) {
+    if (name == n.name) {
+      key.key = key.code = n.name;
+      key.windows_code = n.windows_code;
+      key.edits = n.edits;
+      if (key.key == "Enter") key.text = u"\r";
+      return key;
+    }
+  }
+  std::u16string text;
+  if (!base::UTF8ToUTF16(name.data(), name.size(), &text) || text.empty() || text.size() > 2) return std::nullopt;
+  if (text.size() == 2 && !(text[0] >= 0xD800 && text[0] < 0xDC00)) return std::nullopt;  // two characters
+  if (text[0] < 0x20 || text[0] == 0x7F) return std::nullopt;  // control characters: use the names
+  key.key = std::string(name);
+  key.text = text;
+  key.edits = true;
+  const char16_t c = text.size() == 1 ? text[0] : 0;
+  if (c >= 'a' && c <= 'z') {
+    key.windows_code = c - 'a' + 'A';
+  } else if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+    key.windows_code = c;
+  } else if (c == ' ') {
+    key.windows_code = 0x20;
+    key.code = "Space";
+  }
+  if (key.windows_code >= 'A' && key.windows_code <= 'Z') {
+    key.code = std::string("Key") + static_cast<char>(key.windows_code);
+  } else if (key.windows_code >= '0' && key.windows_code <= '9') {
+    key.code = std::string("Digit") + static_cast<char>(key.windows_code);
+  }
+  if (key.meta || key.ctrl) key.text.clear();  // a shortcut, not typing
+  return key;
+}
+
+bool AllowedOnPassword(const Key& key) {
+  return !key.edits && !key.meta && !key.alt && !key.ctrl;
+}
+
+bool KeyAllowed(const Key& key, bool on_password, bool clipboard) {
+  if (TouchesClipboard(key)) return clipboard;
+  return !on_password || AllowedOnPassword(key);
+}
+
+std::optional<std::vector<std::string>> ParseAllow(const base::Value* value) {
+  std::vector<std::string> allow;
+  if (!value) return allow;
+  if (!value->is_list()) return std::nullopt;
+  for (const base::Value& item : value->GetList()) {
+    const std::string* s = item.GetIfString();
+    if (!s || (*s != "passwords" && *s != "clipboard" && *s != "eval")) return std::nullopt;
+    if (!std::ranges::contains(allow, *s)) allow.push_back(*s);
+  }
+  std::ranges::sort(allow);
+  return allow;
+}
+
+std::string AllowDetail(const std::vector<std::string>& allow) {
+  std::vector<std::string> asks;
+  if (std::ranges::contains(allow, std::string("passwords"))) {
+    asks.push_back("usar senhas salvas e preenchimento automático (endereços e cartões)");
+  }
+  if (std::ranges::contains(allow, std::string("clipboard"))) asks.push_back("copiar e colar");
+  if (std::ranges::contains(allow, std::string("eval"))) asks.push_back("rodar JavaScript em endereços locais (localhost)");
+  if (asks.empty()) return std::string();
+  std::string detail = "Pede também: " + JoinNames(asks);
+  if (std::ranges::contains(allow, std::string("clipboard"))) detail += "\n\nCom copiar e colar, o agente pode ler o que você copiou em qualquer app, inclusive senhas, e trocar o que "
+              "está copiado.";
+  return detail;
+}
+
+std::string ControlAlwaysKey(std::string_view identity,
+                             std::string_view ato,
+                             std::vector<std::string> shares_with,
+                             const std::vector<std::string>& allow) {
+  std::ranges::sort(shares_with);
+  base::ListValue key;  // JSON: no separator a name could contain
+  key.Append(identity);
+  key.Append(ato);
+  for (std::string& folder : shares_with) key.Append(std::move(folder));
+  if (!allow.empty()) {  // a dict, so it never reads as a folder; none keeps the older keys as they were
+    base::ListValue asked;
+    for (const std::string& a : allow) asked.Append(a);
+    base::DictValue wrapped;
+    wrapped.Set("allow", std::move(asked));
+    key.Append(std::move(wrapped));
+  }
+  return base::WriteJson(key).value_or(std::string());
+}
+
+std::string JoinNames(const std::vector<std::string>& names) {
+  std::string out;
+  for (size_t i = 0; i < names.size(); ++i) {
+    if (i) out += i + 1 == names.size() ? " e " : ", ";
+    out += names[i];
+  }
+  return out;
+}
+
+bool IsDisplayText(std::string_view utf8, size_t max) {
+  std::u16string text;
+  if (utf8.empty() || !AtMostChars(utf8, max) || !base::UTF8ToUTF16(utf8.data(), utf8.size(), &text)) return false;
+  return std::none_of(text.begin(), text.end(), [](char16_t c) {
+    return c < 0x20 || (c >= 0x7F && c < 0xA0) || c == 0x061C || (c >= 0x200E && c <= 0x200F) ||
+           (c >= 0x202A && c <= 0x202E) || (c >= 0x2060 && c <= 0x2064) || (c >= 0x2066 && c <= 0x2069) ||
+           c == 0x2028 || c == 0x2029;
+  });
+}
+
+bool PauseBlocks(std::string_view op) {
+  return op.starts_with("tab.") || op.starts_with("page.");
+}
+
+bool DialogBlocks(std::string_view op) {
+  return op.starts_with("page.") && op != "page.dialog";
+}
+
+bool IsLocalURL(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() || url.has_password()) return false;
+  const std::string_view host = url.host();  // canonical: lowercase, IPv4 in dotted form, IPv6 in brackets
+  return host == "localhost" || (host.size() > 10 && host.ends_with(".localhost")) || host == "127.0.0.1" ||
+         host == "[::1]";
+}
+
+bool IsInsecurePage(const GURL& url) {
+  return url.is_valid() && url.SchemeIs("http") && !IsLocalURL(url);
+}
+
+bool KeyTypes(const Key& key) {
+  if (TouchesClipboard(key)) return key.windows_code == 'V';
+  return !key.text.empty() && key.text != u"\r" && !key.meta && !key.ctrl;
+}
+
+std::string MarkInsecure(std::string line) {
+  std::optional<base::Value> value = base::JSONReader::Read(line, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict() || value->GetDict().FindBool("ok") != true) return line;
+  value->GetDict().Set("insecure", true);
+  return base::WriteJson(*value).value_or(line) + "\n";
+}
+
+std::string ClipChars(std::string text, size_t max) {
+  size_t count = 0;
+  for (size_t i = 0; i < text.size(); ++i) {
+    if ((static_cast<unsigned char>(text[i]) & 0xC0) != 0x80 && ++count > max) {
+      text.resize(i);
+      break;
+    }
+  }
+  return text;
+}
+
+bool TouchesClipboard(const Key& key) {
+  if (key.key == "Delete" && key.shift) return true;  // cut, on Windows and Linux
+  if (!key.meta && !key.ctrl) return false;
+  return key.windows_code == 'C' || key.windows_code == 'X' || key.windows_code == 'V';
+}
+
+}  // namespace agens::bridge
