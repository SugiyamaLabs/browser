+// Copyright 2026 SugiyamaLabs.
+// The control session (docs/protocolo.md, "control, tab, page"): an app, after the person's OK,
+// drives tabs of one ato. It belongs to the connection and ends on control.stop, when the
+// connection closes, or when the person presses "Encerrar" on a controlled tab's pill. The person
+// can also take the tabs over ("Assumir": the session pauses, its ops answer `paused`) and hand
+// them back ("Devolver").
+// - It only ever sees the tabs it opened: ids are its own, valid for this session only.
+// - Controlled tabs are marked (AgensControlled): the shell shows it; saved passwords, autofill
+//   and downloads stay out of them.
+
+#include "chrome/browser/agens/bridge/control_ops.h"
+
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <map>
+#include <optional>
+#include <memory>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/bridge.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+#include "chrome/browser/agens/bridge/control_page.h"
+#include "chrome/browser/agens/bridge/ui_ops.h"
+#include "chrome/browser/agens/embed/agens_controlled.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/agens/embed/native_shell.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "components/javascript_dialogs/tab_modal_dialog_manager.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/invalidate_type.h"
+#include "content/public/browser/javascript_dialog_manager.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace agens::bridge::control {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr size_t kMaxReasonChars = 1024;
+// tab.open and tab.navigate answer when the navigation commits or fails, or after this.
+constexpr base::TimeDelta kNavigationWait = base::Seconds(30);
+constexpr size_t kMaxTypeChars = 10000;
+constexpr size_t kMaxAgentChars = 40;
+constexpr size_t kMaxStatusChars = 120;
+
+constexpr size_t kMaxEvalChars = 100000;
+constexpr size_t kMaxDialogChars = 2000;
+constexpr size_t kMaxHeldDialogs = 8;  // per tab
+
+void StopByUser(uint64_t connection);
+void Pause(uint64_t connection);
+void Resume(uint64_t connection);
+content::JavaScriptDialogManager* Dialogs();
+
+// Where a controlled tab's dialog goes when the agent doesn't hold it: the browser's own, or,
+// embedded, the host's (ui.ask).
+content::JavaScriptDialogManager* NormalDialogs(content::WebContents* contents) {
+  if (content::JavaScriptDialogManager* host = agens::EmbeddedDialogManager()) return host;
+  return javascript_dialogs::TabModalDialogManager::FromWebContents(contents);
+}
+
+// A JavaScript dialog a controlled tab opened, held for page.dialog.
+struct HeldDialog {
+  std::string type;  // "alert", "confirm", "prompt", "beforeunload"
+  std::u16string message, default_prompt;
+  content::GlobalRenderFrameHostId frame;
+  bool is_reload = false;  // beforeunload's
+  content::JavaScriptDialogManager::DialogClosedCallback done;
+};
+
+// A tab the session opened. Marks it while it lives, and unmarks it when the session lets go.
+class Tab : public content::WebContentsObserver {
+ public:
+  // The session fills the mark's text (Sync).
+  Tab(uint64_t connection, std::string id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), id(std::move(id)), page(contents), connection_(connection) {
+    AgensControlled::CreateForWebContents(contents);
+    AgensControlled* mark = AgensControlled::FromWebContents(contents);
+    mark->stop = base::BindRepeating(&StopByUser, connection);
+    mark->take_over = base::BindRepeating(&Pause, connection);
+    mark->hand_back = base::BindRepeating(&Resume, connection);
+    mark->dialogs = Dialogs();
+    // The agent's cursor on the pill's page: where it last clicked or hovered.
+    page.on_pointer = base::BindRepeating(
+        [](content::WebContents* contents, gfx::PointF point) {
+          if (AgensControlled* mark = AgensControlled::FromWebContents(contents)) {
+            mark->cursor_x = point.x();
+            mark->cursor_y = point.y();
+            contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+          }
+        },
+        contents);
+    // Keeps rendering while in the background: input, screenshots and the accessibility tree work
+    // on a tab that isn't the active one.
+    capture_ = contents->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+                                                /*is_activity=*/false);
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);  // the shell redraws it
+  }
+  ~Tab() override {
+    Answer(ErrorReply(&waiting_id_, kFailed, "the tab is no longer controlled"));
+    ReleaseDialog();  // the tab stays open: its dialog goes to the person
+    if (content::WebContents* contents = web_contents()) {
+      contents->RemoveUserData(AgensControlled::UserDataKey());
+      contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+    }
+  }
+
+  const std::string id;  // "t1", "t2"… for this session
+  Page page;
+
+  // Answers `request_id` with {tab} once `navigation_id` finishes (or kNavigationWait passes);
+  // kNextNavigation: the next one of the main frame to finish (history and reload give no handle).
+  static constexpr int64_t kNextNavigation = -1;
+  void WaitFor(int64_t navigation_id, base::Value request_id, ReplyCallback reply) {
+    AnswerOk();  // an earlier wait: its navigation was replaced by this one
+    waiting_navigation_ = navigation_id;
+    waiting_id_ = std::move(request_id);
+    waiting_reply_ = std::move(reply);
+    waiting_timer_.Start(FROM_HERE, kNavigationWait, base::BindOnce(&Tab::AnswerOk, base::Unretained(this)));
+  }
+  void AnswerOk() {
+    base::DictValue result;
+    result.Set("tab", id);
+    Answer(OkReply(waiting_id_, std::move(result)));
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (waiting_reply_ && (handle->GetNavigationId() == waiting_navigation_ ||
+                           (waiting_navigation_ == kNextNavigation && handle->IsInPrimaryMainFrame()))) {
+      AnswerOk();  // a failed load is ok too
+    }
+  }
+  void WebContentsDestroyed() override;
+
+  bool HasDialog() const { return !dialogs_.empty(); }
+  // Holds `dialog` behind any already held (up to kMaxHeldDialogs; past that it's dismissed) and
+  // tells the client; the ops waiting on this tab can't run while one is open.
+  void Hold(HeldDialog dialog) {
+    if (dialogs_.size() >= kMaxHeldDialogs) return std::move(dialog.done).Run(false, std::u16string());
+    base::DictValue fields;
+    fields.Set("tab", id);
+    fields.Set("type", dialog.type);
+    fields.Set("message", ClipChars(base::UTF16ToUTF8(dialog.message), kMaxDialogChars));
+    dialogs_.push_back(std::move(dialog));
+    page.FailWaiting(kDialogOpen, "a dialog is open: answer it with page.dialog");
+    SendEventTo(connection_, "page.dialog", std::move(fields));
+  }
+  // The agent's answer to the oldest (page.dialog), or content closing it (accept false). False
+  // when none.
+  bool AnswerDialog(bool accept, const std::u16string* text) {
+    if (dialogs_.empty()) return false;
+    HeldDialog dialog = std::move(dialogs_.front());
+    dialogs_.pop_front();
+    std::move(dialog.done).Run(accept, accept ? (text ? *text : dialog.default_prompt) : std::u16string());
+    return true;
+  }
+  // Content cancels them all (a navigation, the tab closing).
+  void DismissDialogs() {
+    while (AnswerDialog(false, nullptr)) {
+    }
+  }
+  // The oldest to the person, as the browser shows any dialog ("Assumir", or the session let go);
+  // the browser shows one at a time, so the newer ones are dismissed.
+  void ReleaseDialog() {
+    if (dialogs_.empty()) return;
+    HeldDialog dialog = std::move(dialogs_.front());
+    dialogs_.pop_front();
+    DismissDialogs();
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(dialog.frame);
+    content::JavaScriptDialogManager* normal = web_contents() ? NormalDialogs(web_contents()) : nullptr;
+    if (!frame || !normal) return std::move(dialog.done).Run(false, std::u16string());
+    if (dialog.type == "beforeunload") {
+      return normal->RunBeforeUnloadDialog(web_contents(), frame, dialog.is_reload, std::move(dialog.done));
+    }
+    // It may suppress the dialog (a background tab) without answering: then it's a "Cancel".
+    auto [shown, suppressed] = base::SplitOnceCallback(std::move(dialog.done));
+    bool did_suppress = false;
+    const content::JavaScriptDialogType type = dialog.type == "alert"     ? content::JAVASCRIPT_DIALOG_TYPE_ALERT
+                                               : dialog.type == "confirm" ? content::JAVASCRIPT_DIALOG_TYPE_CONFIRM
+                                                                          : content::JAVASCRIPT_DIALOG_TYPE_PROMPT;
+    normal->RunJavaScriptDialog(web_contents(), frame, type, dialog.message, dialog.default_prompt, std::move(shown),
+                                &did_suppress);
+    if (did_suppress) std::move(suppressed).Run(false, std::u16string());
+  }
+  base::WeakPtr<Tab> GetWeakPtr() { return weak_.GetWeakPtr(); }
+
+ private:
+  void Answer(std::string line) {
+    waiting_timer_.Stop();
+    if (waiting_reply_) std::move(waiting_reply_).Run(std::move(line));
+  }
+
+  const uint64_t connection_;
+  base::ScopedClosureRunner capture_;
+  int64_t waiting_navigation_ = 0;
+  base::Value waiting_id_;
+  ReplyCallback waiting_reply_;
+  base::OneShotTimer waiting_timer_;
+  std::deque<HeldDialog> dialogs_;  // oldest first
+  base::WeakPtrFactory<Tab> weak_{this};
+};
+
+// One app's control of one ato.
+struct Session {
+  std::string agent;   // the name shown on its tabs: control.start's agent, else the app's name
+  std::string reason;  // control.start's: the pill's default detail
+  std::string title, detail;  // control.status; empty for the defaults
+  bool paused = false;  // the person took over
+  bool passwords = false, clipboard = false, eval = false;  // control.start's allow
+  base::FilePath ato;  // the ato's profile folder
+  std::vector<std::string> shares_with;  // SharesWith(ato) when the person agreed
+  std::vector<std::unique_ptr<Tab>> tabs;
+  int next_tab = 1;
+
+  Tab* Find(const std::string& id) {
+    for (auto& tab : tabs) {
+      if (tab->id == id) return tab.get();
+    }
+    return nullptr;
+  }
+};
+std::map<uint64_t, Session>& Sessions() {
+  static base::NoDestructor<std::map<uint64_t, Session>> sessions;
+  return *sessions;
+}
+
+// The session's state onto its tabs' marks, and the shell redraws them.
+void Sync(Session& session) {
+  for (auto& tab : session.tabs) {
+    content::WebContents* contents = tab->web_contents();
+    AgensControlled* mark = contents ? AgensControlled::FromWebContents(contents) : nullptr;
+    if (!mark) continue;
+    mark->by = session.agent;
+    mark->title = session.title.empty() ? session.agent + " está usando esta aba" : session.title;
+    mark->detail = session.detail.empty() ? session.reason : session.detail;
+    mark->paused = session.paused;
+    mark->passwords = session.passwords;
+    tab->page.clipboard = session.clipboard;
+    tab->page.eval = session.eval;
+    tab->page.paused = session.paused;
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+  }
+}
+
+// The dialog manager of controlled tabs (AgensControlled::dialogs, asked by the browser for each
+// dialog): holds a dialog for the agent while its session runs, else hands it to the browser's
+// own. Never destroyed: content may keep the pointer past the tab's control.
+class HeldDialogs : public content::JavaScriptDialogManager {
+ public:
+  void RunJavaScriptDialog(content::WebContents* contents,
+                           content::RenderFrameHost* frame,
+                           content::JavaScriptDialogType type,
+                           const std::u16string& message,
+                           const std::u16string& default_prompt,
+                           DialogClosedCallback done,
+                           bool* did_suppress_message) override {
+    if (Tab* tab = Holding(contents)) {
+      *did_suppress_message = false;
+      tab->Hold({type == content::JAVASCRIPT_DIALOG_TYPE_ALERT     ? "alert"
+                 : type == content::JAVASCRIPT_DIALOG_TYPE_CONFIRM ? "confirm"
+                                                                   : "prompt",
+                 message, default_prompt, frame->GetGlobalId(), false, std::move(done)});
+      return;
+    }
+    if (auto* normal = Normal(contents)) {
+      return normal->RunJavaScriptDialog(contents, frame, type, message, default_prompt, std::move(done),
+                                         did_suppress_message);
+    }
+    *did_suppress_message = true;
+  }
+  void RunBeforeUnloadDialog(content::WebContents* contents,
+                             content::RenderFrameHost* frame,
+                             bool is_reload,
+                             DialogClosedCallback done) override {
+    if (Tab* tab = Holding(contents)) {
+      return tab->Hold({"beforeunload", {}, {}, frame->GetGlobalId(), is_reload, std::move(done)});
+    }
+    if (auto* normal = Normal(contents)) return normal->RunBeforeUnloadDialog(contents, frame, is_reload, std::move(done));
+    std::move(done).Run(true, std::u16string());
+  }
+  bool HandleJavaScriptDialog(content::WebContents* contents, bool accept, const std::u16string* prompt) override {
+    if (Tab* tab = Find(contents); tab && tab->AnswerDialog(accept, prompt)) return true;
+    auto* normal = Normal(contents);
+    return normal && normal->HandleJavaScriptDialog(contents, accept, prompt);
+  }
+  void CancelDialogs(content::WebContents* contents, bool reset_state) override {
+    if (Tab* tab = Find(contents)) tab->DismissDialogs();
+    if (auto* normal = Normal(contents)) normal->CancelDialogs(contents, reset_state);
+  }
+
+ private:
+  static Tab* Find(content::WebContents* contents) {
+    for (auto& [connection, session] : Sessions()) {
+      for (auto& tab : session.tabs) {
+        if (tab->web_contents() == contents) return tab.get();
+      }
+    }
+    return nullptr;
+  }
+  // The session's tab while it isn't paused: then the person gets the dialog.
+  static Tab* Holding(content::WebContents* contents) {
+    for (auto& [connection, session] : Sessions()) {
+      for (auto& tab : session.tabs) {
+        if (tab->web_contents() == contents) return session.paused ? nullptr : tab.get();
+      }
+    }
+    return nullptr;
+  }
+  static content::JavaScriptDialogManager* Normal(content::WebContents* contents) { return NormalDialogs(contents); }
+};
+content::JavaScriptDialogManager* Dialogs() {
+  static base::NoDestructor<HeldDialogs> dialogs;
+  return dialogs.get();
+}
+
+// "Assumir": queued and new ops answer `paused`; one in flight stops before its next step
+// touches the page (Page::paused), and answers `paused` too.
+void Pause(uint64_t connection) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end() || it->second.paused) return;
+  it->second.paused = true;
+  for (auto& tab : it->second.tabs) {
+    tab->page.FailWaiting(kPaused, "the person took over the tab");
+    tab->ReleaseDialog();
+  }
+  Sync(it->second);
+  base::DictValue fields;
+  fields.Set("by", "user");
+  SendEventTo(connection, "control.paused", std::move(fields));
+}
+void Resume(uint64_t connection) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end() || !it->second.paused) return;
+  it->second.paused = false;
+  Sync(it->second);
+  // The agent holds the tab's dialogs again: those open on the host come back to it.
+  for (auto& tab : it->second.tabs) {
+    if (tab->web_contents()) ui_ask::HandDialogsTo(tab->web_contents(), Dialogs());
+  }
+  SendEventTo(connection, "control.resumed", {});
+}
+// Connections whose control.start waits for the person.
+std::set<uint64_t>& Asking() {
+  static base::NoDestructor<std::set<uint64_t>> asking;
+  return *asking;
+}
+
+void Tab::WebContentsDestroyed() {
+  // The person closed it: forget it (this deletes `this`).
+  capture_.ReplaceClosure(base::OnceClosure());
+  Observe(nullptr);
+  auto it = Sessions().find(connection_);
+  if (it == Sessions().end()) return;
+  std::erase_if(it->second.tabs, [this](const std::unique_ptr<Tab>& tab) { return tab.get() == this; });
+}
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+// Ends the session. Its tabs stay open and are no longer controlled, unless `close_tabs`.
+void End(uint64_t connection, bool close_tabs) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end()) return;
+  std::vector<std::unique_ptr<Tab>> tabs = std::move(it->second.tabs);
+  Sessions().erase(it);
+  std::vector<content::WebContents*> to_close;
+  for (auto& tab : tabs) {
+    if (close_tabs && tab->web_contents()) to_close.push_back(tab->web_contents());
+  }
+  tabs.clear();  // unmarks them
+  for (content::WebContents* contents : to_close) {
+    ui_ask::TabClosing(contents);
+    contents->Close();
+  }
+}
+
+// Ends the session from the browser's side (tabs stay open) and tells the client why.
+void Stop(uint64_t connection, std::string_view reason) {
+  if (!Sessions().contains(connection)) return;
+  End(connection, /*close_tabs=*/false);
+  base::DictValue fields;
+  fields.Set("reason", reason);
+  SendEventTo(connection, "control.stopped", std::move(fields));
+}
+void StopByUser(uint64_t connection) {
+  Stop(connection, "user");
+}
+
+// The folders of the atos whose cookies `ato` shares ("Compartilhar cookies"), sorted; empty when
+// it shares with none. Their logins are within reach of whoever controls `ato`.
+std::vector<std::string> SharesWith(const base::FilePath& ato) {
+  std::vector<std::string> folders;
+  if (!AgensWindow::AtoSharesCookies(ato)) return folders;
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath() != ato && AgensWindow::AtoSharesCookies(entry->GetPath())) {
+      folders.push_back(entry->GetPath().BaseName().AsUTF8Unsafe());
+    }
+  }
+  std::ranges::sort(folders);
+  return folders;
+}
+
+// The person's consent described the ato's cookie sharing at the time: when that changes, the
+// session ends.
+void SharingChanged() {
+  std::vector<uint64_t> ended;
+  for (const auto& [connection, session] : Sessions()) {
+    if (SharesWith(session.ato) != session.shares_with) ended.push_back(connection);
+  }
+  for (uint64_t connection : ended) Stop(connection, "sharing_changed");
+}
+void WatchSharing() {
+  static base::NoDestructor<PrefChangeRegistrar> prefs;
+  if (!prefs->IsEmpty()) return;
+  prefs->Init(g_browser_process->local_state());
+  prefs->Add(AgensWindow::kAtosPref, base::BindRepeating(&SharingChanged));
+}
+
+bool ControlAlways(const std::string& key) {
+  return std::ranges::contains(g_browser_process->local_state()->GetList(kControlAlwaysPref), base::Value(key));
+}
+
+std::optional<GURL> WebURL(const Request& request) {
+  std::optional<std::string> text = StringParam(request.body, "url");
+  if (!text) return std::nullopt;
+  GURL url(*text);
+  // Only web pages: never chrome://, file:, javascript: or data:.
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) return std::nullopt;
+  return url;
+}
+
+// What control.start asked for, carried through the approval.
+struct Wanted {
+  std::string agent, reason;
+  std::vector<std::string> allow;  // ParseAllow
+};
+
+void Start(const Client& client, Request request, ReplyCallback reply) {
+  const uint64_t connection = client.connection;
+  if (Sessions().contains(connection) || Asking().contains(connection)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "control already started on this connection"));
+    return;
+  }
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> reason = StringParam(request.body, "reason");
+  if (!id || !reason || (!reason->empty() && !IsDisplayText(*reason, kMaxReasonChars))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                    "needs ato and reason (up to 1024 characters, no control characters)"));
+    return;
+  }
+  std::optional<std::vector<std::string>> allow = ParseAllow(request.body.Find("allow"));
+  if (!allow) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "allow is a list of \"passwords\", \"clipboard\" and \"eval\""));
+    return;
+  }
+  const base::Value* agent_param = request.body.Find("agent");
+  if (agent_param && (!agent_param->is_string() || !IsDisplayText(agent_param->GetString(), kMaxAgentChars))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "agent is 1 to 40 characters, no control characters"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  const std::string name = client.name.empty() ? "app" : client.name;
+  Wanted wanted;
+  wanted.agent = agent_param ? agent_param->GetString() : name;
+  wanted.reason = *reason;
+  wanted.allow = std::move(*allow);
+  const std::string ato_name = AgensWindow::AtoName(entry);
+  std::vector<std::string> shares_with = SharesWith(entry->GetPath());
+  std::string detail = *reason;
+  if (std::string asks = AllowDetail(wanted.allow); !asks.empty()) detail += (detail.empty() ? "" : "\n\n") + asks;
+  if (!shares_with.empty()) {
+    std::vector<std::string> names;
+    for (const std::string& folder : shares_with) {
+      if (ProfileAttributesEntry* other = FindAto(folder)) names.push_back(AgensWindow::AtoName(other));
+    }
+    detail += (detail.empty() ? "" : "\n\n") + ato_name + " compartilha cookies com " + JoinNames(names) +
+              ": os logins deles também ficam ao alcance.";
+  }
+  // "Permitir sempre" only for a signed app, and only for this ato with this sharing group.
+  const bool signed_client = !client.identity.empty();
+  const std::string always_key =
+      signed_client ? ControlAlwaysKey(client.identity, entry->GetPath().BaseName().AsUTF8Unsafe(), shares_with, wanted.allow)
+                    : std::string();
+  auto begin = [](uint64_t connection, Wanted wanted, base::FilePath ato, std::vector<std::string> shares_with,
+                  std::string always_key, Request request, ReplyCallback reply, AgensApprovalAnswer answer) {
+    // Gone from Asking: the connection closed while the sheet was up.
+    if (!Asking().erase(connection)) return;
+    if (answer == kAgensApprovalDeny) {
+      std::move(reply).Run(ErrorReply(&request.id, kDenied));
+      return;
+    }
+    if (!AgensWindow::Storage().GetProfileAttributesWithPath(ato)) {
+      std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the ato is gone"));
+      return;
+    }
+    if (SharesWith(ato) != shares_with) {  // the sheet no longer says what the app could reach
+      std::move(reply).Run(ErrorReply(&request.id, kDenied, "the ato's cookie sharing changed while asking"));
+      return;
+    }
+    if (answer == kAgensApprovalAllowAlways && !always_key.empty() && !ControlAlways(always_key)) {
+      ScopedListPrefUpdate(g_browser_process->local_state(), kControlAlwaysPref)->Append(always_key);
+    }
+    WatchSharing();
+    Session& session = Sessions()[connection];
+    session.agent = std::move(wanted.agent);
+    session.reason = std::move(wanted.reason);
+    session.passwords = std::ranges::contains(wanted.allow, std::string("passwords"));
+    session.clipboard = std::ranges::contains(wanted.allow, std::string("clipboard"));
+    session.eval = std::ranges::contains(wanted.allow, std::string("eval"));
+    session.ato = std::move(ato);
+    session.shares_with = std::move(shares_with);
+    std::move(reply).Run(OkReply(request.id));
+  };
+  Asking().insert(connection);
+  if (signed_client && ControlAlways(always_key)) {
+    begin(connection, std::move(wanted), entry->GetPath(), std::move(shares_with), always_key, std::move(request), std::move(reply),
+          kAgensApprovalAllow);
+    return;
+  }
+  AskApproval(connection, "O " + name + " quer usar abas do ato " + ato_name, detail, /*offer_always=*/signed_client,
+              base::BindOnce(begin, connection, std::move(wanted), entry->GetPath(), std::move(shares_with), always_key,
+                             std::move(request), std::move(reply)));
+}
+
+// A new foreground tab in `browser` (the ato's window), controlled by the session.
+void OpenIn(uint64_t connection, GURL url, Request request, ReplyCallback reply, BrowserWindowInterface* browser) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "control ended"));
+    return;
+  }
+  Session& session = it->second;
+  if (!browser || browser->GetProfile()->GetPath() != session.ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the ato's window"));
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  base::WeakPtr<content::NavigationHandle> handle = Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the tab"));
+    return;
+  }
+  auto tab = std::make_unique<Tab>(connection, "t" + base::NumberToString(session.next_tab++), contents);
+  if (handle) {
+    tab->WaitFor(handle->GetNavigationId(), std::move(request.id), std::move(reply));
+  } else {
+    base::DictValue result;
+    result.Set("tab", tab->id);
+    std::move(reply).Run(OkReply(request.id, std::move(result)));
+  }
+  session.tabs.push_back(std::move(tab));
+  Sync(session);
+}
+
+void TabOpen(const Client& client, Request request, ReplyCallback reply) {
+  const Session& session = Sessions().at(client.connection);
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  std::optional<GURL> url = WebURL(request);
+  if (!ato || !url) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and an http or https url"));
+    return;
+  }
+  if (*ato != session.ato.BaseName().AsUTF8Unsafe()) {
+    std::move(reply).Run(ErrorReply(&request.id, kDenied, "control was approved for another ato"));
+    return;
+  }
+  // The ato's window when it has one (left where it is); otherwise open it.
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(session.ato);
+  BrowserWindowInterface* browser = nullptr;
+  if (profile) {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation([&](BrowserWindowInterface* b) {
+      if (b->GetProfile() != profile || b->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+          b->IsDeleteScheduled() || b->GetTabStripModel()->closing_all()) {
+        return true;
+      }
+      browser = b;
+      return false;
+    });
+  }
+  if (browser) {
+    OpenIn(client.connection, *url, std::move(request), std::move(reply), browser);
+    return;
+  }
+  profiles::SwitchToProfile(session.ato, /*always_create=*/false,
+                            base::BindOnce(&OpenIn, client.connection, *url, std::move(request), std::move(reply)));
+}
+
+void TabNavigate(Session& session, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  std::optional<GURL> url = WebURL(request);
+  if (!id || !url) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and an http or https url"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::NavigationController::LoadURLParams params(*url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  base::WeakPtr<content::NavigationHandle> handle = tab->web_contents()->GetController().LoadURLWithParams(params);
+  if (!handle) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "the navigation did not start"));
+    return;
+  }
+  tab->WaitFor(handle->GetNavigationId(), std::move(request.id), std::move(reply));
+}
+
+// tab.back, tab.forward and tab.reload: answer like tab.navigate.
+void TabHistory(Session& session, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::NavigationController& controller = tab->web_contents()->GetController();
+  if (request.op == "tab.back" ? !controller.CanGoBack() : request.op == "tab.forward" && !controller.CanGoForward()) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "nothing to go to in that direction"));
+    return;
+  }
+  if (request.op == "tab.reload" && controller.GetLastCommittedEntry() &&
+      controller.GetLastCommittedEntry()->GetHasPostData()) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "would resubmit a form"));
+    return;
+  }
+  tab->WaitFor(Tab::kNextNavigation, std::move(request.id), std::move(reply));
+  if (request.op == "tab.back") {
+    controller.GoBack();
+  } else if (request.op == "tab.forward") {
+    controller.GoForward();
+  } else {
+    controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/false);
+  }
+}
+
+void TabClose(Session& session, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  auto it = std::find_if(session.tabs.begin(), session.tabs.end(), [&](auto& tab) { return tab->id == *id; });
+  if (it == session.tabs.end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::WebContents* contents = (*it)->web_contents();
+  session.tabs.erase(it);  // unmarks it first
+  if (contents) {
+    ui_ask::TabClosing(contents);
+    contents->Close();
+  }
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void PageOp(Session& session, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  if (tab->HasDialog() && DialogBlocks(op)) {
+    std::move(reply).Run(ErrorReply(&request.id, kDialogOpen, "a dialog is open: answer it with page.dialog"));
+    return;
+  }
+  std::optional<std::string> ref = StringParam(request.body, "ref");
+  // Runs `method` (a Page op without other arguments) in the tab's queue.
+  auto run = [&](void (Page::*method)(base::Value, ReplyCallback)) {
+    tab->page.Run(request.id.Clone(), base::BindOnce(method, base::Unretained(&tab->page), request.id.Clone()),
+                  std::move(reply));
+  };
+  if (op == "page.console") {
+    run(&Page::Console);
+  } else if (op == "page.network") {
+    run(&Page::Network);
+  } else if (op == "page.hover") {
+    if (!ref) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and ref"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Hover, base::Unretained(&tab->page), request.id.Clone(), *ref), std::move(reply));
+  } else if (op == "page.scroll") {
+    std::optional<double> dy = request.body.FindDouble("dy");
+    const base::Value* ref_value = request.body.Find("ref");
+    if (!dy || !std::isfinite(*dy) || std::abs(*dy) > 1e6 || (ref_value && !ref)) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and dy (CSS pixels); ref is optional"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Scroll, base::Unretained(&tab->page), request.id.Clone(), ref.value_or(""), *dy),
+                  std::move(reply));
+  } else if (op == "page.eval") {
+    std::optional<std::string> js = StringParam(request.body, "js");
+    if (!js || !AtMostChars(*js, kMaxEvalChars)) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and js (up to 100000 characters)"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Eval, base::Unretained(&tab->page), request.id.Clone(), std::move(*js)),
+                  std::move(reply));
+  } else if (op == "page.dialog") {
+    std::optional<std::string> action = StringParam(request.body, "action");
+    const base::Value* text_value = request.body.Find("text");
+    std::u16string text;
+    if (!action || (*action != "accept" && *action != "dismiss") ||
+        (text_value && (!text_value->is_string() || !AtMostChars(text_value->GetString(), kMaxTypeChars) ||
+                        !base::UTF8ToUTF16(text_value->GetString().data(), text_value->GetString().size(), &text)))) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab and action (accept or dismiss); text is optional"));
+      return;
+    }
+    if (!tab->HasDialog()) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "no dialog is open on that tab"));
+      return;
+    }
+    // At once, outside the queue: the op that raised it (a click, an eval) is stuck until it's answered.
+    tab->AnswerDialog(*action == "accept", text_value ? &text : nullptr);
+    std::move(reply).Run(OkReply(request.id));
+  } else if (op == "page.snapshot") {
+    tab->page.Run(request.id.Clone(), base::BindOnce(&Page::Snapshot, base::Unretained(&tab->page), request.id.Clone()),
+                  std::move(reply));
+  } else if (op == "page.screenshot") {
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Screenshot, base::Unretained(&tab->page), request.id.Clone()), std::move(reply));
+  } else if (op == "page.click") {
+    if (!ref) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and ref"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Click, base::Unretained(&tab->page), request.id.Clone(), *ref), std::move(reply));
+  } else if (op == "page.type") {
+    std::optional<std::string> text = StringParam(request.body, "text");
+    std::u16string text16;
+    // No control characters: Enter or Tab inside the text could move the focus (to a password
+    // field, say) while typing. Those go one at a time through page.key, which checks again.
+    if (!ref || !text || !AtMostChars(*text, kMaxTypeChars) || !base::UTF8ToUTF16(text->data(), text->size(), &text16) ||
+        std::any_of(text16.begin(), text16.end(), [](char16_t c) { return c < 0x20 || c == 0x7F; })) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab, ref and text (up to 10000 characters, no control characters)"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Type, base::Unretained(&tab->page), request.id.Clone(), *ref, std::move(text16)),
+                  std::move(reply));
+  } else if (op == "page.key") {
+    std::optional<std::string> name = StringParam(request.body, "key");
+    std::optional<Key> key = name ? ParseKey(*name, request.body.Find("modifiers")) : std::nullopt;
+    if (!key) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab and key: a key name (Enter, Tab, Escape, Backspace, Delete, "
+                                      "ArrowUp…, PageUp, PageDown, Home, End) or one character; modifiers is a list "
+                                      "of shift, meta, alt, ctrl"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::PressKey, base::Unretained(&tab->page), request.id.Clone(), std::move(*key)),
+                  std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+// The pill's two lines; each omitted or empty goes back to its default.
+void Status(Session& session, const Request& request, ReplyCallback reply) {
+  std::string lines[2];
+  const char* keys[2] = {"title", "detail"};
+  for (int i = 0; i < 2; ++i) {
+    const base::Value* value = request.body.Find(keys[i]);
+    if (!value) continue;
+    if (!value->is_string() || (!value->GetString().empty() && !IsDisplayText(value->GetString(), kMaxStatusChars))) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "title and detail are up to 120 characters, no control characters"));
+      return;
+    }
+    lines[i] = value->GetString();
+  }
+  session.title = std::move(lines[0]);
+  session.detail = std::move(lines[1]);
+  Sync(session);
+  std::move(reply).Run(OkReply(request.id));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return base::StartsWith(op, "control.") || base::StartsWith(op, "tab.") || base::StartsWith(op, "page.");
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  if (op == "control.start") {
+    Start(client, std::move(request), std::move(reply));
+    return;
+  }
+  if (op == "control.stop") {
+    End(client.connection, /*close_tabs=*/true);
+    std::move(reply).Run(OkReply(request.id));
+    return;
+  }
+  if (op.starts_with("control.") && op != "control.status") {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  auto it = Sessions().find(client.connection);
+  if (it == Sessions().end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs control.start on this connection"));
+    return;
+  }
+  Session& session = it->second;
+  if (op == "control.status") {
+    Status(session, request, std::move(reply));
+    return;
+  }
+  if (session.paused && PauseBlocks(op)) {
+    std::move(reply).Run(ErrorReply(&request.id, kPaused, "the person took over: wait for control.resumed"));
+    return;
+  }
+  if (op == "tab.open") {
+    TabOpen(client, std::move(request), std::move(reply));
+  } else if (op == "tab.navigate") {
+    TabNavigate(session, std::move(request), std::move(reply));
+  } else if (op == "tab.back" || op == "tab.forward" || op == "tab.reload") {
+    TabHistory(session, std::move(request), std::move(reply));
+  } else if (op == "tab.close") {
+    TabClose(session, request, std::move(reply));
+  } else if (op.starts_with("page.")) {
+    PageOp(session, std::move(request), std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  Asking().erase(connection);
+  End(connection, /*close_tabs=*/false);
+}
+
+}  // namespace agens::bridge::control
