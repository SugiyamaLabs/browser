+// Our new tab page (prototype .ntp): the mark, a greeting and a big search field. Nothing on it
+// talks to an outside server.
+@interface AgensNewTabView : NSView
+@property(nonatomic, readonly) NSTextField* field;
+- (void)refreshTheme;
+@end
+@implementation AgensNewTabView {
+  NSImageView* _mark;
+  NSTextField* _greeting;
+  NSView* _well;
+  NSImageView* _searchIcon;
+  NSTextField* _hint;
+  NSTextField* _quiet;
+}
+@synthesize field = _field;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    self.layer.cornerRadius = 11;
+    _mark = [[NSImageView alloc] init];
+    _mark.imageScaling = NSImageScaleProportionallyUpOrDown;
+    _mark.accessibilityElement = NO;
+    _greeting = Label(22, NSFontWeightSemibold, kInk);
+    _greeting.alignment = NSTextAlignmentCenter;
+    _well = [[NSView alloc] init];
+    _well.wantsLayer = YES;
+    _well.layer.cornerRadius = 14;
+    _well.layer.borderWidth = 1;
+    _searchIcon = [NSImageView imageViewWithImage:Symbol(@"magnifyingglass", 15)];
+    _searchIcon.contentTintColor = kDim.color();
+    _field = WellField(16, @"Buscar ou digitar endereço", @"Buscar ou digitar endereço");
+    _hint = Label(11.5, NSFontWeightRegular, kDim);
+    _hint.stringValue = @"⌘L";
+    _quiet = Label(12.5, NSFontWeightRegular, kDim);
+    _quiet.alignment = NSTextAlignmentCenter;
+    _quiet.stringValue = @"Sem notícias, sem anúncios e sem nada falando com servidor de fora.";
+    for (NSView* v in @[ _searchIcon, _field, _hint ]) [_well addSubview:v];
+    for (NSView* v in @[ _mark, _greeting, _well, _quiet ]) [self addSubview:v];
+    [self refreshTheme];
+  }
+  return self;
+}
+- (BOOL)isFlipped {
+  return YES;
+}
+- (void)refreshTheme {
+  self.layer.backgroundColor = CG(kBg, self);
+  _well.layer.backgroundColor = CG(kSunk, self);
+  _well.layer.borderColor = CG(kLine, self);
+  const char* svg = IsDark(self.effectiveAppearance) ? kAgensMarkDarkSvg : kAgensMarkLightSvg;
+  _mark.image = [[NSImage alloc] initWithData:[NSData dataWithBytes:svg length:strlen(svg)]];
+  NSInteger hour = [NSCalendar.currentCalendar component:NSCalendarUnitHour fromDate:NSDate.date];
+  _greeting.stringValue = hour < 12 ? @"Bom dia" : hour < 18 ? @"Boa tarde" : @"Boa noite";
+}
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  [self refreshTheme];
+}
+- (void)layout {
+  [super layout];
+  CGFloat w = MIN(560, NSWidth(self.bounds) * 0.9);
+  CGFloat x = (NSWidth(self.bounds) - w) / 2;
+  CGFloat total = 72 + 18 + 30 + 22 + 48 + 24 + 18;
+  CGFloat y = MAX(24, (NSHeight(self.bounds) - total) / 2 - 20);
+  _mark.frame = NSMakeRect((NSWidth(self.bounds) - 72) / 2, y, 72, 72);
+  y += 72 + 18;
+  _greeting.frame = NSMakeRect(x, y, w, 30);
+  y += 30 + 22;
+  _well.frame = NSMakeRect(x, y, w, 48);
+  _searchIcon.frame = NSMakeRect(18, 16, 16, 16);
+  _hint.frame = NSMakeRect(w - 18 - 26, 16, 26, 16);
+  _field.frame = NSMakeRect(44, 13, w - 44 - 52, 22);
+  y += 48 + 24;
+  _quiet.frame = NSMakeRect(x - 40, y, w + 80, 18);
+}
+@end
