+++ b/chrome/browser/agens/bridge/view_ops.h
@@ -0,0 +1,83 @@
+// Copyright 2026 SugiyamaLabs.
+// The page inside another app (docs/protocolo.md, "host e view"): host.attach, view.* and
+// approval.answer and ui.answer (ui_ops.h). Only when the engine runs embedded (agens_embedded.h); otherwise every op here
+// answers unknown_op. UI thread; see ops.h for what a handler gets.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_VIEW_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_VIEW_OPS_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/ops.h"
+#include "ui/gfx/geometry/point.h"
+
+struct AgensWindow;
+class GURL;
+class Profile;
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}  // namespace content
+
+namespace agens::bridge::view {
+
+bool Handles(std::string_view op);
+void HandleOp(const Client& client, Request request, ReplyCallback reply);
+void OnConnectionClosed(uint64_t connection);
+
+// The engine's parent died (agens_embedded_mac.mm): nobody is the host any more.
+void HostGone();
+
+// The host's connection; 0 while none is attached.
+uint64_t Host();
+// The n of the tab's id "v<n>" (given now when it has none).
+int TabNumber(content::WebContents* contents);
+
+// The n of a tab the host was told about (view.tab); 0 for any other.
+int KnownTab(content::WebContents* contents);
+
+// DevTools may open for the tab (policy, kiosk).
+bool CanInspect(content::WebContents* contents);
+// Opens DevTools for the tab at `dock` ("bottom" or "right": a view the host lays out next to the
+// page; "window": its own window, the one window the embedded engine puts on screen; "": where the
+// host had it last, the window at first), or moves and shows the one open: Elements on the element
+// at `at` of `frame` (root DIPs, as a right click's x and y) when given. Ends the tab's picker.
+// Returns the DevTools view's "v<n>" when it is a view, else "". Check CanInspect first.
+std::string Inspect(content::WebContents* contents,
+                    content::RenderFrameHost* frame,
+                    std::optional<gfx::Point> at,
+                    std::string dock);
+// A DevTools frontend shown as a view (its menus, lists, panels and dialogs go to the host), and one
+// in a window of its own (they stay Chromium's, in that window).
+bool IsDevToolsView(content::WebContents* contents);
+bool InOwnDevToolsWindow(content::WebContents* contents);
+
+// Extension popups (extension_ops.cc): views the host attaches, gives input to and answers the
+// ui.ask of like tabs, outside any tab strip and never in view.tab. RemoveView detaches it and
+// ends its asks.
+void AddView(content::WebContents* contents);
+void RemoveView(content::WebContents* contents);
+// A tab or such a view by its "v<n>"; `window` gets a tab's window (null for a view).
+content::WebContents* FindView(int n, AgensWindow** window = nullptr);
+// view.open's ending: a new foreground tab of `url` in the ato's window, replied as {tab}.
+void OpenTab(Request request, ReplyCallback reply, GURL url, Profile* profile);
+
+// The shell's windows (native_shell_mac.mm): their tabs are the ones the host sees.
+void AddWindow(AgensWindow* window);
+void RemoveWindow(AgensWindow* window);
+
+// approval.cc, embedded: the question goes to the host as approval.ask instead of a sheet. Same
+// contract as agens::ShowApprovalSheet: one at a time; `done` runs once (now, with deny, when no
+// host is attached; deny too when the host goes away first). `facts` go out next to the four fields.
+void AskHost(const std::string& title,
+             const std::string& detail,
+             bool offer_always,
+             base::DictValue facts,
+             ApprovalCallback done);
+
+}  // namespace agens::bridge::view
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_VIEW_OPS_H_
diff --git a/chrome/browser/agens/bridge/view_pick.cc b/chrome/browser/agens/bridge/view_pick.cc
new file mode 100644
index 0000000000..f2cf0f9403
--- /dev/null
+++ b/chrome/browser/agens/bridge/view_pick.cc
@@ -0,0 +1,459 @@
+// Copyright 2026 SugiyamaLabs.
+// The picker (view_pick.h). How DevTools' inspect mode behaves, and what that asks of us:
+// - Overlay.setInspectMode answers ok even when Overlay is not enabled, and fails (keeping the
+//   mode) without a highlightConfig: DOM.enable and Overlay.enable go first, and a config always
+//   goes along. Detaching the session clears mode, tool and highlight in the renderer.
+// - A press with no element under the mouse passes to the page, and scrolling or leaving the view
+//   forgets that element: view_ops.cc sends a plain move at the press's point right before it.
+// - The highlight of Overlay.highlightNode goes away at the next mouse move over the page: while
+//   a pick is held, view_ops.cc keeps plain moves from the page.
+// - Escape in the page only says inspectModeCanceled; ending the mode is ours.
+// What the page returns goes through ClipPicked (view_input.h), whatever the script did.
+
+#include "chrome/browser/agens/bridge/view_pick.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/public/browser/agens_embed_mac.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "skia/ext/image_operations.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size_conversions.h"
+
+namespace agens::bridge::view {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr char kObjectGroup[] = "agens-pick";
+constexpr base::TimeDelta kCopyWait = base::Seconds(3);
+
+// Runs in the page, in our isolated world when it can, on the picked node: everything view.picked
+// carries, cut before it leaves the renderer. A password field's value never goes in the html (its
+// `value` attribute is dropped from a copy) and its text is empty. The reply waits for a frame, so
+// the picture taken next no longer has the hover highlight.
+constexpr char kDescribe[] = R"(async function(maxHtml, maxText, maxStyle) {
+  const el = this.nodeType === 9 ? this.documentElement : this;
+  const secret = e => e.localName === 'input' && (e.type === 'password' || /password/i.test(e.autocomplete || ''));
+  const path = [];
+  for (let e = el; e && e.nodeType === 1; e = e.parentElement) {
+    if (e.id) {
+      const id = '#' + CSS.escape(e.id);
+      let unique = false;
+      try { unique = e.getRootNode().querySelectorAll(id).length === 1; } catch (x) {}
+      if (unique) { path.unshift(id); break; }
+    }
+    let part = CSS.escape(e.localName);
+    const parent = e.parentElement;
+    if (parent) {
+      const same = [...parent.children].filter(c => c.localName === e.localName);
+      if (same.length > 1) part += ':nth-of-type(' + (same.indexOf(e) + 1) + ')';
+    }
+    path.unshift(part);
+  }
+  let html;
+  if (secret(el) || [...el.querySelectorAll('input')].some(secret)) {
+    const copy = el.cloneNode(true);
+    for (const e of [copy, ...copy.querySelectorAll('input')]) if (secret(e)) e.removeAttribute('value');
+    html = copy.outerHTML;
+  } else {
+    html = el.outerHTML;
+  }
+  const text = secret(el) ? '' : String(el.innerText ?? el.textContent ?? '');
+  const r = el.getBoundingClientRect();
+  let x = r.left, y = r.top;
+  for (let w = el.ownerDocument.defaultView; w && w.frameElement; w = w.parent) {
+    const f = w.frameElement, b = f.getBoundingClientRect(), s = getComputedStyle(f);
+    x += b.left + f.clientLeft + parseFloat(s.paddingLeft);
+    y += b.top + f.clientTop + parseFloat(s.paddingTop);
+  }
+  const cs = getComputedStyle(el), styles = {};
+  for (const k of ['display', 'position', 'width', 'height', 'margin', 'padding', 'font-family', 'font-size',
+                   'font-weight', 'line-height', 'color', 'background-color', 'border', 'border-radius']) {
+    styles[k] = cs.getPropertyValue(k).slice(0, maxStyle);
+  }
+  const out = {selector: path.join(' > '), html: html.slice(0, maxHtml), truncated: html.length > maxHtml,
+               text: text.slice(0, maxText), text_truncated: text.length > maxText,
+               styles, x, y, width: r.width, height: r.height, ratio: window.devicePixelRatio || 1};
+  await new Promise(done => { requestAnimationFrame(() => setTimeout(done)); setTimeout(done, 200); });
+  return out;
+})";
+
+// Up stops at <body>: <html> and <head> are nothing a person points at. Down takes the first child
+// that is drawn, so it never lands in <head>, <script> or a hidden element.
+constexpr char kStep[] = R"(function(parent) {
+  if (parent) {
+    if (this.localName === "body" || this.localName === "html") return null;
+    return this.parentElement || (this.parentNode && this.parentNode.host) || null;
+  }
+  for (let c = this.firstElementChild; c; c = c.nextElementSibling) {
+    if (c.getClientRects().length) return c;
+  }
+  return null;
+})";
+
+// The overlay's own highlight in a calm amber, with its label (tag and size).
+base::DictValue HighlightConfig() {
+  auto amber = [](double alpha) {
+    base::DictValue color;
+    color.Set("r", 255);
+    color.Set("g", 180);
+    color.Set("b", 84);
+    color.Set("a", alpha);
+    return color;
+  };
+  base::DictValue config;
+  config.Set("showInfo", true);
+  config.Set("showAccessibilityInfo", false);  // the label is the tag and the size, nothing more
+  config.Set("contentColor", amber(0.28));     // no outline exists in the overlay: the tint has to read on any background
+  config.Set("paddingColor", amber(0.14));
+  config.Set("borderColor", amber(0.9));
+  return config;
+}
+
+base::DictValue Arg(base::Value value) {
+  base::DictValue arg;
+  arg.Set("value", std::move(value));
+  return arg;
+}
+
+std::string Base64Png(const SkBitmap& bitmap) {
+  std::optional<std::vector<uint8_t>> png = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/true);
+  return png ? base::Base64Encode(*png) : std::string();
+}
+
+// Within kMaxPickedPngBase64, at half the size if it must; "" when not even that fits.
+// shortcut: encodes on the UI thread (tens of ms for a whole view at 2x); move it to the thread
+// pool if picks of big elements show as jank.
+std::string PickedPng(const SkBitmap& bitmap) {
+  if (bitmap.drawsNothing()) return std::string();
+  std::string png = Base64Png(bitmap);
+  if (png.size() <= kMaxPickedPngBase64) return png;
+  png = Base64Png(skia::ImageOperations::Resize(bitmap, skia::ImageOperations::RESIZE_GOOD,
+                                                std::max(1, bitmap.width() / 2), std::max(1, bitmap.height() / 2)));
+  return png.size() <= kMaxPickedPngBase64 ? png : std::string();
+}
+
+}  // namespace
+
+Picker::Picker(content::WebContents* contents, Send send)
+    : content::WebContentsObserver(contents), send_(std::move(send)) {}
+
+Picker::~Picker() {
+  End(false);
+}
+
+void Picker::Finish(Done& done, std::string code) {
+  if (done) std::move(done).Run(std::move(code));
+}
+
+bool Picker::Attach() {
+  if (agent_host_) return true;
+  agent_host_ = content::DevToolsAgentHost::GetOrCreateFor(web_contents());
+  if (!agent_host_ || !agent_host_->AttachClient(this)) {
+    agent_host_ = nullptr;
+    return false;
+  }
+  Command("DOM.enable");
+  Command("Overlay.enable", {}, Current(base::BindOnce([](Picker* self, const base::DictValue* result) {
+            self->overlay_on_ = result != nullptr;
+          })));
+  base::DictValue world;
+  world.Set("frameId", web_contents()->GetPrimaryMainFrame()->GetDevToolsFrameToken().ToString());
+  world.Set("worldName", kObjectGroup);
+  Command("Page.createIsolatedWorld", std::move(world),
+          Current(base::BindOnce([](Picker* self, const base::DictValue* result) {
+            if (result) self->world_ = result->FindInt("executionContextId").value_or(0);
+          })));
+  return true;
+}
+
+void Picker::Command(std::string_view method, base::DictValue params, Reply reply) {
+  if (!agent_host_) {
+    if (reply) std::move(reply).Run(nullptr);
+    return;
+  }
+  const int id = ++next_id_;
+  base::DictValue message;
+  message.Set("id", id);
+  message.Set("method", method);
+  message.Set("params", std::move(params));
+  std::optional<std::string> json = base::WriteJson(message);
+  if (!json) return;
+  if (reply) waiting_[id] = std::move(reply);  // before sending: a reply may come back right away
+  agent_host_->DispatchProtocolMessage(this, base::as_byte_span(*json));
+}
+
+Picker::Reply Picker::Current(base::OnceCallback<void(Picker*, const base::DictValue*)> then) {
+  return base::BindOnce(
+      [](base::WeakPtr<Picker> self, int generation, base::OnceCallback<void(Picker*, const base::DictValue*)> then,
+         const base::DictValue* result) {
+        if (self && self->generation_ == generation) std::move(then).Run(self.get(), result);
+      },
+      weak_factory_.GetWeakPtr(), generation_, std::move(then));
+}
+
+void Picker::Arm(Done done) {
+  Finish(arm_done_, kFailed);
+  Finish(step_done_, kFailed);
+  Finish(stop_done_, std::string());
+  arm_done_ = std::move(done);
+  ++generation_;
+  if (!web_contents() || !Attach()) {
+    End(false);
+    Finish(arm_done_, kFailed);
+    return;
+  }
+  if (state_ == State::kHeld || state_ == State::kFetching) Command("Overlay.hideHighlight");
+  if (!object_.empty()) {
+    base::DictValue group;
+    group.Set("objectGroup", kObjectGroup);
+    Command("Runtime.releaseObjectGroup", std::move(group));
+    object_.clear();
+  }
+  trail_.clear();
+  state_ = State::kArming;
+  base::DictValue mode;
+  mode.Set("mode", "searchForNode");
+  mode.Set("highlightConfig", HighlightConfig());
+  Command("Overlay.setInspectMode", std::move(mode),
+          Current(base::BindOnce([](Picker* self, const base::DictValue* result) {
+            if (!result || !self->overlay_on_) return self->End(false);  // answers arm_done_ "failed"
+            self->state_ = State::kArmed;
+            // A press over a cross-origin iframe lands on the <iframe> element, not inside it.
+            content::AgensEmbedRouteMouseToRoot(self->web_contents(), true);
+            Finish(self->arm_done_, std::string());
+          })));
+}
+
+void Picker::Picked(int backend_node_id) {
+  ++generation_;
+  state_ = State::kFetching;
+  content::AgensEmbedRouteMouseToRoot(web_contents(), false);
+  base::DictValue mode;
+  mode.Set("mode", "none");
+  mode.Set("highlightConfig", base::DictValue());
+  Command("Overlay.setInspectMode", std::move(mode));
+  Resolve(backend_node_id, world_ != 0);
+}
+
+void Picker::Resolve(int backend_node_id, bool in_world) {
+  base::DictValue params;
+  params.Set("backendNodeId", backend_node_id);
+  params.Set("objectGroup", kObjectGroup);
+  if (in_world) params.Set("executionContextId", world_);
+  Command("DOM.resolveNode", std::move(params),
+          Current(base::BindOnce(
+              [](int backend_node_id, bool in_world, Picker* self, const base::DictValue* result) {
+                const std::string* object = result ? result->FindStringByDottedPath("object.objectId") : nullptr;
+                if (object) return self->Describe(*object);
+                // A node of a same-origin iframe is not in the main frame's world: its frame's own.
+                if (in_world) return self->Resolve(backend_node_id, false);
+                self->End(true);
+              },
+              backend_node_id, in_world)));
+}
+
+void Picker::Describe(const std::string& object_id) {
+  base::ListValue args;
+  args.Append(Arg(base::Value(static_cast<int>(kMaxPickedHtmlBytes))));
+  args.Append(Arg(base::Value(static_cast<int>(kMaxPickedTextChars))));
+  args.Append(Arg(base::Value(static_cast<int>(kMaxPickedStyleChars))));
+  base::DictValue params;
+  params.Set("objectId", object_id);
+  params.Set("functionDeclaration", kDescribe);
+  params.Set("arguments", std::move(args));
+  params.Set("returnByValue", true);
+  params.Set("awaitPromise", true);
+  params.Set("silent", true);
+  Command("Runtime.callFunctionOn", std::move(params),
+          Current(base::BindOnce(
+              [](std::string object_id, Picker* self, const base::DictValue* result) {
+                const base::DictValue* value =
+                    result && !result->Find("exceptionDetails") ? result->FindDictByDottedPath("result.value") : nullptr;
+                PickedBox box;
+                std::optional<base::DictValue> fields = value ? ClipPicked(*value, box) : std::nullopt;
+                if (!fields) return self->End(true);
+                self->Capture(std::move(object_id), std::move(*fields), box);
+              },
+              object_id)));
+}
+
+void Picker::Capture(std::string object_id, base::DictValue fields, const PickedBox& box) {
+  content::RenderWidgetHostView* view = web_contents()->GetRenderWidgetHostView();
+  if (!view) return End(true);
+  const float scale = view->GetDeviceScaleFactor() > 0 ? view->GetDeviceScaleFactor() : 1;
+  // CSS pixels → the view's points: the page's zoom is its devicePixelRatio over the screen's.
+  const double zoom = box.ratio / scale;
+  const gfx::RectF rect(box.x * zoom, box.y * zoom, box.width * zoom, box.height * zoom);
+  fields.Set("x", static_cast<double>(rect.x()));
+  fields.Set("y", static_cast<double>(rect.y()));
+  fields.Set("width", static_cast<double>(rect.width()));
+  fields.Set("height", static_cast<double>(rect.height()));
+  // The part on screen only (a pick can be bigger than the view).
+  gfx::Rect visible = gfx::ToEnclosingRect(rect);
+  visible.Intersect(gfx::Rect(view->GetViewBounds().size()));
+  if (visible.IsEmpty()) {
+    fields.Set("png_skipped", true);
+    return Emit(std::move(object_id), std::move(fields));
+  }
+  // The same copy page.screenshot makes (control_page.cc), at the screen's scale.
+  view->CopyFromSurface(
+      visible, gfx::ScaleToCeiledSize(visible.size(), scale), kCopyWait,
+      base::BindOnce(
+          [](base::WeakPtr<Picker> self, int generation, std::string object_id, base::DictValue fields,
+             const content::CopyFromSurfaceResult& result) {
+            if (!self || self->generation_ != generation) return;
+            std::string png = result.has_value() ? PickedPng(result->bitmap) : std::string();
+            if (png.empty()) {
+              fields.Set("png_skipped", true);
+            } else {
+              fields.Set("png", std::move(png));
+            }
+            self->Emit(std::move(object_id), std::move(fields));
+          },
+          weak_factory_.GetWeakPtr(), generation_, std::move(object_id), std::move(fields)));
+}
+
+void Picker::Emit(std::string object_id, base::DictValue fields) {
+  state_ = State::kHeld;
+  object_ = std::move(object_id);
+  send_.Run(std::move(fields));
+  // Highlighted for good: it scrolls with the page, until the picker ends or arms again.
+  base::DictValue params;
+  params.Set("objectId", object_);
+  params.Set("highlightConfig", HighlightConfig());
+  Command("Overlay.highlightNode", std::move(params));
+}
+
+void Picker::Step(bool parent, Done done) {
+  if (state_ != State::kHeld) return std::move(done).Run(kNotFound);
+  Finish(step_done_, kFailed);
+  step_done_ = std::move(done);
+  ++generation_;
+  if (!parent && !trail_.empty()) {  // down goes back the way up came
+    const std::string back = trail_.back();
+    trail_.pop_back();
+    Finish(step_done_, std::string());
+    state_ = State::kFetching;
+    Command("Overlay.hideHighlight");
+    return Describe(back);
+  }
+  base::ListValue args;
+  args.Append(Arg(base::Value(parent)));
+  base::DictValue params;
+  params.Set("objectId", object_);
+  params.Set("functionDeclaration", kStep);
+  params.Set("arguments", std::move(args));
+  params.Set("objectGroup", kObjectGroup);
+  params.Set("silent", true);
+  Command("Runtime.callFunctionOn", std::move(params),
+          Current(base::BindOnce([](bool parent, Picker* self, const base::DictValue* result) {
+            if (!result) return Finish(self->step_done_, kFailed);
+            const std::string* found = result->FindStringByDottedPath("result.objectId");
+            if (!found) return Finish(self->step_done_, kNotFound);  // the pick stays
+            const std::string object_id = *found;
+            if (parent) self->trail_.push_back(self->object_);
+            else self->trail_.clear();
+            Finish(self->step_done_, std::string());
+            self->state_ = State::kFetching;
+            self->Command("Overlay.hideHighlight");
+            self->Describe(object_id);
+          }, parent)));
+}
+
+void Picker::Stop(Done done) {
+  if (state_ == State::kOff || !agent_host_) {
+    End(false);
+    return std::move(done).Run(std::string());
+  }
+  Finish(stop_done_, std::string());
+  stop_done_ = std::move(done);
+  base::DictValue mode;
+  mode.Set("mode", "none");
+  mode.Set("highlightConfig", base::DictValue());
+  Command("Overlay.setInspectMode", std::move(mode),
+          Current(base::BindOnce([](Picker* self, const base::DictValue*) { self->End(false); })));
+}
+
+void Picker::End(bool cancelled) {
+  Finish(stop_done_, std::string());  // off is off, however it got there
+  if (state_ == State::kOff) return;
+  state_ = State::kOff;
+  ++generation_;
+  object_.clear();
+  trail_.clear();
+  if (web_contents()) content::AgensEmbedRouteMouseToRoot(web_contents(), false);
+  if (agent_host_) agent_host_->DetachClient(this);
+  agent_host_ = nullptr;
+  waiting_.clear();
+  overlay_on_ = false;
+  world_ = 0;
+  Finish(arm_done_, kFailed);
+  Finish(step_done_, kFailed);
+  if (cancelled) {
+    base::DictValue fields;
+    fields.Set("cancelled", true);
+    send_.Run(std::move(fields));
+  }
+}
+
+void Picker::PrimaryPageChanged(content::Page&) {
+  End(true);
+}
+
+void Picker::PrimaryMainFrameRenderProcessGone(base::TerminationStatus) {
+  End(true);
+}
+
+void Picker::WebContentsDestroyed() {
+  End(false);
+  Observe(nullptr);
+}
+
+void Picker::DispatchProtocolMessage(content::DevToolsAgentHost* agent_host, base::span<const uint8_t> message) {
+  if (agent_host != agent_host_.get()) return;
+  std::optional<base::DictValue> parsed = base::JSONReader::ReadDict(
+      std::string_view(reinterpret_cast<const char*>(message.data()), message.size()), base::JSON_PARSE_RFC);
+  if (!parsed) return;
+  if (std::optional<int> id = parsed->FindInt("id")) {
+    auto it = waiting_.find(*id);
+    if (it == waiting_.end()) return;
+    Reply reply = std::move(it->second);
+    waiting_.erase(it);
+    std::move(reply).Run(parsed->Find("error") ? nullptr : parsed->FindDict("result"));
+    return;
+  }
+  const std::string* method = parsed->FindString("method");
+  if (!method) return;
+  if (*method == "Overlay.inspectNodeRequested") {
+    // Only while armed: the person's own DevTools, or a node left pending, can send one too.
+    std::optional<int> node = parsed->FindIntByDottedPath("params.backendNodeId");
+    if (state_ == State::kArmed && node) Picked(*node);
+  } else if (*method == "Overlay.inspectModeCanceled") {
+    End(true);  // Escape in the page
+  }
+}
+
+void Picker::AgentHostClosed(content::DevToolsAgentHost* agent_host) {
+  if (agent_host != agent_host_.get()) return;
+  agent_host_ = nullptr;
+  End(true);
+}
+
+}  // namespace agens::bridge::view
diff --git a/chrome/browser/agens/bridge/view_pick.h b/chrome/browser/agens/bridge/view_pick.h
new file mode 100644
index 0000000000..68f776593c
--- /dev/null
+++ b/chrome/browser/agens/bridge/view_pick.h
@@ -0,0 +1,103 @@
+// Copyright 2026 SugiyamaLabs.
+// The element picker of a tab the host shows (docs/protocolo.md, "Passo 5.4"): view.pick,
+// view.pick.step and the view.picked event. DevTools' own inspect mode does the work inside the
+// page (the highlight under the mouse, a press that picks instead of acting), driven by an internal
+// DevTools session without a window, as session_read.cc does. view_ops.cc owns one per shown tab
+// and decides who may use it; this file only talks to the page. UI thread.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_VIEW_PICK_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_VIEW_PICK_H_
+
+#include <map>
+#include <string>
+#include <vector>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace content {
+class DevToolsAgentHost;
+}
+
+namespace agens::bridge {
+struct PickedBox;
+}
+
+namespace agens::bridge::view {
+
+class Picker : public content::WebContentsObserver, public content::DevToolsAgentHostClient {
+ public:
+  // view.picked's fields without "tab": a pick, or {cancelled: true} when the picker ended by
+  // itself (Escape in the page, navigation, the renderer gone, End(true)).
+  using Send = base::RepeatingCallback<void(base::DictValue)>;
+  // An error code of protocol.h, or "" when it went through.
+  using Done = base::OnceCallback<void(std::string code)>;
+
+  Picker(content::WebContents* contents, Send send);
+  Picker(const Picker&) = delete;
+  Picker& operator=(const Picker&) = delete;
+  // Detaches the session: the page drops the mode and the highlight. Sends nothing.
+  ~Picker() override;
+
+  // view.pick on:true: the next press on the page picks (again, after a pick).
+  void Arm(Done done);
+  // view.pick.step: the parent or the first child of the pick. kNotFound when there is none (the
+  // pick stays); "" and then a new view.picked when there is.
+  void Step(bool parent, Done done);
+  // view.pick on:false: like End(false), but `done` runs once the page has left the mode, so a
+  // click sent after the answer acts on the page.
+  void Stop(Done done);
+  // Ends the mode and clears the highlight; {cancelled: true} goes out when `cancelled` and the
+  // picker was on. Nothing happens on a picker already off.
+  void End(bool cancelled);
+
+  bool armed() const { return state_ == State::kArming || state_ == State::kArmed; }
+  bool held() const { return state_ == State::kHeld; }  // a pick is highlighted in the page
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus status) override;
+  void WebContentsDestroyed() override;
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+
+ private:
+  enum class State { kOff, kArming, kArmed, kFetching, kHeld };
+  // Gets the command's "result", or null when it failed or the session went away.
+  using Reply = base::OnceCallback<void(const base::DictValue* result)>;
+
+  bool Attach();
+  void Command(std::string_view method, base::DictValue params = {}, Reply reply = {});
+  // A reply that runs only if nothing restarted the picker since it was asked.
+  Reply Current(base::OnceCallback<void(Picker*, const base::DictValue*)> then);
+  void Picked(int backend_node_id);
+  void Resolve(int backend_node_id, bool in_world);
+  void Describe(const std::string& object_id);
+  void Capture(std::string object_id, base::DictValue fields, const PickedBox& box);
+  void Emit(std::string object_id, base::DictValue fields);
+  static void Finish(Done& done, std::string code);
+
+  Send send_;
+  State state_ = State::kOff;
+  int generation_ = 0;
+  scoped_refptr<content::DevToolsAgentHost> agent_host_;
+  int next_id_ = 0;
+  std::map<int, Reply> waiting_;
+  bool overlay_on_ = false;  // Overlay.enable went through (setInspectMode says ok even when not)
+  int world_ = 0;            // our isolated world in the main frame, 0 while there is none
+  std::string object_;       // the pick, in the session's object group
+  std::vector<std::string> trail_;  // the picks ↑ came from, so ↓ goes back the same way
+  Done arm_done_, step_done_, stop_done_;
+  base::WeakPtrFactory<Picker> weak_factory_{this};
+};
+
+}  // namespace agens::bridge::view
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_VIEW_PICK_H_
diff --git a/chrome/browser/agens/embed/agens_controlled.h b/chrome/browser/agens/embed/agens_controlled.h
new file mode 100644
index 0000000000..709347df06
--- /dev/null
+++ b/chrome/browser/agens/embed/agens_controlled.h
@@ -0,0 +1,53 @@
+// Copyright 2026 SugiyamaLabs.
+// Marks a tab an app drives over the socket (bridge/control_ops.cc, docs/agens.md "Controle").
+// The shell shows it (AgensTab.controller: the pill with Assumir / Devolver); downloads stay out
+// of it, saved passwords and autofill too unless the session was allowed "passwords", and
+// extensions when the host turned agent_extensions off.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_CONTROLLED_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_CONTROLLED_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class JavaScriptDialogManager;
+}
+
+class AgensControlled : public content::WebContentsUserData<AgensControlled> {
+ public:
+  static bool Is(content::WebContents* contents) { return contents && FromWebContents(contents); }
+  // The built-in password manager and autofill stay out, unless the session was allowed "passwords".
+  static bool KeepsPasswordsOut(content::WebContents* contents) {
+    const AgensControlled* mark = contents ? FromWebContents(contents) : nullptr;
+    return mark && !mark->passwords;
+  }
+  // Extensions stay out (host.settings agent_extensions off): no scripts in its frames (the bridge
+  // tells the renderer), no toolbar action, no tab-id based extension API.
+  static bool BlocksExtensions(content::WebContents* contents) {
+    const AgensControlled* mark = contents ? FromWebContents(contents) : nullptr;
+    return mark && mark->extensions_blocked;
+  }
+
+  std::string by;               // the agent's name, for the pill and "Controlado pelo …"
+  std::string title, detail;    // the pill's two lines while the agent works (control.status)
+  bool paused = false;          // the person took over ("Assumir")
+  bool passwords = false;       // control.start's allow has "passwords"
+  bool extensions_blocked = false;  // BlocksExtensions
+  // Where the agent last clicked or hovered, in DIPs from the page's top-left; x < 0 when never.
+  float cursor_x = -1, cursor_y = -1;
+  base::RepeatingClosure stop;       // "Encerrar": ends the whole control session
+  base::RepeatingClosure take_over;  // "Assumir": pauses the session
+  base::RepeatingClosure hand_back;  // "Devolver ao …": resumes it
+  // Its JavaScript dialogs go here (held for the agent); never destroyed, so content may keep it.
+  content::JavaScriptDialogManager* dialogs = nullptr;
+
+ private:
+  explicit AgensControlled(content::WebContents* contents)
+      : content::WebContentsUserData<AgensControlled>(*contents) {}
+  friend class content::WebContentsUserData<AgensControlled>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_CONTROLLED_H_
diff --git a/chrome/browser/agens/embed/agens_cookie_pool.cc b/chrome/browser/agens/embed/agens_cookie_pool.cc
new file mode 100644
index 0000000000..36b5ad620a
--- /dev/null
+++ b/chrome/browser/agens/embed/agens_cookie_pool.cc
@@ -0,0 +1,411 @@
+// Copyright 2026 SugiyamaLabs.
+// Mirrors cookies between the loaded atos of the pool through each profile's own CookieManager.
+// Cookie values pass through here only on their way from one store to another: never logged,
+// stored or counted. Local State gets one time per ato ("synced"), never a cookie name or value.
+
+#include "chrome/browser/agens/embed/agens_cookie_pool.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/json/values_util.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/scoped_observation.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_manager_observer.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "content/public/browser/storage_partition.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_access_result.h"
+#include "net/cookies/cookie_change_dispatcher.h"
+#include "net/cookies/cookie_options.h"
+#include "net/cookies/cookie_util.h"
+#include "net/cookies/unique_cookie_key.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+
+namespace agens {
+
+namespace {
+
+// A write we made that the store has not reported back after this long never will be.
+constexpr base::TimeDelta kEchoLifetime = base::Seconds(5);
+// "synced" is exact at merge end, unload, quit and EndSession; in between at most this old.
+// shortcut: after a crash, cookies mirrored in the last minute look newer than "synced", so a
+// logout made in another ato while this one slept can come back; upgrade if crashes make it matter.
+constexpr base::TimeDelta kSyncedEvery = base::Seconds(60);
+// Changes during a merge make it read both sides again, at most this many passes in all.
+constexpr int kMaxMergePasses = 3;
+
+network::mojom::CookieManager* CookiesOf(Profile* profile) {
+  return profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+}
+
+// Name, domain, path and partition key (what makes two cookies "the same" for a store), plus
+// whether it is a deletion. No value.
+using EchoKey = std::pair<net::UniqueCookieKey, bool>;
+EchoKey KeyOf(const net::CanonicalCookie& cookie, bool deletion) {
+  return {cookie.LegacyUniqueKey(), deletion};
+}
+
+// When this store got this value (old cookies may lack the update time).
+base::Time Updated(const net::CanonicalCookie& cookie) {
+  return std::max(cookie.LastUpdateDate(), cookie.CreationDate());
+}
+
+// The cookie as written into another store: same everything but updated now, so that store's
+// LastUpdateDate says when it got the value (what a reload merge compares with "synced").
+net::CanonicalCookie Stamped(const net::CanonicalCookie& c) {
+  std::unique_ptr<net::CanonicalCookie> copy = net::CanonicalCookie::FromStorage(
+      c.Name(), c.Value(), c.Domain(), c.Path(), c.CreationDate(), c.ExpiryDate(), c.LastAccessDate(),
+      base::Time::Now(), c.SecureAttribute(), c.IsHttpOnly(), c.SameSite(), c.Priority(), c.PartitionKey(),
+      c.SourceScheme(), c.SourcePort(), c.SourceType(), net::CanonicalCookieFromStorageCallSite::kCookieManager);
+  return copy ? *copy : c;
+}
+
+// agens.atos[<folder>].synced: the last moment this ato was in sync with another loaded ato of the
+// pool. Missing: it never was (or it left the pool since), so its next merge is a first join.
+std::optional<base::Time> Synced(const base::FilePath& dir) {
+  const base::DictValue* extras =
+      g_browser_process->local_state()->GetDict(AgensWindow::kAtosPref).FindDict(dir.BaseName().AsUTF8Unsafe());
+  return extras ? base::ValueToTime(extras->Find("synced")) : std::nullopt;
+}
+void SetSynced(const base::FilePath& dir) {
+  if (!AgensWindow::AtoSharesCookies(dir)) return;  // left the pool or was deleted: nothing to keep
+  ScopedDictPrefUpdate update(g_browser_process->local_state(), AgensWindow::kAtosPref);
+  update->EnsureDict(dir.BaseName().AsUTF8Unsafe())->Set("synced", base::TimeToValue(base::Time::Now()));
+}
+
+class CookiePool : public ProfileManagerObserver, public ProfileObserver {
+ public:
+  static CookiePool& Get() {
+    static base::NoDestructor<CookiePool> pool;
+    return *pool;
+  }
+
+  void Start() {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (started_ || !manager) return;
+    started_ = true;
+    manager_observation_.Observe(manager);
+    prefs_.Init(g_browser_process->local_state());
+    // Posted: our own "synced" writes change this pref from inside the loops below.
+    prefs_.Add(AgensWindow::kAtosPref, base::BindRepeating(&CookiePool::RefreshSoon, base::Unretained(this)));
+    Refresh();
+  }
+
+ private:
+  enum class State { kWaiting, kMerging, kReady };
+
+  // One loaded ato of the pool, listening to every change in its store. Changes are mirrored only
+  // between kReady members; a member still merging is marked dirty instead and reads again.
+  struct Member : network::mojom::CookieChangeListener {
+    Member(CookiePool* pool, Profile* profile, int generation)
+        : pool(pool), profile(profile), generation(generation) {
+      CookiesOf(profile)->AddGlobalChangeListener(receiver.BindNewPipeAndPassRemote());
+      // E.g. the network service restarted: leave, and join again on the new store.
+      receiver.set_disconnect_handler(
+          base::BindOnce(&CookiePool::OnDisconnect, base::Unretained(pool), profile, generation));
+    }
+    void OnCookieChange(const net::CookieChangeInfo& change) override { pool->OnChange(this, change); }
+
+    raw_ptr<CookiePool> pool;
+    raw_ptr<Profile> profile;
+    const int generation;  // callbacks meant for an older Member of the same profile do nothing
+    State state = State::kWaiting;
+    bool dirty = false;  // something changed on either side during this merge pass
+    int passes = 0;
+    base::Time pass_start, previous_pass_start;
+    // Writes this pool made into this store, which the store reports back: they are not mirrored
+    // again (that would ping-pong forever). Expire after kEchoLifetime.
+    std::multimap<EchoKey, base::TimeTicks> echoes;
+    mojo::Receiver<network::mojom::CookieChangeListener> receiver{this};
+  };
+
+  Member* Find(Profile* profile, int generation) {
+    auto it = members_.find(profile);
+    return it != members_.end() && it->second->generation == generation ? it->second.get() : nullptr;
+  }
+  Member* AnyReady(const Member* except = nullptr) {
+    for (auto& [profile, member] : members_) {
+      if (member.get() != except && member->state == State::kReady) return member.get();
+    }
+    return nullptr;
+  }
+  int ReadyCount() {
+    return static_cast<int>(
+        std::ranges::count_if(members_, [](const auto& m) { return m.second->state == State::kReady; }));
+  }
+
+  void RefreshSoon() {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CookiePool::Refresh, weak_.GetWeakPtr()));
+  }
+  void Refresh() {
+    ProfileManager* manager = g_browser_process->profile_manager();
+    if (!manager) return;
+    for (Profile* profile : manager->GetLoadedProfiles()) {
+      if (profile->IsOffTheRecord()) continue;
+      const bool shared = AgensWindow::AtoSharesCookies(profile->GetPath());
+      if (shared && !members_.contains(profile)) {
+        members_[profile] = std::make_unique<Member>(this, profile, ++generation_);
+        profile_observations_.AddObservation(profile);
+      } else if (!shared && members_.contains(profile)) {
+        Leave(profile);  // keeps the cookies it has now
+      }
+    }
+    Kick();
+  }
+
+  // Waiting members merge with a member that finished its own merge. With none ready and none
+  // merging, the first one waiting is the pool by itself (nothing loaded to merge with).
+  void Kick() {
+    for (auto& [profile, member] : members_) {
+      if (member->state != State::kWaiting) continue;
+      if (Member* source = AnyReady()) {
+        member->passes = 0;
+        StartPass(member.get(), source);
+      } else if (std::ranges::none_of(members_, [](const auto& m) { return m.second->state == State::kMerging; })) {
+        member->state = State::kReady;
+      }
+    }
+  }
+
+  // shortcut: atos of the pool that are not loaded get nothing until they load, so two pool atos
+  // never loaded together don't share (with "synced" they converge later without losing a
+  // logout). Upgrade when that matters: open the asleep pool atos' cookie stores without the profile.
+  void StartPass(Member* member, Member* source) {
+    member->state = State::kMerging;
+    member->dirty = false;
+    member->pass_start = base::Time::Now();
+    CookiesOf(source->profile)
+        ->GetAllCookies(
+            base::BindOnce(&CookiePool::GotPool, weak_.GetWeakPtr(), member->profile.get(), member->generation));
+  }
+  void GotPool(Profile* profile, int generation, const std::vector<net::CanonicalCookie>& pool) {
+    if (!Find(profile, generation)) return;
+    CookiesOf(profile)->GetAllCookies(
+        base::BindOnce(&CookiePool::Merge, weak_.GetWeakPtr(), profile, generation, pool));
+  }
+
+  // The rules, for the same cookie (name, domain, path, partition key) in the pool and here:
+  // - first join (no "synced"): on both sides the pool wins; on one side it is kept and copied;
+  // - reload ("synced" known): on both sides the newer wins; on one side, newer than "synced" is
+  //   new and copied, older means the other side deleted it while apart, so it goes here too;
+  // - another pass (something changed during the last one): like reload since the last pass's
+  //   start, but deleting nothing (a write a store refused must not turn into a deletion).
+  void Merge(Profile* profile,
+             int generation,
+             const std::vector<net::CanonicalCookie>& pool,
+             const std::vector<net::CanonicalCookie>& own) {
+    Member* joining = Find(profile, generation);
+    if (!joining) return;
+    const bool again = joining->passes > 0;
+    const std::optional<base::Time> since =
+        again ? std::optional(joining->previous_pass_start) : Synced(profile->GetPath());
+    std::map<net::UniqueCookieKey, const net::CanonicalCookie*> mine;
+    for (const net::CanonicalCookie& cookie : own) mine[cookie.LegacyUniqueKey()] = &cookie;
+    for (const net::CanonicalCookie& cookie : pool) {
+      auto same = mine.find(cookie.LegacyUniqueKey());
+      if (same != mine.end()) {
+        const net::CanonicalCookie* other = same->second;
+        mine.erase(same);
+        if (other->Value() == cookie.Value() && other->ExpiryDate() == cookie.ExpiryDate()) continue;
+        if (since && Updated(*other) > Updated(cookie)) {
+          ToPool(joining, *other, /*deletion=*/false);
+        } else {
+          Write(joining, cookie);
+        }
+      } else if (!since || Updated(cookie) > *since) {
+        Write(joining, cookie);
+      } else if (!again) {
+        ToPool(joining, cookie, /*deletion=*/true);  // deleted here while apart
+      }
+    }
+    for (const auto& [key, cookie] : mine) {
+      if (!since || Updated(*cookie) > *since) {
+        ToPool(joining, *cookie, /*deletion=*/false);
+      } else if (!again) {
+        Delete(joining, *cookie);  // deleted in the pool while apart
+      }
+    }
+    Member* source = AnyReady(joining);
+    if (joining->dirty && source && joining->passes + 1 < kMaxMergePasses) {
+      ++joining->passes;
+      joining->previous_pass_start = joining->pass_start;
+      StartPass(joining, source);
+      return;
+    }
+    joining->state = State::kReady;
+    if (source) SetSynced(profile->GetPath());
+    Kick();
+  }
+
+  void Leave(Profile* profile) {
+    auto it = members_.find(profile);
+    if (it == members_.end()) return;
+    Member* member = it->second.get();
+    // Unloading (or quitting) while another loaded ato is in sync: both were in sync until now.
+    if (member->state == State::kReady && ReadyCount() > 1) {
+      SetSynced(profile->GetPath());
+      if (ReadyCount() == 2) SetSynced(AnyReady(member)->profile->GetPath());
+    }
+    members_.erase(it);
+    profile_observations_.RemoveObservation(profile);
+    Kick();  // a member that waited for this one
+  }
+
+  void OnDisconnect(Profile* profile, int generation) {
+    if (!Find(profile, generation)) return;
+    Leave(profile);
+    // Joins again (a reload merge) once the new network service is up.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&CookiePool::Refresh, weak_.GetWeakPtr()), base::Seconds(1));
+  }
+
+  void OnChange(Member* member, const net::CookieChangeInfo& change) {
+    using Cause = net::CookieChangeCause;
+    const Cause cause = change.cause;
+    const bool deletion = cause == Cause::EXPLICIT || cause == Cause::UNKNOWN_DELETION ||
+                          cause == Cause::EXPIRED_OVERWRITE;  // a site deletes by setting it expired
+    const bool insertion = cause == Cause::INSERTED || cause == Cause::INSERTED_NO_CHANGE_OVERWRITE ||
+                           cause == Cause::INSERTED_NO_VALUE_CHANGE_OVERWRITE;
+    // OVERWRITE is followed by the insertion; EXPIRED and EVICTED happen in each store by itself.
+    if (!deletion && !insertion) return;
+    const base::TimeTicks now = base::TimeTicks::Now();
+    std::erase_if(member->echoes, [&](const auto& echo) { return now - echo.second > kEchoLifetime; });
+    auto echo = member->echoes.find(KeyOf(change.cookie, deletion));
+    if (echo != member->echoes.end()) {
+      member->echoes.erase(echo);
+      return;
+    }
+    if (cause == Cause::INSERTED_NO_CHANGE_OVERWRITE) return;  // nothing changed
+    if (member->state != State::kReady) {
+      member->dirty = true;  // its merge reads it again
+      return;
+    }
+    Mirror(member, change.cookie, deletion);
+  }
+
+  // A change in a ready member, to the other ready members; the ones merging read again.
+  void Mirror(Member* from, const net::CanonicalCookie& cookie, bool deletion) {
+    for (auto& [profile, member] : members_) {
+      if (member.get() == from) continue;
+      if (member->state != State::kReady) {
+        member->dirty = true;
+      } else if (deletion) {
+        Delete(member.get(), cookie);
+      } else {
+        Write(member.get(), cookie);
+      }
+    }
+    if (base::Time::Now() - last_synced_ > kSyncedEvery && ReadyCount() > 1) {
+      last_synced_ = base::Time::Now();
+      RecordSynced();
+    }
+  }
+  // From a member merging to the pool (the ready members).
+  void ToPool(Member* from, const net::CanonicalCookie& cookie, bool deletion) {
+    for (auto& [profile, member] : members_) {
+      if (member.get() == from || member->state != State::kReady) continue;
+      if (deletion) {
+        Delete(member.get(), cookie);
+      } else {
+        Write(member.get(), cookie);
+      }
+    }
+  }
+  // As it is: httpOnly, SameSite, session-only and partitioned included.
+  void Write(Member* to, const net::CanonicalCookie& cookie) {
+    to->echoes.emplace(KeyOf(cookie, false), base::TimeTicks::Now());
+    const bool secure = cookie.IsSecure() || cookie.SourceScheme() == net::CookieSourceScheme::kSecure;
+    CookiesOf(to->profile)
+        ->SetCanonicalCookie(Stamped(cookie),
+                             net::cookie_util::SimulatedCookieSource(cookie, secure ? "https" : "http"),
+                             net::CookieOptions::MakeAllInclusive(),
+                             base::BindOnce(
+                                 [](base::WeakPtr<CookiePool> pool, Profile* profile, int generation, EchoKey key,
+                                    net::CookieAccessResult result) {
+                                   if (pool && !result.status.IsInclude()) pool->DropEcho(profile, generation, key);
+                                 },
+                                 weak_.GetWeakPtr(), to->profile.get(), to->generation, KeyOf(cookie, false)));
+  }
+  // Only the same cookie with the same value goes (CookieManager::DeleteCanonicalCookie).
+  void Delete(Member* to, const net::CanonicalCookie& cookie) {
+    to->echoes.emplace(KeyOf(cookie, true), base::TimeTicks::Now());
+    CookiesOf(to->profile)
+        ->DeleteCanonicalCookie(
+            cookie, base::BindOnce(
+                        [](base::WeakPtr<CookiePool> pool, Profile* profile, int generation, EchoKey key, bool deleted) {
+                          if (pool && !deleted) pool->DropEcho(profile, generation, key);
+                        },
+                        weak_.GetWeakPtr(), to->profile.get(), to->generation, KeyOf(cookie, true)));
+  }
+  // The store refused or had nothing to change, so it will not report this write.
+  void DropEcho(Profile* profile, int generation, const EchoKey& key) {
+    Member* member = Find(profile, generation);
+    if (!member) return;
+    auto echo = member->echoes.find(key);
+    if (echo != member->echoes.end()) member->echoes.erase(echo);
+  }
+
+  // Every ready member is in sync with the others now. Mirrored writes are stamped with the time
+  // they happen, so "synced" must be at least the last of them: else, on the next load, a cookie
+  // the others deleted meanwhile looks new and comes back.
+  void RecordSynced() {
+    if (ReadyCount() < 2) return;
+    for (auto& [profile, member] : members_) {
+      if (member->state == State::kReady) SetSynced(profile->GetPath());
+    }
+  }
+
+ public:
+  // SIGTERM and logout skip OnProfileManagerDestroying and OnProfileWillBeDestroyed.
+  void EndSession() { RecordSynced(); }
+
+ private:
+  // ProfileManagerObserver:
+  void OnProfileAdded(Profile* profile) override { Refresh(); }
+  void OnProfileManagerDestroying() override {
+    RecordSynced();
+    members_.clear();
+    profile_observations_.RemoveAllObservations();
+    manager_observation_.Reset();
+    prefs_.RemoveAll();
+  }
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override { Leave(profile); }
+
+  bool started_ = false;
+  int generation_ = 0;
+  base::Time last_synced_;
+  std::map<Profile*, std::unique_ptr<Member>> members_;
+  PrefChangeRegistrar prefs_;
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver> manager_observation_{this};
+  base::ScopedMultiSourceObservation<Profile, ProfileObserver> profile_observations_{this};
+  base::WeakPtrFactory<CookiePool> weak_{this};
+};
+
+}  // namespace
+
+void StartCookiePool() {
+  CookiePool::Get().Start();
+}
+
+void EndCookiePoolSession() {
+  CookiePool::Get().EndSession();
+}
+
+}  // namespace agens
