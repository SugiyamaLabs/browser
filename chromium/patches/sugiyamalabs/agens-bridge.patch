+// --- date: an <input>'s date, time, month or week picker. Values in the page's units
+// (valueAsNumber): ms since 1970-01-01 UTC for date, datetime-local and week, ms since midnight
+// for time, months since 1970-01 for month.
+
+const char* DateType(::ui::TextInputType type) {
+  switch (type) {
+    case ::ui::TEXT_INPUT_TYPE_DATE: return "date";
+    case ::ui::TEXT_INPUT_TYPE_DATE_TIME_LOCAL: return "datetime-local";
+    case ::ui::TEXT_INPUT_TYPE_MONTH: return "month";
+    case ::ui::TEXT_INPUT_TYPE_TIME: return "time";
+    case ::ui::TEXT_INPUT_TYPE_WEEK: return "week";
+    default: return nullptr;
+  }
+}
