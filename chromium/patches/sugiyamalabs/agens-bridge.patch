+class HostDateChooser : public blink::mojom::DateTimeChooser {
+ public:
+  explicit HostDateChooser(content::GlobalRenderFrameHostId frame) : frame_(frame) {}
+  ~HostDateChooser() override { Withdraw(std::exchange(ask_, 0)); }
+
+  void OpenDateTimeDialog(blink::mojom::DateTimeDialogValuePtr value, OpenDateTimeDialogCallback done) override {
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_);
+    content::WebContents* contents = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+    const char* type = DateType(value->dialog_type);
+    // One at a time (Blink asks again only after the first ended); the agent's tab: cancelled.
+    if (done_ || !contents || !type || AgentWorking(contents)) return std::move(done).Run(false, 0);
+    base::DictValue fields;
+    fields.Set("type", type);
+    if (std::isfinite(value->dialog_value)) fields.Set("value", value->dialog_value);
+    fields.Set("min", value->minimum);
+    fields.Set("max", value->maximum);
+    fields.Set("step", value->step);
+    base::ListValue suggestions;
+    for (const auto& suggestion : value->suggestions) {
+      base::DictValue entry;
+      entry.Set("value", suggestion->value);
+      entry.Set("label", base::UTF16ToUTF8(suggestion->label.empty() ? suggestion->localized_value : suggestion->label));
+      suggestions.Append(std::move(entry));
+    }
+    fields.Set("suggestions", std::move(suggestions));
+    SetAnchor(fields, contents, value->anchor);
+    done_ = std::move(done);
+    ask_ = Ask(contents, "date", std::move(fields),
+               base::BindOnce(&HostDateChooser::Answered, weak_.GetWeakPtr()));
+  }
+  // The page closed the picker first (the field went, it lost focus...).
+  void CloseDateTimeDialog() override {
+    Withdraw(std::exchange(ask_, 0));
+    if (done_) std::move(done_).Run(false, 0);
+  }
+
+ private:
+  void Answered(const base::DictValue* answer) {
+    ask_ = 0;
+    std::optional<double> value = answer ? answer->FindDouble("value") : std::nullopt;
+    if (done_) std::move(done_).Run(value.has_value(), value.value_or(0));
+  }
+
+  const content::GlobalRenderFrameHostId frame_;
+  int ask_ = 0;
+  OpenDateTimeDialogCallback done_;
+  base::WeakPtrFactory<HostDateChooser> weak_{this};
+};
