+                             const std::vector<blink::mojom::MenuItemPtr>& items);
+bool AgensEmbedShowContextMenu(RenderFrameHost& frame, const ContextMenuParams& params);
+
+// From RenderWidgetHostViewMac: the cursor it shows, and the caret (in the view, DIPs).
+void AgensEmbedCursorChanged(RenderWidgetHostViewMac* view, const ui::Cursor& cursor);
+void AgensEmbedCaretChanged(RenderWidgetHostViewMac* view, const gfx::Rect& caret);
