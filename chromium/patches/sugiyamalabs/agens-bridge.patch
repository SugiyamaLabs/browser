+#include "ui/gfx/image/image_skia_rep.h"
+
+namespace agens::bridge::view {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr size_t kMaxAddressChars = 8192;
+
+// A tab's number, given the first time the host could see it.
+class TabNumber : public content::WebContentsUserData<TabNumber> {
+ public:
+  const int n;
+
+ private:
+  TabNumber(content::WebContents* contents, int n)
+      : content::WebContentsUserData<TabNumber>(*contents), n(n) {}
+  friend class content::WebContentsUserData<TabNumber>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabNumber);
+
+int NumberOf(content::WebContents* contents) {
+  static int next = 0;
+  if (!TabNumber::FromWebContents(contents)) TabNumber::CreateForWebContents(contents, ++next);
+  return TabNumber::FromWebContents(contents)->n;
+}
+
+// The last layer a tab drew by itself, kept from every frame: a tab that is already drawn and idle
+// sends no new frame when the host attaches it.
