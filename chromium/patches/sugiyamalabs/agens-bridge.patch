diff --git a/chrome/browser/agens/bridge/approval.cc b/chrome/browser/agens/bridge/approval.cc
new file mode 100644
index 0000000000..66016c0331
--- /dev/null
+++ b/chrome/browser/agens/bridge/approval.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/approval.h"
+
+#include <cstdlib>
+#include <deque>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/agens/embed/native_shell.h"
+
+namespace agens::bridge {
+
+namespace {
+
+struct Ask {
+  uint64_t connection;
+  std::string title, detail;
+  bool offer_always;
+  ApprovalCallback done;  // null once that connection closed (its sheet may still be up)
+
+  bool SameQuestion(const Ask& other) const {
+    return title == other.title && detail == other.detail && offer_always == other.offer_always;
+  }
+};
+std::deque<Ask>& Asks() {
+  static base::NoDestructor<std::deque<Ask>> asks;
+  return *asks;
+}
+bool g_asking = false;
+
+void AskNext();
+
+// Runs (and removes) the front ask and every queued one asking the same.
+void Resolve(AgensApprovalAnswer answer) {
+  const Ask front = {0, Asks().front().title, Asks().front().detail, Asks().front().offer_always, {}};
+  std::vector<ApprovalCallback> dones;
+  for (auto it = Asks().begin(); it != Asks().end();) {
+    if (!it->SameQuestion(front)) {
+      ++it;
+      continue;
+    }
+    if (it->done) dones.push_back(std::move(it->done));
+    it = Asks().erase(it);
+  }
+  for (ApprovalCallback& done : dones) std::move(done).Run(answer);
+}
+
+void Answered(AgensApprovalAnswer answer) {
+  g_asking = false;
+  if (Asks().empty()) return;
+  Resolve(answer);
+  AskNext();
+}
+
+#if !defined(OFFICIAL_BUILD)
+// Test seam, never in official builds: AGENS_BRIDGE_TEST_ANSWER=allow|always|deny answers every
+// approval without a sheet. Deliberately no pref or switch: the sheet guards session secrets.
+std::optional<AgensApprovalAnswer> TestAnswer(bool offer_always) {
+  const char* value = getenv("AGENS_BRIDGE_TEST_ANSWER");
+  if (!value) return std::nullopt;
+  const std::string answer = value;
+  if (answer == "allow") return kAgensApprovalAllow;
+  if (answer == "always") return offer_always ? kAgensApprovalAllowAlways : kAgensApprovalAllow;
+  if (answer == "deny") return kAgensApprovalDeny;
+  return std::nullopt;
+}
+#endif
+
+void AskNext() {
+  while (!g_asking && !Asks().empty()) {
+    const Ask& front = Asks().front();
+#if !defined(OFFICIAL_BUILD)
+    if (std::optional<AgensApprovalAnswer> answer = TestAnswer(front.offer_always)) {
+      LOG(WARNING) << "agens bridge: AGENS_BRIDGE_TEST_ANSWER answered an approval without a sheet ("
+                   << *answer << ")";
+      Resolve(*answer);
+      continue;
+    }
+#endif
+    g_asking = true;
+    // Copies: it may answer right away (no window to ask on), and Answered then erases `front`.
+    const std::string title = front.title, detail = front.detail;
+    agens::ShowApprovalSheet(title, detail, front.offer_always, base::BindOnce(&Answered));
+  }
+}
+
+}  // namespace
+
+void AskApproval(uint64_t connection,
+                 std::string title,
+                 std::string detail,
+                 bool offer_always,
+                 ApprovalCallback done) {
+  Asks().push_back({connection, std::move(title), std::move(detail), offer_always, std::move(done)});
+  AskNext();
+}
+
+void CancelApprovals(uint64_t connection) {
+  for (auto it = Asks().begin(); it != Asks().end();) {
+    if (it->connection != connection) {
+      ++it;
+    } else if (g_asking && it == Asks().begin()) {
+      (it++)->done.Reset();
+    } else {
+      it = Asks().erase(it);
+    }
+  }
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/approval.h b/chrome/browser/agens/bridge/approval.h
new file mode 100644
index 0000000000..f9a53def1b
--- /dev/null
+++ b/chrome/browser/agens/bridge/approval.h
@@ -0,0 +1,36 @@
+// Copyright 2026 SugiyamaLabs.
+// Approval sheets for the socket: the person's OK before something happens on a client's behalf.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_APPROVAL_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_APPROVAL_H_
+
+#include <cstdint>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/agens/embed/agens_embed.h"
+
+namespace agens::bridge {
+
+using ApprovalCallback = base::OnceCallback<void(AgensApprovalAnswer)>;
+
+// UI thread. Asks the person, for the client on `connection`, with a sheet on the most recently
+// active window: `title` is the question (pt-BR), `detail` the text under it (may be multi-line),
+// `offer_always` adds "Permitir sempre". "Não permitir" is the Return default.
+// - One sheet at a time, in order. Pending asks with the same title, detail and offer_always are
+//   answered together by one sheet.
+// - `done` runs once with the answer; kAgensApprovalDeny when there is no window to ask on or it
+//   closes first. Remembering kAgensApprovalAllowAlways is the caller's job.
+// - `done` never runs if `connection` closes first (its queued asks are dropped; a sheet already
+//   showing stays up and its answer goes only to the other asks it covers).
+void AskApproval(uint64_t connection,
+                 std::string title,
+                 std::string detail,
+                 bool offer_always,
+                 ApprovalCallback done);
+
+// UI thread, from OnConnectionClosed (ops.h).
+void CancelApprovals(uint64_t connection);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_APPROVAL_H_
