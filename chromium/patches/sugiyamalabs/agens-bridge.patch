+// Copyright 2026 SugiyamaLabs.
+// The local control socket, `<user data dir>/agens.sock` (docs/agens.md, "O socket"). Accepts and
+// reads on the IO thread, runs each operation on the UI thread (ops.cc) and writes the reply back.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_BRIDGE_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_BRIDGE_H_
+
+#include <string_view>
+
+#include "base/functional/callback_forward.h"
+#include "base/values.h"
+
+class PrefRegistrySimple;
+
+namespace agens::bridge {
+
+// Local State. Dev setting (Configurações › Sistema): clients without our signature get in.
+inline constexpr char kAcceptUnsignedPref[] = "agens.bridge.accept_unsigned";
+// Clients answered "Permitir sempre": "<team id>/<signing identifier>".
+inline constexpr char kAllowedClientsPref[] = "agens.bridge.allowed_clients";
+// control.start answered "Permitir sempre": ControlAlwaysKey (control_keys.h) strings.
+inline constexpr char kControlAlwaysPref[] = "agens.bridge.control_always";
+
+void RegisterPrefs(PrefRegistrySimple* registry);
+// UI thread. Start once the threads run; Stop at teardown removes the socket file.
+void Start();
+void Stop();
+// UI thread. Sends `{"event": name, ...fields}` to every authorized client.
+void SendEvent(std::string_view name, base::DictValue fields);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_BRIDGE_H_
diff --git a/chrome/browser/agens/bridge/bridge_mac.mm b/chrome/browser/agens/bridge/bridge_mac.mm
new file mode 100644
index 0000000000..7d1d1de5a3
--- /dev/null
+++ b/chrome/browser/agens/bridge/bridge_mac.mm
@@ -0,0 +1,535 @@
+// Copyright 2026 SugiyamaLabs.
+// The socket server on macOS: a Unix socket in the user data dir, the peer's code signature read
+// from its audit token, and the approval of the person before a signed client gets in.
+
+#include "chrome/browser/agens/bridge/bridge.h"
+
+#import <Foundation/Foundation.h>
+#include <Security/Security.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <deque>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/apple/bridging.h"
+#include "base/apple/foundation_util.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/message_loop/message_pump_for_io.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/current_thread.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/ops.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+#include "chrome/browser/agens/embed/native_shell.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace agens::bridge {
+
+namespace {
+
+// PLACEHOLDER: our Apple Team ID (10 characters, from the Developer account). Not known yet: no
+// signing identity on the build machine. Until it is set no client passes the signature check, so
+// only "Aceitar apps sem assinatura" lets clients in.
+constexpr char kTeamId[] = "TEAM_ID_PLACEHOLDER";
+
+constexpr char kSocketName[] = "agens.sock";
+
+// Same-user DoS bounds: requests held while the approval is pending, replies the client hasn't
+// read, and open connections.
+constexpr size_t kMaxWaitingBytes = 64 * 1024;
+constexpr size_t kMaxPendingOutput = 16 << 20;  // a page.screenshot reply alone can pass 1 MB
+constexpr size_t kMaxConnections = 16;
+
+// --- Who is on the other side (thread pool: the Security calls may block).
+
+struct Peer {
+  bool ours = false;     // signed with kTeamId
+  std::string identity;  // "<team id>/<signing identifier>", only when ours
+  std::string name;      // the app's name, for the approval sheet
+};
+
+std::string AppName(SecCodeRef code, const std::string& fallback) {
+  CFURLRef url = nullptr;
+  if (SecCodeCopyPath(code, kSecCSDefaultFlags, &url) != errSecSuccess || !url) return fallback;
+  base::apple::ScopedCFTypeRef<CFURLRef> owned(url);
+  NSURL* path = base::apple::CFToNSPtrCast(url);
+  NSBundle* bundle = [NSBundle bundleWithURL:path];
+  NSString* name = [bundle objectForInfoDictionaryKey:@"CFBundleDisplayName"]
+                       ?: [bundle objectForInfoDictionaryKey:@"CFBundleName"];
+  if (![name isKindOfClass:NSString.class] || !name.length) {
+    name = path.lastPathComponent.stringByDeletingPathExtension;
+  }
+  return name.length ? base::SysNSStringToUTF8(name) : fallback;
+}
+
+Peer CheckPeer(audit_token_t token) {
+  Peer peer;
+  peer.name = "app";
+  base::apple::ScopedCFTypeRef<CFDataRef> data(
+      CFDataCreate(nullptr, reinterpret_cast<const UInt8*>(&token), sizeof(token)));
+  NSDictionary* attributes = @{
+    base::apple::CFToNSPtrCast(kSecGuestAttributeAudit) : base::apple::CFToNSPtrCast(data.get())
+  };
+  SecCodeRef raw_code = nullptr;
+  if (SecCodeCopyGuestWithAttributes(nullptr, base::apple::NSToCFPtrCast(attributes),
+                                     kSecCSDefaultFlags, &raw_code) != errSecSuccess ||
+      !raw_code) {
+    return peer;
+  }
+  base::apple::ScopedCFTypeRef<SecCodeRef> code(raw_code);
+
+  CFDictionaryRef raw_info = nullptr;
+  std::string identifier;
+  if (SecCodeCopySigningInformation(code.get(), kSecCSSigningInformation, &raw_info) ==
+          errSecSuccess &&
+      raw_info) {
+    base::apple::ScopedCFTypeRef<CFDictionaryRef> info(raw_info);
+    if (CFStringRef id = base::apple::GetValueFromDictionary<CFStringRef>(info.get(),
+                                                                          kSecCodeInfoIdentifier)) {
+      identifier = base::SysCFStringRefToUTF8(id);
+    }
+  }
+  peer.name = AppName(code.get(), identifier.empty() ? peer.name : identifier);
+
+  const std::string requirement_text =
+      std::string("anchor apple generic and certificate leaf[subject.OU] = \"") + kTeamId + "\"";
+  SecRequirementRef raw_requirement = nullptr;
+  if (SecRequirementCreateWithString(base::SysUTF8ToCFStringRef(requirement_text).get(),
+                                     kSecCSDefaultFlags, &raw_requirement) != errSecSuccess ||
+      !raw_requirement) {
+    return peer;
+  }
+  base::apple::ScopedCFTypeRef<SecRequirementRef> requirement(raw_requirement);
+  // Checks the running process (dynamic validity) against our Team ID.
+  if (SecCodeCheckValidity(code.get(), kSecCSDefaultFlags, requirement.get()) == errSecSuccess &&
+      !identifier.empty()) {
+    peer.ours = true;
+    peer.identity = std::string(kTeamId) + "/" + identifier;
+  }
+  return peer;
+}
+
+// --- The decision (UI thread). `done` gets nullptr to let the client in, else the error code.
+
+using Decision = base::OnceCallback<void(const char* error)>;
+
+bool AlwaysAllowed(const std::string& identity) {
+  const base::ListValue& list = g_browser_process->local_state()->GetList(kAllowedClientsPref);
+  return std::ranges::contains(list, base::Value(identity));
+}
+
+void Decide(Peer peer, uint64_t connection, Decision done) {
+  if (!g_browser_process || g_browser_process->IsShuttingDown()) {
+    std::move(done).Run(kDenied);
+    return;
+  }
+  if (!peer.ours) {
+    const bool accept = g_browser_process->local_state()->GetBoolean(kAcceptUnsignedPref);
+    std::move(done).Run(accept ? nullptr : kUnauthorized);
+    return;
+  }
+  if (AlwaysAllowed(peer.identity)) {
+    std::move(done).Run(nullptr);
+    return;
+  }
+  // Connections of the same app ask the same question, so one sheet answers them all.
+  AskApproval(connection, "O " + peer.name + " quer usar o AgensBrowser", "Ele poderá ver, criar e abrir os seus atos.",
+              /*offer_always=*/true,
+              base::BindOnce(
+                  [](std::string identity, Decision done, AgensApprovalAnswer answer) {
+                    if (answer == kAgensApprovalAllowAlways && !AlwaysAllowed(identity)) {
+                      ScopedListPrefUpdate(g_browser_process->local_state(), kAllowedClientsPref)->Append(identity);
+                    }
+                    std::move(done).Run(answer == kAgensApprovalDeny ? kDenied : nullptr);
+                  },
+                  peer.identity, std::move(done)));
+}
+
+// --- The server (IO thread).
+
+class Server;
+
+class Connection : public base::MessagePumpForIO::FdWatcher {
+ public:
+  Connection(Server* server, base::ScopedFD fd) : server_(server), fd_(std::move(fd)) {
+    static uint64_t next_id = 0;  // IO thread only
+    client_.connection = ++next_id;
+  }
+
+  void Start();
+  void Send(std::string line);
+
+ private:
+  enum class State { kChecking, kAllowed, kClosing };
+
+  void Checked(Peer peer);
+  void Authorized(const char* error);
+  void Handle(std::string line);
+  void Flush();
+  void Close();
+
+  // base::MessagePumpForIO::FdWatcher:
+  void OnFileCanReadWithoutBlocking(int fd) override;
+  void OnFileCanWriteWithoutBlocking(int fd) override;
+
+  raw_ptr<Server> server_;
+  base::ScopedFD fd_;
+  Client client_;  // name and identity filled once the signature is read
+  State state_ = State::kChecking;
+  LineFramer framer_;
+  std::vector<std::string> waiting_;  // lines read before the client was let in
+  size_t waiting_bytes_ = 0;
+  bool closed_posted_ = false;
+  std::string out_;
+  base::MessagePumpForIO::FdWatchController read_watch_{FROM_HERE};
+  base::MessagePumpForIO::FdWatchController write_watch_{FROM_HERE};
+  bool writing_ = false;
+  base::WeakPtrFactory<Connection> weak_{this};
+
+  friend class Server;
+};
+
+class Server : public base::MessagePumpForIO::FdWatcher {
+ public:
+  explicit Server(base::ScopedFD fd) : fd_(std::move(fd)) {
+    base::CurrentIOThread::Get()->WatchFileDescriptor(fd_.get(), /*persistent=*/true,
+                                                      base::MessagePumpForIO::WATCH_READ,
+                                                      &watch_, this);
+  }
+
+  void Remove(Connection* connection) {
+    auto it = connections_.find(connection);
+    if (it == connections_.end()) return;
+    // Not now: we may be inside one of its watcher callbacks.
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, std::move(it->second));
+    connections_.erase(it);
+    ResumeAccept();  // its descriptor is about to be free
+  }
+
+  void SendTo(uint64_t connection, const std::string& line) {
+    for (auto& [c, owned] : connections_) {
+      if (c->client_.connection == connection && c->state_ == Connection::State::kAllowed) c->Send(line);
+    }
+  }
+
+  void Broadcast(const std::string& line) {
+    for (auto& [connection, owned] : connections_) {
+      if (connection->state_ == Connection::State::kAllowed) connection->Send(line);
+    }
+  }
+
+ private:
+  // base::MessagePumpForIO::FdWatcher:
+  void OnFileCanReadWithoutBlocking(int) override {
+    for (;;) {
+      base::ScopedFD client(HANDLE_EINTR(accept(fd_.get(), nullptr, nullptr)));
+      if (!client.is_valid()) {
+        if (errno == EMFILE || errno == ENFILE) {
+          // The pending connection keeps the socket readable: stop watching or this spins.
+          PLOG(ERROR) << "agens bridge: accept";
+          watch_.StopWatchingFileDescriptor();
+          paused_ = true;
+          base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+              FROM_HERE, base::BindOnce(&Server::ResumeAccept, weak_.GetWeakPtr()), base::Seconds(1));
+        } else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != ECONNABORTED) {
+          PLOG(ERROR) << "agens bridge: accept";
+        }
+        return;
+      }
+      if (connections_.size() >= kMaxConnections) continue;  // refused: closed right away
+      const int one = 1;
+      setsockopt(client.get(), SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+      if (fcntl(client.get(), F_SETFL, fcntl(client.get(), F_GETFL) | O_NONBLOCK) != 0) continue;
+      auto connection = std::make_unique<Connection>(this, std::move(client));
+      Connection* raw = connection.get();
+      connections_[raw] = std::move(connection);
+      raw->Start();
+    }
+  }
+  void OnFileCanWriteWithoutBlocking(int) override {}
+
+  void ResumeAccept() {
+    if (!paused_) return;
+    paused_ = false;
+    base::CurrentIOThread::Get()->WatchFileDescriptor(fd_.get(), /*persistent=*/true,
+                                                      base::MessagePumpForIO::WATCH_READ, &watch_, this);
+  }
+
+  base::ScopedFD fd_;
+  base::MessagePumpForIO::FdWatchController watch_{FROM_HERE};
+  bool paused_ = false;
+  // Before weak_: connections go first, then pending ResumeAccept tasks are cancelled.
+  std::map<Connection*, std::unique_ptr<Connection>> connections_;
+  base::WeakPtrFactory<Server> weak_{this};
+};
+
+void Connection::Start() {
+  base::CurrentIOThread::Get()->WatchFileDescriptor(fd_.get(), /*persistent=*/true,
+                                                    base::MessagePumpForIO::WATCH_READ,
+                                                    &read_watch_, this);
+  audit_token_t token;
+  socklen_t size = sizeof(token);
+  if (getsockopt(fd_.get(), SOL_LOCAL, LOCAL_PEERTOKEN, &token, &size) != 0) {
+    PLOG(ERROR) << "agens bridge: LOCAL_PEERTOKEN";
+    Authorized(kUnauthorized);
+    return;
+  }
+  // Signature (thread pool) → decision (UI) → back here.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE}, base::BindOnce(&CheckPeer, token),
+      base::BindOnce(&Connection::Checked, weak_.GetWeakPtr()));
+}
+
+// Back on IO; skipped when the connection closed meanwhile. A close after this posts
+// OnConnectionClosed behind Decide, so the UI drops the ask.
+void Connection::Checked(Peer peer) {
+  client_.name = peer.name;
+  client_.identity = peer.identity;
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&Decide, std::move(peer), client_.connection,
+                                base::BindPostTask(content::GetIOThreadTaskRunner({}),
+                                                   base::BindOnce(&Connection::Authorized, weak_.GetWeakPtr()))));
+}
+
+void Connection::Authorized(const char* error) {
+  if (state_ != State::kChecking) return;
+  if (error) {
+    // Each waiting request gets the refusal; a client that sent nothing gets one without id.
+    if (waiting_.empty()) out_ += ErrorReply(nullptr, error);
+    for (const std::string& line : waiting_) {
+      std::string reply;
+      if (std::optional<Request> request = ParseRequest(line, reply)) {
+        reply = ErrorReply(&request->id, error);
+      }
+      out_ += reply;
+    }
+    waiting_.clear();
+    state_ = State::kClosing;
+    Flush();
+    return;
+  }
+  state_ = State::kAllowed;
+  std::vector<std::string> lines = std::move(waiting_);
+  waiting_.clear();
+  for (std::string& line : lines) Handle(std::move(line));
+}
+
+void Connection::Handle(std::string line) {
+  std::string error;
+  std::optional<Request> request = ParseRequest(line, error);
+  if (!request) {
+    Send(std::move(error));
+    return;
+  }
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&HandleOp, client_, std::move(*request),
+                                base::BindPostTask(content::GetIOThreadTaskRunner({}),
+                                                   base::BindOnce(&Connection::Send, weak_.GetWeakPtr()))));
+}
+
+void Connection::Send(std::string line) {
+  if (state_ == State::kClosing) return;
+  out_ += line;
+  if (out_.size() > kMaxPendingOutput) {
+    Close();  // the client stopped reading
+    return;
+  }
+  Flush();
+}
+
+void Connection::Flush() {
+  while (!out_.empty()) {
+    const ssize_t n = HANDLE_EINTR(write(fd_.get(), out_.data(), out_.size()));
+    if (n < 0) {
+      if (errno == EAGAIN || errno == EWOULDBLOCK) {
+        if (!writing_) {
+          writing_ = base::CurrentIOThread::Get()->WatchFileDescriptor(
+              fd_.get(), /*persistent=*/true, base::MessagePumpForIO::WATCH_WRITE, &write_watch_, this);
+        }
+        return;
+      }
+      out_.clear();
+      Close();
+      return;
+    }
+    out_.erase(0, n);
+  }
+  if (writing_) {
+    write_watch_.StopWatchingFileDescriptor();
+    writing_ = false;
+  }
+  if (state_ == State::kClosing) Close();
+}
+
+void Connection::Close() {
+  if (!closed_posted_) {  // Close can run twice (a write error while closing)
+    closed_posted_ = true;
+    content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE,
+                                                 base::BindOnce(&OnConnectionClosed, client_.connection));
+  }
+  read_watch_.StopWatchingFileDescriptor();
+  write_watch_.StopWatchingFileDescriptor();
+  writing_ = false;
+  state_ = State::kClosing;
+  weak_.InvalidateWeakPtrs();
+  server_->Remove(this);
+}
+
+void Connection::OnFileCanReadWithoutBlocking(int) {
+  char buffer[64 * 1024];
+  for (;;) {
+    const ssize_t n = HANDLE_EINTR(read(fd_.get(), buffer, sizeof(buffer)));
+    if (n == 0 || (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK)) {
+      Close();
+      return;
+    }
+    if (n < 0) return;
+    std::vector<std::string> lines;
+    if (!framer_.Append(std::string_view(buffer, n), lines)) {
+      Close();  // a line past kMaxLineBytes
+      return;
+    }
+    for (std::string& line : lines) {
+      if (state_ == State::kChecking) {
+        waiting_bytes_ += line.size();
+        if (waiting_bytes_ > kMaxWaitingBytes) {
+          Close();
+          return;
+        }
+        waiting_.push_back(std::move(line));
+      } else if (state_ == State::kAllowed) {
+        Handle(std::move(line));
+      }
+    }
+    if (state_ == State::kClosing) return;
+  }
+}
+
+void Connection::OnFileCanWriteWithoutBlocking(int) {
+  Flush();
+}
+
+// --- Lifetime.
+
+Server* g_server = nullptr;  // IO thread only
+base::FilePath& SocketPath() {  // UI thread only
+  static base::NoDestructor<base::FilePath> path;
+  return *path;
+}
+
+void StartOnIO(base::ScopedFD fd) {
+  DCHECK(!g_server);
+  g_server = new Server(std::move(fd));
+}
+
+void StopOnIO() {
+  delete g_server;
+  g_server = nullptr;
+}
+
+base::ScopedFD Listen(const base::FilePath& path) {
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  if (path.value().size() >= sizeof(address.sun_path)) {
+    LOG(ERROR) << "agens bridge: socket path too long (" << path.value().size() << " bytes, max "
+               << sizeof(address.sun_path) - 1 << "): " << path.value() << "; the socket is off";
+    return {};
+  }
+  strlcpy(address.sun_path, path.value().c_str(), sizeof(address.sun_path));
+  // Only one browser runs per user data dir (the process singleton), so a socket left here is
+  // stale. Anything else at that path is not ours to delete.
+  struct stat info;
+  if (lstat(address.sun_path, &info) == 0) {
+    if (!S_ISSOCK(info.st_mode)) {
+      LOG(ERROR) << "agens bridge: " << path.value() << " exists and is not a socket; the socket is off";
+      return {};
+    }
+    unlink(address.sun_path);
+  }
+  base::ScopedFD fd(socket(AF_UNIX, SOCK_STREAM, 0));
+  if (!fd.is_valid() || fcntl(fd.get(), F_SETFL, fcntl(fd.get(), F_GETFL) | O_NONBLOCK) != 0 ||
+      bind(fd.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+    PLOG(ERROR) << "agens bridge: bind " << path.value();
+    return {};
+  }
+  // Before listen(), so nobody connects while it is still wider than 0600.
+  if (chmod(address.sun_path, 0600) != 0 || listen(fd.get(), SOMAXCONN) != 0) {
+    PLOG(ERROR) << "agens bridge: listen " << path.value();
+    unlink(address.sun_path);
+    return {};
+  }
+  return fd;
+}
+
+}  // namespace
+
+void RegisterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kAcceptUnsignedPref, false);
+  registry->RegisterListPref(kAllowedClientsPref);
+  registry->RegisterListPref(kControlAlwaysPref);
+}
+
+void Start() {
+  base::FilePath dir;
+  if (!SocketPath().empty() || !base::PathService::Get(chrome::DIR_USER_DATA, &dir)) return;
+  const base::FilePath path = dir.AppendASCII(kSocketName);
+  base::ScopedFD fd = Listen(path);
+  if (!fd.is_valid()) return;
+  SocketPath() = path;
+  content::GetIOThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(&StartOnIO, std::move(fd)));
+}
+
+void Stop() {
+  if (SocketPath().empty()) return;
+  unlink(SocketPath().value().c_str());
+  SocketPath().clear();
+  content::GetIOThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(&StopOnIO));
+}
+
+void SendEvent(std::string_view name, base::DictValue fields) {
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](std::string line) {
+                       if (g_server) g_server->Broadcast(line);
+                     },
+                     EventLine(name, std::move(fields))));
+}
+
+void SendEventTo(uint64_t connection, std::string_view name, base::DictValue fields) {
+  content::GetIOThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](uint64_t connection, std::string line) {
+                       if (g_server) g_server->SendTo(connection, line);
+                     },
+                     connection, EventLine(name, std::move(fields))));
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/control_keys.cc b/chrome/browser/agens/bridge/control_keys.cc
new file mode 100644
index 0000000000..6f41b799ed
--- /dev/null
+++ b/chrome/browser/agens/bridge/control_keys.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/control_keys.h"
+
+#include <algorithm>
+
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace agens::bridge {
+
+namespace {
+
+struct Named {
+  const char* name;
+  int windows_code;
+  bool edits;
+};
+// DOM key and code are the same string for all of these.
+constexpr Named kNamed[] = {
+    {"Enter", 0x0D, false},     {"Tab", 0x09, false},        {"Escape", 0x1B, false},
+    {"Backspace", 0x08, true},  {"Delete", 0x2E, true},      {"ArrowUp", 0x26, false},
+    {"ArrowDown", 0x28, false}, {"ArrowLeft", 0x25, false},  {"ArrowRight", 0x27, false},
+    {"PageUp", 0x21, false},    {"PageDown", 0x22, false},   {"Home", 0x24, false},
+    {"End", 0x23, false},
+};
+
+}  // namespace
+
+std::optional<Key> ParseKey(std::string_view name, const base::Value* modifiers) {
+  Key key;
+  if (modifiers) {
+    if (!modifiers->is_list()) return std::nullopt;
+    for (const base::Value& m : modifiers->GetList()) {
+      const std::string* s = m.GetIfString();
+      if (!s) return std::nullopt;
+      if (*s == "shift") {
+        key.shift = true;
+      } else if (*s == "meta") {
+        key.meta = true;
+      } else if (*s == "alt") {
+        key.alt = true;
+      } else if (*s == "ctrl") {
+        key.ctrl = true;
+      } else {
+        return std::nullopt;
+      }
+    }
+  }
+  for (const Named& n : kNamed) {
+    if (name == n.name) {
+      key.key = key.code = n.name;
+      key.windows_code = n.windows_code;
+      key.edits = n.edits;
+      if (key.key == "Enter") key.text = u"\r";
+      return key;
+    }
+  }
+  std::u16string text;
+  if (!base::UTF8ToUTF16(name.data(), name.size(), &text) || text.empty() || text.size() > 2) return std::nullopt;
+  if (text.size() == 2 && !(text[0] >= 0xD800 && text[0] < 0xDC00)) return std::nullopt;  // two characters
+  if (text[0] < 0x20 || text[0] == 0x7F) return std::nullopt;  // control characters: use the names
+  key.key = std::string(name);
+  key.text = text;
+  key.edits = true;
+  const char16_t c = text.size() == 1 ? text[0] : 0;
+  if (c >= 'a' && c <= 'z') {
+    key.windows_code = c - 'a' + 'A';
+  } else if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+    key.windows_code = c;
+  } else if (c == ' ') {
+    key.windows_code = 0x20;
+    key.code = "Space";
+  }
+  if (key.windows_code >= 'A' && key.windows_code <= 'Z') {
+    key.code = std::string("Key") + static_cast<char>(key.windows_code);
+  } else if (key.windows_code >= '0' && key.windows_code <= '9') {
+    key.code = std::string("Digit") + static_cast<char>(key.windows_code);
+  }
+  if (key.meta || key.ctrl) key.text.clear();  // a shortcut, not typing
+  return key;
+}
+
+bool AllowedOnPassword(const Key& key) {
+  return !key.edits && !key.meta && !key.alt && !key.ctrl;
+}
+
+std::string ControlAlwaysKey(std::string_view identity, std::string_view ato, std::vector<std::string> shares_with) {
+  std::ranges::sort(shares_with);
+  base::ListValue key;  // JSON: no separator a name could contain
+  key.Append(identity);
+  key.Append(ato);
+  for (std::string& folder : shares_with) key.Append(std::move(folder));
+  return base::WriteJson(key).value_or(std::string());
+}
+
+std::string JoinNames(const std::vector<std::string>& names) {
+  std::string out;
+  for (size_t i = 0; i < names.size(); ++i) {
+    if (i) out += i + 1 == names.size() ? " e " : ", ";
+    out += names[i];
+  }
+  return out;
+}
+
+bool TouchesClipboard(const Key& key) {
+  if (key.key == "Delete" && key.shift) return true;  // cut, on Windows and Linux
+  if (!key.meta && !key.ctrl) return false;
+  return key.windows_code == 'C' || key.windows_code == 'X' || key.windows_code == 'V';
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/control_keys.h b/chrome/browser/agens/bridge/control_keys.h
new file mode 100644
index 0000000000..972a04f6a5
--- /dev/null
+++ b/chrome/browser/agens/bridge/control_keys.h
@@ -0,0 +1,48 @@
+// Copyright 2026 SugiyamaLabs.
+// page.key's key names and the password rules that depend on them (docs/protocolo.md, "control,
+// tab, page"). Pure logic, checked by protocol_selfcheck.cc with only //base.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_CONTROL_KEYS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_CONTROL_KEYS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+namespace agens::bridge {
+
+struct Key {
+  std::string key;        // DOM key value: "Enter", "a"
+  std::string code;       // DOM code: "Enter", "KeyA"; empty when it has none we know
+  int windows_code = 0;   // Windows virtual key code (Chromium's ui::KeyboardCode); 0 when none
+  std::u16string text;    // what it types: the character, "\r" for Enter; empty for the others
+  bool shift = false, meta = false, alt = false, ctrl = false;
+  bool edits = false;     // inserts or deletes text
+};
+
+// A named key (Enter, Tab, Escape, Backspace, Delete, ArrowUp/Down/Left/Right, PageUp/PageDown,
+// Home, End) or one character, with `modifiers` ("shift", "meta", "alt", "ctrl"; may be null).
+// nullopt for anything else.
+std::optional<Key> ParseKey(std::string_view name, const base::Value* modifiers);
+
+// Allowed while a password field has the focus: keys that move, never ones that type, delete or
+// carry a modifier other than Shift. Enter is allowed on purpose: it submits a form with a
+// password the person typed, and the controller never sees the value.
+bool AllowedOnPassword(const Key& key);
+
+// Copy, cut or paste: never, so the clipboard stays out of the controller's reach.
+bool TouchesClipboard(const Key& key);
+
+// control.start's "Permitir sempre": what Local State remembers, one string per answer. The
+// app's identity, the ato's folder and the folders of the atos it shares cookies with (any order),
+// so that a change in that group asks again.
+std::string ControlAlwaysKey(std::string_view identity, std::string_view ato, std::vector<std::string> shares_with);
+
+// "A", "A e B", "A, B e C".
+std::string JoinNames(const std::vector<std::string>& names);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_CONTROL_KEYS_H_
diff --git a/chrome/browser/agens/bridge/control_ops.cc b/chrome/browser/agens/bridge/control_ops.cc
new file mode 100644
index 0000000000..60916496fa
--- /dev/null
+++ b/chrome/browser/agens/bridge/control_ops.cc
@@ -0,0 +1,498 @@
+// Copyright 2026 SugiyamaLabs.
+// The control session (docs/protocolo.md, "control, tab, page"): an app, after the person's OK,
+// drives tabs of one ato. It belongs to the connection and ends on control.stop, when the
+// connection closes, or when the person presses "Parar" on a controlled tab.
+// - It only ever sees the tabs it opened: ids are its own, valid for this session only.
+// - Controlled tabs are marked (AgensControlled): the shell shows it; saved passwords, autofill
+//   and downloads stay out of them.
+
+#include "chrome/browser/agens/bridge/control_ops.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/bridge.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+#include "chrome/browser/agens/bridge/control_page.h"
+#include "chrome/browser/agens/embed/agens_controlled.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/invalidate_type.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace agens::bridge::control {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr size_t kMaxReasonChars = 1024;
+// tab.open and tab.navigate answer when the navigation commits or fails, or after this.
+constexpr base::TimeDelta kNavigationWait = base::Seconds(30);
+constexpr size_t kMaxTypeChars = 10000;
+
+void StopByUser(uint64_t connection);
+
+// A tab the session opened. Marks it while it lives, and unmarks it when the session lets go.
+class Tab : public content::WebContentsObserver {
+ public:
+  Tab(uint64_t connection, std::string id, content::WebContents* contents, const std::string& client)
+      : content::WebContentsObserver(contents), id(std::move(id)), page(contents), connection_(connection) {
+    AgensControlled::CreateForWebContents(contents);
+    AgensControlled* mark = AgensControlled::FromWebContents(contents);
+    mark->by = client;
+    mark->stop = base::BindRepeating(&StopByUser, connection);
+    // Keeps rendering while in the background: input, screenshots and the accessibility tree work
+    // on a tab that isn't the active one.
+    capture_ = contents->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+                                                /*is_activity=*/false);
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);  // the shell redraws it
+  }
+  ~Tab() override {
+    Answer(ErrorReply(&waiting_id_, kFailed, "the tab is no longer controlled"));
+    if (content::WebContents* contents = web_contents()) {
+      contents->RemoveUserData(AgensControlled::UserDataKey());
+      contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+    }
+  }
+
+  const std::string id;  // "t1", "t2"… for this session
+  Page page;
+
+  // Answers `request_id` with {tab} once `navigation_id` finishes (or kNavigationWait passes).
+  void WaitFor(int64_t navigation_id, base::Value request_id, ReplyCallback reply) {
+    AnswerOk();  // an earlier wait: its navigation was replaced by this one
+    waiting_navigation_ = navigation_id;
+    waiting_id_ = std::move(request_id);
+    waiting_reply_ = std::move(reply);
+    waiting_timer_.Start(FROM_HERE, kNavigationWait, base::BindOnce(&Tab::AnswerOk, base::Unretained(this)));
+  }
+  void AnswerOk() {
+    base::DictValue result;
+    result.Set("tab", id);
+    Answer(OkReply(waiting_id_, std::move(result)));
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (waiting_reply_ && handle->GetNavigationId() == waiting_navigation_) AnswerOk();  // a failed load is ok too
+  }
+  void WebContentsDestroyed() override;
+
+ private:
+  void Answer(std::string line) {
+    waiting_timer_.Stop();
+    if (waiting_reply_) std::move(waiting_reply_).Run(std::move(line));
+  }
+
+  const uint64_t connection_;
+  base::ScopedClosureRunner capture_;
+  int64_t waiting_navigation_ = 0;
+  base::Value waiting_id_;
+  ReplyCallback waiting_reply_;
+  base::OneShotTimer waiting_timer_;
+};
+
+// One app's control of one ato.
+struct Session {
+  std::string client;  // the app's name, shown on its tabs
+  base::FilePath ato;  // the ato's profile folder
+  std::vector<std::string> shares_with;  // SharesWith(ato) when the person agreed
+  std::vector<std::unique_ptr<Tab>> tabs;
+  int next_tab = 1;
+
+  Tab* Find(const std::string& id) {
+    for (auto& tab : tabs) {
+      if (tab->id == id) return tab.get();
+    }
+    return nullptr;
+  }
+};
+std::map<uint64_t, Session>& Sessions() {
+  static base::NoDestructor<std::map<uint64_t, Session>> sessions;
+  return *sessions;
+}
+// Connections whose control.start waits for the person.
+std::set<uint64_t>& Asking() {
+  static base::NoDestructor<std::set<uint64_t>> asking;
+  return *asking;
+}
+
+void Tab::WebContentsDestroyed() {
+  // The person closed it: forget it (this deletes `this`).
+  capture_.ReplaceClosure(base::OnceClosure());
+  Observe(nullptr);
+  auto it = Sessions().find(connection_);
+  if (it == Sessions().end()) return;
+  std::erase_if(it->second.tabs, [this](const std::unique_ptr<Tab>& tab) { return tab.get() == this; });
+}
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+// Ends the session. Its tabs stay open and are no longer controlled, unless `close_tabs`.
+void End(uint64_t connection, bool close_tabs) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end()) return;
+  std::vector<std::unique_ptr<Tab>> tabs = std::move(it->second.tabs);
+  Sessions().erase(it);
+  std::vector<content::WebContents*> to_close;
+  for (auto& tab : tabs) {
+    if (close_tabs && tab->web_contents()) to_close.push_back(tab->web_contents());
+  }
+  tabs.clear();  // unmarks them
+  for (content::WebContents* contents : to_close) contents->Close();
+}
+
+// Ends the session from the browser's side (tabs stay open) and tells the client why.
+void Stop(uint64_t connection, std::string_view reason) {
+  if (!Sessions().contains(connection)) return;
+  End(connection, /*close_tabs=*/false);
+  base::DictValue fields;
+  fields.Set("reason", reason);
+  SendEventTo(connection, "control.stopped", std::move(fields));
+}
+void StopByUser(uint64_t connection) {
+  Stop(connection, "user");
+}
+
+// The folders of the atos whose cookies `ato` shares ("Compartilhar cookies"), sorted; empty when
+// it shares with none. Their logins are within reach of whoever controls `ato`.
+std::vector<std::string> SharesWith(const base::FilePath& ato) {
+  std::vector<std::string> folders;
+  if (!AgensWindow::AtoSharesCookies(ato)) return folders;
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath() != ato && AgensWindow::AtoSharesCookies(entry->GetPath())) {
+      folders.push_back(entry->GetPath().BaseName().AsUTF8Unsafe());
+    }
+  }
+  std::ranges::sort(folders);
+  return folders;
+}
+
+// The person's consent described the ato's cookie sharing at the time: when that changes, the
+// session ends.
+void SharingChanged() {
+  std::vector<uint64_t> ended;
+  for (const auto& [connection, session] : Sessions()) {
+    if (SharesWith(session.ato) != session.shares_with) ended.push_back(connection);
+  }
+  for (uint64_t connection : ended) Stop(connection, "sharing_changed");
+}
+void WatchSharing() {
+  static base::NoDestructor<PrefChangeRegistrar> prefs;
+  if (!prefs->IsEmpty()) return;
+  prefs->Init(g_browser_process->local_state());
+  prefs->Add(AgensWindow::kAtosPref, base::BindRepeating(&SharingChanged));
+}
+
+bool ControlAlways(const std::string& key) {
+  return std::ranges::contains(g_browser_process->local_state()->GetList(kControlAlwaysPref), base::Value(key));
+}
+
+std::optional<GURL> WebURL(const Request& request) {
+  std::optional<std::string> text = StringParam(request.body, "url");
+  if (!text) return std::nullopt;
+  GURL url(*text);
+  // Only web pages: never chrome://, file:, javascript: or data:.
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) return std::nullopt;
+  return url;
+}
+
+void Start(const Client& client, Request request, ReplyCallback reply) {
+  const uint64_t connection = client.connection;
+  if (Sessions().contains(connection) || Asking().contains(connection)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "control already started on this connection"));
+    return;
+  }
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> reason = StringParam(request.body, "reason");
+  if (!id || !reason || !AtMostChars(*reason, kMaxReasonChars)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and reason (up to 1024 characters)"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  const std::string name = client.name.empty() ? "app" : client.name;
+  const std::string ato_name = AgensWindow::AtoName(entry);
+  std::vector<std::string> shares_with = SharesWith(entry->GetPath());
+  std::string detail = *reason;
+  if (!shares_with.empty()) {
+    std::vector<std::string> names;
+    for (const std::string& folder : shares_with) {
+      if (ProfileAttributesEntry* other = FindAto(folder)) names.push_back(AgensWindow::AtoName(other));
+    }
+    detail += (detail.empty() ? "" : "\n\n") + ato_name + " compartilha cookies com " + JoinNames(names) +
+              ": os logins deles também ficam ao alcance.";
+  }
+  // "Permitir sempre" only for a signed app, and only for this ato with this sharing group.
+  const bool signed_client = !client.identity.empty();
+  const std::string always_key =
+      signed_client ? ControlAlwaysKey(client.identity, entry->GetPath().BaseName().AsUTF8Unsafe(), shares_with)
+                    : std::string();
+  auto begin = [](uint64_t connection, std::string name, base::FilePath ato, std::vector<std::string> shares_with,
+                  std::string always_key, Request request, ReplyCallback reply, AgensApprovalAnswer answer) {
+    // Gone from Asking: the connection closed while the sheet was up.
+    if (!Asking().erase(connection)) return;
+    if (answer == kAgensApprovalDeny) {
+      std::move(reply).Run(ErrorReply(&request.id, kDenied));
+      return;
+    }
+    if (!AgensWindow::Storage().GetProfileAttributesWithPath(ato)) {
+      std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the ato is gone"));
+      return;
+    }
+    if (SharesWith(ato) != shares_with) {  // the sheet no longer says what the app could reach
+      std::move(reply).Run(ErrorReply(&request.id, kDenied, "the ato's cookie sharing changed while asking"));
+      return;
+    }
+    if (answer == kAgensApprovalAllowAlways && !always_key.empty() && !ControlAlways(always_key)) {
+      ScopedListPrefUpdate(g_browser_process->local_state(), kControlAlwaysPref)->Append(always_key);
+    }
+    WatchSharing();
+    Session& session = Sessions()[connection];
+    session.client = std::move(name);
+    session.ato = std::move(ato);
+    session.shares_with = std::move(shares_with);
+    std::move(reply).Run(OkReply(request.id));
+  };
+  Asking().insert(connection);
+  if (signed_client && ControlAlways(always_key)) {
+    begin(connection, name, entry->GetPath(), std::move(shares_with), always_key, std::move(request), std::move(reply),
+          kAgensApprovalAllow);
+    return;
+  }
+  AskApproval(connection, "O " + name + " quer usar abas do ato " + ato_name, detail, /*offer_always=*/signed_client,
+              base::BindOnce(begin, connection, name, entry->GetPath(), std::move(shares_with), always_key,
+                             std::move(request), std::move(reply)));
+}
+
+// A new foreground tab in `browser` (the ato's window), controlled by the session.
+void OpenIn(uint64_t connection, GURL url, Request request, ReplyCallback reply, BrowserWindowInterface* browser) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "control ended"));
+    return;
+  }
+  Session& session = it->second;
+  if (!browser || browser->GetProfile()->GetPath() != session.ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the ato's window"));
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  base::WeakPtr<content::NavigationHandle> handle = Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the tab"));
+    return;
+  }
+  auto tab = std::make_unique<Tab>(connection, "t" + base::NumberToString(session.next_tab++), contents,
+                                   session.client);
+  if (handle) {
+    tab->WaitFor(handle->GetNavigationId(), std::move(request.id), std::move(reply));
+  } else {
+    base::DictValue result;
+    result.Set("tab", tab->id);
+    std::move(reply).Run(OkReply(request.id, std::move(result)));
+  }
+  session.tabs.push_back(std::move(tab));
+}
+
+void TabOpen(const Client& client, Request request, ReplyCallback reply) {
+  const Session& session = Sessions().at(client.connection);
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  std::optional<GURL> url = WebURL(request);
+  if (!ato || !url) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and an http or https url"));
+    return;
+  }
+  if (*ato != session.ato.BaseName().AsUTF8Unsafe()) {
+    std::move(reply).Run(ErrorReply(&request.id, kDenied, "control was approved for another ato"));
+    return;
+  }
+  // The ato's window when it has one (left where it is); otherwise open it.
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(session.ato);
+  BrowserWindowInterface* browser = nullptr;
+  if (profile) {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation([&](BrowserWindowInterface* b) {
+      if (b->GetProfile() != profile || b->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+          b->IsDeleteScheduled() || b->GetTabStripModel()->closing_all()) {
+        return true;
+      }
+      browser = b;
+      return false;
+    });
+  }
+  if (browser) {
+    OpenIn(client.connection, *url, std::move(request), std::move(reply), browser);
+    return;
+  }
+  profiles::SwitchToProfile(session.ato, /*always_create=*/false,
+                            base::BindOnce(&OpenIn, client.connection, *url, std::move(request), std::move(reply)));
+}
+
+void TabNavigate(Session& session, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  std::optional<GURL> url = WebURL(request);
+  if (!id || !url) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and an http or https url"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::NavigationController::LoadURLParams params(*url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  base::WeakPtr<content::NavigationHandle> handle = tab->web_contents()->GetController().LoadURLWithParams(params);
+  if (!handle) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "the navigation did not start"));
+    return;
+  }
+  tab->WaitFor(handle->GetNavigationId(), std::move(request.id), std::move(reply));
+}
+
+void TabClose(Session& session, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  auto it = std::find_if(session.tabs.begin(), session.tabs.end(), [&](auto& tab) { return tab->id == *id; });
+  if (it == session.tabs.end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::WebContents* contents = (*it)->web_contents();
+  session.tabs.erase(it);  // unmarks it first
+  if (contents) contents->Close();
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void PageOp(Session& session, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  std::optional<std::string> ref = StringParam(request.body, "ref");
+  if (op == "page.snapshot") {
+    tab->page.Run(request.id.Clone(), base::BindOnce(&Page::Snapshot, base::Unretained(&tab->page), request.id.Clone()),
+                  std::move(reply));
+  } else if (op == "page.screenshot") {
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Screenshot, base::Unretained(&tab->page), request.id.Clone()), std::move(reply));
+  } else if (op == "page.click") {
+    if (!ref) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and ref"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Click, base::Unretained(&tab->page), request.id.Clone(), *ref), std::move(reply));
+  } else if (op == "page.type") {
+    std::optional<std::string> text = StringParam(request.body, "text");
+    std::u16string text16;
+    // No control characters: Enter or Tab inside the text could move the focus (to a password
+    // field, say) while typing. Those go one at a time through page.key, which checks again.
+    if (!ref || !text || !AtMostChars(*text, kMaxTypeChars) || !base::UTF8ToUTF16(text->data(), text->size(), &text16) ||
+        std::any_of(text16.begin(), text16.end(), [](char16_t c) { return c < 0x20 || c == 0x7F; })) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab, ref and text (up to 10000 characters, no control characters)"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Type, base::Unretained(&tab->page), request.id.Clone(), *ref, std::move(text16)),
+                  std::move(reply));
+  } else if (op == "page.key") {
+    std::optional<std::string> name = StringParam(request.body, "key");
+    std::optional<Key> key = name ? ParseKey(*name, request.body.Find("modifiers")) : std::nullopt;
+    if (!key) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab and key: a key name (Enter, Tab, Escape, Backspace, Delete, "
+                                      "ArrowUp…, PageUp, PageDown, Home, End) or one character; modifiers is a list "
+                                      "of shift, meta, alt, ctrl"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::PressKey, base::Unretained(&tab->page), request.id.Clone(), std::move(*key)),
+                  std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return base::StartsWith(op, "control.") || base::StartsWith(op, "tab.") || base::StartsWith(op, "page.");
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  if (op == "control.start") {
+    Start(client, std::move(request), std::move(reply));
+    return;
+  }
+  if (op == "control.stop") {
+    End(client.connection, /*close_tabs=*/true);
+    std::move(reply).Run(OkReply(request.id));
+    return;
+  }
+  if (op.starts_with("control.")) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  auto it = Sessions().find(client.connection);
+  if (it == Sessions().end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs control.start on this connection"));
+    return;
+  }
+  Session& session = it->second;
+  if (op == "tab.open") {
+    TabOpen(client, std::move(request), std::move(reply));
+  } else if (op == "tab.navigate") {
+    TabNavigate(session, std::move(request), std::move(reply));
+  } else if (op == "tab.close") {
+    TabClose(session, request, std::move(reply));
+  } else if (op.starts_with("page.")) {
+    PageOp(session, std::move(request), std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  Asking().erase(connection);
+  End(connection, /*close_tabs=*/false);
+}
+
+}  // namespace agens::bridge::control
