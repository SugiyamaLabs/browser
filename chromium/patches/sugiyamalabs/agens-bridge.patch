diff --git a/chrome/browser/agens/ui/page_tools.h b/chrome/browser/agens/ui/page_tools.h
new file mode 100644
index 0000000000..acd31da1a0
--- /dev/null
+++ b/chrome/browser/agens/ui/page_tools.h
@@ -0,0 +1,96 @@
+// Copyright 2026 SugiyamaLabs.
+// Find in page, the zoom notice and the reopened tab (prototipos/busca.html): the small decisions
+// the chrome takes, pure and constexpr. The static_asserts at the end are their self-check and run
+// on every build of the chrome.
+
+#ifndef CHROME_BROWSER_AGENS_UI_PAGE_TOOLS_H_
+#define CHROME_BROWSER_AGENS_UI_PAGE_TOOLS_H_
+
+#include <string_view>
+
+namespace agens::ui {
+
+// "Site não encontrado" (prototipos/janela-abas.html #paginas): a host one or two edits away from
+// one in the ato's history is offered as "Você quis dizer …?". Hosts longer than 63 never match.
+constexpr int EditDistance(std::string_view a, std::string_view b) {
+  if (a.size() > 63 || b.size() > 63) return 99;
+  int prev[64] = {}, cur[64] = {};
+  for (size_t j = 0; j <= b.size(); ++j) prev[j] = static_cast<int>(j);
+  for (size_t i = 1; i <= a.size(); ++i) {
+    cur[0] = static_cast<int>(i);
+    for (size_t j = 1; j <= b.size(); ++j) {
+      const int sub = prev[j - 1] + (a[i - 1] == b[j - 1] ? 0 : 1);
+      const int del = prev[j] + 1, ins = cur[j - 1] + 1;
+      cur[j] = sub < del ? (sub < ins ? sub : ins) : (del < ins ? del : ins);
+    }
+    for (size_t j = 0; j <= b.size(); ++j) prev[j] = cur[j];
+  }
+  return prev[b.size()];
+}
+constexpr bool LooksLikeTypo(std::string_view typed, std::string_view known) {
+  const int d = EditDistance(typed, known);
+  return d > 0 && d <= (typed.size() > 7 ? 2 : 1);
+}
+
+// What the find bar's counter says: nothing (empty field), "Nenhum resultado" (and the field's
+// border goes red) or "3 de 6".
+enum class FindCount { kBlank, kNone, kOrdinal };
+constexpr FindCount CountFor(bool typed, int total) {
+  return !typed ? FindCount::kBlank : total > 0 ? FindCount::kOrdinal : FindCount::kNone;
+}
+// ↑ and ↓ only while there is something to step through.
+constexpr bool CanStep(bool typed, int total) { return typed && total > 0; }
+
+// The find bar's row (prototype .find), left to right: 8 pt in, the field, ↑, ↓, a separator, Aa,
+// ×, 6 pt to the end; 4 pt between them and 2 more around the separator. x of each, and the width.
+struct FindRow {
+  double field, up, down, sep, aa, close, width;
+};
+inline constexpr double kFindButton = 26, kFindHeight = 40;
+constexpr FindRow LayFindRow(double field_w, double aa_w) {
+  const double up = 8 + field_w + 4, down = up + kFindButton + 4, sep = down + kFindButton + 4 + 2;
+  const double aa = sep + 1 + 2 + 4, close = aa + aa_w + 4;
+  return {8, up, down, sep, aa, close, close + kFindButton + 6};
+}
+
+// The "Zoom 125%" notice: for a change on the page already shown (⌘+ ⌘− ⌘0, the popover, a pinch),
+// never for switching tabs or for a site that simply has its own zoom.
+constexpr bool ZoomNotice(bool same_tab, bool same_url, int was, int now) {
+  return same_tab && same_url && was > 0 && was != now;
+}
+
+// After "Reabrir aba fechada" the tab that came back is the active one, once the list grew: that
+// one gets the warm outline. -1: none (still waiting, or nothing came back).
+constexpr int ReopenedTab(bool waiting, int was_count, int count, int active) {
+  return waiting && count > was_count ? active : -1;
+}
+
+namespace page_tools_selfcheck {
+static_assert(CountFor(false, 6) == FindCount::kBlank);
+static_assert(CountFor(true, 0) == FindCount::kNone);
+static_assert(CountFor(true, 6) == FindCount::kOrdinal);
+static_assert(!CanStep(true, 0) && !CanStep(false, 3) && CanStep(true, 1));
+// The prototype's bar: a 250 pt field and a 30 pt Aa make a 397 pt float.
+constexpr FindRow kRow = LayFindRow(250, 30);
+static_assert(kRow.up == 262 && kRow.down == 292 && kRow.sep == 324 && kRow.aa == 331);
+static_assert(kRow.close == 365 && kRow.width == 397);
+// ⌘+ on the page: notice. Same zoom, another tab, another page or the first report: none.
+static_assert(ZoomNotice(true, true, 100, 110));
+static_assert(!ZoomNotice(true, true, 110, 110));
+static_assert(!ZoomNotice(false, true, 100, 125));
+static_assert(!ZoomNotice(true, false, 100, 125));
+static_assert(!ZoomNotice(true, true, 0, 125));
+// One tab more after asking: the active one is the reopened; not asked, or no new tab: none.
+static_assert(ReopenedTab(true, 3, 4, 2) == 2);
+static_assert(ReopenedTab(false, 3, 4, 2) == -1);
+static_assert(ReopenedTab(true, 3, 3, 2) == -1);
+// The prototype's typo, and what is not one.
+static_assert(EditDistance("lineaer.app", "linear.app") == 1 && EditDistance("", "abc") == 3);
+static_assert(LooksLikeTypo("lineaer.app", "linear.app") && LooksLikeTypo("gihtub.com", "github.com"));
+static_assert(!LooksLikeTypo("linear.app", "linear.app") && !LooksLikeTypo("youtube.com", "linear.app"));
+static_assert(!LooksLikeTypo("x.io", "y.co"));
+}  // namespace page_tools_selfcheck
+
+}  // namespace agens::ui
+
+#endif  // CHROME_BROWSER_AGENS_UI_PAGE_TOOLS_H_
diff --git a/chrome/browser/agens/ui/popover_arrow.h b/chrome/browser/agens/ui/popover_arrow.h
new file mode 100644
index 0000000000..d0e7b0382f
--- /dev/null
+++ b/chrome/browser/agens/ui/popover_arrow.h
@@ -0,0 +1,72 @@
+// Copyright 2026 SugiyamaLabs.
+// Where a menu that comes from a control goes, and where its arrow sits on it
+// (prototipos/menus-seta.html). Pure and constexpr: the static_asserts at the end are its
+// self-check and run on every build of the chrome.
+
+#ifndef CHROME_BROWSER_AGENS_UI_POPOVER_ARROW_H_
+#define CHROME_BROWSER_AGENS_UI_POPOVER_ARROW_H_
+
+namespace agens::ui {
+
+// The arrow: a 10 pt square turned 45°, its outer half (14 × 7), with a 2 pt round tip. It has
+// the menu's fill and its 1 pt border runs around it without a seam.
+inline constexpr double kArrowW = 14, kArrowH = 7, kArrowTip = 2;
+inline constexpr double kArrowGap = 4;  // from the control to the arrow's tip
+inline constexpr double kPopEdge = 4;   // a menu keeps this far from the window's edges
+
+struct PopRect {
+  double x, y, w, h;  // y grows downward (the chrome view is flipped)
+};
+struct PopPlace {
+  double x, y;     // the menu body's top-left
+  bool below;      // under the control (arrow on its top edge); else above (arrow on its bottom)
+  double arrow_x;  // the arrow's center, from the body's left edge
+};
+
+constexpr double PopMin(double a, double b) { return a < b ? a : b; }
+constexpr double PopMax(double a, double b) { return a > b ? a : b; }
+
+// A w × h menu body for `control`, inside `window` (same coordinates). Under the control when it
+// fits, else above when that fits (the arrow flips with it); centered on the control, sliding to
+// stay in the window while the arrow keeps pointing at the control's center, never closer than
+// radius + 4 to a corner.
+constexpr PopPlace PlacePopover(PopRect control, double w, double h, PopRect window, double radius) {
+  const double gap = kArrowGap + kArrowH;
+  const bool fits_below = control.y + control.h + gap + h <= window.y + window.h - kPopEdge;
+  const bool fits_above = control.y - gap - h >= window.y + kPopEdge;
+  const bool below = fits_below || !fits_above;
+  const double cx = control.x + control.w / 2;
+  const double x = PopMax(window.x + kPopEdge, PopMin(cx - w / 2, window.x + window.w - kPopEdge - w));
+  const double inset = radius + 4 + kArrowW / 2;
+  return {x, below ? control.y + control.h + gap : control.y - gap - h, below,
+          PopMax(inset, PopMin(cx - x, w - inset))};
+}
+
+namespace popover_selfcheck {
+constexpr PopRect kWindow{0, 0, 1000, 700};
+// Room under the control: below, gap 4 + 7, centered on it, arrow in the middle.
+constexpr PopPlace kMid = PlacePopover({400, 12, 28, 28}, 280, 200, kWindow, 12);
+static_assert(kMid.below && kMid.y == 12 + 28 + 11 && kMid.x == 414 - 140 && kMid.arrow_x == 140);
+// Control at the right edge: the menu slides in, the arrow stays on the control.
+constexpr PopPlace kRight = PlacePopover({958, 12, 28, 28}, 280, 200, kWindow, 12);
+static_assert(kRight.x == 1000 - 4 - 280 && kRight.x + kRight.arrow_x == 972);
+// Past the corner limit: the arrow stops at radius + 4 + half its width from the edge.
+constexpr PopPlace kCorner = PlacePopover({992, 12, 8, 28}, 280, 200, kWindow, 12);
+static_assert(kCorner.arrow_x == 280 - 23 && kCorner.x + kCorner.arrow_x < 996);
+constexpr PopPlace kLeft = PlacePopover({0, 12, 8, 28}, 280, 200, kWindow, 12);
+static_assert(kLeft.x == 4 && kLeft.arrow_x == 23);
+// Asked under, no room at the window's foot: above, the arrow flips to the bottom edge.
+constexpr PopPlace kUp = PlacePopover({100, 640, 30, 28}, 240, 200, kWindow, 12);
+static_assert(!kUp.below && kUp.y == 640 - 11 - 200 && kUp.y + 200 + 11 == 640);
+// No room either way: stays under (as before the arrow).
+static_assert(PlacePopover({100, 300, 30, 28}, 240, 500, kWindow, 12).below);
+// Exactly fits under (4 from the foot).
+static_assert(PlacePopover({100, 400, 30, 28}, 240, 700 - 4 - 439, kWindow, 12).below);
+static_assert(!PlacePopover({100, 400, 30, 28}, 240, 700 - 3 - 439, kWindow, 12).below);
+// Wider than the window: pinned to the left edge.
+static_assert(PlacePopover({100, 12, 30, 28}, 1200, 100, kWindow, 12).x == 4);
+}  // namespace popover_selfcheck
+
+}  // namespace agens::ui
+
+#endif  // CHROME_BROWSER_AGENS_UI_POPOVER_ARROW_H_
