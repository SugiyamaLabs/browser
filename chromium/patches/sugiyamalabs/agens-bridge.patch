+
+Page::Page(content::WebContents* contents) : content::WebContentsObserver(contents) {
+  accessibility_ = content::BrowserAccessibilityState::GetInstance()->CreateScopedModeForWebContents(
+      contents, kMode);
+}
+
+Page::~Page() {
+  for (Waiting& w : waiting_) std::move(w.reply).Run(ErrorReply(&w.id, kFailed, "the tab is no longer controlled"));
+}
+
+void Page::Run(base::Value id, Op op, ReplyCallback reply) {
+  if (waiting_.size() >= kMaxWaitingOps) return Fail(id, reply, kBadRequest, "too many page requests waiting");
+  waiting_.push_back({std::move(id), std::move(op), std::move(reply)});
+  if (!busy_) Next();
+}
+
+void Page::Next() {
+  if (waiting_.empty()) {
+    busy_ = false;
+    return;
+  }
+  busy_ = true;
+  Waiting w = std::move(waiting_.front());
+  waiting_.pop_front();
+  std::move(w.op).Run(base::BindOnce(&Page::Done, weak_.GetWeakPtr(), std::move(w.reply)));
+}
+
+void Page::Done(base::WeakPtr<Page> self, ReplyCallback reply, std::string line) {
+  std::move(reply).Run(std::move(line));
+  // Posted: an op that answers right away must not grow the stack.
+  if (self) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(&Page::Next, self));
+  }
+}
+
+void Page::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() || handle->IsSameDocument()) return;
+  nodes_.clear();  // refs end with their document
+  refs_.clear();
+}
+
+ui::BrowserAccessibilityManager* Page::RootManager() {
+  return ManagerFor(web_contents()->GetPrimaryMainFrame()->GetAXTreeID());
+}
+
+ui::BrowserAccessibility* Page::Resolve(const std::string& ref) {
+  auto it = nodes_.find(ref);
+  if (it == nodes_.end()) return nullptr;
+  ui::BrowserAccessibilityManager* manager = ManagerFor(it->second.first);
+  return manager ? manager->GetFromID(it->second.second) : nullptr;
+}
+
+content::RenderWidgetHost* Page::FocusedWidget() {
+  content::RenderFrameHost* frame = web_contents()->GetFocusedFrame();
+  return (frame ? frame : web_contents()->GetPrimaryMainFrame())->GetRenderWidgetHost();
+}
+
+void Page::WaitForTree(base::WeakPtr<Page> self, base::TimeTicks deadline, base::OnceClosure then) {
+  ui::BrowserAccessibilityManager* manager = self ? self->RootManager() : nullptr;
+  const bool ready = manager && manager->GetBrowserAccessibilityRoot() && manager->GetTreeData().loaded;
+  if (!self || ready || base::TimeTicks::Now() >= deadline) {
+    std::move(then).Run();
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&Page::WaitForTree, self, deadline, std::move(then)), kTreePoll);
+}
+
+void Page::Snapshot(base::Value id, ReplyCallback reply) {
+  WaitForTree(weak_.GetWeakPtr(), base::TimeTicks::Now() + kTreeWait,
+              base::BindOnce(&Page::SnapshotNow, weak_.GetWeakPtr(), std::move(id), std::move(reply)));
+}
+
+void Page::SnapshotNow(base::WeakPtr<Page> self, base::Value id, ReplyCallback reply) {
+  if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+  std::map<std::string, Node>& nodes = self->nodes_;
+  std::map<Node, std::string>& refs = self->refs_;
+  base::ListValue list;
+  bool truncated = false;
+  size_t bytes = 0;  // a bound on the reply's size: each text twice for JSON escaping
+  ui::BrowserAccessibilityManager* manager = self->RootManager();
+  ui::BrowserAccessibility* focus = manager ? manager->GetFocus() : nullptr;
+  // Document order; `depth` counts listed ancestors. PlatformGetChild walks into frames.
+  auto visit = [&](auto&& recurse, ui::BrowserAccessibility* node, int depth, bool in_named) -> void {
+    const bool listed = !node->IsInvisibleOrIgnored() && Worth(*node, in_named);
+    if (listed && (list.size() >= kMaxNodes || bytes >= kMaxSnapshotBytes)) {
+      truncated = true;
+      return;
+    }
+    if (listed) {
+      const Node key{node->manager()->GetTreeID(), node->GetId()};
+      std::string& ref = refs[key];
+      if (ref.empty()) {
+        ref = "e" + base::NumberToString(self->next_ref_++);
+        nodes[ref] = key;
+      }
+      const ui::AXNodeData& data = node->GetData();
+      base::DictValue item;
+      item.Set("ref", ref);
+      item.Set("role", ui::ToString(node->GetRole()));
+      item.Set("name", Clip(node->GetName()));
+      if (IsPassword(data)) {
+        item.Set("password", true);  // never its value
+      } else {
+        item.Set("value", Clip(base::UTF16ToUTF8(node->GetValueForControl())));
+      }
+      item.Set("depth", depth);
+      if (node == focus) item.Set("focused", true);
+      if (data.GetRestriction() == ax::mojom::Restriction::kDisabled) item.Set("disabled", true);
+      switch (data.GetCheckedState()) {
+        case ax::mojom::CheckedState::kTrue: item.Set("checked", true); break;
+        case ax::mojom::CheckedState::kFalse: item.Set("checked", false); break;
+        case ax::mojom::CheckedState::kMixed: item.Set("checked", "mixed"); break;
+        default: break;
+      }
+      bytes += 200;
+      for (const char* field : {"name", "value"}) {
+        if (const std::string* text = item.FindString(field)) bytes += 2 * text->size();
+      }
+      list.Append(std::move(item));
+    }
+    const bool named = listed && node->GetRole() != ax::mojom::Role::kStaticText && !node->GetName().empty();
+    for (size_t i = 0; i < node->PlatformChildCount() && !truncated; ++i) {
+      if (ui::BrowserAccessibility* child = node->PlatformGetChild(i)) {
+        recurse(recurse, child, depth + (listed ? 1 : 0), in_named || named);
+      }
+    }
+  };
+  if (ui::BrowserAccessibility* root = manager ? manager->GetBrowserAccessibilityRoot() : nullptr) {
+    visit(visit, root, 0, false);
+  }
+  base::DictValue result;
+  result.Set("nodes", std::move(list));
+  if (truncated) result.Set("truncated", true);
+  std::move(reply).Run(OkReply(id, std::move(result)));
+}
+
+void Page::Click(base::Value id, std::string ref, ReplyCallback reply) {
+  ClickAttempt(weak_.GetWeakPtr(), std::move(id), std::move(ref), base::TimeTicks::Now() + kScrollWait, false,
+               std::move(reply));
+}
+
+// A real click at the node's center, scrolled into view first. The accessibility default action
+// where a click can't land: an option of a closed <select>, a node in another process's frame, or
+// one that stays out of view.
+void Page::ClickAttempt(base::WeakPtr<Page> self,
+                        base::Value id,
+                        std::string ref,
+                        base::TimeTicks deadline,
+                        bool scrolled,
+                        ReplyCallback reply) {
+  if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+  ui::BrowserAccessibility* node = self->Resolve(ref);
+  if (!node) return Fail(id, reply, kNotFound, ref);
+  content::RenderWidgetHost* widget = self->web_contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+  content::RenderFrameHost* frame = nullptr;
+  self->web_contents()->GetPrimaryMainFrame()->ForEachRenderFrameHost([&](content::RenderFrameHost* rfh) {
+    if (rfh->GetAXTreeID() == node->manager()->GetTreeID()) frame = rfh;
+  });
+  ui::AXOffscreenResult offscreen = ui::AXOffscreenResult::kOnscreen;
+  const gfx::Rect bounds =
+      node->GetBoundsRect(ui::AXCoordinateSystem::kRootFrame, ui::AXClippingBehavior::kClipped, &offscreen);
+  const bool visible = !bounds.IsEmpty() && offscreen == ui::AXOffscreenResult::kOnscreen;
+  const bool clickable = frame && frame->GetRenderWidgetHost() == widget &&
+                         node->GetRole() != ax::mojom::Role::kMenuListOption;
+  if (clickable && !visible && base::TimeTicks::Now() < deadline) {
+    if (!scrolled) node->manager()->ScrollToMakeVisible(*node, gfx::Rect());
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&Page::ClickAttempt, self, std::move(id), std::move(ref), deadline, true, std::move(reply)),
+        base::Milliseconds(50));
+    return;
+  }
+  if (!clickable || !visible) {
+    node->manager()->DoDefaultAction(*node);
+    std::move(reply).Run(OkReply(id));
+    return;
+  }
+  // Tree bounds are in physical pixels; input takes DIPs.
+  const float scale = self->RootManager() ? self->RootManager()->device_scale_factor() : 1;
+  const gfx::PointF point(bounds.CenterPoint().x() / scale, bounds.CenterPoint().y() / scale);
+  AckWaiter::Start(widget, blink::WebInputEvent::Type::kMouseUp,
+                   base::BindOnce([](base::Value id, ReplyCallback reply) { std::move(reply).Run(OkReply(id)); },
+                                  std::move(id), std::move(reply)));
+  SendMouse(widget, blink::WebInputEvent::Type::kMouseMove, point);
+  SendMouse(widget, blink::WebInputEvent::Type::kMouseDown, point);
+  SendMouse(widget, blink::WebInputEvent::Type::kMouseUp, point);
+}
+
+void Page::FocusIsPassword(base::OnceCallback<void(std::optional<bool>)> done) {
+  web_contents()->RequestAXTreeSnapshot(
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<bool>)> done, ui::AXTreeUpdate& update) {
+            if (update.nodes.empty()) return std::move(done).Run(std::nullopt);
+            const ui::AXNodeID focus = update.tree_data.focus_id;
+            // Fails closed: without the focused node we can't tell where keys would go.
+            for (const ui::AXNodeData& node : update.nodes) {
+              if (node.id == focus) return std::move(done).Run(IsPassword(node));
+            }
+            std::move(done).Run(std::nullopt);
+          },
+          std::move(done)),
+      kMode, /*max_nodes=*/0, kRendererWait, content::WebContents::AXTreeSnapshotPolicy::kAll);
+}
+
+void Page::Type(base::Value id, std::string ref, std::u16string text, ReplyCallback reply) {
+  ui::BrowserAccessibility* node = Resolve(ref);
+  if (!node) return Fail(id, reply, kNotFound, ref);
+  if (IsPassword(node->GetData())) return Fail(id, reply, kDenied, "a password field");
+  node->manager()->SetFocus(*node);
+  // Then, with the focus where it really landed, refuse if that is a password field.
+  FocusIsPassword(base::BindOnce(
+      [](base::WeakPtr<Page> self, base::Value id, std::u16string text, ReplyCallback reply,
+         std::optional<bool> password) {
+        if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+        if (!password) return Fail(id, reply, kFailed, "could not read the page");
+        if (*password) return Fail(id, reply, kDenied, "the focus is on a password field");
+        // One character at a time (a surrogate pair is one).
+        std::vector<Key> keys;
+        for (size_t i = 0; i < text.size();) {
+          const size_t n = (text[i] >= 0xD800 && text[i] < 0xDC00 && i + 1 < text.size()) ? 2 : 1;
+          if (std::optional<Key> key = ParseKey(base::UTF16ToUTF8(text.substr(i, n)), nullptr)) {
+            keys.push_back(std::move(*key));
+          }
+          i += n;
+        }
+        if (keys.empty()) return std::move(reply).Run(OkReply(id));
+        content::RenderWidgetHost* widget = self->FocusedWidget();
+        AckWaiter::Start(widget, blink::WebInputEvent::Type::kKeyUp,
+                         base::BindOnce([](base::Value id, ReplyCallback reply) { std::move(reply).Run(OkReply(id)); },
+                                        std::move(id), std::move(reply)),
+                         static_cast<int>(keys.size()));
+        for (const Key& key : keys) SendKey(widget, key);
+      },
+      weak_.GetWeakPtr(), std::move(id), std::move(text), std::move(reply)));
+}
+
+void Page::PressKey(base::Value id, Key key, ReplyCallback reply) {
+  if (TouchesClipboard(key)) return Fail(id, reply, kDenied, "copy, cut and paste are not available");
+  FocusIsPassword(base::BindOnce(
+      [](base::WeakPtr<Page> self, base::Value id, Key key, ReplyCallback reply, std::optional<bool> password) {
+        if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+        if (!password) return Fail(id, reply, kFailed, "could not read the page");
+        if (*password && !AllowedOnPassword(key)) {
+          return Fail(id, reply, kDenied, "the focus is on a password field: only keys that move");
+        }
+        content::RenderWidgetHost* widget = self->FocusedWidget();
+        AckWaiter::Start(widget, blink::WebInputEvent::Type::kKeyUp,
+                         base::BindOnce([](base::Value id, ReplyCallback reply) { std::move(reply).Run(OkReply(id)); },
+                                        std::move(id), std::move(reply)));
+        SendKey(widget, key);
+      },
+      weak_.GetWeakPtr(), std::move(id), std::move(key), std::move(reply)));
+}
+
+void Page::Screenshot(base::Value id, ReplyCallback reply) {
+  // The page as it is now: a password field showing its text would show in the picture.
+  web_contents()->RequestAXTreeSnapshot(
+      base::BindOnce(
+          [](base::WeakPtr<Page> self, base::Value id, ReplyCallback reply, ui::AXTreeUpdate& update) {
+            if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+            if (update.nodes.empty()) return Fail(id, reply, kFailed, "could not read the page");
+            if (AnyRevealedPassword(update)) return Fail(id, reply, kDenied, "a password field shows its text");
+            content::RenderWidgetHostView* view = self->web_contents()->GetRenderWidgetHostView();
+            if (!view) return Fail(id, reply, kFailed, "the tab shows nothing");
+            // The visible viewport at 1x (DIPs), which keeps the reply small.
+            view->CopyFromSurface(
+                gfx::Rect(), view->GetViewBounds().size(), kRendererWait,
+                base::BindOnce(
+                    [](base::WeakPtr<Page> self, base::Value id, ReplyCallback reply,
+                       const content::CopyFromSurfaceResult& result) {
+                      if (!self) return Fail(id, reply, kFailed, "the tab is no longer controlled");
+                      if (!result.has_value() || result->bitmap.drawsNothing()) {
+                        return Fail(id, reply, kFailed, "could not capture the tab");
+                      }
+                      std::optional<std::vector<uint8_t>> png =
+                          gfx::PNGCodec::EncodeBGRASkBitmap(result->bitmap, /*discard_transparency=*/true);
+                      if (!png) return Fail(id, reply, kFailed, "could not encode the picture");
+                      // Again after the capture: one revealed meanwhile may be in the picture.
+                      self->web_contents()->RequestAXTreeSnapshot(
+                          base::BindOnce(
+                              [](base::Value id, ReplyCallback reply, std::vector<uint8_t> png,
+                                 ui::AXTreeUpdate& update) {
+                                if (update.nodes.empty()) return Fail(id, reply, kFailed, "could not read the page");
+                                if (AnyRevealedPassword(update)) {
+                                  return Fail(id, reply, kDenied, "a password field shows its text");
+                                }
+                                base::DictValue out;
+                                out.Set("png", base::Base64Encode(png));
+                                std::move(reply).Run(OkReply(id, std::move(out)));
+                              },
+                              std::move(id), std::move(reply), std::move(*png)),
+                          kMode, /*max_nodes=*/0, kRendererWait,
+                          content::WebContents::AXTreeSnapshotPolicy::kAll);
+                    },
+                    self, std::move(id), std::move(reply)));
+          },
+          weak_.GetWeakPtr(), std::move(id), std::move(reply)),
+      kMode, /*max_nodes=*/0, kRendererWait, content::WebContents::AXTreeSnapshotPolicy::kAll);
+}
+
+}  // namespace agens::bridge::control
diff --git a/chrome/browser/agens/bridge/control_page.h b/chrome/browser/agens/bridge/control_page.h
new file mode 100644
index 0000000000..15127a1f23
--- /dev/null
+++ b/chrome/browser/agens/bridge/control_page.h
@@ -0,0 +1,97 @@
+// Copyright 2026 SugiyamaLabs.
+// The page side of a controlled tab (page.* in docs/protocolo.md): its accessibility tree with
+// refs, real input on its widget, and screenshots. UI thread. Password rules, checked against the
+// page as it is when the action runs:
+// - a field that is or was a password field (Blink keeps that for the element's life) shows no
+//   value and takes no typing; while one has the focus, only keys that move go through;
+// - no screenshot while such a field shows its text;
+// - the clipboard is never touched.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_CONTROL_PAGE_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_CONTROL_PAGE_H_
+
+#include <deque>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+#include "chrome/browser/agens/bridge/ops.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/accessibility/ax_tree_id.h"
+
+namespace content {
+class RenderWidgetHost;
+class ScopedAccessibilityMode;
+}  // namespace content
+namespace ui {
+class BrowserAccessibility;
+class BrowserAccessibilityManager;
+}  // namespace ui
+
+namespace agens::bridge::control {
+
+class Page : public content::WebContentsObserver {
+ public:
+  // Turns accessibility on for this tab only, for as long as it lives.
+  explicit Page(content::WebContents* contents);
+  ~Page() override;
+
+  // One op at a time per tab, in the order they came: each password check sees what the ops
+  // before it did. `op` gets the reply to run when it's done; the next op starts after that.
+  // Past kMaxWaitingOps waiting, answers bad_request.
+  using Op = base::OnceCallback<void(ReplyCallback)>;
+  void Run(base::Value id, Op op, ReplyCallback reply);
+
+  // The ops, for Run. Each answers `reply` once, for the request `id`.
+  void Snapshot(base::Value id, ReplyCallback reply);
+  void Click(base::Value id, std::string ref, ReplyCallback reply);
+  void Type(base::Value id, std::string ref, std::u16string text, ReplyCallback reply);
+  void PressKey(base::Value id, Key key, ReplyCallback reply);
+  void Screenshot(base::Value id, ReplyCallback reply);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+
+ private:
+  using Node = std::pair<ui::AXTreeID, int32_t>;
+  struct Waiting {
+    base::Value id;
+    Op op;
+    ReplyCallback reply;
+  };
+
+  void Next();
+  static void Done(base::WeakPtr<Page> self, ReplyCallback reply, std::string line);
+
+  ui::BrowserAccessibilityManager* RootManager();
+  ui::BrowserAccessibility* Resolve(const std::string& ref);
+  content::RenderWidgetHost* FocusedWidget();
+  // Static with a weak `self`, so a reply waiting in a posted task still runs if the tab goes.
+  static void WaitForTree(base::WeakPtr<Page> self, base::TimeTicks deadline, base::OnceClosure then);
+  static void SnapshotNow(base::WeakPtr<Page> self, base::Value id, ReplyCallback reply);
+  static void ClickAttempt(base::WeakPtr<Page> self,
+                           base::Value id,
+                           std::string ref,
+                           base::TimeTicks deadline,
+                           bool scrolled,
+                           ReplyCallback reply);
+  // Asks the renderer for the page as it is now (after the input already sent) whether the
+  // focused element is or was a password field; nullopt when it can't tell.
+  void FocusIsPassword(base::OnceCallback<void(std::optional<bool>)> done);
+
+  std::unique_ptr<content::ScopedAccessibilityMode> accessibility_;
+  std::deque<Waiting> waiting_;
+  bool busy_ = false;
+  // Refs of the current document, both ways. Cleared when the tab goes to another page.
+  std::map<std::string, Node> nodes_;
+  std::map<Node, std::string> refs_;
+  int next_ref_ = 1;
+  base::WeakPtrFactory<Page> weak_{this};
+};
+
+}  // namespace agens::bridge::control
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_CONTROL_PAGE_H_
diff --git a/chrome/browser/agens/bridge/ops.cc b/chrome/browser/agens/bridge/ops.cc
new file mode 100644
index 0000000000..335cc66a55
--- /dev/null
+++ b/chrome/browser/agens/bridge/ops.cc
@@ -0,0 +1,206 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/ops.h"
+
+#include <utility>
+
+#include "base/version_info/version_info.h"
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/control_ops.h"
+#include "chrome/browser/agens/bridge/session_ops.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "url/gurl.h"
+
+namespace agens::bridge {
+
+namespace {
+
+// An internal step went wrong (e.g. Chromium could not create the profile).
+constexpr char kFailed[] = "failed";
+
+constexpr size_t kMaxNameChars = 256;
+constexpr size_t kMaxTagChars = 1024;
+
+// The ato whose folder is `id`, among the atos the UI lists; `index` is its place in that list.
+// Only ids from this list are accepted, so a client never names a path.
+ProfileAttributesEntry* FindAto(const std::string& id, int* index = nullptr) {
+  std::vector<ProfileAttributesEntry*> atos = AgensWindow::Atos();
+  for (size_t i = 0; i < atos.size(); ++i) {
+    if (atos[i]->GetPath().BaseName().AsUTF8Unsafe() == id) {
+      if (index) *index = static_cast<int>(i);
+      return atos[i];
+    }
+  }
+  return nullptr;
+}
+
+// A color param: absent is fine when `optional`; present must be one of the palette's names.
+bool ReadColor(const Request& request, bool optional, std::optional<std::string>& color) {
+  const base::Value* value = request.body.Find("color");
+  if (!value) return optional;
+  if (!value->is_string() || AgensWindow::AtoColorIndex(value->GetString()) < 0) return false;
+  color = value->GetString();
+  return true;
+}
+
+void AtosList(const Request& request, ReplyCallback reply) {
+  std::vector<ProfileAttributesEntry*> entries = AgensWindow::Atos();
+  base::ListValue atos;
+  for (size_t i = 0; i < entries.size(); ++i) {
+    base::DictValue ato;
+    ato.Set("id", entries[i]->GetPath().BaseName().AsUTF8Unsafe());
+    ato.Set("name", AgensWindow::AtoName(entries[i]));
+    ato.Set("color", AgensWindow::kAtoColors[AgensWindow::AtoColor(entries[i], static_cast<int>(i))]);
+    ato.Set("tag", AgensWindow::AtoTag(entries[i]));
+    ato.Set("shared", AgensWindow::AtoSharesCookies(entries[i]->GetPath()));  // read-only here
+    ato.Set("asleep", !g_browser_process->profile_manager()->GetProfileByPath(entries[i]->GetPath()));
+    atos.Append(std::move(ato));
+  }
+  base::DictValue result;
+  result.Set("atos", std::move(atos));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+void AtosCreate(Request request, ReplyCallback reply) {
+  std::optional<std::string> name = StringParam(request.body, "name");
+  std::optional<std::string> color;
+  const base::Value* tag = request.body.Find("tag");
+  if (!name || name->empty() || !AtMostChars(*name, kMaxNameChars) || !ReadColor(request, /*optional=*/true, color) ||
+      (tag && (!tag->is_string() || !AtMostChars(tag->GetString(), kMaxTagChars)))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                    "needs name (up to 256 characters); color and tag (up to 1024) are optional strings"));
+    return;
+  }
+  const base::FilePath dir = AgensWindow::FreeAtoDir();
+  // Before the profile exists, so the sidebar's first look already has the color.
+  base::DictValue extras;
+  if (color) extras.Set("color", *color);
+  extras.Set("tag", tag ? tag->GetString() : std::string());
+  AgensWindow::SetAtoExtras(dir, std::move(extras));
+  g_browser_process->profile_manager()->CreateProfileAsync(
+      dir, base::BindOnce(
+               [](Request request, ReplyCallback reply, std::string name, base::FilePath dir, Profile* profile) {
+                 ProfileAttributesEntry* entry =
+                     profile ? AgensWindow::Storage().GetProfileAttributesWithPath(profile->GetPath()) : nullptr;
+                 if (!entry) {
+                   AgensWindow::SetAtoExtras(dir, std::nullopt);
+                   std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not create the ato"));
+                   return;
+                 }
+                 entry->SetLocalProfileName(base::UTF8ToUTF16(name), /*is_default_name=*/false);
+                 base::DictValue result;
+                 result.Set("ato", dir.BaseName().AsUTF8Unsafe());
+                 std::move(reply).Run(OkReply(request.id, std::move(result)));
+               },
+               std::move(request), std::move(reply), *name, dir));
+}
+
+void AtosRename(const Request& request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> name = StringParam(request.body, "name");
+  if (!id || !name || name->empty() || !AtMostChars(*name, kMaxNameChars)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and name (up to 256 characters)"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  entry->SetLocalProfileName(base::UTF8ToUTF16(*name), /*is_default_name=*/false);
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void AtosColor(const Request& request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> color;
+  if (!id || !ReadColor(request, /*optional=*/false, color)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and a known color"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  const base::DictValue* old = AgensWindow::AtoExtras(entry);
+  base::DictValue extras = old ? old->Clone() : base::DictValue();
+  extras.Set("color", *color);
+  AgensWindow::SetAtoExtras(entry->GetPath(), std::move(extras));  // windows repaint through ato_prefs
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void AtosOpen(Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  const base::Value* url_value = request.body.Find("url");
+  GURL url;
+  if (url_value) {
+    url = url_value->is_string() ? GURL(url_value->GetString()) : GURL();
+    // Only web pages: a client must not open chrome://, file: or javascript: in an ato.
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "url must be http or https"));
+      return;
+    }
+  }
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  // Loads the profile when it isn't, and opens (or brings up) its window.
+  profiles::SwitchToProfile(
+      entry->GetPath(), /*always_create=*/false,
+      base::BindOnce(
+          [](Request request, ReplyCallback reply, GURL url, BrowserWindowInterface* browser) {
+            if (!browser) {
+              std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the ato"));
+              return;
+            }
+            if (url.is_valid()) browser->OpenGURL(url, WindowOpenDisposition::NEW_FOREGROUND_TAB);
+            std::move(reply).Run(OkReply(request.id));
+          },
+          std::move(request), std::move(reply), std::move(url)));
+}
+
+}  // namespace
+
+void HandleOp(Client client, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  if (op == "hello") {
+    base::DictValue result;
+    result.Set("protocol", kProtocolVersion);
+    result.Set("browser", version_info::GetVersionNumber());
+    std::move(reply).Run(OkReply(request.id, std::move(result)));
+  } else if (!g_browser_process || !g_browser_process->profile_manager()) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "the browser is shutting down"));
+  } else if (op == "atos.list") {
+    AtosList(request, std::move(reply));
+  } else if (op == "atos.create") {
+    AtosCreate(std::move(request), std::move(reply));
+  } else if (op == "atos.rename") {
+    AtosRename(request, std::move(reply));
+  } else if (op == "atos.color") {
+    AtosColor(request, std::move(reply));
+  } else if (op == "atos.open") {
+    AtosOpen(std::move(request), std::move(reply));
+  } else if (session::Handles(op)) {
+    session::HandleOp(client, std::move(request), std::move(reply));
+  } else if (control::Handles(op)) {
+    control::HandleOp(client, std::move(request), std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  CancelApprovals(connection);
+  session::OnConnectionClosed(connection);
+  control::OnConnectionClosed(connection);
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/ops.h b/chrome/browser/agens/bridge/ops.h
new file mode 100644
index 0000000000..245680ec72
--- /dev/null
+++ b/chrome/browser/agens/bridge/ops.h
@@ -0,0 +1,42 @@
+// Copyright 2026 SugiyamaLabs.
+// The socket's operations, run on the UI thread. HandleOp (ops.cc) answers hello and atos.* and
+// hands the rest to one area each, in its own file: session_ops.h (login, session, renew) and
+// control_ops.h (control.*, tab.*, page.*). An area gets, for each request:
+// - `client`: which connection it serves and who is on the other side (verified by signature);
+// - `reply`: run it exactly once, now or later (async is fine);
+// and may call SendEventTo(client.connection, ...) and AskApproval (approval.h). Each area's
+// OnConnectionClosed(connection) runs on the UI thread once that connection is gone.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_OPS_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+
+namespace agens::bridge {
+
+struct Client {
+  uint64_t connection = 0;  // unique for this run of the browser
+  std::string name;         // the app's display name (from its bundle)
+  std::string identity;     // "<team id>/<signing identifier>"; empty for an unsigned client
+};
+
+// Gets the finished reply line (protocol.h: OkReply / ErrorReply). Safe to run from any thread;
+// dropped if the connection closed.
+using ReplyCallback = base::OnceCallback<void(std::string line)>;
+
+void HandleOp(Client client, Request request, ReplyCallback reply);
+
+// UI thread. `{"event": name, ...fields}` to that connection only; dropped if it closed.
+void SendEventTo(uint64_t connection, std::string_view name, base::DictValue fields);
+
+// UI thread, from the server: the connection closed. Cancels its approvals and tells each area.
+void OnConnectionClosed(uint64_t connection);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_OPS_H_
diff --git a/chrome/browser/agens/bridge/protocol.cc b/chrome/browser/agens/bridge/protocol.cc
new file mode 100644
index 0000000000..4cd937924e
--- /dev/null
+++ b/chrome/browser/agens/bridge/protocol.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/protocol.h"
+
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+
+namespace agens::bridge {
+
+namespace {
+
+std::string Line(base::DictValue dict) {
+  // Values built here are always serializable; the writer escapes "\n" inside strings.
+  return base::WriteJson(dict).value_or("{}") + "\n";
+}
+
+}  // namespace
+
+bool LineFramer::Append(std::string_view data, std::vector<std::string>& lines) {
+  while (!data.empty()) {
+    const size_t end = data.find('\n');
+    const std::string_view piece = data.substr(0, end);
+    if (partial_.size() + piece.size() > kMaxLineBytes) {
+      partial_.clear();
+      return false;
+    }
+    partial_.append(piece);
+    if (end == std::string_view::npos) break;
+    if (!partial_.empty() && partial_.back() == '\r') partial_.pop_back();
+    if (!partial_.empty()) lines.push_back(std::move(partial_));
+    partial_.clear();
+    data.remove_prefix(end + 1);
+  }
+  return true;
+}
+
+std::optional<Request> ParseRequest(std::string_view line, std::string& error_reply) {
+  std::optional<base::Value> value = base::JSONReader::Read(line, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    error_reply = ErrorReply(nullptr, kBadRequest, "not a JSON object");
+    return std::nullopt;
+  }
+  base::DictValue& dict = value->GetDict();
+  const base::Value* id = dict.Find("id");
+  if (!id || !(id->is_int() || id->is_double() || id->is_string())) {
+    error_reply = ErrorReply(nullptr, kBadRequest, "missing id");
+    return std::nullopt;
+  }
+  const std::string* op = dict.FindString("op");
+  if (!op || op->empty()) {
+    error_reply = ErrorReply(id, kBadRequest, "missing op");
+    return std::nullopt;
+  }
+  Request request{id->Clone(), *op, {}};
+  request.body = std::move(dict);
+  return request;
+}
+
+std::string OkReply(const base::Value& id, base::DictValue result) {
+  result.Set("id", id.Clone());
+  result.Set("ok", true);
+  return Line(std::move(result));
+}
+
+std::string ErrorReply(const base::Value* id, std::string_view code, std::string_view message) {
+  base::DictValue dict;
+  if (id) dict.Set("id", id->Clone());
+  dict.Set("ok", false);
+  dict.Set("error", code);
+  if (!message.empty()) dict.Set("message", message);
+  return Line(std::move(dict));
+}
+
+std::string EventLine(std::string_view name, base::DictValue fields) {
+  fields.Set("event", name);
+  return Line(std::move(fields));
+}
+
+bool AtMostChars(std::string_view utf8, size_t max) {
+  size_t count = 0;
+  for (unsigned char c : utf8) {
+    if ((c & 0xC0) != 0x80 && ++count > max) return false;  // continuation bytes don't count
+  }
+  return true;
+}
+
+std::optional<std::string> StringParam(const base::DictValue& body, std::string_view key) {
+  const std::string* s = body.FindString(key);
+  return s ? std::optional<std::string>(*s) : std::nullopt;
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/protocol.h b/chrome/browser/agens/bridge/protocol.h
new file mode 100644
index 0000000000..1647ec285f
--- /dev/null
+++ b/chrome/browser/agens/bridge/protocol.h
@@ -0,0 +1,61 @@
+// Copyright 2026 SugiyamaLabs.
+// The socket's wire format (docs/agens.md, "O socket"): one JSON object per line. Pure logic, no
+// sockets or threads, so protocol_selfcheck.cc can exercise it with only //base.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_PROTOCOL_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_PROTOCOL_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+namespace agens::bridge {
+
+inline constexpr int kProtocolVersion = 1;
+// A longer line drops the connection.
+inline constexpr size_t kMaxLineBytes = 1 << 20;
+
+// Error codes on the wire.
+inline constexpr char kBadRequest[] = "bad_request";
+inline constexpr char kUnknownOp[] = "unknown_op";
+inline constexpr char kNotFound[] = "not_found";
+inline constexpr char kUnauthorized[] = "unauthorized";
+inline constexpr char kDenied[] = "denied";
+
+// Splits a byte stream into lines (without the "\n"). Empty lines are skipped.
+class LineFramer {
+ public:
+  // Appends `data` and moves every complete line into `lines`. False once a line passes
+  // kMaxLineBytes; the framer is then unusable.
+  bool Append(std::string_view data, std::vector<std::string>& lines);
+
+ private:
+  std::string partial_;
+};
+
+struct Request {
+  base::Value id;          // a number or a string, echoed back as is
+  std::string op;
+  base::DictValue body;  // the whole object, so ops read their params from it
+};
+
+// Parses one line. On failure returns nullopt and fills `error_reply` with the line to send back
+// (bad_request, carrying the id when one could be read).
+std::optional<Request> ParseRequest(std::string_view line, std::string& error_reply);
+
+// Lines to send, each ending in "\n". `result` fields sit next to "id" and "ok".
+std::string OkReply(const base::Value& id, base::DictValue result = {});
+// `id` may be null (no request to answer, e.g. a refused connection).
+std::string ErrorReply(const base::Value* id, std::string_view code, std::string_view message = {});
+std::string EventLine(std::string_view name, base::DictValue fields = {});
+
+// Param helpers: the string at `key`, or nullopt when missing or not a string.
+std::optional<std::string> StringParam(const base::DictValue& body, std::string_view key);
+// True when the UTF-8 text has at most `max` characters (code points).
+bool AtMostChars(std::string_view utf8, size_t max);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_PROTOCOL_H_
diff --git a/chrome/browser/agens/bridge/protocol_selfcheck.cc b/chrome/browser/agens/bridge/protocol_selfcheck.cc
new file mode 100644
index 0000000000..a72cd4fa7c
--- /dev/null
+++ b/chrome/browser/agens/bridge/protocol_selfcheck.cc
@@ -0,0 +1,149 @@
+// Copyright 2026 SugiyamaLabs.
+// Assert-based check of the wire format (protocol.h). Build and run:
+//   ninja -C out/Dev agens_bridge_selfcheck && out/Dev/agens_bridge_selfcheck
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+
+using namespace agens::bridge;
+
+void RunSessionNeedChecks();  // session_need_selfcheck.cc
+
+#define CHECK_TRUE(x)                                              \
+  do {                                                             \
+    if (!(x)) {                                                    \
+      std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #x); \
+      std::exit(1);                                                \
+    }                                                              \
+  } while (0)
+
+static base::DictValue Parse(const std::string& line) {
+  CHECK_TRUE(!line.empty() && line.back() == '\n');
+  CHECK_TRUE(line.find('\n') == line.size() - 1);
+  std::optional<base::Value> v = base::JSONReader::Read(line, base::JSON_PARSE_RFC);
+  CHECK_TRUE(v && v->is_dict());
+  return std::move(v->GetDict());
+}
+
+int main() {
+  // Framing: split across chunks, CRLF, empty lines.
+  {
+    LineFramer framer;
+    std::vector<std::string> lines;
+    CHECK_TRUE(framer.Append("{\"a\":", lines));
+    CHECK_TRUE(lines.empty());
+    CHECK_TRUE(framer.Append("1}\r\n\n{\"b\":2}\n{\"c\"", lines));
+    CHECK_TRUE(lines.size() == 2 && lines[0] == "{\"a\":1}" && lines[1] == "{\"b\":2}");
+    CHECK_TRUE(framer.Append(":3}\n", lines));
+    CHECK_TRUE(lines.size() == 3 && lines[2] == "{\"c\":3}");
+  }
+  // Cap: exactly kMaxLineBytes is fine, one more drops.
+  {
+    LineFramer framer;
+    std::vector<std::string> lines;
+    CHECK_TRUE(framer.Append(std::string(kMaxLineBytes, 'x') + "\n", lines));
+    CHECK_TRUE(lines.size() == 1);
+    LineFramer over;
+    CHECK_TRUE(over.Append(std::string(kMaxLineBytes / 2, 'x'), lines));
+    CHECK_TRUE(!over.Append(std::string(kMaxLineBytes / 2 + 1, 'x'), lines));
+  }
+  // Requests.
+  {
+    std::string error;
+    std::optional<Request> r = ParseRequest(R"({"id":1,"op":"atos.create","name":"Cliente A","tag":"t1"})", error);
+    CHECK_TRUE(r && r->op == "atos.create" && r->id.GetInt() == 1);
+    CHECK_TRUE(StringParam(r->body, "name") == "Cliente A");
+    CHECK_TRUE(StringParam(r->body, "tag") == "t1");
+    CHECK_TRUE(!StringParam(r->body, "color"));
+    CHECK_TRUE(!StringParam(r->body, "id"));  // not a string
+
+    CHECK_TRUE(!ParseRequest("not json", error));
+    base::DictValue e = Parse(error);
+    CHECK_TRUE(*e.FindString("error") == kBadRequest && !e.Find("id") && e.FindBool("ok") == false);
+
+    CHECK_TRUE(!ParseRequest("[1,2]", error));
+    CHECK_TRUE(*Parse(error).FindString("error") == kBadRequest);
+
+    CHECK_TRUE(!ParseRequest(R"({"op":"hello"})", error));
+    CHECK_TRUE(*Parse(error).FindString("error") == kBadRequest);
+
+    CHECK_TRUE(!ParseRequest(R"({"id":7})", error));
+    e = Parse(error);
+    CHECK_TRUE(*e.FindString("error") == kBadRequest && e.FindInt("id") == 7);
+
+    CHECK_TRUE(!ParseRequest(R"({"id":{},"op":"hello"})", error));
+    CHECK_TRUE(ParseRequest(R"({"id":"abc","op":"hello"})", error));
+  }
+  // Replies and events.
+  {
+    base::DictValue result;
+    result.Set("ato", "Profile 1");
+    base::DictValue ok = Parse(OkReply(base::Value(3), std::move(result)));
+    CHECK_TRUE(ok.FindInt("id") == 3 && ok.FindBool("ok") == true && *ok.FindString("ato") == "Profile 1");
+
+    base::DictValue err = Parse(ErrorReply(nullptr, kUnauthorized, "line\nbreak"));
+    CHECK_TRUE(*err.FindString("error") == kUnauthorized && *err.FindString("message") == "line\nbreak");
+
+    base::DictValue ev = Parse(EventLine("session.lost"));
+    CHECK_TRUE(*ev.FindString("event") == "session.lost" && !ev.Find("id"));
+  }
+  // Character caps count code points, not bytes.
+  {
+    CHECK_TRUE(AtMostChars("", 0));
+    CHECK_TRUE(AtMostChars(std::string(256, 'a'), 256));
+    CHECK_TRUE(!AtMostChars(std::string(257, 'a'), 256));
+    std::string accents;
+    for (int i = 0; i < 256; ++i) accents += "\xC3\xA7";  // "ç", 2 bytes each
+    CHECK_TRUE(AtMostChars(accents, 256));
+    CHECK_TRUE(!AtMostChars(accents + "a", 256));
+    CHECK_TRUE(AtMostChars("\xF0\x9F\x98\x80", 1));  // one emoji, 4 bytes
+  }
+  // page.key: names, characters, modifiers, and what a password field allows.
+  {
+    base::Value none;
+    CHECK_TRUE(ParseKey("Enter", nullptr)->text == u"\r" && ParseKey("Enter", nullptr)->windows_code == 0x0D);
+    CHECK_TRUE(!ParseKey("Enter", nullptr)->edits && ParseKey("Backspace", nullptr)->edits);
+    CHECK_TRUE(ParseKey("a", nullptr)->code == "KeyA" && ParseKey("a", nullptr)->windows_code == 'A');
+    CHECK_TRUE(ParseKey("7", nullptr)->code == "Digit7" && ParseKey("\xC3\xA7", nullptr)->text == u"\u00e7");
+    CHECK_TRUE(ParseKey("\xF0\x9F\x98\x80", nullptr));  // one emoji: a surrogate pair
+    CHECK_TRUE(!ParseKey("", nullptr) && !ParseKey("ab", nullptr) && !ParseKey("enter", nullptr));
+    CHECK_TRUE(!ParseKey("\t", nullptr) && !ParseKey("F5", nullptr));
+    base::ListValue mods;
+    mods.Append("meta");
+    mods.Append("shift");
+    base::Value list(std::move(mods));
+    std::optional<Key> k = ParseKey("v", &list);
+    CHECK_TRUE(k && k->meta && k->shift && !k->ctrl && k->text.empty() && TouchesClipboard(*k));
+    base::ListValue bad;
+    bad.Append("hyper");
+    base::Value bad_list(std::move(bad));
+    CHECK_TRUE(!ParseKey("a", &bad_list) && !ParseKey("a", &none));
+    base::ListValue shift;
+    shift.Append("shift");
+    base::Value shift_list(std::move(shift));
+    CHECK_TRUE(AllowedOnPassword(*ParseKey("Tab", &shift_list)) && AllowedOnPassword(*ParseKey("ArrowLeft", nullptr)));
+    CHECK_TRUE(AllowedOnPassword(*ParseKey("Enter", nullptr)) && AllowedOnPassword(*ParseKey("Escape", nullptr)));
+    CHECK_TRUE(!AllowedOnPassword(*ParseKey("a", nullptr)) && !AllowedOnPassword(*ParseKey("Backspace", nullptr)));
+    CHECK_TRUE(!AllowedOnPassword(*ParseKey("Delete", nullptr)) && !AllowedOnPassword(*ParseKey("ArrowLeft", &list)));
+    CHECK_TRUE(TouchesClipboard(*ParseKey("Delete", &shift_list)) && !TouchesClipboard(*ParseKey("c", nullptr)));
+  }
+  // control.start's "Permitir sempre" key and the names in its sheet.
+  {
+    CHECK_TRUE(ControlAlwaysKey("T/app", "Profile 1", {"Profile 3", "Default"}) ==
+               ControlAlwaysKey("T/app", "Profile 1", {"Default", "Profile 3"}));
+    CHECK_TRUE(ControlAlwaysKey("T/app", "Profile 1", {}) != ControlAlwaysKey("T/app", "Profile 1", {"Default"}));
+    CHECK_TRUE(ControlAlwaysKey("T/app", "Profile 1", {}) != ControlAlwaysKey("T/app", "Profile 2", {}));
+    CHECK_TRUE(ControlAlwaysKey("T/a", "b", {}) != ControlAlwaysKey("T/a\",\"b", "", {}));
+    CHECK_TRUE(JoinNames({}) == "" && JoinNames({"A"}) == "A" && JoinNames({"A", "B"}) == "A e B");
+    CHECK_TRUE(JoinNames({"A", "B", "C"}) == "A, B e C");
+  }
+  std::printf("agens bridge protocol: ok\n");
+  RunSessionNeedChecks();
+  return 0;
+}
diff --git a/chrome/browser/agens/bridge/session_need.cc b/chrome/browser/agens/bridge/session_need.cc
new file mode 100644
index 0000000000..719ce44b6d
--- /dev/null
+++ b/chrome/browser/agens/bridge/session_need.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/session_need.h"
+
+#include <algorithm>
+#include <tuple>
+
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/agens/bridge/protocol.h"
+#include "url/gurl.h"
+
+namespace agens::bridge::session {
+
+namespace {
+
+constexpr size_t kMaxOriginBytes = 2048;
+
+bool KnownType(std::string_view type) {
+  return type == "cookie" || type == "localStorage" || type == "header";
+}
+
+}  // namespace
+
+std::optional<url::Origin> ParseOrigin(std::string_view text) {
+  if (text.size() > kMaxOriginBytes) return std::nullopt;
+  const GURL url(text);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() || url.has_password()) return std::nullopt;
+  url::Origin origin = url::Origin::Create(url);
+  if (origin.GetURL() != url) return std::nullopt;  // a path, query or fragment
+  return origin;
+}
+
+bool ValidName(std::string_view name) {
+  if (name.empty() || !AtMostChars(name, kMaxNameChars)) return false;
+  return std::ranges::none_of(name, [](unsigned char c) { return c < 0x20 || c == 0x7f; });
+}
+
+std::optional<std::vector<Item>> ParseNeed(const base::Value* need, std::string& error) {
+  error = "need must be a list of 1 to 32 items {type: cookie|localStorage|header, from: http(s) origin, name}";
+  if (!need || !need->is_list() || need->GetList().empty() || need->GetList().size() > kMaxItems) return std::nullopt;
+  std::vector<Item> items;
+  for (const base::Value& value : need->GetList()) {
+    if (!value.is_dict()) return std::nullopt;
+    const std::string* type = value.GetDict().FindString("type");
+    const std::string* from = value.GetDict().FindString("from");
+    const std::string* name = value.GetDict().FindString("name");
+    if (!type || !from || !name || !KnownType(*type) || !ValidName(*name)) return std::nullopt;
+    std::optional<url::Origin> origin = ParseOrigin(*from);
+    if (!origin) return std::nullopt;
+    // The Cookie header would hand over every cookie of that origin: ask for the cookies by name.
+    if (*type == "header" && base::EqualsCaseInsensitiveASCII(*name, "cookie")) {
+      error = "header Cookie is not allowed; ask for each cookie by name";
+      return std::nullopt;
+    }
+    Item item{*type, *from, *origin, *name};
+    const bool repeat = std::ranges::any_of(items, [&](const Item& other) {
+      return other.type == item.type && other.origin == item.origin && other.name == item.name;
+    });
+    if (!repeat) items.push_back(std::move(item));
+  }
+  error.clear();
+  return items;
+}
+
+std::string Describe(const Item& item) {
+  std::string where = item.origin.Serialize();
+  if (item.origin.scheme() == "https") where = where.substr(std::string_view("https://").size());
+  return item.type + " " + item.name + " de " + where;
+}
+
+std::string ApprovalKey(std::string_view identity, std::string_view ato, const std::vector<Item>& items) {
+  std::vector<std::tuple<std::string, std::string, std::string>> sorted;
+  for (const Item& item : items) sorted.emplace_back(item.type, item.origin.Serialize(), item.name);
+  std::ranges::sort(sorted);
+  sorted.erase(std::unique(sorted.begin(), sorted.end()), sorted.end());
+  base::ListValue list;
+  for (const auto& [type, origin, name] : sorted) list.Append(base::ListValue().Append(type).Append(origin).Append(name));
+  // JSON, so no separator inside a name can make two different sets collide.
+  return base::WriteJson(base::ListValue().Append(identity).Append(ato).Append(std::move(list))).value_or("");
+}
+
+}  // namespace agens::bridge::session
diff --git a/chrome/browser/agens/bridge/session_need.h b/chrome/browser/agens/bridge/session_need.h
new file mode 100644
index 0000000000..7200546383
--- /dev/null
+++ b/chrome/browser/agens/bridge/session_need.h
@@ -0,0 +1,49 @@
+// Copyright 2026 SugiyamaLabs.
+// The pure part of the session ops (session_ops.h): reading a `need` list, the words the approval
+// sheet shows for each item, and the key "Permitir sempre" is remembered under. Only //base and
+// //url, so protocol_selfcheck.cc can exercise it.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_SESSION_NEED_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_SESSION_NEED_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "url/origin.h"
+
+namespace agens::bridge::session {
+
+// Local State. ApprovalKey()s answered "Permitir sempre" (never for an unsigned client).
+inline constexpr char kAlwaysPref[] = "agens.bridge.session_always";
+
+inline constexpr size_t kMaxItems = 32;
+inline constexpr size_t kMaxNameChars = 256;
+
+struct Item {
+  std::string type;  // "cookie", "localStorage" or "header"
+  std::string from;  // as the client sent it, echoed back
+  url::Origin origin;
+  std::string name;
+};
+
+// An http(s) origin and nothing more (no path, query, fragment or credentials).
+std::optional<url::Origin> ParseOrigin(std::string_view text);
+// A cookie, storage key or header name: 1..kMaxNameChars characters, no control characters (it is
+// shown on the sheet, one item per line).
+bool ValidName(std::string_view name);
+
+// `need` from the request: 1..kMaxItems items, repeats dropped. On failure fills `error` (the
+// bad_request message) and returns nullopt.
+std::optional<std::vector<Item>> ParseNeed(const base::Value* need, std::string& error);
+
+// One line of the sheet, e.g. "cookie d de app.slack.com" (https is implied, other schemes shown).
+std::string Describe(const Item& item);
+
+// The same for the same client, ato and set of items, whatever their order.
+std::string ApprovalKey(std::string_view identity, std::string_view ato, const std::vector<Item>& items);
+
+}  // namespace agens::bridge::session
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_SESSION_NEED_H_
diff --git a/chrome/browser/agens/bridge/session_need_selfcheck.cc b/chrome/browser/agens/bridge/session_need_selfcheck.cc
new file mode 100644
index 0000000000..168e6239f8
--- /dev/null
+++ b/chrome/browser/agens/bridge/session_need_selfcheck.cc
@@ -0,0 +1,98 @@
+// Copyright 2026 SugiyamaLabs.
+// Assert-based check of session_need.h, run by agens_bridge_selfcheck (protocol_selfcheck.cc).
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "chrome/browser/agens/bridge/session_need.h"
+
+using namespace agens::bridge::session;
+
+#define NEED_CHECK(x)                                                     \
+  do {                                                                    \
+    if (!(x)) {                                                           \
+      std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #x); \
+      std::exit(1);                                                       \
+    }                                                                     \
+  } while (0)
+
+static std::optional<std::vector<Item>> Need(const std::string& json) {
+  std::optional<base::Value> v = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  NEED_CHECK(v);
+  std::string error;
+  std::optional<std::vector<Item>> items = ParseNeed(&*v, error);
+  NEED_CHECK(items.has_value() == error.empty());
+  return items;
+}
+
+void RunSessionNeedChecks() {
+  // Origins: http(s), nothing past the host and port.
+  NEED_CHECK(ParseOrigin("https://app.slack.com"));
+  NEED_CHECK(ParseOrigin("https://app.slack.com/"));
+  NEED_CHECK(ParseOrigin("http://127.0.0.1:8765")->Serialize() == "http://127.0.0.1:8765");
+  NEED_CHECK(!ParseOrigin("https://app.slack.com/path"));
+  NEED_CHECK(!ParseOrigin("https://app.slack.com/?q=1"));
+  NEED_CHECK(!ParseOrigin("https://app.slack.com/#x"));
+  NEED_CHECK(!ParseOrigin("https://user:pw@app.slack.com"));
+  NEED_CHECK(!ParseOrigin("ftp://app.slack.com"));
+  NEED_CHECK(!ParseOrigin("javascript:alert(1)"));
+  NEED_CHECK(!ParseOrigin("app.slack.com"));
+  NEED_CHECK(!ParseOrigin(""));
+
+  // Names: no control characters (they would forge lines on the sheet), capped.
+  NEED_CHECK(ValidName("d"));
+  NEED_CHECK(!ValidName(""));
+  NEED_CHECK(!ValidName("a\nheader Authorization de bank.com"));
+  NEED_CHECK(!ValidName(std::string("a\0b", 3)));
+  NEED_CHECK(ValidName(std::string(kMaxNameChars, 'n')));
+  NEED_CHECK(!ValidName(std::string(kMaxNameChars + 1, 'n')));
+
+  // Need lists.
+  std::optional<std::vector<Item>> items = Need(
+      R"([{"type":"cookie","from":"https://app.slack.com","name":"d"},
+          {"type":"localStorage","from":"http://127.0.0.1:8765","name":"token"},
+          {"type":"header","from":"https://outlook.office.com","name":"Authorization"},
+          {"type":"cookie","from":"https://app.slack.com/","name":"d"}])");
+  NEED_CHECK(items && items->size() == 3);  // the repeat is dropped
+  NEED_CHECK((*items)[0].from == "https://app.slack.com" && (*items)[1].name == "token");
+  NEED_CHECK(Describe((*items)[0]) == "cookie d de app.slack.com");
+  NEED_CHECK(Describe((*items)[1]) == "localStorage token de http://127.0.0.1:8765");
+  NEED_CHECK(Describe((*items)[2]) == "header Authorization de outlook.office.com");
+
+  NEED_CHECK(!Need("[]"));
+  NEED_CHECK(!Need("{}"));
+  NEED_CHECK(!Need("[1]"));
+  NEED_CHECK(!Need(R"([{"type":"password","from":"https://a.com","name":"x"}])"));
+  NEED_CHECK(!Need(R"([{"type":"cookie","from":"https://a.com/x","name":"x"}])"));
+  NEED_CHECK(!Need(R"([{"type":"cookie","from":"https://a.com","name":""}])"));
+  NEED_CHECK(!Need(R"([{"type":"cookie","from":"https://a.com"}])"));
+  NEED_CHECK(!Need(R"([{"type":"cookie","from":"https://a.com","name":7}])"));
+  NEED_CHECK(!Need(R"([{"type":"header","from":"https://a.com","name":"COOKIE"}])"));
+  NEED_CHECK(Need(R"([{"type":"cookie","from":"https://a.com","name":"Cookie"}])"));
+  auto many = [](size_t n) {
+    std::string list = "[";
+    for (size_t i = 0; i < n; ++i) {
+      list += (i ? "," : "") + std::string(R"({"type":"cookie","from":"https://a.com","name":"c)") +
+              std::to_string(i) + "\"}";
+    }
+    return list + "]";
+  };
+  NEED_CHECK(!Need(many(kMaxItems + 1)));
+  NEED_CHECK(Need(many(kMaxItems))->size() == kMaxItems);
+
+  // The "always" key: order and repeats do not matter; client, ato and every item do.
+  std::optional<std::vector<Item>> ab = Need(
+      R"([{"type":"cookie","from":"https://a.com","name":"x"},{"type":"header","from":"https://b.com","name":"H"}])");
+  std::optional<std::vector<Item>> ba = Need(
+      R"([{"type":"header","from":"https://b.com/","name":"H"},{"type":"cookie","from":"https://a.com","name":"x"}])");
+  std::optional<std::vector<Item>> a = Need(R"([{"type":"cookie","from":"https://a.com","name":"x"}])");
+  NEED_CHECK(ApprovalKey("T/app", "Profile 1", *ab) == ApprovalKey("T/app", "Profile 1", *ba));
+  NEED_CHECK(ApprovalKey("T/app", "Profile 1", *ab) != ApprovalKey("T/app", "Profile 1", *a));
+  NEED_CHECK(ApprovalKey("T/app", "Profile 1", *a) != ApprovalKey("T/other", "Profile 1", *a));
+  NEED_CHECK(ApprovalKey("T/app", "Profile 1", *a) != ApprovalKey("T/app", "Profile 2", *a));
+  NEED_CHECK(!ApprovalKey("T/app", "Profile 1", *a).empty());
+
+  std::printf("agens bridge session need: ok\n");
+}
diff --git a/chrome/browser/agens/bridge/session_ops.cc b/chrome/browser/agens/bridge/session_ops.cc
new file mode 100644
index 0000000000..ab81719bc2
--- /dev/null
+++ b/chrome/browser/agens/bridge/session_ops.cc
@@ -0,0 +1,267 @@
+// Copyright 2026 SugiyamaLabs.
+// Session values (cookie, localStorage and header values) live only in memory on their way to the
+// socket: never in a log line, pref, file or error message.
+
+#include "chrome/browser/agens/bridge/session_ops.h"
+
+#include <list>
+#include <map>
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/agens/bridge/session_need.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "base/timer/timer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "net/cookies/cookie_change_dispatcher.h"
+#include "net/cookies/cookie_options.h"
+#include "net/cookies/cookie_partition_key_collection.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "url/gurl.h"
+
+namespace agens::bridge::session {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr char kCancelled[] = "cancelled";
+
+// Per connection, and how long one may wait for the person (also covers a profile that never opens).
+constexpr size_t kMaxLoginsInFlight = 4;
+constexpr base::TimeDelta kMaxLoginTime = base::Minutes(15);
+
+// The ato whose folder is `id`, among the atos the UI lists (as ops.cc), so a client never names a path.
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+network::mojom::CookieManager* CookiesOf(Profile* profile) {
+  return profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+}
+
+// Whether the ato would send a cookie `name` to `origin` (httpOnly included). Only that: the value
+// is not needed, so it never leaves the cookie store.
+void HasCookie(Profile* profile, const url::Origin& origin, const std::string& name, base::OnceCallback<void(bool)> done) {
+  CookiesOf(profile)->GetCookieList(
+      origin.GetURL(), net::CookieOptions::MakeAllInclusive(), net::CookiePartitionKeyCollection(),
+      base::BindOnce(
+          [](std::string name, base::OnceCallback<void(bool)> done, const std::vector<net::CookieWithAccessResult>& cookies,
+             const std::vector<net::CookieWithAccessResult>&) {
+            std::move(done).Run(std::ranges::any_of(cookies, [&](const auto& c) { return c.cookie.Name() == name; }));
+          },
+          name, std::move(done)));
+}
+
+bool IsInsertion(net::CookieChangeCause cause) {
+  return cause == net::CookieChangeCause::INSERTED || cause == net::CookieChangeCause::INSERTED_NO_CHANGE_OVERWRITE ||
+         cause == net::CookieChangeCause::INSERTED_NO_VALUE_CHANGE_OVERWRITE;
+}
+
+class LoginWatch;
+
+// What this area keeps per connection; dropped in OnConnectionClosed.
+struct ConnectionState {
+  std::list<std::unique_ptr<LoginWatch>> logins;
+};
+std::map<uint64_t, ConnectionState>& Connections() {
+  static base::NoDestructor<std::map<uint64_t, ConnectionState>> connections;
+  return *connections;
+}
+
+// A `login` in progress: the tab it opened and its `done` rule. Replies once and deletes itself;
+// deleted early (the connection closed), it stops watching and leaves the tab open.
+class LoginWatch : public content::WebContentsObserver, public network::mojom::CookieChangeListener {
+ public:
+  LoginWatch(uint64_t connection,
+             base::Value id,
+             ReplyCallback reply,
+             std::string url_prefix,
+             std::optional<url::Origin> cookie_origin,
+             std::string cookie_name)
+      : connection_(connection),
+        id_(std::move(id)),
+        reply_(std::move(reply)),
+        url_prefix_(std::move(url_prefix)),
+        cookie_origin_(std::move(cookie_origin)),
+        cookie_name_(std::move(cookie_name)) {
+    timeout_.Start(FROM_HERE, kMaxLoginTime,
+                   base::BindOnce(&LoginWatch::Finish, base::Unretained(this),
+                                  ErrorReply(&id_, kFailed, "timed out"), /*close_tab=*/false));
+  }
+
+  void Start(Profile* profile, content::WebContents* tab) {
+    Observe(tab);
+    if (!cookie_origin_) return;
+    CookiesOf(profile)->AddCookieChangeListener(cookie_origin_->GetURL(), cookie_name_,
+                                                receiver_.BindNewPipeAndPassRemote());
+    // E.g. the network service restarted: nothing would ever tell this watch.
+    receiver_.set_disconnect_handler(base::BindOnce(&LoginWatch::Finish, base::Unretained(this),
+                                                    ErrorReply(&id_, kFailed, "lost the cookie store"),
+                                                    /*close_tab=*/false));
+    // The person may already be logged in.
+    HasCookie(profile, *cookie_origin_, cookie_name_,
+              base::BindOnce(
+                  [](base::WeakPtr<LoginWatch> self, bool has) {
+                    if (self && has) self->Finish(OkReply(self->id_), /*close_tab=*/true);
+                  },
+                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Fail() { Finish(ErrorReply(&id_, kFailed, "could not open the ato"), /*close_tab=*/false); }
+
+ private:
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (!url_prefix_.empty() && navigation->IsInPrimaryMainFrame() && navigation->HasCommitted() &&
+        !navigation->IsErrorPage() && base::StartsWith(navigation->GetURL().spec(), url_prefix_)) {
+      Finish(OkReply(id_), /*close_tab=*/true);
+    }
+  }
+  void WebContentsDestroyed() override {
+    Finish(ErrorReply(&id_, kCancelled, "the tab was closed"), /*close_tab=*/false);
+  }
+
+  // network::mojom::CookieChangeListener:
+  void OnCookieChange(const net::CookieChangeInfo& change) override {
+    if (change.cookie.Name() == cookie_name_ && IsInsertion(change.cause)) Finish(OkReply(id_), /*close_tab=*/true);
+  }
+
+  // Deletes this.
+  void Finish(std::string line, bool close_tab) {
+    std::move(reply_).Run(std::move(line));
+    if (close_tab && web_contents()) {
+      // Posted: not from inside the tab's own observer call.
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(
+                         [](base::WeakPtr<content::WebContents> tab) {
+                           if (tab) tab->ClosePage();
+                         },
+                         web_contents()->GetWeakPtr()));
+    }
+    Observe(nullptr);
+    std::erase_if(Connections()[connection_].logins, [this](const auto& watch) { return watch.get() == this; });
+  }
+
+  const uint64_t connection_;
+  const base::Value id_;
+  ReplyCallback reply_;
+  const std::string url_prefix_;  // spec of the URL; empty for a cookie rule
+  const std::optional<url::Origin> cookie_origin_;
+  const std::string cookie_name_;
+  mojo::Receiver<network::mojom::CookieChangeListener> receiver_{this};
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<LoginWatch> weak_factory_{this};
+};
+
+void Login(const Client& client, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  const GURL url(StringParam(request.body, "url").value_or(""));
+  const base::DictValue* done = request.body.FindDict("done");
+  std::string url_prefix;
+  std::optional<url::Origin> cookie_origin;
+  std::string cookie_name;
+  bool done_ok = false;
+  // The rule must be about the site it opens: otherwise opening any page would tell a client whether
+  // the person is logged in somewhere else, unseen.
+  auto same_site = [&](const url::Origin& other) {
+    return url.is_valid() && net::registry_controlled_domains::SameDomainOrHost(
+                                 url::Origin::Create(url), other,
+                                 net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  };
+  if (done && done->size() == 1) {
+    const GURL prefix(StringParam(*done, "url_prefix").value_or(""));
+    if (prefix.is_valid() && prefix.SchemeIsHTTPOrHTTPS() && same_site(url::Origin::Create(prefix))) {
+      url_prefix = prefix.spec();
+      done_ok = true;
+    }
+  } else if (done && done->size() == 2) {
+    std::optional<std::string> name = StringParam(*done, "cookie");
+    std::optional<std::string> from = StringParam(*done, "from");
+    cookie_origin = from ? ParseOrigin(*from) : std::nullopt;
+    if (name && ValidName(*name) && cookie_origin && same_site(*cookie_origin)) {
+      cookie_name = *name;
+      done_ok = true;
+    }
+  }
+  if (!id || !url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !done_ok) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                    "needs ato, url (http or https) and done: {cookie, from} or {url_prefix}, "
+                                    "on the same site as url"));
+    return;
+  }
+  if (Connections()[client.connection].logins.size() >= kMaxLoginsInFlight) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "at most 4 logins at once per connection"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  auto owned = std::make_unique<LoginWatch>(client.connection, request.id.Clone(), std::move(reply),
+                                            std::move(url_prefix), std::move(cookie_origin), std::move(cookie_name));
+  LoginWatch* watch = owned.get();
+  Connections()[client.connection].logins.push_back(std::move(owned));
+  // Loads the profile when it isn't, and opens (or brings up) its window.
+  profiles::SwitchToProfile(
+      entry->GetPath(), /*always_create=*/false,
+      base::BindOnce(
+          [](uint64_t connection, LoginWatch* watch, GURL url, BrowserWindowInterface* browser) {
+            // The connection may have closed meanwhile, taking the watch with it.
+            auto it = Connections().find(connection);
+            if (it == Connections().end() ||
+                !std::ranges::any_of(it->second.logins, [&](const auto& w) { return w.get() == watch; })) {
+              return;
+            }
+            content::WebContents* tab = nullptr;
+            if (browser) {
+              NavigateParams params(browser, url, ui::PAGE_TRANSITION_LINK);
+              params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+              Navigate(&params);
+              tab = params.navigated_or_inserted_contents;
+            }
+            if (tab) {
+              watch->Start(browser->GetProfile(), tab);
+            } else {
+              watch->Fail();
+            }
+          },
+          client.connection, watch, url));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return op == "login" || op == "session" || op == "renew";
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  if (request.op == "login") {
+    Login(client, std::move(request), std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, request.op));
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  Connections().erase(connection);
+}
+
+}  // namespace agens::bridge::session
diff --git a/chrome/browser/agens/bridge/session_ops.h b/chrome/browser/agens/bridge/session_ops.h
