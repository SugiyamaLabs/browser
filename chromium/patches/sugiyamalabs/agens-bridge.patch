+// agens: an input whose text is a secret: a password field now or before (a "show password"
+// toggle changed its type), one Blink's heuristics take for a password, one masked with
+// -webkit-text-security, or one whose autocomplete names a secret. It says kInputType "password"
+// (and kProtected when masked), which the browser's socket control relies on to never read,
+// type into or picture one (chrome/browser/agens/bridge/control_page.cc).
+bool AgensIsSecretInput(const Node* node, bool* masked) {
+  const auto* input = DynamicTo<HTMLInputElement>(node);
+  if (!input || !input->IsTextField()) {
+    return false;
+  }
+  const ComputedStyle* style = input->GetComputedStyle();
+  *masked = input->FormControlType() == FormControlType::kInputPassword ||
+            (style && style->TextSecurity() != ETextSecurity::kNone);
+  if (*masked || input->HasBeenPasswordField() ||
+      input->HasBeenHeuristicCustomPasswordCSS() ||
+      input->HasBeenHeuristicCustomPasswordJS()) {
+    return true;
+  }
+  const String autocomplete =
+      input->FastGetAttribute(html_names::kAutocompleteAttr).GetString();
+  for (const char* token : {"current-password", "new-password",
+                            "one-time-code", "cc-number", "cc-csc"}) {
+    if (autocomplete.FindIgnoringAsciiCase(token) != String::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+void AgensSerializeSecretInput(const Node* node, ui::AXNodeData* node_data) {
+  bool masked = false;
+  if (!AgensIsSecretInput(node, &masked)) {
+    return;
+  }
+  node_data->RemoveStringAttribute(ax::mojom::blink::StringAttribute::kInputType);
+  node_data->AddStringAttribute(ax::mojom::blink::StringAttribute::kInputType,
+                                "password");
+  if (masked) {
+    node_data->AddState(ax::mojom::blink::State::kProtected);
+  }
+}
+
 }  // namespace
 
