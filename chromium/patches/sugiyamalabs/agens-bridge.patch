+void RestoreAfterCrash(Profile* initial);
+// The ato (its folder name) had windows when the engine last quit normally and its tabs were not
+// brought back yet (atos.list "restorable"). Kept across runs until view.restore.
+bool IsRestorable(const std::string& ato);
