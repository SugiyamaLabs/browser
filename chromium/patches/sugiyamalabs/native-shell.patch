+// --- Actions.
+
+// The window menu (prototype openMainMenu): Nova aba, Favoritos, Histórico, Configurações.
+- (void)showMenu {
+  if (_menuView) {
+    [self closeMenu];
+    return;
+  }
+  __weak AgensChrome* weak = self;
+  struct Item {
+    NSString* icon;
+    NSString* title;
+    NSString* key;
+    void (^action)(void);
+  } items[] = {
+      {kIconPlus, @"Nova aba", @"⌘T", ^{ [weak menuNewTab:nil]; }},
+      {kIconStar, @"Favoritos", @"⌘⌥B", ^{ [weak menuBookmarks:nil]; }},
+      {kIconClock, @"Histórico", @"⌘Y", ^{ [weak menuHistory:nil]; }},
+      {kIconSettings, @"Configurações", @"⌘,", ^{ [weak menuSettings:nil]; }},
+  };
+  const CGFloat w = 260, rowH = 33;
+  NSView* panel = [self popoverWidth:w height:std::size(items) * rowH + 10 under:_menu];
+  panel.accessibilityRole = NSAccessibilityMenuRole;
+  panel.accessibilityLabel = @"Menu";
+  CGFloat y = NSHeight(panel.frame) - 5 - rowH;  // the panel isn't flipped
+  for (const Item& it : items) {
+    AgensMenuRow* row = [[AgensMenuRow alloc] initWithIcon:it.icon title:it.title key:it.key];
+    void (^action)(void) = it.action;
+    row.onPress = ^{
+      [weak closeMenu];
+      action();
+    };
+    row.frame = NSMakeRect(5, y, w - 10, rowH);
+    [panel addSubview:row];
+    y -= rowH;
+  }
+  [self presentPopover:panel anchor:_menu];
+}
+
+// Our floating panels (prototype .menu): float background, strong border, 12 pt corners.
+- (NSView*)popoverWidth:(CGFloat)w height:(CGFloat)h under:(NSView*)anchor {
+  NSView* panel = [[NSView alloc] initWithFrame:NSMakeRect(MAX(8, NSMaxX(anchor.frame) - w), NSMaxY(anchor.frame) + 6, w, h)];
+  panel.wantsLayer = YES;
+  panel.layer.cornerRadius = 12;
+  panel.layer.borderWidth = 1;
+  panel.layer.backgroundColor = CG(kFloat, self);
+  panel.layer.borderColor = CG(kLineStrong, self);
+  return panel;
+}
+- (void)presentPopover:(NSView*)panel anchor:(NSView*)anchor {
+  __weak AgensChrome* weak = self;
+  [self closeMenu];
+  _menuView = panel;
+  _popoverAnchor = anchor;
+  [self addSubview:_menuView];
+  // Rise in, as the prototype (.2s); a click anywhere else or Esc closes it.
+  _menuView.alphaValue = 0;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* ctx) {
+    ctx.duration = 0.2;
+    self->_menuView.animator.alphaValue = 1;
+  }];
+  _clickMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDown | NSEventMaskRightMouseDown | NSEventMaskKeyDown
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     AgensChrome* strong = weak;
+                                     if (!strong || !strong->_menuView) return event;
+                                     if (event.type == NSEventTypeKeyDown) {
+                                       if (event.keyCode == 53) {  // Esc
+                                         [strong closeMenu];
+                                         return nil;
+                                       }
+                                       return event;
+                                     }
+                                     NSPoint p = [strong convertPoint:event.locationInWindow fromView:nil];
+                                     if (event.window != strong.window ||
+                                         (!NSPointInRect(p, strong->_menuView.frame) &&
+                                          !NSPointInRect(p, strong->_popoverAnchor.frame))) {
+                                       [strong closeMenu];
+                                     }
+                                     return event;
+                                   }];
+}
+- (void)setStatus:(const char*)text {
+  _statusText.stringValue = @(text);
+  _statusPill.hidden = _statusText.stringValue.length == 0;
+  [self relayout];
+}
