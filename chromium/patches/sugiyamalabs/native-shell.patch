+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(w->browser->GetProfile());
+  if (!service || !service->loaded() || !keyword) return;
+  if (TemplateURL* t = service->GetTemplateURLForKeyword(base::UTF8ToUTF16(keyword))) {
+    service->SetUserSelectedDefaultSearchProvider(t);
