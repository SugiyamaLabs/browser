+  if (pref && !pref->IsDefaultValue()) {
+    return base::Minutes(std::max(
+        1, local->GetInteger(performance_manager::user_tuning::prefs::kMemorySaverModeTimeBeforeDiscardInMinutes)));
+  }
+  return kSleepingTabsDiscardAfter.Get();
+}
