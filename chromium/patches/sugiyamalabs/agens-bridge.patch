+// Copyright 2026 SugiyamaLabs.
+// The page inside another app (docs/protocolo.md, "host e view"): host.attach, view.* and
+// approval.answer and ui.answer (ui_ops.h). Only when the engine runs embedded (agens_embedded.h); otherwise every op here
+// answers unknown_op. UI thread; see ops.h for what a handler gets.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_VIEW_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_VIEW_OPS_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/agens/bridge/approval.h"
+#include "chrome/browser/agens/bridge/ops.h"
+
+struct AgensWindow;
+namespace content {
+class WebContents;
+}
+
+namespace agens::bridge::view {
+
+bool Handles(std::string_view op);
+void HandleOp(const Client& client, Request request, ReplyCallback reply);
+void OnConnectionClosed(uint64_t connection);
+
+// The engine's parent died (agens_embedded_mac.mm): nobody is the host any more.
+void HostGone();
+
+// The host's connection; 0 while none is attached.
+uint64_t Host();
+// The n of the tab's id "v<n>" (given now when it has none).
+int TabNumber(content::WebContents* contents);
+
+// The shell's windows (native_shell_mac.mm): their tabs are the ones the host sees.
+void AddWindow(AgensWindow* window);
+void RemoveWindow(AgensWindow* window);
+
+// approval.cc, embedded: the question goes to the host as approval.ask instead of a sheet. Same
+// contract as agens::ShowApprovalSheet: one at a time; `done` runs once (now, with deny, when no
+// host is attached; deny too when the host goes away first).
+void AskHost(const std::string& title, const std::string& detail, bool offer_always, ApprovalCallback done);
+
+}  // namespace agens::bridge::view
