+// The link's URL while the pointer is on it (prototipos/janela-recursos.html, #link): flush in the
+// page's bottom-left corner, the domain in ink, a long path cut in the middle so its end (file,
+// anchor) stays in view.
+static NSAttributedString* LinkText(NSString* s, NSUInteger max) {
+  const NSUInteger slash = [s rangeOfString:@"/"].location;
+  NSString* domain = slash == NSNotFound ? s : [s substringToIndex:slash];
+  NSString* path = slash == NSNotFound ? @"" : [s substringFromIndex:slash];
+  const NSInteger keep = MAX(8, (NSInteger)max - (NSInteger)domain.length - 1);
+  if (s.length > max && (NSInteger)path.length > keep) {
+    const NSUInteger a = [path rangeOfComposedCharacterSequenceAtIndex:(NSUInteger)ceil(keep * 0.45)].location;
+    const NSUInteger b = [path rangeOfComposedCharacterSequenceAtIndex:path.length - (keep - a)].location;
+    path = [NSString stringWithFormat:@"%@…%@", [path substringToIndex:a], [path substringFromIndex:b]];
+  }
+  NSMutableAttributedString* out = [[NSMutableAttributedString alloc]
+      initWithString:domain
+          attributes:@{NSFontAttributeName : [NSFont systemFontOfSize:12 weight:NSFontWeightMedium], NSForegroundColorAttributeName : kInk.color()}];
+  [out appendAttributedString:[[NSAttributedString alloc]
+                                  initWithString:path
+                                      attributes:@{NSFontAttributeName : [NSFont systemFontOfSize:12], NSForegroundColorAttributeName : kMute.color()}]];
+  return out;
+}
