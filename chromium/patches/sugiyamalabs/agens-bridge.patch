diff --git a/chrome/browser/agens/embed/agens_embedded.h b/chrome/browser/agens/embed/agens_embedded.h
new file mode 100644
index 0000000000..aef9e1cc9e
--- /dev/null
+++ b/chrome/browser/agens/embed/agens_embedded.h
@@ -0,0 +1,46 @@
+// Copyright 2026 SugiyamaLabs.
+// The engine as another app's hidden helper (docs/agens.md, "Um código, dois produtos";
+// docs/protocolo.md, "host e view"). With --agens-embedded the app that launched the engine draws
+// the whole interface: the engine has no Dock icon, puts no window on screen except the DevTools
+// window the person asked for (view.inspect, the right click's "inspect"), activates itself only
+// for that one, and quits when that app goes away. macOS only; false everywhere else.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_EMBEDDED_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_EMBEDDED_H_
+
+#include <sys/types.h>
+
+#include <string>
+
+namespace content {
+class WebContents;
+}
+
+namespace agens {
+
+inline constexpr char kEmbeddedSwitch[] = "agens-embedded";
+// Development only, never in official builds: unsigned clients get on the socket while nothing
+// is signed yet. Only meaningful with kEmbeddedSwitch.
+inline constexpr char kAcceptUnsignedSwitch[] = "agens-accept-unsigned";
+
+bool IsEmbedded();
+// The process that launched the engine (its parent at startup); 0 when not embedded.
+pid_t EmbeddedParent();
+// Embedded and started with kAcceptUnsignedSwitch in a non-official build.
+bool AcceptUnsignedClients();
+// Besides the parent, which always gets in: an app signed with our Team ID whose signing
+// identifier the host listed in --agens-allowed-clients. Embedded only.
+inline constexpr char kAllowedClientsSwitch[] = "agens-allowed-clients";
+bool EmbeddedClientAllowed(const std::string& signing_identifier);
+
+// The tab a file panel is about to open for: ChromeSelectFilePolicy sets it right before the
+// panel (bridge/ui_ops.cc, the host's) reads it, in the same call.
+void SetFileDialogSource(content::WebContents* contents);
+
+// From ChromeBrowserMainPartsMac::PreEarlyInitialization, before any window exists: no Dock
+// icon, no startup window, no first run, and the watch on the parent. Exits right away when the
+// parent is already gone. Does nothing when not embedded.
+void StartEmbedded();
+
+}  // namespace agens
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_EMBEDDED_H_
