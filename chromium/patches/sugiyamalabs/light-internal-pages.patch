+// Copyright 2026 SugiyamaLabs.
+// Trivial stand-ins for the history, bookmarks and new tab WebUI pages. The native shell draws
+// those views itself over the page card, so the heavy WebUI underneath only wastes memory.
+#ifndef CHROME_BROWSER_UI_WEBUI_AGENS_LIGHT_PAGES_H_
+#define CHROME_BROWSER_UI_WEBUI_AGENS_LIGHT_PAGES_H_
+
+namespace content {
+class WebUIConfigMap;
+}
+
+// Registers the light pages for every host the native shell covers.
+void RegisterAgensLightPageConfigs(content::WebUIConfigMap& map);
+
+#endif  // CHROME_BROWSER_UI_WEBUI_AGENS_LIGHT_PAGES_H_
