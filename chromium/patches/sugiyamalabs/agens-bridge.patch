+    // (~AgensWindow posts the deny).
+    if (!strong || !strong->_window) return;
+    agens_window_approval_answer(strong->_window, r == NSAlertFirstButtonReturn                ? kAgensApprovalAllow
+                                                  : offerAlways && r == NSAlertSecondButtonReturn ? kAgensApprovalAllowAlways
+                                                                                                  : kAgensApprovalDeny);
+  }];
+}
