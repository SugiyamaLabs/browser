+// Exceções por site: one row per site and kind, with the value and "Tirar".
+static NSString* KindName(const std::string& kind) {
+  static const std::pair<const char*, NSString*> kNames[] = {
+      {"camera", @"Câmera"}, {"microphone", @"Microfone"}, {"location", @"Localização"},
+      {"notifications", @"Notificações"}, {"popups", @"Pop-ups e redirecionamentos"}, {"sound", @"Som"},
+      {"clipboard", @"Área de transferência"}, {"downloads", @"Downloads automáticos"},
+      {"javascript", @"JavaScript"}, {"cookies", @"Cookies"},
+  };
+  for (const auto& [k, name] : kNames) {
+    if (kind == k) return name;
+  }
+  return @(kind.c_str());
+}
+// "https://meet.google.com:443" → "meet.google.com"; "[*.]example.com" → "*.example.com".
+static NSString* SiteName(const std::string& pattern) {
+  NSString* s = @(pattern.c_str());
+  for (NSString* prefix in @[ @"https://", @"http://" ]) {
+    if ([s hasPrefix:prefix]) s = [s substringFromIndex:prefix.length];
+  }
+  if ([s hasSuffix:@":443"]) s = [s substringToIndex:s.length - 4];
+  return [s stringByReplacingOccurrencesOfString:@"[*.]" withString:@"*."];
+}
+static void ExceptionsListed(void* context, const AgensSiteException* list, int count) {
+  auto* out = static_cast<std::vector<std::tuple<std::string, std::string, AgensPermission>>*>(context);
+  for (int i = 0; i < count; ++i) out->emplace_back(list[i].site, list[i].kind, list[i].value);
+}
+- (CGFloat)exceptionsPage:(CGFloat)y {
+  std::vector<std::tuple<std::string, std::string, AgensPermission>> list;
+  if (_browser) agens_site_exceptions(_browser, ExceptionsListed, &list);
+  std::sort(list.begin(), list.end());
+  _exceptions.clear();
+  if (list.empty()) {
+    return [self info:@"Nenhuma exceção neste ato" detail:@"Quando você permite ou bloqueia algo para um site, aparece aqui." note:@"" y:y];
+  }
+  for (const auto& [site, kind, value] : list) {
+    const NSInteger tag = _exceptions.size();
+    _exceptions.emplace_back(site, kind);
+    NSPopUpButton* popup = [[NSPopUpButton alloc] init];
+    popup.controlSize = NSControlSizeSmall;
+    popup.font = [NSFont systemFontOfSize:NSFont.smallSystemFontSize];
+    const BOOL ask = kind == "camera" || kind == "microphone" || kind == "location" ||
+                     kind == "notifications" || kind == "clipboard" || kind == "downloads";
+    if (ask) {
+      [popup addItemWithTitle:@"Perguntar"];
+      popup.lastItem.tag = kAgensAsk;
+    }
+    [popup addItemWithTitle:@"Permitir"];
+    popup.lastItem.tag = kAgensAllow;
+    [popup addItemWithTitle:@"Bloquear"];
+    popup.lastItem.tag = kAgensBlock;
+    if (kind == "cookies") {
+      [popup addItemWithTitle:@"Só nesta sessão"];
+      popup.lastItem.tag = kAgensSessionOnly;
+    }
+    [popup selectItemWithTag:value];
+    popup.identifier = [NSString stringWithFormat:@"%ld", (long)tag];
+    popup.target = self;
+    popup.action = @selector(setException:);
+    [popup sizeToFit];
+    NSView* box = [self buttons:@[ [self small:@"Tirar" action:@selector(removeException:) tag:tag] ]];
+    NSView* both = [[NSView alloc] initWithFrame:NSMakeRect(0, 0, NSWidth(popup.frame) + 8 + NSWidth(box.frame), MAX(NSHeight(popup.frame), NSHeight(box.frame)))];
+    popup.frame = NSMakeRect(0, (NSHeight(both.frame) - NSHeight(popup.frame)) / 2, NSWidth(popup.frame), NSHeight(popup.frame));
+    box.frame = NSMakeRect(NSMaxX(popup.frame) + 8, (NSHeight(both.frame) - NSHeight(box.frame)) / 2, NSWidth(box.frame), NSHeight(box.frame));
+    [both addSubview:popup];
+    [both addSubview:box];
+    y = [self option:SiteName(site) detail:KindName(kind) control:both y:y];
+  }
+  return y;
+}
+- (void)setException:(NSPopUpButton*)popup {
+  const size_t i = popup.identifier.integerValue;
+  if (!_browser || i >= _exceptions.size()) return;
+  agens_site_exception_set(_browser, _exceptions[i].first.c_str(), _exceptions[i].second.c_str(),
+                           (AgensPermission)popup.selectedItem.tag);
+}
+- (void)removeException:(NSButton*)button {
+  const size_t i = button.tag;
+  if (!_browser || i >= _exceptions.size()) return;
+  agens_site_exception_remove(_browser, _exceptions[i].first.c_str(), _exceptions[i].second.c_str());
+  [self showSection:@"excecoes"];
+}
