+// Grafite (dark) tokens from docs/visual.md.
+static NSColor* Hex(uint32_t rgb, CGFloat a = 1) {
+  return [NSColor colorWithSRGBRed:((rgb >> 16) & 255) / 255.0
+                             green:((rgb >> 8) & 255) / 255.0
+                              blue:(rgb & 255) / 255.0
+                             alpha:a];
+}
