@@ -0,0 +1,345 @@
+// SugiyamaLabs: ad blocker levels, daily list update and the in-app rules converter.
+// See docs/bloqueador.md in our repository.
+
+#include "chrome/browser/sugiyamalabs/adblock.h"
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/process/launch.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/subresource_filter/content/browser/ruleset_service.h"
+#include "components/subresource_filter/core/browser/subresource_filter_features.h"
+#include "components/subresource_filter/tools/ruleset_converter/ruleset_converter.h"
+#include "net/base/load_flags.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace sugiyamalabs::adblock {
+namespace {
+
+// The only host the browser talks to for lists.
+constexpr char kDefaultListsUrl[] =
+    "https://raw.githubusercontent.com/SugiyamaLabs/browser/main/chromium/adblock/lists/";
+constexpr char kConvertSwitch[] = "agens-convert-rules";
+constexpr char kConvertInputsSwitch[] = "agens-convert-inputs";
+// The largest download SimpleURLLoader::DownloadToString allows. shortcut: EasyList is 2 MB today;
+// move to DownloadToFile if a list nears 5 MB.
+constexpr size_t kMaxListBytes = 5 * 1024 * 1024;
+
+// Level 1 uses the first two lists, level 2 all of them.
+constexpr const char* kLists[] = {"easylist.txt", "easyprivacy.txt", "ublock-filters.txt",
+                                  "ublock-privacy.txt", "easylist-cookie.txt"};
+constexpr size_t kListCount[] = {0, 2, 5};
+
+bool g_updating = false;
+base::Time g_last_attempt;
+
+base::FilePath AdblockDir() {
+  base::FilePath dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &dir);
+  return dir.AppendASCII("AgensAdblock");
+}
+
+// Rules for `level`: the ones built from downloaded lists if there are any, else the app's.
+struct Pick {
+  base::FilePath path;
+  std::string version;
+};
+Pick PickRules(int level) {
+  const std::string name = "rules_" + base::NumberToString(level);
+  base::FilePath path = AdblockDir().AppendASCII(name);
+  base::File::Info info;
+  if (!base::GetFileInfo(path, &info)) {
+    base::PathService::Get(chrome::DIR_RESOURCES, &path);
+    path = path.AppendASCII("adblock_rules_" + base::NumberToString(level));
+    if (!base::GetFileInfo(path, &info)) {
+      return {};
+    }
+  }
+  return {path, base::NumberToString(level) + "-" + base::NumberToString(info.size) + "-" +
+                    base::NumberToString(info.last_modified.InMillisecondsSinceUnixEpoch())};
+}
+
+void ApplyLevel() {
+  const int level = GetLevel();
+  subresource_filter::SetNativeAdblockActive(level > 0);
+  if (level == 0) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&PickRules, level), base::BindOnce([](Pick pick) {
+        subresource_filter::RulesetService* service =
+            g_browser_process ? g_browser_process->subresource_filter_ruleset_service()
+                              : nullptr;
+        if (!service || pick.version.empty()) {
+          return;
+        }
+        subresource_filter::UnindexedRulesetInfo info;
+        info.content_version = std::move(pick.version);
+        info.ruleset_path = pick.path;
+        service->IndexAndStoreAndPublishRulesetIfNeeded(info);
+      }));
+}
+
+// --- update ---------------------------------------------------------------------------------
+
+using DoneCallback = base::OnceCallback<void(bool, std::string)>;
+
+void Finish(DoneCallback done, bool ok, std::string message) {
+  g_updating = false;
+  if (ok) {
+    g_browser_process->local_state()->SetTime(kLastUpdatePref, base::Time::Now());
+    ApplyLevel();
+  }
+  if (done) {
+    std::move(done).Run(ok, std::move(message));
+  }
+}
+
+bool ConvertInChild(const std::vector<base::FilePath>& inputs, const base::FilePath& output) {
+  base::FilePath exe;
+  if (!base::PathService::Get(base::FILE_EXE, &exe)) {
+    return false;
+  }
+  std::vector<std::string> paths;
+  for (const auto& p : inputs) {
+    paths.push_back(p.AsUTF8Unsafe());
+  }
+  base::CommandLine command(exe);
+  command.AppendSwitchPath(kConvertSwitch, output);
+  command.AppendSwitchASCII(kConvertInputsSwitch, base::JoinString(paths, ","));
+  base::Process process = base::LaunchProcess(command, base::LaunchOptions());
+  int code = -1;
+  if (!process.IsValid() || !process.WaitForExitWithTimeout(base::Minutes(3), &code)) {
+    process.Terminate(1, false);
+    return false;
+  }
+  return code == 0 && base::PathExists(output);
+}
+
+// Writes the downloaded lists and the two rulesets built from them next to each other, then
+// swaps them in, so a failure in the middle keeps the previous ones. Returns "" on success.
+std::string InstallBlocking(std::map<std::string, std::string> bodies) {
+  const base::FilePath dir = AdblockDir();
+  const base::FilePath staging = dir.AppendASCII("staging");
+  base::DeletePathRecursively(staging);
+  if (!base::CreateDirectory(staging) || !base::CreateDirectory(dir.AppendASCII("lists"))) {
+    return "Não foi possível gravar as listas.";
+  }
+  for (const auto& [name, body] : bodies) {
+    if (!base::WriteFile(staging.AppendASCII(name), body)) {
+      base::DeletePathRecursively(staging);
+      return "Não foi possível gravar as listas.";
+    }
+  }
+  for (int level = 1; level <= 2; ++level) {
+    std::vector<base::FilePath> inputs;
+    for (size_t i = 0; i < kListCount[level]; ++i) {
+      inputs.push_back(staging.AppendASCII(kLists[i]));
+    }
+    if (!ConvertInChild(inputs, staging.AppendASCII("rules_" + base::NumberToString(level)))) {
+      base::DeletePathRecursively(staging);
+      return "Não foi possível converter as listas; as anteriores continuam valendo.";
+    }
+  }
+  for (const char* name : kLists) {
+    base::ReplaceFile(staging.AppendASCII(name), dir.AppendASCII("lists").AppendASCII(name),
+                      nullptr);
+  }
+  for (int level = 1; level <= 2; ++level) {
+    const std::string name = "rules_" + base::NumberToString(level);
+    base::ReplaceFile(staging.AppendASCII(name), dir.AppendASCII(name), nullptr);
+  }
+  base::DeletePathRecursively(staging);
+  return std::string();
+}
+
+struct Download {
+  std::unique_ptr<network::SimpleURLLoader> loader;
+  std::map<std::string, std::string> bodies;
+  DoneCallback done;
+};
+
+void FetchNext(std::unique_ptr<Download> d);
+
+void OnDownloaded(std::unique_ptr<Download> d, std::optional<std::string> body) {
+  const auto* headers = d->loader->ResponseInfo() ? d->loader->ResponseInfo()->headers.get()
+                                                  : nullptr;
+  // A filter list starts with "[Adblock…]" or a "!" comment; anything else (an HTML error
+  // page, an empty file) means the download is not a list.
+  if (!body || !headers || headers->response_code() != 200 || body->size() < 1024 ||
+      (body->front() != '[' && body->front() != '!')) {
+    Finish(std::move(d->done), false,
+           "Não foi possível baixar as listas; as anteriores continuam valendo.");
+    return;
+  }
+  d->bodies[kLists[d->bodies.size()]] = std::move(*body);
+  FetchNext(std::move(d));
+}
+
+void FetchNext(std::unique_ptr<Download> d) {
+  if (d->bodies.size() == std::size(kLists)) {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::WithBaseSyncPrimitives(), base::TaskPriority::BEST_EFFORT},
+        base::BindOnce(&InstallBlocking, std::move(d->bodies)),
+        base::BindOnce(
+            [](DoneCallback done, std::string error) {
+              Finish(std::move(done), error.empty(),
+                     error.empty() ? "Listas atualizadas." : error);
+            },
+            std::move(d->done)));
+    return;
+  }
+  std::string base_url = kDefaultListsUrl;
+  const base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kListsUrlSwitch)) {
+    base_url = command_line->GetSwitchValueASCII(kListsUrlSwitch);
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(base_url + kLists[d->bodies.size()]);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;  // no cookies
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  net::NetworkTrafficAnnotationTag annotation = net::DefineNetworkTrafficAnnotation(
+      "agens_adblock_lists", R"(
+        semantics {
+          sender: "Ad blocker list update"
+          description:
+            "Once a day, downloads the ad blocker filter lists from the SugiyamaLabs "
+            "repository on GitHub, so blocking follows the lists without an app update."
+          trigger: "Daily, or when the person taps Atualizar agora."
+          data: "Nothing is sent: a plain GET with no cookies and no identifiers."
+          destination: OTHER
+          internal { contacts { email: "contact@sugiyamalabs.com" } }
+          user_data { type: NONE }
+          last_reviewed: "2026-11-10"
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Configurações > Bloqueador > Atualizar as listas todo dia."
+          policy_exception_justification: "Not implemented."
+        })");
+  d->loader = network::SimpleURLLoader::Create(std::move(request), annotation);
+  network::SimpleURLLoader* loader = d->loader.get();
+  loader->DownloadToString(
+      g_browser_process->system_network_context_manager()->GetSharedURLLoaderFactory().get(),
+      base::BindOnce(&OnDownloaded, std::move(d)), kMaxListBytes);
+}
+
+void MaybeAutoUpdate() {
+  if (!GetAutoUpdate() || GetLevel() == 0 || g_updating) {
+    return;
+  }
+  const base::Time now = base::Time::Now();
+  if (!GetLastUpdate().is_null() && now - GetLastUpdate() < base::Hours(24)) {
+    return;
+  }
+  if (!g_last_attempt.is_null() && now - g_last_attempt < base::Hours(6)) {
+    return;  // a failed update is retried in a few hours, not every hour
+  }
+  g_last_attempt = now;
+  UpdateNow(DoneCallback());
+}
+
+}  // namespace
+
+void RegisterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterIntegerPref(kLevelPref, 2);
+  registry->RegisterBooleanPref(kAutoUpdatePref, true);
+  registry->RegisterTimePref(kLastUpdatePref, base::Time());
+  registry->RegisterBooleanPref(kHideCookieNoticesPref, true);
+}
+
+void Start() {
+  static bool started = false;
+  if (started) {
+    return;
+  }
+  started = true;
+  static base::NoDestructor<PrefChangeRegistrar> registrar;
+  registrar->Init(g_browser_process->local_state());
+  registrar->Add(kLevelPref, base::BindRepeating(&ApplyLevel));
+  ApplyLevel();
+
+  // Never on the startup path: first check 2 minutes in (5 s with the test switch), then hourly.
+  static base::NoDestructor<base::RepeatingTimer> timer;
+  timer->Start(FROM_HERE, base::Hours(1), base::BindRepeating(&MaybeAutoUpdate));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&MaybeAutoUpdate),
+      base::CommandLine::ForCurrentProcess()->HasSwitch(kListsUrlSwitch) ? base::Seconds(5)
+                                                                         : base::Minutes(2));
+}
+
+int GetLevel() {
+  return std::clamp(g_browser_process->local_state()->GetInteger(kLevelPref), 0, 2);
+}
+void SetLevel(int level) {
+  g_browser_process->local_state()->SetInteger(kLevelPref, std::clamp(level, 0, 2));
+}
+bool GetAutoUpdate() {
+  return g_browser_process->local_state()->GetBoolean(kAutoUpdatePref);
+}
+void SetAutoUpdate(bool enabled) {
+  g_browser_process->local_state()->SetBoolean(kAutoUpdatePref, enabled);
+}
+base::Time GetLastUpdate() {
+  return g_browser_process->local_state()->GetTime(kLastUpdatePref);
+}
+
+void UpdateNow(DoneCallback done) {
+  if (g_updating) {
+    if (done) {
+      std::move(done).Run(false, "Já está atualizando.");
+    }
+    return;
+  }
+  g_updating = true;
+  auto d = std::make_unique<Download>();
+  d->done = std::move(done);
+  FetchNext(std::move(d));
+}
+
+std::optional<int> MaybeRunRulesConverter(const base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(kConvertSwitch)) {
+    return std::nullopt;
+  }
+  logging::SetMinLogLevel(logging::LOGGING_FATAL);  // one warning per dropped rule otherwise
+  subresource_filter::RulesetConverter converter;
+  const bool ok =
+      converter.SetInputFiles(command_line.GetSwitchValueNative(kConvertInputsSwitch)) &&
+      converter.SetOutputFileUrl(command_line.GetSwitchValuePath(kConvertSwitch)) &&
+      converter.SetInputFormat("filter-list") && converter.SetOutputFormat("unindexed-ruleset") &&
+      converter.Convert();
+  return ok ? 0 : 1;
+}
+
+}  // namespace sugiyamalabs::adblock
