+pid_t g_parent = 0;
+dispatch_source_t g_parent_watch;  // kept for the life of the process
+
+void ParentGone() {
+  static bool quitting = false;
+  if (quitting) return;
+  quitting = true;
+  bridge::view::HostGone();  // its connection may linger, but it is no longer the host
+  // Nobody is left to answer a "leave this page?" dialog.
+  chrome::ExitIgnoreUnloadHandlers();
+  // shortcut: a shutdown stuck for 10 s ends hard (no clean exit); find out why if it shows up.
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC),
+                 dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                   _exit(0);
+                 });
+}
+
+// The last net under the cases handled where they start (popups and app windows are normal
+// windows, no web apps, no picture-in-picture; pickers, printing and external apps go to the
+// host): a views window goes on
+// screen only when it belongs to a DevTools window. Anything else stays hidden, with a log line
+// naming it. Hidden, never closed: whatever made it keeps running, nothing waits on its showing.
+// The top views window `window` belongs to (itself, or what it is a child of).
+views::Widget* TopWidget(NSWindow* window) {
+  NSWindow* root = window;
+  while (root.parentWindow) root = root.parentWindow;
+  views::Widget* widget = views::Widget::GetWidgetForNativeWindow(gfx::NativeWindow(root));
+  while (widget && widget->parent()) widget = widget->parent();
+  return widget;
+}
+
+// The DevTools window `window` is or belongs to; null for anything else.
+BrowserWindowInterface* DevToolsOf(NSWindow* window) {
+  views::Widget* widget = window ? TopWidget(window) : nullptr;
+  BrowserWindowInterface* browser =
+      widget ? GlobalBrowserCollection::GetInstance()->FindBrowserWithWindow(widget->GetNativeWindow()) : nullptr;
+  return browser && browser->GetType() == BrowserWindowInterface::TYPE_DEVTOOLS ? browser : nullptr;
+}
+
+BOOL MayOrderIn(NSWindow* window) {
+  if (DevToolsOf(window)) return YES;
+  views::Widget* widget = TopWidget(window);
+  LOG(ERROR) << "agens: kept off screen (embedded): "
+               << (widget && !widget->GetName().empty() ? widget->GetName()
+                                                         : base::SysNSStringToUTF8(NSStringFromClass(window.class)));
+  return NO;
+}
+
+// Page features whose only UI is a system window or panel the engine cannot keep off screen
+// (the share sheet, the color sampler) or a dialog on a window nobody sees (payment): not
+// available in the page, so sites see them missing instead of a request that never ends.
+// shortcut: refused for now; the host could show them later (ui.ask), as it does other requests.
+// PagePopup: the date, time and color pickers are drawn in a popup window of their own; without
+// it they go to the browser, and so to the host (ui.ask date and color), while date fields keep
+// their inline segments (chrome_client_impl.cc). Passkeys (WebAuth) go to the host too.
+constexpr char kOffBlinkFeatures[] = "PaymentRequest,WebShare,EyeDropperAPI,DocumentPictureInPictureAPI,PagePopup";
+
+#if !defined(OFFICIAL_BUILD)
+// Gates only (tools/gates/embutido.sh): SIGUSR2 makes the engine quit the ways a person can, with no
+// system input. ⌘Q as the menu bar takes it from the key window (a built event handed to the main
+// menu, never posted), then IDC_EXIT. Both must be refused (RefuseQuit).
+// SIGUSR1: a quit Apple event sent to itself (dispatched in process, as Activity Monitor's or
+// osascript's would arrive), first with no reason (refused), then with kAEReallyLogOut (quits).
+constexpr char kTestQuitSignalSwitch[] = "agens-test-quit-signal";
+dispatch_source_t g_test_quit;
+dispatch_source_t g_test_system_quit;
+
+void SendQuitToSelf(std::optional<OSType> reason) {
+  NSAppleEventDescriptor* quit =
+      [NSAppleEventDescriptor appleEventWithEventClass:kCoreEventClass
+                                               eventID:kAEQuitApplication
+                                      targetDescriptor:[NSAppleEventDescriptor currentProcessDescriptor]
+                                              returnID:kAutoGenerateReturnID
+                                         transactionID:kAnyTransactionID];
+  if (reason) {
+    [quit setAttributeDescriptor:[NSAppleEventDescriptor descriptorWithEnumCode:*reason] forKeyword:kAEQuitReason];
+  }
+  AppleEvent reply = {typeNull, nullptr};
+  AESendMessage(quit.aeDesc, &reply, kAENoReply, kAEDefaultTimeout);
+  AEDisposeDesc(&reply);
+}
+
+void WatchTestQuitSignal() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(kTestQuitSignalSwitch)) return;
+  signal(SIGUSR2, SIG_IGN);  // the source below gets it instead of the default (terminate)
+  g_test_quit = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, SIGUSR2, 0, dispatch_get_main_queue());
+  dispatch_source_set_event_handler(g_test_quit, ^{
+    NSEvent* q = [NSEvent keyEventWithType:NSEventTypeKeyDown
+                                  location:NSZeroPoint
+                             modifierFlags:NSEventModifierFlagCommand
+                                 timestamp:0
+                              windowNumber:NSApp.keyWindow.windowNumber
+                                   context:nil
+                                characters:@"q"
+                charactersIgnoringModifiers:@"q"
+                                 isARepeat:NO
+                                   keyCode:12];  // kVK_ANSI_Q
+    LOG(ERROR) << "agens: test quit: cmd-q to the main menu: "
+                 << ([NSApp.mainMenu performKeyEquivalent:q] ? "taken" : "not taken");
+    LOG(ERROR) << "agens: test quit: IDC_EXIT";
+    chrome::AttemptUserExit();
+  });
+  dispatch_resume(g_test_quit);
+
+  signal(SIGUSR1, SIG_IGN);
+  g_test_system_quit = dispatch_source_create(DISPATCH_SOURCE_TYPE_SIGNAL, SIGUSR1, 0, dispatch_get_main_queue());
+  dispatch_source_set_event_handler(g_test_system_quit, ^{
+    LOG(ERROR) << "agens: test quit: quit Apple event, no reason";
+    SendQuitToSelf(std::nullopt);
+    // Later, so the first is handled on its own (sent to itself, each waits for the run loop).
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+      LOG(ERROR) << "agens: test quit: quit Apple event, log out";
+      SendQuitToSelf(kAEReallyLogOut);
+    });
+  });
+  dispatch_resume(g_test_system_quit);
+}
+#endif
+
+bool g_powering_off = false;  // NSWorkspaceWillPowerOffNotification fired: log out, restart, shut down
+
+// A quit from the system (log out, restart, shut down) must go through, or macOS shows "cancelled
+// log out" and stops there: which app gets the quit first is not up to the host.
+bool SystemQuit() {
+  if (g_powering_off) return true;
+  NSAppleEventDescriptor* event = NSAppleEventManager.sharedAppleEventManager.currentAppleEvent;
+  if (event.eventClass != kCoreEventClass || event.eventID != kAEQuitApplication) return false;
+  NSAppleEventDescriptor* why = [event attributeDescriptorForKeyword:kAEQuitReason]
+                                    ?: [event paramDescriptorForKeyword:kAEQuitReason];
+  switch (why.enumCodeValue) {
+    case kAELogOut:
+    case kAEReallyLogOut:
+    case kAEShowRestartDialog:
+    case kAEShowShutdownDialog:
+    case kAERestart:
+    case kAEShutDown:
+      return true;
+    default:
+      return false;
+  }
+}
+
+}  // namespace
+
+// At a quit that goes through, while the tabs still live: for each ato with windows, what
+// view.restore will bring back, for the host's "Continuar de onde parou" card (atos.list, beside
+// "restorable"): restorable_tabs, restorable_preview (the first 3, {title, url}) and closed_at.
+// From the live tabs: the session file cannot be read safely without loading the ato (its reader
+// is private to components/sessions and its init deletes files). The person's tabs only, as the
+// session marks them for restore (kAgentTabKey, session_restore.cc), and only tabs with a page other than the new tab page.
+
+void RememberRestorableTabs() {
+  if (!IsEmbedded()) return;
+  constexpr size_t kPreviewTabs = 3, kTitleChars = 120, kUrlBytes = 2048;
+  base::flat_map<std::string, base::DictValue> summaries;
+  GlobalBrowserCollection::GetInstance()->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL || browser->GetProfile()->IsOffTheRecord()) {
+      return true;
+    }
+    base::DictValue& summary = summaries[browser->GetProfile()->GetBaseName().AsUTF8Unsafe()];
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int i = 0; i < model->count(); ++i) {
+      content::WebContents* contents = model->GetWebContentsAt(i);
+      content::NavigationEntry* entry = contents->GetController().GetLastCommittedEntry();
+      if (AgensControlled::Is(contents) || !entry || entry->IsInitialEntry()) continue;
+      // A blank "Nova aba" (the one a window opens with) is nothing to continue.
+      if (entry->GetVirtualURL().SchemeIs(content::kChromeUIScheme) &&
+          entry->GetVirtualURL().host() == chrome::kChromeUINewTabHost) {
+        continue;
+      }
+      const int tabs = summary.FindInt("restorable_tabs").value_or(0);
+      summary.Set("restorable_tabs", tabs + 1);
+      base::ListValue* preview = summary.EnsureList("restorable_preview");
+      if (preview->size() >= kPreviewTabs) continue;
+      std::u16string title = contents->GetTitle();
+      if (title.size() > kTitleChars) {
+        title.resize(kTitleChars);
+        if (CBU16_IS_LEAD(title.back())) title.pop_back();  // never half a character
+      }
+      base::DictValue tab;
+      tab.Set("title", base::UTF16ToUTF8(title));
+      tab.Set("url", entry->GetVirtualURL().spec().substr(0, kUrlBytes));  // a spec is ASCII
+      preview->Append(std::move(tab));
+    }
+    return true;
+  });
+  const double now = std::floor(base::Time::Now().InSecondsFSinceUnixEpoch());
+  ScopedDictPrefUpdate update(g_browser_process->local_state(), AgensWindow::kAtosPref);
+  for (auto& [ato, summary] : summaries) {
+    base::DictValue* extras = update->EnsureDict(ato);
+    extras->Set("restorable_tabs", summary.FindInt("restorable_tabs").value_or(0));
+    base::ListValue* preview = summary.FindList("restorable_preview");
+    extras->Set("restorable_preview", preview ? std::move(*preview) : base::ListValue());
+    extras->Set("closed_at", now);
+  }
+}
+
+bool RefuseQuit() {
+  if (!IsEmbedded()) return false;
+  if (browser_shutdown::HasShutdownStarted()) {
+    RememberRestorableTabs();
+    return false;
+  }
+  if (SystemQuit()) {
+    LOG(ERROR) << "agens: quit allowed (embedded): the system is logging out, restarting or shutting down";
+    RememberRestorableTabs();
+    return false;
+  }
+  BrowserWindowInterface* devtools = DevToolsOf(NSApp.keyWindow);
+  LOG(ERROR) << "agens: quit refused (embedded): the host decides when the engine quits"
+               << (devtools ? "; closing the DevTools window instead" : "");
+  if (devtools) devtools->GetWindow()->Close();  // what ⌘W does there
+  return true;
+}
+
+bool DevToolsWindowMayRun(int command_id) {
+  switch (command_id) {
+    case IDC_CLOSE_TAB:
+    case IDC_CLOSE_WINDOW:
+    case IDC_EXIT:  // goes on to RefuseQuit, which closes the window
+    case IDC_MINIMIZE_WINDOW:
+    case IDC_FULLSCREEN:
+    case IDC_ZOOM_PLUS:
+    case IDC_ZOOM_MINUS:
+    case IDC_ZOOM_NORMAL:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// agens.atos[<folder>].restorable (Local State, beside the ato's other extras): its last session
+// can come back with view.restore. Read without loading the ato's profile.
+bool IsRestorable(const std::string& ato) {
+  const base::DictValue* extras = g_browser_process->local_state()->GetDict(AgensWindow::kAtosPref).FindDict(ato);
+  return extras && extras->FindBool("restorable").value_or(false);
+}
+
+bool TakeRestorable(const std::string& ato) {
+  if (!IsRestorable(ato)) return false;
+  ScopedDictPrefUpdate update(g_browser_process->local_state(), AgensWindow::kAtosPref);
+  base::DictValue* extras = update->EnsureDict(ato);
+  for (const char* key : {"restorable", "restorable_tabs", "restorable_preview", "closed_at"}) extras->Remove(key);
+  return true;
+}
+
+void RestoreAfterCrash(Profile* initial) {
+  if (!IsEmbedded()) return;
+  // The initial profile loads in every run, so its exit type is the engine's. A clean end only
+  // comes from the host going away (it starts afresh then), so only a crash or a kill brings tabs
+  // back by itself.
+  if (ExitTypeService::GetLastSessionExitType(initial) != ExitType::kCrashed) {
+    // The atos that had windows at the normal quit become restorable, without loading them; the
+    // list is emptied so Chromium does not load them at start either (chrome_browser_main.cc).
+    PrefService* local = g_browser_process->local_state();
+    ProfileManager* manager = g_browser_process->profile_manager();
+    const base::ListValue last = local->GetList(prefs::kProfilesLastActive).Clone();
+    for (const base::Value& ato : last) {
+      if (ato.is_string() && manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+                                 manager->user_data_dir().Append(base::FilePath::FromUTF8Unsafe(ato.GetString())))) {
+        // Only with tabs of the person to bring back (the summary of the quit, RememberRestorableTabs):
+        // an ato that had only an agent's tabs offers nothing, and its older session is gone.
+        ScopedDictPrefUpdate update(local, AgensWindow::kAtosPref);
+        base::DictValue* extras = update->EnsureDict(ato.GetString());
+        if (extras->FindInt("restorable_tabs").value_or(1) > 0) {
+          extras->Set("restorable", true);
+        } else {
+          for (const char* key : {"restorable", "restorable_tabs", "restorable_preview", "closed_at"}) extras->Remove(key);
+        }
+      }
+    }
+    local->ClearPref(prefs::kProfilesLastActive);
+    return;
+  }
+  // Once the main loop runs: profiles load here, not inside another profile's init. Only the atos
+  // that had windows when the engine died.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce([] {
+    if (browser_shutdown::HasShutdownStarted()) return;
+    for (Profile* profile : ProfileManager::GetLastOpenedProfiles()) {
+      LOG(ERROR) << "agens: restoring the tabs of " << profile->GetBaseName().value() << " after a crash";
+      TakeRestorable(profile->GetBaseName().AsUTF8Unsafe());  // an older saved session is gone now
+      SessionRestore::RestoreSession(profile, nullptr, SessionRestore::RESTORE_BROWSER, StartupTabs());
+    }
+  }));
+}
+
+bool IsEmbedded() {
+  static const bool embedded = base::CommandLine::ForCurrentProcess()->HasSwitch(kEmbeddedSwitch);
+  return embedded;
+}
+
+pid_t EmbeddedParent() {
+  return g_parent;
+}
+
+bool AcceptUnsignedClients() {
+#if defined(OFFICIAL_BUILD)
+  return false;
+#else
+  return IsEmbedded() && base::CommandLine::ForCurrentProcess()->HasSwitch(kAcceptUnsignedSwitch);
+#endif
+}
+
+bool EmbeddedClientAllowed(const std::string& signing_identifier) {
+  static const base::NoDestructor<std::vector<std::string>> allowed(bridge::ParseAllowedClients(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(kAllowedClientsSwitch)));
+  return IsEmbedded() && !signing_identifier.empty() && std::ranges::contains(*allowed, signing_identifier);
+}
+
+void StartEmbedded() {
+  if (!IsEmbedded()) return;
+  g_parent = getppid();
+  if (g_parent <= 1) _exit(0);  // the app that launched the engine is already gone (now launchd's)
+
+  // No window of our own: tabs live in browser windows that never go on screen
+  // (WebUIBrowserWindow::Show), and the host shows them. Popups open as tabs (browser_navigator.cc);
+  // a DevTools window the person asks for is the one exception.
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  command_line->AppendSwitch(switches::kNoStartupWindow);  // also no session restore at startup
+  command_line->AppendSwitch(switches::kNoFirstRun);
+  std::string off = command_line->GetSwitchValueASCII(switches::kDisableBlinkFeatures);
+  command_line->AppendSwitchASCII(switches::kDisableBlinkFeatures,
+                                  off.empty() ? kOffBlinkFeatures : off + "," + kOffBlinkFeatures);
+  [NativeWidgetMacNSWindow setOrderInFilter:^BOOL(NSWindow* window) {
+    return MayOrderIn(window);
+  }];
+  // Our own onboarding window (AgensFirstRun, ui/chrome_mac.mm) is the stand-alone product's. A
+  // volatile domain: it lasts for this process and is never saved to the shared defaults.
+  NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+  NSMutableDictionary* arguments = [[defaults volatileDomainForName:NSArgumentDomain] mutableCopy]
+                                       ?: [NSMutableDictionary dictionary];
+  arguments[@"AgensFirstRunDone"] = @YES;
+  [defaults removeVolatileDomainForName:NSArgumentDomain];
+  [defaults setVolatileDomain:arguments forName:NSArgumentDomain];
+  // Before NSApp finishes launching, so the Dock never shows the engine.
+  [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+
+  // On the main queue: it runs once the UI thread's run loop does, where quitting is safe.
+  g_parent_watch = dispatch_source_create(DISPATCH_SOURCE_TYPE_PROC, static_cast<uintptr_t>(g_parent),
+                                          DISPATCH_PROC_EXIT, dispatch_get_main_queue());
+  dispatch_source_set_event_handler(g_parent_watch, ^{
+    ParentGone();
+  });
+  dispatch_resume(g_parent_watch);
+  if (getppid() != g_parent) _exit(0);  // it went away before the watch was set
+  [NSWorkspace.sharedWorkspace.notificationCenter addObserverForName:NSWorkspaceWillPowerOffNotification
+                                                              object:nil
+                                                               queue:nil
+                                                          usingBlock:^(NSNotification*) {
+                                                            g_powering_off = true;
+                                                          }];
+#if !defined(OFFICIAL_BUILD)
+  WatchTestQuitSignal();
+#endif
+}
+
+}  // namespace agens
