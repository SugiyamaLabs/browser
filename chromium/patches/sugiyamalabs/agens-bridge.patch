+                                                    others.lastObject];
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = [NSString stringWithFormat:@"Compartilhar os cookies de %@?", name];
+  NSString* what = others.count
+                       ? [NSString stringWithFormat:@"Os logins de %@ passam a valer também em %@, e os deles em %@.", name, list, name]
+                       : [NSString stringWithFormat:@"Por enquanto nada é compartilhado: os logins de %@ só passam a valer em outro ato quando ele também ligar esta opção.", name];
+  alert.informativeText = [what stringByAppendingString:
