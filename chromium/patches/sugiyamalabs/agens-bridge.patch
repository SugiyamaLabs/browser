+void ShowApprovalSheet(const std::string& title,
+                       const std::string& detail,
+                       bool offer_always,
+                       base::OnceCallback<void(AgensApprovalAnswer)> done) {
+  // The most recently active window that isn't closing and isn't already asking.
+  BrowserWindowInterface* browser = nullptr;
+  NativeShellView* shell = nullptr;
+  if (IsNativeShellEnabled()) {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation([&](BrowserWindowInterface* b) {
+      if (b->IsDeleteScheduled() || !b->GetWindow() || b->GetTabStripModel()->closing_all()) return true;
+      views::Widget* widget = views::Widget::GetWidgetForNativeWindow(b->GetWindow()->GetNativeWindow());
+      if (!widget || widget->IsClosed()) return true;
+      auto* s = views::AsViewClass<NativeShellView>(widget->GetRootView()->GetViewByID(NativeShellView::kViewId));
+      if (!s || !s->window()->ui || s->window()->approval_answer) return true;
+      browser = b;
+      shell = s;
+      return false;
+    });
+  }
+  if (!shell) {
+    std::move(done).Run(kAgensApprovalDeny);
+    return;
+  }
+  browser->GetWindow()->Activate();  // the sheet must be seen to be answered
+  shell->window()->approval_answer = std::move(done);
+  agens_ui_approval_prompt(shell->window()->ui, title.c_str(), detail.c_str(), offer_always);
+}
