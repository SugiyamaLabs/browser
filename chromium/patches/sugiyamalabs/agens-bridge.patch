+// Where a controlled tab's dialog goes when the agent doesn't hold it: the browser's own, or,
+// embedded, the host's (ui.ask).
+content::JavaScriptDialogManager* NormalDialogs(content::WebContents* contents) {
+  if (content::JavaScriptDialogManager* host = agens::EmbeddedDialogManager()) return host;
+  return javascript_dialogs::TabModalDialogManager::FromWebContents(contents);
+}
