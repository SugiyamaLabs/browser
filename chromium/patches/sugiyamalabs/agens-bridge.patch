+std::string VisibleUrl(content::WebContents* contents) {
+  const GURL& url = contents->GetVisibleURL();
+  // The new tab page has no address to show, as in the shell (AgensWindow::NotifyNow).
+  if (url.SchemeIs("chrome") &&
+      (url.host() == "newtab" || url.host() == "new-tab-page" || url.host() == "new-tab-page-third-party")) {
+    return std::string();
+  }
+  return url.spec();
+}
+
+base::DictValue TabFields(AgensWindow* window, content::WebContents* contents) {
+  base::DictValue tab;
+  tab.Set("tab", ViewTabName(NumberOf(contents)));
+  tab.Set("ato", AtoOf(window));
+  tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  tab.Set("url", VisibleUrl(contents));
+  tab.Set("loading", contents->IsLoading());
+  tab.Set("audible", contents->IsCurrentlyAudible());
+  tab.Set("can_back", contents->GetController().CanGoBack());
+  tab.Set("can_forward", contents->GetController().CanGoForward());
+  if (const AgensControlled* controlled = AgensControlled::FromWebContents(contents)) {
+    tab.Set("control", ControlFields(*controlled));
+  }
+  return tab;
+}
