+// "Você quis dizer …?": the nearest host from this ato's history (page_tools.h LooksLikeTypo).
+static void HostsListed(void* context, const AgensVisit* visits, int count) {
+  NSMutableOrderedSet<NSString*>* hosts = [NSMutableOrderedSet orderedSet];
+  for (int i = 0; i < count; ++i) {
+    NSString* host = SiteHost(@(visits[i].url));
+    if (host.length) [hosts addObject:host];
+  }
+  [(__bridge AgensChrome*)context suggestFrom:hosts.array];
+}
+- (void)suggestFor:(NSString*)host {
+  _notFoundHost = host;
+  [_error notFound:host suggestion:_notFoundSuggestion && [_notFoundFor isEqualToString:host] ? _notFoundSuggestion : nil];
+  if (_window && ![_notFoundFor isEqualToString:host]) {
+    _notFoundFor = host;
+    _notFoundSuggestion = nil;
+    agens_history(_window, "", HostsListed, (__bridge void*)self);
+  }
+}
+- (void)suggestFrom:(NSArray<NSString*>*)hosts {
+  NSString* typed = _notFoundFor;
+  NSString* best = nil;
+  int bestD = 99;
+  for (NSString* h in hosts) {
+    if (!agens::ui::LooksLikeTypo(typed.UTF8String, h.UTF8String)) continue;
+    const int d = agens::ui::EditDistance(typed.UTF8String, h.UTF8String);
+    if (d < bestD) best = h, bestD = d;
+  }
+  _notFoundSuggestion = best;
+  if (!_error.hidden && [_notFoundHost isEqualToString:typed]) [_error notFound:typed suggestion:best];
+}
