+bool MediaDevicesManager::AudioDeviceListenerNeeded() const {
+  for (const auto& [id, request] : subscriptions_) {
+    if (request.subscribe_types[static_cast<size_t>(
+            MediaDeviceType::kMediaAudioInput)] ||
+        request.subscribe_types[static_cast<size_t>(
+            MediaDeviceType::kMediaAudioOutput)]) {
+      return true;
+    }
+  }
+  // An open microphone needs device-removal notifications.
+  MediaStreamManager* msm = MediaStreamManager::GetInstance();
+  return msm && msm->audio_input_device_manager() &&
+         msm->audio_input_device_manager()->HasOpenedDevices();
+}
+
+void MediaDevicesManager::MaybeScheduleReleaseAudioDeviceListener() {
+  CHECK_CURRENTLY_ON(BrowserThread::IO, base::NotFatalUntil::M155);
+  if (!audio_service_device_listener_ ||
+      !base::FeatureList::IsEnabled(features::kAudioServiceIdleRelease) ||
+      release_audio_device_listener_timer_.IsRunning()) {
+    return;
+  }
+  release_audio_device_listener_timer_.Start(
+      FROM_HERE, features::kAudioServiceIdleTimeout.Get(),
+      base::BindOnce(&MediaDevicesManager::OnReleaseAudioDeviceListenerTimer,
+                     base::Unretained(this)));
+}
+
+void MediaDevicesManager::OnReleaseAudioDeviceListenerTimer() {
+  CHECK_CURRENTLY_ON(BrowserThread::IO, base::NotFatalUntil::M155);
+  if (AudioDeviceListenerNeeded()) {
+    // shortcut: no signal when the last subscriber or microphone goes away
+    // here, so check again one period later.
+    MaybeScheduleReleaseAudioDeviceListener();
+    return;
+  }
+  SendLogMessage("Releasing the audio service device listener.");
+  // Drops the cache too: the next enumeration asks the (relaunched) service.
+  StopMonitoring(DeviceStopMonitoringMode::kStopAudio);
+}
