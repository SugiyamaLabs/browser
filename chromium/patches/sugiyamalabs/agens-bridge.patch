+// A tab the session opened. Marks it while it lives, and unmarks it when the session lets go.
+class Tab : public content::WebContentsObserver {
+ public:
+  // The session fills the mark's text (Sync).
+  Tab(uint64_t connection, std::string id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), id(std::move(id)), page(contents), connection_(connection) {
+    AgensControlled::CreateForWebContents(contents);
+    AgensControlled* mark = AgensControlled::FromWebContents(contents);
+    mark->stop = base::BindRepeating(&StopByUser, connection);
+    mark->take_over = base::BindRepeating(&Pause, connection);
+    mark->hand_back = base::BindRepeating(&Resume, connection);
+    mark->dialogs = Dialogs();
+    // The agent's cursor on the pill's page: where it last clicked or hovered.
+    page.on_pointer = base::BindRepeating(
+        [](content::WebContents* contents, gfx::PointF point) {
+          if (AgensControlled* mark = AgensControlled::FromWebContents(contents)) {
+            mark->cursor_x = point.x();
+            mark->cursor_y = point.y();
+            contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+          }
+        },
+        contents);
+    // Keeps rendering while in the background: input, screenshots and the accessibility tree work
+    // on a tab that isn't the active one.
+    capture_ = contents->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+                                                /*is_activity=*/false);
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);  // the shell redraws it
+  }
+  ~Tab() override {
+    Answer(ErrorReply(&waiting_id_, kFailed, "the tab is no longer controlled"));
+    ReleaseDialog();  // the tab stays open: its dialog goes to the person
+    if (content::WebContents* contents = web_contents()) {
+      BlockExtensions(false);
+      contents->RemoveUserData(AgensControlled::UserDataKey());
+      contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+    }
+  }
+
+  const std::string id;  // "t1", "t2"… for this session
+  Page page;
+
+  // Answers `request_id` with {tab} once `navigation_id` finishes (or kNavigationWait passes);
+  // kNextNavigation: the next one of the main frame to finish (history and reload give no handle).
+  static constexpr int64_t kNextNavigation = -1;
+  void WaitFor(int64_t navigation_id, base::Value request_id, ReplyCallback reply) {
+    AnswerOk();  // an earlier wait: its navigation was replaced by this one
+    waiting_navigation_ = navigation_id;
+    waiting_id_ = std::move(request_id);
+    waiting_reply_ = std::move(reply);
+    waiting_timer_.Start(FROM_HERE, kNavigationWait, base::BindOnce(&Tab::AnswerOk, base::Unretained(this)));
+  }
+  void AnswerOk() {
+    base::DictValue result;
+    result.Set("tab", id);
+    Answer(OkReply(waiting_id_, std::move(result)));
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (waiting_reply_ && (handle->GetNavigationId() == waiting_navigation_ ||
+                           (waiting_navigation_ == kNextNavigation && handle->IsInPrimaryMainFrame()))) {
+      AnswerOk();  // a failed load is ok too
+    }
+  }
+  void WebContentsDestroyed() override;
+  void RenderFrameCreated(content::RenderFrameHost* frame) override {
+    if (extensions_blocked_) TellFrame(frame);  // a new frame (another process, a new document) starts unblocked
+  }
+
+  // host.settings' agent_extensions off: no extension script or CSS in any of the tab's frames
+  // (the renderer checks it before each injection), and the mark tells the rest of the browser.
+  void BlockExtensions(bool block) {
+    if (AgensControlled* mark = AgensControlled::FromWebContents(web_contents())) mark->extensions_blocked = block;
+    if (block == extensions_blocked_) return;
+    extensions_blocked_ = block;
+    web_contents()->ForEachRenderFrameHost([this](content::RenderFrameHost* frame) { TellFrame(frame); });
+  }
+
+  bool HasDialog() const { return !dialogs_.empty(); }
+  // Holds `dialog` behind any already held (up to kMaxHeldDialogs; past that it's dismissed) and
+  // tells the client; the ops waiting on this tab can't run while one is open.
+  void Hold(HeldDialog dialog) {
+    if (dialogs_.size() >= kMaxHeldDialogs) return std::move(dialog.done).Run(false, std::u16string());
+    base::DictValue fields;
+    fields.Set("tab", id);
+    fields.Set("type", dialog.type);
+    fields.Set("message", ClipChars(base::UTF16ToUTF8(dialog.message), kMaxDialogChars));
+    dialogs_.push_back(std::move(dialog));
+    page.FailWaiting(kDialogOpen, "a dialog is open: answer it with page.dialog");
+    SendEventTo(connection_, "page.dialog", std::move(fields));
+  }
+  // The agent's answer to the oldest (page.dialog), or content closing it (accept false). False
+  // when none.
+  bool AnswerDialog(bool accept, const std::u16string* text) {
+    if (dialogs_.empty()) return false;
+    HeldDialog dialog = std::move(dialogs_.front());
+    dialogs_.pop_front();
+    std::move(dialog.done).Run(accept, accept ? (text ? *text : dialog.default_prompt) : std::u16string());
+    return true;
+  }
+  // Content cancels them all (a navigation, the tab closing).
+  void DismissDialogs() {
+    while (AnswerDialog(false, nullptr)) {
+    }
+  }
+  // The oldest to the person, as the browser shows any dialog ("Assumir", or the session let go);
+  // the browser shows one at a time, so the newer ones are dismissed.
+  void ReleaseDialog() {
+    if (dialogs_.empty()) return;
+    HeldDialog dialog = std::move(dialogs_.front());
+    dialogs_.pop_front();
+    DismissDialogs();
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(dialog.frame);
+    content::JavaScriptDialogManager* normal = web_contents() ? NormalDialogs(web_contents()) : nullptr;
+    if (!frame || !normal) return std::move(dialog.done).Run(false, std::u16string());
+    if (dialog.type == "beforeunload") {
+      return normal->RunBeforeUnloadDialog(web_contents(), frame, dialog.is_reload, std::move(dialog.done));
+    }
+    // It may suppress the dialog (a background tab) without answering: then it's a "Cancel".
+    auto [shown, suppressed] = base::SplitOnceCallback(std::move(dialog.done));
+    bool did_suppress = false;
+    const content::JavaScriptDialogType type = dialog.type == "alert"     ? content::JAVASCRIPT_DIALOG_TYPE_ALERT
+                                               : dialog.type == "confirm" ? content::JAVASCRIPT_DIALOG_TYPE_CONFIRM
+                                                                          : content::JAVASCRIPT_DIALOG_TYPE_PROMPT;
+    normal->RunJavaScriptDialog(web_contents(), frame, type, dialog.message, dialog.default_prompt, std::move(shown),
+                                &did_suppress);
+    if (did_suppress) std::move(suppressed).Run(false, std::u16string());
+  }
+  base::WeakPtr<Tab> GetWeakPtr() { return weak_.GetWeakPtr(); }
+
+ private:
+  void Answer(std::string line) {
+    waiting_timer_.Stop();
+    if (waiting_reply_) std::move(waiting_reply_).Run(std::move(line));
+  }
+  void TellFrame(content::RenderFrameHost* frame) {
+    auto* extensions = extensions::ExtensionWebContentsObserver::GetForWebContents(web_contents());
+    // Null before the frame is live: RenderFrameCreated tells it then.
+    if (extensions::mojom::LocalFrame* local = extensions ? extensions->GetLocalFrame(frame) : nullptr) {
+      local->SetExtensionsBlocked(extensions_blocked_);
+    }
+  }
+
+  const uint64_t connection_;
+  base::ScopedClosureRunner capture_;
+  int64_t waiting_navigation_ = 0;
+  base::Value waiting_id_;
+  ReplyCallback waiting_reply_;
+  base::OneShotTimer waiting_timer_;
+  std::deque<HeldDialog> dialogs_;  // oldest first
+  bool extensions_blocked_ = false;
+  base::WeakPtrFactory<Tab> weak_{this};
+};
+
+// One app's control of one ato.
+struct Session {
+  std::string agent;   // the name shown on its tabs: control.start's agent, else the app's name
+  std::string reason;  // control.start's: the pill's default detail
+  std::string title, detail;  // control.status; empty for the defaults
+  bool paused = false;  // the person took over
+  bool passwords = false, clipboard = false, eval = false;  // control.start's allow
+  base::FilePath ato;  // the ato's profile folder
+  std::vector<std::string> shares_with;  // SharesWith(ato) when the person agreed
+  std::vector<std::unique_ptr<Tab>> tabs;
+  int next_tab = 1;
+
+  Tab* Find(const std::string& id) {
+    for (auto& tab : tabs) {
+      if (tab->id == id) return tab.get();
+    }
+    return nullptr;
+  }
+};
+std::map<uint64_t, Session>& Sessions() {
+  static base::NoDestructor<std::map<uint64_t, Session>> sessions;
+  return *sessions;
+}
+
+// The session's state onto its tabs' marks, and the shell redraws them.
+void Sync(Session& session) {
+  for (auto& tab : session.tabs) {
+    content::WebContents* contents = tab->web_contents();
+    AgensControlled* mark = contents ? AgensControlled::FromWebContents(contents) : nullptr;
+    if (!mark) continue;
+    mark->by = session.agent;
+    mark->title = session.title.empty() ? session.agent + " está usando esta aba" : session.title;
+    mark->detail = session.detail.empty() ? session.reason : session.detail;
+    mark->paused = session.paused;
+    mark->passwords = session.passwords;
+    tab->page.clipboard = session.clipboard;
+    tab->page.eval = session.eval;
+    tab->page.paused = session.paused;
+    tab->BlockExtensions(!g_browser_process->local_state()->GetBoolean(kAgentExtensionsPref));
+    contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+  }
+}
+void SyncAll() {
+  for (auto& [connection, session] : Sessions()) Sync(session);
+}
+
+// The dialog manager of controlled tabs (AgensControlled::dialogs, asked by the browser for each
+// dialog): holds a dialog for the agent while its session runs, else hands it to the browser's
+// own. Never destroyed: content may keep the pointer past the tab's control.
+class HeldDialogs : public content::JavaScriptDialogManager {
+ public:
+  void RunJavaScriptDialog(content::WebContents* contents,
+                           content::RenderFrameHost* frame,
+                           content::JavaScriptDialogType type,
+                           const std::u16string& message,
+                           const std::u16string& default_prompt,
+                           DialogClosedCallback done,
+                           bool* did_suppress_message) override {
+    if (Tab* tab = Holding(contents)) {
+      *did_suppress_message = false;
+      tab->Hold({type == content::JAVASCRIPT_DIALOG_TYPE_ALERT     ? "alert"
+                 : type == content::JAVASCRIPT_DIALOG_TYPE_CONFIRM ? "confirm"
+                                                                   : "prompt",
+                 message, default_prompt, frame->GetGlobalId(), false, std::move(done)});
+      return;
+    }
+    if (auto* normal = Normal(contents)) {
+      return normal->RunJavaScriptDialog(contents, frame, type, message, default_prompt, std::move(done),
+                                         did_suppress_message);
+    }
+    *did_suppress_message = true;
+  }
+  void RunBeforeUnloadDialog(content::WebContents* contents,
+                             content::RenderFrameHost* frame,
+                             bool is_reload,
+                             DialogClosedCallback done) override {
+    if (Tab* tab = Holding(contents)) {
+      return tab->Hold({"beforeunload", {}, {}, frame->GetGlobalId(), is_reload, std::move(done)});
+    }
+    if (auto* normal = Normal(contents)) return normal->RunBeforeUnloadDialog(contents, frame, is_reload, std::move(done));
+    std::move(done).Run(true, std::u16string());
+  }
+  bool HandleJavaScriptDialog(content::WebContents* contents, bool accept, const std::u16string* prompt) override {
+    if (Tab* tab = Find(contents); tab && tab->AnswerDialog(accept, prompt)) return true;
+    auto* normal = Normal(contents);
+    return normal && normal->HandleJavaScriptDialog(contents, accept, prompt);
+  }
+  void CancelDialogs(content::WebContents* contents, bool reset_state) override {
+    if (Tab* tab = Find(contents)) tab->DismissDialogs();
+    if (auto* normal = Normal(contents)) normal->CancelDialogs(contents, reset_state);
+  }
+
+ private:
+  static Tab* Find(content::WebContents* contents) {
+    for (auto& [connection, session] : Sessions()) {
+      for (auto& tab : session.tabs) {
+        if (tab->web_contents() == contents) return tab.get();
+      }
+    }
+    return nullptr;
+  }
+  // The session's tab while it isn't paused: then the person gets the dialog.
+  static Tab* Holding(content::WebContents* contents) {
+    for (auto& [connection, session] : Sessions()) {
+      for (auto& tab : session.tabs) {
+        if (tab->web_contents() == contents) return session.paused ? nullptr : tab.get();
+      }
+    }
+    return nullptr;
+  }
+  static content::JavaScriptDialogManager* Normal(content::WebContents* contents) { return NormalDialogs(contents); }
+};
+content::JavaScriptDialogManager* Dialogs() {
+  static base::NoDestructor<HeldDialogs> dialogs;
+  return dialogs.get();
+}
+
+// "Assumir": queued and new ops answer `paused`; one in flight stops before its next step
+// touches the page (Page::paused), and answers `paused` too.
+void Pause(uint64_t connection) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end() || it->second.paused) return;
+  it->second.paused = true;
+  for (auto& tab : it->second.tabs) {
+    tab->page.FailWaiting(kPaused, "the person took over the tab");
+    tab->ReleaseDialog();
+  }
+  Sync(it->second);
+  base::DictValue fields;
+  fields.Set("by", "user");
+  SendEventTo(connection, "control.paused", std::move(fields));
+}
+void Resume(uint64_t connection) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end() || !it->second.paused) return;
+  it->second.paused = false;
+  Sync(it->second);
+  // The agent holds the tab's dialogs again: those open on the host come back to it.
+  for (auto& tab : it->second.tabs) {
+    if (tab->web_contents()) ui_ask::HandDialogsTo(tab->web_contents(), Dialogs());
+  }
+  SendEventTo(connection, "control.resumed", {});
+}
+// Connections whose control.start waits for the person.
+std::set<uint64_t>& Asking() {
+  static base::NoDestructor<std::set<uint64_t>> asking;
+  return *asking;
+}
+
+void Tab::WebContentsDestroyed() {
+  // The person closed it: forget it (this deletes `this`).
+  capture_.ReplaceClosure(base::OnceClosure());
+  Observe(nullptr);
+  auto it = Sessions().find(connection_);
+  if (it == Sessions().end()) return;
+  std::erase_if(it->second.tabs, [this](const std::unique_ptr<Tab>& tab) { return tab.get() == this; });
+}
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+// Ends the session. Its tabs stay open and are no longer controlled, unless `close_tabs`.
+void End(uint64_t connection, bool close_tabs) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end()) return;
+  std::vector<std::unique_ptr<Tab>> tabs = std::move(it->second.tabs);
+  Sessions().erase(it);
+  std::vector<content::WebContents*> to_close;
+  for (auto& tab : tabs) {
+    if (close_tabs && tab->web_contents()) to_close.push_back(tab->web_contents());
+  }
+  tabs.clear();  // unmarks them
+  for (content::WebContents* contents : to_close) {
+    ui_ask::TabClosing(contents);
+    contents->Close();
+  }
+}
+
+// Ends the session from the browser's side (tabs stay open) and tells the client why.
+void Stop(uint64_t connection, std::string_view reason) {
+  if (!Sessions().contains(connection)) return;
+  End(connection, /*close_tabs=*/false);
+  base::DictValue fields;
+  fields.Set("reason", reason);
+  SendEventTo(connection, "control.stopped", std::move(fields));
+}
+void StopByUser(uint64_t connection) {
+  Stop(connection, "user");
+}
