+  } else {
+    self.layer.backgroundColor = self.hovered ? CG(kHover, self) : NSColor.clearColor.CGColor;
+    self.layer.borderColor = CG(self.hovered ? kLineHover : kLineStrong, self);
+    _label.textColor = kInk.color();
+    _icon.contentTintColor = (self.hovered ? kInk : kDim).color();
+  }
+}
