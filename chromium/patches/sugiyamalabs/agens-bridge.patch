@@ -0,0 +1,560 @@
+// Copyright 2026 SugiyamaLabs.
+// Compartilhar a tela in the casca (agens_screen_share.h, docs/casca.md).
+
+#include "chrome/browser/agens/embed/agens_screen_share.h"
+
+#import <AppKit/AppKit.h>
+#include <CoreGraphics/CoreGraphics.h>
+
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/agens/bridge/ui_ops.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+#include "chrome/browser/agens/bridge/view_ops.h"
+#include "chrome/browser/agens/embed/agens_embedded.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/agens/embed/native_shell.h"
+#include "chrome/browser/media/webrtc/desktop_media_list.h"
+#include "chrome/browser/media/webrtc/desktop_media_list_observer.h"
+#include "chrome/browser/media/webrtc/desktop_media_picker.h"
+#include "chrome/browser/media/webrtc/desktop_media_picker_controller.h"
+#include "chrome/browser/media/webrtc/desktop_media_picker_factory_impl.h"
+#include "chrome/browser/media/webrtc/desktop_media_picker_manager.h"
+#include "chrome/browser/media/webrtc/media_stream_ui.h"
+#include "chrome/browser/media/webrtc/system_media_capture_permissions_mac.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/desktop_media_id.h"
+#include "content/public/browser/invalidate_type.h"
+#include "content/public/browser/media_stream_request.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/cocoa/permissions_utils.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace agens {
+namespace {
+
+using content::DesktopMediaID;
+
+// The protocol's names for AgensShareKind.
+constexpr const char* kTypeNames[] = {"screen", "window", "tab"};
+// Base64 thumbnails per ui.ask or ui.update; the rest goes in the next one.
+constexpr size_t kHostThumbnailBytes = 512 * 1024;
+
+// A tab capture's tab: the page of its main frame.
+content::WebContents* SharedTab(const DesktopMediaID& id) {
+  content::RenderFrameHost* frame =
+      content::RenderFrameHost::FromID(id.web_contents_id.render_process_id, id.web_contents_id.main_render_frame_id);
+  return frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+}
+
+// What the host calls a source: a tab's view id ("" for one it doesn't know), else the capture id.
+std::string HostId(const DesktopMediaID& id) {
+  if (id.type != DesktopMediaID::TYPE_WEB_CONTENTS) return id.ToString();
+  const int n = bridge::view::KnownTab(SharedTab(id));
+  return n ? bridge::ViewTabName(n) : std::string();
+}
+
+int KindOf(DesktopMediaList::Type type) {
+  switch (type) {
+    case DesktopMediaList::Type::kScreen: return kAgensShareScreen;
+    case DesktopMediaList::Type::kWindow: return kAgensShareWindow;
+    default: return kAgensShareTab;
+  }
+}
+int KindOf(DesktopMediaID::Type type) {
+  return type == DesktopMediaID::TYPE_SCREEN ? kAgensShareScreen
+         : type == DesktopMediaID::TYPE_WINDOW ? kAgensShareWindow
+                                               : kAgensShareTab;
+}
+
+// The window names picked here, for the bar ("a janela Figma"): the capture's id carries none.
+std::map<DesktopMediaID::Id, std::string>& WindowNames() {
+  static base::NoDestructor<std::map<DesktopMediaID::Id, std::string>> names;
+  return *names;
+}
+
+class SharePicker;
+std::vector<SharePicker*>& Pickers() {
+  static base::NoDestructor<std::vector<SharePicker*>> pickers;
+  return *pickers;
+}
+
+// Shows the sources on the casca (agens_ui_share_picker) and answers with the one picked
+// (agens_window_share_pick); with no `window` (embedded), on the host (ui.ask "screen_share",
+// ui.update while open). `switching`: "Trocar", only tabs.
+class SharePicker : public DesktopMediaPicker {
+ public:
+  SharePicker(AgensWindow* window, content::WebContents* contents, bool switching, std::string origin = {})
+      : window_(window ? window->weak.GetWeakPtr() : nullptr),
+        host_(!window),
+        contents_(contents->GetWeakPtr()),
+        origin_(std::move(origin)),
+        switching_(switching) {
+    if (tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents)) {
+      tab_id_ = tab->GetHandle().raw_value();
+    }
+    Pickers().push_back(this);
+  }
+  ~SharePicker() override {
+    std::erase(Pickers(), this);
+    if (manager_shown_) DesktopMediaPickerManager::Get()->OnHideDialog();
+    if (window_ && window_->ui) agens_ui_share_picker(window_->ui, nullptr);
+    bridge::ui_ask::Withdraw(ask_);  // the request went first: ui.cancel "gone"
+  }
+
+  // DesktopMediaPicker:
+  void Show(const Params& params,
+            std::vector<std::unique_ptr<DesktopMediaList>> source_lists,
+            DoneCallback done_callback) override {
+    if (!switching_) {
+      DesktopMediaPickerManager::Get()->OnShowDialog(params);
+      manager_shown_ = true;
+    }
+    done_ = std::move(done_callback);
+    site_ = base::UTF16ToUTF8(params.app_name);
+    // As Chromium's picker: screen audio only where macOS can give it, a window's never (the
+    // prototype: macOS doesn't send one window's sound alone), a tab's whenever asked.
+    if (params.request_audio && !switching_) {
+      audio_ |= 1 << kAgensShareTab;
+      if (!params.exclude_system_audio &&
+          DesktopMediaPickerController::IsSystemAudioCaptureSupported(params.request_source)) {
+        audio_ |= 1 << kAgensShareScreen;
+      }
+    }
+    for (auto& list : source_lists) {
+      // shortcut: a list macOS draws itself (SCContentSharingPicker, off by default) is left out;
+      // handle it if that feature ever turns on.
+      if (list->IsSourceListDelegated()) continue;
+      const int kind = KindOf(list->GetMediaListType());
+      kinds_ |= 1 << kind;
+      // The casca's 16:10 tile at 2x; the host's at most 320 points wide.
+      list->SetThumbnailSize(host_ ? gfx::Size(320, 200) : gfx::Size(360, 226));
+      watches_.push_back(std::make_unique<Watch>(this));
+      lists_.push_back(std::move(list));
+      if (kind == kAgensShareTab) {
+        lists_.back()->StartUpdating(watches_.back().get());
+      } else {
+        needs_screen_ = true;
+      }
+    }
+    if (!needs_screen_ || !system_media_permissions::ScreenCaptureNeedsSystemLevelPermissions()) {
+      OnPermission(true);
+    } else {
+      CheckPermission();  // publishes when known, so the sheet doesn't flip from picker to warning
+    }
+  }
+
+  AgensWindow* window() const { return window_.get(); }
+
+  void Pick(const std::string& id, bool audio) {
+    for (const auto& list : lists_) {
+      for (int i = 0; i < list->GetSourceCount(); ++i) {
+        const DesktopMediaList::Source& source = list->GetSource(i);
+        if ((host_ ? HostId(source.id) : source.id.ToString()) != id) continue;
+        DesktopMediaID media_id = source.id;
+        const int kind = KindOf(list->GetMediaListType());
+        media_id.audio_share = switching_ ? switch_audio_ : audio && (audio_ & (1 << kind));
+        if (kind == kAgensShareWindow) WindowNames()[media_id.id] = base::UTF16ToUTF8(source.name);
+        return Finish(media_id);
+      }
+    }
+    Finish(base::unexpected(blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED_BY_USER));
+  }
+
+  void set_switch_audio(bool audio) { switch_audio_ = audio; }
+
+ private:
+  struct Thumbnail {
+    uint32_t generation = 0;
+    uint32_t on_host = 0;  // the generation the host has
+    std::vector<uint8_t> png;
+  };
+
+  struct Watch : DesktopMediaListObserver {
+    explicit Watch(SharePicker* picker) : picker(picker) {}
+    void OnSourceAdded(int) override { picker->Changed(); }
+    void OnSourceRemoved(int) override { picker->Changed(); }
+    void OnSourceMoved(int, int) override { picker->Changed(); }
+    void OnSourceNameChanged(int) override { picker->Changed(); }
+    void OnSourceThumbnailChanged(int) override { picker->Changed(); }
+    void OnSourcePreviewChanged(size_t) override {}
+    void OnDelegatedSourceListSelection() override {}
+    void OnDelegatedSourceListDismissed() override {}
+    raw_ptr<SharePicker> picker;
+  };
+
+  // Chromium's picker polls the same way (ScreenCapturePermissionCheckerMac): the person turns it
+  // on in System Settings and the picker fills by itself.
+  void CheckPermission() {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock()}, base::BindOnce(&ui::IsScreenCaptureAllowed),
+        base::BindOnce(&SharePicker::OnPermission, weak_.GetWeakPtr()));
+  }
+  void OnPermission(bool allowed) {
+    const bool changed = !permission_known_ || allowed != permission_;
+    permission_known_ = true;
+    permission_ = allowed;
+    if (allowed) {
+      poll_.Stop();
+      if (!screen_started_) {
+        screen_started_ = true;
+        for (size_t i = 0; i < lists_.size(); ++i) {
+          if (KindOf(lists_[i]->GetMediaListType()) != kAgensShareTab) lists_[i]->StartUpdating(watches_[i].get());
+        }
+      }
+    } else if (!poll_.IsRunning()) {
+      poll_.Start(FROM_HERE, base::Seconds(1), base::BindRepeating(&SharePicker::CheckPermission, base::Unretained(this)));
+    }
+    if (changed) Changed();
+  }
+
+  // Thumbnails change about once a second per source: one update per run of the loop.
+  void Changed() {
+    if (publish_pending_ || !permission_known_) return;
+    publish_pending_ = true;
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SharePicker::Publish, weak_.GetWeakPtr()));
+  }
+  void Publish() {
+    publish_pending_ = false;
+    if (done_.is_null()) return;
+    if (host_) return PublishToHost();
+    if (!window_ || !window_->ui) return;
+    std::vector<std::string> ids, names;
+    std::vector<int> kinds;
+    std::vector<const std::vector<uint8_t>*> pngs;
+    for (const auto& list : lists_) {
+      for (int i = 0; i < list->GetSourceCount(); ++i) {
+        const DesktopMediaList::Source& source = list->GetSource(i);
+        ids.push_back(source.id.ToString());
+        names.push_back(base::UTF16ToUTF8(source.name));
+        kinds.push_back(KindOf(list->GetMediaListType()));
+        pngs.push_back(&Encode(ids.back(), source).png);
+      }
+    }
+    std::vector<AgensShareSource> sources(ids.size());
+    for (size_t i = 0; i < ids.size(); ++i) {
+      sources[i] = {ids[i].c_str(), kinds[i], names[i].c_str(), pngs[i]->empty() ? nullptr : pngs[i]->data(),
+                    static_cast<int>(pngs[i]->size())};
+    }
+    const AgensSharePicker picker = {site_.c_str(), tab_id_, kinds_, audio_, permission_, switching_,
+                                     sources.data(), static_cast<int>(sources.size())};
+    agens_ui_share_picker(window_->ui, &picker);
+  }
+
+  Thumbnail& Encode(const std::string& id, const DesktopMediaList::Source& source) {
+    Thumbnail& t = thumbnails_[id];
+    const SkBitmap* bitmap = source.thumbnail.isNull() ? nullptr : source.thumbnail.bitmap();
+    if (bitmap && bitmap->getGenerationID() != t.generation) {  // only new pictures get encoded
+      t.generation = bitmap->getGenerationID();
+      t.png = gfx::PNGCodec::EncodeBGRASkBitmap(*bitmap, false).value_or(std::vector<uint8_t>());
+    }
+    return t;
+  }
+
+  // The window's app, for the host to name it and draw its icon (from the bundle id).
+  void AddApp(DesktopMediaID::Id window, base::DictValue& entry) {
+    auto [it, fresh] = apps_.try_emplace(window);
+    if (fresh) {
+      NSArray* info = CFBridgingRelease(
+          CGWindowListCopyWindowInfo(kCGWindowListOptionIncludingWindow, static_cast<CGWindowID>(window)));
+      NSDictionary* first = info.firstObject;
+      NSString* owner = first[(__bridge NSString*)kCGWindowOwnerName];
+      NSNumber* pid = first[(__bridge NSString*)kCGWindowOwnerPID];
+      NSRunningApplication* app = pid ? [NSRunningApplication runningApplicationWithProcessIdentifier:pid.intValue] : nil;
+      it->second = {owner ? base::SysNSStringToUTF8(owner) : std::string(),
+                    app.bundleIdentifier ? base::SysNSStringToUTF8(app.bundleIdentifier) : std::string()};
+    }
+    if (!it->second.first.empty()) entry.Set("app", it->second.first);
+    if (!it->second.second.empty()) entry.Set("bundle_id", it->second.second);
+  }
+
+  // ui.ask "screen_share" the first time, ui.update after. A thumbnail (a tab's favicon) goes only
+  // when it is new to the host, within kHostThumbnailBytes per message.
+  void PublishToHost() {
+    if (!contents_) return;
+    base::ListValue sources;
+    size_t budget = kHostThumbnailBytes;
+    bool deferred = false;
+    std::vector<std::pair<Thumbnail*, uint32_t>> going;
+    for (const auto& list : lists_) {
+      const int kind = KindOf(list->GetMediaListType());
+      for (int i = 0; i < list->GetSourceCount(); ++i) {
+        const DesktopMediaList::Source& source = list->GetSource(i);
+        const std::string id = HostId(source.id);
+        if (id.empty()) continue;
+        base::DictValue entry;
+        entry.Set("id", id);
+        entry.Set("type", kTypeNames[kind]);
+        entry.Set("title", base::UTF16ToUTF8(source.name));
+        if (kind == kAgensShareWindow) AddApp(source.id.id, entry);
+        Thumbnail& t = Encode(id, source);
+        if (!t.png.empty() && t.on_host != t.generation) {
+          std::string png = base::Base64Encode(t.png);
+          if (png.size() <= budget) {
+            budget -= png.size();
+            entry.Set(kind == kAgensShareTab ? "favicon" : "thumbnail", std::move(png));
+            going.emplace_back(&t, t.generation);
+          } else {
+            deferred = true;
+          }
+        }
+        sources.Append(std::move(entry));
+      }
+    }
+    base::DictValue fields;
+    fields.Set("sources", std::move(sources));
+    fields.Set("permission", permission_ ? "granted" : "missing");
+    bool on_host;
+    if (!ask_) {
+      base::ListValue types, audio;
+      for (int kind : {kAgensShareScreen, kAgensShareWindow, kAgensShareTab}) {
+        if (kinds_ & (1 << kind)) types.Append(kTypeNames[kind]);
+        if (audio_ & (1 << kind)) audio.Append(kTypeNames[kind]);
+      }
+      fields.Set("origin", origin_);
+      fields.Set("types", std::move(types));
+      fields.Set("audio", std::move(audio));
+      fields.Set("switching", switching_);
+      ask_ = bridge::ui_ask::Ask(contents_.get(), "screen_share", std::move(fields),
+                                 base::BindOnce(&SharePicker::Answered, weak_.GetWeakPtr()));
+      on_host = ask_ && bridge::ui_ask::Sent(ask_);
+    } else {
+      on_host = bridge::ui_ask::Update(ask_, std::move(fields));
+    }
+    // Not on the host yet (behind another ask): every thumbnail goes again with the next update.
+    if (!on_host) return;
+    for (auto [t, generation] : going) t->on_host = generation;
+    if (deferred) Changed();
+  }
+
+  // The host's ui.answer; null when the engine ended it (no host, the tab went).
+  void Answered(const base::DictValue* answer) {
+    ask_ = 0;
+    const std::string* source = answer ? answer->FindString("source") : nullptr;
+    if (!source) return Finish(base::unexpected(blink::mojom::MediaStreamRequestResult::PERMISSION_DENIED_BY_USER));
+    Pick(*source, answer->FindBool("audio").value_or(false));
+  }
+
+  void Finish(DoneCallbackArgumentType result) {
+    poll_.Stop();
+    if (manager_shown_) DesktopMediaPickerManager::Get()->OnHideDialog();
+    manager_shown_ = false;
+    if (done_.is_null()) return;
+    // Posted, as Chromium's picker does: the callback may destroy this picker.
+    content::GetUIThreadTaskRunner({})->PostTask(FROM_HERE, base::BindOnce(std::move(done_), result));
+  }
+
+  base::WeakPtr<AgensWindow> window_;
+  const bool host_;
+  base::WeakPtr<content::WebContents> contents_;
+  const std::string origin_;  // host: who asks (the requesting frame's origin)
+  int ask_ = 0;               // host: the open ui.ask
+  std::map<DesktopMediaID::Id, std::pair<std::string, std::string>> apps_;  // window: app name, bundle id
+  const bool switching_;
+  bool switch_audio_ = false;
+  int tab_id_ = 0;
+  std::string site_;
+  int kinds_ = 0, audio_ = 0;
+  bool needs_screen_ = false, screen_started_ = false;
+  bool permission_known_ = false, permission_ = false;
+  bool publish_pending_ = false, manager_shown_ = false;
+  DoneCallback done_;
+  // Declared before lists_ so they go after them: a list keeps a raw_ptr to its watch.
+  std::vector<std::unique_ptr<Watch>> watches_;  // one per list, same order
+  std::vector<std::unique_ptr<DesktopMediaList>> lists_;
+  std::map<std::string, Thumbnail> thumbnails_;
+  base::RepeatingTimer poll_;
+  base::WeakPtrFactory<SharePicker> weak_{this};
+};
+
+class NativeShareUI;
+std::vector<NativeShareUI*>& Shares() {
+  static base::NoDestructor<std::vector<NativeShareUI*>> shares;
+  return *shares;
+}
+
+// While a tab shares (prototype "Compartilhando"): its marks in the address and on the tab, and the
+// bar with Trocar and Parar, all drawn by the casca from AgensTab.sharing*.
+class NativeShareUI : public MediaStreamUI {
+ public:
+  NativeShareUI(content::WebContents* capturer, const DesktopMediaID& media_id, bool audio)
+      : capturer_(capturer->GetWeakPtr()), media_id_(media_id), audio_(audio) {
+    Shares().push_back(this);
+  }
+  ~NativeShareUI() override {
+    std::erase(Shares(), this);
+    Touch();
+  }
+
+  // MediaStreamUI:
+  gfx::NativeViewId OnStarted(base::OnceClosure stop_callback,
+                              content::MediaStreamUI::SourceCallback source_callback,
+                              const std::vector<DesktopMediaID>& media_ids) override {
+    stop_ = std::move(stop_callback);
+    source_ = std::move(source_callback);
+    started_ = true;
+    Touch();
+    return 0;
+  }
+
+  content::WebContents* capturer() const { return capturer_.get(); }
+  bool started() const { return started_; }
+  bool can_switch() const { return !source_.is_null(); }
+  int kind() const { return KindOf(media_id_.type); }
+  bool audio() const { return audio_; }
+  std::string Name() const {
+    if (media_id_.type == DesktopMediaID::TYPE_WINDOW) {
+      auto it = WindowNames().find(media_id_.id);
+      return it != WindowNames().end() ? it->second : std::string();
+    }
+    if (media_id_.type != DesktopMediaID::TYPE_WEB_CONTENTS) return std::string();
+    content::WebContents* shared = SharedTab(media_id_);
+    return shared ? base::UTF16ToUTF8(shared->GetTitle()) : std::string();
+  }
+  // The source's id as the host's ask had it.
+  std::string Target() const { return HostId(media_id_); }
+
+  void Stop() {
+    if (stop_) std::move(stop_).Run();
+  }
+  // Trocar: the picker again, with this ato's tabs; the pick changes the shared tab in place. No
+  // `window`: the host's (view.share.switch).
+  void Switch(AgensWindow* window) {
+    if (source_.is_null() || !capturer_) return;
+    switcher_ = std::make_unique<SharePicker>(window, capturer_.get(), /*switching=*/true,
+                                              capturer_->GetPrimaryMainFrame()->GetLastCommittedOrigin().Serialize());
+    switcher_->set_switch_audio(audio_);
+    DesktopMediaPicker::Params params(DesktopMediaPicker::Params::RequestSource::kGetDisplayMedia);
+    params.web_contents = capturer_.get();
+    params.app_name = base::UTF8ToUTF16(capturer_->GetPrimaryMainFrame()->GetLastCommittedOrigin().host());
+    std::vector<std::unique_ptr<DesktopMediaList>> lists = DesktopMediaPickerFactoryImpl::GetInstance()->CreateMediaList(
+        {DesktopMediaList::Type::kWebContents}, capturer_.get(),
+        base::BindRepeating([](content::WebContents*) { return true; }));
+    switcher_->Show(params, std::move(lists),
+                    base::BindOnce(&NativeShareUI::Switched, weak_.GetWeakPtr()));
+  }
+
+ private:
+  void Switched(DesktopMediaPicker::DoneCallbackArgumentType result) {
+    switcher_.reset();
+    if (result.has_value() && source_) source_.Run(result.value(), /*captured_surface_control_active=*/false);
+  }
+  // The tab strip reads the state again (AgensWindow::Notify through OnTabChangedAt).
+  void Touch() {
+    if (capturer_) capturer_->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+  }
+
+  base::WeakPtr<content::WebContents> capturer_;
+  const DesktopMediaID media_id_;
+  const bool audio_;
+  bool started_ = false;
+  base::OnceClosure stop_;
+  content::MediaStreamUI::SourceCallback source_;
+  std::unique_ptr<SharePicker> switcher_;
+  base::WeakPtrFactory<NativeShareUI> weak_{this};
+};
+
+std::vector<NativeShareUI*> SharesOf(content::WebContents* contents) {
+  std::vector<NativeShareUI*> out;
+  for (NativeShareUI* share : Shares()) {
+    if (share->started() && share->capturer() == contents) out.push_back(share);
+  }
+  return out;
+}
+
+content::WebContents* TabAt(AgensWindow* w, int index) {
+  return index >= 0 && index < w->model()->count() ? w->model()->GetWebContentsAt(index) : nullptr;
+}
+
+}  // namespace
+
+std::unique_ptr<DesktopMediaPicker> CreateNativeDesktopMediaPicker(const content::MediaStreamRequest* request) {
+  // "This tab" (preferCurrentTab) keeps Chromium's confirmation.
+  if (!request || request->video_type == blink::mojom::MediaStreamType::DISPLAY_VIDEO_CAPTURE_THIS_TAB) return nullptr;
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(request->render_process_id, request->render_frame_id);
+  content::WebContents* contents = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (IsEmbedded()) {
+    return contents ? std::make_unique<SharePicker>(nullptr, contents, /*switching=*/false, request->url_origin.Serialize())
+                    : nullptr;
+  }
+  AgensWindow* window = NativeWindowForContents(contents);
+  return window ? std::make_unique<SharePicker>(window, contents, /*switching=*/false) : nullptr;
+}
+
+std::unique_ptr<MediaStreamUI> CreateNativeShareUI(content::WebContents* capturer,
+                                                   const DesktopMediaID& media_id,
+                                                   bool audio) {
+  if (!capturer || (!IsEmbedded() && !NativeWindowForContents(capturer))) return nullptr;
+  return std::make_unique<NativeShareUI>(capturer, media_id, audio);
+}
+
+void FillShareState(content::WebContents* contents, AgensTab* tab, std::string* name) {
+  const std::vector<NativeShareUI*> shares = SharesOf(contents);
+  if (shares.empty()) {
+    tab->sharing_name = "";
+    return;
+  }
+  NativeShareUI* share = shares.front();  // one getDisplayMedia at a time is what sites do
+  *name = share->Name();
+  tab->sharing = share->kind() + 1;
+  tab->sharing_audio = share->audio();
+  tab->sharing_name = name->c_str();
+  tab->sharing_switch = share->can_switch();
+}
+
+std::optional<base::DictValue> ShareFields(content::WebContents* contents) {
+  const std::vector<NativeShareUI*> shares = SharesOf(contents);
+  if (shares.empty()) return std::nullopt;
+  NativeShareUI* share = shares.front();  // as FillShareState
+  base::DictValue fields;
+  fields.Set("kind", kTypeNames[share->kind()]);
+  fields.Set("target", share->Target());
+  fields.Set("title", share->Name());
+  fields.Set("audio", share->audio());
+  fields.Set("switch", share->can_switch());
+  return fields;
+}
+
+bool StopSharing(content::WebContents* contents) {
+  const std::vector<NativeShareUI*> shares = SharesOf(contents);
+  for (NativeShareUI* share : shares) share->Stop();
+  return !shares.empty();
+}
+
+bool SwitchSharing(content::WebContents* contents) {
+  const std::vector<NativeShareUI*> shares = SharesOf(contents);
+  if (shares.empty() || !shares.front()->can_switch()) return false;
+  shares.front()->Switch(nullptr);
+  return true;
+}
+
+}  // namespace agens
+
+void agens_window_share_pick(AgensWindow* w, const char* id, int audio) {
+  // The newest one: Trocar's picker can open while the first one's answer is on its way.
+  const std::vector<agens::SharePicker*>& pickers = agens::Pickers();
+  for (auto it = pickers.rbegin(); it != pickers.rend(); ++it) {
+    if ((*it)->window() == w) return (*it)->Pick(id ? id : "", audio != 0);
+  }
+}
+void agens_window_share_stop(AgensWindow* w, int index) {
+  for (agens::NativeShareUI* share : agens::SharesOf(agens::TabAt(w, index))) share->Stop();
+}
+void agens_window_share_switch(AgensWindow* w, int index) {
+  std::vector<agens::NativeShareUI*> shares = agens::SharesOf(agens::TabAt(w, index));
+  if (!shares.empty()) shares.front()->Switch(w);
+}
