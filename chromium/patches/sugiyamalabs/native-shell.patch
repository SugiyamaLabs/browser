+- (instancetype)initWithWindow:(AgensWindow*)window {
+  if ((self = [super initWithFrame:NSZeroRect])) {
+    _window = window;
+    _rows = [NSMutableArray array];
+    _suggestionRows = [NSMutableArray array];
+    _atoButtons = [NSMutableArray array];
+    _selected = -1;
+    _url = @"";
+    self.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+
+    __weak AgensChrome* weak = self;
+    _back = [[AgensToolButton alloc] initWithSymbol:@"chevron.left" label:@"Voltar"];
+    _back.onPress = ^{ [weak run:agens_window_back]; };
+    _forward = [[AgensToolButton alloc] initWithSymbol:@"chevron.right" label:@"Avançar"];
+    _forward.onPress = ^{ [weak run:agens_window_forward]; };
+    _reload = [[AgensToolButton alloc] initWithSymbol:@"arrow.clockwise" label:@"Recarregar"];
+    _reload.onPress = ^{ [weak reloadOrStop]; };
+
+    _omni = [[NSView alloc] init];
+    _omni.wantsLayer = YES;
+    _omni.layer.cornerRadius = 10;
+    _omni.layer.borderWidth = 1;
+    _omniIcon = [NSImageView imageViewWithImage:Symbol(@"magnifyingglass", 12)];
+    _omniIcon.contentTintColor = kDim.color();
+    _address = WellField(13, @"Buscar ou digitar endereço", @"Endereço e busca");
+    _address.delegate = self;
+    _address.target = self;
+    _address.action = @selector(go:);
+    [_omni addSubview:_omniIcon];
+    [_omni addSubview:_address];
+
+    _suggest = [[NSView alloc] init];
+    _suggest.wantsLayer = YES;
+    _suggest.layer.cornerRadius = 12;
+    _suggest.layer.borderWidth = 1;
+    _suggest.hidden = YES;
+    _suggest.accessibilityRole = NSAccessibilityListRole;
+    _suggest.accessibilityLabel = @"Sugestões";
+
+    _atoTile = AtoTile(18);
+    _atoName = Label(13, NSFontWeightSemibold, kInk);
+    _separator = [[NSView alloc] init];
+    _atosLine = [[NSView alloc] init];
+    for (NSView* line in @[ _separator, _atosLine ]) line.wantsLayer = YES;
+
+    _newTab = [[AgensHoverView alloc] init];
+    NSImageView* plus = [NSImageView imageViewWithImage:Symbol(@"plus", 13)];
+    plus.contentTintColor = kDim.color();
+    plus.frame = NSMakeRect(8, 8, 16, 16);
+    NSTextField* label = Label(13, NSFontWeightRegular, kDim);
+    label.stringValue = @"Nova aba";
+    label.frame = NSMakeRect(34, 7, 150, 18);
+    [_newTab addSubview:plus];
+    [_newTab addSubview:label];
+    _newTab.accessibilityLabel = @"Nova aba";
+    _newTab.onPress = ^{ [weak run:agens_window_new_tab]; };
+
+    _addAto = [[AgensToolButton alloc] initWithSymbol:@"plus" label:@"Novo ato"];
+    _addAto.onPress = ^{ [weak run:agens_window_new_ato]; };
+
+    _ntp = [[AgensNewTabView alloc] init];
+    _ntp.hidden = YES;
+    _ntp.field.target = self;
+    _ntp.field.action = @selector(go:);
+
+    for (NSView* v in @[ _back, _forward, _reload, _omni, _atoTile, _atoName, _separator, _newTab,
+                         _atosLine, _addAto, _ntp, _suggest ]) {
+      [self addSubview:v];
+    }
+    [self refreshTheme];
+    agens_window_set_tabs_observer(_window, TabsChanged, (__bridge void*)self);
+    agens_window_set_atos_observer(_window, AtosChanged, (__bridge void*)self);
+    agens_window_set_suggestions_observer(_window, SuggestionsChanged, (__bridge void*)self);
+  }
+  return self;
+}
+
+- (void)refreshTheme {
+  _omni.layer.backgroundColor = CG(kSunk, self);
+  _omni.layer.borderColor = CG(_address.currentEditor ? kLineStrong : kLine, self);
+  _suggest.layer.backgroundColor = CG(kFloat, self);
+  _suggest.layer.borderColor = CG(kLineStrong, self);
+  _separator.layer.backgroundColor = CG(kLine, self);
+  _atosLine.layer.backgroundColor = CG(kLine, self);
+}
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  [self refreshTheme];
+  if (_window) agens_window_relayout(_window);  // the engine repaints the window and page card
+}
+- (void)colorsWindow:(unsigned*)window page:(unsigned*)page line:(unsigned*)line {
+  *window = kSideBg.rgb(self);
+  *page = kBg.rgb(self);
+  *line = kLine.rgb(self);
+}
+
+// Clicks on the page (where there is no chrome view) go to the page underneath.
+- (NSView*)hitTest:(NSPoint)point {
+  NSView* hit = [super hitTest:point];
+  if (hit == self && NSPointInRect([self convertPoint:point fromView:self.superview], _page)) return nil;
+  return hit;
+}
+
+- (AgensRect)layoutForWidth:(int)width height:(int)height {
+  _back.frame = NSMakeRect(kLightsEnd, 12, 28, 28);
+  _forward.frame = NSMakeRect(kLightsEnd + 30, 12, 28, 28);
+  _reload.frame = NSMakeRect(kLightsEnd + 60, 12, 28, 28);
+  CGFloat omniX = kLightsEnd + 96;
+  _omni.frame = NSMakeRect(omniX, 9, width - omniX - kPad, 34);
+  _omniIcon.frame = NSMakeRect(12, 10, 14, 14);
+  _address.frame = NSMakeRect(33, 8, NSWidth(_omni.frame) - 33 - 12, 18);
+
+  // Column: ato title (prototype .space-title), separator, new tab, tabs.
+  CGFloat y = kToolbar;
+  _atoTile.frame = NSMakeRect(kPad + 8, y + 7, 18, 18);
+  _atoName.frame = NSMakeRect(kPad + 35, y + 7, kSide - 43, 18);
+  y += kRow + 6;
+  _separator.frame = NSMakeRect(kPad + 8, y, kSide - 16, 1);
+  y += 7;
+  _newTab.frame = NSMakeRect(kPad, y, kSide, kRow);
+  y += kRow + 1;
+  for (AgensTabRow* row in _rows) {
+    row.frame = NSMakeRect(kPad, y, kSide, kRow);
+    y += kRow + 1;
+  }
+
+  // Atos row at the foot, centered, with a line above (prototype .spaces).
+  CGFloat footY = height - kPad - kAtos;
+  _atosLine.frame = NSMakeRect(kPad, footY, kSide, 1);
+  CGFloat x = kPad + (kSide - (_atoButtons.count + 1) * 32) / 2;
+  for (AgensAtoButton* b in _atoButtons) {
+    b.frame = NSMakeRect(x, footY + 8, 30, 34);
+    x += 32;
+  }
+  _addAto.frame = NSMakeRect(x, footY + 8, 30, 28);
+
+  _page = NSMakeRect(kPad + kSide + kGap, kToolbar, width - (kPad + kSide + kGap) - kPad,
+                     height - kToolbar - kPad);
+  _ntp.frame = NSInsetRect(_page, 1, 1);
+
+  CGFloat rowsH = _suggestionRows.count * 34;
+  _suggest.frame = NSMakeRect(NSMinX(_omni.frame), NSMaxY(_omni.frame) + 6, NSWidth(_omni.frame), rowsH + 10);
+  for (NSUInteger i = 0; i < _suggestionRows.count; ++i) {
+    _suggestionRows[i].frame = NSMakeRect(5, 5 + i * 34, NSWidth(_omni.frame) - 10, 34);
+  }
+  return {(int)NSMinX(_page), (int)NSMinY(_page), (int)NSWidth(_page), (int)NSHeight(_page)};
+}
+- (void)relayout {
+  [self layoutForWidth:(int)NSWidth(self.bounds) height:(int)NSHeight(self.bounds)];
+}
+
+- (void)setTabs:(const AgensTab*)tabs count:(int)count {
+  __weak AgensChrome* weak = self;
+  while ((int)_rows.count < count) {
+    AgensTabRow* row = [[AgensTabRow alloc] initWithFrame:NSMakeRect(0, 0, kSide, kRow)];
+    __weak AgensTabRow* weakRow = row;
+    row.onPress = ^{ [weak activate:weakRow.index]; };
+    row.onClose = ^{ [weak close:weakRow.index]; };
+    [self addSubview:row positioned:NSWindowBelow relativeTo:_ntp];
+    [_rows addObject:row];
+  }
+  while ((int)_rows.count > count) {
+    [_rows.lastObject removeFromSuperview];
+    [_rows removeLastObject];
+  }
+  for (int i = 0; i < count; ++i) {
+    _rows[i].index = i;
+    [_rows[i] updateWith:tabs[i]];
+    if (!tabs[i].active) continue;
+    _url = @(tabs[i].url);
+    _loading = tabs[i].loading;
+    _back.enabled = tabs[i].can_go_back;
+    _forward.enabled = tabs[i].can_go_forward;
+  }
+  [_reload setSymbol:_loading ? @"xmark" : @"arrow.clockwise"];
+  _reload.accessibilityLabel = _loading ? @"Parar" : @"Recarregar";
+  BOOL secure = [_url hasPrefix:@"https://"];
+  _omniIcon.image = Symbol(_url.length == 0 ? @"magnifyingglass" : secure ? @"lock.fill" : @"globe", 12);
+  // Don't overwrite what the person is typing.
+  if (_address.currentEditor == nil) _address.stringValue = [self displayURL];
+  BOOL wasNTP = !_ntp.hidden;
+  _ntp.hidden = _url.length > 0;
+  if (!_ntp.hidden && !wasNTP) _ntp.field.stringValue = @"";
+  [self relayout];
+}
+
+// The address as the prototype shows it: no https:// or www., no lone trailing slash.
+- (NSString*)displayURL {
+  NSString* s = _url;
+  for (NSString* p in @[ @"https://", @"www." ]) {
+    if ([s hasPrefix:p]) s = [s substringFromIndex:p.length];
+  }
+  NSRange slash = [s rangeOfString:@"/"];
+  if (slash.location != NSNotFound && slash.location == s.length - 1) s = [s substringToIndex:slash.location];
+  return s;
+}
+
+- (void)setAtos:(const AgensAto*)atos count:(int)count {
+  __weak AgensChrome* weak = self;
+  while ((int)_atoButtons.count < count) {
+    AgensAtoButton* b = [[AgensAtoButton alloc] initWithFrame:NSZeroRect];
+    int index = (int)_atoButtons.count;
+    b.onPress = ^{ [weak switchAto:index]; };
+    [self addSubview:b positioned:NSWindowBelow relativeTo:_ntp];
+    [_atoButtons addObject:b];
+  }
+  while ((int)_atoButtons.count > count) {
+    [_atoButtons.lastObject removeFromSuperview];
+    [_atoButtons removeLastObject];
+  }
+  for (int i = 0; i < count; ++i) {
+    [_atoButtons[i] updateWith:atos[i] index:i];
+    if (!atos[i].active) continue;
+    _atoName.stringValue = @(atos[i].name);
+    _atoTile.stringValue = Monogram(_atoName.stringValue);
+    _atoTile.layer.backgroundColor = AtoColor(i).CGColor;
+  }
+  [self relayout];
+}
+- (void)switchAto:(int)index {
+  if (_window && !_atoButtons[index].selected) agens_window_switch_ato(_window, index);
+}
+
+// --- Address and suggestions.
+
+- (void)controlTextDidBeginEditing:(NSNotification*)note {
+  [self refreshTheme];
+}
+- (void)controlTextDidChange:(NSNotification*)note {
+  if (note.object != _address) return;
+  _selected = -1;
+  if (_window) agens_window_suggest(_window, _address.stringValue.UTF8String);
+}
+- (void)controlTextDidEndEditing:(NSNotification*)note {
+  if (note.object != _address) return;
+  _address.stringValue = [self displayURL];
+  [self closeSuggestions];
+  [self refreshTheme];
+}
+// Arrows walk the list, Enter opens, Esc closes (the prototype's omnibox keys).
+- (BOOL)control:(NSControl*)control textView:(NSTextView*)textView doCommandBySelector:(SEL)command {
+  if (control != _address) return NO;
+  int count = (int)_suggestionRows.count;
+  if (command == @selector(moveDown:) && count) {
+    [self select:(_selected + 1) % count];
+    return YES;
+  }
+  if (command == @selector(moveUp:) && count) {
+    [self select:_selected <= 0 ? count - 1 : _selected - 1];
+    return YES;
+  }
+  if (command == @selector(cancelOperation:)) {
+    _address.stringValue = _url;
+    [self closeSuggestions];
+    return YES;
+  }
+  if (command == @selector(insertNewline:) && _selected >= 0) {
+    [self openSuggestion:_selected];
+    return YES;
+  }
+  return NO;
+}
+- (void)select:(int)index {
+  _selected = index;
+  for (int i = 0; i < (int)_suggestionRows.count; ++i) _suggestionRows[i].selected = i == index;
+}
+- (void)setSuggestions:(const AgensSuggestion*)suggestions count:(int)count {
+  if (_address.currentEditor == nil) count = 0;  // results that arrive after the field closed
+  __weak AgensChrome* weak = self;
+  while ((int)_suggestionRows.count < count) {
+    AgensSuggestionRow* row = [[AgensSuggestionRow alloc] initWithFrame:NSZeroRect];
+    int index = (int)_suggestionRows.count;
+    row.onPress = ^{ [weak openSuggestion:index]; };
+    [_suggest addSubview:row];
+    [_suggestionRows addObject:row];
+  }
+  while ((int)_suggestionRows.count > count) {
+    [_suggestionRows.lastObject removeFromSuperview];
+    [_suggestionRows removeLastObject];
+  }
+  for (int i = 0; i < count; ++i) [_suggestionRows[i] updateWith:suggestions[i]];
+  if (_selected >= count) _selected = -1;
+  [self select:_selected];
+  _suggest.hidden = count == 0;
+  [self relayout];
+}
+- (void)closeSuggestions {
+  if (_window) agens_window_suggest(_window, "");
+  [self setSuggestions:nullptr count:0];
+}
+- (void)openSuggestion:(int)index {
+  if (_window) agens_window_open_suggestion(_window, index);
+  [self closeSuggestions];
+  [self.window makeFirstResponder:nil];
+}
+
+// --- Actions.
+
+- (void)run:(void (*)(AgensWindow*))action {
+  if (_window) action(_window);
+}
+- (void)reloadOrStop {
+  [self run:_loading ? agens_window_stop : agens_window_reload];
+}
+- (void)activate:(int)index {
+  if (_window) agens_window_activate_tab(_window, index);
+}
+- (void)close:(int)index {
+  if (_window) agens_window_close_tab(_window, index);
+}
+- (void)go:(NSTextField*)sender {
+  if (_window && sender.stringValue.length) agens_window_navigate(_window, sender.stringValue.UTF8String);
+  [self closeSuggestions];
+}
+- (void)detach {
+  if (_window) {
+    agens_window_set_tabs_observer(_window, nullptr, nullptr);
+    agens_window_set_atos_observer(_window, nullptr, nullptr);
+    agens_window_set_suggestions_observer(_window, nullptr, nullptr);
+  }
+  _window = nullptr;
+}
+- (void)focusAddress {
+  _address.stringValue = _url;  // the full address while editing
+  [self.window makeFirstResponder:_address];
+}
+@end
+
+extern "C" {
+
+void* agens_ui_create_chrome(AgensWindow* window) {
+  return (__bridge_retained void*)[[AgensChrome alloc] initWithWindow:window];
+}
+AgensRect agens_ui_layout(void* chrome, int width, int height) {
+  return [(__bridge AgensChrome*)chrome layoutForWidth:width height:height];
+}
+void agens_ui_focus_address(void* chrome) {
+  [(__bridge AgensChrome*)chrome focusAddress];
+}
+void agens_ui_colors(void* chrome, unsigned* window, unsigned* page, unsigned* line) {
+  [(__bridge AgensChrome*)chrome colorsWindow:window page:page line:line];
+}
+void agens_ui_destroy_chrome(void* chrome) {
+  [(__bridge AgensChrome*)chrome detach];
+}
+
+}  // extern "C"
