+// SugiyamaLabs: ad blocker levels, daily list update and the in-app rules converter.
+#ifndef CHROME_BROWSER_SUGIYAMALABS_ADBLOCK_H_
+#define CHROME_BROWSER_SUGIYAMALABS_ADBLOCK_H_
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+
+class PrefRegistrySimple;
+
+namespace base {
+class CommandLine;
+}
+
+namespace sugiyamalabs::adblock {
+
+// Local State. Level: 0 off, 1 Padrao (EasyList + EasyPrivacy), 2 Forte (+ uBlock filters,
+// uBlock privacy, EasyList Cookie List). Default 2.
+inline constexpr char kLevelPref[] = "agens.adblock.level";
+inline constexpr char kAutoUpdatePref[] = "agens.adblock.auto_update";
+inline constexpr char kLastUpdatePref[] = "agens.adblock.last_update";
+inline constexpr char kHideCookieNoticesPref[] = "agens.adblock.hide_cookie_notices";
+
+// Test-only: where the lists are downloaded from, instead of our GitHub.
+inline constexpr char kListsUrlSwitch[] = "agens-adblock-lists-url";
+
+void RegisterPrefs(PrefRegistrySimple* registry);
+
+// Applies the level and schedules the daily update. Call once, with the ruleset service up.
+void Start();
+
+int GetLevel();
+void SetLevel(int level);  // clamped to 0..2; applies now
+bool GetAutoUpdate();
+void SetAutoUpdate(bool enabled);
+base::Time GetLastUpdate();  // null when never updated
+
+// Downloads the lists from our GitHub and re-indexes. `done` gets (ok, message). Never blocks.
+void UpdateNow(base::OnceCallback<void(bool, std::string)> done);
+
+// The converter runs in a child process (this same executable, `--agens-convert-rules`), so a
+// malformed list cannot crash the browser. Call first thing in ChromeMainDelegate; returns the
+// exit code when this process is the converter.
+std::optional<int> MaybeRunRulesConverter(const base::CommandLine& command_line);
+
+}  // namespace sugiyamalabs::adblock
+
+#endif  // CHROME_BROWSER_SUGIYAMALABS_ADBLOCK_H_
