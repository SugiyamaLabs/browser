+// Turning it off only isolates the ato again; turning it on asks first.
+- (void)toggleAtoShared:(NSSwitch*)sw {
+  NSString* ato = sw.identifier;
+  if (!_browser || !ato) return;
+  if (sw.state == NSControlStateValueOff) {
+    agens_window_set_ato_shared(_browser, ato.UTF8String, 0);
+    return;
+  }
+  sw.state = NSControlStateValueOff;  // until confirmed
+  NSArray<NSString*>* names = [_chrome atoNamesForSettings];
+  NSArray<NSNumber*>* shares = [_chrome atoSharedForSettings];
+  NSArray<NSString*>* ids = [_chrome atoIdsForSettings];
+  const NSUInteger index = [ids indexOfObject:ato];
+  if (index == NSNotFound || index >= names.count) return;
+  NSMutableArray<NSString*>* others = [NSMutableArray array];
+  for (NSUInteger i = 0; i < names.count && i < shares.count; ++i) {
+    if (i != index && shares[i].boolValue) [others addObject:names[i]];
+  }
+  NSString* name = names[index];
+  NSString* list = others.count < 2
+                       ? others.firstObject
+                       : [NSString stringWithFormat:@"%@ e %@",
+                                                    [[others subarrayWithRange:NSMakeRange(0, others.count - 1)]
+                                                        componentsJoinedByString:@", "],
+                                                    others.lastObject];
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = [NSString stringWithFormat:@"Compartilhar os cookies de %@?", name];
+  NSString* what = others.count
+                       ? [NSString stringWithFormat:@"Os logins de %@ passam a valer também em %@, e os deles em %@.", name, list, name]
+                       : [NSString stringWithFormat:@"Por enquanto nada é compartilhado: os logins de %@ só passam a valer em outro ato quando ele também ligar esta opção.", name];
+  alert.informativeText = [what stringByAppendingString:
+      @" No mesmo site, o login dos outros atos substitui o deste. Apagar cookies num ato que compartilha apaga nos outros também. Só cookies: senhas, histórico e dados dos sites continuam separados."];
+  [alert addButtonWithTitle:@"Compartilhar"];
+  [alert addButtonWithTitle:@"Cancelar"];
+  __weak AgensSettings* weak = self;
+  [alert beginSheetModalForWindow:self.window completionHandler:^(NSModalResponse r) {
+    AgensSettings* strong = weak;
+    if (r != NSAlertFirstButtonReturn || !strong || !strong->_browser) return;
+    agens_window_set_ato_shared(strong->_browser, ato.UTF8String, 1);  // by folder: still this ato
+    sw.state = NSControlStateValueOn;
+  }];
+}
