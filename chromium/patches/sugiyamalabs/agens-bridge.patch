+  // Only for the panel this same call opens: a policy asked and no panel followed is forgotten.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           base::BindOnce([] { FileDialogSource() = nullptr; }));
