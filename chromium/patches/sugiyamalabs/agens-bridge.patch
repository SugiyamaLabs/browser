+}  // namespace
+
+std::vector<std::string> SharesWith(const base::FilePath& ato) {
+  std::vector<std::string> folders;
+  if (!AgensWindow::AtoSharesCookies(ato)) return folders;
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath() != ato && AgensWindow::AtoSharesCookies(entry->GetPath())) {
+      folders.push_back(entry->GetPath().BaseName().AsUTF8Unsafe());
+    }
+  }
+  std::ranges::sort(folders);
+  return folders;
+}
+
+namespace {
+
+// The person's consent described the ato's cookie sharing at the time: when that changes, the
+// session ends.
+void SharingChanged() {
+  std::vector<uint64_t> ended;
+  for (const auto& [connection, session] : Sessions()) {
+    if (SharesWith(session.ato) != session.shares_with) ended.push_back(connection);
+  }
+  for (uint64_t connection : ended) Stop(connection, "sharing_changed");
+}
+void WatchSharing() {
+  static base::NoDestructor<PrefChangeRegistrar> prefs;
+  if (!prefs->IsEmpty()) return;
+  prefs->Init(g_browser_process->local_state());
+  prefs->Add(AgensWindow::kAtosPref, base::BindRepeating(&SharingChanged));
+  prefs->Add(kAgentExtensionsPref, base::BindRepeating(&SyncAll));  // host.settings while tabs are controlled
+}
+
+bool ControlAlways(const std::string& key) {
+  return std::ranges::contains(g_browser_process->local_state()->GetList(kControlAlwaysPref), base::Value(key));
+}
+
+std::optional<GURL> WebURL(const Request& request) {
+  std::optional<std::string> text = StringParam(request.body, "url");
+  if (!text) return std::nullopt;
+  GURL url(*text);
+  // Only web pages: never chrome://, file:, javascript: or data:.
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) return std::nullopt;
+  return url;
+}
+
+// What control.start asked for, carried through the approval.
+struct Wanted {
+  std::string agent, reason;
+  std::vector<std::string> allow;  // ParseAllow
+};
+
+void Start(const Client& client, Request request, ReplyCallback reply) {
+  const uint64_t connection = client.connection;
+  if (Sessions().contains(connection) || Asking().contains(connection)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "control already started on this connection"));
+    return;
+  }
+  std::optional<std::string> id = StringParam(request.body, "ato");
+  std::optional<std::string> reason = StringParam(request.body, "reason");
+  if (!id || !reason || (!reason->empty() && !IsDisplayText(*reason, kMaxReasonChars))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                    "needs ato and reason (up to 1024 characters, no control characters)"));
+    return;
+  }
+  std::optional<std::vector<std::string>> allow = ParseAllow(request.body.Find("allow"));
+  if (!allow) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "allow is a list of \"passwords\", \"clipboard\" and \"eval\""));
+    return;
+  }
+  const base::Value* agent_param = request.body.Find("agent");
+  if (agent_param && (!agent_param->is_string() || !IsDisplayText(agent_param->GetString(), kMaxAgentChars))) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "agent is 1 to 40 characters, no control characters"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*id);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  const std::string name = client.name.empty() ? "app" : client.name;
+  Wanted wanted;
+  wanted.agent = agent_param ? agent_param->GetString() : name;
+  wanted.reason = *reason;
+  wanted.allow = std::move(*allow);
+  const std::string ato_name = AgensWindow::AtoName(entry);
+  std::vector<std::string> shares_with = SharesWith(entry->GetPath());
+  std::string detail = *reason;
+  if (std::string asks = AllowDetail(wanted.allow); !asks.empty()) detail += (detail.empty() ? "" : "\n\n") + asks;
+  std::vector<std::string> names;
+  for (const std::string& folder : shares_with) {
+    if (ProfileAttributesEntry* other = FindAto(folder)) names.push_back(AgensWindow::AtoName(other));
+  }
+  if (!shares_with.empty()) {
+    detail += (detail.empty() ? "" : "\n\n") + ato_name + " compartilha cookies com " + JoinNames(names) +
+              ": os logins deles também ficam ao alcance.";
+  }
+  // The same, in parts, for a host that draws its own sheet.
+  base::DictValue facts;
+  facts.Set("kind", "control");
+  facts.Set("ato", *id);
+  facts.Set("ato_name", ato_name);
+  facts.Set("agent", wanted.agent);
+  if (!reason->empty()) facts.Set("reason", *reason);
+  base::ListValue allow_list, shares_list;
+  for (const std::string& a : wanted.allow) allow_list.Append(a);
+  for (const std::string& n : names) shares_list.Append(n);
+  facts.Set("allow", std::move(allow_list));
+  if (!shares_list.empty()) facts.Set("shares_with", std::move(shares_list));
+  // "Permitir sempre" only for a signed app, and only for this ato with this sharing group.
+  const bool signed_client = !client.identity.empty();
+  const std::string always_key =
+      signed_client ? ControlAlwaysKey(client.identity, entry->GetPath().BaseName().AsUTF8Unsafe(), shares_with, wanted.allow)
+                    : std::string();
+  auto begin = [](uint64_t connection, Wanted wanted, base::FilePath ato, std::vector<std::string> shares_with,
+                  std::string always_key, Request request, ReplyCallback reply, AgensApprovalAnswer answer) {
+    // Gone from Asking: the connection closed while the sheet was up.
+    if (!Asking().erase(connection)) return;
+    if (answer == kAgensApprovalDeny) {
+      std::move(reply).Run(ErrorReply(&request.id, kDenied));
+      return;
+    }
+    if (!AgensWindow::Storage().GetProfileAttributesWithPath(ato)) {
+      std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the ato is gone"));
+      return;
+    }
+    if (SharesWith(ato) != shares_with) {  // the sheet no longer says what the app could reach
+      std::move(reply).Run(ErrorReply(&request.id, kDenied, "the ato's cookie sharing changed while asking"));
+      return;
+    }
+    if (answer == kAgensApprovalAllowAlways && !always_key.empty() && !ControlAlways(always_key)) {
+      ScopedListPrefUpdate(g_browser_process->local_state(), kControlAlwaysPref)->Append(always_key);
+    }
+    WatchSharing();
+    Session& session = Sessions()[connection];
+    session.agent = std::move(wanted.agent);
+    session.reason = std::move(wanted.reason);
+    session.passwords = std::ranges::contains(wanted.allow, std::string("passwords"));
+    session.clipboard = std::ranges::contains(wanted.allow, std::string("clipboard"));
+    session.eval = std::ranges::contains(wanted.allow, std::string("eval"));
+    session.ato = std::move(ato);
+    session.shares_with = std::move(shares_with);
+    std::move(reply).Run(OkReply(request.id));
+  };
+  Asking().insert(connection);
+  if (signed_client && ControlAlways(always_key)) {
+    begin(connection, std::move(wanted), entry->GetPath(), std::move(shares_with), always_key, std::move(request), std::move(reply),
+          kAgensApprovalAllow);
+    return;
+  }
+  AskApproval(connection, "O " + name + " quer usar abas do ato " + ato_name, detail, /*offer_always=*/signed_client,
+              base::BindOnce(begin, connection, std::move(wanted), entry->GetPath(), std::move(shares_with), always_key,
+                             std::move(request), std::move(reply)),
+              std::move(facts));
+}
+
+// A new foreground tab in `browser` (the ato's window), controlled by the session.
+void OpenIn(uint64_t connection, GURL url, Request request, ReplyCallback reply, BrowserWindowInterface* browser) {
+  auto it = Sessions().find(connection);
+  if (it == Sessions().end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "control ended"));
+    return;
+  }
+  Session& session = it->second;
+  if (!browser || browser->GetProfile()->GetPath() != session.ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the ato's window"));
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  base::WeakPtr<content::NavigationHandle> handle = Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the tab"));
+    return;
+  }
+  auto tab = std::make_unique<Tab>(connection, "t" + base::NumberToString(session.next_tab++), contents);
+  if (handle) {
+    tab->WaitFor(handle->GetNavigationId(), std::move(request.id), std::move(reply));
+  } else {
+    base::DictValue result;
+    result.Set("tab", tab->id);
+    std::move(reply).Run(OkReply(request.id, std::move(result)));
+  }
+  session.tabs.push_back(std::move(tab));
+  Sync(session);
+}
+
+void TabOpen(const Client& client, Request request, ReplyCallback reply) {
+  const Session& session = Sessions().at(client.connection);
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  std::optional<GURL> url = WebURL(request);
+  if (!ato || !url) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato and an http or https url"));
+    return;
+  }
+  if (*ato != session.ato.BaseName().AsUTF8Unsafe()) {
+    std::move(reply).Run(ErrorReply(&request.id, kDenied, "control was approved for another ato"));
+    return;
+  }
+  // The ato's window when it has one (left where it is); otherwise open it.
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(session.ato);
+  BrowserWindowInterface* browser = nullptr;
+  if (profile) {
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation([&](BrowserWindowInterface* b) {
+      if (b->GetProfile() != profile || b->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+          b->IsDeleteScheduled() || b->GetTabStripModel()->closing_all()) {
+        return true;
+      }
+      browser = b;
+      return false;
+    });
+  }
+  if (browser) {
+    OpenIn(client.connection, *url, std::move(request), std::move(reply), browser);
+    return;
+  }
+  profiles::SwitchToProfile(session.ato, /*always_create=*/false,
+                            base::BindOnce(&OpenIn, client.connection, *url, std::move(request), std::move(reply)));
+}
+
+void TabNavigate(Session& session, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  std::optional<GURL> url = WebURL(request);
+  if (!id || !url) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and an http or https url"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::NavigationController::LoadURLParams params(*url);
+  params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  base::WeakPtr<content::NavigationHandle> handle = tab->web_contents()->GetController().LoadURLWithParams(params);
+  if (!handle) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "the navigation did not start"));
+    return;
+  }
+  tab->WaitFor(handle->GetNavigationId(), std::move(request.id), std::move(reply));
+}
+
+// tab.back, tab.forward and tab.reload: answer like tab.navigate.
+void TabHistory(Session& session, Request request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::NavigationController& controller = tab->web_contents()->GetController();
+  if (request.op == "tab.back" ? !controller.CanGoBack() : request.op == "tab.forward" && !controller.CanGoForward()) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "nothing to go to in that direction"));
+    return;
+  }
+  if (request.op == "tab.reload" && controller.GetLastCommittedEntry() &&
+      controller.GetLastCommittedEntry()->GetHasPostData()) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "would resubmit a form"));
+    return;
+  }
+  tab->WaitFor(Tab::kNextNavigation, std::move(request.id), std::move(reply));
+  if (request.op == "tab.back") {
+    controller.GoBack();
+  } else if (request.op == "tab.forward") {
+    controller.GoForward();
+  } else {
+    controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/false);
+  }
+}
+
+void TabClose(Session& session, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  auto it = std::find_if(session.tabs.begin(), session.tabs.end(), [&](auto& tab) { return tab->id == *id; });
+  if (it == session.tabs.end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  content::WebContents* contents = (*it)->web_contents();
+  session.tabs.erase(it);  // unmarks it first
+  if (contents) {
+    ui_ask::TabClosing(contents);
+    contents->Close();
+  }
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void PageOp(Session& session, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  std::optional<std::string> id = StringParam(request.body, "tab");
+  if (!id) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  Tab* tab = session.Find(*id);
+  if (!tab) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *id));
+    return;
+  }
+  if (tab->HasDialog() && DialogBlocks(op)) {
+    std::move(reply).Run(ErrorReply(&request.id, kDialogOpen, "a dialog is open: answer it with page.dialog"));
+    return;
+  }
+  std::optional<std::string> ref = StringParam(request.body, "ref");
+  // Runs `method` (a Page op without other arguments) in the tab's queue.
+  auto run = [&](void (Page::*method)(base::Value, ReplyCallback)) {
+    tab->page.Run(request.id.Clone(), base::BindOnce(method, base::Unretained(&tab->page), request.id.Clone()),
+                  std::move(reply));
+  };
+  if (op == "page.console") {
+    run(&Page::Console);
+  } else if (op == "page.network") {
+    run(&Page::Network);
+  } else if (op == "page.hover") {
+    if (!ref) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and ref"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Hover, base::Unretained(&tab->page), request.id.Clone(), *ref), std::move(reply));
+  } else if (op == "page.scroll") {
+    std::optional<double> dy = request.body.FindDouble("dy");
+    const base::Value* ref_value = request.body.Find("ref");
+    if (!dy || !std::isfinite(*dy) || std::abs(*dy) > 1e6 || (ref_value && !ref)) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and dy (CSS pixels); ref is optional"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Scroll, base::Unretained(&tab->page), request.id.Clone(), ref.value_or(""), *dy),
+                  std::move(reply));
+  } else if (op == "page.eval") {
+    std::optional<std::string> js = StringParam(request.body, "js");
+    if (!js || !AtMostChars(*js, kMaxEvalChars)) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and js (up to 100000 characters)"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Eval, base::Unretained(&tab->page), request.id.Clone(), std::move(*js)),
+                  std::move(reply));
+  } else if (op == "page.dialog") {
+    std::optional<std::string> action = StringParam(request.body, "action");
+    const base::Value* text_value = request.body.Find("text");
+    std::u16string text;
+    if (!action || (*action != "accept" && *action != "dismiss") ||
+        (text_value && (!text_value->is_string() || !AtMostChars(text_value->GetString(), kMaxTypeChars) ||
+                        !base::UTF8ToUTF16(text_value->GetString().data(), text_value->GetString().size(), &text)))) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab and action (accept or dismiss); text is optional"));
+      return;
+    }
+    if (!tab->HasDialog()) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "no dialog is open on that tab"));
+      return;
+    }
+    // At once, outside the queue: the op that raised it (a click, an eval) is stuck until it's answered.
+    tab->AnswerDialog(*action == "accept", text_value ? &text : nullptr);
+    std::move(reply).Run(OkReply(request.id));
+  } else if (op == "page.snapshot") {
+    tab->page.Run(request.id.Clone(), base::BindOnce(&Page::Snapshot, base::Unretained(&tab->page), request.id.Clone()),
+                  std::move(reply));
+  } else if (op == "page.screenshot") {
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Screenshot, base::Unretained(&tab->page), request.id.Clone()), std::move(reply));
+  } else if (op == "page.click") {
+    if (!ref) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and ref"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Click, base::Unretained(&tab->page), request.id.Clone(), *ref), std::move(reply));
+  } else if (op == "page.type") {
+    std::optional<std::string> text = StringParam(request.body, "text");
+    std::u16string text16;
+    // No control characters: Enter or Tab inside the text could move the focus (to a password
+    // field, say) while typing. Those go one at a time through page.key, which checks again.
+    if (!ref || !text || !AtMostChars(*text, kMaxTypeChars) || !base::UTF8ToUTF16(text->data(), text->size(), &text16) ||
+        std::any_of(text16.begin(), text16.end(), [](char16_t c) { return c < 0x20 || c == 0x7F; })) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab, ref and text (up to 10000 characters, no control characters)"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::Type, base::Unretained(&tab->page), request.id.Clone(), *ref, std::move(text16)),
+                  std::move(reply));
+  } else if (op == "page.key") {
+    std::optional<std::string> name = StringParam(request.body, "key");
+    std::optional<Key> key = name ? ParseKey(*name, request.body.Find("modifiers")) : std::nullopt;
+    if (!key) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab and key: a key name (Enter, Tab, Escape, Backspace, Delete, "
+                                      "ArrowUp…, PageUp, PageDown, Home, End) or one character; modifiers is a list "
+                                      "of shift, meta, alt, ctrl"));
+      return;
+    }
+    tab->page.Run(request.id.Clone(),
+                  base::BindOnce(&Page::PressKey, base::Unretained(&tab->page), request.id.Clone(), std::move(*key)),
+                  std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+// The pill's two lines; each omitted or empty goes back to its default.
+void Status(Session& session, const Request& request, ReplyCallback reply) {
+  std::string lines[2];
+  const char* keys[2] = {"title", "detail"};
+  for (int i = 0; i < 2; ++i) {
+    const base::Value* value = request.body.Find(keys[i]);
+    if (!value) continue;
+    if (!value->is_string() || (!value->GetString().empty() && !IsDisplayText(value->GetString(), kMaxStatusChars))) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "title and detail are up to 120 characters, no control characters"));
+      return;
+    }
+    lines[i] = value->GetString();
+  }
+  session.title = std::move(lines[0]);
+  session.detail = std::move(lines[1]);
+  Sync(session);
+  std::move(reply).Run(OkReply(request.id));
+}
+
+}  // namespace
+
+bool Handles(std::string_view op) {
+  return base::StartsWith(op, "control.") || base::StartsWith(op, "tab.") || base::StartsWith(op, "page.");
+}
+
+void HandleOp(const Client& client, Request request, ReplyCallback reply) {
+  const std::string& op = request.op;
+  if (op == "control.start") {
+    Start(client, std::move(request), std::move(reply));
+    return;
+  }
+  if (op == "control.stop") {
+    End(client.connection, /*close_tabs=*/true);
+    std::move(reply).Run(OkReply(request.id));
+    return;
+  }
+  if (op.starts_with("control.") && op != "control.status") {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  auto it = Sessions().find(client.connection);
+  if (it == Sessions().end()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs control.start on this connection"));
+    return;
+  }
+  Session& session = it->second;
+  if (op == "control.status") {
+    Status(session, request, std::move(reply));
+    return;
+  }
+  if (session.paused && PauseBlocks(op)) {
+    std::move(reply).Run(ErrorReply(&request.id, kPaused, "the person took over: wait for control.resumed"));
+    return;
+  }
+  if (op == "tab.open") {
+    TabOpen(client, std::move(request), std::move(reply));
+  } else if (op == "tab.navigate") {
+    TabNavigate(session, std::move(request), std::move(reply));
+  } else if (op == "tab.back" || op == "tab.forward" || op == "tab.reload") {
+    TabHistory(session, std::move(request), std::move(reply));
+  } else if (op == "tab.close") {
+    TabClose(session, request, std::move(reply));
+  } else if (op.starts_with("page.")) {
+    PageOp(session, std::move(request), std::move(reply));
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+  }
+}
+
+void OnConnectionClosed(uint64_t connection) {
+  Asking().erase(connection);
+  End(connection, /*close_tabs=*/false);
+}
+
+}  // namespace agens::bridge::control
