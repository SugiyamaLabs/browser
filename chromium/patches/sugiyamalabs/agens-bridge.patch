+++ b/chrome/browser/agens/embed/agens_embedded_mac.mm
@@ -0,0 +1,134 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/embed/agens_embedded.h"
+
+#import <AppKit/AppKit.h>
+#include <dispatch/dispatch.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+#include "chrome/browser/agens/bridge/view_ops.h"
+#include "chrome/browser/lifetime/application_lifetime.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/common/chrome_switches.h"
+#import "components/remote_cocoa/app_shim/native_widget_mac_nswindow.h"
+#include "content/public/common/content_switches.h"
+#include "ui/views/widget/widget.h"
+
+namespace agens {
+
+namespace {
+
+pid_t g_parent = 0;
+dispatch_source_t g_parent_watch;  // kept for the life of the process
+
+void ParentGone() {
+  static bool quitting = false;
+  if (quitting) return;
+  quitting = true;
+  bridge::view::HostGone();  // its connection may linger, but it is no longer the host
+  // Nobody is left to answer a "leave this page?" dialog.
+  chrome::ExitIgnoreUnloadHandlers();
+  // shortcut: a shutdown stuck for 10 s ends hard (no clean exit); find out why if it shows up.
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC),
+                 dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+                   _exit(0);
+                 });
+}
+
+// The last net under the cases handled where they start (popups and app windows are normal
+// windows, no web apps, no picture-in-picture, printing or external apps): a views window goes on
+// screen only when it belongs to a DevTools window. Anything else stays hidden, with a log line
+// naming it. Hidden, never closed: whatever made it keeps running, nothing waits on its showing.
+BOOL MayOrderIn(NSWindow* window) {
+  NSWindow* root = window;
+  while (root.parentWindow) root = root.parentWindow;
+  views::Widget* widget = views::Widget::GetWidgetForNativeWindow(gfx::NativeWindow(root));
+  while (widget && widget->parent()) widget = widget->parent();
+  BrowserWindowInterface* browser =
+      widget ? GlobalBrowserCollection::GetInstance()->FindBrowserWithWindow(widget->GetNativeWindow()) : nullptr;
+  if (browser && browser->GetType() == BrowserWindowInterface::TYPE_DEVTOOLS) return YES;
+  LOG(ERROR) << "agens: kept off screen (embedded): "
+               << (widget && !widget->GetName().empty() ? widget->GetName()
+                                                         : base::SysNSStringToUTF8(NSStringFromClass(window.class)));
+  return NO;
+}
+
+// Page features whose only UI is a system window or panel the engine cannot keep off screen
+// (passkeys, the share sheet, the color sampler) or a dialog on a window nobody sees (payment):
+// not available in the page, so sites see them missing instead of a request that never ends.
+// shortcut: refused for now; the host could show them later (ui.ask), as it does other requests.
+constexpr char kOffBlinkFeatures[] = "WebAuth,PaymentRequest,WebShare,EyeDropperAPI,DocumentPictureInPictureAPI";
+
+}  // namespace
+
+bool IsEmbedded() {
+  static const bool embedded = base::CommandLine::ForCurrentProcess()->HasSwitch(kEmbeddedSwitch);
+  return embedded;
+}
+
+pid_t EmbeddedParent() {
+  return g_parent;
+}
+
+bool AcceptUnsignedClients() {
+#if defined(OFFICIAL_BUILD)
+  return false;
+#else
+  return IsEmbedded() && base::CommandLine::ForCurrentProcess()->HasSwitch(kAcceptUnsignedSwitch);
+#endif
+}
+
+bool EmbeddedClientAllowed(const std::string& signing_identifier) {
+  static const base::NoDestructor<std::vector<std::string>> allowed(bridge::ParseAllowedClients(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(kAllowedClientsSwitch)));
+  return IsEmbedded() && !signing_identifier.empty() && std::ranges::contains(*allowed, signing_identifier);
+}
+
+void StartEmbedded() {
+  if (!IsEmbedded()) return;
+  g_parent = getppid();
+  if (g_parent <= 1) _exit(0);  // the app that launched the engine is already gone (now launchd's)
+
+  // No window of our own: tabs live in browser windows that never go on screen
+  // (WebUIBrowserWindow::Show), and the host shows them. Popups open as tabs (browser_navigator.cc);
+  // a DevTools window the person asks for is the one exception.
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  command_line->AppendSwitch(switches::kNoStartupWindow);  // also no session restore at startup
+  command_line->AppendSwitch(switches::kNoFirstRun);
+  std::string off = command_line->GetSwitchValueASCII(switches::kDisableBlinkFeatures);
+  command_line->AppendSwitchASCII(switches::kDisableBlinkFeatures,
+                                  off.empty() ? kOffBlinkFeatures : off + "," + kOffBlinkFeatures);
+  [NativeWidgetMacNSWindow setOrderInFilter:^BOOL(NSWindow* window) {
+    return MayOrderIn(window);
+  }];
+  // Our own onboarding window (AgensFirstRun, ui/chrome_mac.mm) is the stand-alone product's. A
+  // volatile domain: it lasts for this process and is never saved to the shared defaults.
+  NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+  NSMutableDictionary* arguments = [[defaults volatileDomainForName:NSArgumentDomain] mutableCopy]
+                                       ?: [NSMutableDictionary dictionary];
+  arguments[@"AgensFirstRunDone"] = @YES;
+  [defaults removeVolatileDomainForName:NSArgumentDomain];
+  [defaults setVolatileDomain:arguments forName:NSArgumentDomain];
+  // Before NSApp finishes launching, so the Dock never shows the engine.
+  [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+
+  // On the main queue: it runs once the UI thread's run loop does, where quitting is safe.
+  g_parent_watch = dispatch_source_create(DISPATCH_SOURCE_TYPE_PROC, static_cast<uintptr_t>(g_parent),
+                                          DISPATCH_PROC_EXIT, dispatch_get_main_queue());
+  dispatch_source_set_event_handler(g_parent_watch, ^{
+    ParentGone();
+  });
+  dispatch_resume(g_parent_watch);
+  if (getppid() != g_parent) _exit(0);  // it went away before the watch was set
+}
