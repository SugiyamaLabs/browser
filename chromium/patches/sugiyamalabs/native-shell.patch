+    __weak AgensSettings* weak = self;
+    for (const Section& sec : kSections) {
+      AgensMenuRow* row = [[AgensMenuRow alloc] initWithIcon:sec.icon title:sec.title key:@""];
+      row.frame = NSMakeRect(10, y, 232, 36);
+      NSString* key = sec.key;
+      row.onPress = ^{ [weak showSection:key]; };
+      row.identifier = key;
+      [_nav addSubview:row];
+      [_navRows addObject:row];
+      y += 36;
