+// --- color: an <input type=color>'s chooser; the choice goes back as #rrggbb.
+
+std::string HexColor(SkColor color) {
+  return base::StringPrintf("#%02x%02x%02x", SkColorGetR(color), SkColorGetG(color), SkColorGetB(color));
+}
