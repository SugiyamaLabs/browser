new file mode 100644
--- /dev/null
+++ b/chrome/browser/agens_adblock/youtube_scriptlet.cc
@@ -0,0 +1,135 @@
+// Copyright 2026 SugiyamaLabs. All rights reserved.
+#include "chrome/browser/agens_adblock/youtube_scriptlet.h"
+
+namespace agens_adblock {
+
+const std::string_view kYoutubeScriptlet = R"JS((function () {
+  'use strict';
+  // The browser may inject twice into one window; wrap only once.
+  var once = Symbol.for('agens.yt');
+  if (window[once]) return;
+  Object.defineProperty(window, once, { value: 1 });
+  var KEYS = ['adPlacements', 'playerAds', 'adSlots'];
+  var URL_RE = /\/youtubei\/v1\/(player|get_watch)/;
+  var HAS_AD = /"(adPlacements|playerAds|adSlots)"/;
+
+  function prune(o) {
+    if (!o || typeof o !== 'object') return o;
+    if (Array.isArray(o)) {
+      for (var i = 0; i < o.length; i++) prune(o[i]);
+      return o;
+    }
+    var targets = [o, o.playerResponse];
+    for (var t = 0; t < targets.length; t++) {
+      var x = targets[t];
+      if (!x || typeof x !== 'object') continue;
+      for (var k = 0; k < KEYS.length; k++) {
+        if (KEYS[k] in x) delete x[KEYS[k]];
+      }
+      var m = x.auxiliaryUi && x.auxiliaryUi.messageRenderers;
+      if (m && m.enforcementMessageViewModel) delete m.enforcementMessageViewModel;
+    }
+    return o;
+  }
+
+  // 1. Inline `var ytInitialPlayerResponse = {...}` in the watch page.
+  try {
+    var held;
+    Object.defineProperty(window, 'ytInitialPlayerResponse', {
+      configurable: true,
+      enumerable: true,
+      get: function () { return held; },
+      set: function (v) { held = prune(v); }
+    });
+  } catch (e) {}
+
+  // 2. JSON.parse: the player parses some responses by itself.
+  try {
+    var nativeParse = JSON.parse;
+    JSON.parse = function () {
+      var r = nativeParse.apply(this, arguments);
+      try {
+        if (r && typeof r === 'object' &&
+            (r.adPlacements || r.playerAds || r.adSlots ||
+             (r.playerResponse && typeof r.playerResponse === 'object'))) prune(r);
+      } catch (e) {}
+      return r;
+    };
+  } catch (e) {}
+
+  // 3. fetch() of /youtubei/v1/player (SPA navigation to the next video).
+  try {
+    var nativeFetch = window.fetch;
+    window.fetch = function (input) {
+      var p = nativeFetch.apply(this, arguments);
+      var u = typeof input === 'string' ? input : (input && input.url) || '';
+      if (!URL_RE.test(u)) return p;
+      return p.then(function (r) {
+        return r.clone().text().then(function (text) {
+          if (!HAS_AD.test(text)) return r;
+          var body = JSON.stringify(prune(nativeParse(text)));
+          return new Response(body, {
+            status: r.status, statusText: r.statusText, headers: r.headers
+          });
+        }).catch(function () { return r; });
+      });
+    };
+  } catch (e) {}
+
+  // 4. XMLHttpRequest to the same endpoints.
+  try {
+    var X = XMLHttpRequest.prototype;
+    var nativeOpen = X.open;
+    X.open = function (method, url) {
+      this.__agensYt = URL_RE.test(String(url));
+      return nativeOpen.apply(this, arguments);
+    };
+    var fix = function (xhr, val) {
+      if (xhr.__agensYt && typeof val === 'string' && HAS_AD.test(val)) {
+        try { return JSON.stringify(prune(nativeParse(val))); } catch (e) {}
+      }
+      return val;
+    };
+    ['responseText', 'response'].forEach(function (name) {
+      var d = Object.getOwnPropertyDescriptor(X, name);
+      if (!d || !d.get) return;
+      Object.defineProperty(X, name, {
+        configurable: true, enumerable: d.enumerable,
+        get: function () { return fix(this, d.get.call(this)); }
+      });
+    });
+  } catch (e) {}
+
+  // 5. Safety net: if an ad still starts, skip it right away.
+  try {
+    setInterval(function () {
+      var p = document.getElementById('movie_player');
+      if (!p || !p.classList.contains('ad-showing')) return;
+      var v = p.querySelector('video');
+      if (v && isFinite(v.duration) && v.duration > 0) v.currentTime = v.duration;
+      var b = p.querySelector('.ytp-skip-ad-button, .ytp-ad-skip-button, .ytp-ad-skip-button-modern');
+      if (b) b.click();
+      window.__agensYtSkips = (window.__agensYtSkips || 0) + 1;
+    }, 500);
+  } catch (e) {}
+})();
+)JS";
+
+const std::string_view kYoutubeCss =
+    "#masthead-ad{display:none!important}\n"
+    "ytd-ad-slot-renderer,ytd-in-feed-ad-layout-renderer,"
+    "ytd-display-ad-renderer,ytd-promoted-sparkles-web-renderer,"
+    "ytd-banner-promo-renderer,#player-ads,.ytp-ad-overlay-container,"
+    "ytd-companion-slot-renderer{display:none!important}\n";
+
+bool IsYoutubeHost(std::string_view host) {
+  for (std::string_view d : {"youtube.com", "youtube-nocookie.com"}) {
+    if (host == d ||
+        (host.size() > d.size() && host.ends_with(d) &&
+         host[host.size() - d.size() - 1] == '.'))
+      return true;
+  }
+  return false;
+}
+
+}  // namespace agens_adblock
