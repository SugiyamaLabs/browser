+- (void)setTabs:(const AgensTab*)tabs count:(int)count {
+  __weak AgensChrome* weak = self;
+  while ((int)_rows.count < count) {
+    AgensTabRow* row = [[AgensTabRow alloc] initWithFrame:NSMakeRect(0, 0, kSide, kRow)];
+    __weak AgensTabRow* weakRow = row;
+    row.onPress = ^{ [weak activate:weakRow.index]; };
+    row.onDrag = ^(NSPoint delta) { [weak dragRow:weakRow by:delta]; };
+    row.onDrop = ^{ [weak dropRow:weakRow]; };
+    row.onClose = ^{ [weak close:weakRow.index]; };
+    row.onPin = ^{
+      AgensChrome* strong = weak;
+      if (strong && strong->_window) agens_window_set_pinned(strong->_window, weakRow.index, !weakRow.pinned);
+    };
+    row.onMute = ^{
+      AgensChrome* strong = weak;
+      if (strong && strong->_window) agens_window_toggle_mute(strong->_window, weakRow.index);
+    };
+    [_tabsDoc addSubview:row];
+    [_rows addObject:row];
+  }
+  while ((int)_rows.count > count) {
+    [_rows.lastObject removeFromSuperview];
+    [_rows removeLastObject];
+  }
+  int activeTab = -1;
+  _pinnedCount = 0;
+  for (int i = 0; i < count; ++i) {
+    _rows[i].index = i;
+    [_rows[i] updateWith:tabs[i]];
+    if (tabs[i].pinned) ++_pinnedCount;
+    if (tabs[i].active) activeTab = i;
+    if (!tabs[i].active) continue;
+    _activeIndex = i;
+    _sound.hidden = !(tabs[i].audible || tabs[i].muted);
+    [_sound setSymbol:tabs[i].muted ? @"speaker.slash.fill" : @"speaker.wave.2.fill"];
+    [_sound setTint:tabs[i].muted ? kLight3 : kDim];
+    _sound.accessibilityLabel = tabs[i].muted ? @"Ativar o som da aba" : @"Silenciar a aba";
+    _sound.toolTip = _sound.accessibilityLabel;
+    _url = @(tabs[i].url);
+    _loading = tabs[i].loading;
+    _bookmarked = tabs[i].bookmarked;
+    _back.enabled = tabs[i].can_go_back;
+    _forward.enabled = tabs[i].can_go_forward;
+  }
+  if (_loadbar.hidden == _loading) {
+    _loadbar.hidden = !_loading;
+    [self runLoadbar];
+  }
+  [_reload setSymbol:_loading ? @"xmark" : @"arrow.clockwise"];
+  [_star setSymbol:_bookmarked ? @"star.fill" : @"star"];
+  [_star setTint:_bookmarked ? kLight3 : kDim];
+  _star.accessibilityLabel = _bookmarked ? @"Tirar dos favoritos" : @"Adicionar aos favoritos";
+  _star.hidden = _url.length == 0 || [_url hasPrefix:@"chrome://"];
+  _siteButton.hidden = _url.length == 0;
+  _reload.accessibilityLabel = _loading ? @"Parar" : @"Recarregar";
+  BOOL secure = [_url hasPrefix:@"https://"];
+  _omniIcon.image = Symbol(_url.length == 0 ? @"magnifyingglass" : secure ? @"lock.fill" : @"globe", 12);
+  // Don't overwrite what the person is typing.
+  if (_address.currentEditor == nil) _address.stringValue = [self displayURL];
+  const BOOL wasHistory = !_history.hidden;
+  _history.hidden = ![_url hasPrefix:@"chrome://history"];
+  if (!_history.hidden && !wasHistory) [_history reload];
+  BOOL wasNTP = !_ntp.hidden;
+  _ntp.hidden = _url.length > 0;
+  if (!_ntp.hidden && !wasNTP) _ntp.field.stringValue = @"";
+  [self relayout];
+  if (activeTab >= 0 && _rows[activeTab].superview == _tabsDoc) [_tabsDoc scrollRectToVisible:_rows[activeTab].frame];
+}
+
+// The address as the prototype shows it: no https:// or www., no lone trailing slash.
+- (NSString*)displayURL {
+  if ([_url hasPrefix:@"chrome://history"]) return @"Histórico";
+  NSString* s = _url;
+  for (NSString* p in @[ @"https://", @"www." ]) {
+    if ([s hasPrefix:p]) s = [s substringFromIndex:p.length];
+  }
+  NSRange slash = [s rangeOfString:@"/"];
+  if (slash.location != NSNotFound && slash.location == s.length - 1) s = [s substringToIndex:slash.location];
+  return s;
+}
