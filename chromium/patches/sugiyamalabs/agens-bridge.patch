diff --git a/chrome/browser/agens/bridge/session_read.cc b/chrome/browser/agens/bridge/session_read.cc
new file mode 100644
index 0000000000..59ee012e92
--- /dev/null
+++ b/chrome/browser/agens/bridge/session_read.cc
@@ -0,0 +1,438 @@
+// Copyright 2026 SugiyamaLabs.
+// Reading the values of session items (session_read.h): cookies from the ato's cookie store, and
+// localStorage keys and request headers from a hidden tab of the ato. A value lives only here and
+// in the `done` call: nothing on this path logs, keeps or returns anything that was not asked, and
+// the cookies, keys and headers filtered out are dropped as they arrive.
+
+#include "chrome/browser/agens/bridge/session_read.h"
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/string_escape.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_options.h"
+#include "net/cookies/cookie_partition_key_collection.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace agens::bridge::session {
+
+namespace {
+
+// How long after the page finished loading we still wait for the request that carries a header:
+// the page may make it a moment later. Past this, what is missing stays missing (the caller's own
+// kPageWait is the backstop).
+constexpr base::TimeDelta kHeaderWait = base::Seconds(3);
+
+// How many requests of other origins we remember headers for while waiting for the request of the
+// asked origin to be reported. A bound, so a busy page cannot grow this.
+constexpr size_t kMaxPendingRequests = 64;
+
+// Runs `done` in a task of its own: never from inside a mojo or DevTools callback, because running
+// it may destroy the caller, the reader and the tab.
+void PostValues(ValuesCallback done, Values values) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](ValuesCallback done, Values values) { std::move(done).Run(std::move(values)); },
+          std::move(done), std::move(values)));
+}
+
+// --- Cookies ---
+
+// The replies of one ReadCookies call, filled in by origin; `done` is posted after the last one.
+struct CookieRead {
+  std::vector<Item> items;
+  Values values;
+  size_t pending = 0;
+  ValuesCallback done;
+  // Held until the answer is posted: the ato must not go to sleep mid-read (closing its last
+  // window starts that; the caller wakes it, and this keeps it awake until the values are here).
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive;
+};
+
+void ReadCookiesFromStore(Profile* profile, const std::vector<Item>& items, ValuesCallback done) {
+  auto read = std::make_shared<CookieRead>();
+  read->items = items;
+  read->values.resize(items.size());
+  read->done = std::move(done);
+  read->keep_alive =
+      ScopedProfileKeepAlive::TryAcquire(profile, ProfileKeepAliveOrigin::kHeadlessCommand);
+
+  // One call per origin: the items may come from several.
+  std::map<std::string, std::vector<size_t>> by_origin;
+  for (size_t i = 0; i < items.size(); ++i) {
+    by_origin[items[i].origin.Serialize()].push_back(i);
+  }
+  if (by_origin.empty()) {
+    PostValues(std::move(read->done), std::move(read->values));
+    return;
+  }
+  read->pending = by_origin.size();
+  network::mojom::CookieManager* cookies =
+      profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess();
+  for (auto& entry : by_origin) {
+    // The first cookie of the list with that name: same order the ato would send it in.
+    const std::vector<size_t>& indices = entry.second;
+    const GURL url = items[indices.front()].origin.GetURL();
+    cookies->GetCookieList(
+        url, net::CookieOptions::MakeAllInclusive(), net::CookiePartitionKeyCollection(),
+        base::BindOnce(
+            [](std::shared_ptr<CookieRead> read, std::vector<size_t> indices,
+               const std::vector<net::CookieWithAccessResult>& cookies,
+               const std::vector<net::CookieWithAccessResult>&) {
+              for (size_t index : indices) {
+                for (const net::CookieWithAccessResult& cookie : cookies) {
+                  if (cookie.cookie.Name() == read->items[index].name) {
+                    read->values[index] = cookie.cookie.Value();
+                    break;
+                  }
+                }
+              }
+              if (--read->pending > 0) {
+                return;
+              }
+              PostValues(std::move(read->done), std::move(read->values));
+            },
+            read, indices));
+  }
+}
+
+// --- localStorage and headers of a hidden tab ---
+
+class PageRead : public PageReader,
+                 public content::WebContentsObserver,
+                 public content::DevToolsAgentHostClient {
+ public:
+  PageRead(content::WebContents* tab,
+           const url::Origin& origin,
+           const std::vector<Item>& items,
+           ValuesCallback done)
+      : content::WebContentsObserver(tab),
+        origin_(origin),
+        items_(items),
+        values_(items.size()),
+        done_(std::move(done)) {
+    // The ato goes to sleep when its last window closes, and the caller may have woken it a
+    // moment before that: hold it until this reader is gone (the release is posted by the
+    // keep-alive itself, after `done`).
+    keep_alive_ = ScopedProfileKeepAlive::TryAcquire(
+        Profile::FromBrowserContext(tab->GetBrowserContext())->GetOriginalProfile(),
+        ProfileKeepAliveOrigin::kHeadlessCommand);
+    StartHeaderCapture();
+  }
+
+  PageRead(const PageRead&) = delete;
+  PageRead& operator=(const PageRead&) = delete;
+  ~PageRead() override {
+    // Destroyed first, the reader never answers: nothing below is reached again.
+    finished_ = true;
+    timer_.Stop();
+    StopHeaderCapture();
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishLoad(content::RenderFrameHost* frame, const GURL&) override {
+    if (finished_ || frame != web_contents()->GetPrimaryMainFrame()) {
+      return;
+    }
+    // The page ended on another origin (a login redirect): nothing of this origin to read.
+    if (frame->GetLastCommittedOrigin() != origin_) {
+      return Finish();
+    }
+    loaded_ = true;
+    ReadStorages();
+    // A request with the header may still come: give it a moment, then answer with what is here.
+    if (HasUnreadHeaders()) {
+      timer_.Start(FROM_HERE, kHeaderWait,
+                   base::BindOnce(&PageRead::Finish, base::Unretained(this)));
+    }
+    MaybeFinish();
+  }
+  void WebContentsDestroyed() override {
+    // The tab is going away, so is its session: stop, keeping what was already read.
+    agent_host_ = nullptr;
+    Finish();
+  }
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override {
+    if (finished_ || agent_host != agent_host_.get()) {
+      return;
+    }
+    // Every header of every request passes here: keep only the ones asked, drop the rest.
+    std::optional<base::DictValue> notification = base::JSONReader::ReadDict(
+        std::string_view(reinterpret_cast<const char*>(message.data()), message.size()),
+        base::JSON_PARSE_RFC);
+    if (!notification) {
+      return;
+    }
+    const std::string* method = notification->FindString("method");
+    const base::DictValue* params = notification->FindDict("params");
+    if (!method || !params) {
+      return;  // the reply to Network.enable
+    }
+    if (*method == "Network.requestWillBeSent") {
+      OnRequestWillBeSent(*params);
+    } else if (*method == "Network.requestWillBeSentExtraInfo") {
+      OnRequestWillBeSentExtraInfo(*params);
+    }
+  }
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override {
+    if (finished_ || agent_host != agent_host_.get()) {
+      return;
+    }
+    agent_host_ = nullptr;
+    // Nothing more will come from the tab's session; a page that already loaded may answer now.
+    if (loaded_) {
+      Finish();
+    }
+  }
+
+ private:
+  // The tab's internal DevTools session: it sees the requests the page makes, including the first
+  // one (this runs before the caller loads the page).
+  void StartHeaderCapture() {
+    if (!HasHeaderItems()) {
+      return;
+    }
+    agent_host_ = content::DevToolsAgentHost::GetOrCreateFor(web_contents());
+    if (!agent_host_ || !agent_host_->AttachClient(this)) {
+      agent_host_ = nullptr;
+      return;
+    }
+    const std::string enable = R"({"id":1,"method":"Network.enable"})";
+    agent_host_->DispatchProtocolMessage(this, base::as_byte_span(enable));
+  }
+
+  // Detaches without touching this reader again: safe from the destructor only.
+  void StopHeaderCapture() {
+    if (!agent_host_) {
+      return;
+    }
+    agent_host_->DetachClient(this);
+    agent_host_ = nullptr;
+  }
+
+  void ReadStorages() {
+    content::RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (items_[i].type != "localStorage") {
+        continue;
+      }
+      ++storage_reads_;
+      // An isolated world reads the key the page sees, but the page cannot see or patch the read.
+      // The name is quoted, so a quote or a backslash in it cannot break out of the string.
+      const std::u16string script =
+          u"localStorage.getItem(" +
+          base::UTF8ToUTF16(base::GetQuotedJSONString(items_[i].name)) + u")";
+      frame->ExecuteJavaScriptInIsolatedWorld(
+          script, base::BindOnce(&PageRead::GotStorage, weak_factory_.GetWeakPtr(), i),
+          ISOLATED_WORLD_ID_CHROME_INTERNAL);
+    }
+  }
+
+  void GotStorage(size_t index, base::Value result) {
+    --storage_reads_;
+    // A missing key is null; an empty string is a value.
+    if (const std::string* value = result.GetIfString()) {
+      values_[index] = *value;
+    }
+    MaybeFinish();
+  }
+
+  void OnRequestWillBeSent(const base::DictValue& params) {
+    const std::string* request_id = params.FindString("requestId");
+    const base::DictValue* request = params.FindDict("request");
+    if (!request_id || !request) {
+      return;
+    }
+    const std::string* url = request->FindString("url");
+    if (!url) {
+      return;
+    }
+    if (url::Origin::Create(GURL(*url)) != origin_) {
+      extra_headers_.erase(*request_id);  // another origin: never kept
+      return;
+    }
+    // Only the requests of the asked origin are followed from here on.
+    if (our_requests_.size() >= kMaxPendingRequests) {
+      our_requests_.clear();
+    }
+    our_requests_.insert(*request_id);
+    if (const base::DictValue* headers = request->FindDict("headers")) {
+      TakeHeaders(*headers);
+    }
+    // Extra info may have been reported before the request itself.
+    if (auto early = extra_headers_.find(*request_id); early != extra_headers_.end()) {
+      TakeHeaders(early->second);
+      extra_headers_.erase(early);
+    }
+  }
+
+  void OnRequestWillBeSentExtraInfo(const base::DictValue& params) {
+    const std::string* request_id = params.FindString("requestId");
+    const base::DictValue* headers = params.FindDict("headers");
+    if (!request_id || !headers) {
+      return;
+    }
+    if (our_requests_.contains(*request_id)) {
+      TakeHeaders(*headers);
+      return;
+    }
+    // The request itself is not known yet: keep only the asked headers until it is, so nothing
+    // else of the wire is ever held.
+    if (extra_headers_.contains(*request_id)) {
+      return;
+    }
+    base::DictValue asked;
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (items_[i].type != "header" || values_[i]) {
+        continue;
+      }
+      for (const auto [key, value] : *headers) {
+        if (!base::EqualsCaseInsensitiveASCII(key, items_[i].name)) {
+          continue;
+        }
+        if (const std::string* text = value.GetIfString()) {
+          asked.Set(key, *text);
+        }
+        break;
+      }
+    }
+    if (asked.empty()) {
+      return;
+    }
+    if (extra_headers_.size() >= kMaxPendingRequests) {
+      extra_headers_.clear();
+    }
+    extra_headers_[*request_id] = std::move(asked);
+  }
+
+  // Keeps the asked headers of a request of the origin, first one wins.
+  void TakeHeaders(const base::DictValue& headers) {
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (items_[i].type != "header" || values_[i]) {
+        continue;
+      }
+      for (const auto [key, value] : headers) {
+        if (!base::EqualsCaseInsensitiveASCII(key, items_[i].name)) {
+          continue;
+        }
+        if (const std::string* text = value.GetIfString()) {
+          values_[i] = *text;
+        }
+        break;
+      }
+    }
+    if (!HasUnreadHeaders()) {
+      // Everything asked is here: the identifiers have no more use.
+      our_requests_.clear();
+      extra_headers_.clear();
+    }
+    MaybeFinish();
+  }
+
+  bool HasHeaderItems() const {
+    for (const Item& item : items_) {
+      if (item.type == "header") {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool HasUnreadHeaders() const {
+    for (size_t i = 0; i < items_.size(); ++i) {
+      if (items_[i].type == "header" && !values_[i]) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  void MaybeFinish() {
+    if (finished_ || !loaded_ || storage_reads_ > 0) {
+      return;
+    }
+    // While the session lives, a missing header may still arrive (the timer bounds the wait).
+    if (agent_host_ && HasUnreadHeaders()) {
+      return;
+    }
+    Finish();
+  }
+
+  // Answers once, in a task of its own; after this, nothing here touches the tab or its session.
+  void Finish() {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    timer_.Stop();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PageRead::Deliver, weak_factory_.GetWeakPtr(), std::move(values_)));
+  }
+
+  // Delivers, and the caller may destroy this reader and the tab right here: touch nothing after.
+  void Deliver(Values values) { std::move(done_).Run(std::move(values)); }
+
+  const url::Origin origin_;
+  const std::vector<Item> items_;
+  Values values_;  // one per item, in the order of `items_`; never logged
+  ValuesCallback done_;
+  size_t storage_reads_ = 0;
+  bool loaded_ = false;
+  bool finished_ = false;
+  scoped_refptr<content::DevToolsAgentHost> agent_host_;
+  std::unique_ptr<ScopedProfileKeepAlive> keep_alive_;  // the ato, while this reader lives
+  std::map<std::string, base::DictValue> extra_headers_;  // only the asked headers, by requestId
+  std::set<std::string> our_requests_;                    // requests of the asked origin
+  base::OneShotTimer timer_;
+
+  base::WeakPtrFactory<PageRead> weak_factory_{this};
+};
+
+}  // namespace
+
+void ReadCookies(Profile* profile, const std::vector<Item>& items, ValuesCallback done) {
+  ReadCookiesFromStore(profile, items, std::move(done));
+}
+
+std::unique_ptr<PageReader> ReadFromPage(content::WebContents* tab,
+                                         const url::Origin& origin,
+                                         const std::vector<Item>& items,
+                                         ValuesCallback done) {
+  return std::make_unique<PageRead>(tab, origin, items, std::move(done));
+}
+
+}  // namespace agens::bridge::session
diff --git a/chrome/browser/agens/bridge/session_read.h b/chrome/browser/agens/bridge/session_read.h
new file mode 100644
index 0000000000..ef8bfc467e
--- /dev/null
+++ b/chrome/browser/agens/bridge/session_read.h
@@ -0,0 +1,95 @@
+// Copyright 2026 SugiyamaLabs.
+// Reading the values of session items: the one piece of `session` and `renew` that touches a
+// secret (docs/protocolo.md, "session", "renew"; docs/sessao.md). session_ops.cc does everything
+// around it: validation, the approval sheet, loading the ato, the hidden tab, the timeout, the
+// reply, session.lost. These functions only fetch values. session_read.cc is a stub that finds
+// nothing; tools/gates/sessao.sh says which checks wait for it.
+//
+// Rules for both functions:
+// - UI thread: they are called on it, and `done` runs on it.
+// - `done` runs at most once, always from a task of its own (post it): never from inside the
+//   call itself, nor from inside an observer, mojo or DevTools callback of the tab, because
+//   running it may destroy the reader and the tab at once. Touch nothing after it. It gets exactly
+//   one entry per item, in the order of `items`: the value, or nullopt when that item does not
+//   exist or cannot be read. An empty string is a value (the cookie exists, empty).
+// - Values reach only `done`: never a log line (LOG, VLOG, DVLOG, the console), a crash key, a
+//   histogram, a pref, a file or an error message. Nothing here needs logging.
+// - Only the items asked: never read, keep or return other cookies, keys or headers (filter as
+//   early as possible and drop the rest), and keep a value no longer than it takes to run `done`.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_SESSION_READ_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_SESSION_READ_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "chrome/browser/agens/bridge/session_need.h"
+#include "url/origin.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace agens::bridge::session {
+
+// One entry per item asked, same order: the value, or nullopt.
+using Values = std::vector<std::optional<std::string>>;
+using ValuesCallback = base::OnceCallback<void(Values)>;
+
+// Cookie items, read straight from the ato's cookie store (no page involved).
+// - `profile`: the ato, loaded. Valid during the call only: do not keep it.
+// - `items`: all of type "cookie", 1 to kMaxItems, possibly of several origins.
+// - For each item: the value of the cookie named `name` that the ato would send to
+//   `origin.GetURL()`, httpOnly included; when several match (path, domain), the first of the
+//   list. Pointer: the ato's
+//     profile->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess()->GetCookieList(
+//         url, net::CookieOptions::MakeAllInclusive(), net::CookiePartitionKeyCollection(), ...)
+//   is the same call HasCookie() in session_ops.cc makes (it only checks the name).
+// - If the store goes away (the profile closes, the network service restarts), mojo drops the
+//   callback and `done` never runs: fine, the caller has a timeout.
+void ReadCookies(Profile* profile, const std::vector<Item>& items, ValuesCallback done);
+
+// Reads the page items of one origin while it lives. Destroying it stops everything: observers
+// removed, DevTools session detached, and `done` never runs afterwards (weak pointers).
+class PageReader {
+ public:
+  virtual ~PageReader() = default;
+};
+
+// localStorage and header items of `origin`, from a page of that origin.
+// - `tab`: a hidden WebContents of the ato, in no window, without a delegate, created by the
+//   caller. This is called right before the caller loads `origin.GetURL()` in it, so a DevTools
+//   session attached here sees the very first request. The caller owns `tab` and the returned
+//   reader, and always destroys the reader before the tab: when `done` has run, when its
+//   timeout passes (kPageWait in session_ops.cc), when the client disconnects or when the ato's
+//   profile is about to go. Never navigate, show or close `tab`.
+// - `items`: all of `origin`, of type "localStorage" or "header", 1 to kMaxItems.
+// - "localStorage": the value of key `name` in the localStorage of `origin`, once the main frame
+//   has a loaded document of that origin. Missing key: nullopt. The page ended on another
+//   origin (a login redirect): nullopt. Pointers: content::WebContentsObserver (DidFinishLoad,
+//   PrimaryMainFrame()->GetLastCommittedOrigin()), then localStorage.getItem in an isolated
+//   world (RenderFrameHost::ExecuteJavaScriptInIsolatedWorld, chrome_isolated_world_ids.h) so
+//   the page cannot see or patch it, or DevTools DOMStorage.getDOMStorageItems.
+// - "header": the value of header `name` (case-insensitive) on a request the page itself makes
+//   to a URL of `origin` while the reader lives; the first one wins. Pointers: an internal
+//   DevTools session, content::DevToolsAgentHost::GetOrCreateFor(tab)->AttachClient(client) with
+//   a content::DevToolsAgentHostClient; send Network.enable; read Network.requestWillBeSent
+//   (params.request.url, params.request.headers) and Network.requestWillBeSentExtraInfo
+//   (params.headers, as sent on the wire, matched by requestId). DispatchProtocolMessage gets
+//   every header of every request: parse it, keep only the asked header, drop the message, never
+//   log it. AgentHostClosed: nothing more will come.
+// - When to run `done`: once every item has its value, or once nothing more can come (e.g. a
+//   few seconds after the page finished loading without the request). Not running it at all is
+//   allowed: the caller's timeout then answers with what is missing.
+std::unique_ptr<PageReader> ReadFromPage(content::WebContents* tab,
+                                         const url::Origin& origin,
+                                         const std::vector<Item>& items,
+                                         ValuesCallback done);
+
+}  // namespace agens::bridge::session
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_SESSION_READ_H_
diff --git a/chrome/browser/agens/bridge/ui_answer.cc b/chrome/browser/agens/bridge/ui_answer.cc
new file mode 100644
index 0000000000..63b6439c7c
--- /dev/null
+++ b/chrome/browser/agens/bridge/ui_answer.cc
@@ -0,0 +1,188 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/ui_answer.h"
+
+#include <algorithm>
+#include <initializer_list>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "chrome/browser/agens/bridge/control_keys.h"
+
+namespace agens::bridge {
+
+namespace {
+
+// Only `id`, `op`, `ask`, `cancel` and the kind's own keys.
+bool OnlyKeys(const base::DictValue& body, std::initializer_list<std::string_view> own) {
+  for (const auto [key, value] : body) {
+    if (key == "id" || key == "op" || key == "ask" || key == "cancel") continue;
+    bool known = false;
+    for (std::string_view k : own) known = known || key == k;
+    if (!known) return false;
+  }
+  return true;
+}
+
+bool IsText(const base::Value* value) {
+  return value && value->is_string() && value->GetString().size() <= kMaxUiTextBytes;
+}
+
+bool IsAbsolutePath(const base::Value& value) {
+  if (!IsText(&value)) return false;
+  const std::string& path = value.GetString();
+  return !path.empty() && path[0] == '/' && path.find('\0') == std::string::npos &&
+         !base::FilePath(path).ReferencesParent();
+}
+
+UiAnswer Pick(bool ok) {
+  return ok ? UiAnswer::kAnswer : UiAnswer::kBadRequest;
+}
+
+// A DevTools menu (context.items) offers `id`: an entry with it that can be chosen, at any depth.
+bool OffersItem(const base::ListValue* items, int id) {
+  if (!items) return false;
+  for (const base::Value& value : *items) {
+    const base::DictValue* item = value.GetIfDict();
+    if (!item) continue;
+    if (const base::ListValue* submenu = item->FindList("items")) {
+      if (OffersItem(submenu, id)) return true;
+      continue;
+    }
+    if (item->FindInt("id") == id && !item->FindBool("disabled").value_or(false)) return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+UiAnswer CheckUiAnswer(bool from_host, const base::DictValue* asked_or_null, const base::DictValue& body) {
+  if (!from_host) return UiAnswer::kUnauthorized;
+  if (!body.FindString("ask")) return UiAnswer::kBadRequest;
+  if (!asked_or_null) return UiAnswer::kNotFound;
+  const base::DictValue& asked = *asked_or_null;
+  const std::string* kind = asked.FindString("kind");
+  if (!kind) return UiAnswer::kBadRequest;
+  if (const base::Value* cancel = body.Find("cancel")) {
+    return cancel->is_bool() && cancel->GetBool() && OnlyKeys(body, {}) ? UiAnswer::kCancel : UiAnswer::kBadRequest;
+  }
+  if (*kind == "select") {
+    if (!OnlyKeys(body, {"index"})) return UiAnswer::kBadRequest;
+    std::optional<int> index = body.FindInt("index");
+    const base::ListValue* items = asked.FindList("items");
+    if (!index || !items || *index < 0 || static_cast<size_t>(*index) >= items->size()) return UiAnswer::kBadRequest;
+    const base::DictValue* item = (*items)[*index].GetIfDict();
+    return Pick(item && !item->FindBool("disabled").value_or(false) && !item->FindBool("group").value_or(false));
+  }
+  if (*kind == "context_menu") {
+    if (!OnlyKeys(body, {"action", "item", "dock"})) return UiAnswer::kBadRequest;
+    const std::string* action = body.FindString("action");
+    const base::Value* item = body.Find("item");
+    const base::Value* dock = body.Find("dock");
+    if (dock && !(action && *action == "inspect" && dock->is_string() && IsDevToolsDock(dock->GetString()))) {
+      return UiAnswer::kBadRequest;
+    }
+    if (item) return Pick(!action && item->is_int() && OffersItem(asked.FindListByDottedPath("context.items"), item->GetInt()));
+    const base::ListValue* actions = asked.FindListByDottedPath("context.actions");
+    return Pick(action && actions && actions->contains(*action));
+  }
+  if (*kind == "dialog") {
+    if (!OnlyKeys(body, {"accept", "text"})) return UiAnswer::kBadRequest;
+    std::optional<bool> accept = body.FindBool("accept");
+    const base::Value* text = body.Find("text");
+    const std::string* type = asked.FindString("type");
+    if (!accept) return UiAnswer::kBadRequest;
+    return Pick(!text || (IsText(text) && *accept && type && *type == "prompt"));
+  }
+  if (*kind == "file") {
+    const base::ListValue* paths = body.FindList("paths");
+    const std::string* mode = asked.FindString("mode");
+    if (!OnlyKeys(body, {"paths"}) || !paths || !mode) return UiAnswer::kBadRequest;
+    if (paths->empty()) return UiAnswer::kCancel;
+    if (paths->size() > (*mode == "open_multiple" ? kMaxUiPaths : 1)) return UiAnswer::kBadRequest;
+    for (const base::Value& path : *paths) {
+      if (!IsAbsolutePath(path)) return UiAnswer::kBadRequest;
+    }
+    return UiAnswer::kAnswer;
+  }
+  if (*kind == "auth") {
+    return Pick(OnlyKeys(body, {"username", "password"}) && IsText(body.Find("username")) &&
+                IsText(body.Find("password")));
+  }
+  if (*kind == "permission") {
+    const base::Value* remember = body.Find("remember");
+    return Pick(OnlyKeys(body, {"allow", "remember"}) && body.FindBool("allow") && (!remember || remember->is_bool()));
+  }
+  if (*kind == "extension") {
+    if (!OnlyKeys(body, {"allow", "atos"}) || !body.FindBool("allow")) return UiAnswer::kBadRequest;
+    const base::Value* atos = body.Find("atos");
+    if (!atos) return UiAnswer::kAnswer;
+    // Only with allow, only atos the ask offered, each once.
+    const base::ListValue* offered = asked.FindList("atos");
+    if (!*body.FindBool("allow") || !atos->is_list() || !offered) return UiAnswer::kBadRequest;
+    std::vector<std::string_view> seen;
+    for (const base::Value& ato : atos->GetList()) {
+      if (!ato.is_string() || std::ranges::contains(seen, ato.GetString())) return UiAnswer::kBadRequest;
+      const bool known = std::ranges::any_of(*offered, [&](const base::Value& o) {
+        const std::string* id = o.is_dict() ? o.GetDict().FindString("id") : nullptr;
+        return id && *id == ato.GetString();
+      });
+      if (!known) return UiAnswer::kBadRequest;
+      seen.push_back(ato.GetString());
+    }
+    return UiAnswer::kAnswer;
+  }
+  return UiAnswer::kBadRequest;
+}
+
+void ClipUiAsk(base::DictValue& fields) {
+  const std::string* kind = fields.FindString("kind");
+  if (!kind) return;
+  auto clip = [](base::DictValue& dict, std::string_view key, size_t max) {
+    if (std::string* text = dict.FindString(key)) *text = ClipChars(std::move(*text), max);
+  };
+  auto clip_list = [&](base::ListValue* list, size_t max_items) {
+    if (!list) return false;
+    const bool cut = list->size() > max_items;
+    if (cut) list->erase(list->begin() + max_items, list->end());
+    for (base::Value& item : *list) {
+      if (item.is_string()) item = base::Value(ClipChars(item.GetString(), kMaxUiLabelChars));
+      if (item.is_dict()) clip(item.GetDict(), "label", kMaxUiLabelChars);
+    }
+    return cut;
+  };
+  if (*kind == "dialog") {
+    clip(fields, "message", kMaxUiDialogChars);
+    clip(fields, "default", kMaxUiDialogChars);
+  } else if (*kind == "select") {
+    if (clip_list(fields.FindList("items"), kMaxUiSelectItems)) fields.Set("truncated", true);
+    const std::optional<int> selected = fields.FindInt("selected");
+    if (selected && static_cast<size_t>(*selected) >= kMaxUiSelectItems) fields.Set("selected", -1);
+  } else if (*kind == "context_menu") {
+    if (base::DictValue* context = fields.FindDict("context")) clip(*context, "selection", kMaxUiLabelChars);
+  } else if (*kind == "auth") {
+    clip(fields, "realm", kMaxUiLabelChars);
+  } else if (*kind == "extension") {
+    clip(fields, "name", kMaxUiLabelChars);
+    clip(fields, "version", kMaxUiLabelChars);
+    clip_list(fields.FindList("permissions"), kMaxUiTexts);
+  }
+}
+
+bool PathsFitMode(std::string_view mode, const base::ListValue& paths) {
+  for (const base::Value& value : paths) {
+    if (!value.is_string()) return false;
+    const base::FilePath path(value.GetString());
+    if (mode == "folder") {
+      if (!base::DirectoryExists(path)) return false;
+    } else if (mode == "save") {
+      if (base::DirectoryExists(path) || !base::DirectoryExists(path.DirName())) return false;
+    } else if (!base::PathExists(path) || base::DirectoryExists(path)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/ui_answer.h b/chrome/browser/agens/bridge/ui_answer.h
new file mode 100644
index 0000000000..0b0ecb5d32
--- /dev/null
+++ b/chrome/browser/agens/bridge/ui_answer.h
@@ -0,0 +1,54 @@
+// Copyright 2026 SugiyamaLabs.
+// What the host may answer to a ui.ask (docs/protocolo.md, "Passo 5.3"). Pure logic, so
+// ui_answer_selfcheck.cc runs it with only //base; the engine side is ui_ops.h.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_UI_ANSWER_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_UI_ANSWER_H_
+
+#include <string_view>
+
+#include "base/values.h"
+
+namespace agens::bridge {
+
+inline constexpr size_t kMaxOpenUiAsks = 16;          // sent and waiting, all tabs together
+inline constexpr size_t kMaxOpenUiAsksPerTab = 4;     // so one tab can't take the others' turn
+inline constexpr size_t kMaxUiDialogChars = 1024;     // a dialog's message and prompt default
+inline constexpr size_t kMaxUiLabelChars = 200;       // a select item, realm, selection, extension texts
+inline constexpr size_t kMaxUiSelectItems = 1000;
+inline constexpr size_t kMaxUiTexts = 100;            // an extension's permission texts
+inline constexpr size_t kMaxUiTextBytes = 64 * 1024;  // prompt text, username, password, a path
+inline constexpr size_t kMaxUiPaths = 100;            // file, open_multiple
+
+inline constexpr size_t kMaxUiMenuItems = 500;        // a DevTools menu's items, submenus included
+inline constexpr int kMaxUiMenuDepth = 4;             // its submenus in submenus
+
+enum class UiAnswer { kAnswer, kCancel, kBadRequest, kNotFound, kUnauthorized };
+
+// Where DevTools goes (view.inspect, view.devtools.dock, the right click's inspect).
+inline bool IsDevToolsDock(std::string_view dock) {
+  return dock == "bottom" || dock == "right" || dock == "window";
+}
+
+// `body` is the whole ui.answer request; `asked` the open ui.ask its "ask" names, as sent (kind
+// and fields), or null when none is open by that name. In order: kUnauthorized when not
+// `from_host`; kBadRequest without an "ask" string; kNotFound when `asked` is null; kCancel for
+// {cancel: true} alone and for a file answer with no paths; kBadRequest when a field is missing,
+// has the wrong type, doesn't belong to the kind, or picks what the ask didn't offer (a disabled
+// or header item, an action outside `actions`, text outside an accepted prompt, a relative path or
+// too many). A context_menu answer is `action` or `item` (the `id` of an entry of
+// `context.items` that is not disabled, a separator, a group header or a submenu); `dock` goes
+// only with the action inspect.
+UiAnswer CheckUiAnswer(bool from_host, const base::DictValue* asked, const base::DictValue& body);
+
+// Cuts what the page controls in a ui.ask of `fields["kind"]` to the limits above; a select's
+// list past kMaxUiSelectItems keeps the first ones and gets "truncated": true.
+void ClipUiAsk(base::DictValue& fields);
+
+// A file answer's `paths` against the disk, for `mode`: open and open_multiple want existing
+// files that aren't folders, folder an existing folder, save a path whose folder exists and that
+// isn't a folder itself. Blocks (it stats each one).
+bool PathsFitMode(std::string_view mode, const base::ListValue& paths);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_UI_ANSWER_H_
diff --git a/chrome/browser/agens/bridge/ui_answer_selfcheck.cc b/chrome/browser/agens/bridge/ui_answer_selfcheck.cc
new file mode 100644
index 0000000000..46b9e9d930
--- /dev/null
+++ b/chrome/browser/agens/bridge/ui_answer_selfcheck.cc
@@ -0,0 +1,216 @@
+// Copyright 2026 SugiyamaLabs.
+// Assert-based check of ui_answer.h, run by agens_bridge_selfcheck (protocol_selfcheck.cc).
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/agens/bridge/ui_answer.h"
+
+using namespace agens::bridge;
+
+#define UI_CHECK(x)                                                       \
+  do {                                                                    \
+    if (!(x)) {                                                           \
+      std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #x); \
+      std::exit(1);                                                       \
+    }                                                                     \
+  } while (0)
+
+static base::DictValue Json(const std::string& json) {
+  std::optional<base::Value> v = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  UI_CHECK(v && v->is_dict());
+  return std::move(v->GetDict());
+}
+
+// The answer `json` (plus id, op and ask) to the ask `asked`.
+static UiAnswer Check(const std::string& asked, const std::string& json) {
+  base::DictValue body = Json(json);
+  body.Set("id", 1);
+  body.Set("op", "ui.answer");
+  body.Set("ask", "u1");
+  const base::DictValue open = Json(asked);
+  return CheckUiAnswer(/*from_host=*/true, &open, body);
+}
+
+void RunUiAnswerChecks() {
+  constexpr UiAnswer kOk = UiAnswer::kAnswer, kCancel = UiAnswer::kCancel, kBad = UiAnswer::kBadRequest;
+
+  // Who may answer, and which ask.
+  {
+    const base::DictValue asked = Json(R"({"kind":"extension"})");
+    const base::DictValue answer = Json(R"({"id":1,"op":"ui.answer","ask":"u1","allow":true})");
+    UI_CHECK(CheckUiAnswer(false, &asked, answer) == UiAnswer::kUnauthorized);
+    UI_CHECK(CheckUiAnswer(false, nullptr, Json(R"({"id":1,"op":"ui.answer"})")) == UiAnswer::kUnauthorized);
+    UI_CHECK(CheckUiAnswer(true, nullptr, answer) == UiAnswer::kNotFound);
+    UI_CHECK(CheckUiAnswer(true, &asked, answer) == kOk);
+    UI_CHECK(CheckUiAnswer(true, &asked, Json(R"({"id":1,"op":"ui.answer","allow":true})")) == kBad);
+    UI_CHECK(CheckUiAnswer(true, nullptr, Json(R"({"id":1,"op":"ui.answer","ask":4})")) == kBad);
+  }
+
+  // Cancel, for every kind; nothing else may come with it.
+  const std::string select =
+      R"({"kind":"select","items":[{"label":"Brasil"},{"label":"Chile","disabled":true},{"label":"Sul","group":true},{"label":"Peru"}],"selected":0})";
+  UI_CHECK(Check(select, R"({"cancel":true})") == kCancel);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"cancel":true})") == kCancel);
+  UI_CHECK(Check(select, R"({"cancel":false})") == kBad);
+  UI_CHECK(Check(select, R"({"cancel":1})") == kBad);
+  UI_CHECK(Check(select, R"({"cancel":true,"index":0})") == kBad);
+  UI_CHECK(Check(R"({"kind":"nope"})", R"({"allow":true})") == kBad);
+  UI_CHECK(Check(R"({})", R"({"cancel":true})") == kBad);
+
+  // select: an index of an item that can be picked.
+  UI_CHECK(Check(select, R"({"index":0})") == kOk && Check(select, R"({"index":3})") == kOk);
+  UI_CHECK(Check(select, R"({"index":1})") == kBad);  // disabled
+  UI_CHECK(Check(select, R"({"index":2})") == kBad);  // optgroup header
+  UI_CHECK(Check(select, R"({"index":4})") == kBad && Check(select, R"({"index":-1})") == kBad);
+  UI_CHECK(Check(select, R"({"index":"0"})") == kBad && Check(select, R"({"index":0.5})") == kBad);
+  UI_CHECK(Check(select, R"({})") == kBad && Check(select, R"({"index":0,"action":"copy"})") == kBad);
+
+  // context_menu: one of the actions offered.
+  const std::string menu = R"({"kind":"context_menu","context":{"actions":["copy","reload"]}})";
+  UI_CHECK(Check(menu, R"({"action":"reload"})") == kOk);
+  UI_CHECK(Check(menu, R"({"action":"paste"})") == kBad && Check(menu, R"({"action":1})") == kBad);
+  // inspect (view.inspect's twin) only when the engine offered it: DevTools allowed, no agent.
+  UI_CHECK(Check(menu, R"({"action":"inspect"})") == kBad);
+  UI_CHECK(Check(R"({"kind":"context_menu","context":{"actions":["reload","inspect"]}})", R"({"action":"inspect"})") == kOk);
+  UI_CHECK(Check(menu, R"({})") == kBad && Check(R"({"kind":"context_menu"})", R"({"action":"copy"})") == kBad);
+  // inspect may say where DevTools goes; nothing else carries a dock.
+  const std::string inspect = R"({"kind":"context_menu","context":{"actions":["reload","inspect"]}})";
+  UI_CHECK(Check(inspect, R"({"action":"inspect","dock":"bottom"})") == kOk);
+  UI_CHECK(Check(inspect, R"({"action":"inspect","dock":"right"})") == kOk);
+  UI_CHECK(Check(inspect, R"({"action":"inspect","dock":"window"})") == kOk);
+  UI_CHECK(Check(inspect, R"({"action":"inspect","dock":"left"})") == kBad);
+  UI_CHECK(Check(inspect, R"({"action":"inspect","dock":1})") == kBad);
+  UI_CHECK(Check(inspect, R"({"action":"reload","dock":"bottom"})") == kBad);
+  // A DevTools view's own menu: the id of an item that can be chosen, at any depth.
+  const std::string devtools = R"({"kind":"context_menu","context":{"actions":["copy"],"items":[
+      {"id":3,"label":"Edit attribute"},{"separator":true},{"id":4,"label":"Off","disabled":true},
+      {"label":"Copy","items":[{"id":7,"label":"Copy selector"},{"label":"Sub","items":[{"id":9,"label":"Deep"}]}]},
+      {"label":"Header","group":true},{"id":5,"label":"Word wrap","checked":true}]}})";
+  UI_CHECK(Check(devtools, R"({"item":3})") == kOk && Check(devtools, R"({"item":5})") == kOk);
+  UI_CHECK(Check(devtools, R"({"item":7})") == kOk && Check(devtools, R"({"item":9})") == kOk);
+  UI_CHECK(Check(devtools, R"({"item":4})") == kBad);  // disabled
+  UI_CHECK(Check(devtools, R"({"item":8})") == kBad && Check(devtools, R"({"item":"3"})") == kBad);
+  UI_CHECK(Check(devtools, R"({"item":3,"action":"copy"})") == kBad);
+  UI_CHECK(Check(devtools, R"({"action":"copy"})") == kOk);
+  UI_CHECK(Check(menu, R"({"item":3})") == kBad);  // a page's menu has no items
+
+  // dialog: accept, and text only for an accepted prompt.
+  const std::string prompt = R"({"kind":"dialog","type":"prompt","message":"Nome?","default":"a"})";
+  const std::string confirm = R"({"kind":"dialog","type":"confirm","message":"Sair?"})";
+  UI_CHECK(Check(prompt, R"({"accept":true,"text":"Ana"})") == kOk && Check(prompt, R"({"accept":false})") == kOk);
+  UI_CHECK(Check(prompt, R"({"accept":false,"text":"Ana"})") == kBad);
+  UI_CHECK(Check(confirm, R"({"accept":true})") == kOk && Check(confirm, R"({"accept":true,"text":"x"})") == kBad);
+  UI_CHECK(Check(confirm, R"({})") == kBad && Check(confirm, R"({"accept":"yes"})") == kBad);
+  UI_CHECK(Check(prompt, R"({"accept":true,"text":7})") == kBad);
+  UI_CHECK(Check(prompt, R"({"accept":true,"text":")" + std::string(kMaxUiTextBytes + 1, 'a') + "\"}") == kBad);
+  UI_CHECK(Check(confirm, R"({"accept":true,"allow":true})") == kBad);
+
+  // file: absolute paths, one unless open_multiple (up to 100); none is a cancel.
+  const std::string open = R"({"kind":"file","mode":"open","accept":[".png"]})";
+  const std::string multiple = R"({"kind":"file","mode":"open_multiple","accept":[]})";
+  UI_CHECK(Check(open, R"({"paths":["/tmp/a.png"]})") == kOk && Check(open, R"({"paths":[]})") == kCancel);
+  UI_CHECK(Check(open, R"({"paths":["/tmp/a","/tmp/b"]})") == kBad);
+  UI_CHECK(Check(multiple, R"({"paths":["/tmp/a","/tmp/b"]})") == kOk);
+  UI_CHECK(Check(open, R"({"paths":["a.png"]})") == kBad && Check(open, R"({"paths":["/tmp/../etc/x"]})") == kBad);
+  UI_CHECK(Check(open, R"({"paths":[""]})") == kBad && Check(open, R"({"paths":[1]})") == kBad);
+  UI_CHECK(Check(open, R"({"paths":"/tmp/a"})") == kBad && Check(open, R"({})") == kBad);
+  {
+    std::string many = R"({"paths":[)";
+    for (size_t i = 0; i <= kMaxUiPaths; ++i) many += std::string(i ? "," : "") + "\"/tmp/f\"";
+    UI_CHECK(Check(multiple, many + "]}") == kBad);
+  }
+
+  // auth: username and password, both strings.
+  const std::string auth = R"({"kind":"auth","origin":"https://a.example","realm":"r","proxy":false,"retry":false})";
+  UI_CHECK(Check(auth, R"({"username":"ana","password":"x"})") == kOk);
+  UI_CHECK(Check(auth, R"({"username":"","password":""})") == kOk);
+  UI_CHECK(Check(auth, R"({"username":"ana"})") == kBad && Check(auth, R"({"password":"x"})") == kBad);
+  UI_CHECK(Check(auth, R"({"username":"ana","password":1})") == kBad);
+  UI_CHECK(Check(auth, R"({"username":"ana","password":"x","remember":true})") == kBad);
+
+  // permission: allow, remember only with it; extension: allow alone.
+  const std::string permission = R"({"kind":"permission","origin":"https://a.example","permission":"camera"})";
+  UI_CHECK(Check(permission, R"({"allow":true})") == kOk && Check(permission, R"({"allow":false,"remember":true})") == kOk);
+  UI_CHECK(Check(permission, R"({"remember":true})") == kBad && Check(permission, R"({"allow":true,"remember":1})") == kBad);
+  UI_CHECK(Check(permission, R"({"allow":"yes"})") == kBad);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"allow":false})") == kOk);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"allow":true,"remember":true})") == kBad);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({})") == kBad);
+  // extension: atos, only with allow and only those the ask offered, each once.
+  const std::string atos = R"({"kind":"extension","ato":"Default","atos":[{"id":"Default"},{"id":"Profile 1"}]})";
+  UI_CHECK(Check(atos, R"({"allow":true})") == kOk && Check(atos, R"({"allow":true,"atos":[]})") == kOk);
+  UI_CHECK(Check(atos, R"({"allow":true,"atos":["Default","Profile 1"]})") == kOk);
+  UI_CHECK(Check(atos, R"({"allow":true,"atos":["Profile 9"]})") == kBad);
+  UI_CHECK(Check(atos, R"({"allow":true,"atos":["Profile 1","Profile 1"]})") == kBad);
+  UI_CHECK(Check(atos, R"({"allow":true,"atos":"Profile 1"})") == kBad && Check(atos, R"({"allow":true,"atos":[1]})") == kBad);
+  UI_CHECK(Check(atos, R"({"allow":false,"atos":["Profile 1"]})") == kBad);
+  UI_CHECK(Check(R"({"kind":"extension"})", R"({"allow":true,"atos":["Default"]})") == kBad);  // none offered
+
+  // What the page controls, cut before it goes out.
+  {
+    base::DictValue dialog = Json(R"({"kind":"dialog","type":"prompt"})");
+    dialog.Set("message", std::string(2000, 'm'));
+    dialog.Set("default", std::string(2000, 'd'));
+    ClipUiAsk(dialog);
+    UI_CHECK(dialog.FindString("message")->size() == kMaxUiDialogChars && dialog.FindString("default")->size() == kMaxUiDialogChars);
+    base::DictValue select = Json(R"({"kind":"select","selected":1500})");
+    base::ListValue items;
+    for (int i = 0; i < 1200; ++i) {
+      base::DictValue item;
+      item.Set("label", std::string(300, 'a'));
+      items.Append(std::move(item));
+    }
+    select.Set("items", std::move(items));
+    ClipUiAsk(select);
+    UI_CHECK(select.FindList("items")->size() == kMaxUiSelectItems && select.FindBool("truncated") == true);
+    UI_CHECK((*select.FindList("items"))[0].GetDict().FindString("label")->size() == kMaxUiLabelChars);
+    UI_CHECK(select.FindInt("selected") == -1);
+    std::string index_past = R"({"index":)" + base::NumberToString(kMaxUiSelectItems) + "}";
+    base::DictValue body = Json(index_past);
+    body.Set("ask", "u1");
+    UI_CHECK(CheckUiAnswer(true, &select, body) == kBad);  // only what was sent can be picked
+    base::DictValue small = Json(R"({"kind":"select","items":[{"label":"a"}],"selected":0})");
+    ClipUiAsk(small);
+    UI_CHECK(!small.Find("truncated") && small.FindInt("selected") == 0);
+    base::DictValue extension = Json(R"({"kind":"extension"})");
+    extension.Set("name", std::string(300, 'n'));
+    extension.Set("version", std::string(300, 'v'));
+    base::ListValue texts;
+    for (int i = 0; i < 150; ++i) texts.Append(std::string(300, 't'));
+    extension.Set("permissions", std::move(texts));
+    ClipUiAsk(extension);
+    UI_CHECK(extension.FindString("name")->size() == kMaxUiLabelChars && extension.FindString("version")->size() == kMaxUiLabelChars);
+    UI_CHECK(extension.FindList("permissions")->size() == kMaxUiTexts &&
+             (*extension.FindList("permissions"))[0].GetString().size() == kMaxUiLabelChars);
+    base::DictValue auth = Json(R"({"kind":"auth"})");
+    auth.Set("realm", std::string(300, 'r'));
+    ClipUiAsk(auth);
+    UI_CHECK(auth.FindString("realm")->size() == kMaxUiLabelChars);
+  }
+
+  // The paths against the disk.
+  base::ScopedTempDir dir;
+  UI_CHECK(dir.CreateUniqueTempDir());
+  const base::FilePath file = dir.GetPath().Append("a.png");
+  UI_CHECK(base::WriteFile(file, "x"));
+  auto list = [](std::initializer_list<base::FilePath> paths) {
+    base::ListValue l;
+    for (const base::FilePath& p : paths) l.Append(p.value());
+    return l;
+  };
+  const base::FilePath missing = dir.GetPath().Append("nope");
+  UI_CHECK(PathsFitMode("open", list({file})) && PathsFitMode("open_multiple", list({file, file})));
+  UI_CHECK(!PathsFitMode("open", list({dir.GetPath()})) && !PathsFitMode("open", list({missing})));
+  UI_CHECK(!PathsFitMode("open_multiple", list({file, missing})));
+  UI_CHECK(PathsFitMode("folder", list({dir.GetPath()})) && !PathsFitMode("folder", list({file})));
+  UI_CHECK(PathsFitMode("save", list({missing})) && PathsFitMode("save", list({file})));  // overwrite is the host's to ask
+  UI_CHECK(!PathsFitMode("save", list({dir.GetPath()})) && !PathsFitMode("save", list({missing.Append("b")})));
+
+  std::printf("agens bridge ui.answer: ok\n");
+}
