+  _fill.path = f;
+  _edge.path = e;
+  for (CGPathRef p : {(CGPathRef)fill, (CGPathRef)edge, f, e}) CGPathRelease(p);
+  [self refresh];
+}
+- (void)refresh {
+  _fill.fillColor = CG(kFloat, self);
+  _edge.strokeColor = CG(kLineStrong, self);
+}
+- (void)viewDidChangeEffectiveAppearance {
