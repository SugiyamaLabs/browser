+int agens_pref_get_int(AgensWindow* w, AgensPrefStore store, const char* name, int* out) {
+  const PrefService::Preference* p = Find(w, store, name, base::Value::Type::INTEGER);
+  if (!p) return 0;
+  *out = p->GetValue()->GetInt();
+  return 1;
+}
+int agens_pref_get_string(AgensWindow* w, AgensPrefStore store, const char* name, char* out, int size) {
+  const PrefService::Preference* p = Find(w, store, name, base::Value::Type::STRING);
+  if (!p || size <= 0) return 0;
+  const std::string& v = p->GetValue()->GetString();
+  const size_t n = std::min(v.size(), static_cast<size_t>(size - 1));
+  std::copy_n(v.data(), n, out);
+  out[n] = 0;
+  return 1;
+}
