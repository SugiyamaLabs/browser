+// The install sheet's "Onde instalar" (prototipos/extensoes.html #instalar): the radios turn the
+// ato list on and off, and the button says where it goes.
+@interface AgensInstallChoice : NSObject
+@property(nonatomic, strong) NSButton* only;
+@property(nonatomic, strong) NSButton* all;
+@property(nonatomic, strong) NSArray<NSButton*>* atos;  // identifier: the ato's id
+@property(nonatomic, strong) NSButton* install;
+@property(nonatomic, copy) NSString* atoName;
+- (void)changed:(id)sender;
+@end
+@implementation AgensInstallChoice
+@synthesize only = _only;
+@synthesize all = _all;
+@synthesize atos = _atos;
+@synthesize install = _install;
+@synthesize atoName = _atoName;
+- (void)changed:(id)sender {
+  const BOOL all = _all.state == NSControlStateValueOn;
+  int count = 0;
+  for (NSButton* ato in _atos) {
+    // The asking ato (and those that have it already) stay checked and locked.
+    if (ato.tag == 0) ato.enabled = all;
+    count += ato.state == NSControlStateValueOn;
+  }
+  _install.title = all && count > 1 ? [NSString stringWithFormat:@"Instalar em %d atos", count]
+                                    : [NSString stringWithFormat:@"Instalar no ato %@", _atoName];
+}
+// The ids the person chose: the checked ones under "Em todos os atos", else none (only this ato).
+- (std::vector<std::string>)chosen {
+  std::vector<std::string> ids;
+  if (_all.state != NSControlStateValueOn) return ids;
+  for (NSButton* ato in _atos) {
+    if (ato.state == NSControlStateValueOn && ato.tag != 2) ids.push_back(ato.identifier.UTF8String);
+  }
+  return ids;
+}
