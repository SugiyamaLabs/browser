+- (AgensRect)layoutForWidth:(int)width height:(int)height {
+  // Open column: two columns like the body below (buttons end where the tab column ends, the
+  // address has the page card's edges). Collapsed: the buttons follow the traffic lights.
+  // During the animation everything follows the current width: the buttons slide from the end
+  // of the column to after the traffic lights, and the labels switch at the halfway point.
+  const CGFloat side = _sideW;
+  const BOOL narrow = side < (kRail + kSide) / 2;
+  CGFloat columnEnd = kPad + side;
+  CGFloat navX = MAX(kLightsEnd, columnEnd - 118);
+  _toggle.frame = NSMakeRect(navX, 12, 28, 28);
+  _back.frame = NSMakeRect(navX + 30, 12, 28, 28);
+  _forward.frame = NSMakeRect(navX + 60, 12, 28, 28);
+  _reload.frame = NSMakeRect(navX + 90, 12, 28, 28);
+  CGFloat omniX = MAX(columnEnd + kGap, navX + 126);
+  _menu.frame = NSMakeRect(width - kPad - 28, 12, 28, 28);
+  CGFloat omniEnd = NSMinX(_menu.frame) - 4;
+  if (!_downloadsButton.hidden) {
+    _downloadsButton.frame = NSMakeRect(NSMinX(_menu.frame) - 30, 12, 28, 28);
+    omniEnd = NSMinX(_downloadsButton.frame) - 4;
+  }
+  _omni.frame = NSMakeRect(omniX, 9, omniEnd - omniX, 34);
+  _omniIcon.frame = NSMakeRect(12, 10, 14, 14);
+  _siteButton.frame = NSInsetRect(_omniIcon.frame, -6, -6);
+  _star.frame = NSMakeRect(NSWidth(_omni.frame) - 4 - 26, 4, 26, 26);
+  _address.frame = NSMakeRect(33, 8, NSMinX(_star.frame) - 6 - 33, 18);
+
+  // Column: ato title (prototype .space-title), separator, new tab, tabs.
+  CGFloat y = kToolbar;
+  CGFloat inset = narrow ? (side - 18) / 2 : 8;
+  _atoTile.frame = NSMakeRect(kPad + inset, y + 7, 18, 18);
+  _atoName.frame = NSMakeRect(kPad + 35, y + 7, kSide - 43, 18);
+  _atoName.hidden = narrow;
+  y += kRow + 6;
+  _separator.frame = NSMakeRect(kPad + (narrow ? 6 : 8), y, side - (narrow ? 12 : 16), 1);
+  y += 7;
+  _newTab.frame = NSMakeRect(kPad, y, side, kRow);
+  _newTabPlus.frame = NSMakeRect(narrow ? (side - 16) / 2 : 8, 8, 16, 16);
+  _newTabLabel.frame = NSMakeRect(34, 7, 150, 18);
+  _newTabLabel.hidden = narrow;
+  y += kRow + 1;
+
+  // Atos at the foot with a line above (prototype .spaces): a centered row when open, a column
+  // when collapsed. Only what fits (6 open, 5 collapsed); past that the last slot is "⋯" with the
+  // full list, and the current ato always stays in view. The warm dot marks the current one:
+  // under it, or to its left in the column.
+  const NSUInteger n = _atoButtons.count, cap = narrow ? 5 : 6;
+  const BOOL overflow = n > cap;
+  std::vector<int> shown;
+  for (int i = 0; i < (int)(overflow ? cap - 1 : n); ++i) shown.push_back(i);
+  if (overflow && _activeAto >= (int)shown.size()) shown.back() = _activeAto;
+  NSMutableArray<NSView*>* foot = [NSMutableArray array];
+  for (AgensAtoButton* b in _atoButtons) b.hidden = YES;
+  for (int i : shown) {
+    _atoButtons[i].hidden = NO;
+    [foot addObject:_atoButtons[i]];
+  }
+  _moreAtos.hidden = !overflow;
+  if (overflow) [foot addObject:_moreAtos];
+  [foot addObject:_addAto];
+  _atoDot.hidden = YES;
+  CGFloat footY;
+  if (!narrow) {
+    footY = height - kPad - kAtos;
+    _atosLine.frame = NSMakeRect(kPad, footY, side, 1);
+    CGFloat x = kPad + (side - foot.count * 32) / 2;
+    for (NSView* v in foot) {
+      v.frame = NSMakeRect(x, footY + 8, 30, 28);
+      if ([v isKindOfClass:AgensAtoButton.class] && ((AgensAtoButton*)v).selected) {
+        _atoDot.frame = NSMakeRect(x + 13, footY + 8 + 28 + 3, 4, 4);
+        _atoDot.hidden = NO;
+      }
+      x += 32;
+    }
+  } else {
+    footY = height - kPad - 8 - foot.count * 32;
+    _atosLine.frame = NSMakeRect(kPad + 6, footY, side - 12, 1);
+    CGFloat x = kPad + (side - 30) / 2, by = footY + 8;
+    for (NSView* v in foot) {
+      v.frame = NSMakeRect(x, by, 30, 28);
+      if ([v isKindOfClass:AgensAtoButton.class] && ((AgensAtoButton*)v).selected) {
+        _atoDot.frame = NSMakeRect(x - 5, by + 12, 4, 4);
+        _atoDot.hidden = NO;
+      }
+      by += 32;
+    }
+  }
+
+  // The tabs fill what's left and scroll. The collapsed rail is too narrow for a scroller next to
+  // the icons; it still scrolls with the trackpad or wheel.
+  _tabsScroll.hasVerticalScroller = !narrow;
+  _tabsScroll.verticalScroller.alphaValue = 1;
+  _tabsScroll.frame = NSMakeRect(kPad, y, side, MAX(0, footY - 6 - y));
+  CGFloat rowY = 0;
+  for (AgensTabRow* row in _rows) {
+    row.frame = NSMakeRect(0, rowY, side, kRow);
+    rowY += kRow + 1;
+  }
+  _tabsDoc.frame = NSMakeRect(0, 0, side, MAX(rowY, NSHeight(_tabsScroll.frame)));
+
+  _page = NSMakeRect(columnEnd + kGap, kToolbar, width - (columnEnd + kGap) - kPad,
+                     height - kToolbar - kPad);
+  _ntp.frame = NSInsetRect(_page, 1, 1);
+  CGFloat statusW = MIN(ceil(_statusText.fittingSize.width) + 24, NSWidth(_page) / 2);
+  _statusPill.frame = NSMakeRect(NSMinX(_page) + 8, NSMaxY(_page) - 8 - 22, statusW, 22);
+  _statusText.frame = NSMakeRect(10, 3, statusW - 20, 16);
+
+  NSRect anchor = [self editingField] == _ntp.field ? [_ntp convertRect:_ntp.well.frame toView:self]
+                                                     : _omni.frame;
+  CGFloat rowsH = _suggestionRows.count * 34;
+  _suggest.frame = NSMakeRect(NSMinX(anchor), NSMaxY(anchor) + 6, NSWidth(anchor), rowsH + 10);
+  for (NSUInteger i = 0; i < _suggestionRows.count; ++i) {
+    _suggestionRows[i].frame = NSMakeRect(5, 5 + i * 34, NSWidth(anchor) - 10, 34);
+  }
+  return {(int)NSMinX(_page), (int)NSMinY(_page), (int)NSWidth(_page), (int)NSHeight(_page)};
+}
+- (AgensRect)siteIconRect {
+  NSRect r = [_omni convertRect:_omniIcon.frame toView:self];
+  return {(int)NSMinX(r), (int)NSMinY(r), (int)NSWidth(r), (int)NSHeight(r)};
+}
+- (void)relayout {
+  [self layoutForWidth:(int)NSWidth(self.bounds) height:(int)NSHeight(self.bounds)];
+}
+
+- (void)setTabs:(const AgensTab*)tabs count:(int)count {
+  __weak AgensChrome* weak = self;
+  while ((int)_rows.count < count) {
+    AgensTabRow* row = [[AgensTabRow alloc] initWithFrame:NSMakeRect(0, 0, kSide, kRow)];
+    __weak AgensTabRow* weakRow = row;
+    row.onPress = ^{ [weak activate:weakRow.index]; };
+    row.onClose = ^{ [weak close:weakRow.index]; };
+    [_tabsDoc addSubview:row];
+    [_rows addObject:row];
+  }
+  while ((int)_rows.count > count) {
+    [_rows.lastObject removeFromSuperview];
+    [_rows removeLastObject];
+  }
+  int activeTab = -1;
+  for (int i = 0; i < count; ++i) {
+    _rows[i].index = i;
+    [_rows[i] updateWith:tabs[i]];
+    if (tabs[i].active) activeTab = i;
+    if (!tabs[i].active) continue;
+    _url = @(tabs[i].url);
+    _loading = tabs[i].loading;
+    _bookmarked = tabs[i].bookmarked;
+    _back.enabled = tabs[i].can_go_back;
+    _forward.enabled = tabs[i].can_go_forward;
+  }
+  [_reload setSymbol:_loading ? @"xmark" : @"arrow.clockwise"];
+  [_star setSymbol:_bookmarked ? @"star.fill" : @"star"];
+  [_star setTint:_bookmarked ? kLight3 : kDim];
+  _star.accessibilityLabel = _bookmarked ? @"Tirar dos favoritos" : @"Adicionar aos favoritos";
+  _star.hidden = _url.length == 0;
+  _siteButton.hidden = _url.length == 0;
+  _reload.accessibilityLabel = _loading ? @"Parar" : @"Recarregar";
+  BOOL secure = [_url hasPrefix:@"https://"];
+  _omniIcon.image = Symbol(_url.length == 0 ? @"magnifyingglass" : secure ? @"lock.fill" : @"globe", 12);
+  // Don't overwrite what the person is typing.
+  if (_address.currentEditor == nil) _address.stringValue = [self displayURL];
+  BOOL wasNTP = !_ntp.hidden;
+  _ntp.hidden = _url.length > 0;
+  if (!_ntp.hidden && !wasNTP) _ntp.field.stringValue = @"";
+  [self relayout];
+  if (activeTab >= 0) [_tabsDoc scrollRectToVisible:_rows[activeTab].frame];
+}
+
+// The address as the prototype shows it: no https:// or www., no lone trailing slash.
+- (NSString*)displayURL {
+  NSString* s = _url;
+  for (NSString* p in @[ @"https://", @"www." ]) {
+    if ([s hasPrefix:p]) s = [s substringFromIndex:p.length];
+  }
+  NSRange slash = [s rangeOfString:@"/"];
+  if (slash.location != NSNotFound && slash.location == s.length - 1) s = [s substringToIndex:slash.location];
+  return s;
+}
+
+- (void)setAtos:(const AgensAto*)atos count:(int)count {
+  __weak AgensChrome* weak = self;
+  while ((int)_atoButtons.count < count) {
+    AgensAtoButton* b = [[AgensAtoButton alloc] initWithFrame:NSZeroRect];
+    int index = (int)_atoButtons.count;
+    b.onPress = ^{ [weak switchAto:index]; };
+    [self addSubview:b positioned:NSWindowBelow relativeTo:_ntp];
+    [_atoButtons addObject:b];
+  }
+  while ((int)_atoButtons.count > count) {
+    [_atoButtons.lastObject removeFromSuperview];
+    [_atoButtons removeLastObject];
+  }
+  [_atoNames removeAllObjects];
+  for (int i = 0; i < count; ++i) {
+    [_atoButtons[i] updateWith:atos[i] index:i];
+    [_atoNames addObject:@(atos[i].name)];
+    if (!atos[i].active) continue;
+    _activeAto = i;
+    _atoName.stringValue = @(atos[i].name);
+    _atoTile.stringValue = Monogram(_atoName.stringValue);
+    _atoTile.layer.backgroundColor = AtoColor(i).CGColor;
+  }
+  [self relayout];
+}
+// Every ato, for when they don't fit in the foot.
+- (void)showAtosMenu {
+  NSMenu* menu = [[NSMenu alloc] initWithTitle:@"Atos"];
+  for (NSUInteger i = 0; i < _atoNames.count; ++i) {
+    NSMenuItem* item = [menu addItemWithTitle:_atoNames[i] action:@selector(atoFromMenu:) keyEquivalent:@""];
+    item.target = self;
+    item.tag = i;
+    item.state = (int)i == _activeAto ? NSControlStateValueOn : NSControlStateValueOff;
+  }
+  [menu addItem:NSMenuItem.separatorItem];
+  NSMenuItem* add = [menu addItemWithTitle:@"Novo ato" action:@selector(newAtoFromMenu:) keyEquivalent:@""];
+  add.target = self;
+  [menu popUpMenuPositioningItem:nil atLocation:NSMakePoint(NSMinX(_moreAtos.frame), NSMinY(_moreAtos.frame) - 4) inView:self];
+}
+- (void)atoFromMenu:(NSMenuItem*)item {
+  [self switchAto:(int)item.tag];
+}
+- (void)newAtoFromMenu:(id)sender {
+  [self run:agens_window_new_ato];
+}
+- (void)switchAto:(int)index {
+  if (_window && !_atoButtons[index].selected) agens_window_switch_ato(_window, index);
+}
+
+// --- Address and suggestions.
+
+// The address bar or the new tab page's field, whichever has the cursor (both suggest).
+- (NSTextField*)editingField {
+  if (_ntp.field.currentEditor) return _ntp.field;
+  return _address.currentEditor ? _address : nil;
+}
+- (void)controlTextDidBeginEditing:(NSNotification*)note {
+  [self refreshTheme];
+}
+- (void)controlTextDidChange:(NSNotification*)note {
+  NSTextField* field = note.object;
+  _selected = -1;
+  if (_window) agens_window_suggest(_window, field.stringValue.UTF8String);
+}
+- (void)controlTextDidEndEditing:(NSNotification*)note {
+  if (note.object == _address) _address.stringValue = [self displayURL];
+  [self closeSuggestions];
+  [self refreshTheme];
+}
+// Arrows walk the list, Enter opens, Esc closes (the prototype's omnibox keys).
+- (BOOL)control:(NSControl*)control textView:(NSTextView*)textView doCommandBySelector:(SEL)command {
+  int count = (int)_suggestionRows.count;
+  if (command == @selector(moveDown:) && count) {
+    [self select:(_selected + 1) % count];
+    return YES;
+  }
+  if (command == @selector(moveUp:) && count) {
+    [self select:_selected <= 0 ? count - 1 : _selected - 1];
+    return YES;
+  }
+  if (command == @selector(cancelOperation:)) {
+    ((NSTextField*)control).stringValue = control == _address ? _url : @"";
+    [self closeSuggestions];
+    return YES;
+  }
+  if (command == @selector(insertNewline:) && _selected >= 0) {
+    [self openSuggestion:_selected];
+    return YES;
+  }
+  return NO;
+}
+- (void)select:(int)index {
+  _selected = index;
+  for (int i = 0; i < (int)_suggestionRows.count; ++i) _suggestionRows[i].selected = i == index;
+}
+- (void)setSuggestions:(const AgensSuggestion*)suggestions count:(int)count {
+  if (![self editingField]) count = 0;  // results that arrive after the field closed
+  __weak AgensChrome* weak = self;
+  while ((int)_suggestionRows.count < count) {
+    AgensSuggestionRow* row = [[AgensSuggestionRow alloc] initWithFrame:NSZeroRect];
+    int index = (int)_suggestionRows.count;
+    row.onPress = ^{ [weak openSuggestion:index]; };
+    [_suggest addSubview:row];
+    [_suggestionRows addObject:row];
+  }
+  while ((int)_suggestionRows.count > count) {
+    [_suggestionRows.lastObject removeFromSuperview];
+    [_suggestionRows removeLastObject];
+  }
+  for (int i = 0; i < count; ++i) [_suggestionRows[i] updateWith:suggestions[i]];
+  if (_selected >= count) _selected = -1;
+  [self select:_selected];
+  _suggest.hidden = count == 0;
+  [self relayout];
+}
+- (void)closeSuggestions {
+  if (_window) agens_window_suggest(_window, "");
+  [self setSuggestions:nullptr count:0];
+}
+- (void)openSuggestion:(int)index {
+  if (_window) agens_window_open_suggestion(_window, index);
+  [self closeSuggestions];
+  [self.window makeFirstResponder:nil];
+}
+
+// --- Actions.
+
+// The window menu (prototype openMainMenu): Nova aba, Favoritos, Histórico, Configurações.
+- (void)showMenu {
+  if (_menuView) {
+    [self closeMenu];
+    return;
+  }
+  __weak AgensChrome* weak = self;
+  struct Item {
+    NSString* icon;
+    NSString* title;
+    NSString* key;
+    void (^action)(void);
+  } items[] = {
+      {kIconPlus, @"Nova aba", @"⌘T", ^{ [weak menuNewTab:nil]; }},
+      {kIconStar, @"Favoritos", @"⌘⌥B", ^{ [weak menuBookmarks:nil]; }},
+      {kIconClock, @"Histórico", @"⌘Y", ^{ [weak menuHistory:nil]; }},
+      {kIconSettings, @"Configurações", @"⌘,", ^{ [weak menuSettings:nil]; }},
+  };
+  const CGFloat w = 260, rowH = 33;
+  NSView* panel = [self popoverWidth:w height:std::size(items) * rowH + 10 under:_menu];
+  panel.accessibilityRole = NSAccessibilityMenuRole;
+  panel.accessibilityLabel = @"Menu";
+  CGFloat y = NSHeight(panel.frame) - 5 - rowH;  // the panel isn't flipped
+  for (const Item& it : items) {
+    AgensMenuRow* row = [[AgensMenuRow alloc] initWithIcon:it.icon title:it.title key:it.key];
+    void (^action)(void) = it.action;
+    row.onPress = ^{
+      [weak closeMenu];
+      action();
+    };
+    row.frame = NSMakeRect(5, y, w - 10, rowH);
+    [panel addSubview:row];
+    y -= rowH;
+  }
+  [self presentPopover:panel anchor:_menu];
+}
+
+// Our floating panels (prototype .menu): float background, strong border, 12 pt corners.
+- (NSView*)popoverWidth:(CGFloat)w height:(CGFloat)h under:(NSView*)anchor {
+  NSView* panel = [[NSView alloc] initWithFrame:NSMakeRect(MAX(8, NSMaxX(anchor.frame) - w), NSMaxY(anchor.frame) + 6, w, h)];
+  panel.wantsLayer = YES;
+  panel.layer.cornerRadius = 12;
+  panel.layer.borderWidth = 1;
+  panel.layer.backgroundColor = CG(kFloat, self);
+  panel.layer.borderColor = CG(kLineStrong, self);
+  return panel;
+}
+- (void)presentPopover:(NSView*)panel anchor:(NSView*)anchor {
+  __weak AgensChrome* weak = self;
+  [self closeMenu];
+  _menuView = panel;
+  _popoverAnchor = anchor;
+  [self addSubview:_menuView];
+  // Rise in, as the prototype (.2s); a click anywhere else or Esc closes it.
+  _menuView.alphaValue = 0;
+  [NSAnimationContext runAnimationGroup:^(NSAnimationContext* ctx) {
+    ctx.duration = 0.2;
+    self->_menuView.animator.alphaValue = 1;
+  }];
+  _clickMonitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDown | NSEventMaskRightMouseDown | NSEventMaskKeyDown
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     AgensChrome* strong = weak;
+                                     if (!strong || !strong->_menuView) return event;
+                                     if (event.type == NSEventTypeKeyDown) {
+                                       if (event.keyCode == 53) {  // Esc
+                                         [strong closeMenu];
+                                         return nil;
+                                       }
+                                       return event;
+                                     }
+                                     NSPoint p = [strong convertPoint:event.locationInWindow fromView:nil];
+                                     if (event.window != strong.window ||
+                                         (!NSPointInRect(p, strong->_menuView.frame) &&
+                                          !NSPointInRect(p, strong->_popoverAnchor.frame))) {
+                                       [strong closeMenu];
+                                     }
+                                     return event;
+                                   }];
+}
+- (void)setStatus:(const char*)text {
+  _statusText.stringValue = @(text);
+  _statusPill.hidden = _statusText.stringValue.length == 0;
+  [self relayout];
+}
+
+- (void)setDownloads:(const AgensDownload*)downloads count:(int)count started:(BOOL)started {
+  _downloadNames.clear();
+  for (int i = 0; i < count; ++i) _downloadNames.push_back(downloads[i].name);
+  _downloads.assign(downloads, downloads + count);
+  for (int i = 0; i < count; ++i) _downloads[i].name = _downloadNames[i].c_str();  // keep our copies
+  BOOL running = std::any_of(_downloads.begin(), _downloads.end(), [](const AgensDownload& d) { return d.state == kAgensDownloading; });
+  _downloadsButton.hidden = count == 0;
+  [_downloadsButton setTint:running ? kLight3 : kDim];
+  _downloadsButton.accessibilityLabel = running ? @"Downloads em andamento" : @"Downloads";
+  [self relayout];
+  if (started) {
+    [self showDownloads];  // like Chrome: a new download opens the list
+  } else if (_downloadsPanel) {
+    [self fillDownloads];
+  }
+}
+- (void)toggleDownloads {
+  if (_downloadsPanel) {
+    [self closeMenu];
+  } else {
+    [self showDownloads];
+  }
+}
+- (void)showDownloads {
+  const CGFloat w = 340;
+  NSView* panel = [self popoverWidth:w height:10 under:_downloadsButton];
+  panel.accessibilityRole = NSAccessibilityListRole;
+  panel.accessibilityLabel = @"Downloads";
+  [self presentPopover:panel anchor:_downloadsButton];
+  _downloadsPanel = panel;
+  [self fillDownloads];
+}
+- (void)fillDownloads {
+  const CGFloat w = NSWidth(_downloadsPanel.frame), rowH = 48;
+  const int count = (int)MIN(_downloads.size(), (size_t)6);
+  for (NSView* v in [_downloadsPanel.subviews copy]) [v removeFromSuperview];
+  NSRect f = _downloadsPanel.frame;
+  f.size.height = count * rowH + 10;
+  _downloadsPanel.frame = f;
+  __weak AgensChrome* weak = self;
+  CGFloat y = f.size.height - 5 - rowH;
+  for (int i = 0; i < count; ++i) {
+    AgensDownloadRow* row = [[AgensDownloadRow alloc] initWithFrame:NSMakeRect(5, y, w - 10, rowH)];
+    [row updateWith:_downloads[i]];
+    const BOOL done = _downloads[i].state == kAgensDownloaded;
+    row.onPress = ^{
+      AgensChrome* strong = weak;
+      if (strong && done && strong->_window) agens_window_download_open(strong->_window, i);
+    };
+    row.onShow = ^{
+      AgensChrome* strong = weak;
+      if (strong && strong->_window) agens_window_download_show(strong->_window, i);
+    };
+    row.onCancel = ^{
+      AgensChrome* strong = weak;
+      if (strong && strong->_window) agens_window_download_cancel(strong->_window, i);
+    };
+    [_downloadsPanel addSubview:row];
+    y -= rowH;
+  }
+}
+- (void)closeMenu {
+  [_menuView removeFromSuperview];
+  _menuView = nil;
+  _popoverAnchor = nil;
+  _downloadsPanel = nil;
+  if (_clickMonitor) [NSEvent removeMonitor:_clickMonitor];
+  _clickMonitor = nil;
+}
+- (void)menuNewTab:(id)sender {
+  [self run:agens_window_new_tab];
+}
+- (void)menuBookmarks:(id)sender {
+  if (_window) agens_window_open_page(_window, kAgensBookmarks);
+}
+- (void)menuHistory:(id)sender {
+  if (_window) agens_window_open_page(_window, kAgensHistory);
+}
+- (void)menuSettings:(id)sender {
+  if (_window) agens_window_open_page(_window, kAgensSettings);
+}
+// Open/close the column with the prototype's motion (width, .32s, ease-out); instant with
+// "Reduzir movimento". Each frame lays out the chrome and asks the engine to move the page.
+- (void)toggleSidebar {
+  _collapsed = !_collapsed;
+  [NSUserDefaults.standardUserDefaults setBool:_collapsed forKey:kCollapsedKey];
+  [_sideTimer invalidate];
+  const CGFloat from = _sideW, to = _collapsed ? kRail : kSide;
+  if (NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion) {
+    [self setSideWidth:to];
+    return;
+  }
+  const CFTimeInterval start = CACurrentMediaTime(), duration = 0.32;
+  __weak AgensChrome* weak = self;
+  _sideTimer = [NSTimer timerWithTimeInterval:1.0 / 120 repeats:YES block:^(NSTimer* timer) {
+    AgensChrome* strong = weak;
+    if (!strong) {
+      [timer invalidate];
+      return;
+    }
+    double t = MIN(1.0, (CACurrentMediaTime() - start) / duration);
+    [strong setSideWidth:from + (to - from) * (1 - pow(1 - t, 3))];
+    if (t >= 1) [timer invalidate];
+  }];
+  [NSRunLoop.currentRunLoop addTimer:_sideTimer forMode:NSRunLoopCommonModes];
+}
+- (void)setSideWidth:(CGFloat)width {
+  _sideW = width;
+  [self relayout];
+  if (_window) agens_window_relayout(_window);  // the page moves with the column
+}
+- (void)run:(void (*)(AgensWindow*))action {
+  if (_window) action(_window);
+}
+- (void)reloadOrStop {
+  [self run:_loading ? agens_window_stop : agens_window_reload];
+}
+- (void)activate:(int)index {
+  if (_window) agens_window_activate_tab(_window, index);
+}
+- (void)close:(int)index {
+  if (_window) agens_window_close_tab(_window, index);
+}
+- (void)go:(NSTextField*)sender {
+  if (_window && sender.stringValue.length) agens_window_navigate(_window, sender.stringValue.UTF8String);
+  [self closeSuggestions];
+}
+- (void)detach {
+  [_sideTimer invalidate];
+  [self closeMenu];
+  if (_keyMonitor) [NSEvent removeMonitor:_keyMonitor];
+  _keyMonitor = nil;
+  if (_window) {
+    agens_window_set_tabs_observer(_window, nullptr, nullptr);
+    agens_window_set_atos_observer(_window, nullptr, nullptr);
+    agens_window_set_suggestions_observer(_window, nullptr, nullptr);
+    agens_window_set_status_observer(_window, nullptr, nullptr);
+    agens_window_set_downloads_observer(_window, nullptr, nullptr);
+  }
+  _window = nullptr;
+}
+- (void)focusAddress {
+  if (!_ntp.hidden) {  // a new tab: type in the page's own big field
+    [self.window makeFirstResponder:_ntp.field];
+    return;
+  }
+  _address.stringValue = _url;  // the full address while editing
+  [self.window makeFirstResponder:_address];
+}
+@end
