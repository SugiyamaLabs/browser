+// --- dialog: alert, confirm, prompt and beforeunload of a tab no agent holds.
+
+class HostDialogs : public content::JavaScriptDialogManager {
+ public:
+  void RunJavaScriptDialog(content::WebContents* contents,
+                           content::RenderFrameHost* frame,
+                           content::JavaScriptDialogType type,
+                           const std::u16string& message,
+                           const std::u16string& default_prompt,
+                           DialogClosedCallback done,
+                           bool* did_suppress_message) override {
+    *did_suppress_message = false;
+    Open(contents, frame, type, false, false, message, default_prompt, std::move(done));
+  }
+  void RunBeforeUnloadDialog(content::WebContents* contents,
+                             content::RenderFrameHost* frame,
+                             bool is_reload,
+                             DialogClosedCallback done) override {
+    // Nobody to ask (no host, or shutting down after it left): the page may go, or quitting would hang.
+    if (!view::Host()) return std::move(done).Run(true, std::u16string());
+    Open(contents, frame, content::JAVASCRIPT_DIALOG_TYPE_CONFIRM, true, is_reload, {}, {}, std::move(done));
+  }
+  bool HandleJavaScriptDialog(content::WebContents* contents, bool accept, const std::u16string* prompt) override {
+    auto it = std::ranges::find(dialogs_, contents, &Dialog::contents);
+    if (it == dialogs_.end()) return false;
+    Dialog dialog = std::move(*it);
+    dialogs_.erase(it);
+    Withdraw(dialog.ask);
+    std::move(dialog.done).Run(accept, accept ? (prompt ? *prompt : dialog.default_prompt) : std::u16string());
+    return true;
+  }
+  void CancelDialogs(content::WebContents* contents, bool reset_state) override {
+    while (Take(contents, contents->IsBeingDestroyed() ? "closed" : "navigated", [](Dialog dialog) {
+      std::move(dialog.done).Run(false, std::u16string());
+    })) {
+    }
+  }
+
+  void HandTo(content::WebContents* contents, content::JavaScriptDialogManager* to) {
+    while (Take(contents, "gone", [contents, to](Dialog dialog) {
+      content::RenderFrameHost* frame = content::RenderFrameHost::FromID(dialog.frame);
+      if (!frame) return std::move(dialog.done).Run(false, std::u16string());
+      if (dialog.beforeunload) return to->RunBeforeUnloadDialog(contents, frame, dialog.is_reload, std::move(dialog.done));
+      bool suppressed = false;
+      to->RunJavaScriptDialog(contents, frame, dialog.type, dialog.message, dialog.default_prompt,
+                              std::move(dialog.done), &suppressed);
+    })) {
+    }
+  }
+
+ private:
+  struct Dialog {
+    int key = 0;
+    int ask = 0;
+    raw_ptr<content::WebContents> contents;  // only compared: its asks end before it goes
+    content::GlobalRenderFrameHostId frame;
+    content::JavaScriptDialogType type;
+    bool beforeunload = false, is_reload = false;
+    std::u16string message, default_prompt;
+    DialogClosedCallback done;
+  };
+
+  void Open(content::WebContents* contents,
+            content::RenderFrameHost* frame,
+            content::JavaScriptDialogType type,
+            bool beforeunload,
+            bool is_reload,
+            const std::u16string& message,
+            const std::u16string& default_prompt,
+            DialogClosedCallback done) {
+    base::DictValue fields;
+    fields.Set("type", beforeunload                                    ? "beforeunload"
+                       : type == content::JAVASCRIPT_DIALOG_TYPE_ALERT   ? "alert"
+                       : type == content::JAVASCRIPT_DIALOG_TYPE_CONFIRM ? "confirm"
+                                                                         : "prompt");
+    fields.Set("message", base::UTF16ToUTF8(message));
+    fields.Set("origin", frame->GetLastCommittedOrigin().Serialize());
+    if (type == content::JAVASCRIPT_DIALOG_TYPE_PROMPT && !beforeunload) {
+      fields.Set("default", base::UTF16ToUTF8(default_prompt));
+    }
+    const int key = ++next_key_;
+    dialogs_.push_back({key, 0, contents, frame->GetGlobalId(), type, beforeunload, is_reload, message,
+                        default_prompt, std::move(done)});
+    const int ask = Ask(contents, "dialog", std::move(fields),
+                        base::BindOnce(&HostDialogs::Answered, base::Unretained(this), key));
+    auto it = std::ranges::find(dialogs_, key, &Dialog::key);
+    if (it != dialogs_.end()) it->ask = ask;
+  }
+
+  void Answered(int key, const base::DictValue* answer) {
+    auto it = std::ranges::find(dialogs_, key, &Dialog::key);
+    if (it == dialogs_.end()) return;
+    Dialog dialog = std::move(*it);
+    dialogs_.erase(it);
+    const bool accept = answer && answer->FindBool("accept").value_or(false);
+    std::u16string text;
+    if (accept && dialog.type == content::JAVASCRIPT_DIALOG_TYPE_PROMPT) {
+      const std::string* typed = answer->FindString("text");
+      text = typed ? base::UTF8ToUTF16(*typed) : dialog.default_prompt;
+    }
+    std::move(dialog.done).Run(accept, text);
+  }
+
+  // The oldest dialog of `contents` out of the host (ui.cancel `reason`) and into `then`.
+  template <typename F>
+  bool Take(content::WebContents* contents, std::string_view reason, F then) {
+    auto it = std::ranges::find(dialogs_, contents, &Dialog::contents);
+    if (it == dialogs_.end()) return false;
+    Dialog dialog = std::move(*it);
+    dialogs_.erase(it);
+    if (std::unique_ptr<Pending> p = ui_ask::Take(dialog.ask)) {
+      TellCancelled(*p, reason);
+      SendNext();
+    }
+    then(std::move(dialog));
+    return true;
+  }
+
+  std::vector<Dialog> dialogs_;  // oldest first
+  int next_key_ = 0;
+};
+HostDialogs& TheDialogs() {
+  static base::NoDestructor<HostDialogs> dialogs;
+  return *dialogs;
+}
+
+// --- select: a <select>'s list.
+
+base::OnceClosure Select(content::WebContents* contents,
+                         const gfx::Rect& bounds,
+                         int selected,
+                         std::vector<content::AgensEmbedMenuItem> items,
+                         base::OnceCallback<void(std::optional<int>)> done) {
+  // The agent picks with page.click; the list is the person's only after "Assumir".
+  if (AgentWorking(contents)) {
+    std::move(done).Run(std::nullopt);
+    return base::OnceClosure();
+  }
+  base::ListValue list;
+  for (const content::AgensEmbedMenuItem& item : items) {
+    base::DictValue entry;
+    entry.Set("label", item.label);
+    if (!item.enabled) entry.Set("disabled", true);
+    if (item.group) entry.Set("group", true);
+    list.Append(std::move(entry));
+  }
+  base::DictValue fields;
+  fields.Set("x", bounds.x());
+  fields.Set("y", bounds.y());
+  fields.Set("width", bounds.width());
+  fields.Set("items", std::move(list));
+  fields.Set("selected", selected >= 0 && static_cast<size_t>(selected) < items.size() ? selected : -1);
+  const int ask = Ask(contents, "select", std::move(fields),
+                      base::BindOnce(
+                          [](base::OnceCallback<void(std::optional<int>)> done, const base::DictValue* answer) {
+                            std::move(done).Run(answer ? answer->FindInt("index") : std::nullopt);
+                          },
+                          std::move(done)));
+  return base::BindOnce(&Withdraw, ask);
+}
+
+// --- context_menu: a right click; the engine runs what the person picked.
+
+struct Clicked {
+  content::GlobalRenderFrameHostId frame;
+  GURL link, frame_url, link_followed;
+  network::mojom::ReferrerPolicy referrer_policy;
+  int x = 0, y = 0;
+  bool devtools = false;  // a DevTools view's own menu
+};
+
+// A DevTools view's menu entries (DevToolsHost's custom items): `id` is what the frontend runs.
+base::ListValue MenuItems(const std::vector<blink::mojom::CustomContextMenuItemPtr>& items, int depth, size_t& budget) {
+  using Type = blink::mojom::CustomContextMenuItemType;
+  base::ListValue list;
+  for (const auto& item : items) {
+    if (!budget) break;
+    --budget;
+    base::DictValue entry;
+    if (item->type == Type::kSeparator) {
+      entry.Set("separator", true);
+      list.Append(std::move(entry));
+      continue;
+    }
+    if (item->type == Type::kSubMenu && depth >= kMaxUiMenuDepth) continue;
+    entry.Set("label", ClipChars(base::UTF16ToUTF8(item->label), kMaxUiLabelChars));
+    if (item->type == Type::kSubMenu) {
+      entry.Set("items", MenuItems(item->submenu, depth + 1, budget));
+    } else if (item->type == Type::kGroup) {
+      entry.Set("group", true);
+    } else {
+      entry.Set("id", item->action);
+    }
+    if (!item->enabled) entry.Set("disabled", true);
+    if (item->type == Type::kCheckableOption) entry.Set("checked", item->checked);
+    list.Append(std::move(entry));
+  }
+  return list;
+}
+
+void RunAction(const Clicked& clicked, const base::DictValue* answer) {
+  const std::string* action = answer ? answer->FindString("action") : nullptr;
+  content::RenderFrameHost* frame = content::RenderFrameHost::FromID(clicked.frame);
+  content::WebContents* contents = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  if (!contents) return;
+  if (clicked.devtools) {
+    // The frontend runs its pick, then learns the menu closed (also when nothing was picked).
+    std::optional<int> item = answer ? answer->FindInt("item") : std::nullopt;
+    if (item) contents->ExecuteCustomContextMenuCommand(*item, clicked.link_followed);
+    if (action) content::AgensEmbedEdit(contents, *action == "select_all" ? "selectAll" : *action);
+    contents->NotifyContextMenuClosed(clicked.link_followed);
+    return;
+  }
+  if (!action) return;
+  content::NavigationController& controller = contents->GetController();
+  if (*action == "open_link_new_tab") {
+    contents->OpenURL(content::OpenURLParams(clicked.link, content::Referrer(clicked.frame_url, clicked.referrer_policy),
+                                             WindowOpenDisposition::NEW_BACKGROUND_TAB, ui::PAGE_TRANSITION_LINK,
+                                             /*is_renderer_initiated=*/false, /*started_from_context_menu=*/true),
+                      {});
+  } else if (*action == "copy_link") {
+    ::ui::ScopedClipboardWriter(::ui::ClipboardBuffer::kCopyPaste).WriteText(base::UTF8ToUTF16(clicked.link.spec()));
+  } else if (*action == "copy_image") {
+    frame->CopyImageAt(clicked.x, clicked.y);
+  } else if (*action == "save_image") {
+    frame->SaveImageAt(clicked.x, clicked.y);  // a download, under the usual rules
+  } else if (*action == "copy" || *action == "cut" || *action == "paste") {
+    content::AgensEmbedEdit(contents, *action);
+  } else if (*action == "select_all") {
+    content::AgensEmbedEdit(contents, "selectAll");
+  } else if (*action == "back") {
+    if (controller.CanGoBack()) controller.GoBack();
+  } else if (*action == "forward") {
+    if (controller.CanGoForward()) controller.GoForward();
+  } else if (*action == "reload") {
+    controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/true);
+  } else if (*action == "inspect") {
+    // Offered when the menu opened; an agent may have started since, or the policy changed.
+    if (!AgentWorking(contents) && view::CanInspect(contents)) {
+      const std::string* dock = answer->FindString("dock");  // checked: bottom, right or window
+      view::Inspect(contents, frame, gfx::Point(clicked.x, clicked.y), dock ? *dock : std::string());
+    }
+  }
+}
+
+void ContextMenu(content::RenderFrameHost& frame, const content::ContextMenuParams& params) {
+  content::WebContents* contents = content::WebContents::FromRenderFrameHost(&frame);
+  // The agent has no right click; the person's counts only after "Assumir".
+  if (!contents || AgentWorking(contents)) return;
+  base::DictValue context;
+  base::ListValue actions;
+  // A DevTools view: its own menu (the entries it gave) and the editing actions, nothing of a page's.
+  const bool devtools = view::IsDevToolsView(contents);
+  if (devtools) {
+    size_t budget = kMaxUiMenuItems;
+    context.Set("items", MenuItems(params.custom_items, 0, budget));
+    context.Set("editable", params.is_editable);
+    if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanCopy) actions.Append("copy");
+    if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanCut) actions.Append("cut");
+    if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanPaste) actions.Append("paste");
+    if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanSelectAll) actions.Append("select_all");
+    context.Set("actions", std::move(actions));
+    base::DictValue fields;
+    fields.Set("x", params.x);
+    fields.Set("y", params.y);
+    fields.Set("context", std::move(context));
+    Clicked clicked{frame.GetGlobalId(), params.link_url, params.frame_url, params.link_followed, params.referrer_policy,
+                    params.x, params.y, /*devtools=*/true};
+    Ask(contents, "context_menu", std::move(fields), base::BindOnce(&RunAction, std::move(clicked)));
+    return;
+  }
+  if (params.link_url.is_valid()) {
+    context.Set("link", params.link_url.spec());  // the address the actions use
+    if (params.link_url.SchemeIsHTTPOrHTTPS()) actions.Append("open_link_new_tab");
+    actions.Append("copy_link");
+  }
+  if (params.media_type == blink::mojom::ContextMenuDataMediaType::kImage && params.src_url.is_valid()) {
+    context.Set("image", params.src_url.spec());
+    if (params.has_image_contents) actions.Append("copy_image");
+    actions.Append("save_image");
+  }
+  const bool password = params.form_control_type == blink::mojom::FormControlType::kInputPassword;
+  if (!params.selection_text.empty() && !password) {
+    context.Set("selection", base::UTF16ToUTF8(params.selection_text));
+  }
+  context.Set("editable", params.is_editable);
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanCopy) actions.Append("copy");
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanCut) actions.Append("cut");
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanPaste) actions.Append("paste");
+  if (params.edit_flags & blink::ContextMenuDataEditFlags::kCanSelectAll) actions.Append("select_all");
+  if (contents->GetController().CanGoBack()) actions.Append("back");
+  if (contents->GetController().CanGoForward()) actions.Append("forward");
+  actions.Append("reload");
+  if (view::CanInspect(contents)) actions.Append("inspect");  // last, as in Chrome's menu
+  context.Set("actions", std::move(actions));
+  base::DictValue fields;
+  fields.Set("x", params.x);
+  fields.Set("y", params.y);
+  fields.Set("context", std::move(context));
+  Ask(contents, "context_menu", std::move(fields),
+      base::BindOnce(&RunAction, Clicked{frame.GetGlobalId(), params.link_url, params.frame_url, GURL(),
+                                         params.referrer_policy, params.x, params.y}));
+}
+
+// --- file: every file and folder panel (pages, "save as"), for the tab it opens for.
+
+class HostFileDialog : public ::ui::SelectFileDialog {
+ public:
+  HostFileDialog(Listener* listener, std::unique_ptr<::ui::SelectFilePolicy> policy)
+      : SelectFileDialog(listener, std::move(policy)) {}
+
+  // ::ui::SelectFileDialog:
+  bool IsRunning(gfx::NativeWindow window) const override {
+    return ask_ != 0 || (native_ && native_->IsRunning(window));
+  }
+  void ListenerDestroyed() override {
+    listener_ = nullptr;
+    if (ask_) Withdraw(std::exchange(ask_, 0));
+    if (native_) native_->ListenerDestroyed();
+  }
+
+ protected:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    // Set by ChromeSelectFilePolicy right before this, in the same call.
+    content::WebContents* contents = FileDialogSource().get();
+    FileDialogSource() = nullptr;
+    // A DevTools window's own panel (save a HAR, add a workspace folder) is on screen with it: the
+    // standard one, as Chromium shows it. The policy was checked already. A DevTools view's goes to
+    // the host like a page's.
+    if (view::InOwnDevToolsWindow(contents)) {
+      native_ = base::MakeRefCounted<::ui::SelectFileDialogImpl>(listener_, nullptr);
+      native_->SelectFile(type, title, default_path, file_types, file_type_index, default_extension, owning_window,
+                          caller);
+      return;
+    }
+    const char* mode = type == SELECT_OPEN_MULTI_FILE ? "open_multiple"
+                       : type == SELECT_SAVEAS_FILE   ? "save"
+                       : type == SELECT_OPEN_FILE     ? "open"
+                       : (type == SELECT_FOLDER || type == SELECT_UPLOAD_FOLDER || type == SELECT_EXISTING_FOLDER)
+                           ? "folder"
+                           : nullptr;
+    base::DictValue fields;
+    fields.Set("mode", mode ? mode : "");
+    base::ListValue accept;
+    if (file_types) {
+      for (const auto& group : file_types->extensions) {
+        for (const auto& extension : group) accept.Append("." + extension);
+      }
+    }
+    fields.Set("accept", std::move(accept));
+    if (type == SELECT_SAVEAS_FILE) fields.Set("suggested", default_path.BaseName().value());
+    scoped_refptr<HostFileDialog> self(this);
+    auto done = base::BindOnce(&HostFileDialog::Answered, self, type);
+    // No tab, or an agent's: no file, as before.
+    if (!contents || !mode || AgentWorking(contents)) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(std::move(done), static_cast<const base::DictValue*>(nullptr)));
+      return;
+    }
+    ask_ = Ask(contents, "file", std::move(fields), std::move(done));
+  }
+  bool HasMultipleFileTypeChoicesImpl() override { return false; }
+
+ private:
+  ~HostFileDialog() override = default;
+  void Answered(Type type, const base::DictValue* answer) {
+    ask_ = 0;
+    if (!listener_) return;
+    const base::ListValue* paths = answer ? answer->FindList("paths") : nullptr;
+    if (!paths || paths->empty()) return listener_->FileSelectionCanceled();
+    std::vector<::ui::SelectedFileInfo> files;
+    for (const base::Value& path : *paths) {
+      ::ui::SelectedFileInfo file{base::FilePath(path.GetString())};
+      file.display_name = file.file_path.BaseName().value();  // a folder's name heads its files' paths
+      files.push_back(std::move(file));
+    }
+    if (type == SELECT_OPEN_MULTI_FILE) return listener_->MultiFilesSelected(files);
+    listener_->FileSelected(files[0], 0);
+  }
+
+  int ask_ = 0;
+  scoped_refptr<::ui::SelectFileDialog> native_;  // a DevTools window's panel
+};
+
+class HostFileDialogFactory : public ::ui::SelectFileDialogFactory {
+ public:
+  ::ui::SelectFileDialog* Create(::ui::SelectFileDialog::Listener* listener,
+                                 std::unique_ptr<::ui::SelectFilePolicy> policy) override {
+    return new HostFileDialog(listener, std::move(policy));
+  }
+};
+
+// --- view.cursor and view.caret.
+
+const char* CursorName(::ui::mojom::CursorType type) {
+  using T = ::ui::mojom::CursorType;
+  switch (type) {
+    case T::kHand: return "pointer";
+    case T::kIBeam:
+    case T::kVerticalText: return "text";
+    case T::kWait:
+    case T::kProgress: return "wait";
+    case T::kCross:
+    case T::kCell: return "crosshair";
+    case T::kGrab: return "grab";
+    case T::kGrabbing: return "grabbing";
+    case T::kNotAllowed:
+    case T::kNoDrop: return "not_allowed";
+    case T::kMove: return "move";
+    case T::kEastResize:
+    case T::kWestResize:
+    case T::kEastWestResize:
+    case T::kColumnResize: return "resize_ew";
+    case T::kNorthResize:
+    case T::kSouthResize:
+    case T::kNorthSouthResize:
+    case T::kRowResize: return "resize_ns";
+    case T::kNorthEastResize:
+    case T::kSouthWestResize:
+    case T::kNorthEastSouthWestResize: return "resize_nesw";
+    case T::kNorthWestResize:
+    case T::kSouthEastResize:
+    case T::kNorthWestSouthEastResize: return "resize_nwse";
+    case T::kNone: return "none";
+    default: return "default";
+  }
+}
+
+// The last view.cursor and view.caret a tab sent, and to which host; goes with the tab.
+class LastSent : public content::WebContentsUserData<LastSent> {
+ public:
+  // For `host`: forgets what an earlier host was told.
+  static LastSent& For(content::WebContents* contents, uint64_t host) {
+    CreateForWebContents(contents);  // no-op once it exists
+    LastSent* last = FromWebContents(contents);
+    if (last->host_ != host) {
+      last->host_ = host;
+      last->cursor.clear();
+      last->caret.reset();
+    }
+    return *last;
+  }
+  std::string cursor;
+  std::optional<gfx::Rect> caret;
+
+ private:
+  explicit LastSent(content::WebContents* contents, uint64_t host = 0)
+      : content::WebContentsUserData<LastSent>(*contents), host_(host) {}
+  friend class content::WebContentsUserData<LastSent>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+  uint64_t host_;
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LastSent);
+
+// Only tabs the host was told about (view.tab): no id is made up here.
+void CursorChanged(content::WebContents* contents, ::ui::mojom::CursorType type) {
+  const uint64_t host = view::Host();
+  const int n = host ? view::KnownTab(contents) : 0;
+  if (!n) return;
+  std::string& last = LastSent::For(contents, host).cursor;
+  if (last == CursorName(type)) return;
+  last = CursorName(type);
+  base::DictValue fields;
+  fields.Set("tab", ViewTabName(n));
+  fields.Set("cursor", last);
+  SendEventTo(host, "view.cursor", std::move(fields));
+}
+
+void CaretChanged(content::WebContents* contents, const gfx::Rect& caret) {
+  const uint64_t host = view::Host();
+  const int n = host ? view::KnownTab(contents) : 0;
+  if (!n) return;
+  std::optional<gfx::Rect>& last = LastSent::For(contents, host).caret;
+  if (last == caret) return;
+  last = caret;
+  base::DictValue fields;
+  fields.Set("tab", ViewTabName(n));
+  fields.Set("x", caret.x());
+  fields.Set("y", caret.y());
+  fields.Set("width", caret.width());
+  fields.Set("height", caret.height());
+  SendEventTo(host, "view.caret", std::move(fields));
+}
+
+}  // namespace
+
+int Ask(content::WebContents* contents, std::string_view kind, base::DictValue fields, AnswerCallback done) {
+  State& s = S();
+  const int tab = contents ? view::TabNumber(contents) : 0;
+  const size_t of_tab = std::ranges::count_if(s.asks, [tab](const auto& p) { return tab && p->tab == tab; });
+  if (!view::Host() || s.asks.size() >= kMaxOpenUiAsks || of_tab >= kMaxOpenUiAsksPerTab ||
+      (contents && contents->IsBeingDestroyed())) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done), static_cast<const base::DictValue*>(nullptr)));
+    return 0;
+  }
+  auto p = std::make_unique<Pending>();
+  p->n = ++s.next;
+  p->kind = std::string(kind);
+  p->tab = tab;
+  p->done = std::move(done);
+  p->fields = std::move(fields);
+  p->fields.Set("ask", "u" + base::NumberToString(p->n));
+  p->fields.Set("kind", kind);
+  ClipUiAsk(p->fields);
+  if (contents) {
+    p->fields.Set("tab", ViewTabName(p->tab));
+    if (!Watch::FromWebContents(contents)) Watch::CreateForWebContents(contents, p->tab);
+  }
+  const int n = p->n;
+  s.asks.push_back(std::move(p));
+  SendNext();
+  return n;
+}
+
+void Withdraw(int ask) {
+  std::unique_ptr<Pending> p = Take(ask);
+  if (!p) return;
+  TellCancelled(*p, "gone");
+  SendNext();
+}
+
+void TabClosing(content::WebContents* contents) {
+  if (Watch::FromWebContents(contents)) EndTab(view::TabNumber(contents), "closed");
+}
+
+bool AgentWorking(content::WebContents* contents) {
+  const AgensControlled* controlled = contents ? AgensControlled::FromWebContents(contents) : nullptr;
+  return controlled && !controlled->paused;
+}
+
+void HandleAnswer(bool from_host, const Request& request, ReplyCallback reply) {
+  const std::string* ask = request.body.FindString("ask");
+  Pending* p = nullptr;
+  for (auto& candidate : S().asks) {
+    if (ask && candidate->sent && !candidate->checking && *candidate->fields.FindString("ask") == *ask) {
+      p = candidate.get();
+    }
+  }
+  switch (CheckUiAnswer(from_host, p ? &p->fields : nullptr, request.body)) {
+    case UiAnswer::kUnauthorized:
+      return std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "needs host.attach on this connection"));
+    case UiAnswer::kNotFound:
+      return std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ask));
+    case UiAnswer::kBadRequest:
+      return std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ask, and fields that fit its kind"));
+    case UiAnswer::kCancel:  // the host's {cancel: true} comes as is: the person decided
+      return Finish(p->n, request.id, std::move(reply), request.body.Clone());
+    case UiAnswer::kAnswer:
+      break;
+  }
+  if (p->kind != "file") return Finish(p->n, request.id, std::move(reply), request.body.Clone());
+  // The paths are checked on disk, off this thread; the ask can't be answered twice meanwhile.
+  p->checking = true;
+  const int n = p->n;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&PathsFitMode, *p->fields.FindString("mode"), request.body.FindList("paths")->Clone()),
+      base::BindOnce(
+          [](int n, base::Value id, base::DictValue body, ReplyCallback reply, bool fit) {
+            Pending* p = Find(n);
+            if (!p) return Reply(std::move(id), std::move(reply), kNotFound);
+            p->checking = false;
+            if (!fit) {
+              return std::move(reply).Run(ErrorReply(&id, kBadRequest, "a path does not exist or does not fit the mode"));
+            }
+            Finish(n, id, std::move(reply), std::move(body));
+          },
+          n, request.id.Clone(), request.body.Clone(), std::move(reply)));
+}
+
+void HostGone() {
+  std::vector<std::unique_ptr<Pending>> asks = std::move(S().asks);
+  S().asks.clear();
+  for (auto& p : asks) std::move(p->done).Run(nullptr);
+}
+
+void Start() {
+  static bool started = false;
+  if (started || !IsEmbedded()) return;
+  started = true;
+  content::SetAgensEmbedSelectHandler(base::BindRepeating(&Select));
+  content::SetAgensEmbedContextMenuHandler(base::BindRepeating(&ContextMenu));
+  // A DevTools window is on screen by itself: its menus and lists are Chromium's. A DevTools view
+  // has no window: its menus and lists go to the host (ContextMenu, Select).
+  content::SetAgensEmbedOwnWindow(base::BindRepeating(&view::InOwnDevToolsWindow));
+  content::SetAgensEmbedCursorCallbacks(base::BindRepeating(&CursorChanged), base::BindRepeating(&CaretChanged));
+  ::ui::SelectFileDialog::SetFactory(std::make_unique<HostFileDialogFactory>());
+}
+
+content::JavaScriptDialogManager* Dialogs() {
+  return &TheDialogs();
+}
+
+void HandDialogsTo(content::WebContents* contents, content::JavaScriptDialogManager* to) {
+  TheDialogs().HandTo(contents, to);
+}
+
+}  // namespace agens::bridge::ui_ask
