+// The controlled tab at `index`. With `fallback`, if that went stale (tabs moved since the UI's
+// last update), the active tab, else any controlled tab of this window, so that stopping never
+// does nothing; take over and hand back act only on the tab they were drawn for.
+static const AgensControlled* ControlledAt(AgensWindow* w, int index, bool fallback) {
+  auto at = [w](int i) {
+    return w->model()->ContainsIndex(i) ? AgensControlled::FromWebContents(w->model()->GetWebContentsAt(i)) : nullptr;
+  };
+  const AgensControlled* controlled = at(index);
+  if (controlled || !fallback) return controlled;
+  controlled = at(w->model()->active_index());
+  for (int i = 0; !controlled && i < w->model()->count(); ++i) controlled = at(i);
+  return controlled;
+}
+// Posted: stopping removes the mark that holds these closures.
+static void PostControl(const base::RepeatingClosure& action) {
+  if (action) base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, action);
+}
+void agens_window_stop_control(AgensWindow* w, int index) {
+  if (const AgensControlled* controlled = ControlledAt(w, index, /*fallback=*/true)) PostControl(controlled->stop);
+}
+void agens_window_take_control(AgensWindow* w, int index) {
+  if (const AgensControlled* controlled = ControlledAt(w, index, /*fallback=*/false)) PostControl(controlled->take_over);
+}
+void agens_window_hand_back_control(AgensWindow* w, int index) {
