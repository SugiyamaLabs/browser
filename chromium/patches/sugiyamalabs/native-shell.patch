+// Extensões: the ato's extensions, each with on/off and "Remover".
+static void ExtensionsListed(void* context, const AgensExtension* list, int count) {
+  auto* out = static_cast<std::vector<std::tuple<std::string, std::string, std::string, int>>*>(context);
+  for (int i = 0; i < count; ++i) out->emplace_back(list[i].id, list[i].name, list[i].version, list[i].enabled);
+}
+- (CGFloat)fillExtensions:(CGFloat)y {
+  std::vector<std::tuple<std::string, std::string, std::string, int>> list;
+  if (_browser) agens_extensions(_browser, ExtensionsListed, &list);
+  _extensionIds.clear();
+  _extensionNames.clear();
+  if (list.empty()) {
+    return [self info:@"Nenhuma extensão neste ato" detail:@"Cada ato tem as suas." note:@"" y:y];
+  }
+  for (const auto& [id, name, version, enabled] : list) {
+    const NSInteger tag = _extensionIds.size();
+    _extensionIds.push_back(id);
+    _extensionNames.push_back(name);
+    NSSwitch* sw = [[NSSwitch alloc] init];
+    sw.controlSize = NSControlSizeSmall;
+    sw.state = enabled ? NSControlStateValueOn : NSControlStateValueOff;
+    sw.tag = tag;
+    sw.target = self;
+    sw.action = @selector(toggleExtension:);
+    sw.accessibilityLabel = [@"Ligar " stringByAppendingString:@(name.c_str())];
+    [sw sizeToFit];
+    NSView* box = [self buttons:@[ [self small:@"Remover…" action:@selector(confirmRemoveExtension:) tag:tag] ]];
+    NSView* both = [[NSView alloc] initWithFrame:NSMakeRect(0, 0, NSWidth(box.frame) + 10 + NSWidth(sw.frame), MAX(NSHeight(sw.frame), NSHeight(box.frame)))];
+    box.frame = NSMakeRect(0, (NSHeight(both.frame) - NSHeight(box.frame)) / 2, NSWidth(box.frame), NSHeight(box.frame));
+    sw.frame = NSMakeRect(NSMaxX(box.frame) + 10, (NSHeight(both.frame) - NSHeight(sw.frame)) / 2, NSWidth(sw.frame), NSHeight(sw.frame));
+    [both addSubview:box];
+    [both addSubview:sw];
+    y = [self option:@(name.c_str()) detail:[@"Versão " stringByAppendingString:@(version.c_str())] control:both y:y];
+  }
+  return y;
+}
+- (void)toggleExtension:(NSSwitch*)sw {
+  const size_t i = sw.tag;
+  if (_browser && i < _extensionIds.size()) {
+    agens_extension_set_enabled(_browser, _extensionIds[i].c_str(), sw.state == NSControlStateValueOn);
+  }
+}
+- (void)confirmRemoveExtension:(NSButton*)button {
+  const size_t i = button.tag;
+  if (i >= _extensionIds.size()) return;
+  NSAlert* alert = [[NSAlert alloc] init];
+  alert.messageText = [NSString stringWithFormat:@"Remover %@?", @(_extensionNames[i].c_str())];
+  alert.informativeText = @"Sai deste ato junto com os dados dela.";
+  [alert addButtonWithTitle:@"Remover"].hasDestructiveAction = YES;
+  [alert addButtonWithTitle:@"Cancelar"];
+  const std::string id = _extensionIds[i];
+  __weak AgensSettings* weak = self;
+  [alert beginSheetModalForWindow:self.window completionHandler:^(NSModalResponse r) {
+    AgensSettings* strong = weak;
+    if (r != NSAlertFirstButtonReturn || !strong || !strong->_browser) return;
+    agens_extension_remove(strong->_browser, id.c_str());
+    [strong showSection:@"extensoes"];
+  }];
+}
