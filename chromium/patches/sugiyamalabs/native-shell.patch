+- (void)setVisits:(const AgensVisit*)visits count:(int)count {
+  _visits.clear();
+  for (int i = 0; i < count; ++i) _visits.emplace_back(visits[i].url, visits[i].title, visits[i].time);
+  [self build];
+}
+static NSString* DayName(NSDate* date) {
+  NSCalendar* cal = NSCalendar.currentCalendar;
+  if ([cal isDateInToday:date]) return @"Hoje";
+  if ([cal isDateInYesterday:date]) return @"Ontem";
+  static NSDateFormatter* f;
+  if (!f) {
+    f = [[NSDateFormatter alloc] init];
+    f.locale = [NSLocale localeWithLocaleIdentifier:@"pt_BR"];
+    f.dateFormat = @"EEEE, d 'de' MMMM";
+  }
+  NSString* s = [f stringFromDate:date];
+  return [[s substringToIndex:1].uppercaseString stringByAppendingString:[s substringFromIndex:1]];
+}
+- (void)build {
+  for (NSView* v in _items) [v removeFromSuperview];
+  [_items removeAllObjects];
+  NSDateFormatter* hm = [[NSDateFormatter alloc] init];
+  hm.dateFormat = @"HH:mm";
+  NSString* day = nil;
+  __weak AgensHistoryView* weak = self;
+  for (const auto& [url, title, time] : _visits) {
+    NSDate* date = [NSDate dateWithTimeIntervalSince1970:time];
+    NSString* name = DayName(date);
+    if (![name isEqualToString:day]) {
+      day = name;
+      NSTextField* label = Label(12.5, NSFontWeightSemibold, kMute);
+      label.stringValue = name;
+      NSView* line = [[NSView alloc] init];
+      line.wantsLayer = YES;
+      line.layer.backgroundColor = CG(kLine, self);
+      [_items addObject:label];
+      [_items addObject:line];
+    }
+    NSURL* u = [NSURL URLWithString:@(url.c_str())];
+    NSString* site = u.host ?: @(url.c_str());
+    if ([site hasPrefix:@"www."]) site = [site substringFromIndex:4];
+    AgensHistoryRow* row = [[AgensHistoryRow alloc] initWithFrame:NSZeroRect];
+    [row setTime:[hm stringFromDate:date] title:title.empty() ? site : @(title.c_str()) site:site];
+    NSString* address = @(url.c_str());
+    row.onPress = ^{
+      AgensHistoryView* strong = weak;
+      if (strong && strong->_onOpen) strong->_onOpen(address);
+    };
+    row.onRemove = ^{
+      AgensHistoryView* strong = weak;
+      if (!strong || !strong->_engine) return;
+      agens_history_remove(strong->_engine, address.UTF8String);
+      [strong reload];
+    };
+    [_items addObject:row];
+  }
+  if (_visits.empty()) {
+    NSTextField* empty = Label(13, NSFontWeightRegular, kDim);
+    empty.stringValue = _search.stringValue.length ? @"Nada encontrado." : @"Nada por aqui ainda.";
+    [_items addObject:empty];
+  }
+  for (NSView* v in _items) [_doc addSubview:v];
+  self.needsLayout = YES;
+}
+// Prototype .ip: at most 820 pt wide, centered, 36 pt from the top, 28 pt on the sides.
+- (void)layout {
+  [super layout];
+  _scroll.frame = self.bounds;
+  const CGFloat W = NSWidth(self.bounds), cw = MIN(820, W) - 56, x0 = (W - cw) / 2;
+  CGFloat y = 36;
+  [_clear sizeToFit];
+  _clear.frame = NSMakeRect(x0 + cw - NSWidth(_clear.frame), y + 4, NSWidth(_clear.frame), NSHeight(_clear.frame));
+  _search.frame = NSMakeRect(NSMinX(_clear.frame) - 12 - 240, y + 2, 240, 24);
+  _heading.frame = NSMakeRect(x0, y, NSMinX(_search.frame) - 12 - x0, 28);
+  y += 28 + 20;
+  for (NSView* v in _items) {
+    if ([v isKindOfClass:AgensHistoryRow.class]) {
+      v.frame = NSMakeRect(x0 - 10, y, cw + 20, 32);  // the hover box reaches past the text, like .row's padding
+      y += 33;
+    } else if ([v isKindOfClass:NSTextField.class]) {
+      y += 22;
+      v.frame = NSMakeRect(x0, y, cw, 18);
+      y += 24;
+    } else {  // the line under a day
+      v.frame = NSMakeRect(x0, y, cw, 1);
+      y += 7;
+    }
+  }
+  y += 24;
+  _note.frame = NSMakeRect(x0, y, cw, 16);
+  y += 16 + 48;
+  _doc.frame = NSMakeRect(0, 0, W, MAX(y, NSHeight(self.bounds)));
+}
+@end
