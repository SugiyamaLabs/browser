+    "control_keys.cc",
+    "control_keys.h",
+    "protocol.cc",
+    "protocol.h",
+    "session_need.cc",
+    "session_need.h",
+    "ui_answer.cc",
+    "ui_answer.h",
+    "view_input.cc",
+    "view_input.h",
+  ]
+  public_deps = [
+    "//base",
+    "//url",
+  ]
+}
+
+executable("agens_bridge_selfcheck") {
