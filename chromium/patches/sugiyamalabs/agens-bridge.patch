+// Copyright 2026 SugiyamaLabs.
+// Compartilhar a tela in the casca (prototipos/janela-tela.html #tela): our picker in place of
+// Chromium's getDisplayMedia dialog, and our sharing marks in place of its notification window and
+// tab-sharing infobar. The rest of Chromium's flow (DisplayMediaAccessHandler, the capture itself)
+// stays. In the AgensBrowser on its own the casca draws them; embedded, the host does (ui.ask
+// "screen_share", view.tab's `sharing`: docs/protocolo.md, "Passo 5.8"). Elsewhere these return
+// null and Chromium's own UI runs.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_SCREEN_SHARE_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_SCREEN_SHARE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+
+#include "chrome/browser/agens/embed/agens_embed.h"
+
+class DesktopMediaPicker;
+class MediaStreamUI;
+namespace content {
+struct DesktopMediaID;
+struct MediaStreamRequest;
+class WebContents;
+}  // namespace content
+
+namespace agens {
+
+// From DesktopMediaPicker::Create: the casca's picker for a request from a tab of a native-shell
+// window, the host's (ui.ask) for one embedded; null for anything else (no request, "this tab").
+std::unique_ptr<DesktopMediaPicker> CreateNativeDesktopMediaPicker(const content::MediaStreamRequest* request);
+// From CreateMediaStreamCaptureIndicatorUI: the bar and marks while `capturer` shares `media_id`;
+// null outside the casca (Chromium's notification UI then).
+std::unique_ptr<MediaStreamUI> CreateNativeShareUI(content::WebContents* capturer,
+                                                   const content::DesktopMediaID& media_id,
+                                                   bool audio);
+// AgensTab.sharing* for a tab; `name` keeps the string `tab->sharing_name` points to.
+void FillShareState(content::WebContents* contents, AgensTab* tab, std::string* name);
+
+// Embedded: view.tab's `sharing` {kind, target, title, audio, switch} while the tab captures.
+std::optional<base::DictValue> ShareFields(content::WebContents* contents);
+// view.share.stop and view.share.switch (the host's Parar and Trocar). False when the tab shares
+// nothing (switch: nothing that can switch).
+bool StopSharing(content::WebContents* contents);
+bool SwitchSharing(content::WebContents* contents);
+
+}  // namespace agens
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_SCREEN_SHARE_H_
