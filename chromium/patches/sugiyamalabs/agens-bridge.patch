+constexpr char kFailed[] = "failed";
+constexpr size_t kMaxNodes = 2000;
+constexpr size_t kMaxTextBytes = 4000;  // per name or value
+constexpr base::TimeDelta kTreeWait = base::Seconds(5);  // for a page that just started loading
+constexpr base::TimeDelta kTreePoll = base::Milliseconds(100);
+constexpr base::TimeDelta kScrollWait = base::Seconds(1);
+constexpr base::TimeDelta kAckWait = base::Seconds(2);
+constexpr base::TimeDelta kRendererWait = base::Seconds(3);
+// Settle: a page still loading never reports a clean tree; past this the op answers anyway.
+constexpr base::TimeDelta kSettleWait = base::Seconds(1);
+constexpr size_t kMaxWaitingOps = 64;
+constexpr size_t kMaxLogEntries = 200;   // page.console and page.network, per tab
+constexpr size_t kMaxLogChars = 2000;    // a message or URL in them
+constexpr size_t kMaxEvalResultBytes = 1 << 20;
+constexpr base::TimeDelta kEvalWait = base::Seconds(10);
+// A snapshot reply stays far under the socket's output cap (bridge_mac.mm), escaping included.
+constexpr size_t kMaxSnapshotBytes = 4 << 20;
+// Basic plus extended properties: checked states and other attributes Blink only sends with them.
+constexpr ui::AXMode kMode(ui::kAXModeBasic.flags() | ui::AXMode::kExtendedProperties);
+
+void Fail(base::Value& id, ReplyCallback& reply, std::string_view code, std::string_view message) {
+  std::move(reply).Run(ErrorReply(&id, code, message));
+}
+
+// A secret field: Blink says "password" for an input that is or was a password field, looks like
+// one to its heuristics, is masked by CSS or has a secret autocomplete token, hidden ones
+// included (ax_object.cc, agens); masked ones are also protected.
+bool IsPassword(const ui::AXNodeData& data) {
+  return data.HasState(ax::mojom::State::kProtected) ||
+         data.GetStringAttribute(ax::mojom::StringAttribute::kInputType) == "password";
+}
+// One whose text may be on screen: not masked, and with a value (an ignored one doesn't carry
+// its value, so it counts).
+bool IsRevealedPassword(const ui::AXNodeData& data) {
+  return !data.HasState(ax::mojom::State::kProtected) &&
+         data.GetStringAttribute(ax::mojom::StringAttribute::kInputType) == "password" &&
+         (data.HasState(ax::mojom::State::kIgnored) ||
+          !data.GetStringAttribute(ax::mojom::StringAttribute::kValue).empty());
+}
+bool AnyRevealedPassword(const ui::AXTreeUpdate& update) {
+  return std::any_of(update.nodes.begin(), update.nodes.end(), IsRevealedPassword);
+}
+
+ui::BrowserAccessibilityManager* ManagerFor(const ui::AXTreeID& tree) {
+  // Every tree a web page's frame has is a BrowserAccessibilityManager.
+  return static_cast<ui::BrowserAccessibilityManager*>(ui::AXTreeManager::FromID(tree));
+}
+
+std::string Clip(std::string text) {
+  if (text.size() > kMaxTextBytes) base::TruncateUTF8ToByteSize(text, kMaxTextBytes, &text);
+  return text;
+}
+
+// Worth listing: what can be acted on or read. Text inside a link, button or heading is already
+// its name.
+bool Worth(const ui::BrowserAccessibility& node, bool in_named) {
+  const ax::mojom::Role role = node.GetRole();
+  const bool named = !base::TrimWhitespaceASCII(node.GetName(), base::TRIM_ALL).empty();
+  if (role == ax::mojom::Role::kStaticText) return named && !in_named;
+  if (role == ax::mojom::Role::kImage) return named;
+  return ui::IsControl(role) || ui::IsLink(role) || ui::IsHeading(role) ||
+         role == ax::mojom::Role::kListBoxOption ||
+         node.GetBoolAttribute(ax::mojom::BoolAttribute::kNonAtomicTextFieldRoot);  // contenteditable
+}
+
+// Waits for the renderer to acknowledge `count` input events of `type` (so what they did, focus
+// or a page's handler, has happened), or kAckWait. Owns itself.
+class AckWaiter : public content::RenderWidgetHost::InputEventObserver, public content::RenderWidgetHostObserver {
+ public:
+  static void Start(content::RenderWidgetHost* widget,
+                    blink::WebInputEvent::Type type,
+                    base::OnceClosure done,
+                    int count = 1) {
+    new AckWaiter(widget, type, count, std::move(done));
+  }
+
+  void OnInputEventAck(const content::RenderWidgetHost&,
+                       blink::mojom::InputEventResultSource,
+                       blink::mojom::InputEventResultState,
+                       const blink::WebInputEvent& event) override {
+    if (event.GetType() == type_ && --count_ == 0) Finish();
+  }
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost*) override { Finish(); }
+
+ private:
+  AckWaiter(content::RenderWidgetHost* widget, blink::WebInputEvent::Type type, int count, base::OnceClosure done)
+      : widget_(widget), type_(type), count_(count), done_(std::move(done)) {
+    widget->AddInputEventObserver(this);
+    widget->AddObserver(this);
+    timer_.Start(FROM_HERE, kAckWait + base::Milliseconds(5) * count,
+                 base::BindOnce(&AckWaiter::Finish, base::Unretained(this)));
+  }
+  void Finish() {
+    widget_->RemoveInputEventObserver(this);
+    widget_->RemoveObserver(this);
+    std::move(done_).Run();
+    delete this;
+  }
+
+  raw_ptr<content::RenderWidgetHost> widget_;
+  const blink::WebInputEvent::Type type_;
+  int count_;
+  base::OnceClosure done_;
+  base::OneShotTimer timer_;
+};
+
+int Modifiers(const Key& key) {
+  return (key.shift ? blink::WebInputEvent::kShiftKey : 0) | (key.meta ? blink::WebInputEvent::kMetaKey : 0) |
+         (key.alt ? blink::WebInputEvent::kAltKey : 0) | (key.ctrl ? blink::WebInputEvent::kControlKey : 0);
+}
+
+// Key down, the character it types (if any), key up. Never handed to the browser's own shortcuts.
+void SendKey(content::RenderWidgetHost* widget, const Key& key) {
+  auto send = [&](blink::WebInputEvent::Type type) {
+    input::NativeWebKeyboardEvent event(type, Modifiers(key), base::TimeTicks::Now());
+    event.windows_key_code = key.windows_code;
+    event.dom_key = static_cast<int>(ui::KeycodeConverter::KeyStringToDomKey(key.key));
+    event.dom_code = static_cast<int>(ui::KeycodeConverter::CodeStringToDomCode(key.code));
+    if (type == blink::WebInputEvent::Type::kChar) {
+      for (size_t i = 0; i < key.text.size() && i < event.text.size(); ++i) {
+        event.text[i] = event.unmodified_text[i] = key.text[i];
+      }
+    }
+    event.skip_if_unhandled = true;
+    widget->ForwardKeyboardEvent(event);
+  };
+  send(blink::WebInputEvent::Type::kRawKeyDown);
+  if (!key.text.empty()) send(blink::WebInputEvent::Type::kChar);
+  send(blink::WebInputEvent::Type::kKeyUp);
+}
+
+void SendMouse(content::RenderWidgetHost* widget, blink::WebInputEvent::Type type, gfx::PointF point) {
+  const bool button = type != blink::WebInputEvent::Type::kMouseMove;
+  gfx::PointF screen = point;
+  if (content::RenderWidgetHostView* view = widget->GetView()) {
+    screen += view->GetViewBounds().OffsetFromOrigin();
+  }
+  blink::WebMouseEvent event(
+      type, point, screen,
+      button ? blink::WebPointerProperties::Button::kLeft : blink::WebPointerProperties::Button::kNoButton,
+      button ? 1 : 0,
+      type == blink::WebInputEvent::Type::kMouseDown ? blink::WebInputEvent::kLeftButtonDown
+                                                       : blink::WebInputEvent::kNoModifiers,
+      base::TimeTicks::Now());
+  widget->ForwardMouseEvent(event);
+}
+
+// A wheel scroll at `point`: began with the delta, then ended, as a trackpad sends it.
+void SendWheel(content::RenderWidgetHost* widget, gfx::PointF point, double dy) {
+  for (auto phase : {blink::WebMouseWheelEvent::kPhaseBegan, blink::WebMouseWheelEvent::kPhaseEnded}) {
+    blink::WebMouseWheelEvent event(blink::WebInputEvent::Type::kMouseWheel, blink::WebInputEvent::kNoModifiers,
+                                    base::TimeTicks::Now());
+    event.SetPositionInWidget(point);
+    event.delta_units = ui::ScrollGranularity::kScrollByPrecisePixel;
+    event.delta_y = phase == blink::WebMouseWheelEvent::kPhaseBegan ? -dy : 0;  // positive delta scrolls up
+    event.phase = phase;
+    widget->ForwardWheelEvent(event);
+  }
+}
+
+// A URL as page.console and page.network show it: no user, password or fragment, clipped.
+std::string ShownURL(const GURL& url) {
+  GURL::Replacements no_credentials;
+  no_credentials.ClearUsername();
+  no_credentials.ClearPassword();
+  no_credentials.ClearRef();  // a fragment often carries a token; the query stays
+  return ClipChars(url.is_valid() ? url.ReplaceComponents(no_credentials).spec() : std::string(), kMaxLogChars);
+}
