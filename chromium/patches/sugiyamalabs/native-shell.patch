+void agens_window_search_engines(AgensWindow* w, AgensSearchEnginesFn fn, void* context) {
+  TemplateURLService* service = TemplateURLServiceFactory::GetForProfile(w->browser->GetProfile());
+  std::vector<std::string> names, keywords;
+  std::vector<TemplateURL*> shown;
+  const TemplateURL* current = service ? service->GetDefaultSearchProvider() : nullptr;
+  if (service && service->loaded()) {
+    for (TemplateURL* t : service->GetTemplateURLs()) {
+      if (t->prepopulate_id() > 0 || t == current) shown.push_back(t);  // not the ones sites add
+    }
+  }
+  for (TemplateURL* t : shown) {
+    names.push_back(base::UTF16ToUTF8(t->short_name()));
+    keywords.push_back(base::UTF16ToUTF8(t->keyword()));
+  }
+  std::vector<AgensSearchEngine> out;
+  for (size_t i = 0; i < shown.size(); ++i) {
+    out.push_back({names[i].c_str(), keywords[i].c_str(), shown[i] == current});
+  }
+  fn(context, out.data(), static_cast<int>(out.size()));
+}
