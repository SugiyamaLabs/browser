+++ b/chrome/browser/agens/bridge/view_input.cc
@@ -0,0 +1,137 @@
+// Copyright 2026 SugiyamaLabs.
+
+#include "chrome/browser/agens/bridge/view_input.h"
+
+#include <cmath>
+#include <limits>
+
+#include "base/base64.h"
+#include "base/strings/string_number_conversions.h"
+
+namespace agens::bridge {
+
+ViewKey::ViewKey() = default;
+ViewKey::~ViewKey() = default;
+
+std::optional<int> ParseViewTab(std::string_view id) {
+  if (id.size() < 2 || id.size() > 11 || id[0] != 'v' || id[1] == '0') return std::nullopt;
+  int64_t n = 0;
+  for (char c : id.substr(1)) {
+    if (c < '0' || c > '9') return std::nullopt;
+    n = n * 10 + (c - '0');
+  }
+  if (n > std::numeric_limits<int>::max()) return std::nullopt;
+  return static_cast<int>(n);
+}
+
+std::string ViewTabName(int n) {
+  return "v" + base::NumberToString(n);
+}
+
+bool ReadViewSize(const base::DictValue& body, int& width, int& height, double& scale) {
+  const std::optional<int> w = body.FindInt("width");
+  const std::optional<int> h = body.FindInt("height");
+  const base::Value* s = body.Find("scale");
+  if (!w || !h || *w < 1 || *h < 1 || *w > kMaxViewSide || *h > kMaxViewSide) return false;
+  if (s && !s->is_int() && !s->is_double()) return false;
+  const double value = s ? s->GetDouble() : 1;
+  if (!(value > 0 && value <= kMaxViewScale)) return false;  // also refuses NaN
+  width = *w;
+  height = *h;
+  scale = value;
+  return true;
+}
+
+bool ReadEventData(const base::DictValue& body, std::string& out) {
+  const std::string* data = body.FindString("data");
+  if (!data || data->empty() || data->size() > kMaxEventDataChars) return false;
+  return base::Base64Decode(*data, &out) && !out.empty();
+}
+
+bool ReadPoint(const base::DictValue& body, double& x, double& y) {
+  constexpr double kLimit = kMaxViewSide * 4.0;
+  const std::optional<double> px = body.FindDouble("x");  // an int reads as a double too
+  const std::optional<double> py = body.FindDouble("y");
+  if (!px || !py || !std::isfinite(*px) || !std::isfinite(*py) || std::abs(*px) > kLimit ||
+      std::abs(*py) > kLimit) {
+    return false;
+  }
+  x = *px;
+  y = *py;
+  return true;
+}
+
+bool IsSelectorName(std::string_view name) {
+  // ^[a-z][A-Za-z]*:$ : what -doCommandBySelector: sends; anything else would be interned forever.
+  if (name.size() < 2 || name.size() > kMaxCommandChars || name.back() != ':' || name[0] < 'a' || name[0] > 'z') {
+    return false;
+  }
+  for (char c : name.substr(1, name.size() - 2)) {
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) return false;
+  }
+  return true;
+}
+
+bool ReadViewKey(const base::DictValue& body, ViewKey& key) {
+  for (auto [name, field] : {std::pair{"text", &key.text}, std::pair{"marked", &key.marked}}) {
+    const base::Value* value = body.Find(name);
+    if (!value) continue;
+    if (!value->is_string() || value->GetString().size() > kMaxInputTextBytes) return false;
+    *field = value->GetString();
+  }
+  if (const base::Value* value = body.Find("commands")) {
+    if (!value->is_list() || value->GetList().size() > kMaxKeyCommands) return false;
+    for (const base::Value& command : value->GetList()) {
+      if (!command.is_string() || !IsSelectorName(command.GetString())) return false;
+      key.commands.push_back(command.GetString());
+    }
+  }
+  for (auto [name, field] : {std::pair{"sel_start", &key.sel_start}, std::pair{"sel_end", &key.sel_end}}) {
+    const base::Value* value = body.Find(name);
+    if (!value) continue;
+    if (!value->is_int()) return false;
+    *field = value->GetInt();
+  }
+  for (auto [name, field] : {std::pair{"had_marked", &key.had_marked}, std::pair{"unmarked", &key.unmarked}}) {
+    const base::Value* value = body.Find(name);
+    if (!value) continue;
+    if (!value->is_bool()) return false;
+    *field = value->GetBool();
+  }
+  return true;
+}
+
+bool IsEditCommand(std::string_view command) {
+  for (std::string_view known : {"cut", "copy", "paste", "selectAll", "undo", "redo"}) {
+    if (command == known) return true;
+  }
+  return false;
+}
+
+std::vector<std::string> ParseAllowedClients(std::string_view value) {
+  std::vector<std::string> ids;
+  if (value.empty()) return ids;
+  size_t start = 0;
+  for (;;) {
+    const size_t end = value.find(',', start);
+    const std::string_view id = value.substr(start, end == std::string_view::npos ? std::string_view::npos : end - start);
+    if (id.empty() || id.size() > 128 || ids.size() == 16) return {};
+    for (char c : id) {
+      if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == '-')) {
+        return {};
+      }
+    }
+    ids.emplace_back(id);
+    if (end == std::string_view::npos) return ids;
+    start = end + 1;
+  }
+}
+
+std::optional<int> ParseApprovalAnswer(std::string_view answer) {
+  if (answer == "allow") return 0;
+  if (answer == "always") return 1;
+  if (answer == "deny") return 2;
+  return std::nullopt;
+}
+
+}  // namespace agens::bridge
diff --git a/chrome/browser/agens/bridge/view_input.h b/chrome/browser/agens/bridge/view_input.h
new file mode 100644
index 0000000000..b7c2381fc0
--- /dev/null
+++ b/chrome/browser/agens/bridge/view_input.h
@@ -0,0 +1,69 @@
+// Copyright 2026 SugiyamaLabs.
+// The params of view.* (docs/protocolo.md, "host e view") that need checking before they reach
+// the page. Pure logic, so view_input_selfcheck.cc runs it with only //base. The input ops come
+// at mouse-move rate: these read in place and fill buffers the caller reuses.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_VIEW_INPUT_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_VIEW_INPUT_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+namespace agens::bridge {
+
+inline constexpr size_t kMaxEventDataChars = 64 * 1024;  // "data": one NSEvent, base64
+inline constexpr size_t kMaxInputTextBytes = 64 * 1024;  // view.key "text" and "marked"
+inline constexpr size_t kMaxKeyCommands = 32;            // view.key "commands"
+inline constexpr size_t kMaxCommandChars = 64;
+inline constexpr int kMaxViewSide = 8192;  // points
+inline constexpr double kMaxViewScale = 8;
+
+// "v12" → 12. nullopt for anything else: no sign, no leading zero, more than 0, fits an int.
+std::optional<int> ParseViewTab(std::string_view id);
+std::string ViewTabName(int n);
+
+// view.attach / view.resize: "width" and "height" whole points in 1..kMaxViewSide, "scale" a
+// number in (0, kMaxViewScale] (1 when absent).
+bool ReadViewSize(const base::DictValue& body, int& width, int& height, double& scale);
+
+// "data": base64 of at most kMaxEventDataChars, decoded into `out` (reused). False when missing,
+// too long, empty or not base64.
+bool ReadEventData(const base::DictValue& body, std::string& out);
+
+// "x", "y": numbers within ±(kMaxViewSide * 4) points (a drag may leave the view).
+bool ReadPoint(const base::DictValue& body, double& x, double& y);
+
+// view.key's fields besides "data": what the host's text input system made of the key.
+struct ViewKey {
+  ViewKey();
+  ~ViewKey();
+  std::string text;                   // -insertText:
+  std::string marked;                 // -setMarkedText: (the composition now)
+  std::vector<std::string> commands;  // -doCommandBySelector:, e.g. "deleteBackward:"
+  std::optional<int> sel_start, sel_end;  // inside `marked`, in UTF-16 units; clamped by the caller
+  bool had_marked = false;
+  bool unmarked = false;
+};
+// False when a field has the wrong type or passes its limit, or a command is not a selector name
+// (IsSelectorName). Missing fields keep their defaults.
+bool ReadViewKey(const base::DictValue& body, ViewKey& key);
+
+// A selector name as -doCommandBySelector: gives it: ^[a-z][A-Za-z]*:$, at most kMaxCommandChars.
+bool IsSelectorName(std::string_view name);
+
+// view.edit: cut, copy, paste, selectAll, undo, redo.
+bool IsEditCommand(std::string_view command);
+
+// --agens-allowed-clients=<id>,<id>: exact signing identifiers, at most 16, each 1 to 128 chars of
+// [A-Za-z0-9.-]. Anything malformed gives an empty list (nobody but the host gets in).
+std::vector<std::string> ParseAllowedClients(std::string_view value);
+
+// approval.answer: allow, always, deny → 0, 1, 2 (AgensApprovalAnswer's order); nullopt otherwise.
+std::optional<int> ParseApprovalAnswer(std::string_view answer);
+
+}  // namespace agens::bridge
+
+#endif  // CHROME_BROWSER_AGENS_BRIDGE_VIEW_INPUT_H_
diff --git a/chrome/browser/agens/bridge/view_input_selfcheck.cc b/chrome/browser/agens/bridge/view_input_selfcheck.cc
new file mode 100644
index 0000000000..7d67567ae2
--- /dev/null
+++ b/chrome/browser/agens/bridge/view_input_selfcheck.cc
@@ -0,0 +1,130 @@
+// Copyright 2026 SugiyamaLabs.
+// Assert-based check of view_input.h, run by agens_bridge_selfcheck (protocol_selfcheck.cc).
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include "base/json/json_reader.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+
+using namespace agens::bridge;
+
+#define VIEW_CHECK(x)                                                     \
+  do {                                                                    \
+    if (!(x)) {                                                           \
+      std::fprintf(stderr, "FAILED %s:%d: %s\n", __FILE__, __LINE__, #x); \
+      std::exit(1);                                                       \
+    }                                                                     \
+  } while (0)
+
+static base::DictValue Body(const std::string& json) {
+  std::optional<base::Value> v = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  VIEW_CHECK(v && v->is_dict());
+  return std::move(v->GetDict());
+}
+
+void RunViewInputChecks() {
+  // Tab ids.
+  VIEW_CHECK(ParseViewTab("v1") == 1 && ParseViewTab("v2147483647") == 2147483647);
+  VIEW_CHECK(!ParseViewTab("v2147483648") && !ParseViewTab("v99999999999"));
+  VIEW_CHECK(!ParseViewTab("") && !ParseViewTab("v") && !ParseViewTab("v0") && !ParseViewTab("v01"));
+  VIEW_CHECK(!ParseViewTab("t1") && !ParseViewTab("v-1") && !ParseViewTab("v+1") && !ParseViewTab("v1 "));
+  VIEW_CHECK(!ParseViewTab("V1") && !ParseViewTab("v1a") && !ParseViewTab(std::string_view("v1\0", 3)));
+  VIEW_CHECK(ViewTabName(42) == "v42" && ParseViewTab(ViewTabName(7)) == 7);
+
+  // Sizes.
+  int w = 0, h = 0;
+  double s = 0;
+  VIEW_CHECK(ReadViewSize(Body(R"({"width":1000,"height":640,"scale":2})"), w, h, s) && w == 1000 && h == 640 && s == 2);
+  VIEW_CHECK(ReadViewSize(Body(R"({"width":1,"height":8192})"), w, h, s) && s == 1);
+  VIEW_CHECK(ReadViewSize(Body(R"({"width":10,"height":10,"scale":1.5})"), w, h, s) && s == 1.5);
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":0,"height":10})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":10,"height":8193})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":10.5,"height":10})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":"10","height":10})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"height":10})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":10,"height":10,"scale":0})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":10,"height":10,"scale":9})"), w, h, s));
+  VIEW_CHECK(!ReadViewSize(Body(R"({"width":10,"height":10,"scale":"2"})"), w, h, s));
+
+  // Event data: base64, bounded, reused buffer.
+  std::string data;
+  VIEW_CHECK(ReadEventData(Body(R"({"data":"aGVsbG8="})"), data) && data == "hello");
+  VIEW_CHECK(ReadEventData(Body(R"({"data":"YQ=="})"), data) && data == "a");  // the buffer shrinks
+  VIEW_CHECK(!ReadEventData(Body(R"({"data":"not base64!"})"), data));
+  VIEW_CHECK(!ReadEventData(Body(R"({"data":""})"), data));
+  VIEW_CHECK(!ReadEventData(Body(R"({"data":12})"), data));
+  VIEW_CHECK(!ReadEventData(Body(R"({})"), data));
+  {
+    std::string big(kMaxEventDataChars, 'A');
+    VIEW_CHECK(ReadEventData(Body("{\"data\":\"" + big + "\"}"), data) && data.size() == kMaxEventDataChars / 4 * 3);
+    VIEW_CHECK(!ReadEventData(Body("{\"data\":\"" + big + "AAAA\"}"), data));
+  }
+
+  // Points.
+  double x = 0, y = 0;
+  VIEW_CHECK(ReadPoint(Body(R"({"x":10,"y":20.5})"), x, y) && x == 10 && y == 20.5);
+  VIEW_CHECK(ReadPoint(Body(R"({"x":-5,"y":-5})"), x, y));
+  VIEW_CHECK(!ReadPoint(Body(R"({"x":10})"), x, y));
+  VIEW_CHECK(!ReadPoint(Body(R"({"x":"1","y":2})"), x, y));
+  VIEW_CHECK(!ReadPoint(Body(R"({"x":1e300,"y":2})"), x, y));
+
+  // Keys.
+  {
+    ViewKey key;
+    VIEW_CHECK(ReadViewKey(Body(R"({"text":"a","commands":["insertText:"],"marked":"´","sel_start":1,"sel_end":1,"had_marked":false,"unmarked":true})"), key));
+    VIEW_CHECK(key.text == "a" && key.commands.size() == 1 && key.marked == "\xC2\xB4" && key.sel_start == 1 &&
+               key.sel_end == 1 && !key.had_marked && key.unmarked);
+  }
+  {
+    ViewKey key;
+    VIEW_CHECK(ReadViewKey(Body(R"({})"), key) && key.text.empty() && !key.sel_start && key.commands.empty());
+  }
+  {
+    ViewKey key;
+    VIEW_CHECK(!ReadViewKey(Body(R"({"text":1})"), key));
+    VIEW_CHECK(!ReadViewKey(Body(R"({"commands":"deleteBackward:"})"), key));
+    VIEW_CHECK(!ReadViewKey(Body(R"({"commands":[1]})"), key));
+    VIEW_CHECK(!ReadViewKey(Body(R"({"commands":[""]})"), key));
+    VIEW_CHECK(!ReadViewKey(Body(R"({"commands":["deleteBackward:","x"]})"), key));
+    VIEW_CHECK(!ReadViewKey(Body(R"({"sel_start":"1"})"), key));
+    VIEW_CHECK(!ReadViewKey(Body(R"({"had_marked":1})"), key));
+  }
+  {
+    ViewKey key;
+    VIEW_CHECK(ReadViewKey(Body("{\"text\":\"" + std::string(kMaxInputTextBytes, 'a') + "\"}"), key));
+    VIEW_CHECK(!ReadViewKey(Body("{\"text\":\"" + std::string(kMaxInputTextBytes + 1, 'a') + "\"}"), key));
+    std::string many = "[";
+    for (size_t i = 0; i <= kMaxKeyCommands; ++i) many += std::string(i ? "," : "") + "\"noop:\"";
+    VIEW_CHECK(!ReadViewKey(Body("{\"commands\":" + many + "]}"), key));
+  }
+
+  // Selector names.
+  VIEW_CHECK(IsSelectorName("deleteBackward:") && IsSelectorName("noop:") && IsSelectorName("a:"));
+  VIEW_CHECK(!IsSelectorName("") && !IsSelectorName(":") && !IsSelectorName("DeleteBackward:"));
+  VIEW_CHECK(!IsSelectorName("insertText") && !IsSelectorName("do:it:") && !IsSelectorName("foo_bar:"));
+  VIEW_CHECK(!IsSelectorName("a1:") && IsSelectorName("a" + std::string(62, 'b') + ":") &&
+             !IsSelectorName("a" + std::string(63, 'b') + ":"));
+
+  // --agens-allowed-clients.
+  VIEW_CHECK(ParseAllowedClients("").empty());
+  VIEW_CHECK((ParseAllowedClients("ai.agens.engine") == std::vector<std::string>{"ai.agens.engine"}));
+  VIEW_CHECK((ParseAllowedClients("a.b,c-d,E9") == std::vector<std::string>{"a.b", "c-d", "E9"}));
+  VIEW_CHECK(ParseAllowedClients("a,,b").empty() && ParseAllowedClients("a,").empty() && ParseAllowedClients(",a").empty());
+  VIEW_CHECK(ParseAllowedClients("a b").empty() && ParseAllowedClients("a/b").empty() && ParseAllowedClients("a_b").empty());
+  VIEW_CHECK(ParseAllowedClients(std::string(128, 'a')).size() == 1 && ParseAllowedClients(std::string(129, 'a')).empty());
+  {
+    std::string sixteen, seventeen;
+    for (int i = 0; i < 16; ++i) sixteen += std::string(i ? "," : "") + "x" + std::to_string(i);
+    seventeen = sixteen + ",y";
+    VIEW_CHECK(ParseAllowedClients(sixteen).size() == 16 && ParseAllowedClients(seventeen).empty());
+  }
+
+  // Edit commands and approval answers.
+  VIEW_CHECK(IsEditCommand("selectAll") && IsEditCommand("paste") && !IsEditCommand("delete") && !IsEditCommand(""));
+  VIEW_CHECK(ParseApprovalAnswer("allow") == 0 && ParseApprovalAnswer("always") == 1 && ParseApprovalAnswer("deny") == 2);
+  VIEW_CHECK(!ParseApprovalAnswer("yes") && !ParseApprovalAnswer(""));
+
+  std::printf("agens bridge view input: ok\n");
+}
diff --git a/chrome/browser/agens/bridge/view_ops.cc b/chrome/browser/agens/bridge/view_ops.cc
new file mode 100644
index 0000000000..1007a1c9ba
--- /dev/null
+++ b/chrome/browser/agens/bridge/view_ops.cc
@@ -0,0 +1,757 @@
+// Copyright 2026 SugiyamaLabs.
+// The host draws the interface; the engine hands it the pages (docs/protocolo.md, "host e view").
+// - One host: the connection that sent host.attach (the app that launched the engine).
+// - Every tab of every ato has an id "v<n>" for as long as it lives, agent tabs included. The host
+//   learns them from view.tab events (sent when anything it shows changes) and view.closed.
+// - An attached tab draws by itself, outside any window (the shell never holds a tab while
+//   embedded, native_shell_mac.mm), and its CAContext id goes out as view.layer. Several at once.
+
+#include "chrome/browser/agens/bridge/view_ops.h"
+
+#include <unistd.h>
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/agens/bridge/ui_ops.h"
+#include "chrome/browser/agens/bridge/view_input.h"
+#include "chrome/browser/agens/embed/agens_controlled.h"
+#include "chrome/browser/agens/embed/agens_embedded.h"
+#include "chrome/browser/agens/embed/agens_window.h"
+#include "chrome/browser/autocomplete/autocomplete_classifier_factory.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/favicon/content/content_favicon_driver.h"
+#include "content/public/browser/agens_embed_mac.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_rep.h"
+
+namespace agens::bridge::view {
+
+namespace {
+
+constexpr char kFailed[] = "failed";
+constexpr size_t kMaxAddressChars = 8192;
+
+// A tab's number, given the first time the host could see it.
+class TabNumber : public content::WebContentsUserData<TabNumber> {
+ public:
+  const int n;
+
+ private:
+  TabNumber(content::WebContents* contents, int n)
+      : content::WebContentsUserData<TabNumber>(*contents), n(n) {}
+  friend class content::WebContentsUserData<TabNumber>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabNumber);
+
+int NumberOf(content::WebContents* contents) {
+  static int next = 0;
+  if (!TabNumber::FromWebContents(contents)) TabNumber::CreateForWebContents(contents, ++next);
+  return TabNumber::FromWebContents(contents)->n;
+}
+
+// The last layer a tab drew by itself, kept from every frame: a tab that is already drawn and idle
+// sends no new frame when the host attaches it.
+class LastLayer : public content::WebContentsUserData<LastLayer> {
+ public:
+  uint32_t context = 0;
+  gfx::Size pixels;
+  float scale = 1;
+
+ private:
+  explicit LastLayer(content::WebContents* contents) : content::WebContentsUserData<LastLayer>(*contents) {}
+  friend class content::WebContentsUserData<LastLayer>;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LastLayer);
+
+// A tab the host shows: kept visible at the host's size, drawing by itself.
+class Shown : public content::WebContentsObserver {
+ public:
+  Shown(content::WebContents* contents, int n) : content::WebContentsObserver(contents), n(n) {
+    // Seen as visible even when Chromium would hide it (not the active tab of its window).
+    capture_ = contents->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/false, /*stay_awake=*/false,
+                                                /*is_activity=*/false);
+    contents->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+  }
+  ~Shown() override {
+    content::WebContents* contents = web_contents();
+    if (!contents) return;
+    if (focused) content::AgensEmbedSetFocus(contents, false);
+    capture_.RunAndReset();
+    contents->UpdateWebContentsVisibility(content::Visibility::HIDDEN);
+  }
+
+  void Resize(const gfx::Size& to) {
+    size = to;
+    web_contents()->Resize(gfx::Rect(size));
+  }
+
+  // content::WebContentsObserver:
+  void WebContentsDestroyed() override;
+
+  const int n;
+  gfx::Size size;  // points
+  bool focused = false;
+  uint32_t context = 0;  // the last view.layer sent
+  gfx::Size pixels;
+  float scale = 1;
+
+ private:
+  base::ScopedClosureRunner capture_;
+};
+
+struct State : public TabStripModelObserver {
+  uint64_t host = 0;
+  std::vector<raw_ptr<AgensWindow>> windows;
+  std::vector<std::unique_ptr<Shown>> shown;
+  std::map<int, base::DictValue> sent;  // the last view.tab of each tab the host knows
+  std::map<int, gfx::Image> icons;      // the favicon it was told about
+  bool flush_pending = false;
+  // The approval on the host (one at a time, approval.cc keeps the queue).
+  int next_ask = 0;
+  std::string ask;
+  bool ask_offers_always = false;
+  ApprovalCallback answer;
+  std::string event_data;  // input ops decode here: no allocation per mouse move
+
+  void Schedule();
+  // TabStripModelObserver (every window's):
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&, const TabStripSelectionChange&) override {
+    Schedule();
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override { Schedule(); }
+};
+State& S() {
+  static base::NoDestructor<State> state;
+  return *state;
+}
+
+void Shown::WebContentsDestroyed() {
+  capture_.ReplaceClosure(base::OnceClosure());  // nothing to undo on a dying tab
+  Observe(nullptr);
+  std::erase_if(S().shown, [this](const std::unique_ptr<Shown>& s) { return s.get() == this; });  // deletes this
+}
+
+Shown* FindShown(int n) {
+  for (auto& s : S().shown) {
+    if (s->n == n && s->web_contents()) return s.get();
+  }
+  return nullptr;
+}
+
+std::string AtoOf(AgensWindow* window) {
+  return window->browser->GetProfile()->GetPath().BaseName().AsUTF8Unsafe();
+}
+
+// Every tab the host may see, with its window: devtools and off-the-record windows stay out.
+template <typename F>
+void ForEachTab(F f) {
+  for (AgensWindow* window : S().windows) {
+    BrowserWindowInterface* browser = window->browser;
+    if (browser->GetType() == BrowserWindowInterface::TYPE_DEVTOOLS || browser->GetProfile()->IsOffTheRecord()) {
+      continue;
+    }
+    TabStripModel* model = window->model();
+    for (int i = 0; i < model->count(); ++i) f(window, model->GetWebContentsAt(i));
+  }
+}
+
+content::WebContents* FindTab(int n, AgensWindow** in = nullptr) {
+  content::WebContents* found = nullptr;
+  ForEachTab([&](AgensWindow* window, content::WebContents* contents) {
+    const TabNumber* number = TabNumber::FromWebContents(contents);
+    if (!found && number && number->n == n) {
+      found = contents;
+      if (in) *in = window;
+    }
+  });
+  return found;
+}
+
+ProfileAttributesEntry* FindAto(const std::string& id) {
+  for (ProfileAttributesEntry* entry : AgensWindow::Atos()) {
+    if (entry->GetPath().BaseName().AsUTF8Unsafe() == id) return entry;
+  }
+  return nullptr;
+}
+
+// What the host needs to draw the agent's indicator: the two lines the shell's own pill shows
+// (control.status, or the defaults control_ops fills in) and whether the person took over.
+base::DictValue ControlFields(const AgensControlled& controlled) {
+  base::DictValue control;
+  control.Set("agent", controlled.by);
+  control.Set("title", controlled.title);
+  control.Set("detail", controlled.detail);
+  control.Set("state", controlled.paused ? "paused" : "working");
+  return control;
+}
+
+std::string VisibleUrl(content::WebContents* contents) {
+  const GURL& url = contents->GetVisibleURL();
+  // The new tab page has no address to show, as in the shell (AgensWindow::NotifyNow).
+  if (url.SchemeIs("chrome") &&
+      (url.host() == "newtab" || url.host() == "new-tab-page" || url.host() == "new-tab-page-third-party")) {
+    return std::string();
+  }
+  return url.spec();
+}
+
+base::DictValue TabFields(AgensWindow* window, content::WebContents* contents) {
+  base::DictValue tab;
+  tab.Set("tab", ViewTabName(NumberOf(contents)));
+  tab.Set("ato", AtoOf(window));
+  tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  tab.Set("url", VisibleUrl(contents));
+  tab.Set("loading", contents->IsLoading());
+  tab.Set("audible", contents->IsCurrentlyAudible());
+  tab.Set("can_back", contents->GetController().CanGoBack());
+  tab.Set("can_forward", contents->GetController().CanGoForward());
+  if (const AgensControlled* controlled = AgensControlled::FromWebContents(contents)) {
+    tab.Set("control", ControlFields(*controlled));
+  }
+  return tab;
+}
+
+gfx::Image FaviconOf(content::WebContents* contents) {
+  auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents);
+  return driver ? driver->GetFavicon() : gfx::Image();
+}
+
+bool SameImage(const gfx::Image& a, const gfx::Image& b) {
+  if (a.IsEmpty() || b.IsEmpty()) return a.IsEmpty() == b.IsEmpty();
+  return a.AsImageSkia().BackedBySameObjectAs(b.AsImageSkia());
+}
+
+base::DictValue TabOnly(int n) {
+  base::DictValue fields;
+  fields.Set("tab", ViewTabName(n));
+  return fields;
+}
+
+// Tells the host what changed since the last time: once per run of the message loop.
+void Flush() {
+  State& s = S();
+  s.flush_pending = false;
+  if (!s.host) return;
+  std::set<int> seen;
+  ForEachTab([&](AgensWindow* window, content::WebContents* contents) {
+    const int n = NumberOf(contents);
+    seen.insert(n);
+    base::DictValue tab = TabFields(window, contents);
+    auto it = s.sent.find(n);
+    if (it == s.sent.end() || !(it->second == tab)) {
+      SendEventTo(s.host, "view.tab", tab.Clone());
+      s.sent[n] = std::move(tab);
+    }
+    gfx::Image icon = FaviconOf(contents);
+    gfx::Image& known = s.icons[n];
+    if (!SameImage(known, icon)) {
+      known = icon;
+      SendEventTo(s.host, "view.favicon", TabOnly(n));
+    }
+  });
+  for (auto it = s.sent.begin(); it != s.sent.end();) {
+    if (seen.contains(it->first)) {
+      ++it;
+      continue;
+    }
+    SendEventTo(s.host, "view.closed", TabOnly(it->first));
+    s.icons.erase(it->first);
+    it = s.sent.erase(it);
+  }
+}
+
+void State::Schedule() {
+  if (!host || flush_pending) return;
+  flush_pending = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(&Flush));
+}
+
+void SendLayer(const Shown& shown) {
+  base::DictValue layer = TabOnly(shown.n);
+  layer.Set("context", static_cast<double>(shown.context));  // a uint32: past an int
+  layer.Set("width", static_cast<int>(std::lround(shown.pixels.width() / shown.scale)));
+  layer.Set("height", static_cast<int>(std::lround(shown.pixels.height() / shown.scale)));
+  layer.Set("scale", static_cast<double>(shown.scale));
+  SendEventTo(S().host, "view.layer", std::move(layer));
+}
+
+// Every frame of a tab drawing by itself: a new layer (process or size changed) goes to the host.
+void OnLayer(content::WebContents* contents, uint32_t context, const gfx::Size& pixels, float scale) {
+  LastLayer::CreateForWebContents(contents);  // no-op once it exists
+  LastLayer* last = LastLayer::FromWebContents(contents);
+  last->context = context;
+  last->pixels = pixels;
+  last->scale = scale > 0 ? scale : 1;
+  for (auto& shown : S().shown) {
+    if (shown->web_contents() != contents) continue;
+    if (shown->context == context && shown->pixels == pixels) return;
+    shown->context = context;
+    shown->pixels = pixels;
+    shown->scale = scale > 0 ? scale : 1;
+    // A new process has a new view: it gets the focus the old one had.
+    if (shown->focused) content::AgensEmbedSetFocus(contents, true);
+    SendLayer(*shown);
+    return;
+  }
+}
+
+void WatchLayers() {
+  static bool watching = false;
+  if (watching) return;
+  watching = true;
+  content::SetAgensEmbedLayerCallback(base::BindRepeating(&OnLayer));
+}
+
+// Just attached: the layer it already has, when it is at that size; else a frame is asked for.
+void SendCurrentLayer(Shown& shown) {
+  const LastLayer* last = LastLayer::FromWebContents(shown.web_contents());
+  if (last && last->context && std::lround(last->pixels.width() / last->scale) == shown.size.width() &&
+      std::lround(last->pixels.height() / last->scale) == shown.size.height()) {
+    shown.context = last->context;
+    shown.pixels = last->pixels;
+    shown.scale = last->scale;
+    SendLayer(shown);
+    return;
+  }
+  content::AgensEmbedRedraw(shown.web_contents());
+}
+
+std::optional<int> TabParam(const Request& request) {
+  const std::string* tab = request.body.FindString("tab");
+  return tab ? ParseViewTab(*tab) : std::nullopt;
+}
+
+// --- Input: no reply, malformed messages dropped, only to attached tabs.
+
+void Input(const Client& client, const Request& request) {
+  State& s = S();
+  if (client.connection != s.host) return;
+  std::optional<int> n = TabParam(request);
+  Shown* shown = n ? FindShown(*n) : nullptr;
+  if (!shown) return;
+  content::WebContents* contents = shown->web_contents();
+  const std::string& op = request.op;
+  if (op == "view.mouse" || op == "view.wheel") {
+    double x = 0, y = 0;
+    if (!ReadEventData(request.body, s.event_data) || !ReadPoint(request.body, x, y)) return;
+    const gfx::PointF point(x, y);
+    if (op == "view.mouse") {
+      content::AgensEmbedMouse(contents, base::as_byte_span(s.event_data), point);
+    } else {
+      content::AgensEmbedWheel(contents, base::as_byte_span(s.event_data), point);
+    }
+  } else if (op == "view.mouse.leave") {
+    content::AgensEmbedMouseLeave(contents);
+  } else if (op == "view.focus") {
+    std::optional<bool> on = request.body.FindBool("on");
+    if (!on) return;
+    if (*on) {
+      // One focused tab at a time.
+      for (auto& other : s.shown) {
+        if (other.get() != shown && other->focused && other->web_contents()) {
+          other->focused = false;
+          content::AgensEmbedSetFocus(other->web_contents(), false);
+        }
+      }
+      // The tab with the keyboard is its window's active tab (find, permission prompts…).
+      for (AgensWindow* window : s.windows) {
+        const int index = window->model()->GetIndexOfWebContents(contents);
+        if (index != TabStripModel::kNoTab && index != window->model()->active_index()) {
+          window->model()->ActivateTabAt(index);
+        }
+      }
+    }
+    shown->focused = *on;
+    content::AgensEmbedSetFocus(contents, *on);
+  } else if (op == "view.edit") {
+    const std::string* command = request.body.FindString("command");
+    if (command && IsEditCommand(*command)) content::AgensEmbedEdit(contents, *command);
+  } else if (op == "view.key") {
+    ViewKey read;
+    if (!ReadEventData(request.body, s.event_data) || !ReadViewKey(request.body, read)) return;
+    content::AgensEmbedKey key;
+    key.native_event.assign(s.event_data.begin(), s.event_data.end());
+    if (!base::UTF8ToUTF16(read.text.data(), read.text.size(), &key.text) ||
+        !base::UTF8ToUTF16(read.marked.data(), read.marked.size(), &key.marked)) {
+      return;
+    }
+    key.selectors = std::move(read.commands);
+    const int length = static_cast<int>(key.marked.length());
+    key.selection_start = std::clamp(read.sel_start.value_or(length), 0, length);
+    key.selection_end = std::clamp(read.sel_end.value_or(length), key.selection_start, length);
+    key.had_marked = read.had_marked;
+    key.unmarked = read.unmarked;
+    content::AgensEmbedKeyEvent(contents, key);
+  }
+}
+
+// --- Requests.
+
+void HostAttach(const Client& client, const Request& request, ReplyCallback reply) {
+  State& s = S();
+  // The parent that launched the engine, and still its parent (not reparented after it died).
+  if (client.pid <= 0 || client.pid != EmbeddedParent() || getppid() != EmbeddedParent()) {
+    std::move(reply).Run(ErrorReply(&request.id, kUnauthorized, "only the app that started the engine is its host"));
+    return;
+  }
+  if (s.host) {
+    std::move(reply).Run(s.host == client.connection
+                             ? ErrorReply(&request.id, kBadRequest, "already the host")
+                             : ErrorReply(&request.id, kUnauthorized, "another connection is the host"));
+    return;
+  }
+  s.host = client.connection;
+  WatchLayers();
+  std::move(reply).Run(OkReply(request.id));
+  s.Schedule();  // the tabs that exist already
+}
+
+void ViewTabs(const Request& request, ReplyCallback reply) {
+  const base::Value* ato_value = request.body.Find("ato");
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  if (ato_value && !ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "ato must be a string"));
+    return;
+  }
+  if (ato && !FindAto(*ato)) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  base::ListValue tabs;
+  ForEachTab([&](AgensWindow* window, content::WebContents* contents) {
+    if (!ato || AtoOf(window) == *ato) tabs.Append(TabFields(window, contents));
+  });
+  base::DictValue result;
+  result.Set("tabs", std::move(tabs));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+// A new foreground tab in the ato's window, made (off screen) when it has none.
+void OpenIn(Request request, ReplyCallback reply, GURL url, Profile* profile) {
+  if (!profile) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not load the ato"));
+    return;
+  }
+  BrowserWindowInterface* browser = nullptr;
+  for (AgensWindow* window : S().windows) {
+    BrowserWindowInterface* b = window->browser;
+    if (b->GetProfile() == profile && b->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+        !b->IsDeleteScheduled() && !b->GetTabStripModel()->closing_all()) {
+      browser = b;
+      break;
+    }
+  }
+  if (!browser) browser = CreateBrowserWindow(BrowserWindowCreateParams(*profile, /*from_user_gesture=*/false));
+  if (!browser) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the ato's window"));
+    return;
+  }
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  content::WebContents* contents = params.navigated_or_inserted_contents;
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kFailed, "could not open the tab"));
+    return;
+  }
+  base::DictValue result;
+  result.Set("tab", ViewTabName(NumberOf(contents)));
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+  S().Schedule();
+}
+
+void ViewOpen(Request request, ReplyCallback reply) {
+  std::optional<std::string> ato = StringParam(request.body, "ato");
+  const base::Value* url_value = request.body.Find("url");
+  GURL url(chrome::kChromeUINewTabURL);
+  if (url_value) {
+    url = url_value->is_string() ? GURL(url_value->GetString()) : GURL();
+    // Only web pages: the host's address bar goes through view.navigate.
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "url must be http or https"));
+      return;
+    }
+  }
+  if (!ato) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ato"));
+    return;
+  }
+  ProfileAttributesEntry* entry = FindAto(*ato);
+  if (!entry) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ato));
+    return;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  const base::FilePath path = entry->GetPath();
+  if (Profile* profile = manager->GetProfileByPath(path)) {
+    OpenIn(std::move(request), std::move(reply), url, profile);
+    return;
+  }
+  // The callback runs once in every case, with null when loading fails.
+  manager->LoadProfileByPath(path, /*incognito=*/false,
+                             base::BindOnce(&OpenIn, std::move(request), std::move(reply), url));
+}
+
+void ViewNavigate(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> text = StringParam(request.body, "text");
+  std::u16string input;
+  if (!text || text->empty() || !AtMostChars(*text, kMaxAddressChars) ||
+      !base::UTF8ToUTF16(text->data(), text->size(), &input)) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and text (up to 8192 characters)"));
+    return;
+  }
+  // What the address bar does with it: an address, or a search with the ato's engine.
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(Profile::FromBrowserContext(contents->GetBrowserContext()))
+      ->Classify(input, false, false, metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  if (!match.destination_url.is_valid()) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "not an address or a search"));
+    return;
+  }
+  contents->GetController().LoadURL(match.destination_url, content::Referrer(), ui::PAGE_TRANSITION_TYPED,
+                                    std::string());
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void ViewFavicon(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::string png;
+  if (gfx::Image icon = FaviconOf(contents); !icon.IsEmpty()) {
+    const SkBitmap& bitmap = icon.AsImageSkia().GetRepresentation(2.0f).GetBitmap();
+    std::optional<std::vector<uint8_t>> bytes = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false);
+    if (bytes) png = base::Base64Encode(*bytes);
+  }
+  base::DictValue result;
+  result.Set("png", std::move(png));  // empty: the tab has no icon
+  std::move(reply).Run(OkReply(request.id, std::move(result)));
+}
+
+void ViewControl(content::WebContents* contents, const Request& request, ReplyCallback reply) {
+  std::optional<std::string> action = StringParam(request.body, "action");
+  if (!action || (*action != "take" && *action != "give" && *action != "end")) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab and action: take, give or end"));
+    return;
+  }
+  const AgensControlled* controlled = AgensControlled::FromWebContents(contents);
+  if (!controlled) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, "no agent controls this tab"));
+    return;
+  }
+  // take pauses the agent ("Assumir"), give resumes it ("Devolver"), end ends its whole session.
+  // Posted, as the shell does: end removes the mark.
+  const base::RepeatingClosure& run =
+      *action == "take" ? controlled->take_over : *action == "give" ? controlled->hand_back : controlled->stop;
+  if (run) base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, run);
+  std::move(reply).Run(OkReply(request.id));
+}
+
+void ApprovalAnswer(const Request& request, ReplyCallback reply) {
+  State& s = S();
+  std::optional<std::string> ask = StringParam(request.body, "ask");
+  std::optional<std::string> answer_text = StringParam(request.body, "answer");
+  std::optional<int> answer = answer_text ? ParseApprovalAnswer(*answer_text) : std::nullopt;
+  if (!ask || !answer) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs ask and answer: allow, always or deny"));
+    return;
+  }
+  if (!s.answer || *ask != s.ask) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *ask));
+    return;
+  }
+  AgensApprovalAnswer result = static_cast<AgensApprovalAnswer>(*answer);
+  if (result == kAgensApprovalAllowAlways && !s.ask_offers_always) result = kAgensApprovalAllow;
+  ApprovalCallback done = std::move(s.answer);  // running it may ask the next one
+  std::move(reply).Run(OkReply(request.id));
+  std::move(done).Run(result);
+}
+
+void TabOp(const Request& request, ReplyCallback reply) {
+  State& s = S();
+  const std::string& op = request.op;
+  std::optional<int> n = TabParam(request);
+  content::WebContents* contents = n ? FindTab(*n) : nullptr;
+  if (!n) {
+    std::move(reply).Run(ErrorReply(&request.id, kBadRequest, "needs tab"));
+    return;
+  }
+  if (!contents) {
+    std::move(reply).Run(ErrorReply(&request.id, kNotFound, *request.body.FindString("tab")));
+    return;
+  }
+  content::NavigationController& controller = contents->GetController();
+  if (op == "view.attach" || op == "view.resize") {
+    int width = 0, height = 0;
+    double scale = 1;
+    if (!ReadViewSize(request.body, width, height, scale)) {
+      std::move(reply).Run(ErrorReply(&request.id, kBadRequest,
+                                      "needs tab, width and height (whole points, 1 to 8192) and scale (up to 8)"));
+      return;
+    }
+    // shortcut: `scale` is read but the tab draws at its screen's scale (the layer says which);
+    // honour it per tab when Retina and mixed displays get tested.
+    Shown* shown = FindShown(*n);
+    if (!shown && op == "view.resize") {
+      std::move(reply).Run(ErrorReply(&request.id, kNotFound, "the tab is not attached"));
+      return;
+    }
+    const bool attaching = op == "view.attach";
+    if (!shown) {
+      s.shown.push_back(std::make_unique<Shown>(contents, *n));
+      shown = s.shown.back().get();
+    }
+    shown->Resize(gfx::Size(width, height));
+    if (attaching) SendCurrentLayer(*shown);  // a new size draws anew; the same one may not
+  } else if (op == "view.detach") {
+    std::erase_if(s.shown, [&](const std::unique_ptr<Shown>& shown) { return shown->n == *n; });
+  } else if (op == "view.close") {
+    std::erase_if(s.shown, [&](const std::unique_ptr<Shown>& shown) { return shown->n == *n; });
+    ui_ask::TabClosing(contents);
+    contents->Close();
+  } else if (op == "view.navigate") {
+    ViewNavigate(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.back") {
+    if (controller.CanGoBack()) controller.GoBack();
+  } else if (op == "view.forward") {
+    if (controller.CanGoForward()) controller.GoForward();
+  } else if (op == "view.reload") {
+    controller.Reload(content::ReloadType::NORMAL, /*check_for_repost=*/true);
+  } else if (op == "view.stop") {
+    contents->Stop();
+  } else if (op == "view.favicon") {
+    ViewFavicon(contents, request, std::move(reply));
+    return;
+  } else if (op == "view.control") {
+    ViewControl(contents, request, std::move(reply));
+    return;
+  } else {
+    std::move(reply).Run(ErrorReply(&request.id, kUnknownOp, op));
+    return;
+  }
+  std::move(reply).Run(OkReply(request.id));
+}
