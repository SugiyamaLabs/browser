+// ---------------------------------------------------------------------------------------------
+// DevTools in the page card (prototipos/devtools.html): the page on top (or on the left), a 1 pt
+// divider, our dock bar and DevTools' own page. Side and size are the person's, for every ato.
+
+static NSString* const kDevToolsDockKey = @"AgensDevToolsDock";      // where it opens: bottom, right or window
+static NSString* const kDevToolsSideKey = @"AgensDevToolsSide";      // the side in the card used last
+static NSString* const kDevToolsHeightKey = @"AgensDevToolsHeight";  // at the bottom, bar included, pt
+static NSString* const kDevToolsWidthKey = @"AgensDevToolsWidth";    // on the right
+static const CGFloat kDevToolsBar = 28, kDevToolsMin = 120, kDevToolsPageMin = 200;
+static BOOL DevToolsOnRight() {
+  return [[NSUserDefaults.standardUserDefaults stringForKey:kDevToolsSideKey] isEqual:@"right"];
+}
+static BOOL DevToolsInWindow() {
+  return [[NSUserDefaults.standardUserDefaults stringForKey:kDevToolsDockKey] isEqual:@"window"];
+}
+// DevTools' part of `total` (the card's height, or width on the right): 40% or 420 pt at first,
+// then what the person dragged, kept to at least 120 pt of DevTools and 200 pt of page.
+static CGFloat DevToolsSize(CGFloat total) {
+  const BOOL right = DevToolsOnRight();
+  const CGFloat kept = [NSUserDefaults.standardUserDefaults doubleForKey:right ? kDevToolsWidthKey : kDevToolsHeightKey];
+  const CGFloat size = kept > 0 ? kept : right ? 420 : round(total * 0.4);
+  return floor(MAX(MIN(size, total - kDevToolsPageMin - 1), MIN(kDevToolsMin, total / 2)));
+}
+
+// The divider: a 1 pt line with 4 pt to grab on each side, warm with a handle while hovered or
+// dragged (prototype .dv).
+@interface AgensDevToolsDivider : NSView
+@property(nonatomic) BOOL vertical;  // DevTools on the right
+@property(nonatomic, copy) void (^onDrag)(NSPoint point, BOOL done);  // in the superview
+@end
+@implementation AgensDevToolsDivider {
+  NSTrackingArea* _tracking;
+  BOOL _hot, _dragging;
+  CALayer* _line;
+  CALayer* _grip;
+}
+@synthesize vertical = _vertical;
+@synthesize onDrag = _onDrag;
+- (instancetype)initWithFrame:(NSRect)frame {
+  if ((self = [super initWithFrame:frame])) {
+    self.wantsLayer = YES;
+    _line = [CALayer layer];
+    _grip = [CALayer layer];
+    _grip.cornerRadius = 2;
+    [self.layer addSublayer:_line];
+    [self.layer addSublayer:_grip];
+    self.accessibilityLabel = @"Arraste para mudar o tamanho";
+  }
+  return self;
+}
+- (BOOL)isFlipped {
+  return YES;
+}
+- (BOOL)mouseDownCanMoveWindow {
+  return NO;
+}
+- (NSAccessibilityRole)accessibilityRole {
+  return NSAccessibilitySplitterRole;
+}
+- (void)setVertical:(BOOL)vertical {
+  _vertical = vertical;
+  [self.window invalidateCursorRectsForView:self];
+  [self refresh];
+}
+- (void)layout {
+  [super layout];
+  [self refresh];
+}
+- (void)refresh {
+  [CATransaction begin];
+  [CATransaction setDisableActions:YES];
+  const NSRect b = self.bounds;
+  _line.frame = _vertical ? NSMakeRect(floor(NSMidX(b)), 0, 1, NSHeight(b)) : NSMakeRect(0, floor(NSMidY(b)), NSWidth(b), 1);
+  _grip.frame = _vertical ? NSMakeRect(NSMidX(b) - 2, NSMidY(b) - 16, 4, 32) : NSMakeRect(NSMidX(b) - 16, NSMidY(b) - 2, 32, 4);
+  const BOOL warm = _hot || _dragging;
+  _line.backgroundColor = CG(warm ? kLight3 : kLineStrong, self);
+  _grip.backgroundColor = CG(kLight3, self);
+  _grip.hidden = !warm;
+  [CATransaction commit];
+}
+- (void)viewDidChangeEffectiveAppearance {
+  [super viewDidChangeEffectiveAppearance];
+  [self refresh];
+}
+- (void)resetCursorRects {
+  [self addCursorRect:self.bounds cursor:_vertical ? NSCursor.resizeLeftRightCursor : NSCursor.resizeUpDownCursor];
+}
+- (void)updateTrackingAreas {
+  [super updateTrackingAreas];
+  if (_tracking) [self removeTrackingArea:_tracking];
+  _tracking = [[NSTrackingArea alloc] initWithRect:NSZeroRect
+                                           options:NSTrackingMouseEnteredAndExited | NSTrackingActiveInKeyWindow |
+                                                   NSTrackingInVisibleRect
+                                             owner:self
+                                          userInfo:nil];
+  [self addTrackingArea:_tracking];
+}
+- (void)mouseEntered:(NSEvent*)event {
+  _hot = YES;
+  [self refresh];
+}
+- (void)mouseExited:(NSEvent*)event {
+  _hot = NO;
+  [self refresh];
+}
+- (void)mouseDown:(NSEvent*)event {
+  _dragging = YES;
+  [self refresh];
+}
+- (void)mouseDragged:(NSEvent*)event {
+  if (_onDrag) _onDrag([self.superview convertPoint:event.locationInWindow fromView:nil], NO);
+}
+- (void)mouseUp:(NSEvent*)event {
+  _dragging = NO;
+  [self refresh];
+  if (_onDrag) _onDrag([self.superview convertPoint:event.locationInWindow fromView:nil], YES);
+}
+@end
+
