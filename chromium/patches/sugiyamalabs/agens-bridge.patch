+// Copyright 2026 SugiyamaLabs.
+// Extensions across atos (docs/extensoes.md): which atos have one, installing it into more atos
+// after the person chose them on the install prompt, adding one from a .crx or a folder, removing
+// it from every ato, the toolbar pins, the icons, and one place to hear about changes. Both shells
+// use it: the casca (agens_window.h, native_shell_mac.mm) and the embedded engine's host ops
+// (bridge/extension_ops.cc). Platform-neutral; UI thread.
+#ifndef CHROME_BROWSER_AGENS_EMBED_AGENS_EXTENSIONS_H_
+#define CHROME_BROWSER_AGENS_EMBED_AGENS_EXTENSIONS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+#include "ui/gfx/image/image.h"
+#include "ui/gfx/native_ui_types.h"
+
+class Profile;
+namespace content {
+class WebContents;
+}
+namespace extensions {
+class Extension;
+class ExtensionAction;
+}  // namespace extensions
+
+namespace agens::ext {
+
+// Starts watching every ato that loads (once; both shells call it with their first window).
+void Start();
+
+class Observer : public base::CheckedObserver {
+ public:
+  // `change`: installed, updated, enabled, disabled, removed or pinned.
+  virtual void OnExtensionChanged(Profile* ato, const std::string& id, std::string_view change) {}
+  // The action's icon, badge, title, visibility or popup changed: on `tab`, or on every tab of
+  // the ato when null.
+  virtual void OnExtensionActionChanged(Profile* ato, const std::string& id, content::WebContents* tab) {}
+};
+void AddObserver(Observer* observer);
+void RemoveObserver(Observer* observer);
+
+// The ato's id (its profile folder's name).
+std::string AtoId(Profile* profile);
+// An extension the person installed (not a component or one built in).
+bool Listed(const extensions::Extension& extension);
+// "store", "file" (a .crx) or "folder" (unpacked, linked to its folder).
+std::string From(const extensions::Extension& extension);
+// The ids of the atos that have it, in the atos' order: a loaded ato says so itself; a sleeping
+// one by what it had the last time it was awake.
+std::vector<std::string> AtosWith(const std::string& id);
+
+// For the install prompt (ui.ask "extension", the casca's sheet): every ato,
+// [{id, name, color, installed}].
+base::ListValue AtoChoices(const std::string& id);
+// The person allowed the install in `asking` and chose `atos` as well (ids; the asking one and
+// unknown ones are skipped): once `asking` has it, it goes into each of them, waking the sleeping
+// ones. Only the prompt calls this: the person's choice is what lets it into other atos.
+void AlsoInstallInto(Profile* asking, const std::string& id, std::vector<std::string> atos);
+
+// "Adicionar de um arquivo": a .crx file or an unpacked folder (absolute paths). The person is
+// asked first, with the same prompt as the store's (and its ato choice). `done` runs once with
+// the id, or an error: "denied" (the person said no) or "failed".
+using InstallDone = base::OnceCallback<void(const std::string& id, const std::string& error)>;
+void InstallFromDisk(Profile* profile, const base::FilePath& path, gfx::NativeWindow parent, InstallDone done);
+
+// Uninstalls it from `profile`, or from every ato that has it (sleeping ones are woken). `done`
+// runs once, when all are done.
+void Remove(Profile* profile, std::string id, bool all, base::OnceClosure done);
+
+// Kept in the bar (the rest are only in the puzzle menu). Per ato, saved with it.
+bool Pinned(Profile* profile, const std::string& id);
+void SetPinned(Profile* profile, const std::string& id, bool pinned);
+
+// The icon the extension's action set for the tab (action.setIcon, declarative content), as a
+// 32 px PNG; empty when it set none.
+std::vector<uint8_t> SetIcon(Profile* profile, const extensions::Extension& extension, int tab_id);
+// The icon file: the action's default (`of_action`) or, without one, the extension's own. `done`
+// gets a 32 px PNG (empty when there is none), later.
+void LoadIcon(Profile* profile,
+              const extensions::Extension& extension,
+              bool of_action,
+              base::OnceCallback<void(std::vector<uint8_t> png)> done);
+// A PNG of `image` at `scale` (2 for the toolbar's 16 pt), or empty.
+std::vector<uint8_t> EncodePng(const gfx::Image& image, float scale = 2);
+
+}  // namespace agens::ext
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_AGENS_EXTENSIONS_H_
