+static NSString* SwapScheme(NSString* url, NSString* from, NSString* to, BOOL toAgens) {
+  if (![url.lowercaseString hasPrefix:from]) return url;
+  NSString* rest = [url substringFromIndex:from.length];
+  const NSRange end = [rest rangeOfCharacterFromSet:[NSCharacterSet characterSetWithCharactersInString:@"/?#"]];
+  NSString* host = (end.location == NSNotFound ? rest : [rest substringToIndex:end.location]).lowercaseString;
+  NSString* swapped = toAgens ? AgensHosts()[host] : [AgensHosts() allKeysForObject:host].firstObject;
+  return [to stringByAppendingString:swapped ? [swapped stringByAppendingString:[rest substringFromIndex:host.length]] : rest];
+}
