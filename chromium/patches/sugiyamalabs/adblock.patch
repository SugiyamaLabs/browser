diff --git a/third_party/sugiyamalabs_adblock/BUILD.gn b/third_party/sugiyamalabs_adblock/BUILD.gn
new file mode 100644
index 0000000000..7bcf900e59
--- /dev/null
+++ b/third_party/sugiyamalabs_adblock/BUILD.gn
@@ -0,0 +1,34 @@
+# SugiyamaLabs: ad blocker ruleset, built from the filter lists that
+# chromium/fetch.sh copies into lists/ (from chromium/adblock/lists in our repo).
+# The browser never downloads lists: they change only with an app update.
+
+import("//build/compiled_action.gni")
+
+_lists = [
+  "lists/easylist.txt",
+  "lists/easyprivacy.txt",
+  "lists/ublock-filters.txt",
+  "lists/ublock-privacy.txt",
+]
+
+compiled_action("ruleset") {
+  tool = "//components/subresource_filter/tools:ruleset_converter"
+  inputs = _lists
+  outputs = [ "$target_gen_dir/adblock_rules" ]
+  args = [
+    "--input_format=filter-list",
+    "--output_format=unindexed-ruleset",
+    "--input_files=" + string_join(",", rebase_path(_lists, root_build_dir)),
+    # URL rules only. shortcut: no cosmetic (CSS) rules, the style indexer
+    # DCHECKs on the list order; add them when cosmetic filtering is done.
+    "--output_file_url=" + rebase_path(outputs[0], root_build_dir),
+  ]
+}
+
+if (is_mac) {
+  bundle_data("bundle_data") {
+    sources = get_target_outputs(":ruleset")
+    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
+    public_deps = [ ":ruleset" ]
+  }
+}
