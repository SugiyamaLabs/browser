+
+namespace content {
+
+namespace {
+
+AgensEmbedLayerCallback& LayerCallback() {
+  static base::NoDestructor<AgensEmbedLayerCallback> callback;
+  return *callback;
+}
+
+// The tab's own view. Null while the tab has none (crashed, or still being set up).
+RenderWidgetHostViewMac* ViewFor(WebContents* contents) {
+  return contents ? static_cast<RenderWidgetHostViewMac*>(contents->GetRenderWidgetHostView())
+                  : nullptr;
+}
+
+ui::LatencyInfo Latency() {
+  ui::LatencyInfo latency;
+  latency.AddLatencyNumber(ui::INPUT_EVENT_LATENCY_UI_COMPONENT);
+  return latency;
+}
+
+}  // namespace
+
+AgensEmbedKey::AgensEmbedKey() = default;
+AgensEmbedKey::~AgensEmbedKey() = default;
+
+void SetAgensEmbedLayerCallback(AgensEmbedLayerCallback callback) {
+  LayerCallback() = std::move(callback);
+}
+
+void AgensEmbedLayerUpdated(RenderWidgetHostViewMac* view, const gfx::CALayerParams& params) {
+  if (!LayerCallback() || !params.ca_context_id) return;
+  // Only a page's main view: popups (a <select>'s list) have no RenderViewHost.
+  RenderViewHost* rvh = RenderViewHost::From(view->host());
+  WebContents* contents = rvh ? WebContents::FromRenderViewHost(rvh) : nullptr;
+  if (contents) {
+    LayerCallback().Run(contents, params.ca_context_id, params.pixel_size, params.scale_factor);
+  }
+}
+
+void AgensEmbedSetFocus(WebContents* contents, bool focused) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  // The same two notifications the NSView sends, in the order that makes the page active and
+  // focused (see RenderWidgetHostViewMac::OnFirstResponderChanged).
+  if (focused) {
+    view->OnFirstResponderChanged(true);
+    view->OnWindowIsKeyChanged(true);
+  } else {
+    view->OnWindowIsKeyChanged(false);
+    view->OnFirstResponderChanged(false);
+  }
+}
+
+void AgensEmbedMouse(WebContents* contents,
+                     base::span<const uint8_t> native_event,
+                     const gfx::PointF& point) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  NSEvent* event = ui::EventFromData(native_event);
+  if (!view || !event) return;
+  blink::WebMouseEvent mouse =
+      input::WebMouseEventBuilder::Build(event, view->GetNativeView().GetNativeNSView());
+  // The event's own location belongs to the other app's window.
+  mouse.SetPositionInWidget(point);
+  // shortcut: the screen position is the view's; popups placed from it land wrong until the other
+  // app also sends where its view is on screen.
+  mouse.SetPositionInScreen(point);
+  view->RouteOrProcessMouseEvent(mouse);
+}
+
+void AgensEmbedMouseLeave(WebContents* contents) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  view->RouteOrProcessMouseEvent(blink::WebMouseEvent(
+      blink::WebInputEvent::Type::kMouseLeave, 0, base::TimeTicks::Now()));
+}
+
+void AgensEmbedWheel(WebContents* contents,
+                     base::span<const uint8_t> native_event,
+                     const gfx::PointF& point) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  NSEvent* event = ui::EventFromData(native_event);
+  if (!view || !event || event.type != NSEventTypeScrollWheel) return;
+  blink::WebMouseWheelEvent wheel =
+      input::WebMouseWheelEventBuilder::Build(event, view->GetNativeView().GetNativeNSView());
+  wheel.SetPositionInWidget(point);
+  wheel.SetPositionInScreen(point);
+  view->RouteOrProcessWheelEvent(wheel);
+}
+
+// The part of -[RenderWidgetHostViewCocoa keyEvent:wasKeyEquivalent:] that runs after
+// -interpretKeyEvents:; the other app did that step and sent what came out of it.
+// shortcut: no key equivalents, keyboard lock or "delay the key until the composition ends"
+// (crbug.com/48161); add them when a real IME shows the difference.
+void AgensEmbedKeyEvent(WebContents* contents, const AgensEmbedKey& key) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  NSEvent* ns_event = ui::EventFromData(key.native_event);
+  if (!view || !ns_event) return;
+  const NSEventType type = ns_event.type;
+  if (type != NSEventTypeKeyDown && type != NSEventTypeKeyUp && type != NSEventTypeFlagsChanged) {
+    return;
+  }
+  input::NativeWebKeyboardEvent event((base::apple::OwnedNSEvent(ns_event)));
+  const ui::LatencyInfo latency = Latency();
+
+  view->BeginKeyboardEvent();
+  if (type != NSEventTypeKeyDown) {
+    view->ForwardKeyboardEvent(event, latency);
+    view->EndKeyboardEvent();
+    return;
+  }
+
+  // Commands that insert characters are left out, as upstream does (Tab would insert a tab
+  // instead of moving to the next field); the key then goes on as a keypress below.
+  std::vector<blink::mojom::EditCommandPtr> commands;
+  bool has_commands = false;
+  for (const std::string& selector : key.selectors) {
+    if (selector == "noop:") continue;
+    has_commands = true;
+    const std::string command =
+        base::SysNSStringToUTF8(RenderWidgetHostViewMacEditCommandHelper::CommandNameForSelector(
+            NSSelectorFromString(base::SysUTF8ToNSString(selector))));
+    if (!base::StartsWith(command, "insert", base::CompareCase::INSENSITIVE_ASCII)) {
+      commands.push_back(blink::mojom::EditCommand::New(command, ""));
+    }
+  }
+  const bool commands_empty = commands.empty();
+  const bool has_marked = !key.marked.empty();
+
+  if (has_marked || key.had_marked || key.text.length() > 1) {
+    input::NativeWebKeyboardEvent fake = event;
+    fake.windows_key_code = 0xE5;  // VKEY_PROCESSKEY: an input method is composing
+    fake.skip_if_unhandled = true;
+    view->ForwardKeyboardEvent(fake, latency);
+  } else {
+    view->ForwardKeyboardEventWithCommands(event, latency, std::move(commands));
+  }
+
+  bool inserted = false;
+  if (key.text.length() > ((has_marked || key.had_marked) ? 0u : 1u)) {
+    view->ImeCommitText(key.text, gfx::Range::InvalidRange());
+    inserted = true;
+  }
+  if (has_marked) {
+    view->ImeSetComposition(key.marked, {}, gfx::Range::InvalidRange(), key.selection_start,
+                            key.selection_end);
+  } else if (key.had_marked && !inserted) {
+    if (key.unmarked) {
+      view->ImeFinishComposingText();
+    } else {
+      view->ImeCancelCompositionFromCocoa();
+    }
+  }
+
+  if (!has_marked) {
+    const NSEventModifierFlags kCtrlCmd = NSEventModifierFlagControl | NSEventModifierFlagCommand;
+    if (!inserted && key.text.length() == 1) {
+      event.SetType(blink::WebInputEvent::Type::kChar);
+      event.text[0] = key.text[0];
+      event.text[1] = 0;
+      event.skip_if_unhandled = true;
+      view->ForwardKeyboardEvent(event, latency);
+    } else if (!inserted && event.text[0] != '\0' &&
+               ((ns_event.modifierFlags & kCtrlCmd) || (has_commands && commands_empty))) {
+      event.SetType(blink::WebInputEvent::Type::kChar);
+      event.skip_if_unhandled = true;
+      view->ForwardKeyboardEvent(event, latency);
+    }
+  }
+  view->EndKeyboardEvent();
+}
+
+void AgensEmbedEdit(WebContents* contents, const std::string& command) {
+  RenderWidgetHostViewMac* view = ViewFor(contents);
+  if (!view) return;
+  if (command == "cut") view->Cut();
+  else if (command == "copy") view->Copy();
+  else if (command == "paste") view->Paste();
+  else if (command == "selectAll") view->SelectAll();
+  else if (command == "undo") view->Undo();
+  else if (command == "redo") view->Redo();
+}
+
+}  // namespace content
