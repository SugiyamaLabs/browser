@@ -0,0 +1,21 @@
+// Copyright 2026 SugiyamaLabs.
+// Session ops for the bridges: login, session, renew (docs/agens.md, "Sessão"). UI thread; see
+// ops.h for what a handler gets.
+#ifndef CHROME_BROWSER_AGENS_BRIDGE_SESSION_OPS_H_
+#define CHROME_BROWSER_AGENS_BRIDGE_SESSION_OPS_H_
+
+#include <cstdint>
+#include <string_view>
+
+#include "chrome/browser/agens/bridge/ops.h"
+
+namespace agens::bridge::session {
+
+// True for the ops this area answers.
+bool Handles(std::string_view op);
+void HandleOp(const Client& client, Request request, ReplyCallback reply);
+void OnConnectionClosed(uint64_t connection);
+
+}  // namespace agens::bridge::session
