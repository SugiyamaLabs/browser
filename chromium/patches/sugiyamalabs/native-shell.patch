+// Copyright 2026 SugiyamaLabs.
+// Glue between Chromium's Webium window (WebUIBrowserWindow, without its HTML page) and the
+// agens_embed.h interface.
+#ifndef CHROME_BROWSER_AGENS_EMBED_NATIVE_SHELL_H_
+#define CHROME_BROWSER_AGENS_EMBED_NATIVE_SHELL_H_
+
+#include <memory>
+
+#include "base/feature_list.h"
+#include "base/functional/callback_forward.h"
+
+class BrowserWindowInterface;
+class StatusBubble;
+namespace views {
+class View;
+class Widget;
+}  // namespace views
+
+namespace agens {
+
+// On by default together with Webium. --disable-features=Webium brings back the Views window.
+BASE_DECLARE_FEATURE(kAgensNativeShell);
+bool IsNativeShellEnabled();
+
+std::unique_ptr<views::View> CreateNativeShellView(BrowserWindowInterface* browser);
+void FocusNativeLocationBar(views::Widget* widget);
+// The window's status bubble (link URL), or null when the native shell isn't in this widget.
+StatusBubble* NativeStatusBubble(views::Widget* widget);
+// True for the native shell's bubble. Chromium casts status bubbles to StatusBubbleViews in a
+// couple of places; those check this first.
+bool IsNativeStatusBubble(const StatusBubble* bubble);
+// Asks whether to close the window and cancel `count` downloads; answers through `callback`.
+void ConfirmCloseWithDownloads(views::Widget* widget, int count, base::OnceCallback<void(bool)> callback);
+
+}  // namespace agens
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_NATIVE_SHELL_H_
