+// --- Building blocks of a section (prototype .group / .opt)
+- (CGFloat)heading:(NSString*)text y:(CGFloat)y {
+  NSTextField* h = Label(17, NSFontWeightSemibold, kInk);
+  h.stringValue = text;
+  h.frame = NSMakeRect(32, y, NSWidth(_pane.bounds) - 64, 24);
+  [_pane addSubview:h];
+  return y + 40;
+}
+// A row without a control: what's true today, or that the thing doesn't exist yet.
+- (CGFloat)info:(NSString*)label detail:(NSString*)detail note:(NSString*)note y:(CGFloat)y {
+  NSTextField* n = Label(12, NSFontWeightRegular, kDim);
+  n.stringValue = note ?: @"";
+  n.alignment = NSTextAlignmentRight;
+  [n sizeToFit];  // created empty, it would keep the width of an empty string
+  return [self option:label detail:detail control:n y:y];
+}
+- (CGFloat)option:(NSString*)label detail:(NSString*)detail control:(NSView*)control y:(CGFloat)y {
+  CGFloat w = NSWidth(_pane.bounds) - 64;
+  NSView* group = [[NSView alloc] initWithFrame:NSMakeRect(32, y, w, 56)];
+  group.wantsLayer = YES;
+  group.layer.cornerRadius = 10;
+  group.layer.borderWidth = 1;
+  group.layer.borderColor = CG(kLine, _pane);
+  group.layer.backgroundColor = CG(kRaise, _pane);
+  // Controls given a width (sliders, fields, color wells) keep it; the rest take their natural size.
+  NSSize cs = control.fittingSize;
+  if (NSWidth(control.frame) > 0) cs = NSMakeSize(NSWidth(control.frame), MAX(NSHeight(control.frame), cs.height));
+  cs.width = MIN(cs.width, w * 0.45);
+  const CGFloat textW = w - 16 - cs.width - 24;
+  NSTextField* l = Label(13, NSFontWeightRegular, kInk);
+  l.stringValue = label;
+  l.frame = NSMakeRect(16, detail ? 30 : 19, textW, 18);
+  [group addSubview:l];
+  if (detail) {
+    NSTextField* d = Label(11.5, NSFontWeightRegular, kDim);
+    d.stringValue = detail;
+    d.toolTip = detail;
+    d.frame = NSMakeRect(16, 12, textW, 15);
+    [group addSubview:d];
+  }
+  if (!control.accessibilityLabel.length) control.accessibilityLabel = label;  // VoiceOver reads the row's name
+  control.frame = NSMakeRect(w - 16 - cs.width, (56 - cs.height) / 2, cs.width, cs.height);
+  [group addSubview:control];
+  [_pane addSubview:group];
+  return y + 64;
+}
+- (NSSegmentedControl*)segments:(NSArray<NSString*>*)labels selected:(NSInteger)i action:(SEL)action {
+  NSSegmentedControl* seg = [NSSegmentedControl segmentedControlWithLabels:labels
+                                                              trackingMode:NSSegmentSwitchTrackingSelectOne
+                                                                    target:self
+                                                                    action:action];
+  seg.selectedSegment = i;
+  return seg;
+}
