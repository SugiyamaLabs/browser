index 0000000000..152312203b
--- /dev/null
+++ b/chrome/browser/agens/embed/native_shell.h
@@ -0,0 +1,28 @@
+// Copyright 2026 SugiyamaLabs.
+// Glue between Chromium's Webium window (WebUIBrowserWindow, without its HTML page) and the
+// agens_embed.h interface.
+#ifndef CHROME_BROWSER_AGENS_EMBED_NATIVE_SHELL_H_
+#define CHROME_BROWSER_AGENS_EMBED_NATIVE_SHELL_H_
+
+#include <memory>
+
+#include "base/feature_list.h"
+
+class BrowserWindowInterface;
+namespace views {
+class View;
+class Widget;
+}  // namespace views
+
+namespace agens {
+
+// On by default together with Webium. --disable-features=Webium brings back the Views window.
+BASE_DECLARE_FEATURE(kAgensNativeShell);
+bool IsNativeShellEnabled();
+
+std::unique_ptr<views::View> CreateNativeShellView(BrowserWindowInterface* browser);
+void FocusNativeLocationBar(views::Widget* widget);
+
+}  // namespace agens
+
+#endif  // CHROME_BROWSER_AGENS_EMBED_NATIVE_SHELL_H_
diff --git a/chrome/browser/agens/embed/native_shell_mac.mm b/chrome/browser/agens/embed/native_shell_mac.mm
new file mode 100644
index 0000000000..19131df5a0
--- /dev/null
+++ b/chrome/browser/agens/embed/native_shell_mac.mm
@@ -0,0 +1,405 @@
+// Copyright 2026 SugiyamaLabs.
+// Engine side of agens_embed.h on macOS: an AgensWindow over the Browser's tab strip, and the
+// views::View that fills the Webium window (the UI's sidebar beside the active tab).
+
+#include "chrome/browser/agens/embed/native_shell.h"
+
+#import <AppKit/AppKit.h>
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/agens/embed/agens_embed.h"
+#include "chrome/browser/autocomplete/autocomplete_classifier_factory.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_provider_client.h"
+#include "chrome/browser/autocomplete/chrome_autocomplete_scheme_classifier.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/strings/stringprintf.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_element_identifiers.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/favicon/content/content_favicon_driver.h"
+#include "components/omnibox/browser/autocomplete_classifier.h"
+#include "components/omnibox/browser/autocomplete_controller.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_rep.h"
+#include "ui/base/base_window.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+
+struct AgensWindow : public TabStripModelObserver,
+                     public AutocompleteController::Observer,
+                     public ProfileAttributesStorage::Observer {
+  explicit AgensWindow(BrowserWindowInterface* browser) : browser(browser) {
+    browser->GetTabStripModel()->AddObserver(this);
+    Storage().AddObserver(this);
+  }
+  ~AgensWindow() override { Storage().RemoveObserver(this); }
+
+  static ProfileAttributesStorage& Storage() {
+    return g_browser_process->profile_manager()->GetProfileAttributesStorage();
+  }
+
+  std::vector<ProfileAttributesEntry*> Atos() {
+    std::vector<ProfileAttributesEntry*> atos;
+    for (ProfileAttributesEntry* entry : Storage().GetAllProfilesAttributesSortedByLocalProfileNameWithCheck()) {
+      if (!entry->IsOmitted()) atos.push_back(entry);
+    }
+    return atos;
+  }
+
+  void NotifyAtos() {
+    if (!atos_observer) return;
+    std::vector<ProfileAttributesEntry*> entries = Atos();
+    std::vector<std::string> names;
+    std::vector<AgensAto> atos;
+    const base::FilePath current = browser->GetProfile()->GetOriginalProfile()->GetPath();
+    for (ProfileAttributesEntry* entry : entries) {
+      // Chromium's first profile is "Pessoa 1"; ours is the personal ato.
+      names.push_back(entry->IsUsingDefaultName() && entry->GetPath() == entries.front()->GetPath()
+                          ? "Pessoal"
+                          : base::UTF16ToUTF8(entry->GetLocalProfileName()));
+    }
+    for (size_t i = 0; i < entries.size(); ++i) {
+      atos.push_back({names[i].c_str(), entries[i]->GetPath() == current,
+                      !g_browser_process->profile_manager()->GetProfileByPath(entries[i]->GetPath())});
+    }
+    atos_observer(atos_context, atos.data(), static_cast<int>(atos.size()));
+  }
+
+  void SwitchAto(int index) {
+    std::vector<ProfileAttributesEntry*> atos = Atos();
+    if (index < 0 || static_cast<size_t>(index) >= atos.size()) return;
+    const gfx::Rect bounds = browser->GetWindow()->GetBounds();
+    profiles::SwitchToProfile(atos[index]->GetPath(), /*always_create=*/false,
+                              base::BindOnce(&AgensWindow::PlaceOver, bounds));
+  }
+
+  void NewAto() {
+    const gfx::Rect bounds = browser->GetWindow()->GetBounds();
+    ProfileManager::CreateMultiProfileAsync(
+        base::UTF8ToUTF16(base::StringPrintf("Ato %zu", Atos().size() + 1)), /*icon_index=*/0,
+        /*is_hidden=*/false, base::BindOnce([](const gfx::Rect& bounds, Profile* profile) {
+          if (!profile) return;
+          profiles::OpenBrowserWindowForProfile(base::BindOnce(&AgensWindow::PlaceOver, bounds),
+                                                /*always_create=*/true, /*is_new_profile=*/true,
+                                                /*open_command_line_urls=*/false, profile);
+        }, bounds));
+  }
+
+  // The ato's window takes this window's place, so switching feels like one window.
+  static void PlaceOver(const gfx::Rect& bounds, BrowserWindowInterface* other) {
+    if (other) other->GetWindow()->SetBounds(bounds);
+  }
+
+  // ProfileAttributesStorage::Observer:
+  void OnProfileAdded(const base::FilePath&) override { NotifyAtos(); }
+  void OnProfileWasRemoved(const base::FilePath&, const std::u16string&) override { NotifyAtos(); }
+  void OnProfileNameChanged(const base::FilePath&, const std::u16string&) override { NotifyAtos(); }
+
+  TabStripModel* model() { return browser->GetTabStripModel(); }
+
+  void Notify() {
+    if (!observer) return;
+    const int count = model()->count();
+    std::vector<std::string> titles(count), urls(count);
+    std::vector<std::vector<uint8_t>> icons(count);
+    std::vector<AgensTab> tabs(count);
+    for (int i = 0; i < count; ++i) {
+      content::WebContents* contents = model()->GetWebContentsAt(i);
+      titles[i] = base::UTF16ToUTF8(contents->GetTitle());
+      urls[i] = contents->GetVisibleURL().spec();
+      if (urls[i].starts_with("chrome://newtab")) urls[i].clear();
+      if (auto* driver = favicon::ContentFaviconDriver::FromWebContents(contents)) {
+        gfx::Image icon = driver->GetFavicon();
+        if (!icon.IsEmpty()) {
+          const SkBitmap& bitmap = icon.AsImageSkia().GetRepresentation(2.0f).GetBitmap();
+          icons[i] = gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, false).value_or(std::vector<uint8_t>());
+        }
+      }
+      tabs[i] = {titles[i].c_str(), urls[i].c_str(), icons[i].empty() ? nullptr : icons[i].data(),
+                 static_cast<int>(icons[i].size()), i == model()->active_index(),
+                 contents->IsLoading(), contents->WasDiscarded(),
+                 contents->GetController().CanGoBack(), contents->GetController().CanGoForward()};
+    }
+    observer(context, tabs.data(), static_cast<int>(tabs.size()));
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                              const TabStripSelectionChange&) override {
+    Notify();
+    NotifyAtos();  // cheap; keeps "asleep" fresh as atos load and unload
+  }
+  void OnTabChangedAt(tabs::TabInterface*, TabChangeType) override { Notify(); }
+
+  void Suggest(const std::string& text) {
+    if (!autocomplete) {
+      AutocompleteControllerConfig config;
+      // Local sources only. kSearch adds the "search for what you typed" row; its remote
+      // suggestions follow kSearchSuggestEnabled, which ungoogled turns off.
+      config.provider_types = static_cast<int>(
+          AutocompleteProvider::Type::kBookmark | AutocompleteProvider::Type::kBuiltin |
+          AutocompleteProvider::Type::kHistoryQuick | AutocompleteProvider::Type::kHistoryUrl |
+          AutocompleteProvider::Type::kSearch | AutocompleteProvider::Type::kShortcuts |
+          AutocompleteProvider::Type::kCalculator);
+      autocomplete = std::make_unique<AutocompleteController>(
+          std::make_unique<ChromeAutocompleteProviderClient>(browser->GetProfile()), config);
+      autocomplete->AddObserver(this);
+    }
+    if (text.empty()) {
+      autocomplete->Stop(AutocompleteStopReason::kClobbered);
+      PublishSuggestions();
+      return;
+    }
+    AutocompleteInput input(base::UTF8ToUTF16(text), metrics::OmniboxEventProto::OTHER,
+                            ChromeAutocompleteSchemeClassifier(browser->GetProfile()));
+    autocomplete->Start(input);
+  }
+
+  void OpenSuggestion(int index) {
+    content::WebContents* active = model()->GetActiveWebContents();
+    if (!autocomplete || !active || index < 0 ||
+        static_cast<size_t>(index) >= autocomplete->result().size()) {
+      return;
+    }
+    const GURL url = autocomplete->result().match_at(index).destination_url;
+    autocomplete->Stop(AutocompleteStopReason::kClobbered);
+    if (!url.is_valid()) return;
+    active->GetController().LoadURL(url, content::Referrer(), ui::PAGE_TRANSITION_TYPED,
+                                    std::string());
+    active->Focus();
+  }
+
+  void PublishSuggestions() {
+    if (!suggestions_observer) return;
+    std::vector<std::string> texts, details;
+    std::vector<AgensSuggestion> out;
+    const AutocompleteResult& result = autocomplete->result();
+    const size_t count = std::min<size_t>(result.size(), 6);
+    texts.reserve(count);
+    details.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+      const AutocompleteMatch& match = result.match_at(i);
+      const bool search = AutocompleteMatch::IsSearchType(match.type);
+      texts.push_back(base::UTF16ToUTF8(search ? match.contents : match.contents));
+      details.push_back(search ? std::string() : base::UTF16ToUTF8(match.description));
+    }
+    for (size_t i = 0; i < count; ++i) {
+      out.push_back({texts[i].c_str(), details[i].c_str(),
+                     AutocompleteMatch::IsSearchType(result.match_at(i).type)});
+    }
+    suggestions_observer(suggestions_context, out.data(), static_cast<int>(out.size()));
+  }
+
+  // AutocompleteController::Observer:
+  void OnResultChanged(AutocompleteController*, bool) override { PublishSuggestions(); }
+
+  raw_ptr<BrowserWindowInterface> browser;
+  AgensTabsChanged observer = nullptr;
+  raw_ptr<void> context = nullptr;
+  AgensAtosChanged atos_observer = nullptr;
+  raw_ptr<void> atos_context = nullptr;
+  AgensSuggestionsChanged suggestions_observer = nullptr;
+  raw_ptr<void> suggestions_context = nullptr;
+  std::unique_ptr<AutocompleteController> autocomplete;
+  base::RepeatingClosure relayout;
+};
+
+extern "C" {
+
+void agens_window_set_tabs_observer(AgensWindow* w, AgensTabsChanged observer, void* context) {
+  w->observer = observer;
+  w->context = context;
+  w->Notify();
+}
+void agens_window_set_suggestions_observer(AgensWindow* w, AgensSuggestionsChanged observer,
+                                           void* context) {
+  w->suggestions_observer = observer;
+  w->suggestions_context = context;
+}
+void agens_window_set_atos_observer(AgensWindow* w, AgensAtosChanged observer, void* context) {
+  w->atos_observer = observer;
+  w->atos_context = context;
+  w->NotifyAtos();
+}
+void agens_window_switch_ato(AgensWindow* w, int index) {
+  w->SwitchAto(index);
+}
+void agens_window_new_ato(AgensWindow* w) {
+  w->NewAto();
+}
+void agens_window_suggest(AgensWindow* w, const char* text) {
+  w->Suggest(text ? text : "");
+}
+void agens_window_open_suggestion(AgensWindow* w, int index) {
+  w->OpenSuggestion(index);
+}
+void agens_window_new_tab(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_NEW_TAB);
+}
+void agens_window_activate_tab(AgensWindow* w, int index) {
+  if (w->model()->ContainsIndex(index)) w->model()->ActivateTabAt(index);
+}
+void agens_window_close_tab(AgensWindow* w, int index) {
+  if (w->model()->ContainsIndex(index)) {
+    w->model()->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE | TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+void agens_window_navigate(AgensWindow* w, const char* text) {
+  content::WebContents* active = w->model()->GetActiveWebContents();
+  std::u16string input = base::UTF8ToUTF16(text ? text : "");
+  if (!active || input.empty()) return;
+  AutocompleteMatch match;
+  AutocompleteClassifierFactory::GetForProfile(w->browser->GetProfile())
+      ->Classify(input, false, false, metrics::OmniboxEventProto::OTHER, &match, nullptr);
+  if (!match.destination_url.is_valid()) return;
+  active->GetController().LoadURL(match.destination_url, content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  active->Focus();
+}
+void agens_window_back(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_BACK);
+}
+void agens_window_forward(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_FORWARD);
+}
+void agens_window_reload(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_RELOAD);
+}
+void agens_window_relayout(AgensWindow* w) {
+  if (w->relayout) w->relayout.Run();
+}
+void agens_window_stop(AgensWindow* w) {
+  chrome::ExecuteCommand(w->browser, IDC_STOP);
+}
+
+}  // extern "C"
+
+namespace agens {
+
+BASE_FEATURE(kAgensNativeShell, base::FEATURE_ENABLED_BY_DEFAULT);
+
+bool IsNativeShellEnabled() {
+  return base::FeatureList::IsEnabled(kAgensNativeShell);
+}
+
+namespace {
+
+class NativeShellView : public views::View, public TabStripModelObserver {
+  METADATA_HEADER(NativeShellView, views::View)
+
+ public:
+  static constexpr float kRadius = 12;  // the page card, as in the prototype
+  static constexpr int kViewId = 0x4167;  // lookup from the window (Cmd+L)
+
+  explicit NativeShellView(BrowserWindowInterface* browser)
+      : window_(std::make_unique<AgensWindow>(browser)) {
+    SetID(kViewId);
+    card_ = AddChildView(std::make_unique<views::View>());
+    contents_ = AddChildView(std::make_unique<views::WebView>(browser->GetProfile()));
+    // Webium sizes new tabs from this element (GetContentsBoundsInScreen).
+    contents_->SetProperty(views::kElementIdentifierKey, kContentsContainerViewElementId);
+    browser->GetTabStripModel()->AddObserver(this);
+    window_->relayout = base::BindRepeating(
+        [](NativeShellView* view) {
+          view->InvalidateLayout();
+          view->SchedulePaint();
+        },
+        base::Unretained(this));
+    chrome_ = (__bridge_transfer NSView*)agens_ui_create_chrome(window_.get());
+  }
+  ~NativeShellView() override {
+    agens_ui_destroy_chrome((__bridge void*)chrome_);
+    [chrome_ removeFromSuperview];
+    contents_->SetWebContents(nullptr);
+  }
+
+  void FocusAddress() { agens_ui_focus_address((__bridge void*)chrome_); }
+
+  // views::View:
+  void AddedToWidget() override {
+    // The views content view is layer-hosting and won't draw AppKit subviews, so the chrome
+    // is a sibling above it in the window frame (below the traffic lights).
+    NSWindow* window = GetWidget()->GetNativeWindow().GetNativeNSWindow();
+    [window.contentView.superview addSubview:chrome_
+                                  positioned:NSWindowAbove
+                                  relativeTo:window.contentView];
+  }
+  void Layout(PassKey) override {
+    if (chrome_.superview) {
+      NSView* content = GetWidget()->GetNativeWindow().GetNativeNSWindow().contentView;
+      chrome_.frame = [content convertRect:content.bounds toView:chrome_.superview];
+    }
+    // The UI owns the colors (light/dark); the engine paints them behind its views.
+    unsigned window_color = 0, page_color = 0, line_color = 0;
+    agens_ui_colors((__bridge void*)chrome_, &window_color, &page_color, &line_color);
+    auto sk = [](unsigned rgb) { return SkColorSetRGB((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255); };
+    SetBackground(views::CreateSolidBackground(sk(window_color)));
+    card_->SetBackground(views::CreateRoundedRectBackground(sk(page_color), kRadius, 1));
+    card_->SetBorder(views::CreateRoundedRectBorder(1, kRadius, sk(line_color)));
+    AgensRect page = agens_ui_layout((__bridge void*)chrome_, width(), height());
+    gfx::Rect card(page.x, page.y, page.width, page.height);
+    card_->SetBoundsRect(card);
+    card.Inset(1);
+    contents_->SetBoundsRect(card);
+    contents_->holder()->SetNativeViewCornerRadii(gfx::RoundedCornersF(kRadius - 1));
+  }
+
+  // TabStripModelObserver: the page area follows the active tab.
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                              const TabStripSelectionChange& selection) override {
+    if (selection.active_tab_changed()) {
+      contents_->SetWebContents(selection.new_contents);
+      contents_->holder()->SetNativeViewCornerRadii(gfx::RoundedCornersF(kRadius - 1));
+    }
+  }
+
+ private:
+  std::unique_ptr<AgensWindow> window_;
+  raw_ptr<views::View> card_;
+  raw_ptr<views::WebView> contents_;
+  NSView* __strong chrome_;
+};
+
+BEGIN_METADATA(NativeShellView)
+END_METADATA
+
+}  // namespace
+
+std::unique_ptr<views::View> CreateNativeShellView(BrowserWindowInterface* browser) {
+  return std::make_unique<NativeShellView>(browser);
+}
+
+void FocusNativeLocationBar(views::Widget* widget) {
+  if (auto* shell = views::AsViewClass<NativeShellView>(
+          widget->GetRootView()->GetViewByID(NativeShellView::kViewId))) {
+    shell->FocusAddress();
+  }
+}
+
+}  // namespace agens
